{
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "ruff.configurationPreference": "filesystemFirst",
    "ruff.importStrategy": "fromEnvironment",
    "ruff.nativeServer": "on",
    "editor.codeLens": true,
    "dotnet.codeLens.enableReferencesCodeLens": true,
    "dotnet.codeLens.enableTestsCodeLens": false,
    "dotnet.defaultSolution": "godot_csharp/DualOntologyWorldEngine.sln",
    "dotnet.preferVisualStudioCodeFileSystemWatcher": true,
    "omnisharp.projectFilesExcludePattern": "**/node_modules/**,**/.git/**,**/bower_components/**,**/artifacts/**,**/tmp/**,**/scratch/**",
    "gitlens.codeLens.enabled": false,
    "gitlens.codeLens.authors.enabled": false,
    "gitlens.codeLens.recentChange.enabled": false,
    "gitlens.currentLine.enabled": false,
    "git.blame.editorDecoration.enabled": false,
    "files.exclude": {
        "**/*.uid": true,
        "**/*.import": true,
        "artifacts": true,
        "tmp": true,
        "scratch": true
    },
    "search.exclude": {
        "**/*.uid": true,
        "artifacts/**": true,
        "tmp/**": true,
        "scratch/**": true
    },
    "files.watcherExclude": {
        "artifacts/**": true,
        "tmp/**": true,
        "scratch/**": true
    },
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true
    },
    "Codegeex.RepoIndex": true,
