{
  "id": "demo_door_case",
  "title": "Demo 重门案加码",
  "source": "docs/design-standard.md 第二部分 §6；初始抽象模型对照 tools/check_demo_door_case.py；阶段限制对照 godot_csharp/scenes/FirstAwakening/HallReplayBridge.cs",
  "target_minutes": [12, 18],
  "sets": {
    "STUDENT": ["侦探", "工程师", "主厨", "音乐家"],
    "INSIDE": ["侦探", "工程师", "主厨", "音乐家", "恶魔_内侧"]
  },
  "initial": {
    "door": "closed", "pin": "out", "bar": "up", "bell": false,
    "phase": "night-response",
    "hall_ash": false, "hall_wiped": false, "main_ash": false, "wedge": "table"
  },
  "banned": ["long_residence", "duty_roster", "worn_personal_item", "healed_body_mark"],
  "evidence": {
    "door_mechanics": {"id": "F01", "label": "门向主楼侧开，配重合门；内销只能从生活翼侧操作", "acquire": "门边检查铰链与配重", "static": true},
    "rule_plaque": {"id": "F09", "label": "铜牌“生活翼警铃规程”四条", "acquire": "门厅警铃下", "static": true},
    "bar_down": {"id": "F02", "label": "外闩落在主楼侧卡座里", "acquire": "门边、检视盖"},
    "pin_in_now": {"id": "F02", "label": "内销当下插着", "acquire": "门边"},
    "scrape_fiber": {"id": "F03", "label": "门底窄缝磨痕夹木纤维", "acquire": "门底"},
    "wedge_ashed": {"id": "F03", "label": "楔子沾灰，尖角缺口与磨痕吻合", "acquire": "包楔"},
    "notation_page3": {"id": "F04", "label": "包纸是练习册第3页，内有音乐家速记谱", "acquire": "研习室对撕口；让音乐家辨认"},
    "wrap_in_detective_bin": {"id": "F04", "label": "包楔在侦探房纸篓", "acquire": "侦探居室纸篓"},
    "ash_inward_strip": {"id": "F05", "label": "门扇正下方向内散开的灰带，湿布擦不到", "acquire": "门底低处"},
    "wipe_trail": {"id": "F06", "label": "湿擦痕从门厅连到水盆", "acquire": "门厅"},
    "cloth_washed": {"id": "F06", "label": "滤布洗过晾开", "acquire": "备餐间"},
    "rooms_cleared": {"id": "F12", "label": "四间居室只剩制式用品", "acquire": "各居室"},
    "pin_in_before_engineer": {"id": "F11", "label": "工程师证言：到门前时内销已插着，拔销试门后又插回", "acquire": "首次会合"},
    "spokes4_over_wipe": {"id": "F07", "label": "四道灰印压在擦痕之上，自门槛通往四扇房门，越往里越淡", "acquire": "门厅，放低油灯侧光，用放大镜", "available": "R2"},
    "narrow_heel_prints": {"id": "F07", "label": "灰印为窄跟鞋印，窄于四人的制式鞋", "acquire": "门厅侧光 + 放大镜，比对制式鞋", "available": "R2"},
    "main_full_arc": {"id": "F08", "label": "主楼侧积灰上有整扇门扫过的扇形弧", "acquire": "检视盖向下看地面", "available": "R2"},
    "chef_morning_testimony": {"id": "F10", "label": "主厨证言：今晨最早起身，见内销没插，顺手插上", "acquire": "问主厨“今早谁最先经过门厅、当时销子是什么状态”", "available": "R5"}
  },
  "predictions": {
    "single_return_trace": {"label": "学生从居室出发搬运，只会留下一道返回本人房门的灰印", "refuted_by": ["spokes4_over_wipe"]},
    "spokes4_then_wiped": {"label": "若来人在擦地之前进出，灰印会被湿擦抹开", "refuted_by": ["spokes4_over_wipe"]}
  },
  "events": {
    "bell": {"do": [{"set": "bell", "to": true}]},
    "listen_wedge": {"params": [["actor", "INSIDE"]], "do": [
      {"require": {"param": "actor", "in": "STUDENT"}, "reason": "撑门者须在生活翼内", "shown_by": ["door_mechanics"]},
      {"require": {"all": [{"var": "door", "eq": "closed"}, {"var": "pin", "eq": "out"}, {"var": "bar", "eq": "up"}]}, "reason": "门须可推开", "shown_by": ["door_mechanics"]},
      {"set": "wedge", "to": "door"}, {"set": "door", "to": "gap10"},
      {"add": "scrape_fiber"},
      {"when": {"param": "actor", "eq": "音乐家"}, "then": [{"add": "_notation_pending"}]}
    ]},
    "escape_through_gap": {"params": [["actor", "STUDENT"]], "player_assumption": true, "do": [
      {"require": {"var": "door", "ne": "gap10"}, "reason": "十厘米窄缝容不下成人穿行", "shown_by": ["door_mechanics", "scrape_fiber"]}
    ]},
    "smoke": {"do": [
      {"require": {"var": "door", "eq": "gap10"}, "reason": "烟灰须经开口入内", "shown_by": ["ash_inward_strip"]},
      {"set": "hall_ash", "to": true}, {"set": "main_ash", "to": true},
      {"add": ["ash_inward_strip", "wedge_ashed"]}
    ]},
    "pull_wedge_close": {"params": [["actor", "INSIDE"]], "do": [
      {"require": {"all": [{"param": "actor", "in": "STUDENT"}, {"var": "door", "eq": "gap10"}]}, "reason": "须在内侧撤楔", "shown_by": ["door_mechanics", "wedge_ashed"]},
      {"set": "door", "to": "closed"}, {"set": "wedge", "to": {"param": "actor"}}
    ]},
    "wrap_rule2": {"params": [["actor", "STUDENT"]], "do": [
      {"require": {"var": "wedge", "eq": {"param": "actor"}}, "reason": "包楔者须持楔", "shown_by": ["wrap_in_detective_bin"]},
      {"require": {"has": "_notation_pending"}, "reason": "包纸须取自门边的练习册第3页", "shown_by": ["notation_page3"]},
      {"remove": "_notation_pending"}, {"add": "notation_page3"},
      {"require": {"param": "actor", "eq": "侦探"}, "reason": "规程二：投于本人居室纸篓；包楔在侦探房", "shown_by": ["rule_plaque", "wrap_in_detective_bin"]},
      {"add": "wrap_in_detective_bin"}
    ]},
    "wipe": {"params": [["actor", "STUDENT"]], "do": [
      {"require": {"var": "hall_ash", "eq": true}, "reason": "须有落灰可擦", "shown_by": ["wipe_trail"]},
      {"set": "hall_wiped", "to": true},
      {"add": ["wipe_trail", "cloth_washed"]}
    ]},
    "pin_in": {"params": [["actor", "INSIDE"]], "do": [
      {"require": {"var": "door", "eq": "closed"}, "reason": "门须合拢", "shown_by": ["door_mechanics"]},
      {"set": "pin", "to": "in"}
    ]},
    "pin_out": {"params": [["actor", "INSIDE"]], "do": [{"set": "pin", "to": "out"}]},
    "bell_stops": {"do": [{"set": "bell", "to": false}]},
    "demon_enter_clear": {"do": [
      {"require": {"var": "pin", "eq": "out"}, "reason": "内销插着时，主楼侧拉不开门", "shown_by": ["door_mechanics"]},
      {"require": {"var": "bar", "eq": "up"}, "reason": "外闩落下后门无法开启", "shown_by": ["door_mechanics", "bar_down"]},
      {"require": {"var": "main_ash", "eq": true}, "reason": "主楼侧须有积灰才留扫弧与灰印", "shown_by": ["main_full_arc"]},
      {"require": {"var": "phase", "ne": "morning"}, "reason": "作者时序中的昨夜巡查不能排在今晨行动之后", "shown_by": []},
      {"add": ["main_full_arc", "rooms_cleared", "narrow_heel_prints"]},
      {"when": {"var": "hall_wiped", "eq": true}, "then": [{"add": "spokes4_over_wipe"}], "else": [{"add": "spokes4_then_wiped"}]},
      {"set": "door", "to": "closed"},
      {"set": "phase", "to": "night-inspection"}
    ]},
    "student_exit_carry": {"params": [["actor", "STUDENT"]], "do": [
      {"require": {"all": [{"var": "pin", "eq": "out"}, {"var": "bar", "eq": "up"}]}, "reason": "门须可开", "shown_by": ["door_mechanics"]},
      {"require": {"var": "main_ash", "eq": true}, "reason": "扫弧需主楼侧积灰", "shown_by": ["main_full_arc"]},
      {"add": ["main_full_arc", "rooms_cleared", "single_return_trace"]}
    ]},
    "bar_down": {"do": [
      {"require": {"var": "phase", "ne": "morning"}, "reason": "宿主时序要求外闩在夜里来人离开后落下，不能排到今晨插销之后", "shown_by": []},
      {"set": "bar", "to": "down"}, {"add": "bar_down"}
    ]},
    "morning_pin_chef": {"do": [
      {"require": {"var": "pin", "eq": "out"}, "reason": "主厨证言：起身时内销未插", "shown_by": ["chef_morning_testimony"]},
      {"set": "pin", "to": "in"}, {"set": "phase", "to": "morning"},
      {"add": "chef_morning_testimony"}
    ]},
    "engineer_today": {"do": [
      {"set": "phase", "to": "morning"},
      {"when": {"var": "pin", "eq": "in"}, "then": [{"add": "pin_in_before_engineer"}]},
      {"set": "pin", "to": "out"},
      {"require": {"var": "bar", "eq": "down"}, "reason": "工程师拔销后门仍推不动", "shown_by": ["bar_down", "pin_in_before_engineer"]},
      {"set": "pin", "to": "in"}
    ]},
    "finish": {"terminal": true, "do": [{"when": {"var": "pin", "eq": "in"}, "then": [{"add": "pin_in_now"}]}]}
  },
  "sequences": {
    "NIGHT_A": [["bell"], ["listen_wedge", "音乐家"], ["smoke"], ["pull_wedge_close", "侦探"], ["wrap_rule2", "侦探"], ["wipe", "主厨"]],
    "RULE3": [["pin_in", "工程师"], ["bell_stops"], ["pin_out", "工程师"]]
  },
  "hypotheses": {
    "H1": {"label": "撑门逃出", "steps": [["bell"], ["listen_wedge", "音乐家"], ["escape_through_gap", "音乐家"]]},
    "H2": {"label": "旧答案：本能链+夜里插销+恶魔落闩", "steps": [{"use": "NIGHT_A"}, ["pin_in", "工程师"], ["bar_down"], ["engineer_today"], ["finish"]]},
    "H3": {"label": "规程三拔销但无人进来", "steps": [{"use": "NIGHT_A"}, {"use": "RULE3"}, ["bar_down"], ["engineer_today"], ["finish"]]},
    "H4": {"label": "侦探夜里开门把行李运去主楼", "steps": [{"use": "NIGHT_A"}, {"use": "RULE3"}, ["student_exit_carry", "侦探"], ["pin_in", "侦探"], ["bar_down"], ["engineer_today"], ["finish"]]},
    "H5": {"label": "恶魔进出清房，夜里内销一直插着", "steps": [{"use": "NIGHT_A"}, ["pin_in", "工程师"], ["demon_enter_clear"], ["bar_down"], ["engineer_today"], ["finish"]]},
    "H6": {"label": "恶魔进出后在内侧插销再离开", "steps": [{"use": "NIGHT_A"}, {"use": "RULE3"}, ["demon_enter_clear"], ["pin_in", "恶魔_内侧"], ["demon_enter_clear"]]},
    "H7": {"label": "恶魔清房先于擦地", "steps": [["bell"], ["listen_wedge", "音乐家"], ["smoke"], ["pull_wedge_close", "侦探"], ["wrap_rule2", "侦探"], {"use": "RULE3"}, ["demon_enter_clear"], ["wipe", "主厨"], ["bar_down"], ["morning_pin_chef"], ["engineer_today"], ["finish"]]},
    "H8": {"label": "恶魔进出，今晨无人插销（工程师首插）", "steps": [{"use": "NIGHT_A"}, {"use": "RULE3"}, ["demon_enter_clear"], ["bar_down"], ["engineer_today"], ["finish"]]},
    "TRUE": {"label": "完整经过（§6.3 十二步）", "truth": true, "steps": [{"use": "NIGHT_A"}, {"use": "RULE3"}, ["demon_enter_clear"], ["bar_down"], ["morning_pin_chef"], ["engineer_today"], ["finish"]]}
  },
  "answer_requires_steps": [["pin_out", "工程师"], ["demon_enter_clear"], ["bar_down"], ["morning_pin_chef"]],
  "rounds": [
    {"id": "R1", "hypothesis": "H1", "expect": "refute", "minutes": [1, 2]},
    {"id": "R2", "hypothesis": "H2", "expect": "pointer", "minutes": [3, 4], "hint": "工程师：“那边的地我没往下看。”检视系统标记“主楼侧地面未核对”“门厅擦痕之上未核对”"},
    {"id": "R3", "hypothesis": "H3", "expect": "refute", "minutes": [2, 3]},
    {"id": "R4", "hypothesis": "H4", "expect": "refute", "minutes": [2, 3], "hint": "主厨：“要是他一个人搬，脚印该是一道。”"},
    {"id": "R5", "hypothesis": "H8", "expect": "refute", "minutes": [2, 3], "hint": "音乐家：“今早谁先起的？”"},
    {"id": "R6", "hypothesis": "TRUE", "expect": "answer", "minutes": [2, 3]}
  ]
}
