<Project>
  <!-- Define paths before SDK props so NuGet assets and apphost cannot collide with sibling projects. -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>obj/CognitionRegression/</BaseIntermediateOutputPath>
    <BaseOutputPath>bin/CognitionRegression/</BaseOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="CognitionRegressionProgram.cs" />
    <Compile Include="EventRegression.cs" />
    <ProjectReference Include="DualOntologyWorldEngine.Core.csproj" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
