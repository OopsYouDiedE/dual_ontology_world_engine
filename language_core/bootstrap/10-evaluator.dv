; A metacircular evaluator for exactly the seed special forms.
; The native table contains only data/arithmetic/cell/apply operations, never eval.
(def! dv-env (fn* (outer) (list (atom '()) outer)))
(def! dv-get (fn* (env key)
  (if env
    (let* (entry (assoc key (deref (first env))))
      (if entry (nth entry 1) (dv-get (nth env 1) key)))
    (error (list 'unbound key)))))
(def! dv-set (fn* (env key value)
  (do (ensure (symbol? key) "Binding must be a symbol")
      (reset! (first env) (put (deref (first env)) key value)) value)))
(def! dv-root (fn* ()
  (let* (env (dv-env nil))
    (do (reset! (first env) native-bindings)
        (dv-set env 'native-bindings native-bindings) env))))
(def! dv-arity (fn* (form size)
  (ensure (= (count form) size) (list 'invalid-form-arity (first form)))))
(def! dv-distinct? (fn* (xs)
  (if (empty? xs) true (if (member? (first xs) (rest xs)) false (dv-distinct? (rest xs))))))
(def! dv-parameters (fn* (xs)
  (do (ensure (list? xs) "Parameters must be a list")
      (ensure (every? symbol? xs) "Parameters must be symbols")
      (ensure (dv-distinct? xs) "Duplicate parameter") xs)))
(def! dv-bind (fn* (env names values)
  (do (ensure (= (count names) (count values)) "Function arity mismatch")
      (if (empty? names) env
        (do (dv-set env (first names) (first values))
            (dv-bind env (rest names) (rest values)))))))
(def! dv-do (fn* (forms env)
  (if (empty? forms) nil
    (if (empty? (rest forms)) (dv-eval (first forms) env)
      (do (dv-eval (first forms) env) (dv-do (rest forms) env))))))
(def! dv-let (fn* (bindings body env)
  (if (empty? bindings) (dv-eval body env)
    (do (ensure (< 1 (count bindings)) "Uneven let bindings")
        (dv-set env (first bindings) (dv-eval (nth bindings 1) env))
        (dv-let (rest (rest bindings)) body env)))))
(def! dv-apply (fn* (f args)
  (apply f args)))
(def! dv-eval (fn* (ast env)
  (if (symbol? ast) (dv-get env ast)
    (if (list? ast)
      (if (empty? ast) ast
        (let* (head (first ast))
          (if (= head 'quote)
            (do (dv-arity ast 2) (nth ast 1))
          (if (= head 'def!)
            (do (dv-arity ast 3) (dv-set env (nth ast 1) (dv-eval (nth ast 2) env)))
          (if (= head 'if)
            (do (ensure (member? (count ast) '(3 4)) "Invalid if arity")
                (if (dv-eval (nth ast 1) env) (dv-eval (nth ast 2) env)
                  (if (= (count ast) 4) (dv-eval (nth ast 3) env) nil)))
          (if (= head 'do) (dv-do (rest ast) env)
          (if (= head 'let*)
            (do (dv-arity ast 3) (dv-let (nth ast 1) (nth ast 2) (dv-env env)))
          (if (= head 'fn*)
            (do (dv-arity ast 3)
                (let* (parameters (dv-parameters (nth ast 1)) body (nth ast 2))
                  (wrap-function (fn* (arguments)
                    (dv-eval body (dv-bind (dv-env env) parameters arguments))))))
            (dv-apply (dv-eval head env) (map (fn* (x) (dv-eval x env)) (rest ast)))))))))))
      ast))))
(def! dv-load (fn* (forms env) (dv-do forms env)))
