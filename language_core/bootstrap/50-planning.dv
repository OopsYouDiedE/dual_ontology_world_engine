; Shared bounded planning, entirely in the language. Predictions remain private.
; Node: (facts path reward-total ledger visited). Edge sources are accepted rule IDs.
; All roots expand a complete depth layer or all retain the preceding layer.
(def! planning-node (fn* (facts path total ledger visited) (list facts path total ledger visited)))
(def! plan-child-result (fn* (node assessment rules context)
  (let* (effect (first assessment) score (nth assessment 1) state (first node)
         predicted (prepare effect state context))
    (if (= (first predicted) 'ok)
      (let* (next (nth predicted 1) reward-key effect previous (get (nth node 3) reward-key 0)
             delta (if (< score 0) score (if (< previous score) (- score previous) 0))
             ledger (put (nth node 3) reward-key (if (< previous score) score previous))
             sources (map (fn* (r) (nth r 1))
               (filter (fn* (r) (= (bind-nouns (nth r 4) context) effect))
                 (filter (fn* (r) (member? (nth r 3) '(prefer require))) (active-rules rules state context)))))
        (if (member? next (nth node 4)) '(rejected cycle)
          (list 'child (planning-node next (concat (nth node 1) (list (list effect score delta sources)))
            (+ (nth node 2) delta) ledger (cons next (nth node 4))))))
      (list 'rejected (nth predicted 1))))))
(def! prediction-children (fn* (results)
  (map (fn* (result) (nth result 1)) (filter (fn* (result) (= (first result) 'child)) results))))
(def! prediction-rejections (fn* (results)
  (map (fn* (result) (nth result 1)) (filter (fn* (result) (= (first result) 'rejected)) results))))
(def! plan-expand-node (fn* (node rules context)
  (let* (results (map (fn* (assessment) (plan-child-result node assessment rules context))
      (filter (fn* (assessment) (not (nth assessment 2))) (assess rules (first node) context))))
    (list (prediction-children results) (prediction-rejections results)))))
; Root: (first-action frontier best-node rejected-predictions). Ties preserve source order.
(def! better-node (fn* (best candidate) (if (< (nth best 2) (nth candidate 2)) candidate best)))
(def! expand-root (fn* (root rules context)
  (let* (results (map (fn* (node) (plan-expand-node node rules context)) (nth root 1))
         children (fold (fn* (out result) (concat out (first result))) '() results)
         rejections (fold (fn* (out result) (concat out (nth result 1))) (nth root 3) results))
    (list (first root) children (fold better-node (nth root 2) children) rejections))))
(def! plan-result (fn* (roots depth expanded stop initial-rejections)
  (list 'planned roots depth expanded stop
    (unique (fold (fn* (out root) (concat out (nth root 3))) initial-rejections roots)))))
(def! plan-layers (fn* (roots rules context depth max-depth remaining expanded rejections)
  (let* (frontier (fold (fn* (sum root) (+ sum (count (nth root 1)))) 0 roots))
    (if (= frontier 0) (plan-result roots depth expanded 'terminal rejections)
    (if (not (< depth max-depth)) (plan-result roots depth expanded 'depth rejections)
    (if (< remaining frontier) (plan-result roots depth expanded 'complete-layer-budget rejections)
      (plan-layers (map (fn* (root) (expand-root root rules context)) roots) rules context
        (+ depth 1) max-depth (- remaining frontier) (+ expanded frontier) rejections)))))))
(def! plan (fn* (rules v context max-depth expansions)
  (do (ensure (view? v) "Subject-indexed view required")
      (ensure (if (integer? max-depth) (if (< 0 max-depth) (not (< 64 max-depth)) false) false) "Invalid planning depth")
      (ensure (if (integer? expansions) (if (< 0 expansions) (not (< 100000 expansions)) false) false) "Invalid expansion budget")
      (let* (facts (get v 'facts '())
             assessments (filter (fn* (a) (not (nth a 2))) (assess rules facts context))
             empty-node (planning-node facts '() 0 '() (list facts))
             results (map (fn* (a) (plan-child-result empty-node a rules context)) assessments)
             rejections (prediction-rejections results)
             children (prediction-children results)
             roots (map (fn* (child) (list (first (first (nth child 1))) (list child) child '())) children))
        (if (empty? roots) (list 'no-action (unique rejections) (if (empty? assessments) 0 1))
          ; expansions counts expanded states, including the one initial state shared by all roots.
          (plan-layers roots rules context 1 max-depth (- expansions 1) 1 rejections))))))
(def! planning-summary (fn* (result)
  (if (= (first result) 'no-action) result
    (let* (roots (nth result 1)
           best (fold (fn* (best root) (if (< (nth (nth best 2) 2) (nth (nth root 2) 2)) root best)) (first roots) (rest roots))
           node (nth best 2))
      (list 'planned (first best) (nth node 1) (nth node 2) (count (nth node 1)) (nth result 3) (nth result 4)
        (nth result 5) (nth result 2))))))
; Social assessment and learning also operate only on explicitly supplied subject data.
(def! social-assess (fn* (cooperation trust compatibility prior-outcomes)
  (let* (score (+ (+ cooperation trust) (+ compatibility (fold + 0 prior-outcomes))))
    (list (if (< 0 score) 'accept (if (< score 0) 'reject 'negotiate)) score))))
(def! remember-attempt (fn* (memory action context outcome)
  (do (ensure (member? outcome '(success failure no-progress interrupted)) "Unknown attempt outcome")
      (concat memory (list (list action context outcome))))))
(def! retry-cost (fn* (memory action context)
  (fold (fn* (cost attempt)
    (if (= (first attempt) action)
      (if (= (nth attempt 1) context)
        (+ cost (if (= (nth attempt 2) 'failure) 4 (if (= (nth attempt 2) 'no-progress) 2 0))) cost) cost)) 0 memory)))
