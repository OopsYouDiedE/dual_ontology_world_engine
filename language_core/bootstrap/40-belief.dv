; Subject-indexed finite weighted inference. Scores are not assumed to be likelihoods.
; View: subject, revision, facts, conceived questions, held claims, explicitly modeled minds.
; Claim: (projection-handle question-index option-index source speaker-handle strength).
; Hypothesis: (stable-id (option-indices...) ((trace-key predicted-value)...)).
(def! clamp (fn* (x low high) (if (< x low) low (if (< high x) high x))))
(def! view (fn* (subject revision facts conceived claims models)
  (do (ensure (string? subject) "View requires a subject")
      (ensure (if (integer? revision) (not (< revision 0)) false) "View requires a revision")
      (list (list 'subject subject) (list 'revision revision) (list 'facts facts)
            (list 'conceived conceived) (list 'claims claims) (list 'models models)))))
(def! view? (fn* (v)
  (if (list? v)
    (if (string? (get v 'subject nil))
      (if (integer? (get v 'revision nil)) (list? (get v 'facts nil)) false) false) false)))
(def! source-factor (fn* (source trust strength)
  (if (= source 'perception) 8
  (if (= source 'inference) 6
  (if (= source 'recall) 3
  (if (= source 'corruption) 1
  (if (= source 'testimony) (clamp (+ 2 (* 0.5 (clamp trust -3 3))) 1 3.5)
  (if (= source 'introspection) (+ 1 (if (< strength 0) 0 strength)) (error "Unknown evidence source")))))))))
(def! normalize (fn* (weights)
  (do (ensure (every? (fn* (p) (if (number? (nth p 1)) (not (< (nth p 1) 0)) false)) weights) "Invalid distribution weight")
      (let* (total (fold (fn* (sum p) (+ sum (nth p 1))) 0 weights))
        (if (= total 0) '(conflict zero-support)
          (list 'distribution (map (fn* (p) (list (first p) (/ (nth p 1) total))) weights)))))))
; This function is Bayesian ONLY when supplied values are declared likelihoods and
; their dependence assumptions are justified by the caller's model.
(def! bayes-update (fn* (distribution likelihoods)
  (do (ensure (= (first distribution) 'distribution) "Expected normalized distribution")
      (normalize (map (fn* (p) (list (first p) (* (nth p 1) (get likelihoods (first p) 0)))) (nth distribution 1))))))
(def! held-claims (fn* (v)
  (let* (facts (get v 'facts '()))
    (filter (fn* (claim) (= (get (get facts (first claim) '()) 'exists 'unknown) 'true)) (get v 'claims '())))))
(def! observed-fields (fn* (v fields)
  (fold (fn* (observed field)
    (let* (obj (get (get v 'facts '()) (nth field 0) '())
           entry (assoc (nth field 1) (get obj 'tags '())))
      (if (= (get obj 'exists 'unknown) 'false) observed
        (if entry (put observed (nth field 2) (nth entry 1)) observed)))) '() fields)))
(def! contradiction-count (fn* (hypothesis observations)
  (fold (fn* (count observation)
    (+ count (if (= (get (nth hypothesis 2) (first observation) nil) (nth observation 1)) 0 1))) 0 observations)))
(def! apply-claim (fn* (v hypotheses distribution claim)
  (let* (speaker (get (get v 'facts '()) (nth claim 4) '())
         trust (get (get speaker 'tags '()) 'Trust 0)
         factor (source-factor (nth claim 3) trust (nth claim 5)))
    (if (< 1 factor)
      (normalize (map (fn* (p)
        (let* (hypothesis (first (filter (fn* (h) (= (first h) (first p))) hypotheses)))
          (list (first p) (* (nth p 1) (if (= (nth (nth hypothesis 1) (nth claim 1)) (nth claim 2)) factor 1))))) (nth distribution 1)))
      distribution))))
(def! case-assess (fn* (v hypotheses fields defaults)
  (do (ensure (view? v) "Subject-indexed view required")
      (ensure (not (empty? hypotheses)) "Empty hypothesis model")
      (ensure (dv-distinct? (map first hypotheses)) "Duplicate hypothesis identity")
      (let* (claims (held-claims v)
             assumed (filter (fn* (d)
               (if (member? (first d) (get v 'conceived '())) false
                 (empty? (filter (fn* (c) (= (nth c 1) (first d))) claims)))) defaults)
             conceivable (filter (fn* (h) (every? (fn* (d) (= (nth (nth h 1) (first d)) (nth d 1))) assumed)) hypotheses)
             observed (observed-fields v fields))
        (if (empty? conceivable) '(unmodeled incompatible-defaults)
          (let* (minimum (fold (fn* (minimum h)
                    (let* (count (contradiction-count h observed)) (if (< count minimum) count minimum)))
                    (contradiction-count (first conceivable) observed) conceivable)
                 candidates (filter (fn* (h) (= (contradiction-count h observed) minimum)) conceivable)
                 prior (normalize (map (fn* (h) (list (first h) 1)) candidates))
                 distinct-claims (fold (fn* (out c)
                   (if (empty? (filter (fn* (old) (= (first old) (first c))) out)) (concat out (list c)) out)) '() claims)
                 posterior (fold (fn* (dist claim) (apply-claim v candidates dist claim)) prior distinct-claims))
            (list (list 'scope (list (get v 'subject nil) (get v 'revision nil)))
                  (list 'distribution posterior) (list 'candidates (map first candidates))
                  (list 'contradicted (< 0 minimum)) (list 'minimum-contradictions minimum)
                  (list 'basis (list observed assumed (map first distinct-claims))))))))))
(def! marginal (fn* (result hypotheses question option)
  (let* (distribution (get result 'distribution nil))
    (fold (fn* (total p)
      (let* (h (first (filter (fn* (h) (= (first h) (first p))) hypotheses)))
        (+ total (if (= (nth (nth h 1) question) option) (nth p 1) 0)))) 0 (nth distribution 1)))))
(def! case-marginals (fn* (result hypotheses option-counts)
  (map (fn* (q) (map (fn* (o) (marginal result hypotheses q o)) (range 0 (nth option-counts q))))
    (range 0 (count option-counts)))))
; A modeled mind is owned by the outer subject and explicitly sourced or hypothetical.
; Model: (inner-view basis-handles hypothetical?). It is never the real other mind.
(def! mental-evaluate (fn* (v path condition context)
  (do (ensure (view? v) "Subject-indexed view required")
    (if (empty? path) (list 'evaluated (eval-condition condition (get v 'facts '()) context) (get v 'subject nil) false '())
      (let* (model (get (get v 'models '()) (first path) nil))
        (if model
          (let* (basis (nth model 1) hypothetical (nth model 2))
            (do (ensure (member? hypothetical '(true false)) "Invalid hypothetical flag")
                (ensure (if hypothetical true (not (empty? basis))) "Observed model requires a source")
                (ensure (every? (fn* (handle) (assoc handle (get v 'facts '()))) basis) "Model source is outside subject view")
                (let* (result (mental-evaluate (first model) (rest path) condition context))
                  (list 'evaluated (nth result 1) (get v 'subject nil)
                    (if hypothetical true (nth result 3)) (concat basis (nth result 4))))))
          (list 'evaluated 'unknown (get v 'subject nil) false '())))))))
