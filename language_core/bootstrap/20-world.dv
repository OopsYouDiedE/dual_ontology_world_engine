; The rule semantics operate on explicit immutable alists, never host objects.
; Nouns: (ref "subject-local-handle") or (slot actor|target|tool|scene).
(def! noun? (fn* (n)
  (if (list? n)
    (if (= (count n) 2)
      (if (= (first n) 'ref) (string? (nth n 1))
        (if (= (first n) 'slot) (member? (nth n 1) '(actor target tool scene)) false)) false) false)))
(def! resolve-noun (fn* (n context)
  (if (= (first n) 'ref) (nth n 1) (get context (nth n 1) nil))))
(def! condition? (fn* (c)
  (if (list? c)
    (let* (op (first c) args (rest c) size (count c))
      (if (= op 'const) (if (= size 2) (truth? (nth c 1)) false)
      (if (= op 'exists) (if (= size 2) (noun? (nth c 1)) false)
      (if (= op 'tagged) (if (= size 4) (if (noun? (nth c 1)) (if (symbol? (nth c 2)) (integer? (nth c 3)) false) false) false)
      (if (= op 'related) (if (= size 4) (if (noun? (nth c 1)) (if (symbol? (nth c 2)) (noun? (nth c 3)) false) false) false)
      (if (= op 'at) (if (= size 3) (if (noun? (nth c 1)) (noun? (nth c 2)) false) false)
      (if (= op 'kind) (if (= size 3) (if (noun? (nth c 1)) (symbol? (nth c 2)) false) false)
      (if (= op 'not) (if (= size 2) (condition? (nth c 1)) false)
      (if (member? op '(all any)) (every? condition? args) false))))))))) false)))
(def! fact-object (fn* (facts noun context) (get facts (resolve-noun noun context) '())))
(def! bool-truth (fn* (b) (if b 'true 'false)))
(def! authority? (fn* (context) (= (get context 'realm nil) 'authority)))
(def! eval-atomic (fn* (c facts context)
  (let* (op (first c) obj (fact-object facts (nth c 1) context) authority (authority? context))
    (if (if authority (not (= (get obj 'exists 'false) 'true)) false) 'false
    (if (= op 'exists) (get obj 'exists 'unknown)
    (if (= op 'tagged)
      (let* (v (get (get obj 'tags '()) (nth c 2) (if authority 0 nil)))
        (if (= v nil) 'unknown (bool-truth (not (< v (nth c 3))))))
    (if (= op 'related)
      (get (get obj 'relations '()) (list (nth c 2) (resolve-noun (nth c 3) context)) (if authority 'false 'unknown))
    (if (= op 'at)
      (let* (location (get obj 'at nil) other (resolve-noun (nth c 2) context))
        (if location (if other (bool-truth (= location other)) 'unknown) (if authority 'false 'unknown)))
      (let* (kind (get obj 'kind nil)) (if kind (bool-truth (= kind (nth c 2))) 'unknown))))))))))
(def! eval-condition (fn* (c facts context)
  (do (ensure (condition? c) (list 'invalid-condition c))
    (let* (op (first c))
      (if (= op 'const) (nth c 1)
      (if (= op 'not) (t-not (eval-condition (nth c 1) facts context))
      (if (= op 'all) (t-all (map (fn* (x) (eval-condition x facts context)) (rest c)))
      (if (= op 'any) (t-any (map (fn* (x) (eval-condition x facts context)) (rest c)))
        (eval-atomic c facts context)))))))))
; Each rule is (rule id condition mode effect weight acceptance).
; This version deliberately supports a small executable effect subset.
(def! effect? (fn* (e)
  (if (list? e)
    (let* (op (first e) size (count e))
      (if (member? op '(set change spend))
        (if (= size 4) (if (noun? (nth e 1)) (if (symbol? (nth e 2)) (integer? (nth e 3)) false) false) false)
      (if (= op 'relate)
        (if (= size 5) (if (noun? (nth e 1)) (if (symbol? (nth e 2)) (if (noun? (nth e 3)) (member? (nth e 4) '(true false)) false) false) false) false)
      (if (= op 'require) (if (= size 2) (condition? (nth e 1)) false)
      (if (= op 'when) (if (= size 3) (if (condition? (nth e 1)) (effect? (nth e 2)) false) false)
      (if (= op 'seq) (every? effect? (rest e)) false)))))) false)))
(def! rule? (fn* (r)
  (if (list? r)
    (if (= (count r) 7)
      (if (= (first r) 'rule)
        (if (symbol? (nth r 1))
          (if (condition? (nth r 2))
            (if (member? (nth r 3) '(require forbid permit prefer infer))
              (if (= (nth r 3) 'infer) (if (condition? (nth r 4)) (if (integer? (nth r 5)) (truth? (nth r 6)) false) false)
                (if (effect? (nth r 4)) (if (integer? (nth r 5)) (truth? (nth r 6)) false) false)) false) false) false) false) false) false)))
(def! active-rules (fn* (rules facts context)
  (do (ensure (every? rule? rules) "Invalid rule")
      (filter (fn* (r) (if (= (nth r 6) 'true) (= (eval-condition (nth r 2) facts context) 'true) false)) rules))))
(def! bind-nouns (fn* (term context)
  (if (noun? term)
    (let* (handle (resolve-noun term context)) (do (ensure handle "Unbound noun slot") (list 'ref handle)))
    (if (list? term) (map (fn* (x) (bind-nouns x context)) term) term))))
; Used only inside trusted preparation: several observed handles share one staged resource.
; The alias map contains local handles, never authority identifiers, and is not returned as a view.
(def! canonical-nouns (fn* (term context aliases)
  (if (noun? term)
    (let* (handle (resolve-noun term context))
      (do (ensure handle "Unbound noun slot") (list 'ref (get aliases handle handle))))
    (if (list? term) (map (fn* (child) (canonical-nouns child context aliases)) term) term))))
(def! contains-effect (fn* (candidate forbidden facts context)
  (if (= candidate forbidden) true
    (if (= (first candidate) 'seq)
      (not (empty? (filter (fn* (e) (contains-effect e forbidden facts context)) (rest candidate))))
      (if (= (first candidate) 'when)
        (if (= (eval-condition (nth candidate 1) facts context) 'false) false
          (contains-effect (nth candidate 2) forbidden facts context)) false)))))
(def! assess-one (fn* (candidate rules facts context)
  (let* (bound (bind-nouns candidate context)
         permits (filter (fn* (r) (if (= (nth r 3) 'permit) (= bound (bind-nouns (nth r 4) context)) false)) rules)
         forbidden (filter (fn* (r)
           (if (= (nth r 3) 'forbid)
             (if (contains-effect bound (bind-nouns (nth r 4) context) facts context)
               (empty? (filter (fn* (p) (not (< (nth p 5) (nth r 5)))) permits)) false) false)) rules)
         score (fold (fn* (sum r)
           (if (member? (nth r 3) '(require prefer))
             (+ sum (if (= bound (bind-nouns (nth r 4) context)) (nth r 5)
               (if (= (nth r 3) 'require) (- 0 (nth r 5)) 0))) sum)) 0 rules))
    (list bound score (not (empty? forbidden)) (map (fn* (r) (nth r 1)) forbidden)))))
(def! unique (fn* (xs) (fold (fn* (acc x) (if (member? x acc) acc (concat acc (list x)))) '() xs)))
(def! assess (fn* (rules facts context)
  (let* (active (active-rules rules facts context)
         candidates (unique (map (fn* (r) (bind-nouns (nth r 4) context))
           (filter (fn* (r) (member? (nth r 3) '(require prefer))) active))))
    (map (fn* (c) (assess-one c active facts context)) candidates))))
(def! choose (fn* (assessments)
  (fold (fn* (best a)
    (if (nth a 2) best (if best (if (< (nth best 1) (nth a 1)) a best) a))) nil assessments)))
; Inference returns proposals. It never inserts conclusions into the subject view.
(def! infer (fn* (rules facts context)
  (map (fn* (r) (list (nth r 1) (bind-nouns (nth r 4) context)))
    (filter (fn* (r) (= (nth r 3) 'infer)) (active-rules rules facts context)))))
; Pure stage preparation. Resource failure aborts the entire stage, preserving input.
(def! prepare-seq (fn* (effects facts context)
  (if (empty? effects) (list 'ok facts)
    (let* (result (prepare (first effects) facts context))
      (if (= (first result) 'ok) (prepare-seq (rest effects) (nth result 1) context) result)))))
(def! prepare-numeric (fn* (effect facts context handle obj)
  (let* (op (first effect) tag (nth effect 2) amount (nth effect 3) tags (get obj 'tags '())
         old (get tags tag (if (authority? context) 0 nil)))
    (if (if (= old nil) (not (= op 'set)) false) '(failed unknown-state)
    (if (if (= op 'spend) (if (< amount 0) true (< old amount)) false) '(failed resource)
      (let* (value (if (= op 'set) amount (if (= op 'change) (+ old amount) (- old amount))))
        (if (if (< value -2147483648) true (< 2147483647 value)) '(failed resource)
          (list 'ok (put facts handle (put obj 'tags (put tags tag value)))))))))))
(def! prepare (fn* (effect facts context)
  (do (ensure (effect? effect) "Unsupported or invalid effect")
    (let* (op (first effect))
      (if (= op 'seq) (prepare-seq (rest effect) facts context)
      (if (= op 'require)
        (let* (truth (eval-condition (nth effect 1) facts context))
          (if (= truth 'unknown) '(failed unknown-condition)
            (if (= truth 'true) (list 'ok facts) '(failed condition))))
      (if (= op 'when)
        (let* (truth (eval-condition (nth effect 1) facts context))
          (if (= truth 'unknown) '(failed unknown-condition)
            (if (= truth 'true) (prepare (nth effect 2) facts context) (list 'ok facts))))
        (let* (handle (resolve-noun (nth effect 1) context) obj (get facts handle nil))
          (if obj
            (if (= (get obj 'exists 'unknown) 'true)
              (if (= op 'relate)
                (let* (other (resolve-noun (nth effect 3) context) other-obj (get facts other '()))
                  (if (= (get other-obj 'exists 'unknown) 'true)
                    (list 'ok (put facts handle (put obj 'relations
                      (put (get obj 'relations '()) (list (nth effect 2) other) (nth effect 4))))) '(failed missing-object)))
                (prepare-numeric effect facts context handle obj)) '(failed missing-object))
            '(failed missing-object))))))))))
; Access checks apply to actually executed writes, including staged condition changes.
(def! term-handles (fn* (term context)
  (if (noun? term) (list (resolve-noun term context))
    (if (list? term) (unique (fold (fn* (out child) (concat out (term-handles child context))) '() term)) '()))))
(def! touches-seq (fn* (effects facts context)
  (if (empty? effects) '()
    (let* (result (prepare (first effects) facts context))
      (concat (touches (first effects) facts context)
        (if (= (first result) 'ok) (touches-seq (rest effects) (nth result 1) context) '()))))))
(def! touches (fn* (effect facts context)
  (let* (op (first effect))
    (if (= op 'seq) (touches-seq (rest effect) facts context)
    (if (= op 'require) (term-handles (nth effect 1) context)
    (if (= op 'when)
      (concat (term-handles (nth effect 1) context)
        (if (= (eval-condition (nth effect 1) facts context) 'true) (touches (nth effect 2) facts context) '()))
      (if (= op 'relate)
        (list (resolve-noun (nth effect 1) context) (resolve-noun (nth effect 3) context))
        (list (resolve-noun (nth effect 1) context)))))))))
