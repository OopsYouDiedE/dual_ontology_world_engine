; Original implementation; see REFERENCES.md for the mature interpreter model.
(def! map (fn* (f xs) (if (empty? xs) '() (cons (f (first xs)) (map f (rest xs))))))
(def! fold (fn* (f acc xs) (if (empty? xs) acc (fold f (f acc (first xs)) (rest xs)))))
(def! filter (fn* (f xs) (if (empty? xs) '() (if (f (first xs)) (cons (first xs) (filter f (rest xs))) (filter f (rest xs))))))
(def! every? (fn* (f xs) (if (empty? xs) true (if (f (first xs)) (every? f (rest xs)) false))))
(def! member? (fn* (x xs) (if (empty? xs) false (if (= x (first xs)) true (member? x (rest xs))))))
(def! assoc (fn* (key pairs) (if (empty? pairs) nil (if (= key (first (first pairs))) (first pairs) (assoc key (rest pairs))))))
(def! get (fn* (pairs key fallback) (let* (entry (assoc key pairs)) (if entry (nth entry 1) fallback))))
(def! put (fn* (pairs key value) (cons (list key value) (filter (fn* (entry) (not (= key (first entry)))) pairs))))
(def! ensure (fn* (test message) (if test true (error message))))
(def! integer? (fn* (x) (if (number? x) (= x (floor x)) false)))
(def! truth? (fn* (x) (member? x '(true false unknown))))
(def! t-not (fn* (x) (do (ensure (truth? x) "Invalid truth value") (if (= x 'true) 'false (if (= x 'false) 'true 'unknown)))))
(def! t-all (fn* (xs) (if (member? 'false xs) 'false (if (member? 'unknown xs) 'unknown 'true))))
(def! t-any (fn* (xs) (t-not (t-all (map t-not xs)))))
(def! range (fn* (start end) (if (< start end) (cons start (range (+ start 1) end)) '())))
