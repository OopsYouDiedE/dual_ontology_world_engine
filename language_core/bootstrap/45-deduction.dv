; Bounded deduction over acquired facts and accepted Infer rules only.
; Proof: (proof truth contradicted? hypothetical? rule-ids stop).
(def! proof (fn* (value contradicted hypothetical basis stop) (list 'proof value contradicted hypothetical basis stop)))
(def! proof-unknown (fn* (stop) (proof 'unknown false false '() stop)))
(def! proof-spend (fn* (budget)
  (let* (remaining (deref budget))
    (if (< 0 remaining) (do (reset! budget (- remaining 1)) true) false))))
(def! negate-condition (fn* (condition)
  (if (= (first condition) 'not) (nth condition 1) (list 'not condition))))
(def! proof-rules (fn* (rules goal facts context assumptions depth budget trail)
  (map (fn* (r)
    (list (nth r 1) (prove-internal rules (bind-nouns (nth r 2) context) facts context assumptions depth budget trail)))
    (filter (fn* (r)
      (if (= (nth r 3) 'infer)
        (if (= (nth r 6) 'true) (= (bind-nouns (nth r 4) context) goal) false) false)) rules))))
(def! proof-supported? (fn* (p) (if (= (nth p 1) 'true) (not (nth p 2)) false)))
(def! proof-stop (fn* (proofs)
  (let* (stops (filter (fn* (p) (not (= (nth p 5) 'complete))) proofs))
    (if (empty? stops) 'complete (nth (first stops) 5)))))
(def! prove-internal (fn* (rules goal facts context assumptions depth budget trail)
  (if (< depth 0) (proof-unknown 'depth)
  (if (not (proof-spend budget)) (proof-unknown 'expansions)
  (if (member? goal trail) (proof-unknown 'cycle)
    (let* (next (cons goal trail) op (first goal)
           observed (eval-condition goal facts context)
           components (if (member? op '(all any))
             (map (fn* (c) (prove-internal rules c facts context assumptions (- depth 1) budget next)) (rest goal))
             (if (= op 'not) (list (prove-internal rules (nth goal 1) facts context assumptions (- depth 1) budget next)) '()))
           composed (if (= op 'all) (t-all (map (fn* (p) (nth p 1)) components))
                      (if (= op 'any) (t-any (map (fn* (p) (nth p 1)) components))
                        (if (= op 'not) (t-not (nth (first components) 1)) observed)))
           positive (proof-rules rules goal facts context assumptions (- depth 1) budget next)
           negative (proof-rules rules (negate-condition goal) facts context assumptions (- depth 1) budget next)
           supporting (filter (fn* (p) (proof-supported? (nth p 1))) positive)
           denying (filter (fn* (p) (proof-supported? (nth p 1))) negative)
           assumed (member? goal assumptions) assumed-not (member? (negate-condition goal) assumptions)
           supported (if (= observed 'true) true (if (= composed 'true) true (if assumed true (not (empty? supporting)))))
           denied (if (= observed 'false) true (if (= composed 'false) true (if assumed-not true (not (empty? denying)))))
           all-proofs (concat components (concat (map (fn* (p) (nth p 1)) positive) (map (fn* (p) (nth p 1)) negative)))
           basis (unique (concat (map first (concat supporting denying))
                     (fold (fn* (out p) (concat out (nth p 4))) '() all-proofs)))
           hypothetical (if assumed true (if assumed-not true (not (empty? (filter (fn* (p) (nth p 3)) all-proofs))))))
      (proof (if supported (if denied 'unknown 'true) (if denied 'false 'unknown))
        (if supported denied false) hypothetical basis (proof-stop all-proofs))))))))
(def! prove-condition (fn* (rules v context goal assumptions depth expansions)
  (do (ensure (view? v) "Subject-indexed view required")
      (ensure (every? rule? rules) "Invalid rule")
      (ensure (condition? goal) "Invalid goal")
      (ensure (every? condition? assumptions) "Invalid assumptions")
      (ensure (if (integer? depth) (if (< depth 0) false (not (< 64 depth))) false) "Invalid reasoning depth")
      (ensure (if (integer? expansions) (if (< 0 expansions) (not (< 100000 expansions)) false) false) "Invalid reasoning budget")
      (let* (budget (atom expansions)
             bound (bind-nouns goal context)
             assumed (map (fn* (c) (bind-nouns c context)) assumptions))
        (list (list (get v 'subject nil) (get v 'revision nil))
          (prove-internal rules bound (get v 'facts '()) context assumed depth budget '())
          (- expansions (deref budget)))))))
