// Source module: language_core/game/player-content.dv
// Presentation migrated from the existing first-chapter authored cards and routes.
// Labels offer an interaction, not its unobserved result. Card prose is post-execution only.
fn c1_ui_ends(text, suffix):
    return rt_length(suffix) <= rt_length(text) and rt_slice(text, rt_length(text) - rt_length(suffix), rt_length(suffix)) == suffix

fn c1_player_scene(scene):
    var actors = []
    var i = 0
    while i < rt_count(scene.actors):
        let actor = scene.actors[i]
        var actions = []
        var j = 0
        while j < rt_count(actor.actions):
            rt_push(actions, c1_player_display(actor.actions[j]))
            j = j + 1
        rt_push(actors, dv_with(actor, "actions", actions))
        i = i + 1
    return dv_with(scene, "actors", actors)

fn c1_player_display(action):
    var result = action
    if action.kind == "move" and dv_has_key(action, "travel"):
        let rooms = {"R05": "自己的卧室", "R06": "霍铎的卧室", "R07": "沈鼎的卧室", "R08": "苏泠的卧室", "hall": "活动厅", "foyer": "门厅", "pantry": "茶水间", "corridor": "走廊"}
        if dv_has_key(rooms, action.travel.to):
            result = dv_with(result, "label", rt_cat("前往", dv_get(rooms, action.travel.to)))
    let cards = [
        {"id": "E1", "title": "隔离门", "text": c1_visible_E1()},
        {"id": "E2", "title": "墙角的木楔与门底的灰", "text": c1_visible_E2()},
        {"id": "E3", "title": "灰上的鞋印", "text": c1_visible_E3()},
        {"id": "E4", "title": "门底的湿布", "text": c1_visible_E4()},
        {"id": "E5", "title": "地上的音叉", "text": c1_visible_E5()},
        {"id": "E6", "title": "书桌上的乐谱", "text": c1_visible_E6()},
        {"id": "E7", "title": "长桌上的石板", "text": c1_visible_E7()},
        {"id": "E8", "title": "铜口", "text": c1_visible_E8()},
        {"id": "E9", "title": "水槽里的杯子", "text": c1_visible_E9()},
        {"id": "E10", "title": "碗柜上的罐子", "text": c1_visible_E10()},
        {"id": "E11", "title": "书架", "text": c1_visible_E11()},
        {"id": "E12", "title": "风衣", "text": c1_visible_E12()}]
    var i = 0
    while i < rt_count(cards):
        let card = cards[i]
        if c1_ui_ends(action.id, rt_cat(".inspect.", card.id)):
            result = dv_with_many(result, {"label": rt_cat("检视", card.title), "presentation": c1_op_presentation("detective", "visible-inspection", [card.text])})
        i = i + 1
    let named = {".opening.wake": "回想醒来前的事", ".opening.empty-slot": "查看自己的标签柜", ".opening.wear-coat": "穿上风衣", ".identify-own-lens": "辨认自己的放大镜", ".replay": "在手稿上重演昨夜", ".sound_trial": "进行声路试验", ".reask_question": "询问当前的问题", ".compare_sole": "查看自己的鞋底", ".loss_testimony": "请苏泠说说声路试验中的所闻", ".talk.slate_code": "询问石板刻痕", ".talk.slate_person": "询问石板上的人形线条", ".talk.frame_hollow": "询问门框的声响", ".talk.cups_known": "询问杯子的摆放", ".talk.starter_kept": "询问罐中留存的酵头", ".talk.recalled_copper": "询问关于铜口的记忆", ".talk.recalled_names": "询问关于姓名的记忆"}
    i = 0
    while i < rt_count(named):
        if c1_ui_ends(action.id, named[i][0]):
            result = dv_with(result, "label", named[i][1])
        i = i + 1
    if c1_ui_ends(action.id, ".touch_latch"):
        result = dv_with(result, "label", "走近并触碰插闩")
    if action.kind == "answer":
        let answers = {"me": "闩门的是我", "V1_0": "苏泠在卧室", "V1_1": "苏泠在活动厅", "V1_2": "苏泠在备餐间", "V3_0": "声音来自铜口在墙内与门框处的管道漏音", "V3_1": "门外有人呼喊", "V4_0": "喊的是闩门，别开", "V4_1": "喊的是开门", "trust": "说明为何信任霍铎的速记并闩门"}
        let id = dv_find(action, "answer_id", "")
        if dv_has_key(answers, id):
            result = dv_with(result, "label", rt_cat("答辩：", dv_get(answers, id)))
    if c1_ui_ends(action.id, ".reask_question"):
        let questions = {"opening": "正式问题尚未提出。", "questions_open": c1_question_text("prompt"), "identity": c1_question_text("prompt"), "voice_source": c1_question_text("voice_source"), "words": c1_question_text("words"), "trust": c1_question_text("trust")}
        result = dv_with(result, "presentation", {"lines": [{"template": "当前问题：{question}", "bindings": [{"name": "question", "ref": dv_ref("question", "state", "current"), "labels": questions}]}]})
    if c1_ui_ends(action.id, ".compare_sole"):
        result = dv_with(result, "presentation", {"actor": "detective", "lines": [{"template": "马球靴的鞋底纹路，与门前灰上的印迹一模一样。靴齿里嵌着同样的炭灰。", "when": c1_statement("boots_fit")} ]})
    if c1_ui_ends(action.id, ".identify-own-lens"):
        result = dv_with(result, "presentation", {"actor": "detective", "lines": [{"template": "风衣内袋里的铜框放大镜，把柄刻痕与石板上的图记完全吻合。", "when": c1_statement("lens_mine")} ]})
    if c1_ui_ends(action.id, ".opening.wear-coat"):
        result = dv_with(result, "presentation", {"actor": "detective", "lines": [{"template": "你披上了这件熟悉的呢料风衣，领口与袖口早已磨平。", "when": dv_fact(dv_ref("coat", "state", "worn_by"), "detective")} ]})
    if c1_ui_ends(action.id, ".sound_trial"):
        result = dv_with(result, "presentation", {"voice": "visible-action", "lines": [{"template": "声路试验完成。各处听见了什么，还需分别询问实际在场的人。", "when": dv_fact(dv_ref("ritual", "state", "sound_trial_done"), true)} ]})
    if c1_ui_ends(action.id, ".loss_testimony"):
        result = dv_with(result, "presentation", {"actor": "su", "lines": [{"template": "苏泠：‘昨夜我听见的“开门”，和刚才铜管漏出的那半句很像。我当时把声音当成了门外的人……可我并没有看见他。’"} ]})
    if c1_ui_ends(action.id, ".talk.frame_hollow"):
        result = dv_with(result, "presentation", {"actor": "su", "lines": [{"template": "苏泠用音叉轻敲门框：‘门框后面是空的，贴着走去主楼的传声铜管。松动的接头就在这里。’"} ]})
    if c1_ui_ends(action.id, ".talk.slate_code"):
        result = dv_with(result, "presentation", {"actor": "huo", "lines": [{"template": "霍铎摸了摸石板上的刻痕：‘⊥是落闩，✕是切勿开门，◎指研习长桌旁的传声铜口。这是我的速记习惯。’"} ]})
    if c1_ui_ends(action.id, ".talk.cups_known"):
        result = dv_with(result, "presentation", {"actor": "shen", "lines": [{"template": "沈鼎擦着水槽里的杯子：‘阿泠喜淡茶不加糖，老霍嗜甜必加两勺。我这双手比脑子灵光，早就习惯这么泡茶了。’"} ]})
    if c1_ui_ends(action.id, ".talk.starter_kept"):
        result = dv_with(result, "presentation", {"actor": "shen", "lines": [{"template": "沈鼎揭开陶罐看了看：‘罐壁上留着好几层旧面痕。我喂它的动作这么顺手……可这罐子从哪儿来，谁在这里养过，我想不起来。’"} ]})
    return result

fn c1_player_replay_summary(actor):
    let candidates = dv_find(actor.policy, "hypotheses", [])
    var i = 0
    while i < rt_count(candidates):
        let candidate = candidates[i]
        if dvs_working_explanation(actor, candidate):
            let model = dvs_cached_model(actor, candidate)
            if dv_explanation_model_complete(model, "explained", actor.mind.revision):
                return "重演结果：已有解释与现有观察相符。这仍是推演，尚不是正式答辩。"
        i = i + 1
    if dv_find(actor.policy, "model_budget", 0) <= 0:
        return "这次重演尚未形成能够完整说明现有观察的解释。推演总预算已耗尽。"
    return "这次重演尚未形成能够完整说明现有观察的解释。"

// Source module: language_core/game/presentation.dv
// Authored location bindings. Geometry remains owned by the existing map assets.
fn dvg_place(location):
    let places = {
        "living_hall": {"map": "living_floor", "room": "living_hall:hall", "spawn": "living_hall_east_south"},
        "central_hall": {"map": "central_hall", "room": "central_hall:central_hall"},
        "lecture": {"map": "lecture", "room": "lecture:lecture"},
        "logistics": {"map": "logistics", "room": "logistics:dining"},
        "clinic": {"map": "clinic", "room": "clinic:ward"},
        "greenhouse": {"map": "greenhouse", "room": "greenhouse:greenhouse"},
        "document_workshop": {"map": "archive", "room": "archive:works"},
        "resonance_hall": {"map": "resonance", "room": "resonance:hall"},
        "quiet_room": {"map": "resonance", "room": "resonance:silent"},
        "white_tower_safe": {"map": "clinic", "room": "clinic:safety"},
        "washroom": {"map": "living_floor", "room": "living_hall:bath"},
        "resonance": {"map": "resonance", "room": "resonance:hall"},
        "outdoor_meter": {"map": "campus_n", "room": "campus_n:campus_n", "anchor": "site:outdoor_meter"},
        "outdoor_high": {"map": "campus_n", "room": "campus_n:campus_n", "anchor": "site:outdoor_high"},
        "outdoor_alley": {"map": "campus_sw", "room": "campus_sw:campus_sw", "anchor": "lane_east"},
        "oath_court": {"map": "campus_s", "room": "campus_s:campus_s", "anchor": "site:oath_court"},
        "threshold.contract": {"map": "living_floor", "room": "living_hall:hall", "anchor": "living_hall_west_north"},
        "threshold.astral": {"map": "living_floor", "room": "living_hall:hall", "anchor": "living_hall_west_south"},
        "threshold.logistics": {"map": "living_floor", "room": "living_hall:hall", "anchor": "living_hall_east_north"},
        "dorm.contract": {"map": "living_floor", "room": "zone_jia:hall"},
        "dorm.astral": {"map": "living_floor", "room": "zone_bing:hall"},
        "dorm.logistics": {"map": "living_floor", "room": "zone_ding:hall"},
        "dorm.yi": {"map": "living_floor", "room": "zone_yi:hall"},
        "foyer": {"map": "living_floor", "room": "zone_yi:foyer", "spawn": "zone_yi_from_hall"},
        "hall": {"map": "living_floor", "room": "zone_yi:hall"},
        "R05": {"map": "living_floor", "room": "zone_yi:north_1", "anchor": "site:bed"},
        "R06": {"map": "living_floor", "room": "zone_yi:south_1"},
        "R07": {"map": "living_floor", "room": "zone_yi:south_2"},
        "R08": {"map": "living_floor", "room": "zone_yi:north_2"},
        "corridor": {"map": "living_floor", "room": "zone_yi:corridor"},
        "pantry": {"map": "living_floor", "room": "zone_yi:prep"}}
    return dv_find(places, location, {"map": "", "room": location})

fn dvg_intent(state):
    let intent = dvs_session_intent(state)
    if intent.status == "awaiting_input":
        var options = []
        let actor = state.actors[state.cursor]
        var i = 0
        while i < rt_count(intent.options):
            let option = intent.options[i]
            let action = dvp_find_action(actor.actions, option.id)
            var offered = dv_with_many(option, {"kind": action.kind, "interaction": dvg_interaction(action)})
            if action.kind == "replay":
                offered = dv_with(offered, "replay_input", dvg_manual_replay_input(actor, action))
            rt_push(options, offered)
            i = i + 1
        return dv_with(intent, "options", options)
    if intent.status != "prepared":
        return intent
    let travel = dv_find(intent.action, "travel", [])
    if intent.action.kind != "move" and not dv_has_key(travel, "station"):
        return intent
    let target = dv_find(travel, "to", "")
    let place = dvg_place(target)
    var destination = dv_with_many(place, {"execution_room": place.room, "logical_location": target})
    if dv_has_key(travel, "station"):
        destination = dv_with(destination, "departure_station", travel.station)
    return dv_with(intent, "destination", destination)

// Presentation bindings contain no observed values or additional action admission.
// The host selects from the already admitted IDs; Prepare rechecks the same action.
fn dvg_self_purpose(action):
    if dv_find(action, "known_opportunity_wait", false) or action.kind == "wait":
        return "wait"
    if action.kind == "replay" or action.kind == "infer":
        return "reasoning"
    return "personal"

fn dvg_interaction(action):
    if dv_has_key(action, "interaction"):
        let interaction = action.interaction
        if dv_find(interaction, "kind", "") == "self":
            return dv_with(interaction, "purpose", dv_find(interaction, "purpose", dvg_self_purpose(action)))
        return interaction
    let travel = dv_find(action, "travel", [])
    if action.kind == "move" and dv_has_key(travel, "to"):
        return {"kind": "doorway", "destination": dvg_place(travel.to)}
    if dv_has_key(travel, "station"):
        return {"kind": "site", "site": rt_slice(travel.station, 5, rt_length(travel.station) - 5)}
    let sites = {"E1": "E1", "E2": "E2", "E3": "E2", "E4": "E2", "E5": "E2", "E6": "E6", "E7": "E7", "E8": "transmitter", "E9": "E10", "E10": "E10", "E11": "E11", "E12": "E12"}
    var i = 0
    while i < rt_count(sites):
        if c1_ui_ends(action.id, rt_cat(".inspect.", sites[i][0])):
            return {"kind": "site", "site": sites[i][1]}
        i = i + 1
    let named = {".opening.wake": "bed", ".opening.wear-coat": "E12", ".identify-own-lens": "E12", ".compare_sole": "E2", ".sound_trial": "transmitter", ".reask_question": "transmitter", ".opening.empty-slot": "zone_rules"}
    i = 0
    while i < rt_count(named):
        if c1_ui_ends(action.id, named[i][0]):
            return {"kind": "site", "site": named[i][1]}
        i = i + 1
    if action.kind == "answer":
        return {"kind": "site", "site": "transmitter"}
    let request = dv_find(dv_find(action, "speech", []), "request", [])
    if dv_has_key(request, "target"):
        return {"kind": "person", "person": request.target}
    let listeners = dv_find(action, "listeners", [])
    if rt_count(listeners) == 1:
        return {"kind": "person", "person": listeners[0]}
    return {"kind": "self", "purpose": dvg_self_purpose(action)}

fn dvg_clock(time):
    let minute = rt_floor(time)
    let hour = rt_floor(minute / 60)
    let rest = minute - hour * 60
    var text = rt_show(rest)
    if rest < 10:
        text = rt_cat("0", text)
    return rt_cat(rt_show(hour - rt_floor(hour / 24) * 24), rt_cat(":", text))

fn dvg_presentation(state, viewer):
    var result = dvs_session_presentation(state, viewer)
    let actor = dv_find(result, "actor", "")
    var display = ""
    var i = 0
    while i < rt_count(state.actors):
        if state.actors[i].id == viewer:
            let subject = state.actors[i]
            let name = dv_read(subject.mind, c1_op_person_ref(actor, "name"))
            if dv_uncontested(name):
                display = name.value
            if display == "":
                display = c1_op_known_speaker_label(subject.mind, actor)
            if display == "":
                display = c2d_known_speaker_name(subject.mind, actor)
            if actor == viewer and dv_find(result, "status", "") == "applied" and c1_ui_ends(dv_find(result, "action_id", ""), ".replay"):
                result = dv_with(result, "lines", dv_append(dv_find(result, "lines", []), c1_player_replay_summary(subject)))
        i = i + 1
    return dv_with(result, "speaker_name", display)

fn dvg_cast():
    return {"detective": "detective", "huo": "engineer", "shen": "chef", "su": "musician", "lucian": "poet", "gu": "archaeologist", "quer": "thief", "ward": "lawyer", "selma": "naturalist", "ruan": "chessplayer", "elena": "dancer", "moran": "painter", "veronica": "chemist", "bertrand": "marksman", "margaret": "architect", "mora": "doctor"}

// A navigation destination is not a per-person initial placement.
fn dvg_initial_anchor(actor, location):
    if actor == "detective" and location == "R05":
        return "site:bed"
    return ""

fn dvg_people(state, viewer):
    let sprites = dvg_cast()
    var viewer_mind = state.actors[0].mind
    var viewer_index = 0
    while viewer_index < rt_count(state.actors):
        if state.actors[viewer_index].id == viewer:
            viewer_mind = state.actors[viewer_index].mind
        viewer_index = viewer_index + 1
    var people = []
    var i = 0
    while i < rt_count(state.actors):
        let actor = state.actors[i]
        let position = dv_read(state.physical, c2_position_ref(actor.id))
        if actor.id != viewer and dv_uncontested(position) and dv_has_key(sprites, actor.id):
            let place = dvg_place(position.value)
            if place.map != "":
                var person = {"key": actor.id, "map": place.map, "room": place.room, "execution_room": place.room, "logical_location": position.value, "initial_anchor": dvg_initial_anchor(actor.id, position.value), "spawn": dv_find(place, "spawn", ""), "present": true, "sprite": dv_find(sprites, actor.id, ""), "frame": ""}
                let known_name = dv_read(viewer_mind, c1_op_person_ref(actor.id, "name"))
                var title = "同伴"
                if dv_uncontested(known_name):
                    title = known_name.value
                person = dv_with(person, "title", title)
                if dv_has_key(place, "anchor"):
                    person = dv_with(person, "anchor", place.anchor)
                rt_push(people, person)
        i = i + 1
    return people

// The map adapter gates destination maps. Keep the occupied map available for
// materialization and local movement; only a doorway to another map is gated.
fn dvg_map_access(state, current_map):
    let zones = [{"map": "zone_yi", "group": "living"}, {"map": "zone_jia", "group": "contract"}, {"map": "zone_bing", "group": "astral"}, {"map": "zone_ding", "group": "logistics"}]
    var maps = {"living_hall": true}
    var i = 0
    while i < rt_count(zones):
        let zone = zones[i]
        var condition = c1dep_can_cross()
        if zone.group != "living":
            condition = dv_all([c1_other_claim(zone.group, "outer_latch_released"), dv_fact(c1_other_access_ref(zone.group), true)])
        let opened = dv_truth(state.physical, condition) == "true"
        maps = dv_with(maps, zone.map, opened)
        if current_map == zone.map:
            maps = dv_with(maps, "living_hall", opened)
        i = i + 1
    return maps

// Spatial additions are content declarations. Sampling and safety remain DV actions.
fn dvg_site_titles(map):
    if map == "living_floor":
        return {"bed": {"title": "床"}, "transmitter": {"title": "铜口"}, "zone_rules": {"title": "公告框"}, "E1": {"title": "隔离门"}, "E2": {"title": "门底与木楔"}, "E6": {"title": "苏泠的书桌"}, "E7": {"title": "长桌上的石板"}, "E10": {"title": "备餐柜台"}, "E11": {"title": "置物架"}, "E12": {"title": "风衣"}}
    return {}

fn dvg_sprite_sites(map):
    if map == "living_floor":
        return {"N1Bed": "bed", "N1Coat": "E12", "R05Shelf": "E11", "R05ShelfTrace": "E11", "Transmitter": "transmitter", "InnerBolt": "E1", "Slate": "E7", "Jar": "E10"}
    return {}

fn dvg_geometry_bindings():
    return {"living_floor": {"sites": [{"id": "E12", "point": [2476, 950], "label": "风衣"}], "props": []}, "campus_n": {"sites": [{"id": "outdoor_meter", "point": [672, 1416], "label": "户外仪器阵"}, {"id": "outdoor_high", "point": [672, 1272], "label": "高地通路"}], "props": [{"id": "outdoor_dial", "texture": "res://ShareAsset/Internal/Props/Outdoor/dial_meter.svg", "position": [704, 1416], "footprint": [-10, -8, 20, 8]}]}}

// Read only the owner's stored comparison and still-current direct observations.
// No world reads, model calls, assumption dumps or new knowledge.
fn dvg_replay_comparison(subject, stored, hypothesis, comparison):
    let public = c1_hist_public_feature(dv_find(comparison, "feature", []))
    if public == false:
        return false
    let observed = dv_find(comparison, "observed_cells", [])
    if rt_count(observed) != 1:
        return false
    let input = observed[0]
    if not dv_same(input.ref, public.observation.ref):
        return false
    let cell = input.cell
    let current = dv_read(subject.mind, public.observation.ref)
    if not dv_uncontested(cell) or not dv_uncontested(current):
        return false
    if not dv_same(cell, current) or not (0 < cell.confidence):
        return false
    // A known/inferred Boolean alone is not proof of an acquired observation.
    var observation_action_ids = []
    let claims = dv_find(cell, "claims", [])
    var i = 0
    while i < rt_count(claims):
        let claim = claims[i]
        if claim.subject == subject.id and claim.source == "perception" and 0 < claim.trust:
            if dv_same_local_ref(subject.id, claim.ref, public.observation.ref) and dv_has(subject.mind.seen, claim.id) and dv_same(claim.value, cell.value):
                let dependency = dv_find(claim, "dependency", [])
                // dv_perceive records [action_event, local_ref]; this is the
                // receipt action ID, not the later observation event ID.
                if rt_count(dependency) == 2 and rt_count(claim.id) == 3:
                    if dependency[0] == claim.id[0] and dependency[0] != "inference" and dv_same_local_ref(subject.id, dependency[1], public.observation.ref):
                        if not dv_has(observation_action_ids, dependency[0]):
                            rt_push(observation_action_ids, dependency[0])
        i = i + 1
    if rt_count(observation_action_ids) == 0:
        return false
    let result = dv_find(comparison, "result", "unknown")
    let labels = {"match": "已取得对应观察；这项假设的推演与观察相容。", "contradiction": "已取得对应观察；这项假设的推演与观察矛盾。", "unknown": "已取得对应观察；这项假设的推演尚不足以比对。"}
    return {"title": public.public_observation_label, "text": dv_find(labels, result, labels.unknown), "result": result, "model_event": stored.event, "source_refs": dv_find(hypothesis, "basis", []), "observation_action_ids": observation_action_ids}

// Only models already produced by this viewer's paid replay are readable here.
// Projection does not enumerate policy candidates, run models or grant facts.
fn dvg_manual_history_title(hypothesis, subject):
    let variables = c1_manual_replay_variables()
    let assignments = dv_find(hypothesis, "variable_assignments", [])
    var parts = []
    var i = 0
    while i < rt_count(assignments):
        var j = 0
        while j < rt_count(variables):
            if variables[j].id == assignments[i].variable and dv_truth(subject.mind, dv_find(variables[j], "available_when", dv_true())) == "true":
                let values = variables[j].values
                var k = 0
                while k < rt_count(values):
                    if dv_same(values[k].value, assignments[i].value):
                        if 0 < rt_count(parts):
                            rt_push(parts, "；")
                        rt_push(parts, rt_cat(variables[j].label, rt_cat("：", values[k].label)))
                    k = k + 1
            j = j + 1
        i = i + 1
    return rt_cat("本人提交的组合假设：", rt_text_join(parts))

fn dvg_replay_titles():
    return {"me": "闩门者是自己", "V1_0": "苏泠当时在卧室", "V1_1": "苏泠当时在活动厅", "V1_2": "苏泠当时在茶水间", "V2_0": "霍铎当时在铜口旁", "V2_1": "霍铎当时在卧室", "V2_2": "霍铎当时在门厅", "V3_0": "呼声经过铜管传来", "V3_1": "呼声来自门外的人", "V4_0": "原话是闩门，别开", "V4_1": "原话是开门", "V5_0": "自己选择相信霍铎", "V5_1": "自己选择相信苏泠", "V5_2": "自己没有相信两人", "V6_0": "昨夜之前彼此陌生", "V6_1": "昨夜之前彼此熟悉", "trust": "信任霍铎速记的理由"}

// Read-only public candidate descriptions. No model is run by this projection.
fn dvg_manual_replay_input(actor, action):
    let titles = dvg_replay_titles()
    let manual = dv_with(actor, "manual_input", true)
    let refs = dvp_goal_refs(actor)
    let all = dv_find(actor.policy, "hypotheses", [])
    var named = []
    var cases = []
    var variables = []
    var i = 0
    while i < rt_count(all):
        let candidate = all[i]
        if dvs_manual_candidate_available(actor, candidate) and dvp_eligible(manual, dv_with(action, "replay_hypothesis_id", candidate.id), actor.mind, refs):
            if dv_find(candidate, "group", "") == "six-variable-history":
                var assignments = candidate.variable_assignments
                if dv_truth(actor.mind, c1_manual_history_gate()) != "true":
                    assignments = []
                    var assignment_index = 0
                    while assignment_index < rt_count(candidate.variable_assignments):
                        if candidate.variable_assignments[assignment_index].variable != "V6":
                            rt_push(assignments, candidate.variable_assignments[assignment_index])
                        assignment_index = assignment_index + 1
                rt_push(cases, {"id": candidate.id, "assignments": assignments})
            else:
                if dv_has_key(titles, candidate.id):
                    rt_push(named, {"id": candidate.id, "label": dv_get(titles, candidate.id)})
        i = i + 1
    let declared = c1_manual_replay_variables()
    i = 0
    while i < rt_count(declared):
        if dv_truth(actor.mind, dv_find(declared[i], "available_when", dv_true())) == "true":
            rt_push(variables, dv_without(declared[i], "available_when"))
        i = i + 1
    var assumption = ""
    if dv_truth(actor.mind, c1_manual_history_gate()) != "true":
        assumption = "当前暂按彼此陌生推演，尚未查明。"
    return {"named": named, "variables": variables, "cases": cases, "initial_assumption": assumption}

fn dvg_replay(state, viewer):
    var subject = false
    var actor_index = 0
    while actor_index < rt_count(state.actors):
        if state.actors[actor_index].id == viewer:
            subject = state.actors[actor_index]
        actor_index = actor_index + 1
    if subject == false:
        return {"summary": "", "hypotheses": [], "conflicts": [], "predictions": []}
    let simulations = dv_find(subject, "simulations", [])
    let titles = dvg_replay_titles()
    var rows = []
    var pass = 0
    // Keep the latest paid manual choice visible, followed by produced
    // explanations, so the display cap cannot hide the requested reconstruction.
    while pass < 3 and rt_count(rows) < 16:
        var i = 0
        while i < rt_count(simulations) and rt_count(rows) < 16:
            let stored = simulations[i][1]
            let hypothesis = dv_find(stored, "source_hypothesis", false)
            let explained = dv_find(stored, "status", "") == "explained"
            let selected = hypothesis != false and dv_find(subject, "last_manual_replay", "") == dv_find(hypothesis, "id", "")
            if hypothesis != false and dv_find(stored, "event", "") != "" and ((pass == 0 and selected) or (pass == 1 and explained and not selected) or (pass == 2 and not explained and not selected)):
                let current = dvs_cached_model(subject, hypothesis)
                var status = dv_find(current, "status", "stale-or-unavailable")
                if status == "explained" and not dv_find(stored, "plan_complete", false):
                    status = "unknown"
                let labels = {"explained": "与现有观察相符；仍属推演解释。", "inconsistent": "与已取得的观察存在矛盾。", "unknown": "现有结果不足以完成比对。", "stale-or-unavailable": "这份旧推演需结合当前认识重新核对。", "not-simulated": "尚无可用推演结果。"}
                var lines = [dv_find(labels, status, "这份推演尚未形成确定结论。")]
                if dv_has_key(stored, "plan_complete") and not stored.plan_complete:
                    rt_push(lines, "本次重演未完成，不能据此认定整个假设成立。")
                if not dv_has_key(stored, "plan_complete"):
                    rt_push(lines, "旧记录未保存重演的完成状态。")
                rt_push(lines, rt_cat("该次推演记录的观察比对：", rt_show(rt_count(dv_find(stored, "comparisons", [])))))
                rt_push(lines, rt_cat("该次推演记录的矛盾：", rt_show(rt_count(dv_find(stored, "contradictions", [])))))
                var readable_comparisons = []
                let comparisons = dv_find(stored, "comparisons", [])
                var comparison_index = 0
                while comparison_index < rt_count(comparisons):
                    let readable = dvg_replay_comparison(subject, stored, hypothesis, comparisons[comparison_index])
                    if readable != false:
                        rt_push(readable_comparisons, readable)
                        rt_push(lines, rt_cat(readable.title, rt_cat("：", readable.text)))
                    comparison_index = comparison_index + 1
                if rt_count(readable_comparisons) == 0:
                    rt_push(lines, "暂无可公开的逐项观察比对；未显示的项目不能据此认定成立。")
                if status == "stale-or-unavailable" and 0 < rt_count(readable_comparisons):
                    rt_push(lines, "以上逐项关系来自该次旧推演，尚未重新核对为当前假设结论。")
                var title = dv_find(hypothesis, "label", dv_find(hypothesis, "title", dv_find(titles, hypothesis.id, rt_cat("已执行重演 ", rt_show(i + 1)))))
                if dv_find(hypothesis, "group", "") == "six-variable-history":
                    title = dvg_manual_history_title(hypothesis, subject)
                rt_push(rows, {"title": rt_cat("假设：", title), "lines": lines, "model_event": stored.event, "source_revision": dv_find(stored, "source_revision", -1), "source_refs": dv_find(hypothesis, "basis", []), "status": status, "comparisons": readable_comparisons})
            i = i + 1
        pass = pass + 1
    var summary = "尚未执行重演。调查取得线索后，可从可用行动中发起推演。"
    if 0 < rt_count(simulations):
        summary = rt_cat("本人已有推演记录：", rt_show(rt_count(simulations)))
        if rt_count(rows) < rt_count(simulations):
            summary = rt_cat(summary, rt_cat("；本页显示：", rt_show(rt_count(rows))))
    return {"summary": summary, "hypotheses": rows, "conflicts": [], "predictions": [], "total_records": rt_count(simulations), "shown_records": rt_count(rows)}

// Only the viewer's current logical location is named; no remote positions.
fn dvg_location_title(location):
    let titles = {"R05": "自己的卧室 · R-05", "R06": "霍铎的卧室 · R-06", "R07": "沈鼎的卧室 · R-07", "R08": "苏泠的卧室 · R-08", "hall": "乙区 · 活动厅", "foyer": "乙区 · 门厅", "corridor": "乙区 · 宿舍走廊", "pantry": "乙区 · 备餐间", "living_hall": "生活翼 · 公共起居厅", "washroom": "生活翼 · 盥洗室", "central_hall": "中央厅", "lecture": "讲堂", "logistics": "后勤院 · 食堂", "clinic": "诊疗所", "greenhouse": "温室", "document_workshop": "文献工房", "resonance_hall": "共鸣厅", "resonance": "共鸣厅", "quiet_room": "沉静室", "white_tower_safe": "白塔院 · 安全端", "outdoor_meter": "室外 · 仪器阵", "outdoor_high": "室外 · 高地通路", "outdoor_alley": "室外 · 夹道", "oath_court": "誓约庭", "threshold.contract": "生活翼 · 甲区门外", "threshold.astral": "生活翼 · 丙区门外", "threshold.logistics": "生活翼 · 丁区门外", "dorm.contract": "甲区 · 活动厅", "dorm.astral": "丙区 · 活动厅", "dorm.logistics": "丁区 · 活动厅", "dorm.yi": "乙区 · 活动厅"}
    return dv_find(titles, location, "现场")

fn dvg_snapshot(state, viewer):
    return dvg_snapshot_with_intent(state, viewer, dvg_intent(state))

// A host may reuse this read-only intent only until the next state transition.
// The standalone DV entry above still projects directly from its own state.
fn dvg_snapshot_with_intent(state, viewer, intent):
    let position = dv_read(state.physical, c2_position_ref(viewer))
    var place = {"map": "", "room": ""}
    var logical_location = ""
    if dv_uncontested(position):
        logical_location = position.value
        let located = dvg_place(position.value)
        if located.map != "":
            place = located
    let cast = dvg_cast()
    let opened = dv_truth(state.physical, dv_fact(c1dep_ref("open"), true)) == "true"
    var snapshot = {"chapter": dv_find(state.story, "chapter", 1), "game_time": state.physical.time, "active": dvs_session_active(state), "viewer": viewer, "resource": "res://scenes/Chapter2/Field/CampusMapView.tscn", "map": place.map, "room": place.room, "execution_room": place.room, "logical_location": logical_location, "initial_anchor": dvg_initial_anchor(viewer, logical_location), "spawn": dv_find(place, "spawn", ""), "field_enabled": true, "player_control": dv_find(state, "player_actor", "") == viewer, "initial_placements": [], "hud": {"title": "安眠者有福", "room": dvg_location_title(logical_location), "time": dvg_clock(state.physical.time)}, "access": {"dorms": true, "isolation_open": opened, "door_prints": false, "maps": dvg_map_access(state, place.map)}, "sites": dvg_site_titles(place.map), "geometry_bindings": dvg_geometry_bindings(), "traces": dvg_traces(state.physical), "people": dvg_people(state, viewer), "presentation": {"player_actor": viewer, "player_sprite": dv_find(cast, viewer, "")}, "cast": cast, "pending": intent, "chapter_summary": dvg_chapter_summary(state)}
    if dv_has_key(place, "anchor"):
        snapshot = dv_with(snapshot, "anchor", place.anchor)
    snapshot = dv_with(snapshot, "replay", dvg_replay(state, viewer))
    return dv_with(snapshot, "sprite_sites", dvg_sprite_sites(place.map))

// A system closing record is not fed into any actor's cognition or choices.
fn dvg_chapter_summary(state):
    if dv_find(state.story, "chapter", 1) != 2:
        return false
    if dv_truth(state.physical, dv_fact(c2daily_ref("council_closed"), true)) != "true":
        return false
    return c2daily_chapter_summary(state.physical)

// Source module: language_core/game/campaign.dv
// Production composition. Chapter content owns its transition conditions.
fn dvg_open():
    return dvg_open_config({"seed": 1, "profile": "Standard_Detective", "detective_zone": "zone_yi"})

// UI ownership and viewing are host configuration, separate from campaign rules.
fn dvg_host_open(options):
    let controller = dv_find(options, "controller", "player")
    let viewer = dv_find(options, "viewer", "detective")
    dv_require(dv_has(["player", "ai"], controller), "Unsupported host controller")
    var state = dvg_open_config(dv_find(options, "campaign", {}))
    var found = false
    var i = 0
    while i < rt_count(state.actors):
        let actor = state.actors[i]
        if actor.id == viewer:
            found = true
            dv_require(dv_has_key(dvg_cast(), viewer), "Host viewer has no visual cast binding")
            dv_require(dv_local(state.bindings, viewer, viewer) != "", "Host viewer has no projection binding")
            let position = dv_read(state.physical, actor.location_ref)
            dv_require(dv_uncontested(position), "Host viewer has no settled location")
            dv_require(dvg_place(position.value).map != "", "Host viewer has no map binding")
        i = i + 1
    dv_require(found, "Unknown host viewer")
    var player = ""
    if controller == "player":
        player = viewer
    state = dvs_set_player(state, player)
    return dvs_owned_state_update(state, {"story": dv_with(state.story, "host_viewer", viewer)})

fn dvg_host_viewer(state):
    return dv_find(state.story, "host_viewer", "detective")

// Configuration is retained as evidence and carried into chapter policy inheritance.
fn dvg_run_config(config):
    let result = {"seed": dv_find(config, "seed", 1), "profile": dv_find(config, "profile", "Standard_Detective"), "detective_zone": dv_find(config, "detective_zone", "zone_yi"), "su_initial_room": dv_find(config, "su_initial_room", "hall"), "private_execution_benefit_multiplier": dv_find(config, "private_execution_benefit_multiplier", 1), "homecoming_negotiation": dv_find(config, "homecoming_negotiation", false)}
    dv_require(rt_floor(result.seed) == result.seed and 0 <= result.seed, "Opening seed must be a nonnegative integer")
    dv_require(dv_has(["hall", "R08", "R05"], result.su_initial_room), "Unsupported initial Su room")
    dv_require(result.private_execution_benefit_multiplier == 1 or result.private_execution_benefit_multiplier == 2, "Private execution benefit multiplier must be 1 or 2")
    dv_require(result.homecoming_negotiation == true or result.homecoming_negotiation == false, "Homecoming negotiation must be boolean")
    return result

fn dvg_configure_actor_policies(scene, config):
    var actors = []
    var i = 0
    while i < rt_count(scene.actors):
        let actor = scene.actors[i]
        var actions = actor.actions
        let initial_profile = dv_find(dv_find(actor, "cognitive_initialization", []), "profile", [])
        if dv_find(actor.policy, "allow_manipulation_candidates", dv_find(initial_profile, "allow_manipulation_candidates", false)):
            actions = []
            var j = 0
            while j < rt_count(actor.actions):
                var action = actor.actions[j]
                let speech = dv_find(action, "speech", [])
                if dv_find(action, "manipulation", false) != false or dv_find(speech, "manipulation", false) != false:
                    action = dv_with(action, "manual_only", false)
                rt_push(actions, action)
                j = j + 1
        rt_push(actors, dv_with_many(actor, {"actions": actions, "policy": dv_with_many(actor.policy, {"private_execution_benefit_multiplier": config.private_execution_benefit_multiplier, "homecoming_negotiation": config.homecoming_negotiation})}))
        i = i + 1
    return dv_with_many(scene, {"actors": actors, "run_config": config})

// Relocation changes only the actual room and its owner's initial self-location.
// Existing identity bindings are retained; no third-party location or sound is granted.
fn dvg_configure_initial_room(scene, config):
    if config.su_initial_room == "hall":
        return scene
    let basis = [{"path": "user:current-request", "line": 0, "id": "counterfactual-su-initial-room"}]
    let ref = dv_ref("su", "state", "location")
    dv_require(dv_local(scene.bindings, "su", "su") == "su", "Su initial location requires its existing identity binding")
    let physical = dv_store(scene.physical, ref, dv_with(dv_field(config.su_initial_room), "basis", basis))
    var actors = []
    var i = 0
    while i < rt_count(scene.actors):
        var actor = scene.actors[i]
        if actor.id == "su":
            actor = dv_with_many(actor, {"location": config.su_initial_room, "mind": dv_store(actor.mind, actor.location_ref, dv_with(dv_field(config.su_initial_room), "basis", basis))})
        rt_push(actors, actor)
        i = i + 1
    return dv_with_many(scene, {"physical": physical, "actors": actors})

// Initial configuration changes the declared cognition and starting room only.
// Budgets and receipts retain their production contracts; no result is seeded.
fn dvg_open_config(config):
    let run_config = dvg_run_config(config)
    var scene = c1n_install_scene(c1dep_install_scene(c1_campaign_scene()))
    scene = dvg_configure_initial_room(scene, run_config)
    let zone = dv_find(config, "detective_zone", "zone_yi")
    let profile = dv_find(config, "profile", "Standard_Detective")
    if zone != "zone_yi":
        scene = c1_other_place_detective(scene, zone, profile)
    scene = c1c_install_scene(scene, dv_find(config, "seed", 1), profile)
    scene = dv_with_many(scene, {"chapter": 1, "game_duration_budget": 5 * 1440 - scene.physical.time, "execution_scope": "DV production session; Godot execution receipts; offscreen non-movement uses DV world laws"})
    scene = dvg_configure_actor_policies(scene, run_config)
    return dvs_session_open(c1_player_scene(scene), "enabled")

fn dvg_chapter_two_ready(state):
    return c1n_morning_ready(state.physical)

fn dvg_extend(state):
    if dv_find(state.story, "chapter", 0) != 1 or not dvg_chapter_two_ready(state):
        return state
    let live = dv_with_many(state.story, {"physical": state.physical, "actors": state.actors, "bindings": state.bindings})
    let expanded = dvg_configure_actor_policies(dv_with(c2h_install_scene(c2daily_install_scene(c2d_install_scene(c2_extend_scene(live)))), "chapter", 2), dvg_run_config(dv_find(state.story, "run_config", [])))
    var events = state.events
    dvs_event(events, "chapter_content_available", "", state.physical.time, [], {"chapter": 2, "source": c2_approved("chapter-state-inheritance"), "movement": false})
    // Content availability neither relocates a resident nor grants perceptions.
    return dvs_owned_state_update(state, {"story": expanded, "physical": expanded.physical, "actors": expanded.actors, "bindings": expanded.bindings, "events": events, "horizon": 5 * 1440, "duration_budget": 5 * 1440 - state.run_start, "idle": 0})

fn dvg_refresh_goals(current):
    var actors = current.actors
    var i = current.cursor
    var changed = false
    let chapter = dv_find(current.story, "chapter", 1)
    // The production scheduler selects the actor before content preparation.
    while i < current.cursor + 1:
        let actor = current.actors[i]
        if dv_find(actor, "scheduled_action", false) == false and (dv_has(c2_people(), actor.id) or actor.id == "demon") and (actor.mind.revision != dv_find(actor, "campaign_goals_revision", -1) or actor.mind.time != dv_find(actor, "campaign_goals_time", -1) or chapter != dv_find(actor, "campaign_goals_chapter", 0)):
            var refreshed = actor
            if chapter == 1:
                if actor.id != "demon":
                    refreshed = c1n_refresh_actor_goals(actor)
                actors = dvs_replace(actors, i, dv_with_many(refreshed, {"campaign_goals_revision": actor.mind.revision, "campaign_goals_time": actor.mind.time, "campaign_goals_chapter": chapter}))
            else:
                let needs_c1_wait = (actor.id == "selma" and dv_truth(actor.mind, c1_other_claim("astral", "west_passage_checked")) != "true") or (actor.id == "mora" and dv_truth(actor.mind, c1_other_claim("logistics", "observation_complete")) != "true")
                let in_living = (dv_truth(actor.mind, c2_at(actor.id, "living_hall")) == "true")
                let case_open = (dv_truth(actor.mind, c2d_case_gate(actor.mind)) == "true")
                // Goal windows, speech receipts and daily protocol fields all
                // participate; an investigation-only signature misses these inputs.
                refreshed = c2h_refresh_actor(c2d_refresh_actor_goals(actor))
                refreshed = c1n_known_future_wait_actor(refreshed)
                actors = dvs_replace(actors, i, dv_with_many(refreshed, {"campaign_goals_revision": actor.mind.revision, "campaign_goals_time": actor.mind.time, "campaign_goals_chapter": chapter, "c2_goals_in_living": in_living, "c2_goals_case_open": case_open, "c2_goals_needs_wait": needs_c1_wait}))
            changed = true
        i = i + 1
    if changed:
        return dvs_owned_state_update(current, {"actors": actors})
    return current

fn dvg_prepare(state):
    var current = dvg_extend(state)
    while dvs_session_active(current) and dv_find(current, "pending", false) == false and not dv_find(current, "awaiting_player", false):
        if dv_find(current, "player_selection", "") == "":
            rt_phase("schedule-start", "")
            current = dvs_schedule(current)
            rt_phase("schedule-end", "")
        if dv_find(current, "pending", false) == false and dvs_session_active(current):
            rt_phase("goals-start", "")
            current = dvg_refresh_goals(current)
            rt_phase("goals-end", "")
            current = dvs_prepare_actor(current)
        if dv_find(current, "pending", false) == false:
            current = dvg_extend(current)
    return current

fn dvg_complete(state, receipt):
    return dvg_extend(dvs_session_complete(state, receipt))

// Geometry identifiers bind to native authored material facts, never an oracle.
fn dvg_traces(world):
    let mapping = {"ash": "ash_wedge", "boots": "boots_toward_bolt", "cloth": "cloth_after_boots", "dent": "fork_dent", "joint_west": "pipe_layout", "joint_east": "pipe_layout", "shelf_R05": "shelf_old", "shelf_R06": "shelf_old", "shelf_R07": "shelf_old", "shelf_R08": "shelf_old", "shelf_EN": "shelf_old", "shelf_ES": "shelf_old"}
    var result = []
    var i = 0
    while i < rt_count(mapping):
        result = dv_with(result, mapping[i][0], dv_truth(world, dv_fact(c1_knowledge(mapping[i][1]), true)) == "true")
        i = i + 1
    return result

// Reporting selection only; all residents retain the same decision mechanism.
fn dvg_tracked_actors():
    return dvg_debug_config().actors

fn dvg_chronological_trace(state):
    return dv_debug_events(state.events, 0, dvg_debug_config()).events

// Bounded formal-model adapter; false uses the authored session action limit.
// Returns the live state without closing it or resetting at chapter expansion.
fn dvg_run_campaign(max_steps):
    var state = dvg_open()
    var limit = max_steps
    if limit == false:
        limit = state.limit
    dv_require(0 <= limit, "Negative campaign step limit")
    var steps = 0
    while dvs_session_active(state) and steps < limit:
        state = dvg_prepare(state)
        let pending = dv_find(state, "pending", false)
        if pending != false:
            state = dvg_complete(state, {"action_event": pending.action_event, "outcome": "applied", "actual": pending.model.actual, "executor": "formal-model"})
            steps = steps + 1
    return state

// Source module: language_core/game/entry.dv
// Production composition and read-only diagnostic configuration.

fn dvg_debug_config():
    return {"viewer": "detective", "actors": [], "event_types": [], "max_steps": false, "phase_progress": false}

// Read-only stopping evidence; these limits never mean narrative completion.
fn dvg_debug_stop_evidence(state, steps, limit):
    var actors = []
    var reasons = []
    var i = 0
    while i < rt_count(state.actors):
        let actor = state.actors[i]
        rt_push(actors, {"actor": actor.id, "action_quota": dv_find(actor.policy, "budget", 0), "reason_budget": dv_find(actor.policy, "reason_budget", 0), "model_budget": dv_find(actor.policy, "model_budget", 0), "planning_limit": dv_find(actor, "planning_limit", 0), "scheduled_action": dv_find(actor, "scheduled_action", false), "can_act": dvs_actor_can_act(actor)})
        i = i + 1
    if limit <= steps:
        rt_push(reasons, "diagnostic-action-window")
    if state.limit <= state.executed:
        rt_push(reasons, "session-action-limit")
    if state.horizon <= state.physical.time:
        rt_push(reasons, "world-horizon")
    if state.duration_blocked:
        rt_push(reasons, "action-exceeds-remaining-time")
    if rt_count(state.actors) <= state.idle and dvs_scheduled_count(state.actors) == 0:
        rt_push(reasons, "no-scheduled-or-admissible-action")
    return {"reasons": reasons, "actors": actors, "executed": state.executed, "session_limit": state.limit, "diagnostic_limit": limit, "game_time": state.physical.time, "horizon": state.horizon, "idle": state.idle, "scheduled_count": dvs_scheduled_count(state.actors), "narrative_completion": "see-actual-closing-record", "chapter_summary": dvg_chapter_summary(state)}

// Projection buffering changes diagnostic delivery only. Every dvs_event still
// commits its original value to the raw DAG before the event is published.
fn dvg_debug_flush(state, presentations, cursor, config, steps, projection_every):
    var i = 0
    while i < rt_count(presentations):
        rt_json_print(presentations[i])
        i = i + 1
    let batch = dv_debug_events(state.events, cursor, config)
    rt_json_print({"type": "debug_events", "batch": batch, "through_step": steps, "projection_every": projection_every})
    return batch.next

fn dvg_debug_completion(events, action_event):
    var i = rt_count(events) - 1
    while 0 <= i:
        let execution = events[i]
        if execution.type == "action_execution" and rt_count(execution.parents) == 1:
            let host = dvs_find_event_by_id(events, execution.parents[0])
            if host != false and host.type == "host_completion" and host.actor == execution.actor and dv_find(host.data, "action_event", "") == action_event:
                return {"host_event": host.id, "execution_event": execution.id, "actor": execution.actor, "action_event": action_event, "status": execution.data.receipt.execution.status}
        i = i - 1
    rt_fail("Stage checkpoint has no matching actual execution and host receipt")
    return false

fn dvg_debug_stage(state, config, run_config, steps, boundary, before_time, action_event, inherited_events, provenance):
    dv_require(dv_find(state, "pending", false) == false, "Stage checkpoint requires a completed action with no pending receipt")
    let last = rt_count(state.events) - 1
    dv_require(0 <= last, "Stage checkpoint requires actual event evidence")
    let completion = dvg_debug_completion(state.events, action_event)
    return {"format": "dv-debug-stage-v1", "completion": completion, "executed": state.executed, "after_complete": true, "boundary": boundary, "before_time": before_time, "game_time": state.physical.time, "steps": steps, "completed_action_event": action_event, "last_event": state.events[last].id, "inherited_event_count": inherited_events, "debug_config": config, "run_config": run_config, "provenance": provenance, "state": state}

// Both fresh and explicitly restored runs use this exact prepare/complete loop.
fn dvg_debug_loop(initial, config, run_config, initial_steps, initial_cursor, resumed):
    var state = initial
    var raw_format = "dag"
    if 3 < rt_arg_count():
        raw_format = rt_arg(3)
    var projection_every = 1
    if 8 < rt_arg_count():
        projection_every = rt_number(rt_arg(8))
    dv_require(0 < projection_every and rt_floor(projection_every) == projection_every, "Projection batch must be a positive integer")
    var provenance = []
    if 9 < rt_arg_count() and rt_arg(9) != "":
        provenance = rt_json_parse(rt_read(rt_arg(9)))
    dv_require(projection_every == 1 or raw_format == "dag", "Batched projection requires complete online raw DAG evidence")
    var cursor = initial_cursor
    var steps = initial_steps
    var last_flush_steps = steps
    var presentations = []
    var last_complete_time = state.physical.time
    var limit = state.limit
    if config.max_steps != false:
        limit = config.max_steps
    dv_require(0 < limit, "Debug max_steps must be positive or false for the authored limit")
    var inherited_events = 0
    if resumed:
        inherited_events = rt_count(state.events)
    rt_json_print({"type": "debug_start", "configuration": config, "run_config": run_config, "executor": "formal-model", "geometry": false, "raw_format": raw_format, "projection_every": projection_every, "resumed": resumed, "initial_steps": steps, "inherited_event_count": inherited_events, "run_start_game_time": state.physical.time, "presentation_scope": "stdout contains flushed projection only; every original committed event remains in raw DAG"})
    while dvs_session_active(state) and steps < limit:
        let before_time = last_complete_time
        state = dvg_prepare(state)
        let pending = dv_find(state, "pending", false)
        if pending != false:
            state = dvg_complete(state, {"action_event": pending.action_event, "outcome": "applied", "actual": pending.model.actual, "executor": "formal-model"})
            steps = steps + 1
            let presentation = dvg_presentation(state, config.viewer)
            if dv_find(presentation, "visible", false):
                rt_push(presentations, rt_snapshot({"type": "player_presentation", "step": steps, "viewer": config.viewer, "presentation": presentation}))
            if raw_format == "dag" and 0 < rt_count(provenance):
                if before_time < 2880 and 2880 <= state.physical.time:
                    rt_raw_checkpoint("stage-day3", dvg_debug_stage(state, config, run_config, steps, 2880, before_time, pending.action_event, inherited_events, provenance))
                if before_time < 5760 and 5760 <= state.physical.time:
                    rt_raw_checkpoint("stage-day5", dvg_debug_stage(state, config, run_config, steps, 5760, before_time, pending.action_event, inherited_events, provenance))
            last_complete_time = state.physical.time
        if projection_every == 1 or projection_every <= steps - last_flush_steps:
            cursor = dvg_debug_flush(state, presentations, cursor, config, steps, projection_every)
            presentations = []
            last_flush_steps = steps
    if cursor < rt_count(state.events) or 0 < rt_count(presentations):
        cursor = dvg_debug_flush(state, presentations, cursor, config, steps, projection_every)
    let active = dvs_session_active(state)
    rt_json_print({"type": "debug_end", "steps": steps, "active": active, "game_time": state.physical.time, "action_bound_reached": steps == limit, "stop_evidence": dvg_debug_stop_evidence(state, steps, limit)})
    let trace = dvs_session_close(state)
    rt_json_print({"type": "debug_events", "batch": dv_debug_events(trace.events, cursor, config), "through_step": steps, "projection_every": projection_every})
    if raw_format == "dag":
        return rt_raw_finish({"trace": trace, "last_live_session": state})
    rt_fail("JSON recording is forbidden")
    return false

// Fresh initialization is never used by the restore entry.
fn dvg_debug_run():
    let config = dvg_debug_config()
    var raw_format = "dag"
    if 3 < rt_arg_count():
        raw_format = rt_arg(3)
    dv_require(raw_format == "dag", "Unknown raw evidence format")
    if raw_format == "dag":
        rt_raw_open(rt_arg(0))
    var run_config = {"seed": 1, "profile": "Standard_Detective", "detective_zone": "zone_yi"}
    if 1 < rt_arg_count():
        run_config = dv_with(run_config, "profile", rt_arg(1))
    if 2 < rt_arg_count():
        run_config = dv_with(run_config, "detective_zone", rt_arg(2))
    if 4 < rt_arg_count():
        run_config = dv_with(run_config, "seed", rt_number(rt_arg(4)))
    if 5 < rt_arg_count():
        run_config = dv_with(run_config, "su_initial_room", rt_arg(5))
    if 6 < rt_arg_count():
        run_config = dv_with(run_config, "private_execution_benefit_multiplier", rt_number(rt_arg(6)))
    if 7 < rt_arg_count():
        dv_require(rt_arg(7) == "true" or rt_arg(7) == "false", "Homecoming negotiation argument must be true or false")
        run_config = dv_with(run_config, "homecoming_negotiation", rt_arg(7) == "true")
    run_config = dvg_run_config(run_config)
    var state = dvg_open_config(run_config)
    state = dvs_owned_state_update(state, {"story": dv_with(state.story, "debug_phase_progress", dv_find(config, "phase_progress", false))})
    if raw_format == "dag":
        rt_raw_checkpoint("initial", state)
    return dvg_debug_loop(state, config, run_config, 0, 0, false)

// Loaded by the tagged-Save C# adapter after Python provenance validation.
fn dvg_debug_resume(checkpoint):
    dv_require(checkpoint.format == "dv-debug-stage-v1" and checkpoint.after_complete == true, "Unsupported or uncompleted checkpoint")
    dv_require(rt_arg(3) == "dag", "Restored runs require online raw DAG")
    dv_require(dv_same(checkpoint.run_config, checkpoint.state.story.run_config), "Checkpoint configuration differs from saved session")
    dv_require(dv_find(checkpoint.state, "pending", false) == false, "Checkpoint still awaits a completion receipt")
    let current_provenance = rt_json_parse(rt_read(rt_arg(9)))
    dv_require(dv_same(checkpoint.provenance.source_hashes, current_provenance.source_hashes), "Restore source fingerprints differ")
    dv_require(dv_same(checkpoint.run_config, current_provenance.run_config), "Restore requested configuration differs")
    rt_raw_open(rt_arg(0))
    rt_raw_checkpoint("initial", checkpoint.state)
    rt_raw_checkpoint("resume-origin", dv_without(checkpoint, "state"))
    return dvg_debug_loop(checkpoint.state, checkpoint.debug_config, checkpoint.run_config, checkpoint.steps, rt_count(checkpoint.state.events), true)
