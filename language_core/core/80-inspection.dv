; Inspector reads committed checkpoints, not reconstructed or omniscient minds.
(defn dv_checkpoint (world time)
  (dv_m3 "time" time "revision" (dv_get world "revision") "world" (dv_clone world)))
(defn dv_session (worlds time time_unit)
  (let (catalog (rt_list) history (rt_list) subjects (rt_list) i 0)
    (do
      (dv_require (rt_not (rt_lt time 0)) "Negative session time")
      (while (rt_lt i (rt_count worlds))
        (let (world (rt_at worlds i) id (dv_get world "id") domain (dv_get world "domain"))
          (do
            (dv_require (dv_or (rt_eq domain "physical") (rt_eq domain "mind")) "Predictions cannot be committed as worlds")
            (dv_require (rt_not (dv_has_key catalog id)) "Duplicate world identity")
            (if (rt_eq domain "mind")
              (do (dv_require (rt_not (dv_has subjects (dv_get world "subject"))) "Duplicate subject world") (rt_push subjects (dv_get world "subject"))) false)
            (set catalog (dv_with catalog id world))
            (rt_push history (dv_checkpoint world time))
            (set i (rt_add i 1)))))
      (dv_m4 "worlds" catalog "history" history "time" time "time_unit" time_unit))))
(defn dv_session_commit (session expected_revision world time)
  (let (catalog (dv_get session "worlds") id (dv_get world "id") old (dv_get catalog id))
    (do
      (dv_require (rt_eq (dv_get old "revision") expected_revision) "Stale session commit")
      (dv_require (rt_lt expected_revision (dv_get world "revision")) "Commit needs a newer world revision")
      (dv_require (dv_and (rt_eq (dv_get old "domain") (dv_get world "domain")) (rt_eq (dv_get old "subject") (dv_get world "subject"))) "World identity changed")
      (dv_require (rt_not (rt_lt time (dv_get session "time"))) "Session time cannot move backwards")
      (dv_with (dv_with (dv_with session "worlds" (dv_with catalog id world))
        "history" (dv_append (dv_get session "history") (dv_checkpoint world time))) "time" time))))
(defn dv_session_advance (session time)
  (do (dv_require (rt_not (rt_lt time (dv_get session "time"))) "Session time cannot move backwards") (dv_with session "time" time)))
(defn dv_active_worldview (world)
  (let (adoptions (dv_get world "adoptions") result (rt_list) i 0 policies (dv_find world "policies" (rt_list)) accepted_policies (rt_list))
    (do (while (rt_lt i (rt_count adoptions))
      (let (entry (rt_at adoptions i))
        (do (if (dv_get (rt_at entry 1) "active") (rt_push result (dv_clone entry)) false) (set i (rt_add i 1)))))
      (set i 0)
      (while (rt_lt i (rt_count policies))
        (let (entry (rt_at policies i))
          (do (if (dv_get (rt_at entry 1) "active") (rt_push accepted_policies (dv_clone entry)) false) (set i (rt_add i 1)))))
      (dv_m2 "laws" result "value_policies" accepted_policies))))
(defn dv_inspect_content (world command object_id facet)
  (if (rt_eq command "worldview") (dv_active_worldview world)
    (if (rt_eq command "state") (dv_clone (dv_get world "objects"))
      (if (rt_eq command "slice")
        (let (objects (dv_get world "objects") fields (rt_list))
          (do
            (if (dv_has_key objects object_id)
              (let (facets (dv_get (dv_get objects object_id) "facets") values (dv_find facets facet (rt_list)) i 0)
                (while (rt_lt i (rt_count values)) (do (rt_push fields (rt_at (rt_at values i) 0)) (set i (rt_add i 1))))) false)
            (dv_slice world object_id facet fields)))
        (rt_fail "Inspector command must be worldview, state or slice")))))
(defn dv_inspect_at (session subject time command object_id facet)
  (do
    (dv_require (rt_not (rt_lt (dv_get session "time") time)) "Requested time has not been reached")
    (let (history (dv_get session "history") i 0 found false chosen false)
      (do
        (while (rt_lt i (rt_count history))
          (let (checkpoint (rt_at history i) world (dv_get checkpoint "world"))
            (do
              (if (dv_and (rt_eq (dv_get world "domain") "mind")
                    (dv_and (rt_eq (dv_get world "subject") subject) (rt_not (rt_lt time (dv_get checkpoint "time")))))
                (do (set found true) (set chosen checkpoint)) false)
              (set i (rt_add i 1)))))
        (if found
          (let (world (dv_get chosen "world"))
            (dv_with (dv_with (dv_with
              (dv_m4 "status" "snapshot" "subject" subject "requested_time" time "checkpoint_time" (dv_get chosen "time"))
              "time_unit" (dv_get session "time_unit")) "revision" (dv_get world "revision")) "content" (dv_inspect_content world command object_id facet)))
          (dv_m3 "status" "no-checkpoint" "subject" subject "requested_time" time))))))
(defn dv_inspector_main ()
  (let (argc (rt_arg_count))
    (do
      (dv_require (dv_or (rt_eq argc 4) (rt_eq argc 6)) "Usage: Inspector session.json subject time worldview|state|slice [object facet]")
      (let (command (rt_arg 3))
        (do
          (dv_require (if (rt_eq command "slice") (rt_eq argc 6) (rt_eq argc 4)) "Wrong inspector argument count")
          (rt_print (rt_json_stringify (dv_inspect_at (rt_json_parse (rt_read (rt_arg 0))) (rt_arg 1) (rt_number (rt_arg 2)) command
            (if (rt_eq argc 6) (rt_arg 4) "") (if (rt_eq argc 6) (rt_arg 5) "")))))))))
