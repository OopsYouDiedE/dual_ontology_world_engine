; Law schema is data. Adoption in each world determines how the schema is used.
(defn dv_true () (dv_m2 "op" "constant" "value" "true"))
(defn dv_fact (ref expected) (dv_m3 "op" "equals" "ref" ref "value" expected))
(defn dv_at_least (ref minimum) (dv_m3 "op" "at_least" "ref" ref "value" minimum))
(defn dv_all (conditions) (dv_m2 "op" "all" "items" conditions))
(defn dv_not (condition) (dv_m2 "op" "not" "item" condition))
(defn dv_truth (world proposition)
  (let (op (dv_get proposition "op"))
    (if (rt_eq op "constant") (dv_get proposition "value")
      (if (rt_eq op "not")
        (let (inner (dv_truth world (dv_get proposition "item")))
          (if (rt_eq inner "unknown") "unknown" (if (rt_eq inner "true") "false" "true")))
        (if (rt_eq op "all")
          (let (items (dv_get proposition "items") i 0 result "true")
            (do (while (rt_lt i (rt_count items))
              (let (truth (dv_truth world (rt_at items i)))
                (do (if (rt_eq truth "false") (set result "false")
                  (if (dv_and (rt_eq truth "unknown") (rt_eq result "true")) (set result "unknown") false)) (set i (rt_add i 1))))) result))
          (let (cell (dv_read world (dv_get proposition "ref")))
            (if (dv_or (rt_not (dv_get cell "known")) (dv_get cell "conflicted")) "unknown"
              (if (rt_eq op "equals")
                (if (dv_same (dv_get cell "value") (dv_get proposition "value")) "true" "false")
                (if (rt_eq op "at_least")
                  (if (rt_lt (dv_get cell "value") (dv_get proposition "value")) "false" "true")
                  (rt_fail "Unknown proposition operator"))))))))))
(defn dv_assign (ref value) (dv_m3 "op" "assign" "ref" ref "value" value))
(defn dv_increment (ref amount) (dv_m3 "op" "increment" "ref" ref "value" amount))
(defn dv_axiom (name version premise effects)
  (dv_m4 "name" name "version" version "premise" (dv_clone premise) "effects" (dv_clone effects)))
(defn dv_instance (id law) (dv_with (dv_with law "schema" (dv_get law "name")) "name" id))
(defn dv_adopt (world law mode confidence basis)
  (do
    (dv_unit confidence)
    (dv_require (if (rt_eq (dv_get world "domain") "physical") (rt_eq confidence 1) true) "Physical laws require certainty")
    (dv_require (rt_lt 0 (rt_count basis)) "Adoption needs a basis")
    (dv_require (rt_not (dv_has_key (dv_get world "adoptions") (dv_get law "name"))) "Duplicate law instance: provide a distinct instance identity")
    (dv_require
      (if (rt_eq (dv_get world "domain") "physical") (rt_eq mode "enforce")
        (dv_and (rt_eq (dv_get world "domain") "mind") (dv_or (rt_eq mode "predict") (dv_or (rt_eq mode "infer") (rt_eq mode "norm")))))
      "Adoption mode is incompatible with world")
    (let (adoption (dv_with (dv_m4 "law" law "mode" mode "confidence" confidence "basis" basis) "active" true))
      (dv_with (dv_with world "adoptions" (dv_with (dv_get world "adoptions") (dv_get law "name") adoption)) "revision" (rt_add (dv_get world "revision") 1)))))
(defn dv_suspend (world name)
  (let (adoptions (dv_get world "adoptions"))
    (dv_with (dv_with world "adoptions" (dv_with adoptions name (dv_with (dv_get adoptions name) "active" false))) "revision" (rt_add (dv_get world "revision") 1))))
(defn dv_reconsider (world law mode confidence basis)
  (let (name (dv_get law "name") previous (dv_get (dv_get world "adoptions") name))
    (let (updated (dv_adopt (dv_with world "adoptions" (dv_without (dv_get world "adoptions") name)) law mode confidence basis))
      (dv_with updated "history" (dv_append (dv_get world "history")
        (dv_m4 "kind" "reconsideration" "previous" previous "current" (dv_get (dv_get updated "adoptions") name) "basis" basis))))))
(defn dv_result (status world changes basis)
  (dv_m4 "status" status "world" (dv_clone world) "changes" changes "basis" basis))
(defn dv_stage (world effects time basis confidence)
  (let (stage (dv_clone world) changes (rt_list) touched (rt_list) i 0 status "ready")
    (do
      (while (dv_and (rt_eq status "ready") (rt_lt i (rt_count effects)))
        (let (effect (rt_at effects i) ref (dv_get effect "ref") op (dv_get effect "op") before (dv_read stage ref))
          (do
            (if (rt_not (dv_has_key (dv_get stage "objects") (dv_get ref "object"))) (set status "unknown-object")
              (if (dv_has touched ref) (set status "duplicate-write")
                (if (dv_and (rt_eq op "increment") (rt_not (dv_get before "known"))) (set status "unknown-state")
                  (do
                    (dv_require (dv_or (rt_eq op "assign") (rt_eq op "increment")) "Unknown effect operator")
                    (let (value (if (rt_eq op "assign") (dv_get effect "value") (rt_add (dv_get before "value") (dv_get effect "value"))))
                      (do
                        (set stage (dv_store stage ref (dv_cell value confidence time basis)))
                        (rt_push changes (dv_m3 "ref" ref "before" before "after" (dv_read stage ref)))
                        (rt_push touched (dv_clone ref))))))))
            (set i (rt_add i 1)))))
      (if (rt_eq status "ready") (dv_result "ready" stage changes basis) (dv_result status world (rt_list) basis)))))
(defn dv_apply_law (world name mode event_id time expected_revision)
  (do
    (dv_require (rt_eq (dv_get world "revision") expected_revision) "Stale world revision")
    (dv_require (rt_not (dv_has (dv_get world "seen") event_id)) "Repeated world event")
    (dv_require (rt_not (rt_lt time (dv_find world "time" 0))) "World time cannot move backwards")
    (let (adoption (dv_get (dv_get world "adoptions") name) law (dv_get adoption "law") basis (dv_get adoption "basis"))
      (if (rt_not (dv_get adoption "active")) (dv_result "not-adopted" world (rt_list) basis)
        (if (rt_not (rt_eq (dv_get adoption "mode") mode)) (dv_result "wrong-adoption-mode" world (rt_list) basis)
          (let (truth (dv_truth world (dv_get law "premise")))
            (if (rt_not (rt_eq truth "true")) (dv_result (rt_cat "premise-" truth) world (rt_list) basis)
              (let (staged (dv_stage world (dv_get law "effects") time basis (dv_get adoption "confidence")))
                (if (rt_not (rt_eq (dv_get staged "status") "ready")) staged
                  (let (next (dv_get staged "world") revision (rt_add expected_revision 1)
                        event (dv_with (dv_with (dv_m4 "id" event_id "time" time "law" name "law_version" (dv_get law "version")) "changes" (dv_get staged "changes")) "basis" basis))
                    (do
                      (set next (dv_with (dv_with (dv_with (dv_with next "revision" revision) "seen" (dv_append (dv_get next "seen") event_id)) "history" (dv_append (dv_get next "history") event)) "time" time))
                      (dv_with (dv_with (dv_result "applied" next (dv_get staged "changes") basis) "event" event_id) "time" time))))))))))))
(defn dv_execute (physical name event_id time expected_revision)
  (do (dv_domain physical "physical") (dv_apply_law physical name "enforce" event_id time expected_revision)))
(defn dv_predict (mind name event_id time expected_revision)
  (do
    (dv_domain mind "mind")
    (let (result (dv_apply_law mind name "predict" event_id time expected_revision))
      (dv_with (dv_with result "world" (dv_with (dv_with (dv_get result "world") "domain" "prediction") "source_revision" expected_revision)) "source_revision" expected_revision))))
(defn dv_infer (mind name event_id time expected_revision)
  (do (dv_domain mind "mind") (dv_apply_law mind name "infer" event_id time expected_revision)))
(defn dv_norm (mind name)
  (do (dv_domain mind "mind")
    (let (adoption (dv_get (dv_get mind "adoptions") name))
      (do (dv_require (rt_eq (dv_get adoption "mode") "norm") "Not a normative adoption")
        (if (dv_get adoption "active") (dv_truth mind (dv_get (dv_get adoption "law") "premise")) "unknown")))))
