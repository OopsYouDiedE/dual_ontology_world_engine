// Observation adaptation is an explicit trusted boundary. Minds receive no world pointer.

fn dv_binding(physical, local, subject):
    return {"physical": physical, "local": local, "subject": subject}

fn dv_local(bindings, physical, subject):
    var i = 0
    var result = ""
    while (i < rt_count(bindings)):
        var binding = bindings[i]
        if dv_and((binding.physical == physical), (binding.subject == subject)):
            dv_require((result == ""), "Ambiguous projection binding")
            result = binding.local
        i = (i + 1)
    return result

fn dv_validate_bindings(bindings, subject):
    var i = 0
    var locals = []
    var physicals = []
    while (i < rt_count(bindings)):
        var b = bindings[i]
        if (b.subject == subject):
            dv_require((0 < rt_length(b.local)), "Empty local identity")
            dv_require((not dv_has(locals, b.local)), "Local projection cannot bind two objects")
            dv_require((not dv_has(physicals, b.physical)), "Ambiguous physical binding")
            rt_push(locals, b.local)
            rt_push(physicals, b.physical)
        i = (i + 1)
    return true

fn dv_project_value(value, bindings, subject):
    if rt_is_list(value):
        if dv_record_like(value):
            if dv_same(dv_find(value, "type", ""), "entity-ref"):
                var local = dv_local(bindings, value.id, subject)
                if (local == ""):
                    return {"known": false, "value": false}
                else:
                    return {"known": true, "value": dv_entity_ref(local)}
            else:
                if dv_or(dv_same(dv_find(value, "type", ""), "ref"), dv_and(dv_has_key(value, "object"), dv_and(dv_has_key(value, "facet"), dv_has_key(value, "field")))):
                    var local = dv_local(bindings, value.object, subject)
                    if (local == ""):
                        return {"known": false, "value": false}
                    else:
                        return {"known": true, "value": dv_scoped_ref(subject, local, value.facet, value.field)}
                else:
                    if dv_has_key(value, "op"):
                        var op = value.op
                        if (op == "constant"):
                            return {"known": true, "value": value}
                        else:
                            if dv_or((op == "equals"), (op == "at_least")):
                                var p_ref = dv_project_value(value.ref, bindings, subject)
                                var p_val = dv_project_value(value.value, bindings, subject)
                                if dv_and(p_ref.known, p_val.known):
                                    return {"known": true, "value": dv_with(dv_with(value, "ref", p_ref.value), "value", p_val.value)}
                                else:
                                    return {"known": false, "value": false}
                            else:
                                if (op == "not"):
                                    var p_item = dv_project_value(value.item, bindings, subject)
                                    if p_item.known:
                                        return {"known": true, "value": dv_with(value, "item", p_item.value)}
                                    else:
                                        return {"known": false, "value": false}
                                else:
                                    if (op == "all"):
                                        var items = value.items
                                        var i = 0
                                        var p_items = []
                                        var all_known = true
                                        while (i < rt_count(items)):
                                            var p_sub = dv_project_value(items[i], bindings, subject)
                                            all_known = dv_and(all_known, p_sub.known)
                                            rt_push(p_items, p_sub.value)
                                            i = (i + 1)
                                        if all_known:
                                            return {"known": true, "value": dv_with(value, "items", p_items)}
                                        else:
                                            return {"known": false, "value": false}
                                    else:
                                        return {"known": false, "value": false}
                    else:
                        var i = 0
                        var items = []
                        var known = true
                        while (i < rt_count(value)):
                            var projected = dv_project_value(value[i], bindings, subject)
                            known = dv_and(known, projected.known)
                            rt_push(items, projected.value)
                            i = (i + 1)
                        return {"known": known, "value": items}
        else:
            var i = 0
            var items = []
            var known = true
            while (i < rt_count(value)):
                var projected = dv_project_value(value[i], bindings, subject)
                known = dv_and(known, projected.known)
                rt_push(items, projected.value)
                i = (i + 1)
            return {"known": known, "value": items}
    else:
        return {"known": true, "value": value}

fn dv_observation(id, subject, ref, value, source, origin, time, trust, dependency):
    dv_unit(trust)
    dv_require((not (time < 0)), "Negative observation time")
    dv_require(dv_has(dv_append(dv_list3("perception", "testimony", "recall"), dv_pair("inference", "initial")), source), "Observations use perception, testimony, recall, inference or initial")
    return dv_with(dv_with(dv_with(dv_with(dv_with({"id": id, "subject": subject, "ref": ref, "value": dv_clone(value)}, "source", source), "origin", origin), "time", time), "trust", trust), "dependency", dependency)

fn dv_perceive(physical, mind, bindings, grants, event_id, time):
    dv_domain(physical, "physical")
    dv_domain(mind, "mind")
    dv_validate_bindings(bindings, mind.subject)
    var observations = []
    var i = 0
    var subject = mind.subject
    while (i < rt_count(grants)):
        var ref = grants[i]
        var local = dv_local(bindings, ref.object, subject)
        var cell = dv_read(physical, ref)
        if dv_and((not (local == "")), cell.known):
            var mapped = dv_project_value(cell.value, bindings, subject)
            var local_ref = dv_scoped_ref(subject, local, ref.facet, ref.field)
            if mapped.known:
                rt_push(observations, dv_observation(dv_list3(event_id, subject, local_ref), subject, local_ref, mapped.value, "perception", "direct", time, 1, dv_pair(event_id, local_ref)))
        i = (i + 1)
    return observations

fn dv_perceive_changes(receipt, mind, bindings, grants):
    dv_require((receipt.status == "applied"), "Only applied world changes can be perceived")
    var changes = receipt.changes
    var exposed = []
    var i = 0
    while (i < rt_count(changes)):
        var ref = changes[i].ref
        if dv_has(grants, ref):
            rt_push(exposed, ref)
        i = (i + 1)
    return dv_perceive(receipt.world, mind, bindings, exposed, receipt.event, receipt.time)

fn dv_observation_profile(source_weights, threshold):
    return {"weights": source_weights, "threshold": dv_unit(threshold)}

fn dv_weight(observation, profile):
    var weights = profile.weights
    var source = observation.source
    var weight = dv_find(weights, source, 1)
    dv_require((not (weight < 0)), "Negative evidence weight")
    return (weight * dv_unit(observation.trust))

fn dv_replace_claim(claims, observation):
    var result = []
    var i = 0
    while (i < rt_count(claims)):
        var old = claims[i]
        if dv_same(old.dependency, observation.dependency):
            false
        else:
            rt_push(result, dv_clone(old))
        i = (i + 1)
    rt_push(result, dv_clone(observation))
    return result

fn dv_aggregate(claims, profile, time):
    var alternatives = []
    var i = 0
    var total = 0
    var best = 0
    var chosen = false
    var best_rel = 0
    while (i < rt_count(claims)):
        var claim = claims[i]
        var weight = dv_weight(claim, profile)
        var value = claim.value
        var j = 0
        var found = false
        var new_items = []
        while (j < rt_count(alternatives)):
            var alternative = alternatives[j]
            if dv_same(alternative[0], value):
                rt_push(new_items, dv_list3(value, (alternative[1] + weight), dv_max(alternative[2], dv_unit(claim.trust))))
                found = true
            else:
                rt_push(new_items, alternative)
            j = (j + 1)
        if dv_or(found, (weight == 0)):
            false
        else:
            rt_push(new_items, dv_list3(value, weight, dv_unit(claim.trust)))
        alternatives = new_items
        total = (total + weight)
        i = (i + 1)
    i = 0
    var distribution = []
    while (i < rt_count(alternatives)):
        var alternative = alternatives[i]
        var weight = alternative[1]
        var rel = alternative[2]
        if (best < weight):
            best = weight
            chosen = alternative[0]
            best_rel = rel
        var local_1 = false
        if (total == 0):
            local_1 = 0
        else:
            local_1 = (weight / total)
        rt_push(distribution, dv_pair(alternative[0], local_1))
        i = (i + 1)
    var local_2 = false
    if (total == 0):
        local_2 = 0
    else:
        local_2 = (best / total)
    var support_share = local_2
    var effective_rel = dv_min(1, dv_max(best_rel, dv_min(1, best)))
    var epistemic_confidence = (support_share * effective_rel)
    var cell = dv_cell(chosen, epistemic_confidence, time, claims)
    return dv_with(dv_with(dv_with(dv_with(dv_with(dv_with(cell, "known", dv_and((0 < total), (not (epistemic_confidence < profile.threshold)))), "conflicted", (1 < rt_count(alternatives))), "claims", claims), "alternatives", distribution), "support_share", support_share), "source_reliability", best_rel)

fn dv_update_mind(mind, observations, expected_revision, profile):
    dv_domain(mind, "mind")
    dv_require((mind.revision == expected_revision), "Stale cognition revision")
    var next = dv_clone(mind)
    var i = 0
    var accepted = []
    var dispositions = []
    while (i < rt_count(observations)):
        var observation = observations[i]
        var id = observation.id
        var ref = observation.ref
        var object_id = ref.object
        dv_require((observation.subject == mind.subject), "Foreign observation")
        dv_require((not dv_has(next.seen, id)), "Repeated observation")
        dv_weight(observation, profile)
        if dv_has_key(next.objects, object_id):
            false
        else:
            next = dv_add_object(next, dv_object(object_id, "perceived", []))
        var old = dv_read(next, ref)
        var time = observation.time
        if (time < old.time):
            rt_push(dispositions, dv_pair(id, "older-than-current"))
        else:
            var is_perception = (observation.source == "perception")
            var local_1 = false
            if dv_and(is_perception, (old.time < time)):
                local_1 = []
            else:
                local_1 = old.claims
            var claims = local_1
            if dv_and(old.known, (rt_count(claims) == 0)):
                if (not dv_and(is_perception, (old.time < time))):
                    claims = dv_single(dv_with(dv_with(dv_with(dv_with(dv_with({"id": dv_pair("initial", ref), "subject": next.subject, "ref": ref, "value": old.value}, "source", "initial"), "origin", "initial"), "time", old.time), "trust", old.confidence), "dependency", dv_pair("initial", ref)))
            var new_time = dv_max(old.time, time)
            next = dv_store(next, ref, dv_aggregate(dv_replace_claim(claims, observation), profile, new_time))
            rt_push(dispositions, dv_pair(id, "updated"))
        next = dv_with(next, "seen", dv_append(next.seen, id))
        rt_push(accepted, dv_clone(observation))
        i = (i + 1)
    var local_2 = false
    if (rt_count(observations) == 0):
        local_2 = expected_revision
    else:
        local_2 = (expected_revision + 1)
    next = dv_with(next, "revision", local_2)
    next = dv_with(next, "history", dv_append(mind.history, {"kind": "observation-batch", "observations": accepted, "dispositions": dispositions}))
    return {"world": next, "dispositions": dispositions, "revision": next.revision}
