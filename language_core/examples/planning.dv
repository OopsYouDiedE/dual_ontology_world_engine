(def! initial-facts '(("object" ((exists true) (tags ((progress 0)))))))
(def! rules '((rule advance (tagged (ref "object") progress 0) prefer (change (ref "object") progress 1) 2 true)
              (rule finish (tagged (ref "object") progress 1) prefer (set (ref "object") done 1) 10 true)))
(def! subjective-view (view "subject" 1 initial-facts '() '() '()))
(def! result (plan rules subjective-view '() 2 100))
(def! best (nth (first (nth result 1)) 2))
(list (list 'planned-path (nth best 1) 'returned-score (nth best 2) 'depth (nth result 2) 'stop (nth result 4)) initial-facts
      (social-assess 1 -2 0 '())
      (retry-cost (remember-attempt '() '(inspect object) 'context-1 'failure) '(inspect object) 'context-1)
      (retry-cost (remember-attempt '() '(inspect object) 'context-1 'failure) '(inspect object) 'context-2))
