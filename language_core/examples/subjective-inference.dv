; Generic mechanism demonstration. No story identities, answers or dialogue.
(def! hypotheses '((h0 (0) ((trace 0))) (h1 (1) ((trace 1)))))
(def! trusted-facts '(("claim" ((exists true))) ("speaker" ((exists true) (tags ((Trust 3)))))))
(def! distrusted-facts '(("claim" ((exists true))) ("speaker" ((exists true) (tags ((Trust -3)))))))
(def! claims '(("claim" 0 1 testimony "speaker" 1)))
(def! a (view "A" 1 trusted-facts '(0) claims '()))
(def! b (view "B" 1 distrusted-facts '(0) claims '()))
(def! ar (case-assess a hypotheses '() '()))
(def! br (case-assess b hypotheses '() '()))
(def! inner (view "B-as-modeled-by-A" 0 '(("object" ((exists true) (tags ((value 1)))))) '() '() '()))
(def! outer (view "A" 1 '(("object" ((exists true) (tags ((value 0)))))) '() '()
  (list (list "B" (list inner '("object") true)))))
(list
  (list 'A-trusted-claim (marginal ar hypotheses 0 1))
  (list 'B-distrusted-claim (marginal br hypotheses 0 1))
  (list 'own-view (mental-evaluate outer '() '(tagged (ref "object") value 1) '()))
  (list 'modeled-other (mental-evaluate outer '("B") '(tagged (ref "object") value 1) '()))
  (list 'absent-model (mental-evaluate outer '("C") '(tagged (ref "object") value 1) '()))
  (list 'explicit-likelihood-update (bayes-update '(distribution ((h0 0.5) (h1 0.5))) '((h0 0.1) (h1 0.9)))))
