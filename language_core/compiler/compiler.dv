; DuelView bootstrap compiler. The complete frontend and C# backend live here.
; AST = [kind, payload, UTF-16 offset]. Checked syntax emits C# directly.
(defn pair (a b) (let (r (rt_list)) (do (rt_push r a) (rt_push r b) r)))
(defn node (kind payload pos)
  (let (r (pair kind payload)) (do (rt_push r pos) r)))
(defn kind (n) (rt_at n 0))
(defn payload (n) (rt_at n 1))
(defn bad (n message)
 (let (source (rt_read (rt_arg 0)) offset (rt_at n 2) i 0 line 1 column 1)
  (do (while (rt_lt i offset)
   (do (if (rt_eq (rt_chr source i) "\n") (do (set line (rt_add line 1)) (set column 1)) (set column (rt_add column 1))) (set i (rt_add i 1))))
   (rt_fail (rt_cat (rt_cat (rt_cat (rt_cat (rt_cat (rt_arg 0) ":") (rt_show line)) ":") (rt_show column)) (rt_cat ": " message))))))

(defn both (a b) (if a b false))
(defn either (a b) (if a true b))
(defn space (c) (either (either (rt_eq c " ") (rt_eq c "\n")) (either (rt_eq c "\r") (rt_eq c "\t"))))
(defn ascii_letter (c)
  (let (n (rt_code c))
    (either (rt_eq c "_") (either (both (rt_lt 64 n) (rt_lt n 91)) (both (rt_lt 96 n) (rt_lt n 123))))))
(defn letter (c) (rt_id_start c))
(defn digit (c) (let (n (rt_code c)) (both (rt_lt 47 n) (rt_lt n 58))))
(defn identifier (s)
  (if (rt_eq (rt_length s) 0) false
    (let (ok (letter (rt_chr s 0)) i 1)
      (do (while (rt_lt i (rt_length s))
        (do (set ok (both ok (either (letter (rt_chr s i)) (digit (rt_chr s i))))) (set i (rt_add i 1)))) ok))))
(defn skip (s start)
  (let (i start running true)
    (do (while (both running (rt_lt i (rt_length s)))
      (let (c (rt_chr s i))
        (if (space c) (set i (rt_add i 1))
          (if (rt_eq c ";")
            (while (if (rt_lt i (rt_length s)) (rt_not (rt_eq (rt_chr s i) "\n")) false) (set i (rt_add i 1)))
            (set running false))))) i)))
(defn hex_digit (c)
  (let (n (rt_code c)) (either (digit c) (either (both (rt_lt 64 n) (rt_lt n 71)) (both (rt_lt 96 n) (rt_lt n 103))))))
(defn scan_string (s start)
  (let (i (rt_add start 1) done false)
    (do
      (while (both (rt_not done) (rt_lt i (rt_length s)))
        (let (c (rt_chr s i))
          (do
            (if (rt_eq c "\"") (set done true)
              (if (rt_eq c "\\")
                (do
                  (set i (rt_add i 1))
                  (if (rt_lt i (rt_length s)) false (rt_fail "DV: unfinished escape"))
                  (let (e (rt_chr s i))
                    (if (rt_eq e "u")
                      (let (k 0) (while (rt_lt k 4)
                        (do (set i (rt_add i 1))
                          (if (rt_lt i (rt_length s)) false (rt_fail "DV: unfinished unicode escape"))
                          (if (hex_digit (rt_chr s i)) false (rt_fail "DV: invalid unicode escape"))
                          (set k (rt_add k 1)))))
                      (if (either (either (rt_eq e "n") (rt_eq e "r")) (either (rt_eq e "t") (either (rt_eq e "\"") (rt_eq e "\\")))) false
                        (rt_fail "DV: unsupported escape")))))
                (if (rt_lt (rt_code c) 32) (rt_fail "DV: control character in string") false)))
            (set i (rt_add i 1)))))
      (if done (pair (node "str" (rt_slice s start (rt_sub i start)) start) i) (rt_fail "DV: unterminated string")))))
(defn parse_one (s start depth)
  (let (i (skip s start))
    (do
      (if (rt_lt depth 129) false (rt_fail "DV: nesting limit"))
      (if (rt_lt i (rt_length s)) false (rt_fail "DV: unexpected end"))
      (let (c (rt_chr s i))
        (if (rt_eq c "(")
          (let (children (rt_list) cursor (skip s (rt_add i 1)) done false)
            (do
              (while (rt_not done)
                (do
                  (if (rt_lt cursor (rt_length s)) false (rt_fail "DV: unclosed list"))
                  (if (rt_eq (rt_chr s cursor) ")") (set done true)
                    (let (parsed (parse_one s cursor (rt_add depth 1)))
                      (do (rt_push children (rt_at parsed 0)) (set cursor (skip s (rt_at parsed 1))))))))
              (pair (node "list" children i) (rt_add cursor 1))))
          (if (rt_eq c ")") (rt_fail "DV: unexpected closing parenthesis")
            (if (rt_eq c "\"") (scan_string s i)
              (let (end i scanning true)
                (do
                  (while (both scanning (rt_lt end (rt_length s)))
                    (let (ch (rt_chr s end))
                      (if (either (space ch) (either (rt_eq ch "(") (either (rt_eq ch ")") (either (rt_eq ch ";") (rt_eq ch "\"")))))
                        (set scanning false) (set end (rt_add end 1)))))
                  (let (token (rt_slice s i (rt_sub end i)))
                    (pair (node (if (rt_is_number token) "num" "sym") token i) end)))))))))))
(defn parse (s)
  (let (result (rt_list) i (skip s 0))
    (do
      (if (rt_lt (rt_length s) 1048577) false (rt_fail "DV: source size limit"))
      (while (rt_lt i (rt_length s))
        (let (p (parse_one s i 0)) (do (rt_push result (rt_at p 0)) (set i (skip s (rt_at p 1)))))) result)))
(defn sym (n)
  (if (rt_eq (kind n) "sym")
    (if (identifier (payload n)) (payload n) (bad n "invalid identifier"))
    (bad n "expected identifier")))
(defn children (n) (if (rt_eq (kind n) "list") (payload n) (bad n "expected list")))
(defn has (items name)
  (let (i 0 found false)
    (do (while (rt_lt i (rt_count items))
      (do (if (rt_eq (rt_at items i) name) (set found true) false) (set i (rt_add i 1)))) found)))
(defn copy (items)
  (let (r (rt_list) i 0)
    (do (while (rt_lt i (rt_count items)) (do (rt_push r (rt_at items i)) (set i (rt_add i 1)))) r)))
(defn words (s)
  (let (nodes (parse s) r (rt_list) i 0)
    (do (while (rt_lt i (rt_count nodes)) (do (rt_push r (payload (rt_at nodes i))) (set i (rt_add i 1)))) r)))
(defn reserved (name) (either (ck_bounded name) (has (words "if let set while do true false") name)))
(defn runtime_name (name) (if (rt_lt (rt_length name) 3) false (rt_eq (rt_slice name 0 3) "rt_")))
(defn native_arity (name)
  (if (has (words "rt_list rt_arg_count") name) 0
    (if (has (words "rt_number rt_is_number rt_is_numeric_value rt_not rt_length rt_code rt_show rt_count rt_is_list rt_copy_value rt_snapshot rt_fail rt_arg rt_read rt_print rt_json_parse rt_json_stringify rt_id_start rt_id_part rt_normalize rt_exact rt_floor") name) 1
      (if (has (words "rt_add rt_sub rt_mul rt_div rt_lt rt_eq rt_memo_get rt_record_with_many rt_same_value rt_cat rt_chr rt_push rt_at rt_write rt_json_write rt_record_index") name) 2
        (if (has (words "rt_slice rt_replace rt_record_find rt_record_with rt_memo_put") name) 3 -1)))))
(defn lookup (signatures name)
  (let (i 0 found -1)
    (do (while (rt_lt i (rt_count signatures))
      (let (entry (rt_at signatures i))
        (do (if (rt_eq (rt_at entry 0) name) (set found (rt_at entry 1)) false) (set i (rt_add i 1))))) found)))
(defn arity (n xs expected) (if (rt_eq (rt_count xs) expected) false (bad n "invalid form arity")))
(defn add_local (n scope)
  (let (name (sym n))
    (if (either (reserved name) (has scope name)) (bad n "reserved, duplicate or shadowed local") (rt_push scope name))))
(defn cs_string (raw)
  (let (i 0 result "")
    (do
      (while (rt_lt i (rt_length raw))
        (let (c (rt_chr raw i) code (rt_code c))
          (do
            (set result (rt_cat result
              (if (rt_eq code 133) "\\u0085"
                (if (rt_eq code 8232) "\\u2028"
                  (if (rt_eq code 8233) "\\u2029" c)))))
            (set i (rt_add i 1)))))
      result)))
(defn emit (n scope signatures)
  (let (tag (kind n) value (payload n))
    (if (rt_eq tag "array") (sf_emit_array n scope signatures)
     (if (rt_eq tag "mapapply") (sf_emit_mapping n scope signatures)
      (if (rt_eq tag "str") (cs_string value)
      (if (rt_eq tag "num") (rt_cat (rt_cat "R.number(\"" value) "\")")
        (if (rt_eq tag "sym")
          (if (either (rt_eq value "true") (rt_eq value "false")) value
            (if (has scope (sym n)) (rt_cat "v_" value) (bad n "unbound local")))
          (emit_form n scope signatures))))))))
(defn emit_form (n scope signatures)
  (let (xs (children n))
    (do
      (if (rt_eq (rt_count xs) 0) (bad n "empty expression") false)
      (let (head (sym (rt_at xs 0)))
        (if (rt_eq head "if")
          (do (arity n xs 4)
            (rt_cat (rt_cat (rt_cat (rt_cat (rt_cat "(R.Bool(" (emit (rt_at xs 1) scope signatures)) ") ? (object)(") (emit (rt_at xs 2) scope signatures)) ") : (object)(") (rt_cat (emit (rt_at xs 3) scope signatures) "))")))
          (if (rt_eq head "let") (emit_let n xs scope signatures)
            (if (rt_eq head "do") (emit_do n xs scope signatures)
              (if (rt_eq head "set")
                (do (arity n xs 3)
                  (let (name (sym (rt_at xs 1)))
                    (do (if (has scope name) false (bad n "assignment to unbound local"))
                      (rt_cat (rt_cat (rt_cat "(v_" name) " = ") (rt_cat (emit (rt_at xs 2) scope signatures) ")")))))
                (if (rt_eq head "while")
                  (do (arity n xs 3)
                    (rt_cat (rt_cat "R.Block(() => {while(R.Bool(" (emit (rt_at xs 1) scope signatures))
                      (rt_cat ")) { _ = " (rt_cat (emit (rt_at xs 2) scope signatures) ";} return false;})"))))
                  (emit_call n xs head scope signatures))))))))))
(defn emit_let (n xs scope signatures)
  (do (arity n xs 3)
    (let (bindings (children (rt_at xs 1)) locals (copy scope) i 0 result "R.Block(() => {")
      (do
        (while (rt_lt i (rt_count bindings))
          (do
            (if (rt_lt (rt_add i 1) (rt_count bindings)) false (bad n "uneven let bindings"))
            (let (name_node (rt_at bindings i) init (emit (rt_at bindings (rt_add i 1)) locals signatures))
              (do (add_local name_node locals)
                (set result (rt_cat result (rt_cat (rt_cat "object v_" (sym name_node)) (rt_cat " = " (rt_cat init ";")))))))
            (set i (rt_add i 2))))
        (rt_cat result (rt_cat "return (object)(" (rt_cat (emit (rt_at xs 2) locals signatures) ");})"))))))
)
(defn emit_do (n xs scope signatures)
  (let (i 1 result "R.Block(() => {")
    (do
      (if (rt_lt 1 (rt_count xs)) false (bad n "empty do"))
      (while (rt_lt i (rt_sub (rt_count xs) 1))
        (do (set result (rt_cat result (rt_cat "_ = " (rt_cat (emit (rt_at xs i) scope signatures) ";")))) (set i (rt_add i 1))))
      (rt_cat result (rt_cat "return (object)(" (rt_cat (emit (rt_at xs i) scope signatures) ");})")))))
)
(defn emit_call (n xs name scope signatures)
 (if (ck_bounded name)
  (do (arity n xs 2) (rt_cat "R.unit(" (rt_cat (emit (rt_at xs 1) scope signatures) ")")))
  (if (if (rt_eq name "rt_mul") (sf_is_mapping_call (rt_at xs 1) signatures) false)
  (sf_emit_mapping (node "mapapply" (pair (rt_at xs 1) (rt_at xs 2)) (rt_at n 2)) scope signatures)
  (let (native (native_arity name) expected (if (rt_lt native 0) (lookup signatures name) native) i 1 result "")
    (do
      (if (rt_lt expected 0) (bad n "unknown function or primitive") false)
      (if (rt_eq expected (rt_sub (rt_count xs) 1)) false (bad n "function arity mismatch"))
      (set result (if (rt_lt native 0) (rt_cat "F_" name) (rt_cat "R." (rt_slice name 3 (rt_sub (rt_length name) 3)))))
      (set result (rt_cat result "("))
      (while (rt_lt i (rt_count xs))
        (do (if (rt_lt 1 i) (set result (rt_cat result ",")) false)
          (set result (rt_cat result (emit (rt_at xs i) scope signatures))) (set i (rt_add i 1))))
      (rt_cat result ")"))))))
(defn signatures_of (forms)
  (let (signatures (rt_list) i 0 mains 0)
    (do
      (while (rt_lt i (rt_count forms))
        (let (n (rt_at forms i) xs (children n))
          (do
            (if (rt_eq (rt_count xs) 0) (bad n "empty declaration") false)
            (let (head (sym (rt_at xs 0)))
              (if (rt_eq head "defn")
                (do (arity n xs 4)
                  (let (name (sym (rt_at xs 1)) params (children (rt_at xs 2)))
                    (do
                      (if (either (reserved name) (either (runtime_name name) (rt_not (rt_lt (lookup signatures name) 0)))) (bad n "duplicate or reserved function") false)
                      (rt_push signatures (sf_list3 name (rt_count params) (if (rt_eq (kind (rt_at xs 3)) "surfacebody") (rt_eq (rt_at (payload (rt_at xs 3)) 1) "Mapping") false))))))
                (if (rt_eq head "main") (do (arity n xs 2) (set mains (rt_add mains 1))) (bad n "unsupported declaration"))))
            (set i (rt_add i 1)))))
      (if (either (rt_eq mains 1) (both (compiler_check_mode) (rt_eq mains 0))) signatures (rt_fail "DV: exactly one main required")))))
(defn emit_function (n signatures)
 (if (rt_eq (kind (rt_at (children n) 3)) "surfacebody") (sf_emit_lowered n signatures)
  (let (xs (children n) name (sym (rt_at xs 1)) params (children (rt_at xs 2)) scope (rt_list) i 0 result (rt_cat "static object F_" name))
    (do
      (set result (rt_cat result "("))
      (while (rt_lt i (rt_count params))
        (let (p (rt_at params i))
          (do (add_local p scope)
            (if (rt_lt 0 i) (set result (rt_cat result ",")) false)
            (set result (rt_cat result (rt_cat "object v_" (sym p)))) (set i (rt_add i 1)))))
      (rt_cat result (rt_cat ") => " (rt_cat (emit (rt_at xs 3) scope signatures) ";\n")))))))
(defn lower_declarations (forms)
  (let (result (rt_list) i 0)
    (do
      (while (rt_lt i (rt_count forms))
        (let (original (rt_at forms i) n (if (rt_eq (kind original) "surface") (sf_lower original) original) xs (children n) offset (rt_at n 2))
          (do
            (if (rt_eq (rt_count xs) 0) (bad n "empty declaration") false)
            (if (rt_eq (sym (rt_at xs 0)) "axiom")
              (do
                (arity n xs 6)
                (let (name (sym (rt_at xs 1)) body (rt_list) declaration (rt_list))
                  (do
                    (rt_push body (node "sym" "dv_axiom" offset))
                    (rt_push body (node "str" (rt_cat (rt_cat "\"" name) "\"") offset))
                    (rt_push body (rt_at xs 2))
                    (rt_push body (rt_at xs 4))
                    (rt_push body (rt_at xs 5))
                    (rt_push declaration (node "sym" "defn" offset))
                    (rt_push declaration (rt_at xs 1))
                    (rt_push declaration (rt_at xs 3))
                    (rt_push declaration (node "list" body offset))
                    (rt_push result (node "list" declaration offset)))))
              (do (rt_push result n)
               (if (if (rt_eq (kind original) "surface") (rt_eq (sym (rt_at xs 1)) "main") false)
                (rt_push result (sf_call "main" (sf_list1 (sf_call "main" (rt_list) offset)) offset)) false)))
            (set i (rt_add i 1))))) result)))
(defn compile (source)
  (let (forms (lower_declarations (compiler_parse source)) checked (ck_program forms) signatures (signatures_of forms) i 0 result "using DuelView.Compiled;\npublic static partial class DVProgram {\n")
    (do
      (while (rt_lt i (rt_count forms))
        (let (n (rt_at forms i) xs (children n))
          (do
            (set result (rt_cat result
              (if (rt_eq (sym (rt_at xs 0)) "defn") (emit_function n signatures)
                (rt_cat "public static int Main(string[] args) { R.Arguments=args; try { _ = "
                  (rt_cat (emit (rt_at xs 1) (rt_list) signatures) "; return 0; } catch(System.Exception e) { System.Console.Error.WriteLine(e.ToString()); return 1; } }\n")))))
            (set i (rt_add i 1)))))
      (rt_cat result "}\n"))))
; Surface frontend. Tokens retain source offsets. All elaboration lives in DV.
(defn sf_list1 (a) (let (r (rt_list)) (do (rt_push r a) r)))
(defn sf_list3 (a b c) (let (r (pair a b)) (do (rt_push r c) r)))
(defn sf_list4 (a b c d) (let (r (sf_list3 a b c)) (do (rt_push r d) r)))
(defn sf_call (name args pos) (node "list" (sf_prepend (node "sym" name pos) args) pos))
(defn sf_prepend (x xs) (let (r (sf_list1 x) i 0) (do (while (rt_lt i (rt_count xs)) (do (rt_push r (rt_at xs i)) (set i (rt_add i 1)))) r)))
(defn sf_scan (s)
 (let (tokens (rt_list) i 0 col 0 line true depth 0)
  (do
   (while (rt_lt i (rt_length s))
    (let (c (rt_chr s i) next (if (rt_lt (rt_add i 1) (rt_length s)) (rt_chr s (rt_add i 1)) ""))
     (if (rt_eq c "\n") (do (set line true) (set col 0) (set i (rt_add i 1)))
      (if (either (rt_eq c " ") (rt_eq c "\r")) (do (if line (set col (rt_add col 1)) false) (set i (rt_add i 1)))
       (if (rt_eq c "\t") (rt_fail "DV surface: use spaces for indentation")
        (if (either (rt_eq c ";") (both (rt_eq c "/") (rt_eq next "/")))
         (while (if (rt_lt i (rt_length s)) (rt_not (rt_eq (rt_chr s i) "\n")) false) (set i (rt_add i 1)))
         (do
          (if (both line (rt_eq depth 0)) (rt_push tokens (node "line" col i)) false)
          (set line false)
          (if (rt_eq c "\"")
           (let (p (scan_string s i)) (do (rt_push tokens (rt_at p 0)) (set i (rt_at p 1))))
           (if (digit c)
            (let (start i) (do
             (while (if (rt_lt i (rt_length s)) (either (digit (rt_chr s i)) (rt_eq (rt_chr s i) ".")) false) (set i (rt_add i 1)))
             (rt_push tokens (node "num" (rt_slice s start (rt_sub i start)) start))))
            (if (rt_id_start c)
             (let (start i) (do
              (while (if (rt_lt i (rt_length s)) (rt_id_part (rt_chr s i)) false) (set i (rt_add i 1)))
              (rt_push tokens (node "sym" (rt_normalize (rt_slice s start (rt_sub i start))) start))))
             (let (two (rt_cat c next) token c)
              (do
               (if (has (words "== != <= >= -> |> ~> >> :=") two) (do (set token two) (set i (rt_add i 1))) false)
               (if (either (rt_eq c "(") (either (rt_eq c "[") (rt_eq c "{"))) (set depth (rt_add depth 1)) false)
               (if (either (rt_eq c ")") (either (rt_eq c "]") (rt_eq c "}"))) (set depth (rt_sub depth 1)) false)
               (rt_push tokens (node "punct" token i)) (set i (rt_add i 1)))))))))))))
   ) (rt_push tokens (node "eof" "EOF" i)) tokens)))
(defn sf_peek (p) (rt_at (rt_at p 0) (rt_at p 1)))
(defn sf_text (p) (payload (sf_peek p)))
(defn sf_take (p) (let (n (sf_peek p)) (do (rt_replace p 1 (rt_add (rt_at p 1) 1)) n)))
(defn sf_is (p text) (rt_eq (sf_text p) text))
(defn sf_expect (p text) (if (sf_is p text) (sf_take p) (bad (sf_peek p) (rt_cat "expected " text))))
(defn sf_name (p) (let (n (sf_take p)) (if (rt_eq (kind n) "sym") n (bad n "expected name"))))
(defn sf_prec (op)
 (if (rt_eq op "|>") 1 (if (rt_eq op "or") 2 (if (rt_eq op "and") 3
  (if (has (words "== != < > <= >=") op) 4 (if (either (rt_eq op "+") (rt_eq op "-")) 5
   (if (has (words "* / ×") op) 6 0)))))))
(defn sf_bin (op left right pos)
 (if (rt_eq op "and") (sf_call "if" (sf_list3 left right (node "sym" "false" pos)) pos)
  (if (rt_eq op "or") (sf_call "if" (sf_list3 left (node "sym" "true" pos) right) pos)
   (if (rt_eq op "×") (node "mapapply" (pair left right) pos)
    (if (rt_eq op "|>")
     (let (xs (children right)) (sf_call (sym (rt_at xs 0)) (sf_prepend left (sf_tail xs)) pos))
     (if (has (words "> <= >= !=") op)
      (if (rt_eq op ">") (sf_call "rt_lt" (pair right left) pos)
       (sf_call "rt_not" (sf_list1 (sf_call (if (rt_eq op "!=") "rt_eq" "rt_lt")
        (if (rt_eq op "<=") (pair right left) (pair left right)) pos)) pos))
      (sf_call (if (rt_eq op "+") "rt_add" (if (rt_eq op "-") "rt_sub" (if (rt_eq op "*") "rt_mul" (if (rt_eq op "/") "rt_div" (if (rt_eq op "<") "rt_lt" "rt_eq"))))) (pair left right) pos)))))))
(defn sf_tail (xs) (let (r (rt_list) i 1) (do (while (rt_lt i (rt_count xs)) (do (rt_push r (rt_at xs i)) (set i (rt_add i 1)))) r)))
(defn sf_expr (p minprec)
 (let (left (sf_atom p) running true)
  (do (while running
   (let (op (sf_text p) prec (if (rt_eq (kind (sf_peek p)) "line") 0 (sf_prec (sf_text p))))
    (if (either (rt_eq prec 0) (rt_lt prec minprec)) (set running false)
     (let (token (sf_take p) right (sf_expr p (rt_add prec 1))) (set left (sf_bin op left right (rt_at token 2))))))) left)))
(defn sf_atom (p)
 (let (n (sf_take p) value (payload n) result n)
  (do
   (if (rt_eq value "-") (set result (sf_call "rt_sub" (pair (node "num" "0" (rt_at n 2)) (sf_expr p 7)) (rt_at n 2)))
    (if (rt_eq value "not") (set result (sf_call "rt_not" (sf_list1 (sf_expr p 7)) (rt_at n 2)))
     (if (rt_eq value "(") (do (set result (sf_expr p 1)) (sf_expect p ")"))
      (if (rt_eq value "[")
       (let (items (rt_list)) (do
        (while (rt_not (sf_is p "]")) (do (rt_push items (sf_expr p 1)) (if (sf_is p ",") (sf_take p) (if (sf_is p "]") false (bad (sf_peek p) "expected comma")))))
        (sf_expect p "]") (set result (node "array" items (rt_at n 2)))))
       (if (rt_eq value "{")
        (let (items (rt_list)) (do
         (while (rt_not (sf_is p "}"))
          (let (key (sf_take p)) (do (sf_expect p ":")
           (rt_push items (sf_call "dv_pair" (pair (if (rt_eq (kind key) "str") key (node "str" (rt_cat (rt_cat "\"" (payload key)) "\"") (rt_at key 2))) (sf_expr p 1)) (rt_at key 2)))
           (if (sf_is p ",") (sf_take p) (if (sf_is p "}") false (bad (sf_peek p) "expected comma"))))))
         (sf_expect p "}") (set result (node "array" items (rt_at n 2)))))
        (if (has (words "str num sym") (kind n)) false (bad n "expected expression")))))))
   (while (either (sf_is p "(") (either (sf_is p ".") (sf_is p "[")))
    (if (sf_is p "(")
     (let (args (rt_list)) (do (sf_take p)
      (while (rt_not (sf_is p ")")) (do (rt_push args (sf_expr p 1)) (if (sf_is p ",") (sf_take p) (if (sf_is p ")") false (bad (sf_peek p) "expected comma")))))
      (sf_expect p ")") (set result (sf_call (sym result) args (rt_at n 2)))))
     (if (sf_is p ".")
      (let (dot (sf_take p) field (sf_name p)) (set result (sf_call "dv_get" (pair result (node "str" (rt_cat (rt_cat "\"" (payload field)) "\"") (rt_at field 2))) (rt_at dot 2))))
      (do (sf_take p) (set result (sf_call "rt_at" (pair result (sf_expr p 1)) (rt_at n 2))) (sf_expect p "]"))))) result)))
(defn sf_type (p) (payload (sf_name p)))
(defn sf_params (p)
 (let (params (rt_list) types (rt_list)) (do (sf_expect p "(")
  (while (rt_not (sf_is p ")"))
   (let (name (sf_name p) type "Value") (do
    (if (sf_is p ":") (do (sf_take p) (set type (sf_type p))) false)
    (rt_push params name) (rt_push types type)
    (if (sf_is p ",") (sf_take p) (if (sf_is p ")") false (bad (sf_peek p) "expected parameter comma"))))))
  (sf_expect p ")") (pair params types))))
(defn sf_block (p parent)
 (let (stmts (rt_list) indent (if (rt_eq (kind (sf_peek p)) "line") (sf_text p) -1) running true)
  (do (if (rt_lt parent indent) false (bad (sf_peek p) "expected indented block"))
   (while running
    (if (rt_eq (kind (sf_peek p)) "line")
     (if (rt_lt (sf_text p) indent) (set running false)
      (do (if (rt_eq (sf_text p) indent) false (bad (sf_peek p) "unexpected indentation"))
       (sf_take p) (rt_push stmts (sf_stmt p indent))))
     (if (rt_eq (kind (sf_peek p)) "eof") (set running false) (bad (sf_peek p) "unexpected token after statement")))) stmts)))
(defn sf_stmt (p indent)
 (let (n (sf_peek p) word (sf_text p))
  (if (either (rt_eq word "let") (rt_eq word "var"))
   (let (keyword (sf_take p) name (sf_name p) type "Value") (do
    (if (sf_is p ":") (do (sf_take p) (set type (sf_type p))) false)
    (sf_expect p "=") (node "bind" (sf_list4 name (sf_expr p 1) type word) (rt_at n 2))))
   (if (rt_eq word "return") (do (sf_take p) (node "return" (sf_expr p 1) (rt_at n 2)))
    (if (either (rt_eq word "if") (rt_eq word "while"))
     (let (keyword (sf_take p) condition (sf_expr p 1) then (rt_list) otherwise (rt_list))
      (do (sf_expect p ":") (set then (sf_block p indent))
       (if (both (rt_eq word "if") (both (rt_eq (kind (sf_peek p)) "line") (rt_eq (sf_text p) indent)))
        (let (cursor (rt_at p 1)) (do (sf_take p)
         (if (sf_is p "else") (do (sf_take p) (sf_expect p ":") (set otherwise (sf_block p indent))) (rt_replace p 1 cursor)))) false)
       (node word (sf_list3 condition then otherwise) (rt_at n 2))))
     (let (expr (sf_expr p 1))
      (if (sf_is p "=") (do (sf_take p) (node "assign" (pair expr (sf_expr p 1)) (rt_at n 2))) (node "expr" expr (rt_at n 2)))))))))
(defn sf_declaration (p)
 (let (head (sf_take p) name (sf_name p) params (sf_params p) ret "Value")
  (do
   (if (sf_is p "->") (do (sf_take p) (set ret (sf_type p))) false)
   (if (rt_eq (payload head) "acceptance") (sf_acceptance_decl p head name params)
    (if (rt_eq (payload head) "imprint") (sf_imprint_decl p head name params)
     (if (rt_eq (payload head) "mapping")
    (do (sf_expect p ":")
     (sf_take p) (sf_expect p "input") (sf_name p)
     (sf_take p) (sf_expect p "output") (sf_name p)
     (sf_take p) (sf_expect p "using")
     (let (call (sf_expr p 1) body (rt_list) input (node "sym" "sf_input" (rt_at head 2)))
      (do (rt_push (rt_at params 0) input) (rt_push (rt_at params 1) "Value")
       (rt_push (children call) input) (rt_push body (node "return" call (rt_at head 2)))
       (node "surface" (sf_list4 name params body "Mapping") (rt_at head 2)))))
    (let (body (rt_list))
     (do (if (sf_is p "=") (do (sf_take p) (rt_push body (node "return" (sf_expr p 1) (rt_at head 2))))
      (do (sf_expect p ":") (set body (sf_block p 0))))
      (node "surface" (sf_list4 name params body ret) (rt_at head 2))))))))))
(defn sf_parse (source) (sf_parse_range source 0 (rt_length source)))
(defn sf_parse_range (source start length)
 (let (tokens (sf_scan (rt_slice source start length)) shifted (sf_shift_tokens tokens start) p (pair tokens 0) forms (rt_list) aliases (rt_list) started false)
  (do
   (while (rt_not (rt_eq (kind (sf_peek p)) "eof"))
    (do
     (if (rt_eq (kind (sf_peek p)) "line") (do (if (rt_eq (sf_text p) 0) false (bad (sf_peek p) "top-level indentation")) (sf_take p)) false)
     (if (sf_is p "(")
      (let (parsed (parse_one source (rt_at (sf_peek p) 2) 0)) (do (rt_push forms (rt_at parsed 0))
       (while (rt_lt (rt_at (sf_peek p) 2) (rt_at parsed 1)) (sf_take p))))
      (if (sf_is p "define")
       (do (if started (bad (sf_peek p) "define must precede declarations") false) (sf_take p)
        (let (from (payload (sf_take p)) to (payload (sf_take p)))
         (do (if (rt_eq (lookup aliases from) -1) (rt_push aliases (pair from to)) (rt_fail "Duplicate define alias")))))
       (do
        (if (rt_not started)
         (let (i (rt_at p 1)) (do
          (while (rt_lt i (rt_count tokens))
           (let (token (rt_at tokens i) j 0 mapped false) (do
            (if (rt_eq (kind token) "sym")
             (while (both (rt_not mapped) (rt_lt j (rt_count aliases)))
              (do (if (rt_eq (payload token) (rt_at (rt_at aliases j) 0)) (do (rt_replace token 1 (rt_at (rt_at aliases j) 1)) (set mapped true)) false) (set j (rt_add j 1)))) false)
            (set i (rt_add i 1))))) (set started true))) false)
        (if (has (words "fn axiom mapping acceptance imprint") (sf_text p)) (rt_push forms (sf_declaration p))
         (if (sf_is p "module")
          (do (sf_take p) (while (rt_not (either (rt_eq (kind (sf_peek p)) "line") (rt_eq (kind (sf_peek p)) "eof"))) (sf_take p)))
          (bad (sf_peek p) "unsupported surface declaration")))))))) forms)))
(defn sf_emit_array (n scope signatures)
 (let (xs (payload n) result "new System.Collections.Generic.List<object> {" i 0)
  (do (while (rt_lt i (rt_count xs))
   (do (if (rt_lt 0 i) (set result (rt_cat result ",")) false)
    (set result (rt_cat result (emit (rt_at xs i) scope signatures))) (set i (rt_add i 1)))) (rt_cat result "}"))))
(defn sf_emit_stmts (stmts scope signatures)
 (let (result "" i 0 locals (copy scope))
  (do (while (rt_lt i (rt_count stmts))
   (let (n (rt_at stmts i) tag (kind n) data (payload n))
    (do
     (set result (rt_cat result
      (if (rt_eq tag "bind")
       (let (init (emit (rt_at data 1) locals signatures)) (do (add_local (rt_at data 0) locals)
        (rt_cat (rt_cat "object v_" (sym (rt_at data 0))) (rt_cat " = " (rt_cat init ";\n")))))
       (if (rt_eq tag "assign")
        (do (if (has locals (sym (rt_at data 0))) false (bad n "assignment to unbound local"))
         (rt_cat (rt_cat "v_" (sym (rt_at data 0))) (rt_cat " = " (rt_cat (emit (rt_at data 1) locals signatures) ";\n"))))
        (if (rt_eq tag "return") (rt_cat "return " (rt_cat (emit data locals signatures) ";\n"))
         (if (either (rt_eq tag "if") (rt_eq tag "while"))
          (rt_cat (rt_cat tag " (R.Bool(") (rt_cat (emit (rt_at data 0) locals signatures)
           (rt_cat ")) {\n" (rt_cat (sf_emit_stmts (rt_at data 1) locals signatures)
            (if (rt_eq tag "if") (rt_cat "} else {\n" (rt_cat (sf_emit_stmts (rt_at data 2) locals signatures) "}\n")) "}\n")))))
          (rt_cat "_ = " (rt_cat (emit data locals signatures) ";\n"))))))))
     (set i (rt_add i 1))))) result)))
(defn sf_emit_function (n signatures)
 (let (data (payload n) name (sym (rt_at data 0)) params (rt_at (rt_at data 1) 0) scope (rt_list) i 0 result (rt_cat "static object F_" (sym (rt_at data 0))))
  (do (set result (rt_cat result "("))
   (while (rt_lt i (rt_count params)) (do (add_local (rt_at params i) scope)
    (if (rt_lt 0 i) (set result (rt_cat result ",")) false)
    (set result (rt_cat result (rt_cat "object v_" (sym (rt_at params i))))) (set i (rt_add i 1))))
   (rt_cat result (rt_cat ") {\n" (rt_cat (sf_emit_stmts (rt_at data 2) scope signatures) "}\n"))))))

(defn sf_lower (n)
 (let (data (payload n) name (rt_at data 0) params (rt_at data 1) body (node "surfacebody" (sf_list3 (sf_rename_body (rt_at data 2) (rt_list)) (rt_at data 3) params) (rt_at n 2)))
  (node "list" (sf_list4 (node "sym" "defn" (rt_at n 2)) name (node "list" (rt_at params 0) (rt_at n 2)) body) (rt_at n 2))))
(defn sf_emit_lowered (n signatures)
 (let (xs (children n) body (payload (rt_at xs 3)))
  (sf_emit_function (node "surface" (sf_list4 (rt_at xs 1) (rt_at body 2) (rt_at body 0) (rt_at body 1)) (rt_at n 2)) signatures)))
(defn sf_emit_mapping (n scope signatures)
 (let (data (payload n) call (rt_at data 0) xs (children call) name (sym (rt_at xs 0)) i 0 valid false args (sf_tail xs))
  (do (while (rt_lt i (rt_count signatures))
   (do (if (rt_eq (rt_at (rt_at signatures i) 0) name) (set valid (rt_at (rt_at signatures i) 2)) false) (set i (rt_add i 1))))
   (if valid false (bad n "left operand must be a declared cognitive mapping"))
   (rt_push args (rt_at data 1)) (emit (sf_call name args (rt_at n 2)) scope signatures))))

(defn sf_acceptance_decl (p head name params)
 (let (levels (rt_list)) (do
  (sf_expect p ":") (sf_take p) (sf_expect p "degree") (sf_name p) (sf_expect p ":") (sf_expect p "Acceptance") (sf_expect p "=")
  (let (degree (sf_expr p 1)) (do
   (sf_take p) (sf_expect p "levels") (sf_expect p ":")
   (while (if (rt_eq (kind (sf_peek p)) "line") (rt_lt 4 (sf_text p)) false)
    (do (sf_take p) (let (level (sf_name p)) (do (sf_expect p "from")
     (rt_push levels (node "array" (pair (node "str" (rt_cat (rt_cat "\"" (payload level)) "\"") (rt_at level 2)) (sf_expr p 1)) (rt_at level 2)))))))
   (node "surface" (sf_list4 name params (sf_list1 (node "return" (sf_call "dv_acceptance_classify" (pair degree (node "array" levels (rt_at head 2))) (rt_at head 2)) (rt_at head 2))) "Value") (rt_at head 2)))))))
(defn sf_imprint_decl (p head name params)
 (let (args (rt_list)) (do
  (sf_expect p ":")
  (sf_take p) (sf_expect p "require") (sf_expect p "capability") (rt_push args (sf_expr p 1))
  (sf_take p) (sf_expect p "achieve") (rt_push args (sf_expr p 1))
  (sf_take p) (sf_expect p "vary") (rt_push args (sf_expr p 1))
  (sf_take p) (sf_expect p "conserve") (sf_expect p "using") (rt_push args (sf_expr p 1))
  (sf_take p) (sf_expect p "limit") (sf_expect p "using") (rt_push args (sf_expr p 1))
  (sf_take p) (sf_expect p "minimize") (sf_expect p "using") (rt_push args (sf_expr p 1))
  (node "surface" (sf_list4 name params (sf_list1 (node "return" (sf_call "dv_imprint_solve" args (rt_at head 2)) (rt_at head 2))) "Value") (rt_at head 2)))))
; Small type kernel: expected nominal type, literal range and declaration signatures.
(defn ck_type_known (t)
 (has (words "Value Number Text Bool Acceptance Probability Confidence Reliability Weight Nat Mapping") t))
(defn ck_bounded (t) (has (words "Acceptance Probability Confidence Reliability") t))
(defn ck_type_raw (n env defs)
 (let (tag (kind n) data (payload n))
  (if (rt_eq tag "num") "Number"
   (if (rt_eq tag "str") "Text"
    (if (rt_eq tag "sym")
     (if (either (rt_eq data "true") (rt_eq data "false")) "Bool" (let (t (lookup env data)) (if (rt_eq t -1) "Value" t)))
     (if (either (rt_eq tag "array") (rt_eq tag "mapapply")) "Value"
      (if (rt_eq tag "list")
       (let (xs (children n) name (sym (rt_at xs 0)) sig (lookup defs name))
        (if (rt_eq sig -1)
         (if (has (words "rt_lt rt_eq rt_not rt_is_list rt_is_number rt_is_numeric_value") name) "Bool"
          (if (has (words "rt_add rt_sub rt_mul rt_div rt_number rt_count rt_length rt_code") name) "Number" "Value"))
         (rt_at sig 1))) "Value")))))))
(defn ck_expect (n expected env defs)
 (let (actual (ck_type n env defs)) (do
  (if (ck_type_known expected) false (bad n (rt_cat "unknown type " expected)))
  (if (rt_eq expected "Value") false
   (if (rt_eq actual expected) false
    (if (both (rt_eq actual "Number") (rt_eq (kind n) "num"))
     (let (value (rt_number (payload n)))
      (if (ck_bounded expected)
       (if (both (rt_not (rt_lt value 0)) (rt_not (rt_lt 1 value))) false (bad n (rt_cat "literal outside " expected)))
       (if (has (words "Weight Nat") expected) (if (either (rt_lt value 0) (if (rt_eq expected "Nat") (rt_not (rt_eq value (rt_floor value))) false)) (bad n "literal violates nonnegative/integer type") false) (bad n "numeric literal has incompatible type"))))
     (bad n (rt_cat (rt_cat (rt_cat "expected " expected) ", obtained ") actual))))) true)))
(defn ck_expr (n env defs)
 (let (tag (kind n))
  (if (rt_eq tag "list")
   (let (xs (children n) name (sym (rt_at xs 0)) sig (lookup defs name) i 1)
    (do
     (if (both (ck_bounded name) (rt_eq (rt_count xs) 2))
      (if (rt_eq (kind (rt_at xs 1)) "num") (ck_expect (rt_at xs 1) name env defs) false) false)
     (while (rt_lt i (rt_count xs))
     (do (ck_expr (rt_at xs i) env defs)
      (if (rt_eq sig -1) false
       (if (rt_lt (rt_sub i 1) (rt_count (rt_at sig 0))) (ck_expect (rt_at xs i) (rt_at (rt_at sig 0) (rt_sub i 1)) env defs) false))
      (set i (rt_add i 1)))) true))
   (if (either (rt_eq tag "array") (rt_eq tag "mapapply"))
    (let (i 0) (do (while (rt_lt i (rt_count (payload n))) (do (ck_expr (rt_at (payload n) i) env defs) (set i (rt_add i 1)))) true)) true))))
(defn ck_body (stmts env mutable defs ret)
 (let (locals (copy env) vars (copy mutable) i 0)
  (do (while (rt_lt i (rt_count stmts))
   (let (n (rt_at stmts i) tag (kind n) data (payload n)) (do
    (if (rt_eq tag "bind")
     (let (value (rt_at data 1) type (rt_at data 2)) (do
      (ck_expr value locals defs) (ck_expect value type locals defs)
      (rt_push locals (pair (sym (rt_at data 0)) type))
      (if (rt_eq (rt_at data 3) "var") (rt_push vars (sym (rt_at data 0))) false)))
     (if (rt_eq tag "assign")
      (do (if (has vars (sym (rt_at data 0))) false (bad n "assignment requires var"))
       (ck_expr (rt_at data 1) locals defs) (ck_expect (rt_at data 1) (lookup locals (sym (rt_at data 0))) locals defs))
      (if (either (rt_eq tag "if") (rt_eq tag "while"))
       (do (ck_expr (rt_at data 0) locals defs)
        (ck_body (rt_at data 1) locals vars defs ret) (ck_body (rt_at data 2) locals vars defs ret))
       (do (ck_expr data locals defs) (if (rt_eq tag "return") (ck_expect data ret locals defs) false)))))
    (set i (rt_add i 1))))) true)))
(defn ck_program (forms)
 (let (defs (rt_list) i 0)
  (do
   (while (rt_lt i (rt_count forms))
    (let (xs (children (rt_at forms i))) (do
     (if (rt_eq (sym (rt_at xs 0)) "defn")
      (if (rt_eq (kind (rt_at xs 3)) "surfacebody")
       (let (data (payload (rt_at xs 3))) (rt_push defs (pair (sym (rt_at xs 1)) (pair (rt_at (rt_at data 2) 1) (if (rt_eq (rt_at data 1) "Mapping") "Value" (rt_at data 1)))))) false) false)
     (set i (rt_add i 1)))))
   (set i 0)
   (while (rt_lt i (rt_count forms))
    (let (xs (children (rt_at forms i))) (do
     (if (rt_eq (sym (rt_at xs 0)) "defn")
      (if (rt_eq (kind (rt_at xs 3)) "surfacebody")
       (let (body (payload (rt_at xs 3)) env (rt_list) vars (rt_list) params (rt_at (payload (rt_at xs 3)) 2) j 0)
        (do (while (rt_lt j (rt_count (rt_at params 0)))
         (do (rt_push env (pair (sym (rt_at (rt_at params 0) j)) (rt_at (rt_at params 1) j))) (rt_push vars (sym (rt_at (rt_at params 0) j))) (set j (rt_add j 1))))
         (ck_body (rt_at body 0) env vars defs (if (rt_eq (rt_at body 1) "Mapping") "Value" (rt_at body 1))))) false) false)
     (set i (rt_add i 1))))) true)))
(defn lookup_index (items name)
 (let (i 0 found -1) (do (while (rt_lt i (rt_count items)) (do (if (rt_eq (rt_at (rt_at items i) 0) name) (set found i) false) (set i (rt_add i 1)))) found)))

(defn ck_type (n env defs)
 (if (rt_eq (kind n) "list")
  (let (name (sym (rt_at (children n) 0))) (if (ck_bounded name) name (ck_type_raw n env defs)))
  (ck_type_raw n env defs)))
(defn sf_is_mapping_call (n signatures)
 (if (rt_eq (kind n) "list")
  (let (name (sym (rt_at (children n) 0)) i 0 found false)
   (do (while (rt_lt i (rt_count signatures))
    (do (if (rt_eq (rt_at (rt_at signatures i) 0) name) (set found (rt_at (rt_at signatures i) 2)) false) (set i (rt_add i 1)))) found)) false))
(defn sf_rename_expr (n env)
 (let (tag (kind n) data (payload n) pos (rt_at n 2))
  (if (rt_eq tag "sym")
   (let (mapped (lookup env data)) (if (rt_eq mapped -1) n (node tag mapped pos)))
   (if (has (words "list array mapapply") tag)
    (let (result (rt_list) i 0) (do
     (while (rt_lt i (rt_count data))
      (do (rt_push result (if (both (rt_eq tag "list") (rt_eq i 0)) (rt_at data i) (sf_rename_expr (rt_at data i) env))) (set i (rt_add i 1))))
     (node tag result pos))) n))))
(defn sf_rename_body (stmts env)
 (let (result (rt_list) locals (copy env) i 0)
  (do (while (rt_lt i (rt_count stmts))
   (let (n (rt_at stmts i) tag (kind n) data (payload n) pos (rt_at n 2) rewritten n)
    (do
     (if (rt_eq tag "bind")
      (let (name (sym (rt_at data 0)) renamed (rt_cat (rt_cat (sym (rt_at data 0)) "__") (rt_show pos)) init (sf_rename_expr (rt_at data 1) locals))
       (do (rt_push locals (pair name renamed))
        (set rewritten (node tag (sf_list4 (node "sym" renamed pos) init (rt_at data 2) (rt_at data 3)) pos))))
      (if (rt_eq tag "assign")
       (set rewritten (node tag (pair (sf_rename_expr (rt_at data 0) locals) (sf_rename_expr (rt_at data 1) locals)) pos))
       (if (either (rt_eq tag "if") (rt_eq tag "while"))
        (set rewritten (node tag (sf_list3 (sf_rename_expr (rt_at data 0) locals) (sf_rename_body (rt_at data 1) locals) (sf_rename_body (rt_at data 2) locals)) pos))
        (set rewritten (node tag (sf_rename_expr data locals) pos)))))
     (rt_push result rewritten) (set i (rt_add i 1))))) result)))

(defn sf_shift_tokens (tokens offset)
 (let (i 0) (do (while (rt_lt i (rt_count tokens))
  (do (rt_replace (rt_at tokens i) 2 (rt_add offset (rt_at (rt_at tokens i) 2))) (set i (rt_add i 1)))) true)))
(defn compiler_check_mode ()
 (if (rt_lt 2 (rt_arg_count)) (rt_eq (rt_arg 2) "--check") false))
(defn compiler_parse (source)
 (if (rt_lt 3 (rt_arg_count))
  (let (ranges (rt_json_parse (rt_read (rt_arg 3))) result (rt_list) i 0)
   (do (while (rt_lt i (rt_count ranges))
    (let (range (rt_at ranges i) forms (sf_parse_range source (rt_at range 0) (rt_at range 1)) j 0)
     (do (while (rt_lt j (rt_count forms)) (do (rt_push result (rt_at forms j)) (set j (rt_add j 1))))
      (set i (rt_add i 1))))) result))
  (sf_parse source)))
(main (let (output (compile (rt_read (rt_arg 0))))
 (if (compiler_check_mode) (rt_print "DV check complete") (rt_write (rt_arg 1) output))))
