// Structured speech: authority is checked by execution, cognition by each owner.
// Only positive equals atoms support testimony cells. Other ASTs remain speech records.
// A received estimated proposal is a public record before any personal adoption.
// Only an owner's declared policy can authorize its bounded testimony support.
// Speech exposes cue identity only. Conclusions and priors belong to local rules.
// Model reception is hypothetical testimony into a private copied prediction world.
// Neither the model nor its alternatives is sourced from another actor's real mind.
// A complete candidate layer is quoted before any prediction is evaluated.
// Work draws only from the existing total model budget, never replay-work allowance.
// Reassessment consumes personal reasoning and withdraws only a scoped interpretation.
// New personal evidence can defeat an earlier interpretation without new speech.
// This operation never writes observations or negates the interpreted proposition.

fn dvs_speech_cognitive_parents(parents, previous):
    if dv_or((previous == ""), dv_has(parents, previous)):
        return parents
    else:
        return dv_append(parents, previous)

fn dvs_speech_ast_nodes(ast):
    var op = ast.op
    var count = 1
    if (op == "not"):
        count = (count + dvs_speech_ast_nodes(ast.item))
    else:
        if (op == "all"):
            var items = ast.items
            var i = 0
            while (i < rt_count(items)):
                count = (count + dvs_speech_ast_nodes(items[i]))
                i = (i + 1)
    return count

fn dvs_speech_map(mind, proposition, bindings):
    var op = proposition.op
    if (op == "constant"):
        return proposition
    else:
        if (op == "all"):
            var mapped = []
            var i = 0
            var items = proposition.items
            while (i < rt_count(items)):
                rt_push(mapped, dvs_speech_map(mind, items[i], bindings))
                i = (i + 1)
            return dv_all(mapped)
        else:
            if (op == "not"):
                return dv_not(dvs_speech_map(mind, proposition.item, bindings))
            else:
                var ref = proposition.ref
                var local = dv_local(bindings, ref.object, mind.subject)
                if (local == ""):
                    if dv_has_key(mind.objects, ref.object):
                        return proposition
                    else:
                        return {"op": "constant", "value": "unknown"}
                else:
                    return dv_with(proposition, "ref", dv_ref(local, ref.facet, ref.field))

fn dvs_speech_truth(mind, speech):
    return dv_truth(mind, dvs_speech_map(mind, speech.literal_ast, dv_find(speech, "referents", [])))

fn dvs_speech_presuppositions(mind, speech):
    var items = dv_find(speech, "presuppositions", [])
    var bindings = dv_find(speech, "referents", [])
    var i = 0
    var result = []
    while (i < rt_count(items)):
        var proposition = dvs_speech_map(mind, items[i], bindings)
        rt_push(result, {"proposition": proposition, "truth": dv_truth(mind, proposition)})
        i = (i + 1)
    return result

fn dvs_emission_location(speaker, speech, physical):
    let ref = dv_find(speech, "emission_location_ref", speaker.location_ref)
    let cell = dv_read(physical, ref)
    if dv_uncontested(cell):
        return cell.value
    return ""

fn dvs_speech_hearing(speaker, listener, speech, physical):
    var source = speaker.id
    var channel = dv_find(speech, "channel", "")
    var source_location = dvs_emission_location(speaker, speech, physical)
    let target_cell = dv_read(physical, listener.location_ref)
    var target_location = ""
    if dv_uncontested(target_cell):
        target_location = target_cell.value
    var grants = dv_find(listener, "hearing_grants", [])
    if (source_location != "") and dv_same(source_location, target_location):
        return true
    var heard = false
    var i = 0
    while (i < rt_count(grants)):
        var grant = grants[i]
        if dv_and((grant.speaker == source), (grant.channel == channel)):
            let sender_locations = dv_find(grant, "sender_locations", [])
            let listener_locations = dv_find(grant, "listener_locations", [])
            var reception = target_location
            if dv_has_key(grant, "reception_location_ref"):
                let endpoint = dv_read(physical, grant.reception_location_ref)
                reception = ""
                if dv_uncontested(endpoint):
                    reception = endpoint.value
            if (dv_truth(listener.mind, dv_find(grant, "available_when", dv_true())) == "true") and dv_truth(physical, dv_find(grant, "authority_when", dv_true())) == "true":
                if source_location != "" and reception != "" and ((rt_count(sender_locations) == 0 or dv_has(sender_locations, source_location)) and (rt_count(listener_locations) == 0 or dv_has(listener_locations, reception))):
                    heard = true
        i = (i + 1)
    return heard

fn dvs_speech_observations(mind, proposition, source, origin, time, trust):
    var op = proposition.op
    var observations = []
    if (op == "all"):
        var items = proposition.items
        var i = 0
        while (i < rt_count(items)):
            var part = dvs_speech_observations(mind, items[i], source, origin, time, trust)
            var j = 0
            while (j < rt_count(part)):
                if dv_has(observations, part[j]):
                    false
                else:
                    rt_push(observations, part[j])
                j = (j + 1)
            i = (i + 1)
    else:
        if (op == "equals"):
            var ref = proposition.ref
            rt_push(observations, dv_observation(dv_list3(source, mind.subject, ref), mind.subject, ref, proposition.value, "testimony", origin, time, trust, dv_pair(origin, ref)))
    return observations

fn dvs_speaker_trust(policy, speaker):
    var trust = dv_find(dv_find(policy, "speaker_trust", []), speaker, 0.5)
    let biases = dv_find(policy, "class_bias", [])
    var i = 0
    while i < rt_count(biases):
        let bias = biases[i]
        if 0 < rt_count(dv_find(bias, "basis", [])) and dv_has(bias.speakers, speaker):
            trust = trust + bias.delta
        i = i + 1
    return dv_min(1, dv_max(0, trust))

fn dvs_speech_proposal_decision(mind, policy, speech, trust):
    var proposal = dv_find(speech, "proposal", false)
    var status = "ordinary"
    var reason = "ordinary-testimony"
    var confidence = trust
    var units = 0
    var acceptance = dv_find(policy, "proposal_acceptance", false)
    if (proposal == false):
        false
    else:
        var claims = dv_find(proposal, "claims", [])
        var local_1 = false
        if (acceptance == false):
            local_1 = []
        else:
            local_1 = dv_find(acceptance, "required_slots", [])
        var required = local_1
        var propositions = []
        var allowed = true
        var i = 0
        var available = "unknown"
        status = "retained"
        reason = "missing-personal-proposal-policy"
        units = 1
        confidence = dv_min(trust, dv_find(proposal, "confidence", 0))
        while (i < rt_count(claims)):
            var claim = claims[i]
            rt_push(propositions, dv_fact(claim.ref, claim.value))
            units = (units + 1)
            i = (i + 1)
        i = 0
        while (i < rt_count(required)):
            var j = 0
            var found = false
            while (j < rt_count(claims)):
                if (required[i] == claims[j].slot_id):
                    found = true
                units = (units + 1)
                j = (j + 1)
            if found:
                false
            else:
                allowed = false
            i = (i + 1)
        if (acceptance == false):
            false
        else:
            available = dv_truth(mind, dvs_speech_map(mind, dv_find(acceptance, "available_when", dv_true()), dv_find(speech, "referents", [])))
            units = (units + (2 * dvs_speech_ast_nodes(dv_find(acceptance, "available_when", dv_true()))))
            reason = "personal-proposal-policy-withheld"
            if dv_find(acceptance, "enabled", false):
                false
            else:
                allowed = false
            if (0 < rt_count(dv_find(acceptance, "basis", []))):
                false
            else:
                allowed = false
            if (available == "true"):
                false
            else:
                allowed = false
            if (0 < rt_count(required)):
                false
            else:
                allowed = false
            if (0 < rt_count(claims)):
                false
            else:
                allowed = false
            if dv_find(proposal, "estimated", false):
                false
            else:
                allowed = false
            if (dv_find(proposal, "argument_id", "") == ""):
                allowed = false
            if dv_and((0 < dv_find(proposal, "confidence", 0)), (dv_find(proposal, "confidence", 0) < 1)):
                false
            else:
                allowed = false
            if (0 < rt_count(dv_find(proposal, "source_event_ids", []))):
                false
            else:
                allowed = false
            if (dv_find(proposal, "model_event", "") == ""):
                allowed = false
            if dv_same(dv_all(propositions), speech.literal_ast):
                false
            else:
                allowed = false
            if (confidence < dv_find(acceptance, "confidence_threshold", 0.5)):
                allowed = false
            if allowed:
                status = "accepted"
                reason = "personal-bounded-proposal-adoption"
    var local_2 = false
    if (acceptance == false):
        local_2 = []
    else:
        local_2 = dv_find(acceptance, "basis", [])
    return dv_with_many({"status": status, "reason": reason, "confidence_cap": confidence, "proposal": proposal}, {"policy_basis": local_2, "calculation_units": units})

fn dvs_speech_received_observations(mind, parsed, source, speaker, time, decision):
    if (decision.status == "retained"):
        return []
    else:
        var items = dvs_speech_observations(mind, parsed, source, speaker, time, decision.confidence_cap)
        var i = 0
        var result = []
        while (i < rt_count(items)):
            var local_1 = false
            if (decision.status == "ordinary"):
                local_1 = items[i]
            else:
                local_1 = dv_with_many(items[i], {"estimated": true, "proposal_source": decision.proposal})
            rt_push(result, local_1)
            i = (i + 1)
        return result

fn dvs_speech_candidates(policy, speech):
    var cues = dv_find(speech, "implicature_candidates", [])
    var rules = dv_find(policy, "implicature_bridges", [])
    var result = []
    var ids = []
    var local_ids = []
    var i = 0
    while (i < rt_count(rules)):
        var rule = rules[i]
        var id = rules[i].id
        var required = dv_find(rules[i], "cue", "")
        var j = 0
        var matched = false
        rt_push(local_ids, id)
        if (required == ""):
            matched = true
        while (j < rt_count(cues)):
            if (cues[j].id == required):
                matched = true
            j = (j + 1)
        if matched:
            rt_push(result, {"id": id, "rule_source": dv_find(rule, "basis", []), "utterance_scope": dv_find(speech, "scope", "")})
            rt_push(ids, id)
        i = (i + 1)
    i = 0
    while (i < rt_count(cues)):
        var cue_id = cues[i].id
        if dv_or(dv_has(ids, cue_id), dv_has(local_ids, cue_id)):
            false
        else:
            rt_push(result, {"id": cue_id, "rule_source": [], "utterance_scope": dv_find(speech, "scope", "")})
            rt_push(ids, cue_id)
        i = (i + 1)
    return result

mapping dvs_listener_mapping(mind, policy, bindings):
    input Percept
    output InterpretationSet
    using dvs_speech_interpret(mind, policy, bindings)

fn dvs_speech_interpret(mind, policy, bindings, candidate):
    var bridges = dv_find(policy, "implicature_bridges", [])
    var i = 0
    var bridge = false
    var proposition = {"op": "constant", "value": "unknown"}
    var available = dv_true()
    var threshold = dv_max(dv_find(policy, "implicature_threshold", 0.5), dv_find(policy, "Implicature_Resistance", 0))
    var confidence = 0
    var adoption = {degree: 0, level: "held"}
    var basis = []
    var status = "rejected"
    var missing = "missing-bridge"
    var scope_check = []
    var withdrawal_evidence = false
    var work = 0
    while (i < rt_count(bridges)):
        var item = bridges[i]
        if (item.id == candidate.id):
            dv_require((bridge == false), "Ambiguous interpretation bridge")
            bridge = item
        i = (i + 1)
    if (bridge == false):
        false
    else:
        var premise = dvs_speech_map(mind, bridge.premise, bindings)
        var bridge_basis = dv_find(bridge, "basis", [])
        var withdrawal = dvs_speech_map(mind, dv_find(bridge, "withdraw_when", dv_not(dv_true())), bindings)
        var scope_ast = dvs_speech_map(mind, dv_find(bridge, "scope_bridge", {"op": "constant", "value": "unknown"}), bindings)
        proposition = dvs_speech_map(mind, bridge.proposition, bindings)
        available = dvs_speech_map(mind, dv_find(bridge, "available_when", dv_true()), bindings)
        confidence = dv_unit(dv_find(bridge, "prior", 0.5))
        basis = bridge_basis
        work = (1 + (2 * ((dvs_speech_ast_nodes(premise) + dvs_speech_ast_nodes(proposition)) + (dvs_speech_ast_nodes(available) + (dvs_speech_ast_nodes(withdrawal) + dvs_speech_ast_nodes(scope_ast))))))
        var literal_scope = dv_find(candidate, "utterance_scope", dv_find(bridge, "source_scope", ""))
        var interpreted_scope = dv_find(bridge, "target_scope", dv_find(bridge, "source_scope", ""))
        var scope_truth = dv_truth(mind, scope_ast)
        var withdraw_truth = dv_truth(mind, withdrawal)
        withdrawal_evidence = {"condition": withdrawal, "truth": withdraw_truth, "inputs": dvs_sim_inputs(mind, withdrawal), "scope": "owner-known-cells-only"}
        var available_truth = dv_truth(mind, available)
        var premise_truth = dv_truth(mind, premise)
        var proposition_truth = dv_truth(mind, proposition)
        scope_check = dv_with({"literal_scope": literal_scope, "interpretation_scope": interpreted_scope, "bridge_truth": scope_truth, "check_enabled": dv_find(policy, "scope_reference_check", false)}, "gap", dv_and((not (literal_scope == interpreted_scope)), (not (scope_truth == "true"))))
        if (withdraw_truth == "true"):
            status = "withdrawn"
            missing = "explicit-withdrawal-evidence"
        else:
            if (not (available_truth == "true")):
                missing = "availability-not-known"
            else:
                if (rt_count(bridge_basis) == 0):
                    missing = "bridge-without-source"
                else:
                    if (not (premise_truth == "true")):
                        missing = "bridge-premise-not-known"
                    else:
                        if (rt_count(basis) == 0):
                            missing = "candidate-without-source"
                        else:
                            if (proposition_truth == "false"):
                                missing = "contrary-evidence"
                            else:
                                adoption = dv_threshold_acceptance(confidence, threshold)
                                if adoption.level != "accepted":
                                    missing = "below-policy-threshold"
                                else:
                                    status = "accepted"
                                    missing = ""
        if dv_and((status == "accepted"), dv_and(scope_check.check_enabled, scope_check.gap)):
            status = "retained"
            adoption = dv_threshold_acceptance(0, threshold)
            missing = "scope-reference-bridge-not-supported"
        basis = dv_append(basis, {"bridge": bridge.id, "basis": bridge_basis})
    return dv_with_many({"id": candidate.id, "proposition": proposition, "status": status, "confidence": confidence}, {"basis": basis, "missing_bridge": missing, "scope_check": scope_check, "withdrawal_evidence": withdrawal_evidence, "kind": "defeasible-interpretation", "calculation_units": work, "acceptance": adoption})

fn dvs_speech_model_interpretations(mind, policy, speech, bindings):
    var candidates = dvs_speech_candidates(policy, speech)
    var result = []
    var i = 0
    while (i < rt_count(candidates)):
        rt_push(result, (dvs_listener_mapping(mind, policy, bindings) × candidates[i]))
        i = (i + 1)
    return result

fn dvs_speech_model_prediction(model, speech, speaker, source, time):
    var before = dv_with_many(model.mind, {"history": [], "seen": []})
    var policy = model.policy
    var bindings = dv_find(speech, "referents", [])
    var parsed = dvs_speech_map(model.mind, speech.literal_ast, dv_find(speech, "referents", []))
    var decision = dvs_speech_proposal_decision(before, policy, speech, dvs_speaker_trust(policy, speaker))
    var observations = dvs_speech_received_observations(before, parsed, rt_cat("prediction-", source), speaker, time, decision)
    var profile = dv_observation_profile({"perception": 1, "testimony": 1, "recall": 1}, dv_find(policy, "observation_threshold", 0.5))
    var receipt = dv_update_mind(before, observations, before.revision, profile)
    var after = receipt.world
    var primary = dvs_speech_model_interpretations(after, policy, speech, bindings)
    var checked = dv_find(policy, "scope_reference_check", false)
    var local_1 = false
    if checked:
        local_1 = dvs_speech_model_interpretations(after, dv_with(policy, "scope_reference_check", false), speech, bindings)
    else:
        local_1 = primary
    var local_2 = false
    if checked:
        local_2 = primary
    else:
        local_2 = dvs_speech_model_interpretations(after, dv_with(policy, "scope_reference_check", true), speech, bindings)
    var local_3 = false
    if checked:
        local_3 = "scope_reference_check_true=primary"
    else:
        local_3 = "scope_reference_check_false=primary"
    return dv_with_many({"model_before": before, "model_after": after, "predicted_literal": parsed, "observations": observations}, {"observation_profile": profile, "prediction": primary, "conditional_prediction": {"scope_reference_check_false": local_1, "scope_reference_check_true": local_2}, "assumptions": dv_find(model, "assumptions", []), "conditional_reuse": local_3, "proposal_decision": decision})

fn dvs_speech_rule_units(rule):
    return (1 + (2 * ((dvs_speech_ast_nodes(rule.premise) + dvs_speech_ast_nodes(rule.proposition)) + (dvs_speech_ast_nodes(dv_find(rule, "available_when", dv_true())) + (dvs_speech_ast_nodes(dv_find(rule, "withdraw_when", dv_not(dv_true()))) + dvs_speech_ast_nodes(dv_find(rule, "scope_bridge", {"op": "constant", "value": "unknown"})))))))

fn dvs_speech_prediction_units(model, speech):
    var rules = dv_find(model.policy, "implicature_bridges", [])
    var candidates = dvs_speech_candidates(model.policy, speech)
    var work = (dvs_speech_proposal_decision(model.mind, model.policy, speech, 0.5).calculation_units + (1 + (2 * dvs_speech_ast_nodes(speech.literal_ast))))
    var i = 0
    while (i < rt_count(candidates)):
        var j = 0
        var id = candidates[i].id
        while (j < rt_count(rules)):
            if (rules[j].id == id):
                work = (work + (2 * dvs_speech_rule_units(rules[j])))
            j = (j + 1)
        i = (i + 1)
    return work

fn dvs_speech_goals(actor):
    var goals = dv_find(actor.policy, "communication_goals", [])
    var active = []
    var i = 0
    while (i < rt_count(goals)):
        var goal = goals[i]
        if dv_and((0 < rt_count(dv_find(goal, "basis", []))), (dv_truth(actor.mind, dv_find(goal, "available_when", dv_true())) == "true")):
            dv_require((not (goal.weight < 0)), "Negative communication weight")
            rt_push(active, goal)
        i = (i + 1)
    return active

fn dvs_speech_choice_signature(actor, action, goals, time):
    let listeners = dv_find(action, "listeners", [])
    let models = dv_find(actor.mind, "listener_models", [])
    var selected = []
    var i = 0
    while i < rt_count(listeners):
        let listener = listeners[i]
        let model = dv_find(models, listener, false)
        var gates = []
        if model != false:
            let parsed = dvs_speech_map(model.mind, action.speech.literal_ast, dv_find(action.speech, "referents", []))
            let refs = dvs_sim_refs(parsed)
            var j = 0
            while j < rt_count(refs):
                rt_push(gates, time < dv_read(model.mind, refs[j]).time)
                j = j + 1
        rt_push(selected, {"listener": listener, "model": model, "older_observation": gates})
        i = i + 1
    return {"speaker": actor.id, "literal_truth": dvs_speech_truth(actor.mind, action.speech), "speech": action.speech, "goals": goals, "models": selected}

fn dvs_speech_goal_value(goals, listener, prediction):
    var value = 0
    var i = 0
    var interpretations = prediction.prediction
    while (i < rt_count(goals)):
        var goal = goals[i]
        var targets = dv_find(goals[i], "listeners", [])
        var j = 0
        if dv_or((rt_count(targets) == 0), dv_has(targets, listener)):
            while (j < rt_count(interpretations)):
                var interpretation = interpretations[j]
                if dv_and((interpretation.id == goal.interpretation_id), (interpretation.status == goal.desired_status)):
                    value = (value + (goal.weight * interpretation.confidence))
                j = (j + 1)
        i = (i + 1)
    return value

fn dvs_prepare_speech_choices(actor, events, time, parent):
    var goals = dvs_speech_goals(actor)
    if rt_count(goals) == 0:
        return actor
    var actions = actor.actions
    var mind = actor.mind
    var models = dv_find(actor.mind, "listener_models", [])
    var cache = dv_find(actor, "speech_choice_values", [])
    var candidates = []
    var eligible = []
    var total = 0
    var i = 0
    var before = actor
    var remaining = dv_find(actor.policy, "model_budget", 0)
    var budget_parent = dv_find(actor, "model_previous_event", "")
    var choice_cognitive = dv_find(actor, "last_cognitive_event", "")
    if (rt_count(goals) == 0):
        false
    else:
        while (i < rt_count(actions)):
            var action = actions[i]
            var id = actions[i].id
            if dv_and(dv_has_key(action, "speech"), dv_find(action, "argument_available", true)):
                if dvp_eligible(actor, action, mind, []):
                    var truth = dvs_speech_truth(mind, action.speech)
                    var signature = dvs_speech_choice_signature(actor, action, goals, time)
                    if (not (truth == "true")):
                        cache = dv_with(cache, id, {"status": "illegal-literal", "utility": 0, "signature": signature})
                        dvs_event(events, "speech_choice_rejected", actor.id, time, dv_single(parent), {"action": action, "actor_before": before, "truth": truth, "charged_units": 0})
                    else:
                        rt_push(eligible, dv_pair(id, signature))
                        var local_1 = false
                        if dv_has_key(cache, id):
                            local_1 = dv_and((dv_get(cache, id).status == "ready"), dv_same(dv_get(cache, id).signature, signature))
                        else:
                            local_1 = false
                        if local_1:
                            false
                        else:
                            var listeners = dv_find(action, "listeners", [])
                            var j = 0
                            var units = 0
                            while (j < rt_count(listeners)):
                                var listener = listeners[j]
                                var local_2 = false
                                if dv_has_key(models, listener):
                                    local_2 = (0 < rt_count(dv_find(dv_get(models, listener), "basis", [])))
                                else:
                                    local_2 = false
                                if local_2:
                                    units = (units + dvs_speech_prediction_units(dv_get(models, listener), action.speech))
                                j = (j + 1)
                            rt_push(candidates, {"action": action, "signature": signature, "units": units})
                            total = (total + units)
            i = (i + 1)
    i = 0
    if (remaining < total):
        while (i < rt_count(eligible)):
            var entry = eligible[i]
            cache = dv_with(cache, entry[0], {"status": "unknown-incomplete-layer", "utility": 0, "signature": entry[1]})
            i = (i + 1)
        if (0 < rt_count(candidates)):
            dvs_event(events, "speech_choice_budget_stop", actor.id, time, dv_single(parent), {"actor_before": dv_without(before, "simulations"), "required_units": total, "available_units": remaining, "charged_units": 0})
    else:
        while (i < rt_count(candidates)):
            var entry = candidates[i]
            var action = candidates[i].action
            var forecasts = []
            var event_ids = []
            var listeners = dv_find(candidates[i].action, "listeners", [])
            var j = 0
            var value = 0
            while (j < rt_count(listeners)):
                var listener = listeners[j]
                var data = false
                var units = 0
                var local_3 = false
                if dv_has_key(models, listener):
                    local_3 = (0 < rt_count(dv_find(dv_get(models, listener), "basis", [])))
                else:
                    local_3 = false
                if local_3:
                    units = dvs_speech_prediction_units(dv_get(models, listener), action.speech)
                    data = dvs_speech_model_prediction(dv_get(models, listener), action.speech, actor.id, rt_cat("preselect-", action.id), time)
                    data = dv_with_many(data, {"status": "model-based", "model": dv_get(models, listener)})
                    value = (value + dvs_speech_goal_value(goals, listener, data))
                else:
                    data = {"status": "unknown-no-model", "prediction": []}
                data = dv_with_many(data, {"listener": listener, "action": action, "actor_before": dv_without(dv_with_many(actor, {"policy": dv_with(actor.policy, "model_budget", remaining), "model_previous_event": budget_parent, "last_cognitive_event": choice_cognitive}), "simulations"), "budget_before": remaining, "charged_units": units, "goals": goals})
                remaining = (remaining - units)
                data = dv_with(data, "budget_after", remaining)
                data = dv_with(data, "prediction_time", time)
                var local_4 = false
                if (0 < units):
                    local_4 = rt_cat("e", rt_show(rt_count(events)))
                else:
                    local_4 = budget_parent
                var local_5 = false
                if (0 < units):
                    local_5 = rt_cat("e", rt_show(rt_count(events)))
                else:
                    local_5 = choice_cognitive
                data = dv_with(data, "actor_after", dv_with_many(actor, {"policy": dv_with(actor.policy, "model_budget", remaining), "model_previous_event": local_4, "last_cognitive_event": local_5}))
                var local_6 = false
                if (budget_parent == ""):
                    local_6 = dv_single(parent)
                else:
                    local_6 = dv_pair(parent, budget_parent)
                let prediction_index = rt_count(events)
                var prediction_id = dvs_event(events, "speech_choice_prediction", actor.id, time, dvs_speech_cognitive_parents(local_6, choice_cognitive), data)
                rt_push(event_ids, prediction_id)
                if (0 < units):
                    budget_parent = prediction_id
                    choice_cognitive = prediction_id
                rt_push(forecasts, dv_pair(listener, prediction_index))
                j = (j + 1)
            cache = dv_with(cache, action.id, dv_with_many({"status": "ready", "utility": value, "signature": entry.signature, "forecasts": forecasts}, {"prediction_events": event_ids, "charged_units": entry.units}))
            i = (i + 1)
    return dv_with_many(actor, {"speech_choice_values": cache, "policy": dv_with(actor.policy, "model_budget", remaining), "model_previous_event": budget_parent, "last_cognitive_event": choice_cognitive})

fn dvs_proposal_reassess(actor, decision, events, time, parent):
    var rule = dv_find(actor.policy, "proposal_reassessment", false)
    var proposal = decision.proposal
    var interpretations = dv_find(actor, "interpretations", [])
    var remaining = dv_find(actor.policy, "reason_budget", 0)
    var last = dv_find(actor, "last_interpretation_event", "")
    var cognitive = dv_find(actor, "last_cognitive_event", "")
    var seen = dv_find(actor, "reassessed_proposals", [])
    var local_1 = false
    if (decision.proposal == false):
        local_1 = ""
    else:
        local_1 = dv_find(decision.proposal, "argument_id", "")
    var proposal_id = local_1
    if dv_and((decision.status == "accepted"), (not dv_has(seen, proposal_id))):
        if (rule == false):
            false
        else:
            if dv_and(dv_find(rule, "enabled", false), (0 < rt_count(dv_find(rule, "basis", [])))):
                var targets = dv_find(rule, "interpretation_ids", [])
                var required = dv_find(rule, "required_slots", [])
                var claims = dv_find(proposal, "claims", [])
                var complete = true
                var i = 0
                if (rt_count(required) == 0):
                    complete = false
                while (i < rt_count(required)):
                    var j = 0
                    var found = false
                    while (j < rt_count(claims)):
                        if (required[i] == claims[j].slot_id):
                            found = true
                        j = (j + 1)
                    if found:
                        false
                    else:
                        complete = false
                    i = (i + 1)
                i = 0
                while (i < rt_count(targets)):
                    var id = targets[i]
                    var old = dv_find(interpretations, targets[i], false)
                    var status = "insufficient-origin"
                    var charged = 0
                    var before = dv_with_many(actor, {"interpretations": interpretations, "policy": dv_with(actor.policy, "reason_budget", remaining), "last_interpretation_event": last, "last_cognitive_event": cognitive})
                    if (old == false):
                        status = "no-personal-interpretation"
                    else:
                        var scope = dv_find(old, "scope_check", [])
                        var source = dv_find(old, "source_event", "")
                        if (old.status == "accepted"):
                            false
                        else:
                            status = "no-prior-accepted-interpretation"
                        if dv_and(complete, dv_and((old.status == "accepted"), dv_and(dv_has(dv_find(proposal, "reassessment_sources", []), source), dv_and((dv_find(scope, "literal_scope", "") == dv_find(rule, "source_scope", "")), (dv_find(scope, "interpretation_scope", "") == dv_find(rule, "target_scope", "")))))):
                            if (remaining < 1):
                                status = "reason-budget-exhausted"
                            else:
                                remaining = (remaining - 1)
                                charged = 1
                                var candidate = {"id": id, "utterance_scope": dv_find(scope, "literal_scope", "")}
                                var revised = (dvs_listener_mapping(actor.mind, actor.policy, dv_find(old, "referents", [])) × {"id": id, "utterance_scope": dv_find(scope, "literal_scope", "")})
                                if (revised.scope_check.bridge_truth == "unknown"):
                                    status = "withdrawn"
                                    interpretations = dv_with(interpretations, id, dv_with_many(old, {"status": "withdrawn", "withdrawal_reason": "paid-scope-bridge-unsupported", "proposal_event": parent}))
                                else:
                                    status = "retained-supported-bridge"
                    var after = dv_with_many(actor, {"interpretations": interpretations, "policy": dv_with(actor.policy, "reason_budget", remaining), "last_interpretation_event": rt_cat("e", rt_show(rt_count(events))), "last_cognitive_event": rt_cat("e", rt_show(rt_count(events)))})
                    var local_2 = false
                    if (status == "withdrawn"):
                        local_2 = "implicature_withdrawn"
                    else:
                        local_2 = "proposal_scope_reassessment"
                    var local_3 = false
                    if (last == ""):
                        var local_4 = false
                        if (old == false):
                            local_4 = ""
                        else:
                            local_4 = dv_find(old, "source_event", "")
                        local_3 = dv_pair(parent, local_4)
                    else:
                        var local_5 = false
                        if (old == false):
                            local_5 = ""
                        else:
                            local_5 = dv_find(old, "source_event", "")
                        local_3 = dv_list3(parent, local_5, last)
                    var local_6 = false
                    if (old == false):
                        local_6 = ""
                    else:
                        local_6 = dv_find(old, "source_event", "")
                    last = dvs_event_prepared(events, local_2, actor.id, time, dvs_speech_cognitive_parents(local_3, cognitive), dv_with_many({"status": status, "actor_before": dv_without(before, "simulations"), "actor_after": dv_without(after, "simulations"), "charged_units": charged}, {"mind_before": actor.mind, "mind_after": actor.mind, "interpretations_before": dv_find(before, "interpretations", []), "interpretations_after": interpretations, "source_event": local_6, "proposal": proposal}))
                    cognitive = last
                    i = (i + 1)
                seen = dv_append(seen, proposal_id)
    return dv_with_many(actor, {"interpretations": interpretations, "policy": dv_with(actor.policy, "reason_budget", remaining), "last_interpretation_event": last, "reassessed_proposals": seen, "last_cognitive_event": cognitive})

// A norm receipt records understood content and provenance, never personal assent.
fn dvs_receive_norm(actor, norm, source, parse_event, events, time):
    let receipt = {"norm": norm, "source_event": source, "parse_event": parse_event, "received_time": time}
    let before = dv_find(actor, "norm_proposals", [])
    let after = dv_with(before, norm.id, receipt)
    let event = dvs_event_prepared(events, "norm_receipt", actor.id, time, dv_pair(source, parse_event), {"receipt": receipt, "proposals_before": before, "proposals_after": after})
    return dv_with_many(actor, {"norm_proposals": after, "last_cognitive_event": event})

// Only the actual owner's successfully completed decision changes personal rules.
fn dvs_complete_norm(actor, action, applied, events, time, execution_event, observation_event):
    if not applied:
        return actor
    let read_receipt = dv_find(action, "norm_receipt", false)
    if read_receipt != false:
        if observation_event != execution_event and dv_truth(actor.mind, read_receipt.content) == "true":
            actor = dvs_receive_norm(actor, read_receipt.norm, execution_event, observation_event, events, time)
    let decision = dv_find(action, "norm_decision", false)
    if decision == false:
        return actor
    let receipt = dv_find(dv_find(actor, "norm_proposals", []), decision.id, false)
    dv_require(receipt != false, "Norm decision needs an owner's actual content receipt")
    dv_require(dv_same(receipt.norm, decision.norm) and receipt.source_event != "" and receipt.parse_event != "", "Norm decision receipt must match understood content")
    let before = dv_find(actor.policy, "norm_rules", [])
    var rules = []
    var i = 0
    while i < rt_count(before):
        if before[i].id != decision.id:
            rt_push(rules, before[i])
        i = i + 1
    if decision.accepted:
        let norm = receipt.norm
        rt_push(rules, {"id": norm.id, "method": norm.method, "mode": norm.mode, "promotes": norm.promotes, "sacrifices": norm.sacrifices, "basis": [norm.source, receipt.source_event, receipt.parse_event, execution_event], "available_when": dv_true()})
    let stance = {"accepted": decision.accepted, "norm": receipt.norm, "source_event": receipt.source_event, "parse_event": receipt.parse_event, "execution_event": execution_event, "observation_event": observation_event}
    let stances = dv_with(dv_find(actor, "norm_stances", []), decision.id, stance)
    let event = dvs_event_prepared(events, "norm_decision", actor.id, time, [execution_event, observation_event, receipt.source_event, receipt.parse_event], {"decision": stance, "value_order": dv_find(actor.policy, "value_order", []), "personal_choice": dv_find(action, "personal_choice", []), "rules_before": before, "rules_after": rules})
    return dv_with_many(actor, {"policy": dv_with(actor.policy, "norm_rules", rules), "norm_stances": stances, "last_cognitive_event": event})

fn dvs_receive_scheduled_speech(listener, message, events, time):
    let speech = message.speech
    let literal = speech.literal_ast
    let bindings = dv_find(speech, "referents", [])
    let source = message.source
    let speaker_id = message.speaker
    let action_id = message.action_id
    let audibility = message.audibility
    var before = listener.mind
    var parsed = dvs_speech_map(before, literal, bindings)
    var policy = listener.policy
    var trust = dvs_speaker_trust(listener.policy, speaker_id)
    var decision = dvs_speech_proposal_decision(before, policy, speech, trust)
    var candidates_actual = dvs_speech_candidates(policy, speech)
    var after = before
    var profile = dv_observation_profile({"perception": 1, "testimony": 1, "recall": 1}, dv_find(listener.policy, "observation_threshold", 0.5))
    let observations = dvs_speech_received_observations(before, parsed, source, speaker_id, message.received_time, decision)
    if 0 < rt_count(observations):
        after = dv_update_mind(before, observations, before.revision, profile).world
    var interpretations = dv_find(listener, "interpretations", [])
    var last_interpretation = dv_find(listener, "last_interpretation_event", "")
    var n = 0
    var parse_event = false
    var proposal_event = false
    if (decision.status == "ordinary"):
        false
    else:
        proposal_event = dvs_event_prepared(events, "proposal_receipt", listener.id, time, dvs_speech_cognitive_parents(dv_single(source), dv_find(listener, "last_cognitive_event", "")), dv_with_many(decision, {"source_event": source, "mind_before": before, "mind_after": before}))
        proposal_event = dvs_event_prepared(events, "proposal_adoption", listener.id, time, dv_pair(source, proposal_event), dv_with_many(decision, {"source_event": source, "mind_before": before, "mind_after": after}))
    var local_2 = false
    if (proposal_event == false):
        local_2 = dv_single(source)
    else:
        local_2 = dv_pair(source, proposal_event)
    parse_event = dvs_event_prepared(events, "listener_parse", listener.id, time, dvs_speech_cognitive_parents(local_2, dv_find(listener, "last_cognitive_event", "")), dv_with_many({"mind_before": before, "mind_after": after, "literal": parsed, "observations": observations}, {"source_event": source, "speech": speech, "presuppositions": dvs_speech_presuppositions(before, speech), "audibility": audibility, "observation_profile": profile, "proposal_decision": decision}))
    listener = dvs_receive_request(listener, speech, parse_event, source, speaker_id)
    listener = dv_with(listener, "received_speeches", dv_append(dv_find(listener, "received_speeches", []), {"speaker": speaker_id, "action_id": action_id, "parse_event": parse_event, "source_event": source}))
    listener = dvs_receive_public_claim(listener, speech, speaker_id, source, parse_event)
    listener = dvs_receive_player_influence(listener, speech, speaker_id, source, parse_event)
    listener = dvs_receive_advice(listener, speech, speaker_id, source, parse_event, parsed)
    while (n < rt_count(candidates_actual)):
        var candidate = candidates_actual[n]
        var interpretation = (dvs_listener_mapping(after, policy, bindings) × candidates_actual[n])
        var interpretations_before = dv_clone(interpretations)
        interpretation = dv_with_many(interpretation, {"source_event": source, "referents": bindings})
        var local_3 = false
        if dv_has_key(interpretations, candidate.id):
            local_3 = (dv_get(interpretations, candidate.id).status == "accepted")
        else:
            local_3 = false
        if dv_and((interpretation.status == "withdrawn"), (not local_3)):
            interpretation = dv_with(interpretation, "status", "rejected")
        interpretations = dv_with(interpretations, candidate.id, interpretation)
        var local_4 = false
        if (interpretation.status == "withdrawn"):
            local_4 = "implicature_withdrawn"
        else:
            local_4 = "implicature"
        var local_5 = false
        if (last_interpretation == ""):
            local_5 = dv_pair(source, parse_event)
        else:
            local_5 = dv_list3(source, parse_event, last_interpretation)
        last_interpretation = dvs_event_prepared(events, local_4, listener.id, time, local_5, dv_with_many(interpretation, {"source_event": source, "mind_before": after, "mind_after": after, "interpretations_before": interpretations_before, "interpretations_after": interpretations}))
        n = (n + 1)
    var local_6 = false
    if (decision.status == "ordinary"):
        local_6 = dv_find(listener, "proposals", [])
    else:
        local_6 = dv_append(dv_find(listener, "proposals", []), dv_with(decision, "source_event", source))
    listener = dvs_proposal_reassess(dv_with_many(listener, {"mind": after, "interpretations": interpretations, "last_interpretation_event": last_interpretation, "proposals": local_6, "last_cognitive_event": parse_event}), decision, events, time, parse_event)
    let norm = dv_find(speech, "norm_proposal", false)
    if norm != false and dv_same(parsed, literal) and dv_truth(after, parsed) == "true":
        listener = dvs_receive_norm(listener, norm, source, parse_event, events, time)
    return listener

fn dvs_drain_received_speech(actor, events, time):
    let messages = dv_find(actor, "pending_heard", [])
    var current = actor
    if 0 < rt_count(messages):
        current = dv_with(actor, "pending_heard", [])
    var i = 0
    while i < rt_count(messages):
        current = dvs_receive_scheduled_speech(current, messages[i], events, time)
        i = i + 1
    return current

fn dvs_speech(actors, speaker_index, action, events, time, parent, physical):
    return dvs_speech_owned(dv_clone(actors), speaker_index, action, events, time, parent, physical)

// Linear session ownership: replace changed actors; snapshots were independently frozen.
fn dvs_speech_owned(actors, speaker_index, action, events, time, parent, physical):
    var speaker = actors[speaker_index]
    var speech = action.speech
    var speaker_mind = speaker.mind
    var bindings = dv_find(speech, "referents", [])
    var literal = speech.literal_ast
    var claim = dvs_speech_map(speaker_mind, literal, bindings)
    var listeners = dv_find(action, "listeners", [])
    var next = actors
    var i = 0
    var source = false
    var visited = []
    source = dvs_event_prepared(events, "speech_literal", speaker.id, time, dvs_speech_cognitive_parents(dv_single(parent), dv_find(speaker, "last_cognitive_event", "")), dv_with({"literal": literal, "claim": claim, "mind_before": speaker_mind, "speech": speech}, "speaker_truth", dv_truth(speaker_mind, claim)))
    if (not (dv_truth(speaker_mind, claim) == "true")):
        dvs_event(events, "speech_rejected", speaker.id, time, dv_single(source), {"reason": "speaker-truth-not-supported", "source_event": source})
    else:
        while (i < rt_count(listeners)):
            var listener_id = listeners[i]
            var j = 0
            var target_index = -1
            var prepared = dv_find(dv_find(speaker, "speech_choice_values", []), action.id, false)
            dv_require((not dv_has(visited, listener_id)), "Repeated speech listener")
            rt_push(visited, listener_id)
            while (j < rt_count(next)):
                if (next[j].id == listener_id):
                    target_index = j
                j = (j + 1)
            var local_1 = false
            if (prepared == false):
                local_1 = false
            else:
                local_1 = (prepared.status == "ready")
            if local_1:
                let prediction_index = dv_get(prepared.forecasts, listener_id)
                var predicted = events[prediction_index].data
                dvs_event_prepared(events, "speaker_prediction", speaker.id, time, dv_append(prepared.prediction_events, source), dv_with_many(predicted, {"source_event": source, "paid_prediction_events": prepared.prediction_events, "paid_forecast": predicted, "charged_units": 0, "execution_charged_units": 0, "speaker_after": dv_without(speaker, "simulations"), "preselection_source_revision": predicted.actor_before.mind.revision}))
            else:
                dvs_event(events, "speaker_prediction", speaker.id, time, dv_single(source), {"listener": listener_id, "status": "unknown-no-paid-preselection", "source_event": source})
            if (target_index < 0):
                dvs_event(events, "speech_unheard", listener_id, time, dv_single(source), {"reason": "unknown-listener", "source_event": source})
            else:
                var listener = next[target_index]
                if (not dvs_speech_hearing(speaker, listener, speech, physical)):
                    dvs_event(events, "speech_unheard", listener_id, time, dv_single(source), {"reason": "no-audibility-grant", "source_event": source})
                else:
                    let message = {"speech": speech, "source": source, "speaker": speaker.id, "action_id": action.id, "received_time": time, "audibility": {"speaker_location": dvs_emission_location(speaker, speech, physical), "listener_location": dv_find(listener, "location", ""), "hearing_grants": dv_find(listener, "hearing_grants", [])}}
                    if dv_find(listener, "scheduled_action", false) != false:
                        next = dvs_replace(next, target_index, dv_with(listener, "pending_heard", dv_append(dv_find(listener, "pending_heard", []), message)))
                        dvs_event(events, "speech_received_pending", listener.id, time, [source], {"source_event": source, "audibility": message.audibility})
                    else:
                        next = dvs_replace(next, target_index, dvs_receive_scheduled_speech(listener, message, events, time))
            i = (i + 1)
    return next

fn dvs_complete_owned_decision(actor, action, success, events, execution_event, time):
    let decision = dv_find(action, "owned_decision", false)
    if not success or decision == false:
        return actor
    let snapshot = dvs_owned_decision_completion_selection(actor, action, events, execution_event)
    let execution = dvs_find_event_by_id(events, execution_event)
    if snapshot == false or execution == false or execution.type != "action_execution" or execution.actor != actor.id:
        dvs_event(events, "owned_decision_unavailable", actor.id, time, [execution_event], {"decision": decision, "reason": "current-context-or-actual-selection-unavailable"})
        return actor
    if execution.data.receipt.execution.status != "applied":
        return actor
    let inputs = dvs_owned_decision_inputs(actor, decision, actor.mind)
    let previous = dv_find(dv_find(actor, "owned_decisions", []), decision.id, false)
    let receipt = {"id": decision.id, "stance": decision.stance, "context": inputs.context, "basis": decision.basis, "declaration": decision, "selection_sources": snapshot.sources, "completion_sources": inputs.sources, "selection_event": snapshot.selection_event, "execution_event": execution_event, "previous_event": dv_find(previous, "event", ""), "time": time, "meaning": "actual-owner-decision-not-performance-or-outcome"}
    var parents = [execution_event, snapshot.selection_event]
    var i = 0
    while i < rt_count(snapshot.sources.requests):
        let request = snapshot.sources.requests[i].receipt
        if request != false:
            parents = dv_explanation_merge(parents, [request.source_event, request.parse_event])
        i = i + 1
    let event = dvs_event(events, "owned_decision", actor.id, time, parents, receipt)
    let recorded = dv_with(receipt, "event", event)
    return dv_with_many(actor, {"owned_decisions": dv_with(dv_find(actor, "owned_decisions", []), decision.id, recorded), "owned_decision_history": dv_append(dv_find(actor, "owned_decision_history", []), recorded), "last_cognitive_event": event})

fn dvs_complete_advice(actor, action, success, events, time, execution_event):
    let decision = dv_find(action, "advice_decision", false)
    if not success or decision == false:
        return actor
    if not dvs_advice_decision_ready(actor, action, actor.mind):
        dvs_event(events, "advice_decision_unavailable", actor.id, time, [execution_event], {"decision": decision, "reason": "receipt-or-owner-assessment-unavailable-at-complete"})
        return actor
    let receipt = dv_get(dv_find(actor, "received_advice", []), decision.advice_id)
    let selection = dvs_heard_before_selection(events, actor, action, execution_event, receipt.parse_event, receipt.source_event)
    if selection == false:
        dvs_event(events, "advice_decision_unavailable", actor.id, time, [execution_event, receipt.source_event, receipt.parse_event], {"decision": decision, "reason": "advice-not-before-decision-selection"})
        return actor
    let assessment = dvs_advice_assessment(actor, receipt, decision.assessment_action_id, actor.mind)
    var status = "declined"
    if decision.accepted:
        status = "accepted-for-consideration"
    let stance = {"advice_id": decision.advice_id, "accepted": decision.accepted, "status": status, "source_event": receipt.source_event, "parse_event": receipt.parse_event, "selection_event": selection.event, "execution_event": execution_event, "assessment": assessment, "time": time, "meaning": "owner-stance-not-target-execution-or-causal-proof"}
    let event = dvs_event(events, "advice_decision", actor.id, time, [execution_event, receipt.source_event, receipt.parse_event], stance)
    return dv_with_many(actor, {"advice_stances": dv_with(dv_find(actor, "advice_stances", []), decision.advice_id, dv_with(stance, "event", event)), "last_cognitive_event": event})

fn dvs_pragmatics_reconsider(actor, events, time, parent):
    let mind = actor.mind
    let policy = actor.policy
    var interpretations = dv_find(actor, "interpretations", [])
    let entries = interpretations
    var i = 0
    var last = dv_find(actor, "last_interpretation_event", "")
    var cognitive = dv_find(actor, "last_cognitive_event", "")
    while i < rt_count(entries):
        let entry = entries[i]
        let old = entry[1]
        let candidate = {id: entry[0], utterance_scope: dv_find(dv_find(old, "scope_check", []), "literal_scope", "")}
        let bindings = dv_find(old, "referents", [])
        var revised = dvs_listener_mapping(mind, policy, bindings) × candidate
        if revised.status == "withdrawn" and old.status != "accepted" and old.status != "withdrawn":
            revised = dv_with(revised, "status", "rejected")
        let before_interpretations = interpretations
        let source = dv_find(old, "source_event", "")
        let previous = dv_find(old, "acceptance", {degree: 0, level: "held"})
        let transition = dv_acceptance_transition(previous, revised.acceptance, parent)
        if revised.status != old.status or not dv_same(previous, revised.acceptance):
            revised = dv_with_many(revised, [["source_event", source], ["referents", bindings], ["acceptance_transition", transition]])
            interpretations = dv_with(interpretations, entry[0], revised)
            var kind = "acceptance_changed"
            if transition.transition == "withdrawn" or revised.status == "withdrawn":
                kind = "implicature_withdrawn"
            var parents = dv_pair(parent, source)
            if last != "":
                parents = dv_list3(parent, source, last)
            let detail = dv_with_many(revised, [["mind_before", mind], ["mind_after", mind], ["interpretations_before", before_interpretations], ["interpretations_after", interpretations]])
            last = dvs_event(events, kind, actor.id, time, dvs_speech_cognitive_parents(parents, cognitive), detail)
            cognitive = last
        i = i + 1
    return dv_with_many(actor, [["interpretations", interpretations], ["last_interpretation_event", last], ["last_cognitive_event", cognitive]])
