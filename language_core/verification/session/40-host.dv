// Host commands contain an action and its execution contract, never a mind or oracle.
fn dvs_present_replace(text, token, value):
    var result = ""
    var i = 0
    while i < rt_length(text):
        if i + rt_length(token) <= rt_length(text) and rt_slice(text, i, rt_length(token)) == token:
            result = rt_cat(result, value)
            i = i + rt_length(token)
        else:
            result = rt_cat(result, rt_chr(text, i))
            i = i + 1
    return result

fn dvs_present_lines(state, viewer, presentation):
    var mind = false
    var i = 0
    while i < rt_count(state.actors):
        if state.actors[i].id == viewer:
            mind = state.actors[i].mind
        i = i + 1
    var result = []
    if mind == false:
        return result
    let lines = dv_find(presentation, "lines", [])
    i = 0
    while i < rt_count(lines):
        let line = lines[i]
        var visible = dv_truth(mind, dv_find(line, "when", dv_true())) == "true"
        var text = line.template
        let bindings = dv_find(line, "bindings", [])
        var j = 0
        while visible and j < rt_count(bindings):
            let binding = bindings[j]
            let cell = dv_read(mind, binding.ref)
            if dv_uncontested(cell):
                let value = rt_show(cell.value)
                let display = dv_find(dv_find(binding, "labels", []), value, value)
                text = dvs_present_replace(text, rt_cat("{", rt_cat(binding.name, "}")), display)
            else:
                visible = false
            j = j + 1
        if visible:
            rt_push(result, text)
        i = i + 1
    return result

fn dvs_session_intent(state):
    let pending = dv_find(state, "pending", false)
    if pending == false:
        return {"status": "idle", "active": dvs_session_active(state), "game_time": state.physical.time}
    return {"status": "prepared", "actor": pending.id, "action_event": pending.action_event, "action": pending.action, "bounds": pending.quote.bounds, "execution_cost": pending.model.actual, "game_time": pending.time}

fn dvs_session_presentation(state, viewer):
    var i = rt_count(state.events) - 1
    var perceived = false
    var heard = false
    while 0 <= i:
        let event = state.events[i]
        if event.actor == viewer and (event.type == "listener_parse" or event.type == "observation"):
            perceived = true
        if event.actor == viewer and event.type == "listener_parse":
            heard = true
        if event.type == "action_execution":
            let action = event.data.action
            let applied = event.data.receipt.execution.status == "applied"
            let visible = event.actor == viewer or (heard or (perceived and not dv_has_key(action, "speech")))
            var surface = ""
            var presentation = []
            if applied and visible:
                surface = dv_find(action, "surface", dv_find(dv_find(action, "speech", []), "surface", ""))
                presentation = dv_find(action, "presentation", [])
            return {"status": event.data.receipt.execution.status, "actor": event.actor, "action_id": action.id, "game_time": event.time, "visible": applied and visible, "surface": surface, "lines": dvs_present_lines(state, viewer, presentation)}
        i = i - 1
    return {"status": "idle", "game_time": state.physical.time}
