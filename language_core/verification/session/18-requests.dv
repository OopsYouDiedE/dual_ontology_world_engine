; Requests are received speech; replies remain the other subject's paid action.
(defn dvs_pending_request (actor action)
 (let (topic (dv_find action "response_topic" "") requests (dv_find actor "received_requests" (rt_list))
       answered (dv_find actor "answered_requests" (rt_list)) result (rt_list) i 0)
  (do (while (dv_and (rt_eq (rt_count result) 0) (rt_lt i (rt_count requests)))
   (let (request (rt_at requests i))
    (do (if (dv_and (rt_eq (dv_get request "topic") topic)
      (rt_not (dv_has answered (dv_get request "parse_event")))) (set result request) false)
     (set i (rt_add i 1))))) result)))
(defn dvs_receive_request (actor speech parse_event source speaker)
 (let (request (dv_find speech "request" false))
  (if (rt_eq request false) actor
   (if (rt_eq (dv_get request "target") (dv_get actor "id"))
    (dv_with actor "received_requests" (dv_append (dv_find actor "received_requests" (rt_list))
     (dv_with (dv_with (dv_m3 "topic" (dv_get request "topic") "parse_event" parse_event "source_event" source)
      "requester" speaker) "request" request))) actor))))
(defn dvs_finish_reply (actor action)
 (let (request (dvs_pending_request actor action))
  (if (rt_lt 0 (rt_count request))
   (dv_with actor "answered_requests" (dv_append (dv_find actor "answered_requests" (rt_list))
    (dv_get request "parse_event"))) actor)))
(defn dvs_record_request (actor action)
 (let (request (dv_find (dv_find action "speech" (rt_list)) "request" false))
  (if (rt_eq request false) actor
   (dv_with actor "request_contexts" (dv_with (dv_find actor "request_contexts" (rt_list))
    (dv_get action "id") (dv_find (dv_find actor "visible_context" (rt_list)) (dv_get request "target") false))))))
(defn dvs_visible_context (actor physical actors)
 (let (result (rt_list) own (dv_read physical (dv_get actor "location_ref")) i 0)
  (do (while (rt_lt i (rt_count actors))
   (let (other (rt_at actors i) position (dv_read physical (dv_get (rt_at actors i) "location_ref")))
    (do (if (dv_and (rt_not (rt_eq (dv_get other "id") (dv_get actor "id")))
      (dv_and (dv_uncontested own) (dv_and (dv_uncontested position) (dv_same (dv_get own "value") (dv_get position "value")))))
     (set result (dv_with result (dv_get other "id")
      (dv_m2 "location" (dv_get position "value") "action_event" (dv_find other "last_action_event" "")))) false)
     (set i (rt_add i 1))))) result)))
(defn dvs_notice_peers (actor physical actors events time parent)
 (if (dv_find (dv_get actor "policy") "notice_co_presence" false)
  (let (context (dvs_visible_context actor physical actors) old (dv_find actor "visible_context" (rt_list)))
   (if (dv_same context old) actor
    (let (event (dvs_event events "co_presence" (dv_get actor "id") time (dvs_cognitive_parents actor (dv_single parent))
      (dv_m4 "context_before" old "context_after" context "physical" physical "location_ref" (dv_get actor "location_ref"))))
     (dv_with (dv_with actor "visible_context" context) "last_cognitive_event" event)))) actor))
(defn dvs_visible_action_grants (actors speaker_index action physical bindings events time parent execution_id)
 (let (speaker (rt_at actors speaker_index) listeners (dv_find action "public_observers" (rt_list))
       grants (dv_find action "public_grants" (rt_list)) result actors i 0
       own (dv_read physical (dv_get (rt_at actors speaker_index) "location_ref")))
  (do (while (rt_lt i (rt_count actors))
   (let (actor (rt_at result i) position (dv_read physical (dv_get (rt_at result i) "location_ref")))
    (do (if (dv_and (dv_and (rt_not (rt_eq i speaker_index)) (dv_has listeners (dv_get actor "id")))
      (dv_and (dv_uncontested own) (dv_and (dv_uncontested position) (dv_same (dv_get own "value") (dv_get position "value")))))
     (let (mind (dv_get actor "mind") observations (dv_perceive physical (dv_get actor "mind") bindings grants execution_id time))
      (if (rt_lt 0 (rt_count observations))
       (let (next (dv_get (dv_update_mind mind observations (dv_get mind "revision") (dvs_observation_profile actor)) "world")
             event (dvs_event events "observation" (dv_get actor "id") time (dvs_cognitive_parents actor (dv_single parent))
              (dv_with (dv_with (dv_with (dv_m4 "observations" observations "mind_before" mind "mind_after" next "action" action)
               "bindings" bindings) "grants" grants) "execution_id" execution_id)))
        (set result (dvs_replace result i (dv_with (dv_with actor "mind" next) "last_cognitive_event" event)))) false)) false)
     (set i (rt_add i 1))))) result)))
