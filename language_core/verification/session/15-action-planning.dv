; Subject-local goals, method scopes and bounded complete-layer comparison.
; Observing a scope has information value; its unknown result is never inserted into a forecast.
(defn dvp_question (actor)
  (if (dv_has_key actor "question_ref")
    (let (cell (dv_read (dv_get actor "mind") (dv_get actor "question_ref")))
      (if (dv_uncontested cell) (dv_get cell "value") "")) ""))
(defn dvp_topic (actor item)
  (let (topic (dv_find item "question" (dv_find item "topic" "")) question (dvp_question actor)
        bindings (dv_find (dv_get actor "policy") "topic_bindings" (rt_list)) i 0 active false)
    (do (if (dv_or (rt_eq topic "identity") (dv_or (rt_eq topic "voice_source") (dv_or (rt_eq topic "words") (rt_eq topic "trust"))))
          (let (open_cell (dv_read (dv_get actor "mind") (dv_ref "question" "state" (rt_cat "open_" topic))))
            (if (dv_and (dv_get open_cell "known") (dv_get open_cell "value")) (set active true) false)) false)
      (if (dv_and (rt_not (rt_eq question "")) (rt_eq topic question)) (set active true) false)
      (while (rt_lt i (rt_count bindings))
        (let (binding (rt_at bindings i))
          (do (if (dv_and (rt_eq (dv_get binding "topic") topic)
            (dv_and (rt_lt 0 (rt_count (dv_find binding "basis" (rt_list))))
              (dv_and (dv_or (dvs_topic_was_heard actor topic) (rt_eq (dv_truth (dv_get actor "mind") (dv_get binding "heard_when")) "true"))
                (rt_not (rt_eq (dv_truth (dv_get actor "mind") (dv_get binding "completed_when")) "true")))))
            (set active true) false) (set i (rt_add i 1))))) active)))
(defn dvp_add_ref (refs ref) (if (dv_has refs ref) refs (dv_append refs ref)))
(defn dvp_merge_refs (refs extra)
  (let (result refs i 0) (do (while (rt_lt i (rt_count extra))
    (do (set result (dvp_add_ref result (rt_at extra i))) (set i (rt_add i 1)))) result)))
(defn dvp_unmet_refs (mind proposition include_known)
  (let (op (dv_get proposition "op"))
    (if (rt_eq op "constant") (rt_list)
      (if (rt_eq op "not") (dvp_unmet_refs mind (dv_get proposition "item") include_known)
        (if (rt_eq op "all")
          (let (items (dv_get proposition "items") result (rt_list) i 0)
            (do (while (rt_lt i (rt_count items))
              (do (set result (dvp_merge_refs result (dvp_unmet_refs mind (rt_at items i) include_known))) (set i (rt_add i 1)))) result))
          (if (dv_or include_known (rt_not (rt_eq (dv_truth mind proposition) "true"))) (dv_single (dv_get proposition "ref")) (rt_list)))))))
(defn dvp_dependencies (mind seeds budget methods)
  (let (refs seeds queue seeds cursor 0 expanded 0 adoptions (dv_get mind "adoptions"))
    (do (while (dv_and (rt_lt cursor (rt_count queue)) (rt_lt expanded budget))
      (let (ref (rt_at queue cursor) i 0)
        (do (set expanded (rt_add expanded 1))
          (while (rt_lt i (rt_count adoptions))
            (let (adoption (rt_at (rt_at adoptions i) 1) law (dv_get (rt_at (rt_at adoptions i) 1) "law") j 0 effects (dv_get (dv_get (rt_at (rt_at adoptions i) 1) "law") "effects"))
              (do (if (dv_and (dv_get adoption "active") (rt_eq (dv_get adoption "mode") "infer"))
                (while (rt_lt j (rt_count effects))
                  (let (effect (rt_at effects j))
                    (do (if (dv_same (dv_get effect "ref") ref)
                      (let (premises (dvp_unmet_refs mind (dv_get law "premise") true) k 0)
                        (do (while (rt_lt k (rt_count premises))
                          (let (premise (rt_at premises k))
                            (do (if (dv_has refs premise) false
                              (do (set refs (dv_append refs premise)) (set queue (dv_append queue premise))))
                              (set k (rt_add k 1))))))) false) (set j (rt_add j 1))))) false)
                (set i (rt_add i 1)))))
          (set i 0)
          (while (rt_lt i (rt_count methods))
            (let (method (rt_at methods i))
              (do (if (dv_has (dv_get method "scope") ref)
                (let (premises (dvp_unmet_refs mind (dv_get method "premise") true) k 0)
                  (while (rt_lt k (rt_count premises))
                    (let (premise (rt_at premises k))
                      (do (if (dv_has refs premise) false
                        (do (set refs (dv_append refs premise)) (set queue (dv_append queue premise))))
                        (set k (rt_add k 1)))))) false)
                (set i (rt_add i 1)))))
          (set cursor (rt_add cursor 1)))))
      (dv_m3 "refs" refs "expanded" expanded "stop" (if (rt_lt cursor (rt_count queue)) "dependency-budget" "dependency-closure")))))
(defn dvp_goal_refs (actor)
  (let (goals (dv_find (dv_get actor "policy") "goals" (rt_list)) mind (dv_get actor "mind") refs (rt_list) i 0)
    (do (while (rt_lt i (rt_count goals))
      (let (goal (rt_at goals i))
        (do (if (dv_and (dvp_topic actor goal) (rt_eq (dv_truth (dv_get actor "mind") (dv_find goal "available_when" (dv_true))) "true"))
          (if (dv_has_key goal "ref") (set refs (dvp_add_ref refs (dv_get goal "ref")))
            (if (dv_has_key goal "proposition") (set refs (dvp_merge_refs refs (dvp_unmet_refs mind (dv_get goal "proposition") true))) false)) false)
          (set i (rt_add i 1))))) refs)))
(defn dvp_probe_refs (actor)
  (let (hypothesis (dv_find actor "hypothesis" false) refs (rt_list))
    (do
      (if (rt_eq hypothesis false) false
        (if (dvp_topic actor hypothesis)
          (let (features (dv_find hypothesis "features" (rt_list)) i 0)
            (do (while (rt_lt i (rt_count features))
              (let (feature (rt_at features i))
                (do (set refs (dvp_merge_refs refs (dvs_sim_refs (dv_find feature "observation" (if (dv_has_key feature "proposition") (dv_get feature "proposition") feature)))))
                  (set i (rt_add i 1))))))) false))
      refs)))
(defn dvp_scope (actor action bindings)
  (let (declared (dv_find action "purpose_refs" (rt_list)) grants (dv_find action "grants" (rt_list)) refs declared i 0)
    (do (while (rt_lt i (rt_count grants))
      (let (ref (rt_at grants i) local (dv_local bindings (dv_get (rt_at grants i) "object") (dv_get actor "id")))
        (do (if (rt_eq local "") false (set refs (dvp_add_ref refs (dv_ref local (dv_get ref "facet") (dv_get ref "field")))))
          (set i (rt_add i 1))))) refs)))
(defn dvp_answer_reward (actor action mind)
  (if (dv_has_key action "answer")
    (if (rt_eq (dv_truth mind (dv_get action "answer")) "true") 1.0
      (if (dv_and (dv_has_key actor "argument") (rt_eq (dv_find (dv_find actor "argument" (rt_list)) "question" "") (dv_find action "argument_question" ""))) 1.0
        (let (hypothesis (dv_find actor "hypothesis" false))
          (if (rt_eq hypothesis false) 0
            (if (dv_same (dv_get hypothesis "proposition") (dv_get action "answer"))
              (dv_find hypothesis "prior" 0.5) 0))))) 0))
(defn dvp_input_signature (actor action refs)
  (let (mind (dv_get actor "mind") inputs (rt_list) i 0 selected (dvp_merge_refs refs (if (dv_has_key action "answer") (dvs_sim_refs (dv_get action "answer")) (rt_list))))
    (do (if (dv_has_key action "support") (set selected (dvp_merge_refs selected (dvs_sim_refs (dv_get action "support")))) false)
      (while (rt_lt i (rt_count selected))
        (do (rt_push inputs (dv_m2 "ref" (rt_at selected i) "cell" (dvs_reason_cell (dv_read mind (rt_at selected i))))) (set i (rt_add i 1))))
      (dv_with (dv_m3 "question" (dvp_question actor) "claim" (dv_find action "answer" false) "inputs" inputs)
        "reward" (dvp_answer_reward actor action mind)))))
(defn dvp_answer_relevant (actor action)
  (if (dv_has_key action "topic") (dvp_topic actor action)
    (let (refs (dvs_sim_refs (dv_get action "answer")) goals (dvp_goal_refs actor) i 0 found false)
      (do (while (rt_lt i (rt_count refs))
        (do (if (dv_has goals (rt_at refs i)) (set found true) false) (set i (rt_add i 1)))) found))))
(defn dvp_answer_attempt_allowed (prev_sig cur_sig)
  (if (rt_eq prev_sig false) true
    (if (rt_not (dv_same (dv_get prev_sig "inputs") (dv_get cur_sig "inputs"))) true
      (if (rt_not (dv_same (dv_get prev_sig "claim") (dv_get cur_sig "claim"))) true
        (if (rt_not (dv_same (dv_get prev_sig "question") (dv_get cur_sig "question"))) true
          (let (r1 (dv_find prev_sig "reward" 0) r2 (dv_find cur_sig "reward" 0) diff (if (rt_lt r1 r2) (rt_sub r2 r1) (rt_sub r1 r2)))
            (rt_not (rt_lt diff 0.2))))))))
(defn dvp_eligible (actor action mind relevant)
  (let (id (dv_get action "id") used (dv_find actor "used" (rt_list)))
    (if (dv_and (rt_not (dv_find actor "cognition_blocked" false)) (dv_and (dv_find action "argument_available" true) (rt_eq (dv_truth mind (dv_get action "precondition")) "true")))
      (if (dv_has_key action "answer")
        (if (dv_and (dvp_answer_relevant actor action)
          (rt_lt (dv_find (dv_find actor "accepted_answers" (rt_list)) (dv_find action "topic" "") 0)
            (if (dv_has_key action "argument") 2 1)))
          (dv_and (rt_not (rt_eq (dv_truth (dv_get actor "mind") (dv_get action "answer")) "false"))
            (dvp_answer_attempt_allowed (dv_find (dv_find actor "answer_attempt_signatures" (rt_list)) id false) (dvp_input_signature actor action relevant))) false)
        (if (dv_has_key action "speech")
          (dv_and (rt_eq (dvs_speech_truth (dv_get actor "mind") (dv_get action "speech")) "true")
            (if (dv_has_key action "response_topic")
              (let (request (dvs_pending_request actor action))
                (if (rt_lt 0 (rt_count request))
                  (dv_has_key (dv_find actor "visible_context" (rt_list)) (dv_get request "requester"))
                  (dv_and (rt_not (dv_has used id))
                    (dv_has_key (dv_find actor "visible_context" (rt_list)) (dv_find action "offer_to" "")))))
              (if (dv_has_key (dv_get action "speech") "request")
                (let (context (dv_find (dv_find actor "visible_context" (rt_list)) (dv_get (dv_get (dv_get action "speech") "request") "target") false))
                  (dv_and (rt_not (rt_eq context false))
                    (rt_not (dv_same context (dv_find (dv_find actor "request_contexts" (rt_list)) id false)))))
                (rt_not (dv_has used id)))))
          (if (rt_eq (dv_get action "kind") "replay")
            (rt_not (dv_same (dv_find (dv_find actor "replay_attempt_signatures" (rt_list)) id false) (dvp_input_signature actor action relevant)))
            (if (dv_find action "repeatable" false) true (rt_not (dv_has used id)))))) false)))
(defn dvp_source_supported (cell source)
  (let (claims (dv_find cell "claims" (rt_list)) i 0 found false)
    (do (while (rt_lt i (rt_count claims))
      (let (claim (rt_at claims i))
        (do (if (dv_and (rt_eq (dv_get claim "source") source) (dv_same (dv_get claim "value") (dv_get cell "value"))) (set found true) false)
          (set i (rt_add i 1))))) found)))
(defn dvp_needs_evidence (actor ref)
  (let (goals (dv_find (dv_get actor "policy") "goals" (rt_list)) i 0 needed false)
    (do (while (rt_lt i (rt_count goals))
      (let (goal (rt_at goals i))
        (do (if (dv_and (dvp_topic actor goal) (rt_eq (dv_truth (dv_get actor "mind") (dv_find goal "available_when" (dv_true))) "true"))
          (if (rt_eq (dv_find goal "kind" "know") "evidence")
            (if (dv_has_key goal "ref")
              (if (dv_same (dv_get goal "ref") ref)
                (let (cell (dv_read (dv_get actor "mind") ref))
                  (if (dvp_source_supported cell (dv_find goal "source" "perception")) false (set needed true))) false) false) false) false)
          (set i (rt_add i 1))))) needed)))
(defn dvp_action_value (actor action bindings relevant probes)
  (let (mind (dv_get actor "mind") policy (dv_get actor "policy") scope (dvp_scope actor action bindings)
        i 0 information 0 verification 0 progress 0 hypothesis (dv_find actor "hypothesis" false))
    (do (while (rt_lt i (rt_count scope))
      (let (ref (rt_at scope i) cell (dv_read mind (rt_at scope i)))
        (do (if (dv_or (rt_not (dv_uncontested cell)) (dvp_needs_evidence actor ref))
          (do (if (dv_has relevant ref) (set information (rt_add information 1)) false)
            (if (dv_has probes ref) (set verification (rt_add verification 1)) false)) false) (set i (rt_add i 1)))))
      (if (dv_has_key action "answer")
        (set progress (dvp_answer_reward actor action mind)) false)
      (if (dv_has_key action "speech")
        (if (rt_lt 0 (rt_count (dvs_speech_goals actor)))
          (let (choice (dv_find (dv_find actor "speech_choice_values" (rt_list)) (dv_get action "id") (rt_list)))
            (if (rt_eq (dv_find choice "status" "") "ready") (set progress (dv_get choice "utility")) false))
          (if (dv_has_key (dv_get action "speech") "request") false (set progress 1))) false)
      (if (dv_has_key action "response_topic")
        (if (rt_lt 0 (rt_count (dvs_pending_request actor action))) (set information (rt_add information 1)) false) false)
      (if (dvp_communication_progress actor action) (set progress 1) false)
      (if (rt_eq (dv_get action "kind") "replay")
        (if (rt_lt 0 (dv_find policy "model_budget" 0))
          (if (rt_eq hypothesis false) false
            (if (dv_and (dvp_topic actor hypothesis)
              (dv_and (rt_lt 0 (rt_count (dv_find hypothesis "features" (rt_list))))
                (rt_lt 0 (rt_count (dvs_sim_plan hypothesis)))))
              (if (rt_eq (dv_find (dvs_cached_model actor hypothesis) "status" "unknown") "stale-or-unavailable")
                (set verification (rt_add verification 1)) false) false)) false) false)
      (dv_m4 "information" information "verification" verification "progress" progress "value"
        (rt_add (rt_mul (rt_add information verification) (dv_find policy "information_weight" 1)) (rt_mul progress (dv_find policy "progress_weight" 1)))))))
(defn dvp_state_key (mind)
  (let (objects (dv_get mind "objects") result (rt_list) i 0)
    (do (while (rt_lt i (rt_count objects))
      (let (entry (rt_at objects i) object (rt_at (rt_at objects i) 1) facets (dv_get (rt_at (rt_at objects i) 1) "facets") j 0)
        (do (while (rt_lt j (rt_count facets))
          (let (facet (rt_at facets j) fields (rt_at (rt_at facets j) 1) k 0)
            (do (while (rt_lt k (rt_count fields))
              (let (field (rt_at fields k))
                (do (rt_push result (dv_m2 "ref" (dv_ref (rt_at entry 0) (rt_at facet 0) (rt_at field 0)) "cell" (dvs_reason_value (rt_at field 1))))
                  (set k (rt_add k 1))))) (set j (rt_add j 1))))) (set i (rt_add i 1))))) (rt_json_stringify result))))
(defn dvp_node_key (node)
  (if (dv_has_key node "key")
    (dv_get node "key")
    (dvp_state_key (dv_get node "mind"))))
(defn dvp_frontier_put (frontier node)
  (let (key (dvp_node_key node) i 0 result (rt_list) dominated false
        node_score (dv_get node "score") node_elapsed (dv_find node "elapsed" 0))
    (do
      (while (rt_lt i (rt_count frontier))
        (let (existing (rt_at frontier i)
              ex_key (dvp_node_key existing)
              ex_score (dv_get existing "score")
              ex_elapsed (dv_find existing "elapsed" 0))
          (do
            (if (dv_same key ex_key)
              (do
                (if (dv_and (rt_not (rt_lt ex_score node_score)) (rt_not (rt_lt node_elapsed ex_elapsed)))
                  (do (set dominated true) (rt_push result existing))
                  (if (dv_and (rt_not (rt_lt node_score ex_score)) (rt_not (rt_lt ex_elapsed node_elapsed)))
                    false
                    (rt_push result existing))))
              (rt_push result existing))
            (set i (rt_add i 1)))))
      (if dominated false (rt_push result node)) result)))
(defn dvp_dependency_methods (actor)
  (let (actions (dv_get actor "actions") methods (rt_list) i 0)
    (do (while (rt_lt i (rt_count actions))
      (do (rt_push methods (dv_m2 "scope" (dv_find (rt_at actions i) "purpose_refs" (dv_find (rt_at actions i) "grants" (rt_list)))
        "premise" (dv_get (rt_at actions i) "precondition"))) (set i (rt_add i 1)))) methods)))
(defn dvp_cached_dependencies (actor seeds budget)
  (let (methods (dvp_dependency_methods actor)
        signature (dv_m4 "question" (dvp_question actor) "seeds" seeds "adoptions" (dv_get (dv_get actor "mind") "adoptions") "methods" methods) cache (dv_find actor "dependency_cache" false))
    (if (rt_eq cache false)
      (let (result (dvp_dependencies (dv_get actor "mind") seeds budget methods))
        (dv_with (dv_with result "cache_hit" false) "cache" (if (rt_eq (dv_get result "stop") "dependency-closure") (dv_m2 "signature" signature "result" result) false)))
      (if (dv_same (dv_get cache "signature") signature)
        (dv_with (dv_with (dv_with (dv_get cache "result") "expanded" 0) "cache_hit" true) "cache" cache)
        (let (result (dvp_dependencies (dv_get actor "mind") seeds budget methods))
          (dv_with (dv_with result "cache_hit" false) "cache" (if (rt_eq (dv_get result "stop") "dependency-closure") (dv_m2 "signature" signature "result" result) false)))))))
(defn dvp_plan (actor bindings costs)
  (let (budget (dv_find (dv_get actor "policy") "plan_budget" 0) depth_limit (dv_find (dv_get actor "policy") "plan_depth" 2)
        goals (dvp_goal_refs actor) probes (dvp_probe_refs actor) dependencies (dvp_cached_dependencies actor (dvp_merge_refs goals probes) budget)
        relevant (dv_get dependencies "refs") expanded (dv_get dependencies "expanded") best false best_score -100000 best_path (rt_list)
        init_key (dvp_state_key (dv_get actor "mind"))
        plans (rt_list) frontier (dv_single (dv_with (dv_m4 "mind" (dv_get actor "mind") "path" (rt_list) "score" 0 "seen" (dv_single init_key)) "key" init_key))
        depth 0 time_blocked 0 stop "complete-depth" actions (dv_get actor "actions") visited (rt_list))
    (do (set visited (dv_single (dv_m3 "key" init_key "score" 0 "elapsed" 0))) (while (dv_and (rt_lt depth depth_limit) (rt_lt 0 (rt_count frontier)))
      (if (rt_lt (rt_sub budget expanded) (rt_count frontier)) (do (set stop "incomplete-layer-budget") (set frontier (rt_list)))
        (let (next_frontier (rt_list) n 0)
          (do (while (rt_lt n (rt_count frontier))
            (let (node (rt_at frontier n) i 0 mind (dv_get (rt_at frontier n) "mind") node_actor (dvp_actor_view actor mind))
              (do (set expanded (rt_add expanded 1))
                (while (rt_lt i (rt_count actions))
                  (let (action (rt_at actions i))
                    (do (if (if (dvp_eligible actor action mind relevant)
                      (if (dv_has_key (dv_get actor "policy") "remaining_game_time")
                        (if (rt_lt (dv_get (dv_get actor "policy") "remaining_game_time")
                          (rt_add (dv_find node "elapsed" 0) (dv_get (dv_get (dv_get costs (dv_get action "kind")) "maximum") "time")))
                          (do (set time_blocked (rt_add time_blocked 1)) false) true) true) false)
                      (let (value (dvp_action_value node_actor action bindings relevant probes) cost (dv_get (dv_get costs (dv_get action "kind")) "actual")
                            path (dv_append (dv_get node "path") (dv_get action "id")) score 0)
                        (do (set score (rt_add (dv_get node "score") (rt_sub (dv_get value "value")
                          (rt_mul (dv_get cost "time") (dv_find (dv_get actor "policy") "time_cost" 0.01)))))
                          (rt_push plans (dv_with (dv_with (dv_with (dv_m4 "path" path "score" score "value" value "relevant_refs" relevant) "probe_refs" probes) "mind_revision" (dv_get (dv_get actor "mind") "revision")) "prediction_basis" (dv_find node "prediction_basis" (rt_list))))
                          (if (rt_lt best_score score) (do (set best_score score) (set best_path path) (set best (dvp_find_action actions (rt_at path 0)))) false)
                          (if (dv_and (rt_lt 0 (rt_count relevant)) (dv_has_key action "predict_law"))
                            (let (name (dv_get action "predict_law") adoptions (dv_get mind "adoptions"))
                              (if (dv_has_key adoptions name)
                               (let (adoption (dv_get adoptions name))
                                  (if (dv_and (dv_get adoption "active") (rt_eq (dv_get adoption "mode") "predict"))
                                    (let (prediction (dv_predict (dv_with mind "domain" "mind") name
                                      (rt_cat "plan-" (rt_show (rt_count plans))) (dv_find mind "time" 0) (dv_get mind "revision")))
                                      (if (rt_eq (dv_get prediction "status") "applied")
                                        (let (predicted (dv_get prediction "world") pred_key (dvp_state_key predicted))
                                          (if (dv_has (dv_get node "seen") pred_key) false
                                            (let (candidate_node (dv_with (dv_with (dv_with (dv_m4 "mind" predicted "path" path "score" score "seen" (dv_append (dv_get node "seen") pred_key)) "key" pred_key) "prediction_basis" (dv_get adoption "basis")) "elapsed" (rt_add (dv_find node "elapsed" 0) (dv_get (dv_get (dv_get costs (dv_get action "kind")) "maximum") "time"))))
                                              (if (dvp_dominated visited candidate_node) false
                                                (do (set visited (dvp_frontier_put visited (dv_m3 "key" pred_key "score" score "elapsed" (dv_get candidate_node "elapsed"))))
                                                  (set next_frontier (dvp_frontier_put next_frontier candidate_node))))))) false)) false)) false)) false))) false)
                      (set i (rt_add i 1))))) (set n (rt_add n 1)))))
            (set frontier next_frontier) (set depth (rt_add depth 1))))))
      (dv_with (dv_with (dv_with (dv_with (dv_with (dv_with (dv_m4 "action" (if (rt_lt 0 best_score) best false) "score" best_score "plan_expansions" expanded "plans" plans) "selected_path" best_path)
        "relevant_refs" relevant) "stop" (if (dv_and (rt_not (rt_lt 0 best_score)) (rt_lt 0 time_blocked)) "duration-budget" stop)) "time_blocked" time_blocked) "dependency_cache" (dv_get dependencies "cache")) "dependency_cache_hit" (dv_get dependencies "cache_hit")))))
(defn dvp_find_action (actions id)
  (let (i 0 result false) (do (while (rt_lt i (rt_count actions))
    (do (if (rt_eq (dv_get (rt_at actions i) "id") id) (set result (rt_at actions i)) false) (set i (rt_add i 1)))) result)))
; Scoring reads this local view; persistent actor updates happen outside planning.
(defn dvp_actor_view (actor mind)
  (let (result (rt_list) i 0)
    (do (while (rt_lt i (rt_count actor))
      (let (entry (rt_at actor i))
        (do (rt_push result (if (rt_eq (rt_at entry 0) "mind") (dv_pair "mind" mind) entry))
          (set i (rt_add i 1))))) result)))
(defn dvp_dominated (nodes candidate)
  (let (i 0 found false)
    (do (while (dv_and (rt_not found) (rt_lt i (rt_count nodes)))
      (let (node (rt_at nodes i))
        (do (if (dv_and (dv_same (dvp_node_key node) (dvp_node_key candidate))
          (dv_and (rt_not (rt_lt (dv_get node "score") (dv_get candidate "score")))
            (rt_not (rt_lt (dv_find candidate "elapsed" 0) (dv_find node "elapsed" 0))))) (set found true) false)
          (set i (rt_add i 1))))) found)))

; Public transmission progress never predicts another subject's acceptance.
(defn dvp_communication_progress (actor action)
  (let (goals (dv_find (dv_get actor "policy") "goals" (rt_list)) i 0 value false)
    (do (while (rt_lt i (rt_count goals))
      (let (goal (rt_at goals i))
        (do (if (rt_eq (dv_find goal "kind" "") "communicate")
          (if (dv_and (rt_eq (dv_find goal "method_id" "") (dv_get action "id"))
            (dv_and (rt_lt 0 (rt_count (dv_find goal "basis" (rt_list))))
              (rt_eq (dv_truth (dv_get actor "mind") (dv_find goal "available_when" (dv_m2 "op" "constant" "value" "true"))) "true")))
            (if (dv_and (dv_find goal "requires_argument" false) (dv_find action "speech_from_argument" false))
              (if (dv_find action "argument_available" false) (set value true) false) false) false) false)
          (set i (rt_add i 1))))) value)))
