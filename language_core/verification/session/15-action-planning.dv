// The whole planning input is retained. Only runner bookkeeping is omitted.
fn dvp_memo_input(actor, costs):
    var policy = actor.policy
    if dv_has_key(policy, "remaining_game_time"):
        var maximum = 0
        var i = 0
        while i < rt_count(costs):
            maximum = dv_max(maximum, costs[i][1].maximum.time)
            i = i + 1
        let bound = dv_find(policy, "plan_depth", 2) * maximum
        if bound <= policy.remaining_game_time:
            policy = dv_with(policy, "remaining_game_time", bound)
    var result = []
    var i = 0
    while i < rt_count(actor):
        let entry = actor[i]
        let key = entry[0]
        if key != "decision_time" and key != "decision_revision" and key != "planning_work_total" and key != "last_cognitive_event":
            if key == "policy":
                rt_push(result, dv_pair(key, policy))
            else:
                rt_push(result, entry)
        i = i + 1
    return result

// Subject-local goals, method scopes and bounded complete-layer comparison.
// Observing a scope has information value; its unknown result is never inserted into a forecast.
// Scoring reads this local view; persistent actor updates happen outside planning.
// Public transmission progress never predicts another subject's acceptance.

fn dvp_question(actor):
    if dv_has_key(actor, "question_ref"):
        var cell = dv_read(actor.mind, actor.question_ref)
        if dv_uncontested(cell):
            return cell.value
        else:
            return ""
    else:
        return ""

fn dvp_topic(actor, item):
    if dv_find(item, "scope", "") == "personal" and 0 < rt_count(dv_find(item, "basis", [])):
        return true
    var topic = dv_find(item, "question", dv_find(item, "topic", ""))
    var question = dvp_question(actor)
    var bindings = dv_find(actor.policy, "topic_bindings", [])
    var i = 0
    var active = false
    if dv_and((not (question == "")), (topic == question)):
        active = true
    while (i < rt_count(bindings)):
        var binding = bindings[i]
        if dv_and((binding.topic == topic), dv_and((0 < rt_count(dv_find(binding, "basis", []))), dv_and(dv_or(dvs_topic_was_heard(actor, topic), (dv_truth(actor.mind, binding.heard_when) == "true")), (not (dv_truth(actor.mind, binding.completed_when) == "true"))))):
            active = true
        i = (i + 1)
    return active

fn dvp_add_ref(refs, ref):
    if dv_has(refs, ref):
        return refs
    else:
        return dv_append(refs, ref)

fn dvp_merge_refs(refs, extra):
    var result = refs
    var i = 0
    while (i < rt_count(extra)):
        result = dvp_add_ref(result, extra[i])
        i = (i + 1)
    return result

fn dvp_unmet_refs(mind, proposition, include_known):
    var op = proposition.op
    if (op == "constant"):
        return []
    else:
        if (op == "not"):
            return dvp_unmet_refs(mind, proposition.item, include_known)
        else:
            if (op == "all"):
                var items = proposition.items
                var result = []
                var i = 0
                while (i < rt_count(items)):
                    result = dvp_merge_refs(result, dvp_unmet_refs(mind, items[i], include_known))
                    i = (i + 1)
                return result
            else:
                if dv_or(include_known, (not (dv_truth(mind, proposition) == "true"))):
                    return dv_single(proposition.ref)
                else:
                    return []

fn dvp_dependencies(mind, seeds, budget, methods):
    var refs = seeds
    var queue = seeds
    var cursor = 0
    var expanded = 0
    var adoptions = mind.adoptions
    while dv_and((cursor < rt_count(queue)), (expanded < budget)):
        var ref = queue[cursor]
        var i = 0
        expanded = (expanded + 1)
        while (i < rt_count(adoptions)):
            var adoption = adoptions[i][1]
            var law = adoptions[i][1].law
            var j = 0
            var effects = adoptions[i][1].law.effects
            if dv_and(adoption.active, (adoption.mode == "infer")):
                while (j < rt_count(effects)):
                    var effect = effects[j]
                    if dv_same(effect.ref, ref):
                        var premises = dvp_unmet_refs(mind, law.premise, true)
                        var k = 0
                        while (k < rt_count(premises)):
                            var premise = premises[k]
                            if dv_has(refs, premise):
                                false
                            else:
                                refs = dv_append(refs, premise)
                                queue = dv_append(queue, premise)
                            k = (k + 1)
                    j = (j + 1)
            i = (i + 1)
        i = 0
        while (i < rt_count(methods)):
            var method = methods[i]
            if dv_has(method.scope, ref):
                var premises = dvp_merge_refs(dvp_unmet_refs(mind, method.premise, true), dv_find(method, "owner_refs", []))
                var k = 0
                while (k < rt_count(premises)):
                    var premise = premises[k]
                    if dv_has(refs, premise):
                        false
                    else:
                        refs = dv_append(refs, premise)
                        queue = dv_append(queue, premise)
                    k = (k + 1)
            i = (i + 1)
        cursor = (cursor + 1)
    var local_1 = false
    if (cursor < rt_count(queue)):
        local_1 = "dependency-budget"
    else:
        local_1 = "dependency-closure"
    return {"refs": refs, "expanded": expanded, "stop": local_1}

fn dvp_goal_refs(actor):
    var goals = dv_find(actor.policy, "goals", [])
    var mind = actor.mind
    var refs = []
    var i = 0
    while (i < rt_count(goals)):
        var goal = goals[i]
        if dv_and(dvp_topic(actor, goal), (dv_truth(actor.mind, dv_find(goal, "available_when", dv_true())) == "true")):
            if dv_has_key(goal, "ref"):
                refs = dvp_add_ref(refs, goal.ref)
            else:
                if dv_has_key(goal, "proposition"):
                    refs = dvp_merge_refs(refs, dvp_unmet_refs(mind, goal.proposition, true))
        i = (i + 1)
    return refs

fn dvp_probe_refs(actor):
    var hypothesis = dv_find(actor, "hypothesis", false)
    var refs = []
    if (hypothesis == false):
        false
    else:
        if dvp_topic(actor, hypothesis):
            var features = dv_find(hypothesis, "features", [])
            var i = 0
            while (i < rt_count(features)):
                var feature = features[i]
                var local_1 = false
                if dv_has_key(feature, "proposition"):
                    local_1 = feature.proposition
                else:
                    local_1 = feature
                refs = dvp_merge_refs(refs, dvs_sim_refs(dv_find(feature, "observation", local_1)))
                i = (i + 1)
    return refs

fn dvp_scope(actor, action, bindings):
    var declared = dv_find(action, "purpose_refs", [])
    var grants = dv_find(action, "grants", [])
    var refs = declared
    var i = 0
    while (i < rt_count(grants)):
        var ref = grants[i]
        var local = dv_local(bindings, grants[i].object, actor.id)
        if (local == ""):
            false
        else:
            refs = dvp_add_ref(refs, dv_ref(local, ref.facet, ref.field))
        i = (i + 1)
    return refs

fn dvp_answer_reward(actor, action, mind):
    if dv_has_key(action, "answer"):
        if (dv_truth(mind, action.answer) == "true"):
            return 1.0
        else:
            if dv_and(dv_has_key(actor, "argument"), (dv_find(dv_find(actor, "argument", []), "question", "") == dv_find(action, "argument_question", ""))):
                return 1.0
            else:
                var hypothesis = dv_find(actor, "hypothesis", false)
                if (hypothesis == false):
                    return 0
                else:
                    if dv_same(hypothesis.proposition, action.answer):
                        return dv_find(hypothesis, "prior", 0.5)
                    else:
                        return 0
    else:
        return 0

fn dvp_input_signature(actor, action, refs):
    var mind = actor.mind
    var inputs = []
    var i = 0
    var local_1 = false
    if dv_has_key(action, "answer"):
        local_1 = dvs_sim_refs(action.answer)
    else:
        local_1 = []
    var selected = dvp_merge_refs(refs, local_1)
    if dv_has_key(action, "support"):
        selected = dvp_merge_refs(selected, dvs_sim_refs(action.support))
    while (i < rt_count(selected)):
        rt_push(inputs, {"ref": selected[i], "cell": dvs_reason_cell(dv_read(mind, selected[i]))})
        i = (i + 1)
    return dv_with({"question": dvp_question(actor), "claim": dv_find(action, "answer", false), "inputs": inputs}, "reward", dvp_answer_reward(actor, action, mind))

fn dvp_answer_relevant(actor, action):
    if dv_has_key(action, "topic"):
        return dvp_topic(actor, action)
    else:
        var refs = dvs_sim_refs(action.answer)
        var goals = dvp_goal_refs(actor)
        var i = 0
        var found = false
        while (i < rt_count(refs)):
            if dv_has(goals, refs[i]):
                found = true
            i = (i + 1)
        return found

fn dvp_answer_attempt_allowed(prev_sig, cur_sig):
    if (prev_sig == false):
        return true
    else:
        if (not dv_same(prev_sig.inputs, cur_sig.inputs)):
            return true
        else:
            if (not dv_same(prev_sig.claim, cur_sig.claim)):
                return true
            else:
                if (not dv_same(prev_sig.question, cur_sig.question)):
                    return true
                else:
                    var r1 = dv_find(prev_sig, "reward", 0)
                    var r2 = dv_find(cur_sig, "reward", 0)
                    var local_1 = false
                    if (r1 < r2):
                        local_1 = (r2 - r1)
                    else:
                        local_1 = (r1 - r2)
                    var diff = local_1
                    return (not (diff < 0.2))

fn dvp_inspection_signature(actor, action, mind):
    let refs = dvp_merge_refs(dv_find(action, "grants", []), dvs_sim_refs(action.precondition))
    var inputs = []
    var i = 0
    while i < rt_count(refs):
        let cell = dv_read(mind, refs[i])
        rt_push(inputs, {"ref": refs[i], "known": cell.known, "value": cell.value, "conflicted": cell.conflicted})
        i = i + 1
    let goals = dvp_refresh_current_evidence(actor, dv_find(actor.policy, "goals", []))
    var freshness = []
    i = 0
    while i < rt_count(goals):
        let goal = goals[i]
        if dv_find(goal, "kind", "") == "evidence" and dv_has_key(goal, "ref") and dv_has(refs, goal.ref):
            rt_push(freshness, {"ref": goal.ref, "minimum_time": dv_find(goal, "minimum_time", 0), "available": dv_truth(mind, dv_find(goal, "available_when", dv_true()))})
        i = i + 1
    return {"inputs": inputs, "freshness": freshness}

fn dvp_eligible_base(actor, action, mind, relevant):
    var id = action.id
    var used = dv_find(actor, "used", [])
    if dv_and((not dv_find(actor, "cognition_blocked", false)), dv_and(dv_find(action, "argument_available", true), (dv_truth(mind, action.precondition) == "true"))):
        if action.kind == "inspect":
            let inspection_actor = dvp_actor_view(actor, mind)
            if dv_same(dv_find(dv_find(actor, "inspection_attempt_signatures", []), id, false), dvp_inspection_signature(inspection_actor, action, mind)):
                return false
        if dv_has_key(action, "answer"):
            var local_1 = false
            if dv_has_key(action, "argument"):
                local_1 = 2
            else:
                local_1 = 1
            if dv_and(dvp_answer_relevant(actor, action), (dv_find(dv_find(actor, "accepted_answers", []), dv_find(action, "topic", ""), 0) < local_1)):
                var speech_ready = true
                if dv_has_key(action, "speech"):
                    speech_ready = (dvs_speech_truth(actor.mind, action.speech) == "true")
                return dv_and(speech_ready, dv_and((not (dv_truth(actor.mind, action.answer) == "false")), dvp_answer_attempt_allowed(dv_find(dv_find(actor, "answer_attempt_signatures", []), id, false), dvp_input_signature(actor, action, relevant))))
            else:
                return false
        else:
            if dv_has_key(action, "speech"):
                var local_2 = false
                if dv_has_key(action, "response_topic"):
                    var request = dvs_pending_request(actor, action)
                    if (0 < rt_count(request)):
                        local_2 = (dvs_request_context(actor, action, request.requester) != false)
                    else:
                        local_2 = dv_and((not dv_has(used, id)), dv_or(dv_has_key(dv_find(actor, "visible_context", []), dv_find(action, "offer_to", "")), dv_find(action, "opportunity_requirement", false) != false and dvp_communication_progress(actor, action)))
                else:
                    if dv_has_key(action.speech, "request"):
                        var context = dvs_request_context(actor, action, action.speech.request.target)
                        local_2 = dv_and((not (context == false)), (not dv_same(context, dv_find(dv_find(actor, "request_contexts", []), id, false))))
                    else:
                        local_2 = (not dv_has(used, id))
                return dv_and((dvs_speech_truth(actor.mind, action.speech) == "true"), local_2)
            else:
                if (action.kind == "replay"):
                    return 0 < dv_find(actor.policy, "model_budget", 0) and (not dv_same(dv_find(dv_find(actor, "replay_attempt_signatures", []), id, false), dvp_input_signature(actor, action, relevant)))
                else:
                    if dv_find(action, "repeatable", false):
                        return true
                    else:
                        return (not dv_has(used, id))
    else:
        return false

fn dvp_source_supported(cell, source):
    return dvp_source_supported_since(cell, source, 0)

fn dvp_source_supported_since(cell, source, minimum_time):
    var claims = dv_find(cell, "claims", [])
    var i = 0
    var found = false
    while (i < rt_count(claims)):
        var claim = claims[i]
        if dv_and((claim.source == source), dv_same(claim.value, cell.value)) and minimum_time <= dv_find(claim, "time", 0):
            found = true
        i = (i + 1)
    return found

fn dvp_needs_evidence(actor, ref):
    var goals = dv_find(actor.policy, "goals", [])
    var i = 0
    var needed = false
    while (i < rt_count(goals)):
        var goal = goals[i]
        if dv_and(dvp_topic(actor, goal), (dv_truth(actor.mind, dv_find(goal, "available_when", dv_true())) == "true")):
            if (dv_find(goal, "kind", "know") == "evidence"):
                if dv_has_key(goal, "ref"):
                    if dv_same(goal.ref, ref):
                        var cell = dv_read(actor.mind, ref)
                        if dvp_source_supported_since(cell, dv_find(goal, "source", "perception"), dv_find(goal, "minimum_time", 0)):
                            false
                        else:
                            needed = true
        i = (i + 1)
    return needed

fn dvp_action_value(actor, action, bindings, relevant, probes):
    return dvp_action_value_context(actor, action, bindings, relevant, probes, dvp_value_context(actor))

fn dvp_value_context(actor):
    var evidence = []
    var achievements = []
    var communications = []
    let goals = dv_find(actor.policy, "goals", [])
    var i = 0
    while i < rt_count(goals):
        let goal = goals[i]
        let kind = dv_find(goal, "kind", "know")
        if kind == "evidence" and dv_has_key(goal, "ref"):
            if dvp_topic(actor, goal) and dv_truth(actor.mind, dv_find(goal, "available_when", dv_true())) == "true":
                if not dvp_source_supported_since(dv_read(actor.mind, goal.ref), dv_find(goal, "source", "perception"), dv_find(goal, "minimum_time", 0)):
                    rt_push(evidence, goal.ref)
        if kind == "achieve" and dvp_topic(actor, goal) and 0 < rt_count(dv_find(goal, "basis", [])):
            if not dv_has(dv_find(actor, "planning_achievements", []), goal.proposition):
                if dv_truth(actor.mind, dv_find(goal, "available_when", dv_true())) == "true" and dv_truth(actor.mind, goal.proposition) != "true":
                    rt_push(achievements, goal)
        if kind == "communicate" and 0 < rt_count(dv_find(goal, "basis", [])) and dv_truth(actor.mind, dv_find(goal, "available_when", dv_true())) == "true":
            rt_push(communications, goal)
        i = i + 1
    return {"evidence": evidence, "achievements": achievements, "communications": communications, "speech_goals": dvs_speech_goals(actor)}

fn dvp_context_communication(action, goals):
    var i = 0
    var value = false
    while i < rt_count(goals):
        let goal = goals[i]
        if dv_find(goal, "method_id", "") == action.id:
            if not dv_find(goal, "requires_argument", false) or (dv_find(action, "speech_from_argument", false) and dv_find(action, "argument_available", false)):
                value = true
        i = i + 1
    return value

fn dvp_action_value_context(actor, action, bindings, relevant, probes, context):
    var mind = actor.mind
    var policy = actor.policy
    var scope = dvp_scope(actor, action, bindings)
    var i = 0
    var information = 0
    var verification = 0
    var progress = 0
    var hypothesis = dv_find(actor, "hypothesis", false)
    while (i < rt_count(scope)):
        var ref = scope[i]
        var cell = dv_read(mind, scope[i])
        if dv_or((not dv_uncontested(cell)), dv_has(context.evidence, ref)):
            if dv_has(relevant, ref):
                information = (information + 1)
            if dv_has(probes, ref):
                verification = (verification + 1)
        i = (i + 1)
    if dv_has_key(action, "answer"):
        progress = dvp_answer_reward(actor, action, mind)
    if dv_has_key(action, "speech"):
        if (0 < rt_count(context.speech_goals)):
            var choice = dv_find(dv_find(actor, "speech_choice_values", []), action.id, [])
            if (dv_find(choice, "status", "") == "ready"):
                progress = choice.utility
        else:
            if dv_has_key(action.speech, "request"):
                false
            else:
                progress = 1
    if dv_has_key(action, "response_topic"):
        if (0 < rt_count(dvs_pending_request(actor, action))):
            information = (information + 1)
    if dvp_context_communication(action, context.communications):
        progress = 1
    if dv_has_key(action, "personal_choice"):
        progress = 1
    let resonance = dv_find(action, "resonance", false)
    if resonance != false:
        dv_require(dv_record_like(resonance), "Resonance must be a record")
        if not dv_find(resonance, "passive", false):
            progress = progress + dvp_resonance_utility(actor, action, mind)
    if (action.kind == "replay"):
        if (0 < dv_find(policy, "model_budget", 0)):
            if (hypothesis == false):
                false
            else:
                if dv_and(dvp_topic(actor, hypothesis), dv_and((0 < rt_count(dv_find(hypothesis, "features", []))), (0 < rt_count(dvs_sim_plan(hypothesis))))):
                    if (dv_find(dvs_cached_model(actor, hypothesis), "status", "unknown") == "stale-or-unavailable"):
                        verification = (verification + 1)
    let achievement = dvp_achievement_pending(actor, action, context.achievements)
    return {"information": information, "verification": verification, "progress": progress, "achievement": achievement, "value": (((information + verification) * dv_find(policy, "information_weight", 1)) + ((progress + achievement) * dv_find(policy, "progress_weight", 1)))}

// Access to an already owned communication goal is not its fulfillment.
// Predict only the subject's adopted effect; never supply a listener or an answer.
fn dvp_opportunities(actor, action):
    if action.kind != "move":
        return []
    let goals = dv_find(actor.policy, "goals", [])
    var pending = []
    var i = 0
    while i < rt_count(goals):
        let goal = goals[i]
        if dv_find(goal, "kind", "") == "communicate" and dv_find(goal, "scope", "") == "personal" and dv_find(goal, "owner", "") == actor.id:
            let method = dvp_find_action(actor.actions, dv_find(goal, "method_id", ""))
            if method != false and 0 < rt_count(dv_find(goal, "basis", [])) and not dv_has(dv_find(actor, "used", []), method.id):
                if not dv_has(dv_find(actor, "planning_opportunities", []), i):
                    if not dv_find(goal, "requires_argument", false) or (dv_find(method, "speech_from_argument", false) and dv_find(method, "argument_available", false)):
                        rt_push(pending, {"key": i, "goal": goal, "method": method})
        i = i + 1
    let adoption = dv_find(actor.mind.adoptions, dv_find(action, "predict_law", ""), false)
    if rt_count(pending) == 0 or adoption == false:
        return []
    if not adoption.active or adoption.mode != "predict":
        return []
    i = 0
    while i < rt_count(adoption.law.effects):
        if not dv_same_local_ref(actor.id, adoption.law.effects[i].ref, actor.location_ref):
            return []
        i = i + 1
    let prediction = dv_predict(dv_with(actor.mind, "domain", "mind"), action.predict_law, "opportunity-forecast", dv_find(actor.mind, "time", 0), actor.mind.revision)
    if prediction.status != "applied":
        return []
    var result = []
    let predicted_actor = dvp_actor_view(actor, prediction.world)
    let before = dv_read(actor.mind, actor.location_ref)
    let after = dv_read(prediction.world, actor.location_ref)
    if not dv_uncontested(before) or not dv_uncontested(after) or before.value == after.value:
        return []
    i = 0
    while i < rt_count(pending):
        let item = pending[i]
        if dv_truth(prediction.world, dv_find(item.goal, "available_when", dv_true())) == "true" and dv_truth(prediction.world, item.method.precondition) == "true":
            let method = dv_without(item.method, "opportunity_requirement")
            let spatial = dv_find(item.method, "opportunity_requirement", false)
            if spatial != false:
                if before.value != spatial.location and after.value == spatial.location and dvp_eligible_base(predicted_actor, item.method, prediction.world, dvp_goal_refs(predicted_actor)) and dvp_eligible_after_base(predicted_actor, method, prediction.world, dvp_goal_refs(predicted_actor)):
                    rt_push(result, {"key": item.key, "method_id": item.method.id, "weight": dv_find(item.goal, "weight", 1), "goal_basis": item.goal.basis, "prediction_basis": adoption.basis, "position_before": before, "position_after": after, "nonspatial_eligible": true, "availability_before": dv_truth(actor.mind, dv_find(item.goal, "available_when", dv_true())), "goal_available_after": "true", "access_only": true, "based_on": "subject_prediction", "method_eligible": dvp_eligible(predicted_actor, item.method, prediction.world, dvp_goal_refs(predicted_actor)), "participants_status": "not-predicted", "unresolved_spatial_requirement": spatial, "fulfillment": false})
        i = i + 1
    return result

fn dvp_initial_access(actor):
    let goals = dv_find(actor.policy, "goals", [])
    let position = dv_read(actor.mind, actor.location_ref)
    var result = []
    var i = 0
    while i < rt_count(goals):
        let goal = goals[i]
        if dv_find(goal, "kind", "") == "communicate" and dv_find(goal, "scope", "") == "personal" and dv_find(goal, "owner", "") == actor.id:
            let method = dvp_find_action(actor.actions, dv_find(goal, "method_id", ""))
            if method != false and dv_uncontested(position):
                let spatial = dv_find(method, "opportunity_requirement", false)
                if spatial != false:
                    if position.value == spatial.location:
                        rt_push(result, i)
        i = i + 1
    return result

fn dvp_state_key(mind):
    var objects = mind.objects
    var result = []
    var i = 0
    while (i < rt_count(objects)):
        var entry = objects[i]
        var object = objects[i][1]
        var facets = objects[i][1].facets
        var j = 0
        while (j < rt_count(facets)):
            var facet = facets[j]
            var fields = facets[j][1]
            var k = 0
            while (k < rt_count(fields)):
                var field = fields[k]
                rt_push(result, {"ref": dv_ref(entry[0], facet[0], field[0]), "cell": dvs_reason_value(field[1])})
                k = (k + 1)
            j = (j + 1)
        i = (i + 1)
    return rt_json_stringify(result)

fn dvp_node_key(node):
    if dv_has_key(node, "key"):
        return node.key
    else:
        return dvp_state_key(node.mind)

fn dvp_frontier_put(frontier, node):
    var key = dvp_node_key(node)
    var i = 0
    var result = []
    var dominated = false
    var node_score = node.score
    var node_elapsed = dv_find(node, "elapsed", 0)
    while (i < rt_count(frontier)):
        var existing = frontier[i]
        var ex_key = dvp_node_key(existing)
        var ex_score = existing.score
        var ex_elapsed = dv_find(existing, "elapsed", 0)
        if dv_same(key, ex_key):
            if dv_and((not (ex_score < node_score)), (not (node_elapsed < ex_elapsed))):
                dominated = true
                rt_push(result, existing)
            else:
                if dv_and((not (node_score < ex_score)), (not (ex_elapsed < node_elapsed))):
                    false
                else:
                    rt_push(result, existing)
        else:
            rt_push(result, existing)
        i = (i + 1)
    if dominated:
        false
    else:
        rt_push(result, node)
    return result

fn dvp_dependency_methods(actor):
    var actions = actor.actions
    var methods = []
    var i = 0
    while (i < rt_count(actions)):
        rt_push(methods, {"scope": dv_find(actions[i], "purpose_refs", dv_find(actions[i], "grants", [])), "premise": actions[i].precondition, "owner_refs": dvp_owner_requirement_refs(actions[i])})
        i = (i + 1)
    return methods

fn dvp_cached_dependencies(actor, seeds, budget):
    var methods = dvp_dependency_methods(actor)
    var signature = {"question": dvp_question(actor), "seeds": seeds, "adoptions": actor.mind.adoptions, "methods": methods}
    var cache = dv_find(actor, "dependency_cache", false)
    if (cache == false):
        var result = dvp_dependencies(actor.mind, seeds, budget, methods)
        var local_1 = false
        if (result.stop == "dependency-closure"):
            local_1 = {"signature": signature, "result": result}
        else:
            local_1 = false
        return dv_with_many(result, {"cache_hit": false, "cache": local_1})
    else:
        if dv_same(cache.signature, signature):
            return dv_with_many(cache.result, {"expanded": 0, "cache_hit": true, "cache": cache})
        else:
            var result = dvp_dependencies(actor.mind, seeds, budget, methods)
            var local_2 = false
            if (result.stop == "dependency-closure"):
                local_2 = {"signature": signature, "result": result}
            else:
                local_2 = false
            return dv_with_many(result, {"cache_hit": false, "cache": local_2})

fn dvp_plan(actor, bindings, costs):
    let indexed = dvp_actor_view(actor, actor.mind)
    rt_push(indexed, dv_pair("planning_choice_groups", dvp_choice_groups(actor.actions)))
    actor = indexed
    // Refresh declared evidence goals for every chapter in the read-only planning view.
    let owned_goals = dv_find(actor.policy, "goals", [])
    var refresh = false
    var goal_index = 0
    while goal_index < rt_count(owned_goals):
        if dv_find(owned_goals[goal_index], "kind", "") == "evidence" and dv_has_key(owned_goals[goal_index], "refresh_until"):
            refresh = true
        goal_index = goal_index + 1
    if refresh:
        let view = dvp_actor_view(actor, actor.mind)
        let policy = dv_with(actor.policy, "goals", dvp_refresh_current_evidence(actor, owned_goals))
        rt_replace(view, rt_record_index(view, "policy"), dv_pair("policy", policy))
        actor = view
    var budget = dv_find(actor.policy, "plan_budget", 0)
    var depth_limit = dv_find(actor.policy, "plan_depth", 2)
    var goals = dvp_goal_refs(actor)
    var probes = dvp_probe_refs(actor)
    var dependencies = dvp_cached_dependencies(actor, dvp_merge_refs(goals, probes), budget)
    var relevant = dependencies.refs
    var expanded = dependencies.expanded
    var best = false
    var best_score = -100000
    var best_path = []
    var current_action = false
    var current_score = 0
    var current_value = []
    var root_best = []
    var best_after_successor_layer = []
    let initial_achievements = dvp_satisfied_goals(actor, actor.mind, [])
    let initial_access = dvp_initial_access(actor)
    let initial_seen = dvp_state_key(actor.mind)
    var init_key = rt_json_stringify({"state": initial_seen, "achievements": initial_achievements, "opportunities": initial_access})
    var plans = []
    var frontier = dv_single({"mind": actor.mind, "path": [], "score": 0, "seen": dv_single(initial_seen), "key": init_key, "achievements": initial_achievements, "opportunities": initial_access})
    var depth = 0
    var time_blocked = 0
    var stop = "complete-depth"
    var actions = actor.actions
    var visited = []
    visited = dv_single({"key": init_key, "score": 0, "elapsed": 0})
    while dv_and((depth < depth_limit), (0 < rt_count(frontier))):
        if ((budget - expanded) < rt_count(frontier)):
            stop = "incomplete-layer-budget"
            frontier = []
        else:
            var next_frontier = []
            var n = 0
            while (n < rt_count(frontier)):
                var node = frontier[n]
                var i = 0
                var mind = frontier[n].mind
                var node_actor = dvp_actor_view(actor, mind)
                rt_push(node_actor, dv_pair("planning_achievements", node.achievements))
                rt_push(node_actor, dv_pair("planning_opportunities", node.opportunities))
                let value_context = dvp_value_context(node_actor)
                expanded = (expanded + 1)
                while (i < rt_count(actions)):
                    var action = actions[i]
                    var local_1 = false
                    if dvp_eligible(actor, action, mind, relevant):
                        if dv_has_key(actor.policy, "remaining_game_time"):
                            if (actor.policy.remaining_game_time < (dv_find(node, "elapsed", 0) + dv_get(costs, action.kind).maximum.time)):
                                time_blocked = (time_blocked + 1)
                                local_1 = false
                            else:
                                local_1 = true
                        else:
                            local_1 = true
                    else:
                        local_1 = false
                    if local_1:
                        var value = dvp_action_value_context(node_actor, action, bindings, relevant, probes, value_context)
                        let opportunities = dvp_opportunities(node_actor, action)
                        var opportunity_keys = node.opportunities
                        var opportunity_value = 0
                        var k = 0
                        while k < rt_count(opportunities):
                            opportunity_keys = dv_append(opportunity_keys, opportunities[k].key)
                            opportunity_value = opportunity_value + opportunities[k].weight
                            k = k + 1
                        value = dv_with_many(value, {"opportunity": opportunity_value, "opportunity_evidence": opportunities, "value": value.value + opportunity_value * dv_find(actor.policy, "progress_weight", 1)})
                        var cost = dv_get(costs, action.kind).actual
                        var path = dv_append(node.path, action.id)
                        var score = 0
                        score = (node.score + (value.value - (cost.time * dv_find(actor.policy, "time_cost", 0.01))))
                        if depth == 0 and action.kind != "move" and current_score < score and 0 < value.information + value.verification + value.progress + value.achievement:
                            current_action = action
                            current_score = score
                            current_value = value
                        rt_push(plans, dv_with_many({"path": path, "score": score, "value": value, "relevant_refs": relevant}, {"probe_refs": probes, "mind_revision": actor.mind.revision, "prediction_basis": dv_find(node, "prediction_basis", [])}))
                        if (best_score < score):
                            best_score = score
                            best_path = path
                            best = dvp_find_action(actions, path[0])
                        if (depth + 1 < depth_limit) and not (depth == 1 and current_action != false) and dv_and((0 < rt_count(relevant)), dv_has_key(action, "predict_law")):
                            var name = action.predict_law
                            var adoptions = mind.adoptions
                            if dv_has_key(adoptions, name):
                                var adoption = dv_get(adoptions, name)
                                if dv_and(adoption.active, (adoption.mode == "predict")):
                                    var prediction = dv_predict(dv_with(mind, "domain", "mind"), name, rt_cat("plan-", rt_show(rt_count(plans))), dv_find(mind, "time", 0), mind.revision)
                                    if (prediction.status == "applied"):
                                        var predicted = prediction.world
                                        let achieved = dvp_satisfied_goals(actor, predicted, node.achievements)
                                        let seen_key = dvp_state_key(predicted)
                                        var pred_key = rt_json_stringify({"state": seen_key, "achievements": achieved, "opportunities": opportunity_keys})
                                        if dv_has(node.seen, seen_key):
                                            false
                                        else:
                                            var candidate_node = {"mind": predicted, "path": path, "score": score - opportunity_value * dv_find(actor.policy, "progress_weight", 1), "seen": dv_append(node.seen, seen_key), "key": pred_key, "prediction_basis": adoption.basis, "elapsed": dv_find(node, "elapsed", 0) + dv_get(costs, action.kind).maximum.time, "achievements": achieved, "opportunities": opportunity_keys}
                                            if dvp_dominated(visited, candidate_node):
                                                false
                                            else:
                                                visited = dvp_frontier_put(visited, {"key": pred_key, "score": candidate_node.score, "elapsed": candidate_node.elapsed})
                                                next_frontier = dvp_frontier_put(next_frontier, candidate_node)
                    i = (i + 1)
                n = (n + 1)
            if depth == 0:
                root_best = {"path": best_path, "net_score": best_score}
                if current_action != false:
                    if depth_limit < 2:
                        stop = "current-affordance-depth-limit"
                    else:
                        if rt_count(next_frontier) == 0:
                            stop = "current-affordance-no-successor"
            if depth == 1 and current_action != false:
                best_after_successor_layer = {"path": best_path, "net_score": best_score}
                next_frontier = []
                stop = "positive-current-after-successor-layer"
            frontier = next_frontier
            depth = (depth + 1)
    var local_2 = false
    if (0 < best_score):
        local_2 = best
    else:
        local_2 = false
    var local_3 = false
    if dv_and((not (0 < best_score)), (0 < time_blocked)):
        local_3 = "duration-budget"
    else:
        local_3 = stop
    return dv_with_many(dv_with_many({"action": local_2, "score": best_score, "plan_expansions": expanded, "plans": plans}, {"selected_path": best_path, "relevant_refs": relevant, "stop": local_3, "time_blocked": time_blocked, "dependency_cache": dependencies.cache, "dependency_cache_hit": dependencies.cache_hit, "current_affordance": {"action": current_action, "net_score": current_score, "value": current_value, "authority_acceptance": "not-predicted"}}), {"completed_layers": depth, "root_best": root_best, "best_after_successor_layer": best_after_successor_layer})

fn dvp_find_action(actions, id):
    var i = 0
    var result = false
    while (i < rt_count(actions)):
        if (actions[i].id == id):
            result = actions[i]
        i = (i + 1)
    return result

fn dvp_actor_view(actor, mind):
    var result = []
    var i = 0
    while (i < rt_count(actor)):
        var entry = actor[i]
        var local_1 = false
        if (entry[0] == "mind"):
            local_1 = dv_pair("mind", mind)
        else:
            local_1 = entry
        rt_push(result, local_1)
        i = (i + 1)
    return result

fn dvp_dominated(nodes, candidate):
    var i = 0
    var found = false
    while dv_and((not found), (i < rt_count(nodes))):
        var node = nodes[i]
        if dv_and(dv_same(dvp_node_key(node), dvp_node_key(candidate)), dv_and((not (node.score < candidate.score)), (not (dv_find(candidate, "elapsed", 0) < dv_find(node, "elapsed", 0))))):
            found = true
        i = (i + 1)
    return found

fn dvp_communication_progress(actor, action):
    var goals = dv_find(actor.policy, "goals", [])
    var i = 0
    var value = false
    while (i < rt_count(goals)):
        var goal = goals[i]
        if (dv_find(goal, "kind", "") == "communicate"):
            if dv_and((dv_find(goal, "method_id", "") == action.id), dv_and((0 < rt_count(dv_find(goal, "basis", []))), (dv_truth(actor.mind, dv_find(goal, "available_when", {"op": "constant", "value": "true"})) == "true"))):
                if dv_and(dv_find(goal, "requires_argument", false), dv_find(action, "speech_from_argument", false)):
                    if dv_find(action, "argument_available", false):
                        value = true
                if not dv_find(goal, "requires_argument", false):
                    value = true
        i = (i + 1)
    return value

fn dvp_satisfied_goals(actor, mind, previous):
    var result = []
    let goals = dv_find(actor.policy, "goals", [])
    var i = 0
    while i < rt_count(goals):
        let goal = goals[i]
        if dv_find(goal, "kind", "") == "achieve":
            if (dv_truth(mind, goal.proposition) == "true" or dv_has(previous, goal.proposition)) and not dv_has(result, goal.proposition):
                result = dv_append(result, goal.proposition)
        i = i + 1
    return result

fn dvp_achievement_value(actor, action):
    let goals = dv_find(actor.policy, "goals", [])
    var pending = []
    var i = 0
    while i < rt_count(goals):
        let goal = goals[i]
        if dv_find(goal, "kind", "") == "achieve" and dvp_topic(actor, goal) and 0 < rt_count(dv_find(goal, "basis", [])):
            if not dv_has(dv_find(actor, "planning_achievements", []), goal.proposition):
                if dv_truth(actor.mind, dv_find(goal, "available_when", dv_true())) == "true" and dv_truth(actor.mind, goal.proposition) != "true":
                    rt_push(pending, goal)
        i = i + 1
    return dvp_achievement_pending(actor, action, pending)

fn dvp_achievement_pending(actor, action, pending):
    var i = 0
    if rt_count(pending) == 0:
        return 0
    let name = dv_find(action, "predict_law", "")
    let adoption = dv_find(actor.mind.adoptions, name, false)
    if adoption == false:
        return 0
    if not adoption.active or adoption.mode != "predict":
        return 0
    let prediction = dv_predict(dv_with(actor.mind, "domain", "mind"), name, "goal-forecast", dv_find(actor.mind, "time", 0), actor.mind.revision)
    if prediction.status != "applied":
        return 0
    var value = 0
    i = 0
    while i < rt_count(pending):
        if dv_truth(prediction.world, pending[i].proposition) == "true":
            value = value + dv_find(pending[i], "weight", 1)
        i = i + 1
    return value

// Only declared relevant received references can refresh an evidence requirement.
fn dvp_refresh_current_evidence(actor, goals):
    var result = []
    var i = 0
    while i < rt_count(goals):
        var goal = goals[i]
        if dv_find(goal, "kind", "") == "evidence" and dv_has_key(goal, "refresh_until"):
            if dv_truth(actor.mind, goal.refresh_until) != "true":
                if dv_has_key(goal, "refresh_refs"):
                    var relevant_time = dv_find(goal, "minimum_time", 0)
                    var r = 0
                    while r < rt_count(goal.refresh_refs):
                        let cell = dv_read(actor.mind, goal.refresh_refs[r])
                        if cell.known:
                            relevant_time = dv_max(relevant_time, dv_find(cell, "time", 0))
                        r = r + 1
                    goal = dv_with(goal, "minimum_time", relevant_time)
        rt_push(result, goal)
        i = i + 1
    return result
