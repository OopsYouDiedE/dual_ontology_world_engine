fn v_support_negative(trace, mind, actor, proposition, visiting):
    if (not (dv_truth(mind, proposition) == "false")):
        return false
    else:
        var op = proposition.op
        if (op == "constant"):
            return (proposition.value == "false")
        else:
            if (op == "not"):
                return v_support(trace, mind, actor, proposition.item, visiting)
            else:
                if (op == "all"):
                    var items = proposition.items
                    var i = 0
                    var found = false
                    while dv_and((not found), (i < rt_count(items))):
                        if v_support_negative(trace, mind, actor, items[i], visiting):
                            found = true
                        i = (i + 1)
                    return found
                else:
                    return v_support_atom(trace, mind, actor, dv_not(proposition), visiting)

fn v_support(trace, mind, actor, proposition, visiting):
    if dv_has(visiting, proposition):
        return false
    else:
        if (not (dv_truth(mind, proposition) == "true")):
            return false
        else:
            if (proposition.op == "not"):
                return v_support_negative(trace, mind, actor, proposition.item, visiting)
            else:
                return v_support_atom(trace, mind, actor, proposition, visiting)

