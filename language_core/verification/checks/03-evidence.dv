fn v_initial_normalized(configuration, mode, run):
    var trace = run.trace
    var manifest = run.manifest
    var initial = dv_find(run.trace, "initial", [])
    var target = dv_find(configuration, "target_actor", dv_find(dv_find(run.manifest, "capability", []), "actor", ""))
