            false
        else:
            status = "invalid_run"
            reason = "Actual frozen public/formal/cost configuration differs, independently of manifest labels"
        rt_push(findings, v_finding("actual_initial_isolation", status, reason, dv_pair(reports[0].source.trace, reports[i].source.trace)))
