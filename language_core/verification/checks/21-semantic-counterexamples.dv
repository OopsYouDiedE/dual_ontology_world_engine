; Semantic Property Verification Suite: Counterexample Reproductions & Regressions
; Directly verifies the 9 minimal counterexamples from the DuelView core design review (2026-10-13).

(defn test_assert (condition label)
  (if condition true (rt_fail (rt_cat "Assertion failed: " label))))

; 1. Confidence agreement: dv_infer premise min matches dv_judge_conclusion
(defn test_confidence_agreement ()
  (let (m (dv_world "mind-1" "mind" "subject-1")
        obj (dv_object "door" "door" (dv_pair
              (dv_pair "mechanical" (dv_pair
                (dv_pair "open" (dv_cell true 0.2 0 (rt_list)))
                (dv_pair "unlocked" (dv_unknown))))
              (dv_pair "identity" (rt_list))))
        rule (dv_axiom "infer-unlocked" 1
               (dv_fact (dv_ref "door" "mechanical" "open") true)
               (dv_single (dv_assign (dv_ref "door" "mechanical" "unlocked") true)))
        policy (dv_cost_policy 1 1 1 1 100 100 false 10)
        step0 (dv_proof_step "step-0" "known"
                (dv_fact (dv_ref "door" "mechanical" "open") true)
                (rt_list) "")
        step1 (dv_proof_step "step-1" "axiom"
                (dv_fact (dv_ref "door" "mechanical" "unlocked") true)
                (dv_single "step-0") "infer-unlocked")
        proof (dv_pair step0 step1))
    (do
      (set m (dv_add_object m obj))
      (set m (dv_adopt m rule "infer" 1 (dv_single "axiom-unlocked")))
      (let (infer_res (dv_infer m "infer-unlocked" "e1" 1 (dv_get m "revision"))
            m_after (dv_get infer_res "world")
            cell (dv_read m_after (dv_ref "door" "mechanical" "unlocked"))
            judge_res (dv_judge_conclusion m (dv_fact (dv_ref "door" "mechanical" "unlocked") true) proof policy))
        (do
          (test_assert (rt_eq (dv_get infer_res "status") "applied") "infer should apply")
          (test_assert (dv_same (dv_get cell "confidence") 0.2) "dv_infer confidence should be 0.2")
          (test_assert (dv_same (dv_get judge_res "confidence") 0.2) "dv_judge_conclusion confidence should be 0.2")
          (test_assert (dv_same (dv_get cell "confidence") (dv_get judge_res "confidence")) "both entries must agree on 0.2 confidence")
          "confidence-agreement-passed")))))

; 2. Preserving direct observation against weaker conflicting inference
(defn test_preserve_direct_observation ()
  (let (m (dv_world "mind-2" "mind" "subject-2")
        obs_claim (dv_observation "obs1" "subject-2" (dv_ref "door" "mechanical" "closed") false "perception" "direct" 1 1 "dep1")
        profile (dv_observation_profile (dv_m4 "perception" 1 "testimony" 1 "recall" 1 "inference" 1) 0.5)
        rule (dv_axiom "infer-closed" 1 (dv_true) (dv_single (dv_assign (dv_ref "door" "mechanical" "closed") true))))
    (do
      (set m (dv_get (dv_update_mind m (dv_single obs_claim) 0 profile) "world"))
      (let (before_cell (dv_read m (dv_ref "door" "mechanical" "closed")))
        (do
          (test_assert (dv_same (dv_get before_cell "value") false) "initial observed value should be false")
          (test_assert (dv_same (dv_get before_cell "confidence") 1) "initial observed confidence should be 1")
          (test_assert (rt_not (dv_get before_cell "conflicted")) "initial cell not conflicted")
          (set m (dv_adopt m rule "infer" 0.1 (dv_single "weak-infer-rule")))
          (let (infer_res (dv_infer m "infer-closed" "e2" 2 (dv_get m "revision"))
                m_after (dv_get infer_res "world")
                after_cell (dv_read m_after (dv_ref "door" "mechanical" "closed")))
            (do
              (test_assert (dv_get after_cell "conflicted") "after conflicting infer, cell MUST be conflicted")
              (test_assert (rt_lt 1 (rt_count (dv_get after_cell "claims"))) "claims must preserve both observation and inference")
              (test_assert (rt_lt 1 (rt_count (dv_get after_cell "alternatives"))) "alternatives must retain both branches")
              "preserve-direct-observation-passed")))))))

; 3. Commutativity of conflicting inferences: both orders produce conflict
(defn test_conflicting_inferences_order ()
  (let (rule_true (dv_axiom "infer-true" 1 (dv_true) (dv_single (dv_assign (dv_ref "door" "mechanical" "open") true)))
        rule_false (dv_axiom "infer-false" 1 (dv_true) (dv_single (dv_assign (dv_ref "door" "mechanical" "open") false)))
        mA (dv_world "mind-3A" "mind" "subject-3")
        mB (dv_world "mind-3B" "mind" "subject-3"))
    (do
      ; Order A: true then false
      (set mA (dv_add_object mA (dv_object "door" "door" (rt_list))))
      (set mA (dv_adopt mA rule_true "infer" 0.8 (dv_single "basis-true")))
      (set mA (dv_adopt mA rule_false "infer" 0.7 (dv_single "basis-false")))
      (set mA (dv_get (dv_infer mA "infer-true" "ea1" 1 (dv_get mA "revision")) "world"))
      (set mA (dv_get (dv_infer mA "infer-false" "ea2" 1 (dv_get mA "revision")) "world"))
      (let (cellA (dv_read mA (dv_ref "door" "mechanical" "open")))
        (do
          (test_assert (dv_get cellA "conflicted") "Order A: cell must be conflicted")
          (test_assert (rt_lt 1 (rt_count (dv_get cellA "alternatives"))) "Order A must retain both alternatives")))
      ; Order B: false then true
      (set mB (dv_add_object mB (dv_object "door" "door" (rt_list))))
      (set mB (dv_adopt mB rule_false "infer" 0.7 (dv_single "basis-false")))
      (set mB (dv_adopt mB rule_true "infer" 0.8 (dv_single "basis-true")))
      (set mB (dv_get (dv_infer mB "infer-false" "eb1" 1 (dv_get mB "revision")) "world"))
      (set mB (dv_get (dv_infer mB "infer-true" "eb2" 1 (dv_get mB "revision")) "world"))
      (let (cellB (dv_read mB (dv_ref "door" "mechanical" "open")))
        (do
          (test_assert (dv_get cellB "conflicted") "Order B: cell must be conflicted")
          (test_assert (rt_lt 1 (rt_count (dv_get cellB "alternatives"))) "Order B must retain both alternatives")))
      "conflicting-inferences-order-passed")))

; 4. Numerical predict on conflicted state is rejected
(defn test_conflicted_numerical_predict ()
  (let (m (dv_world "mind-4" "mind" "subject-4")
        claim1 (dv_observation "obs1" "subject-4" (dv_ref "inv" "count" "stock") 10 "testimony" "alice" 1 1 "dep1")
        claim2 (dv_observation "obs2" "subject-4" (dv_ref "inv" "count" "stock") 20 "testimony" "bob" 1 1 "dep2")
        profile (dv_observation_profile (dv_m4 "perception" 1 "testimony" 1 "recall" 1 "inference" 1) 0.5)
        dec_rule (dv_axiom "dec-stock" 1 (dv_true) (dv_single (dv_increment (dv_ref "inv" "count" "stock") -1))))
    (do
      (set m (dv_get (dv_update_mind m (dv_pair claim1 claim2) 0 profile) "world"))
      (let (stock_cell (dv_read m (dv_ref "inv" "count" "stock")))
        (do
          (test_assert (dv_get stock_cell "conflicted") "stock should be conflicted between 10 and 20")
          (set m (dv_adopt m dec_rule "predict" 1 (dv_single "basis-dec")))
          (let (pred_res (dv_predict m "dec-stock" "p1" 2 (dv_get m "revision")))
            (do
              (test_assert (rt_not (rt_eq (dv_get pred_res "status") "applied")) "predict decrement on conflicted stock must NOT be applied")
              (test_assert (rt_eq (dv_get pred_res "status") "conflicted-state") "predict decrement status should be conflicted-state")
              "conflicted-numerical-predict-passed")))))))

; 5. Low trust testimony cannot reach certainty or evaluate to true
(defn test_low_trust_testimony ()
  (let (m (dv_world "mind-5" "mind" "subject-5")
        claim (dv_observation "obs-weak" "subject-5" (dv_ref "vault" "state" "open") true "testimony" "stranger" 1 0.01 "dep-weak")
        profile (dv_observation_profile (dv_m4 "perception" 1 "testimony" 1 "recall" 1 "inference" 1) 0.9)
        prop (dv_fact (dv_ref "vault" "state" "open") true))
    (do
      (set m (dv_get (dv_update_mind m (dv_single claim) 0 profile) "world"))
      (let (cell (dv_read m (dv_ref "vault" "state" "open"))
            truth (dv_truth m prop))
        (do
          (test_assert (dv_same (dv_get cell "confidence") 0.01) "cell confidence must be bounded by trust (0.01)")
          (test_assert (rt_not (dv_get cell "known")) "cell must not be known at 0.9 threshold with 0.01 confidence")
          (test_assert (rt_eq truth "unknown") "proposition truth must be unknown, not true")
          "low-trust-testimony-passed")))))

; 6. Bounded proposal adoption does not jump to certainty (confidence cap preserved)
(defn test_proposal_cap_preserved ()
  (let (m (dv_world "mind-6" "mind" "subject-6")
        claim (dv_observation "prop1" "subject-6" (dv_ref "clue" "fact" "reliable") true "testimony" "speaker" 1 0.4 "dep-prop")
        profile (dv_observation_profile (dv_m4 "perception" 1 "testimony" 1 "recall" 1 "inference" 1) 0.3))
    (do
      (set m (dv_get (dv_update_mind m (dv_single claim) 0 profile) "world"))
      (let (cell (dv_read m (dv_ref "clue" "fact" "reliable")))
        (do
          (test_assert (dv_same (dv_get cell "confidence") 0.4) "cell confidence must preserve 0.4 cap")
          (test_assert (rt_not (dv_same (dv_get cell "confidence") 1)) "confidence must not jump to 1.0")
          "proposal-cap-preserved-passed")))))

; 7. Recursive reference projection: unmapped objective door is not leaked
(defn test_recursive_reference_projection ()
  (let (phys (dv_world "phys-7" "physical" "")
        door (dv_door "AUTHORITY_SECRET_DOOR" "roomA" "roomB" true false true false false 0)
        chan (dv_channel "chan1" "roomA" "roomB" "sound" true 1 (dv_fact (dv_ref "AUTHORITY_SECRET_DOOR" "mechanical" "closed") true))
        m (dv_world "mind-7" "mind" "subject-7")
        bindings (dv_single (dv_binding "chan1" "local-chan" "subject-7"))
        grants (dv_single (dv_ref "chan1" "link" "gate")))
    (do
      (set phys (dv_add_object (dv_add_object phys door) chan))
      (let (obs (dv_perceive phys m bindings grants "ev1" 1))
        (do
          (test_assert (rt_eq (rt_count obs) 0) "perception with unmapped secret door in gate must be rejected (not leaked)")
          (let (bindings2 (dv_pair (dv_binding "chan1" "local-chan" "subject-7")
                                   (dv_binding "AUTHORITY_SECRET_DOOR" "my-door" "subject-7"))
                obs2 (dv_perceive phys m bindings2 grants "ev2" 1))
            (do
              (test_assert (rt_eq (rt_count obs2) 1) "when door is mapped, perception succeeds")
              (let (gate_prop (dv_get (rt_at obs2 0) "value")
                    gate_ref (dv_get gate_prop "ref"))
                (do
                  (test_assert (rt_eq (dv_get gate_ref "object") "my-door") "nested ref object must be projected to local identity 'my-door'")
                  (test_assert (rt_not (rt_eq (dv_get gate_ref "object") "AUTHORITY_SECRET_DOOR")) "must not leak AUTHORITY_SECRET_DOOR")))))
          "recursive-reference-projection-passed")))))

; 8. Temporal separation: t=2 testimony does not wipe out t=1 direct observation
(defn test_temporal_separation ()
  (let (m (dv_world "mind-8" "mind" "subject-8")
        obs_t1 (dv_observation "obs_t1" "subject-8" (dv_ref "event" "past" "opener") "Alice" "perception" "direct" 1 1 "dep1")
        profile (dv_observation_profile (dv_m4 "perception" 1 "testimony" 1 "recall" 1 "inference" 1) 0.5)
        test_t2 (dv_observation "test_t2" "subject-8" (dv_ref "event" "past" "opener") "Bob" "testimony" "informant" 2 0.01 "dep2"))
    (do
      (set m (dv_get (dv_update_mind m (dv_single obs_t1) 0 profile) "world"))
      (set m (dv_get (dv_update_mind m (dv_single test_t2) (dv_get m "revision") profile) "world"))
      (let (cell (dv_read m (dv_ref "event" "past" "opener")))
        (do
          (test_assert (dv_get cell "conflicted") "cell must be conflicted between Alice and Bob")
          (test_assert (rt_lt 1 (rt_count (dv_get cell "claims"))) "claims must preserve both t=1 perception and t=2 testimony")
          "temporal-separation-passed")))))

; 9. Planning Pareto dominance: fast path is retained when slow path has higher score
(defn test_planning_pareto_dominance ()
  (let (m (dv_world "mind-9" "mind" "subject-9")
        m_obj (dv_object "dummy" "dummy" (rt_list)))
    (do
      (set m (dv_add_object m m_obj))
      (let (slow_node (dv_with (dv_with (dv_m4 "mind" m "path" (dv_single "slow") "score" -0.01 "seen" (rt_list)) "elapsed" 10) "prediction_basis" (rt_list))
            fast_node (dv_with (dv_with (dv_m4 "mind" m "path" (dv_single "fast") "score" -0.02 "seen" (rt_list)) "elapsed" 2) "prediction_basis" (rt_list))
            frontier (dv_single slow_node)
            new_frontier (dvp_frontier_put frontier fast_node))
        (do
          (test_assert (rt_eq (rt_count new_frontier) 2) "Pareto frontier must retain both slow and fast nodes")
          "planning-pareto-dominance-passed")))))

(defn main ()
  (do
    (rt_print (test_confidence_agreement))
    (rt_print (test_preserve_direct_observation))
    (rt_print (test_conflicting_inferences_order))
    (rt_print (test_conflicted_numerical_predict))
    (rt_print (test_low_trust_testimony))
    (rt_print (test_proposal_cap_preserved))
    (rt_print (test_recursive_reference_projection))
    (rt_print (test_temporal_separation))
    (rt_print (test_planning_pareto_dominance))
    (rt_print "ALL_SEMANTIC_PROPERTIES_VERIFIED_SUCCESSFULLY")
    true))
