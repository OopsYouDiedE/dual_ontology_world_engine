; Each supplementary contract retains its own purpose. Timing is descriptive, never a truth gate.
(defn v_status_join (a b)
  (if (dv_or (rt_eq a "invalid_run") (rt_eq b "invalid_run")) "invalid_run"
    (if (dv_or (rt_eq a "violated") (rt_eq b "violated")) "violated"
      (if (dv_or (rt_eq a "insufficient_evidence") (rt_eq b "insufficient_evidence")) "insufficient_evidence"
        (if (dv_or (rt_eq a "not_observed") (rt_eq b "not_observed")) "not_observed" "supported")))))
(defn v_hard_constraints (report)
  (let (items (dv_get report "findings") i 0 status "supported" refs (rt_list) observed false)
    (do (while (rt_lt i (rt_count items))
      (let (f (rt_at items i) id (dv_get (rt_at items i) "id") relevant false)
        (do
          (set relevant (dv_has (dv_list3 "run_integrity" "action_cost_settlement" "observation_provenance") id))
          (set relevant (dv_or relevant (dv_has (dv_list3 "formal_answer_validity" "speech_reception_boundary" "speaker_prediction_boundary") id)))
          (set relevant (dv_or relevant (dv_has (dv_list3 "evidence_dependency_identity" "testimony_common_origin" "listener_interpretation") id)))
          (set relevant (dv_or relevant (v_extended_provenance_id id)))
          (if (dv_and (rt_eq id "literal_truth") (rt_eq (dv_find f "phase" "") "utterance")) (set relevant true) false)
          (if relevant
            (do (set observed true) (set status (v_status_join status (dv_get f "status"))) (rt_push refs f)) false)
          (set i (rt_add i 1)))))
      (v_finding "per_event_hard_constraints" (if observed status "insufficient_evidence") "逐个真实事件核对真话门禁、合法执行、来源、实际听觉、认知更新及正式判定；错误猜测或被拒答本身不当作违反硬语义" refs))))
(defn v_boundary_findings (configuration reports)
  (let (result (rt_list) i 0 all_status "supported" observed false per_run (rt_list))
    (do
      (set all_status (v_actual_isolation_status configuration "evidence_boundary" reports))
      (while (rt_lt i (rt_count reports))
        (let (entry (rt_at reports i) report (dv_get (rt_at reports i) "report") facts (v_findings_named (dv_get (rt_at reports i) "report") "speech_reception_boundary")
              hard (v_hard_constraints (dv_get (rt_at reports i) "report")) j 0)
          (do
            (set all_status (v_status_join all_status (dv_get hard "status")))
            (if (rt_lt 0 (rt_count facts)) (set observed true) false)
            (while (rt_lt j (rt_count facts))
              (do (set all_status (v_status_join all_status (dv_get (rt_at facts j) "status"))) (set j (rt_add j 1))))
            (rt_push per_run (dv_m3 "source" (dv_get entry "source") "reception" facts "hard_constraints" hard))
            (set i (rt_add i 1)))))
      (if observed false (if (rt_eq all_status "supported") (set all_status "not_observed") false))
      (rt_push result (dv_with (v_finding "evidence_boundary_legality" all_status "边界变体须精确合法隔离，并独立重算真实交流可闻/未闻、观察到达及共同来源；主叙事未完成不抹掉已发生的边界事实" (rt_list)) "runs" per_run)) result)))
(defn v_parameter_value (configuration run)
  (let (target (dv_find configuration "target_actor" "") actors (dv_get (dv_get (dv_get run "trace") "initial") "actors") i 0 value false)
    (do (while (rt_lt i (rt_count actors))
      (do (if (rt_eq (dv_get (rt_at actors i) "id") target) (set value (dv_find (dv_get (rt_at actors i) "policy") "information_weight" false)) false) (set i (rt_add i 1)))) value)))
(defn v_parameter_findings (configuration reports)
  (let (result (rt_list) values (rt_list) required (rt_list)
        reserve (dv_find configuration "reserve_set" (rt_list)) i 0 complete "supported" hard_status "supported" causal "supported" per_run (rt_list))
    (do
      (set required (dv_find configuration "neighborhood" (rt_list)))
      (while (rt_lt i (rt_count reserve)) (do (set required (dv_append required (rt_at reserve i))) (set i (rt_add i 1))))
      (if (dv_and (rt_lt 0 (rt_count required)) (rt_lt 0 (rt_count reserve))) false (set complete "insufficient_evidence"))
      (set hard_status (v_actual_isolation_status configuration "parameter_neighborhood" reports))
      (if (rt_eq (dv_get (v_comparison_contract configuration "parameter_neighborhood") "status") "supported")
        (if (v_variants_frozen configuration "parameter_neighborhood" reports) false (set hard_status "invalid_run"))
        (set hard_status (v_status_join hard_status (dv_get (v_comparison_contract configuration "parameter_neighborhood") "status"))))
      (set i 0)
      (while (rt_lt i (rt_count reports))
        (let (entry (rt_at reports i) run (dv_get (rt_at reports i) "loaded") value (v_parameter_value configuration (dv_get (rt_at reports i) "loaded"))
              hard (v_hard_constraints (dv_get (rt_at reports i) "report")) ready (v_last_finding (dv_get (rt_at reports i) "report") "ready_deadline"))
          (do
            (if (dv_same value false) (set complete "insufficient_evidence")
              (if (dv_has values value) (set complete "invalid_run")
                (do (rt_push values value) (if (dv_has required value) false (set complete "invalid_run")))))
            (if (rt_eq (rt_count (v_first (v_events (dv_get run "trace")) "session_stopped" "")) 0) (set complete "insufficient_evidence") false)
            (set hard_status (v_status_join hard_status (dv_get hard "status")))
            (if (v_main_causal_supported (dv_get entry "report") (dv_get run "oracle")) false (set causal "insufficient_evidence"))
            (rt_push per_run (dv_m4 "source" (dv_get entry "source") "parameter" value "hard_constraints" hard "scoped_readiness" ready))
            (set i (rt_add i 1)))))
      (set i 0)
      (while (rt_lt i (rt_count required))
        (do (if (dv_has values (rt_at required i)) false (if (rt_eq complete "supported") (set complete "not_observed") false)) (set i (rt_add i 1))))
      (rt_push result (dv_with (v_finding "parameter_sample_completeness" complete "冻结邻域和独立保留集中的每个样本都须有独立完整原始会话；不挑最快样本，不丢未完成/失败样本" (rt_list)) "observed_parameters" values))
      (rt_push result (dv_with (v_finding "parameter_hard_constraints" (v_status_join complete hard_status) "逐样本逐事件保持同一真话、因果、来源、输入执行、成本与时间口径；更早ready不是微调合法性的条件" (rt_list)) "runs" per_run))
      (rt_push result (v_finding "parameter_causal_robustness" (v_status_join (v_status_join complete hard_status) causal) "所有冻结邻域及保留样本的主因果结果须有真实证据，才支持因果稳健性；各自耗时如实列出，变慢不自动违法" (rt_list))) result)))
(defn v_supplement_findings (configuration mode reports)
  (if (rt_eq mode "evidence_boundary") (v_boundary_findings configuration reports)
    (if (rt_eq mode "parameter_neighborhood") (v_parameter_findings configuration reports) (rt_list))))
(defn v_actual_isolation_status (configuration mode reports)
  (let (items (v_actual_isolation configuration mode reports) i 0 status "supported")
    (do (if (rt_eq (rt_count items) 0) (set status "not_observed") false)
      (while (rt_lt i (rt_count items))
        (do (set status (v_status_join status (dv_get (rt_at items i) "status"))) (set i (rt_add i 1)))) status)))

