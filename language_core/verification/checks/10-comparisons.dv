; Configuration comparisons require a prior approval record and invariant frozen domains.
(defn v_load_run (run)
  (let (manifest (rt_json_parse (rt_read (dv_get run "manifest"))) trace (rt_json_parse (rt_read (dv_get run "trace"))) oracle (rt_json_parse (rt_read (dv_get run "oracle"))))
    (dv_m4 "manifest" manifest "trace" trace "oracle" oracle "report" (v_judge manifest trace oracle))))
(defn v_compare (configuration mode)
  (let (runs (dv_find configuration "runs" (rt_list)) reports (rt_list) findings (rt_list) baseline (rt_list) i 0)
    (do
      (if (dv_and (dv_has_key configuration "approval_ref") (dv_has_key configuration "frozen_fields")) false
        (rt_push findings (v_finding "comparison_authorization" "insufficient_evidence" "Prior approval and frozen-field contract absent; no causal improvement claim permitted" (rt_list))))
      (while (rt_lt i (rt_count runs))
        (let (run (v_load_run (rt_at runs i)) manifest (dv_get run "manifest"))
          (do
            (if (rt_eq i 0) (set baseline manifest)
              (let (fields (dv_find configuration "frozen_fields" (rt_list)) j 0 status "supported")
                (do (while (rt_lt j (rt_count fields))
                  (let (field (rt_at fields j)) (do
                    (if (dv_and (dv_has_key baseline field) (dv_has_key manifest field))
                      (if (rt_eq field "initial") false (if (dv_same (dv_get baseline field) (dv_get manifest field)) false (set status "invalid_run")))
                      (if (rt_eq status "supported") (set status "insufficient_evidence") false)) (set j (rt_add j 1)))))
                  (rt_push findings (v_finding "configuration_isolation" status "Frozen domains compared independently of outcomes" (dv_single (dv_get (rt_at runs i) "manifest")))))))
            (rt_push reports (dv_m3 "source" (rt_at runs i) "report" (dv_get run "report") "loaded" run)) (set i (rt_add i 1)))))
      (if (rt_lt (rt_count runs) 2) (rt_push findings (v_finding "comparison_window" "not_observed" "At least two separately frozen formal sessions required" (rt_list))) false)
      (let (actual (v_actual_isolation configuration mode reports) j 0)
        (while (rt_lt j (rt_count actual)) (do (rt_push findings (rt_at actual j)) (set j (rt_add j 1)))))
      (rt_push findings (v_comparison_contract configuration mode)) (if (rt_eq mode "capability") (rt_push findings (v_compare_effect configuration mode reports (v_outcome_differences reports)))
        (let (extra (v_supplement_findings configuration mode reports) j 0)
          (while (rt_lt j (rt_count extra)) (do (rt_push findings (rt_at extra j)) (set j (rt_add j 1))))))
      (dv_m4 "mode" mode "configuration" configuration "findings" findings "runs" (v_public_reports reports)))))
(defn v_compare_main (mode)
  (do (dv_require (rt_eq (rt_arg_count) 1) "Usage: comparison-entry comparison.json")
    (rt_print (rt_json_stringify (v_compare (rt_json_parse (rt_read (rt_arg 0))) mode)))))
(defn v_comparison_contract (configuration mode)
  (let (status "supported" reason "Prior approved variant scope and required frozen domains present" required (dv_list3 "initial" "axioms" "cost_model") fields (dv_find configuration "frozen_fields" (rt_list)) i 0)
    (do
      (if (dv_and (dv_has_key configuration "approval_ref") (dv_has_key configuration "allowed_variants")) false (set status "insufficient_evidence"))
      (while (rt_lt i (rt_count required)) (do (if (dv_has fields (rt_at required i)) false (set status "insufficient_evidence")) (set i (rt_add i 1))))
      (if (rt_eq mode "capability")
        (if (dv_same (dv_find configuration "variable_fields" (rt_list)) (dv_single "capability")) false (set status "invalid_run"))
        (if (rt_eq mode "evidence_boundary")
          (if (dv_has_key configuration "legal_propagation_variants") false (set status "insufficient_evidence"))
          (if (dv_and (dv_and (dv_has_key configuration "approved_ranges") (dv_has_key configuration "neighborhood")) (dv_and (dv_has_key configuration "reserve_set") (dv_has_key configuration "random_stream_contract"))) false (set status "insufficient_evidence"))))
      (v_finding "approved_configuration_contract" status reason (dv_single (dv_find configuration "approval_ref" false))))))


(defn v_findings_named (report id)
  (let (items (dv_get report "findings") i 0 result (rt_list))
    (do (while (rt_lt i (rt_count items))
      (do (if (rt_eq (dv_get (rt_at items i) "id") id)
      (if (dv_or (rt_eq id "literal_truth") (dv_or (rt_eq id "epistemic_support") (rt_eq id "causal_completeness")))
        (if (rt_eq (dv_find (rt_at items i) "phase" "") "answer") (rt_push result (rt_at items i)) false)
        (rt_push result (rt_at items i))) false) (set i (rt_add i 1)))) result)))
(defn v_last_finding (report id)
  (let (items (v_findings_named report id)) (if (rt_eq (rt_count items) 0) (rt_list) (rt_at items (rt_sub (rt_count items) 1)))))
(defn v_outcome_differences (reports)
  (let (result (rt_list) i 1 names (dv_list3 "literal_truth" "epistemic_support" "causal_completeness"))
    (do (rt_push names "formal_answer_validity") (rt_push names "ready_deadline")
      (while (rt_lt i (rt_count reports))
        (let (j 0 left (dv_get (rt_at reports 0) "report") right (dv_get (rt_at reports i) "report"))
          (do (while (rt_lt j (rt_count names))
            (let (id (rt_at names j) a (v_last_finding left (rt_at names j)) b (v_last_finding right (rt_at names j)))
              (do (rt_push result (dv_m4 "axis" id "baseline" a "variant" b "difference_observed"
                (rt_not (dv_same (dv_find a "status" false) (dv_find b "status" false))))) (set j (rt_add j 1))))) (set i (rt_add i 1))))) result)))
(defn v_last_question_finding (report id question)
  (let (items (dv_get report "findings") i 0 found (rt_list))
    (do (while (rt_lt i (rt_count items))
      (let (item (rt_at items i))
        (do (if (dv_and (rt_eq (dv_get item "id") id) (rt_eq (dv_find item "question_id" "") question)) (set found item) false)
          (set i (rt_add i 1))))) found)))
(defn v_main_causal_supported (report oracle)
  (let (required (dv_find oracle "milestones" (rt_list)) i 0 valid (rt_lt 0 (rt_count (dv_find oracle "milestones" (rt_list)))))
    (do (while (rt_lt i (rt_count required))
      (do (set valid (dv_and valid (rt_eq (dv_find (v_last_finding report (dv_get (rt_at required i) "id")) "status" "") "supported"))) (set i (rt_add i 1))))
      (set valid (dv_and valid (rt_eq (dv_find (v_last_finding report "run_integrity") "status" "") "supported")))
      (set valid (dv_and valid (rt_eq (dv_find (v_last_question_finding report "causal_completeness" (dv_find oracle "target_question_id" "")) "status" "") "supported")))
      (set valid (dv_and valid (rt_eq (dv_find (v_last_question_finding report "formal_answer_validity" (dv_find oracle "target_question_id" "")) "status" "") "supported")))
      (let (items (dv_get report "findings") j 0)
        (while (rt_lt j (rt_count items))
          (let (f (rt_at items j))
            (do (if (dv_or (dv_has (dv_list3 "action_cost_settlement" "observation_provenance" "formal_answer_validity") (dv_get f "id")) (v_extended_provenance_id (dv_get f "id")))
              (set valid (dv_and valid (rt_eq (dv_get f "status") "supported"))) false) (set j (rt_add j 1)))))) valid)))
(defn v_compare_effect (configuration mode reports differences)
  (let (status "not_observed" reason "No final compared axis difference observed" i 0 changed false)
    (do
      (while (rt_lt i (rt_count differences))
        (do (if (dv_get (rt_at differences i) "difference_observed") (set changed true) false) (set i (rt_add i 1))))
      (if changed (do (set status "insufficient_evidence") (set reason "Actual axis differences recorded, but causal result or legal isolation lacks evidence")) false)
      (if (dv_and (dv_and (v_actual_isolation_valid configuration mode reports) (v_variants_frozen configuration mode reports)) (dv_and (rt_eq (dv_get (v_comparison_contract configuration mode) "status") "supported") (rt_lt 1 (rt_count reports))))
        (let (left (dv_get (rt_at reports 0) "report") right (dv_get (rt_at reports 1) "report")
              base_run (dv_get (rt_at reports 0) "loaded") next_run (dv_get (rt_at reports 1) "loaded"))
          (do
            (if (rt_eq mode "capability")
              (if (dv_and (dv_and (rt_eq (dv_find (v_last_finding left "run_integrity") "status" "") "supported")
                (rt_eq (dv_find (v_last_finding left "epistemic_support") "status" "") "supported"))
                (dv_and (rt_eq (dv_find (v_last_finding left "literal_truth") "status" "") "supported")
                  (dv_and (rt_eq (dv_find (v_last_finding left "causal_completeness") "status" "") "violated") (v_main_causal_supported right (dv_get next_run "oracle")))))
                (do (set status "supported") (set reason "Approved isolated capability variant supplies the independently checked causal result missing from literal-correct baseline")) false)
              (if (dv_and (v_main_causal_supported left (dv_get base_run "oracle")) (v_main_causal_supported right (dv_get next_run "oracle")))
                (let (a (v_last_finding left "ready_deadline") b (v_last_finding right "ready_deadline"))
                  (if (dv_and (rt_eq (dv_find a "status" "") "supported") (rt_eq (dv_find b "status" "") "supported"))
                    (let (ta (rt_sub (dv_get a "ready_game_time") (dv_get a "first_acceptance_game_time")) tb (rt_sub (dv_get b "ready_game_time") (dv_get b "first_acceptance_game_time")))
                      (do (set status (if (rt_lt tb ta) "supported" "not_observed"))
                        (set reason (if (rt_lt tb ta) "Main causal contracts supported under approved isolated variant, with earlier exact scoped readiness" "Main causal contracts supported, but no earlier scoped readiness observed")))) false)) false)))) false)
      (dv_with (v_finding "causal_improvement" status reason (rt_list)) "outcome_differences" differences))))
(defn v_variants_frozen (configuration mode reports)
  (let (i 0 valid true baseline (rt_list) fields (dv_find configuration "frozen_fields" (rt_list)))
    (do (while (rt_lt i (rt_count reports))
      (let (run (dv_get (rt_at reports i) "loaded") manifest (dv_get run "manifest") j 0)
        (do
          (if (rt_eq i 0) (set baseline manifest)
            (while (rt_lt j (rt_count fields))
              (let (key (rt_at fields j))
                (do
                  (if (rt_eq key "initial") false
                    (do
                      (set valid (dv_and valid (dv_and (dv_has_key baseline key) (dv_has_key manifest key))))
                      (if (dv_and (dv_has_key baseline key) (dv_has_key manifest key))
                        (set valid (dv_and valid (dv_same (dv_get baseline key) (dv_get manifest key)))) false)))
                  (set j (rt_add j 1))))))
          (if (rt_eq mode "parameter_neighborhood")
            (let (target (dv_find configuration "target_actor" (dv_find (dv_find manifest "capability" (rt_list)) "actor" ""))
                  actors (dv_get (dv_get (dv_get run "trace") "initial") "actors") k 0 value false range (dv_find (dv_find configuration "approved_ranges" (rt_list)) "information_weight" (rt_list)))
              (do
                (while (rt_lt k (rt_count actors))
                  (do (if (rt_eq (dv_get (rt_at actors k) "id") target) (set value (dv_find (dv_get (rt_at actors k) "policy") "information_weight" false)) false) (set k (rt_add k 1))))
                (if (dv_or (dv_same value false) (rt_eq (rt_count range) 0)) (set valid false)
                  (let (minimum (if (dv_record_like range) (dv_get range "minimum") (rt_at range 0)) maximum (if (dv_record_like range) (dv_get range "maximum") (rt_at range 1)))
                    (do
                      (set valid (dv_and valid (dv_and (rt_not (rt_lt value minimum)) (rt_not (rt_lt maximum value)))))
                      (set valid (dv_and valid (dv_or (dv_has (dv_find configuration "neighborhood" (rt_list)) value) (dv_has (dv_find configuration "reserve_set" (rt_list)) value))))))))) false)
          (set i (rt_add i 1))))) valid)))

(defn v_public_reports (reports)
  (let (public (rt_list) i 0)
    (do (while (rt_lt i (rt_count reports))
      (do (rt_push public (dv_m2 "source" (dv_get (rt_at reports i) "source") "report" (dv_get (rt_at reports i) "report"))) (set i (rt_add i 1)))) public)))

