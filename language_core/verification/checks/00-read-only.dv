// Read-only findings. No invocation of session advancement or mind update functions.
// Full read-only causal closure for repeated membership queries on one child.

fn v_finding(id, status, reason, refs):
    return {"id": id, "status": status, "reason": reason, "evidence_refs": refs}

fn v_events(trace):
    return dv_find(trace, "events", [])

fn v_event(events, id):
    var i = rt_count(events)
    var found = []
    var matched = false
    while dv_and((not matched), (0 < i)):
        i = (i - 1)
        if dv_same(dv_find(events[i], "id", false), id):
            found = events[i]
            matched = true
    return found

fn v_first(events, type, actor):
    var i = 0
    var found = []
    while dv_and((rt_count(found) == 0), (i < rt_count(events))):
        var e = events[i]
        if dv_and((rt_count(found) == 0), dv_and((dv_find(e, "type", "") == type), dv_or((actor == ""), (dv_find(e, "actor", "") == actor)))):
            found = e
        i = (i + 1)
    return found

fn v_ancestor(events, child, ancestor):
    var queue = dv_single(child)
    var visited = []
    var cursor = 0
    var found = false
    while dv_and((not found), (cursor < rt_count(queue))):
        var id = queue[cursor]
        if dv_has(visited, id):
            false
        else:
            var e = v_event(events, id)
            var j = 0
            rt_push(visited, id)
            if dv_same(id, ancestor):
                found = true
            var parents = dv_find(e, "parents", [])
            while (j < rt_count(parents)):
                rt_push(queue, parents[j])
                j = (j + 1)
        cursor = (cursor + 1)
    return found

fn v_ancestors(events, child):
    var queue = dv_single(child)
    var visited = []
    var cursor = 0
    while (cursor < rt_count(queue)):
        var id = queue[cursor]
        if dv_has(visited, id):
            false
        else:
            var e = v_event(events, id)
            var j = 0
            rt_push(visited, id)
            var parents = dv_find(e, "parents", [])
            while (j < rt_count(parents)):
                rt_push(queue, parents[j])
                j = (j + 1)
        cursor = (cursor + 1)
    return visited

fn v_integrity(manifest, trace):
    var events = v_events(trace)
    var ids = []
    var status = "supported"
    var reason = "Unique events and explicit earlier causal parents"
    var i = 0
    if (rt_count(events) == 0):
        status = "insufficient_evidence"
        reason = "No sealed event records"
    while (i < rt_count(events)):
        var e = events[i]
        var id = dv_find(events[i], "id", false)
        var parents = dv_find(events[i], "parents", [])
        var j = 0
        if dv_and(dv_has_key(e, "type"), dv_and(dv_has_key(e, "actor"), dv_and(dv_has_key(e, "time"), dv_has_key(e, "data")))):
            false
        else:
            if (status == "supported"):
                status = "insufficient_evidence"
                reason = "事件缺少类型、本人、时刻或完整记录，不能进入重演"
        if dv_or(dv_same(id, false), dv_has(ids, id)):
            status = "invalid_run"
            reason = "Missing or duplicate immutable event identity"
        while (j < rt_count(parents)):
            if (not dv_has(ids, parents[j])):
                status = "invalid_run"
                reason = "Causal parent absent or forward reference"
            else:
                if (dv_find(e, "time", -1) < dv_find(v_event(events, parents[j]), "time", -1)):
                    status = "invalid_run"
                    reason = "Child precedes causal parent"
            j = (j + 1)
        rt_push(ids, id)
        i = (i + 1)
    if dv_has_key(manifest, "integrity"):
        if (manifest.integrity == "verified"):
            false
        else:
            status = "invalid_run"
            reason = "Source or runtime seal did not verify"
    else:
        if (status == "supported"):
            status = "insufficient_evidence"
            reason = "Protection baseline and final seal verification missing"
    return v_finding("run_integrity", status, reason, ids)

fn v_truth_status(truth):
    if (truth == "true"):
        return "supported"
    else:
        if (truth == "false"):
            return "violated"
        else:
            return "insufficient_evidence"

fn v_milestones(manifest, trace, oracle):
    var events = v_events(trace)
    var specs = dv_find(oracle, "milestones", [])
    var chosen = []
    var prior_statuses = []
    var result = []
    var i = 0
    if (rt_count(specs) == 0):
        rt_push(result, v_finding("milestone_contract", "insufficient_evidence", "Story oracle milestone binding absent", []))
    while (i < rt_count(specs)):
        var spec = specs[i]
        var id = specs[i].id
        var e = v_select_milestone(manifest, trace, oracle, specs[i], chosen)
        var status = "supported"
        var reason = "Observed with causal predecessors"
        var refs = []
        var j = 0
        if (rt_count(e) == 0):
            status = "not_observed"
            reason = "Required event did not occur in recorded window"
        else:
            rt_push(refs, e.id)
            var after = dv_find(spec, "after", [])
            while (j < rt_count(after)):
                var prior = dv_find(chosen, after[j], [])
                if (rt_count(prior) == 0):
                    status = "insufficient_evidence"
                    reason = "Required predecessor not recorded"
                else:
                    if (not v_event_precedes(events, prior, e)):
                        status = "violated"
                        reason = "必需偏序前驱未在该事件之前实际发生"
                    else:
                        if (not (dv_find(prior_statuses, after[j], "insufficient_evidence") == "supported")):
                            status = "insufficient_evidence"
                            reason = "前驱自身尚未由真实语义证据建立，下游不能宣称成立"
                j = (j + 1)
        if dv_and((0 < rt_count(e)), (status == "supported")):
            var semantic = v_milestone_semantics(manifest, trace, oracle, spec, e)
            status = semantic.status
            reason = semantic.reason
        chosen = dv_with(chosen, id, e)
        prior_statuses = dv_with(prior_statuses, id, status)
        rt_push(result, dv_with(v_finding(id, status, reason, refs), "first_game_time", dv_find(e, "time", false)))
        i = (i + 1)
    return result

fn v_judge_full(manifest, raw_trace, oracle):
    var trace = v_prepare_evidence_cache(manifest, raw_trace)
    var events = v_events(trace)
    var result = dv_single(v_integrity(manifest, trace))
    var i = 0
    var extra = v_milestones(manifest, trace, oracle)
    var j = 0
    while (j < rt_count(extra)):
        rt_push(result, extra[j])
        j = (j + 1)
    var extra = v_observations(trace)
    var j = 0
    while (j < rt_count(extra)):
        rt_push(result, extra[j])
        j = (j + 1)
    while (i < rt_count(events)):
        var e = events[i]
        if dv_or((e.type == "answer_submitted"), (e.type == "speech_literal")):
            var axes = v_axis_bundle(manifest, trace, v_context_event(events, e), oracle)
            var j = 0
            while (j < rt_count(axes)):
                rt_push(result, axes[j])
                j = (j + 1)
        if dv_or((e.type == "answer_accepted"), (e.type == "answer_rejected")):
            rt_push(result, v_finding("answer_event_observed", "supported", e.type, dv_single(e.id)))
        i = (i + 1)
    rt_push(result, v_game_budget_check(trace, oracle))
    var extra = v_retraction_checks(trace)
    var j = 0
    while (j < rt_count(extra)):
        rt_push(result, extra[j])
        j = (j + 1)
    var extra = v_cost_check(manifest, trace, oracle)
    var j = 0
    while (j < rt_count(extra)):
        rt_push(result, extra[j])
        j = (j + 1)
    var extra = v_social_check(trace)
    var j = 0
    while (j < rt_count(extra)):
        rt_push(result, extra[j])
        j = (j + 1)
    var j = 0
    while (j < rt_count(events)):
        var e = events[j]
        if dv_or((e.type == "answer_accepted"), (e.type == "answer_rejected")):
            rt_push(result, v_answer_validation(manifest, trace, e))
        j = (j + 1)
    var model_findings = v_model_checks(manifest, trace)
    var model_index = 0
    while (model_index < rt_count(model_findings)):
        rt_push(result, model_findings[model_index])
        model_index = (model_index + 1)
    var argument_findings = v_argument_checks(manifest, trace)
    var argument_index = 0
    while (argument_index < rt_count(argument_findings)):
        rt_push(result, argument_findings[argument_index])
        argument_index = (argument_index + 1)
    var stage_times = v_run_stage_times(manifest, trace, oracle)
    var stage_index = 0
    while (stage_index < rt_count(stage_times)):
        rt_push(result, stage_times[stage_index])
        stage_index = (stage_index + 1)
    rt_push(result, v_ready_deadline(manifest, trace, oracle))
    return {"mode": "read_only", "findings": result, "limitations": "No gameplay, aesthetic, or statistical conclusion is inferred from engineering output"}

fn v_judge(manifest, raw_trace, oracle):
    if dv_record_like(raw_trace):
        var initial = dv_find(raw_trace, "initial", [])
        var integrity = v_integrity(manifest, raw_trace)
        if (not (integrity.status == "supported")):
            return {"mode": "read_only", "findings": dv_single(integrity), "limitations": "损坏的来源或事件基线不进入领域重演"}
        else:
            var local_1 = false
            if dv_record_like(initial):
                local_1 = dv_and(dv_has_key(initial, "physical"), dv_has_key(initial, "actors"))
            else:
                local_1 = false
            if local_1:
                return v_judge_full(manifest, raw_trace, oracle)
            else:
                return {"mode": "read_only", "findings": dv_single(v_finding("run_intake", "insufficient_evidence", "缺少完整冻结初始物理与人物快照，不能重演来源或给出全局成立结论", [])), "limitations": "未进入领域重演"}
    else:
        return {"mode": "read_only", "findings": dv_single(v_finding("run_intake", "invalid_run", "轨迹交换数据不是合法只读记录", [])), "limitations": "未进入领域重演"}

fn v_main():
    dv_require((rt_arg_count() == 3), "Usage: main-causal manifest.json trace.json oracle.json")
    return rt_print(rt_json_stringify(v_judge(rt_json_parse(rt_read(rt_arg(0))), rt_json_parse(rt_read(rt_arg(1))), rt_json_parse(rt_read(rt_arg(2))))))

fn v_event_precedes(events, prior, current):
    var i = 0
    var seen = false
    var precedes = false
    while (i < rt_count(events)):
        if (events[i].id == current.id):
            precedes = seen
        if (events[i].id == prior.id):
            seen = true
        i = (i + 1)
    return dv_and(precedes, (not (current.time < prior.time)))

fn v_spec_scope(events, spec, event):
    var local_1 = false
    if dv_has(dv_pair("answer_accepted", "answer_rejected"), event.type):
        local_1 = v_parent_submission(events, event)
    else:
        local_1 = event
    var subject = local_1
    var valid = true
    if dv_has_key(spec, "question_id"):
        valid = dv_and(valid, (spec.question_id == v_question(subject)))
    if dv_has_key(spec, "answer_id"):
        valid = dv_and(valid, (spec.answer_id == dv_find(v_submission_action(subject), "answer_id", "")))
    return valid

fn v_first_after(events, spec, chosen):
    var i = 0
    var found = []
    var fallback = []
    var after = dv_find(spec, "after", [])
    while dv_and((rt_count(found) == 0), (i < rt_count(events))):
        var event = events[i]
        var j = 0
        var eligible = true
        eligible = dv_and((event.type == spec.type), dv_or((dv_find(spec, "actor", "") == ""), (event.actor == spec.actor)))
        if eligible:
            eligible = v_spec_scope(events, spec, event)
        if dv_and(eligible, (rt_count(fallback) == 0)):
            fallback = event
        while dv_and(eligible, (j < rt_count(after))):
            var prior = dv_find(chosen, after[j], [])
            if (rt_count(prior) == 0):
                eligible = false
            else:
                eligible = v_event_precedes(events, prior, event)
            j = (j + 1)
        if eligible:
            found = event
        i = (i + 1)
    if (rt_count(found) == 0):
        return fallback
    else:
        return found

fn v_origin_execution(events, e):
    var i = rt_count(events)
    var found = []
    var speech = dv_find(dv_find(e, "data", []), "speech", [])
    var ancestors = v_ancestors(events, e.id)
    while dv_and((0 < i), (rt_count(found) == 0)):
        i = (i - 1)
        var candidate = events[i]
        var data = dv_find(events[i], "data", [])
        if dv_and((candidate.type == "action_execution"), dv_and((candidate.actor == e.actor), dv_has(ancestors, candidate.id))):
            var local_1 = false
            if (0 < rt_count(speech)):
                local_1 = dv_same(speech, dv_find(dv_find(data, "action", []), "speech", false))
            else:
                local_1 = true
            if local_1:
                found = candidate
    return found

fn v_context_event(events, e):
    var data = dv_find(e, "data", [])
    var origin = v_origin_execution(events, e)
    if (0 < rt_count(origin)):
        var pd = origin.data
        var keys = dv_list3("physical_before", "mind_before", "physical_after")
        var j = 0
        while (j < rt_count(keys)):
            var key = keys[j]
            if dv_and((not dv_has_key(data, key)), dv_has_key(pd, key)):
                data = dv_with(data, key, dv_get(pd, key))
            j = (j + 1)
    return dv_with(e, "data", data)
