// Milestone occurrence, ordering and semantic evidence are separate checks.

fn v_milestone_semantics(manifest, trace, oracle, spec, event):
    var kind = dv_find(spec, "semantic_kind", "")
    var data = event.data
    var status = "insufficient_evidence"
    var reason = "节点只有事件类型记录；尚缺其真实语义验收绑定"
    var refs = dv_single(event.id)
    var events = v_events(trace)
    if (kind == ""):
        if (event.type == "speech_literal"):
            kind = "legal_opening"
        else:
            if (event.type == "observation"):
                kind = "new_observation"
            else:
                if (event.type == "answer_ready"):
                    kind = "ready_argument"
    if (kind == "formal_answer"):
        if (event.type == "answer_submitted"):
            var axes = v_axis_bundle(manifest, trace, event, oracle)
            var local_1 = false
            if dv_and(v_axis_supported(axes, "literal_truth"), dv_and(v_axis_supported(axes, "epistemic_support"), v_axis_supported(axes, "causal_completeness"))):
                local_1 = "supported"
            else:
                local_1 = "insufficient_evidence"
            status = local_1
            reason = "精确答案提交已发生；独立核该问题字面、本人来源及完整因果，不能以其他题目或子题替代"
        else:
            var validation = v_answer_validation(manifest, trace, event)
            status = validation.status
            reason = validation.reason
    if (kind == "genuine_rejection"):
        var validation = v_answer_validation(manifest, trace, event)
        var submit = v_parent_submission(events, event)
        if (0 < rt_count(submit)):
            var axes = dv_find(validation, "axes", [])
            var action = v_submission_action(submit)
            if dv_and((validation.status == "supported"), dv_and((dv_find(axes, "literal_truth", "unknown") == "true"), (dv_find(axes, "question_match", "unknown") == "true"))):
                if dv_or((dv_find(axes, "answer_complete", "unknown") == "false"), (not (dv_find(axes, "epistemic_support", "unknown") == "true"))):
                    status = "supported"
        reason = "真缺口驳回须是当前题目相关的真实字面命题，正式拒绝其未完成论证或缺本人来源；错题真陈述不替代此节点"
    if (kind == "legal_opening"):
        var context = v_context_event(events, event)
        var misunderstood = false
        var differentiated = false
        var i = 0
        var statuses = []
        while (i < rt_count(events)):
            var candidate = events[i]
            var cd = events[i].data
            if dv_and((candidate.type == "implicature"), (dv_find(cd, "source_event", "") == event.id)):
                if (v_interpretation_check(trace, candidate).status == "supported"):
                    if dv_and((dv_find(cd, "status", "") == "accepted"), dv_find(dv_find(cd, "scope_check", []), "gap", false)):
                        misunderstood = true
                    if dv_has(statuses, dv_find(cd, "status", "")):
                        false
                    else:
                        if (0 < rt_count(statuses)):
                            differentiated = true
                        rt_push(statuses, dv_find(cd, "status", ""))
            i = (i + 1)
        if dv_and(v_source_delivery(trace, event), dv_and(misunderstood, differentiated)):
            var axes = v_axis_bundle(manifest, trace, context, oracle)
            if dv_and(v_axis_supported(axes, "literal_truth"), v_axis_supported(axes, "epistemic_support")):
                status = "supported"
        reason = "合法开场需真实真话及说话者来源，还须实际听者采纳了缺桥接暗示，且不同本人出现经重算验证的理解或采纳差异"
    if (kind == "new_observation"):
        if dv_has_key(spec, "requirement"):
            var requirement = spec.requirement
            if dv_and(v_observation_verified(trace, event.id), dv_and((not (dv_truth(data.mind_before, requirement) == "true")), dv_and((dv_truth(data.mind_after, requirement) == "true"), v_support(trace, data.mind_after, event.actor, requirement, [])))):
                status = "supported"
                reason = "真实新观察把所需认知从未建立变为本人有来源的支持；重复看已有事实不替代新证据"
        else:
            reason = "观察投映可以独立核验，但oracle尚未绑定需要新增的证据命题，不能把任意观察称为修正节点"
    if (kind == "serious_wrong_model_use"):
        if dv_and((event.type == "mind_simulation"), dv_and(v_model_verified(manifest, trace, event.id), dv_and(v_wrong_model_used(trace, event), v_wrong_new_refutation(manifest, trace, event)))):
            status = "supported"
        reason = "真实选中假说推动付费方法与验证选择；本次完整执行产生确定预测，后续独立新观察重核其矛盾；先验标签、枚举、未知或计算截断不计为一次错误"
    if (kind == "serious_wrong_hypothesis"):
        var current = dv_find(data, "current", [])
        var serious = false
        var refuted = false
        var i = 0
        if rt_is_list(current):
            if (0 < rt_count(current)):
                while (i < rt_count(events)):
                    var candidate = events[i]
                    var cd = events[i].data
                    if (candidate.actor == event.actor):
                        if (candidate.type == "mind_simulation"):
                            if (dv_find(dv_find(cd, "hypothesis", []), "id", "") == current.id):
                                if dv_and(v_model_verified(manifest, trace, candidate.id), v_ancestor(events, candidate.id, event.id)):
                                    serious = true
                        else:
                            if (candidate.type == "model_recheck"):
                                var old = dv_find(cd, "model_before", [])
                                var actual = v_model_result(candidate)
                                if dv_and(v_model_verified(manifest, trace, candidate.id), (dv_find(actual, "status", "unknown") == "inconsistent")):
                                    var original = v_event(events, dv_find(old, "paid_model_event", dv_find(old, "event", "")))
                                    if (dv_find(dv_find(dv_find(original, "data", []), "hypothesis", []), "id", "") == current.id):
                                        refuted = true
                    i = (i + 1)
        if dv_and(serious, refuted):
            status = "supported"
        reason = "认真错误假说需要本人真实选择后付费重演同一假说，并被后续真实观测重核为不一致；偏好标签或错误答案本身不作证"
    if (kind == "ready_argument"):
        status = v_ready_deadline(manifest, trace, oracle).status
        reason = "目标就绪必须有实际付费完整模型、本人来源及全题论证，另核运行起点总预算"
    if (kind == "sharing_withdrawal"):
        var origin = v_origin_execution(events, event)
        var targets = []
        var i = 0
        var valid = true
        var adopted = false
        if (0 < rt_count(origin)):
            targets = dv_find(origin.data.action, "listeners", [])
        else:
            valid = false
        if (rt_count(targets) == 0):
            valid = false
        while (i < rt_count(targets)):
            var actor = targets[i]
            var j = 0
            var prior_accepted = false
            var withdrawn = false
            while (j < rt_count(events)):
                var candidate = events[j]
                var cd = events[j].data
                if (candidate.actor == actor):
                    if (candidate.type == "implicature"):
                        if dv_and(dv_and((dv_find(cd, "status", "") == "accepted"), dv_find(dv_find(cd, "scope_check", []), "gap", false)), dv_and(v_event_precedes(events, candidate, event), (v_interpretation_check(trace, candidate).status == "supported"))):
                            prior_accepted = true
                    else:
                        if (candidate.type == "implicature_withdrawn"):
                            if (0 < rt_count(origin)):
                                var local_2 = false
                                if dv_has_key(cd, "proposal"):
                                    local_2 = v_proposal_withdrawn_gap(candidate)
                                else:
                                    local_2 = dv_find(dv_find(dv_find(dv_find(cd, "interpretations_before", []), dv_find(cd, "id", ""), []), "scope_check", []), "gap", false)
                                if dv_and(dv_and(v_ancestor(events, candidate.id, origin.id), (v_interpretation_check(trace, candidate).status == "supported")), local_2):
                                    withdrawn = true
                j = (j + 1)
            if prior_accepted:
                adopted = true
                valid = dv_and(valid, withdrawn)
            i = (i + 1)
        if dv_and(v_source_delivery(trace, event), dv_and(adopted, valid)):
            status = "supported"
        reason = "对真实分享听者逐人追溯其先前实际采纳，已采纳者须因该真实分享执行的新证据撤销；撤销P不写入not P"
    var required = dv_find(spec, "causal_after", [])
    var i = 0
    while (i < rt_count(required)):
        if v_ancestor(events, event.id, required[i]):
            false
        else:
            status = "insufficient_evidence"
            reason = "该语义绑定需要的真实来源前驱未记录，不能以全局顺序替代因果来源"
        i = (i + 1)
    return dv_with(dv_with(v_finding("milestone_semantics", status, reason, refs), "actor", event.actor), "action", kind)

fn v_select_milestone(manifest, trace, oracle, spec, chosen):
    var events = v_events(trace)
    var found = []
    var i = 0
    var after = dv_find(spec, "after", [])
    while dv_and((rt_count(found) == 0), (i < rt_count(events))):
        var event = events[i]
        var eligible = true
        var j = 0
        eligible = dv_and((event.type == spec.type), dv_or((dv_find(spec, "actor", "") == ""), (event.actor == spec.actor)))
        if eligible:
            eligible = v_spec_scope(events, spec, event)
        while dv_and(eligible, (j < rt_count(after))):
            var prior = dv_find(chosen, after[j], [])
            if (rt_count(prior) == 0):
                eligible = false
            else:
                eligible = v_event_precedes(events, prior, event)
            j = (j + 1)
        if eligible:
            if (v_milestone_semantics(manifest, trace, oracle, spec, event).status == "supported"):
                found = event
        i = (i + 1)
    if (0 < rt_count(found)):
        return found
    else:
        return v_first_after(events, spec, chosen)

fn v_wrong_probe_refs(hypothesis):
    var features = dv_find(hypothesis, "features", [])
    var refs = []
    var i = 0
    while (i < rt_count(features)):
        var feature = features[i]
        var local_1 = false
        if dv_has_key(feature, "proposition"):
            local_1 = feature.proposition
        else:
            local_1 = feature
        refs = dv_explanation_merge(refs, v_model_sim_refs(dv_find(feature, "observation", local_1)))
        i = (i + 1)
    return refs

fn v_wrong_model_used(trace, event):
    var events = v_events(trace)
    var origin = v_origin_execution(v_events(trace), event)
    var hypothesis = dv_find(event.data, "hypothesis", [])
    var selected = []
    var choice = []
    var adopted = false
    var verified_choice = false
    var i = 0
    var result = v_model_result(event)
    if (0 < rt_count(origin)):
        var ancestors = v_ancestors(events, origin.id)
        while (i < rt_count(events)):
            var candidate = events[i]
            var data = events[i].data
            if dv_and((candidate.actor == event.actor), dv_has(ancestors, candidate.id)):
                if dv_has(dv_pair("hypothesis_adopted", "hypothesis_revised"), candidate.type):
                    if dv_same(v_record_without(dv_find(data, "current", []), dv_single("simulation")), hypothesis):
                        adopted = true
                if (candidate.type == "action_selected"):
                    if dv_same(data.action, origin.data.action):
                        selected = candidate
                if (candidate.type == "planning_choice"):
                    if dv_same(dv_find(data, "action", false), origin.data.action):
                        choice = candidate
            i = (i + 1)
        if dv_and((0 < rt_count(selected)), (0 < rt_count(choice))):
            var data = choice.data
            var path = dv_find(choice.data, "selected_path", [])
            var plans = dv_find(choice.data, "plans", [])
            var j = 0
            while (j < rt_count(plans)):
                var plan = plans[j]
                if dv_and(dv_same(plan.path, path), dv_and((0 < rt_count(path)), (path[0] == origin.data.action.id))):
                    if dv_and(dv_same(plan.probe_refs, v_wrong_probe_refs(hypothesis)), dv_and((0 < dv_find(plan.value, "verification", 0)), (dv_find(dv_find(dv_find(selected.data, "hypothesis", []), "simulation", []), "status", "") == "stale-or-unavailable"))):
                        verified_choice = true
                j = (j + 1)
            verified_choice = dv_and(verified_choice, dv_same(v_record_without(dv_find(selected.data, "hypothesis", []), dv_single("simulation")), hypothesis))
    return dv_and(adopted, dv_and(verified_choice, dv_and((dv_find(dv_find(dv_find(origin, "data", []), "action", []), "kind", "") == "replay"), dv_and((dv_find(dv_find(dv_find(dv_find(origin, "data", []), "receipt", []), "execution", []), "status", "") == "applied"), dv_and(dv_find(result, "plan_complete", false), dv_and((rt_count(dv_find(result, "failures", [])) == 0), dv_and((0 < dv_find(result, "expanded", 0)), dv_and((not (dv_find(result, "remaining", -1) < 0)), dv_and((rt_count(dv_find(result, "predictions", [])) == rt_count(dv_find(result, "comparisons", []))), (rt_count(dv_find(result, "contradictions", [])) == 0))))))))))

fn v_wrong_new_refutation(manifest, trace, event):
    var events = v_events(trace)
    var old = v_model_result(event)
    var predictions = dv_find(v_model_result(event), "predictions", [])
    var i = 0
    var found = false
    while (i < rt_count(events)):
        var candidate = events[i]
        var data = events[i].data
        if dv_and((candidate.actor == event.actor), (candidate.type == "model_recheck")):
            if dv_and(v_model_verified(manifest, trace, candidate.id), dv_and(v_ancestor(events, candidate.id, event.id), (dv_find(dv_find(data, "model_before", []), "paid_model_event", dv_find(dv_find(data, "model_before", []), "event", "")) == event.id))):
                var comparisons = dv_find(v_model_result(candidate), "comparisons", [])
                var j = 0
                while (j < rt_count(comparisons)):
                    var comparison = comparisons[j]
                    var k = 0
                    if (dv_find(comparison, "result", "") == "contradiction"):
                        while (k < rt_count(predictions)):
                            var prediction = predictions[k]
                            if dv_and(dv_same(prediction.feature, comparison.feature), dv_and(prediction.covered, dv_and(dv_has(dv_pair("true", "false"), prediction.prediction), (prediction.prediction == comparison.prediction)))):
                                var n = 0
                                while (n < rt_count(events)):
                                    var observation = events[n]
                                    var od = events[n].data
                                    if dv_and((observation.actor == event.actor), dv_and(dv_has(dv_pair("observation", "listener_parse"), observation.type), dv_and(v_event_precedes(events, event, observation), v_ancestor(events, candidate.id, observation.id)))):
                                        var local_1 = false
                                        if (observation.type == "observation"):
                                            local_1 = v_observation_verified(trace, observation.id)
                                        else:
                                            local_1 = v_reception_verified(trace, observation.id)
                                        if local_1:
                                            var p = dv_find(prediction.feature, "observation", prediction.proposition)
                                            var physical = v_authority_before(trace, event)
                                            var local_2 = false
                                            if (0 < rt_count(physical)):
                                                local_2 = (dv_truth(physical, v_physical_proposition(p, dv_find(dv_find(trace, "configuration", []), "bindings", []), od.mind_after.subject)) == comparison.observation)
                                            else:
                                                local_2 = false
                                            var local_3 = false
                                            if (comparison.observation == "true"):
                                                local_3 = p
                                            else:
                                                local_3 = dv_not(p)
                                            if dv_and(local_2, dv_and((dv_truth(od.mind_after, p) == comparison.observation), dv_and((not (dv_truth(od.mind_before, p) == comparison.observation)), v_support(trace, od.mind_after, event.actor, local_3, [])))):
                                                found = true
                                    n = (n + 1)
                            k = (k + 1)
                    j = (j + 1)
        i = (i + 1)
    return found
