; Milestone occurrence, ordering and semantic evidence are separate checks.
(defn v_milestone_semantics (manifest trace oracle spec event)
  (let (kind (dv_find spec "semantic_kind" "") data (dv_get event "data") status "insufficient_evidence"
        reason "节点只有事件类型记录；尚缺其真实语义验收绑定" refs (dv_single (dv_get event "id")) events (v_events trace))
    (do
      (if (rt_eq kind "")
        (if (rt_eq (dv_get event "type") "speech_literal") (set kind "legal_opening")
          (if (rt_eq (dv_get event "type") "observation") (set kind "new_observation")
            (if (rt_eq (dv_get event "type") "answer_ready") (set kind "ready_argument") false))) false)
      (if (rt_eq kind "formal_answer")
        (if (rt_eq (dv_get event "type") "answer_submitted")
          (let (axes (v_axis_bundle manifest trace event oracle))
            (do (set status (if (dv_and (v_axis_supported axes "literal_truth") (dv_and (v_axis_supported axes "epistemic_support") (v_axis_supported axes "causal_completeness"))) "supported" "insufficient_evidence"))
              (set reason "精确答案提交已发生；独立核该问题字面、本人来源及完整因果，不能以其他题目或子题替代")))
          (let (validation (v_answer_validation manifest trace event))
            (do (set status (dv_get validation "status")) (set reason (dv_get validation "reason"))))) false)
      (if (rt_eq kind "genuine_rejection")
        (let (validation (v_answer_validation manifest trace event) submit (v_parent_submission events event))
          (do
            (if (rt_lt 0 (rt_count submit))
              (let (axes (dv_find validation "axes" (rt_list)) action (v_submission_action submit))
                (if (dv_and (rt_eq (dv_get validation "status") "supported")
                  (dv_and (rt_eq (dv_find axes "literal_truth" "unknown") "true") (rt_eq (dv_find axes "question_match" "unknown") "true")))
                  (if (dv_or (rt_eq (dv_find axes "answer_complete" "unknown") "false") (rt_not (rt_eq (dv_find axes "epistemic_support" "unknown") "true")))
                    (set status "supported") false) false)) false)
            (set reason "真缺口驳回须是当前题目相关的真实字面命题，正式拒绝其未完成论证或缺本人来源；错题真陈述不替代此节点"))) false)
      (if (rt_eq kind "legal_opening")
        (let (context (v_context_event events event) misunderstood false differentiated false i 0 statuses (rt_list))
          (do
            (while (rt_lt i (rt_count events))
              (let (candidate (rt_at events i) cd (dv_get (rt_at events i) "data"))
                (do (if (dv_and (rt_eq (dv_get candidate "type") "implicature") (rt_eq (dv_find cd "source_event" "") (dv_get event "id")))
                  (if (rt_eq (dv_get (v_interpretation_check trace candidate) "status") "supported")
                    (do (if (dv_and (rt_eq (dv_find cd "status" "") "accepted") (dv_find (dv_find cd "scope_check" (rt_list)) "gap" false)) (set misunderstood true) false)
                      (if (dv_has statuses (dv_find cd "status" "")) false (do (if (rt_lt 0 (rt_count statuses)) (set differentiated true) false) (rt_push statuses (dv_find cd "status" ""))))) false) false)
                  (set i (rt_add i 1)))))
            (if (dv_and (v_source_delivery trace event) (dv_and misunderstood differentiated))
              (let (axes (v_axis_bundle manifest trace context oracle))
                (if (dv_and (v_axis_supported axes "literal_truth") (v_axis_supported axes "epistemic_support")) (set status "supported") false)) false)
            (set reason "合法开场需真实真话及说话者来源，还须实际听者采纳了缺桥接暗示，且不同本人出现经重算验证的理解或采纳差异"))) false)
      (if (rt_eq kind "new_observation")
        (if (dv_has_key spec "requirement")
          (let (requirement (dv_get spec "requirement"))
            (if (dv_and (v_observation_verified trace (dv_get event "id"))
              (dv_and (rt_not (rt_eq (dv_truth (dv_get data "mind_before") requirement) "true"))
                (dv_and (rt_eq (dv_truth (dv_get data "mind_after") requirement) "true") (v_support trace (dv_get data "mind_after") (dv_get event "actor") requirement (rt_list)))))
              (do (set status "supported") (set reason "真实新观察把所需认知从未建立变为本人有来源的支持；重复看已有事实不替代新证据")) false))
          (set reason "观察投映可以独立核验，但oracle尚未绑定需要新增的证据命题，不能把任意观察称为修正节点")) false)
      (if (rt_eq kind "serious_wrong_model_use")
        (do (if (dv_and (rt_eq (dv_get event "type") "mind_simulation")
          (dv_and (v_model_verified manifest trace (dv_get event "id"))
            (dv_and (v_wrong_model_used trace event) (v_wrong_new_refutation manifest trace event)))) (set status "supported") false)
          (set reason "真实选中假说推动付费方法与验证选择；本次完整执行产生确定预测，后续独立新观察重核其矛盾；先验标签、枚举、未知或计算截断不计为一次错误")) false)
      (if (rt_eq kind "serious_wrong_hypothesis")
        (let (current (dv_find data "current" (rt_list)) serious false refuted false i 0)
          (do
            (if (rt_is_list current)
              (if (rt_lt 0 (rt_count current))
                (while (rt_lt i (rt_count events))
                  (let (candidate (rt_at events i) cd (dv_get (rt_at events i) "data"))
                    (do
                      (if (rt_eq (dv_get candidate "actor") (dv_get event "actor"))
                        (if (rt_eq (dv_get candidate "type") "mind_simulation")
                          (if (rt_eq (dv_find (dv_find cd "hypothesis" (rt_list)) "id" "") (dv_get current "id"))
                            (if (dv_and (v_model_verified manifest trace (dv_get candidate "id")) (v_ancestor events (dv_get candidate "id") (dv_get event "id"))) (set serious true) false) false)
                          (if (rt_eq (dv_get candidate "type") "model_recheck")
                            (let (old (dv_find cd "model_before" (rt_list)) actual (v_model_result candidate))
                              (if (dv_and (v_model_verified manifest trace (dv_get candidate "id")) (rt_eq (dv_find actual "status" "unknown") "inconsistent"))
                                (let (original (v_event events (dv_find old "paid_model_event" (dv_find old "event" ""))))
                                  (if (rt_eq (dv_find (dv_find (dv_find original "data" (rt_list)) "hypothesis" (rt_list)) "id" "") (dv_get current "id")) (set refuted true) false)) false)) false)) false)
                      (set i (rt_add i 1))))) false) false)
            (if (dv_and serious refuted) (set status "supported") false)
            (set reason "认真错误假说需要本人真实选择后付费重演同一假说，并被后续真实观测重核为不一致；偏好标签或错误答案本身不作证"))) false)
      (if (rt_eq kind "ready_argument")
        (do (set status (dv_get (v_ready_deadline manifest trace oracle) "status")) (set reason "目标就绪必须有实际付费完整模型、本人来源及全题论证，另核运行起点总预算")) false)
      (if (rt_eq kind "sharing_withdrawal")
        (let (origin (v_origin_execution events event) targets (rt_list) i 0 valid true adopted false)
          (do
            (if (rt_lt 0 (rt_count origin)) (set targets (dv_find (dv_get (dv_get origin "data") "action") "listeners" (rt_list))) (set valid false))
            (if (rt_eq (rt_count targets) 0) (set valid false) false)
            (while (rt_lt i (rt_count targets))
              (let (actor (rt_at targets i) j 0 prior_accepted false withdrawn false)
                (do
                  (while (rt_lt j (rt_count events))
                    (let (candidate (rt_at events j) cd (dv_get (rt_at events j) "data"))
                      (do (if (rt_eq (dv_get candidate "actor") actor)
                        (if (rt_eq (dv_get candidate "type") "implicature")
                          (if (dv_and (dv_and (rt_eq (dv_find cd "status" "") "accepted") (dv_find (dv_find cd "scope_check" (rt_list)) "gap" false)) (dv_and (v_event_precedes events candidate event) (rt_eq (dv_get (v_interpretation_check trace candidate) "status") "supported"))) (set prior_accepted true) false)
                          (if (rt_eq (dv_get candidate "type") "implicature_withdrawn")
                            (if (rt_lt 0 (rt_count origin))
                              (if (dv_and (dv_and (v_ancestor events (dv_get candidate "id") (dv_get origin "id")) (rt_eq (dv_get (v_interpretation_check trace candidate) "status") "supported")) (if (dv_has_key cd "proposal") (v_proposal_withdrawn_gap candidate) (dv_find (dv_find (dv_find (dv_find cd "interpretations_before" (rt_list)) (dv_find cd "id" "") (rt_list)) "scope_check" (rt_list)) "gap" false))) (set withdrawn true) false) false) false)) false)
                        (set j (rt_add j 1)))))
                  (if prior_accepted (do (set adopted true) (set valid (dv_and valid withdrawn))) false)
                  (set i (rt_add i 1)))))
            (if (dv_and (v_source_delivery trace event) (dv_and adopted valid)) (set status "supported") false)
            (set reason "对真实分享听者逐人追溯其先前实际采纳，已采纳者须因该真实分享执行的新证据撤销；撤销P不写入not P"))) false)
      (let (required (dv_find spec "causal_after" (rt_list)) i 0)
        (while (rt_lt i (rt_count required))
          (do (if (v_ancestor events (dv_get event "id") (rt_at required i)) false (do (set status "insufficient_evidence") (set reason "该语义绑定需要的真实来源前驱未记录，不能以全局顺序替代因果来源"))) (set i (rt_add i 1)))))
      (dv_with (dv_with (v_finding "milestone_semantics" status reason refs) "actor" (dv_get event "actor")) "action" kind))))
(defn v_select_milestone (manifest trace oracle spec chosen)
  (let (events (v_events trace) found (rt_list) i 0 after (dv_find spec "after" (rt_list)))
    (do (while (dv_and (rt_eq (rt_count found) 0) (rt_lt i (rt_count events)))
      (let (event (rt_at events i) eligible true j 0)
        (do (set eligible (dv_and (rt_eq (dv_get event "type") (dv_get spec "type")) (dv_or (rt_eq (dv_find spec "actor" "") "") (rt_eq (dv_get event "actor") (dv_get spec "actor")))))
          (if eligible (set eligible (v_spec_scope events spec event)) false)
          (while (dv_and eligible (rt_lt j (rt_count after)))
            (let (prior (dv_find chosen (rt_at after j) (rt_list)))
              (do (if (rt_eq (rt_count prior) 0) (set eligible false) (set eligible (v_event_precedes events prior event))) (set j (rt_add j 1)))))
          (if eligible (if (rt_eq (dv_get (v_milestone_semantics manifest trace oracle spec event) "status") "supported") (set found event) false) false)
          (set i (rt_add i 1)))))
      (if (rt_lt 0 (rt_count found)) found (v_first_after events spec chosen)))))

(defn v_wrong_probe_refs (hypothesis)
  (let (features (dv_find hypothesis "features" (rt_list)) refs (rt_list) i 0)
    (do (while (rt_lt i (rt_count features))
      (let (feature (rt_at features i))
        (do (set refs (dv_explanation_merge refs (v_model_sim_refs (dv_find feature "observation"
          (if (dv_has_key feature "proposition") (dv_get feature "proposition") feature))))) (set i (rt_add i 1))))) refs)))
(defn v_wrong_model_used (trace event)
  (let (events (v_events trace) origin (v_origin_execution (v_events trace) event) hypothesis (dv_find (dv_get event "data") "hypothesis" (rt_list))
        selected (rt_list) choice (rt_list) adopted false verified_choice false i 0 result (v_model_result event))
    (do (if (rt_lt 0 (rt_count origin))
      (let (ancestors (v_ancestors events (dv_get origin "id")))
        (do (while (rt_lt i (rt_count events))
          (let (candidate (rt_at events i) data (dv_get (rt_at events i) "data"))
            (do (if (dv_and (rt_eq (dv_get candidate "actor") (dv_get event "actor")) (dv_has ancestors (dv_get candidate "id")))
              (do (if (dv_has (dv_pair "hypothesis_adopted" "hypothesis_revised") (dv_get candidate "type"))
                (if (dv_same (v_record_without (dv_find data "current" (rt_list)) (dv_single "simulation")) hypothesis) (set adopted true) false) false)
                (if (rt_eq (dv_get candidate "type") "action_selected")
                  (if (dv_same (dv_get data "action") (dv_get (dv_get origin "data") "action")) (set selected candidate) false) false)
                (if (rt_eq (dv_get candidate "type") "planning_choice")
                  (if (dv_same (dv_find data "action" false) (dv_get (dv_get origin "data") "action")) (set choice candidate) false) false)) false)
              (set i (rt_add i 1)))))
          (if (dv_and (rt_lt 0 (rt_count selected)) (rt_lt 0 (rt_count choice)))
            (let (data (dv_get choice "data") path (dv_find (dv_get choice "data") "selected_path" (rt_list)) plans (dv_find (dv_get choice "data") "plans" (rt_list)) j 0)
              (do (while (rt_lt j (rt_count plans))
                (let (plan (rt_at plans j))
                  (do (if (dv_and (dv_same (dv_get plan "path") path) (dv_and (rt_lt 0 (rt_count path))
                    (rt_eq (rt_at path 0) (dv_get (dv_get (dv_get origin "data") "action") "id"))))
                    (if (dv_and (dv_same (dv_get plan "probe_refs") (v_wrong_probe_refs hypothesis))
                      (dv_and (rt_lt 0 (dv_find (dv_get plan "value") "verification" 0))
                        (rt_eq (dv_find (dv_find (dv_find (dv_get selected "data") "hypothesis" (rt_list)) "simulation" (rt_list)) "status" "") "stale-or-unavailable")))
                      (set verified_choice true) false) false) (set j (rt_add j 1)))))
                (set verified_choice (dv_and verified_choice
                  (dv_same (v_record_without (dv_find (dv_get selected "data") "hypothesis" (rt_list)) (dv_single "simulation")) hypothesis))))) false))) false)
      (dv_and adopted (dv_and verified_choice (dv_and (rt_eq (dv_find (dv_find (dv_find origin "data" (rt_list)) "action" (rt_list)) "kind" "") "replay")
        (dv_and (rt_eq (dv_find (dv_find (dv_find (dv_find origin "data" (rt_list)) "receipt" (rt_list)) "execution" (rt_list)) "status" "") "applied")
          (dv_and (dv_find result "plan_complete" false) (dv_and (rt_eq (rt_count (dv_find result "failures" (rt_list))) 0)
            (dv_and (rt_lt 0 (dv_find result "expanded" 0))
              (dv_and (rt_not (rt_lt (dv_find result "remaining" -1) 0))
                (dv_and (rt_eq (rt_count (dv_find result "predictions" (rt_list))) (rt_count (dv_find result "comparisons" (rt_list))))
                  (rt_eq (rt_count (dv_find result "contradictions" (rt_list))) 0)))))))))))))
(defn v_wrong_new_refutation (manifest trace event)
  (let (events (v_events trace) old (v_model_result event) predictions (dv_find (v_model_result event) "predictions" (rt_list)) i 0 found false)
    (do (while (rt_lt i (rt_count events))
      (let (candidate (rt_at events i) data (dv_get (rt_at events i) "data"))
        (do (if (dv_and (rt_eq (dv_get candidate "actor") (dv_get event "actor")) (rt_eq (dv_get candidate "type") "model_recheck"))
          (if (dv_and (v_model_verified manifest trace (dv_get candidate "id"))
            (dv_and (v_ancestor events (dv_get candidate "id") (dv_get event "id"))
              (rt_eq (dv_find (dv_find data "model_before" (rt_list)) "paid_model_event" (dv_find (dv_find data "model_before" (rt_list)) "event" "")) (dv_get event "id"))))
            (let (comparisons (dv_find (v_model_result candidate) "comparisons" (rt_list)) j 0)
              (do (while (rt_lt j (rt_count comparisons))
                (let (comparison (rt_at comparisons j) k 0)
                  (do (if (rt_eq (dv_find comparison "result" "") "contradiction")
                    (while (rt_lt k (rt_count predictions))
                      (let (prediction (rt_at predictions k))
                        (do (if (dv_and (dv_same (dv_get prediction "feature") (dv_get comparison "feature"))
                          (dv_and (dv_get prediction "covered")
                            (dv_and (dv_has (dv_pair "true" "false") (dv_get prediction "prediction"))
                              (rt_eq (dv_get prediction "prediction") (dv_get comparison "prediction")))))
                          (let (n 0)
                            (while (rt_lt n (rt_count events))
                              (let (observation (rt_at events n) od (dv_get (rt_at events n) "data"))
                                (do (if (dv_and (rt_eq (dv_get observation "actor") (dv_get event "actor"))
                                  (dv_and (dv_has (dv_pair "observation" "listener_parse") (dv_get observation "type"))
                                    (dv_and (v_event_precedes events event observation) (v_ancestor events (dv_get candidate "id") (dv_get observation "id")))))
                                  (if (if (rt_eq (dv_get observation "type") "observation") (v_observation_verified trace (dv_get observation "id")) (v_reception_verified trace (dv_get observation "id")))
                                    (let (p (dv_find (dv_get prediction "feature") "observation" (dv_get prediction "proposition"))
                                          physical (v_authority_before trace event))
                                      (if (dv_and (if (rt_lt 0 (rt_count physical))
                                          (rt_eq (dv_truth physical (v_physical_proposition p
                                            (dv_find (dv_find trace "configuration" (rt_list)) "bindings" (rt_list))
                                            (dv_get (dv_get od "mind_after") "subject"))) (dv_get comparison "observation")) false)
                                        (dv_and (rt_eq (dv_truth (dv_get od "mind_after") p) (dv_get comparison "observation"))
                                        (dv_and (rt_not (rt_eq (dv_truth (dv_get od "mind_before") p) (dv_get comparison "observation")))
                                          (v_support trace (dv_get od "mind_after") (dv_get event "actor")
                                            (if (rt_eq (dv_get comparison "observation") "true") p (dv_not p)) (rt_list))))) (set found true) false)) false) false)
                                  (set n (rt_add n 1)))))) false) (set k (rt_add k 1))))) false) (set j (rt_add j 1))))))) false) false)
          (set i (rt_add i 1))))) found)))
