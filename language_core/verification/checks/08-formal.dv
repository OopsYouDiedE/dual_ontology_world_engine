fn v_formal_gate_truth(axes):
    var i = 0
    var result = "true"
    while (i < rt_count(axes)):
        var value = axes[i][1]
        if (value == "false"):
            result = "false"
        else:
            if dv_and((value == "unknown"), (result == "true")):
                result = "unknown"
        i = (i + 1)
    return result

fn v_parent_submission(events, e):
    var parents = dv_find(e, "parents", [])
    var i = 0
    var found = []
    while (i < rt_count(parents)):
        var parent = v_event(events, parents[i])
        if (dv_find(parent, "type", "") == "answer_submitted"):
            found = parent
        i = (i + 1)
    return found

fn v_transition_executable(physical, rule, time):
    var name = dv_find(rule, "accepted_law", "")
    var adoption = dv_find(physical.adoptions, dv_find(rule, "accepted_law", ""), [])
    if (name == ""):
        return "unknown"
    else:
        if (rt_count(adoption) == 0):
            return "unknown"
        else:
            if dv_and(adoption.active, (adoption.mode == "enforce")):
                var law = adoption.law
                var truth = dv_truth(physical, adoption.law.premise)
                if (truth == "true"):
                    if (dv_stage(physical, law.effects, time, adoption.basis, adoption.confidence).status == "ready"):
                        return "true"
                    else:
                        return "false"
                else:
                    return truth
            else:
                return "false"

fn v_answer_validation(manifest, trace, e):
    var submit = v_parent_submission(v_events(trace), e)
    var status = "insufficient_evidence"
    var reason = "缺少本次真实提交或完整冻结答辩规则"
    var refs = dv_single(e.id)
    var axes = []
    if (0 < rt_count(submit)):
        var data = submit.data
        var rule = v_formal_rule(v_formal_rules(manifest, trace), dv_find(v_submission_action(submit), "answer_id", ""))
        rt_push(refs, submit.id)
        if (rt_count(rule) == 0):
            if dv_or(dv_has_key(manifest, "formal_answers"), dv_has_key(dv_find(trace, "configuration", []), "formal_answers")):
                var local_1 = false
                if (e.type == "answer_rejected"):
                    local_1 = "supported"
                else:
                    local_1 = "violated"
                status = local_1
                reason = "提交答案未列于冻结答辩目录，正式系统应驳回"
        if dv_and(dv_and((0 < rt_count(rule)), dv_has_key(data, "mind")), dv_has_key(data, "physical")):
            var local_2 = false
            if dv_find(rule, "condition_from_answer", false):
                local_2 = v_physical_proposition(v_submission_action(submit).answer, dv_find(dv_find(trace, "configuration", []), "bindings", []), data.mind.subject)
            else:
                local_2 = rule.condition
            var literal = dv_truth(data.physical, local_2)
            var support = dv_truth(data.mind, rule.required_support)
            var local_3 = false
            if dv_has_key(rule, "question_match"):
                local_3 = dv_truth(data.physical, rule.question_match)
            else:
                local_3 = "unknown"
            var match = local_3
            var local_4 = false
            if dv_has_key(rule, "answer_complete"):
                local_4 = dv_truth(data.mind, rule.answer_complete)
            else:
                local_4 = "unknown"
            var complete = local_4
            var executable = v_transition_executable(data.physical, rule, e.time)
            var accepted = false
            if dv_find(rule, "require_argument", false):
                if v_submitted_argument_valid(manifest, trace, submit):
                    false
                else:
                    complete = "unknown"
            accepted = dv_and(dv_and((literal == "true"), (support == "true")), dv_and((match == "true"), dv_and((complete == "true"), (executable == "true"))))
            if dv_has_key(data, "personal_accepted_answers"):
                var stage = dv_find(e.data, "stage", "")
                var local_5 = false
                if dv_or(dv_has_key(v_submission_action(submit), "argument"), dv_find(rule, "require_argument", false)):
                    local_5 = 2
                else:
                    local_5 = 1
                var level = local_5
                var prior = dv_find(data.personal_accepted_answers, dv_find(e.data, "stage", ""), 0)
                accepted = dv_and(accepted, (prior < level))
            axes = dv_with({"literal_truth": literal, "epistemic_support": support, "question_match": match, "answer_complete": complete}, "transition_executable", executable)
            if (v_formal_gate_truth(axes) == "unknown"):
                status = "insufficient_evidence"
                reason = "当前问题、回答完整性或交接前提尚未确定；字面真值独立保留"
            else:
                var local_6 = false
                if ((e.type == "answer_accepted") == accepted):
                    local_6 = "supported"
                else:
                    local_6 = "violated"
                status = local_6
                reason = "独立核对字面真值、本人来源、当前题目、回答完整性与可执行交接后，验证正式接受或驳回"
            if (not (e.actor == submit.actor)):
                status = "violated"
            if accepted:
                if dv_and(v_support(trace, data.mind, e.actor, rule.required_support, []), v_support(trace, data.mind, e.actor, rule.answer_complete, [])):
                    false
                else:
                    status = "insufficient_evidence"
                if (dv_find(e.data, "accepted_law", "") == rule.accepted_law):
                    false
                else:
                    status = "violated"
                    reason = "接受记录指向的交接法则与冻结答辩规则不同"
    var local_7 = false
    if (0 < rt_count(submit)):
        local_7 = v_question(submit)
    else:
        local_7 = false
    return dv_with(dv_with(v_finding("formal_answer_validity", status, reason, refs), "axes", axes), "question_id", local_7)

fn v_axis_supported(axes, id):
    var i = 0
    var found = false
    while (i < rt_count(axes)):
        if (axes[i].id == id):
            found = (axes[i].status == "supported")
        i = (i + 1)
    return found

fn v_ready_deadline(manifest, trace, oracle):
    var events = v_events(trace)
    var actor = dv_find(oracle, "actor", "")
    var first_id = dv_find(oracle, "first_question_id", "")
    var target_id = dv_find(oracle, "target_question_id", "")
    var t0 = []
    var ready = []
    var i = 0
    var status = "not_observed"
    var reason = "指定首题接受或目标题独立就绪事件尚未发生"
    if dv_or(dv_or((not dv_has_key(dv_find(oracle, "limit", []), "maximum_game_minutes")), (not (dv_find(dv_find(oracle, "limit", []), "origin", "") == "run_start"))), dv_or((actor == ""), dv_or((first_id == ""), (target_id == "")))):
        status = "insufficient_evidence"
        reason = "验收配置须绑定本人、首题与目标题，并声明从正式运行起点计时"
    else:
        while (i < rt_count(events)):
            var e = events[i]
            if (e.actor == actor):
                if dv_and((rt_count(t0) == 0), (e.type == "answer_accepted")):
                    var submit = v_parent_submission(events, e)
                    if dv_and((0 < rt_count(submit)), (v_question(submit) == first_id)):
                        if (v_answer_validation(manifest, trace, e).status == "supported"):
                            t0 = e
                if dv_and((rt_count(ready) == 0), (e.type == "answer_ready")):
                    if (v_question(e) == target_id):
                        ready = e
            i = (i + 1)
        if dv_and((0 < rt_count(t0)), (0 < rt_count(ready))):
            var data = v_ready_context(trace, ready).data
            var axes = v_axis_bundle(manifest, trace, dv_with(v_ready_context(trace, ready), "type", "answer_submitted"), oracle)
            var elapsed = (ready.time - trace.initial.physical.time)
            status = "insufficient_evidence"
            reason = "就绪需要独立来源及当前题目的真值、本人证据与完整因果链；局部模型解释不能替代全题"
            if dv_and(dv_and(dv_has_key(data, "basis_event_ids"), (0 < rt_count(dv_find(data, "basis_event_ids", [])))), dv_and(v_submitted_argument_valid(manifest, trace, v_ready_context(trace, ready)), dv_and(v_axis_supported(axes, "literal_truth"), dv_and(v_axis_supported(axes, "epistemic_support"), v_axis_supported(axes, "causal_completeness"))))):
                var basis = data.basis_event_ids
                var j = 0
                var valid = v_ancestor(events, ready.id, t0.id)
                while (j < rt_count(basis)):
                    valid = dv_and(valid, v_ancestor(events, ready.id, basis[j]))
                    j = (j + 1)
                if dv_and(valid, (dv_find(trace, "game_time_unit", "") == "minute")):
                    var local_1 = false
                    if dv_and((not (elapsed < 0)), (not (dv_find(dv_find(oracle, "limit", []), "maximum_game_minutes", 0) < elapsed))):
                        local_1 = "supported"
                    else:
                        local_1 = "violated"
                    status = local_1
                    reason = "本题完整来源就绪时刻按不可变的正式运行起点及冻结游戏分钟预算核验"
    return dv_with(dv_with(v_finding("ready_deadline", status, reason, dv_pair(dv_find(t0, "id", false), dv_find(ready, "id", false))), "first_acceptance_game_time", dv_find(t0, "time", false)), "ready_game_time", dv_find(ready, "time", false))

fn v_run_stage_times(manifest, trace, oracle):
    var events = v_events(trace)
    var actor = dv_find(oracle, "actor", "")
    var target = dv_find(oracle, "target_question_id", "")
    var start = trace.initial.physical.time
    var maximum = dv_find(dv_find(oracle, "limit", []), "maximum_game_minutes", 0)
    var kinds = dv_list3("answer_submitted", "answer_accepted", "speech_literal")
    var result = []
    var k = 0
    var accepted = []
    while (k < rt_count(kinds)):
        var kind = kinds[k]
        var chosen = []
        var i = 0
        while dv_and((rt_count(chosen) == 0), (i < rt_count(events))):
            var event = events[i]
            if dv_and((event.actor == actor), (event.type == kind)):
                if (kind == "speech_literal"):
                    if (0 < rt_count(accepted)):
                        if v_ancestor(events, event.id, accepted.id):
                            chosen = event
                else:
                    var local_1 = false
                    if (kind == "answer_accepted"):
                        local_1 = v_parent_submission(events, event)
                    else:
                        local_1 = event
                    if (v_question(local_1) == target):
                        chosen = event
            i = (i + 1)
        if (kind == "answer_accepted"):
            accepted = chosen
        var local_2 = false
        if (rt_count(chosen) == 0):
            local_2 = false
        else:
            local_2 = (chosen.time - start)
        var elapsed = local_2
        var local_3 = false
        if dv_or((not dv_has_key(dv_find(oracle, "limit", []), "maximum_game_minutes")), (not (dv_find(dv_find(oracle, "limit", []), "origin", "") == "run_start"))):
            local_3 = "invalid_run"
        else:
            if (rt_count(chosen) == 0):
                local_3 = "not_observed"
            else:
                if dv_and((not (elapsed < 0)), (not (maximum < elapsed))):
                    local_3 = "supported"
                else:
                    local_3 = "violated"
        rt_push(result, dv_with(dv_with(v_finding(rt_cat("run_start_time_", kind), local_3, "从真实运行起点记录本题实际提交、接受或后续分享时刻；这是时限记录，合法性与完整论证由独立轴核验", dv_single(dv_find(chosen, "id", false))), "run_start_game_time", start), "elapsed_game_minutes", elapsed))
        k = (k + 1)
    return result
