fn v_event_prefix(events, stop):
    var items = []
    var i = 0
    while (i < stop):
        rt_push(items, events[i])
        i = (i + 1)
    return items

fn v_record_without(record, keys):
    var copy = []
    var i = 0
    while (i < rt_count(record)):
        if dv_has(keys, record[i][0]):
            false
        else:
            rt_push(copy, record[i])
        i = (i + 1)
    return copy

fn v_model_hypothesis(actor, id):
    var items = dv_find(actor.policy, "hypotheses", [])
    var i = 0
    var found = []
    while (i < rt_count(items)):
        if (items[i].id == id):
            found = items[i]
        i = (i + 1)
    return found

fn v_model_result(event):
    var data = dv_find(event, "data", [])
    return dv_find(data, "result", v_record_without(data, dv_list3("actor_before", "model_before", "hypothesis")))

fn v_cognitive_before(trace, event):
    var events = v_events(trace)
    var mind = v_initial_mind(trace, event.actor)
    var i = 0
    var ancestors = v_ancestors(v_events(trace), event.id)
    while (i < rt_count(events)):
        var prior = events[i]
        var data = dv_find(events[i], "data", [])
        if dv_and((prior.actor == event.actor), dv_has(ancestors, prior.id)):
            var local_1 = false
            if (prior.type == "model_argument_accepted"):
                local_1 = dv_find(dv_find(data, "result", []), "world", [])
            else:
                if (prior.type == "inference"):
                    local_1 = dv_find(dv_find(data, "receipt", []), "world", [])
                else:
                    local_1 = []
            var candidate = dv_find(data, "mind_after", local_1)
            if (0 < rt_count(candidate)):
                if (mind.revision < candidate.revision):
                    mind = candidate
        i = (i + 1)
    return mind

fn v_model_checks_compute(manifest, trace):
    var events = v_events(trace)
    var result = []
    var states = []
    var i = 0
    var catalog = v_frozen_catalog(manifest, trace)
    while (i < rt_count(events)):
        var event = events[i]
        var data = events[i].data
        var kind = events[i].type
        if (kind == "speech_choice_prediction"):
            var id = event.actor
            var state = dv_find(states, event.actor, [])
            var frozen = v_frozen_actor(trace, event.actor)
            var total = dv_find(v_frozen_actor(trace, event.actor).policy, "model_budget", 0)
            var valid = (v_paid_prediction_check(trace, event).status == "supported")
            if (0 < rt_count(state)):
                total = state.remaining
                valid = dv_and(valid, dv_and((state.status == "supported"), v_ancestor(events, event.id, state.event)))
            valid = dv_and(valid, (total == dv_find(data, "budget_before", -1)))
            if (0 < dv_find(data, "charged_units", 0)):
                var local_1 = false
                if valid:
                    local_1 = "supported"
                else:
                    local_1 = "violated"
                states = dv_with(states, id, dv_with({"remaining": dv_find(data, "budget_after", total), "work_remaining": dv_find(state, "work_remaining", 0), "paid": dv_find(state, "paid", ""), "event": event.id}, "status", local_1))
            var local_2 = false
            if valid:
                local_2 = "supported"
            else:
                local_2 = "violated"
            rt_push(result, v_finding("speech_model_budget_provenance", local_2, "发言预选与模型演算共用真实串行预算；核对前次预算事件父边和实际逐节点扣费", dv_single(event.id)))
        if dv_has(dv_list3("mind_simulation", "model_recheck", "factor_prune"), kind):
            var frozen = v_frozen_actor(trace, event.actor)
            var before = dv_find(data, "actor_before", [])
            var origin = v_origin_execution(events, event)
            var actual = v_model_result(event)
            var status = "insufficient_evidence"
            var reason = "缺少真实模型输入、付费执行或当前本人快照，不能按explained标签判定"
            var expected = []
            var checks = []
            if dv_and((0 < rt_count(before)), dv_and((0 < rt_count(frozen)), (0 < rt_count(origin)))):
                var id = event.actor
                var state = dv_find(states, event.actor, [])
                var paid = origin.data
                var policy = before.policy
                var total = dv_find(frozen.policy, "model_budget", 0)
                var work = dv_find(dv_find(catalog, dv_find(origin.data.action, "kind", ""), []), "work_limit", 0)
                var hypothesis = dv_find(data, "hypothesis", [])
                var valid = true
                var missing = false
                if (0 < rt_count(state)):
                    total = state.remaining
                    if (state.paid == origin.id):
                        work = state.work_remaining
                if (kind == "factor_prune"):
                    expected = v_record_without(v_prune_factor_prune(before, v_event_prefix(events, i), event.time, "judge-local"), dv_single("actor_before"))
                    valid = dv_and(valid, dv_same(dv_find(policy, "factor_domains", []), dv_find(frozen.policy, "factor_domains", [])))
                    valid = dv_and(valid, dv_same(dv_find(policy, "factor_constraints", []), dv_find(frozen.policy, "factor_constraints", [])))
                    valid = dv_and(valid, (dv_find(policy, "prune_confidence_limit", -1) == dv_find(frozen.policy, "prune_confidence_limit", -2)))
                else:
                    if (kind == "model_recheck"):
                        var old = dv_find(data, "model_before", [])
                        if (0 < rt_count(old)):
                            expected = v_model_model_recheck(before, old)
                            valid = dv_and(valid, v_ancestor(events, event.id, dv_find(old, "event", "")))
                            valid = dv_and(valid, v_model_cache_matches(trace, old))
                        else:
                            missing = true
                            valid = false
                    else:
                        if (0 < rt_count(hypothesis)):
                            valid = dv_and(valid, dv_same(hypothesis, v_model_hypothesis(frozen, hypothesis.id)))
                            expected = v_model_model(before, hypothesis, i, event.time, "judge-local")
                        else:
                            missing = true
                            valid = false
                if (kind == "factor_prune"):
                    var certificates = dv_find(actual, "certificates", [])
                    var j = 0
                    var ancestors = v_ancestors(events, event.id)
                    while (j < rt_count(certificates)):
                        var roots = certificates[j].source_event_ids
                        var k = 0
                        while (k < rt_count(roots)):
                            if dv_has(ancestors, roots[k]):
                                false
                            else:
                                missing = true
                            k = (k + 1)
                        j = (j + 1)
                checks = {"actual_replay": dv_same(expected, actual), "mind_origin": dv_same(before.mind, v_cognitive_before(trace, event)), "total_budget": (total == dv_find(policy, "model_budget", -1)), "method_work_budget": (work == dv_find(policy, "model_work_remaining", -1))}
                valid = dv_and(valid, dv_and(checks.actual_replay, dv_and(checks.mind_origin, dv_and(checks.total_budget, checks.method_work_budget))))
                valid = dv_and(valid, dv_and((dv_find(paid.action, "kind", "") == "replay"), dv_and(v_action_frozen(trace, id, paid.action), (paid.receipt.execution.status == "applied"))))
                valid = dv_and(valid, dv_same(dv_find(before, "response_models", []), dv_find(frozen, "response_models", [])))
                if (0 < rt_count(state)):
                    valid = dv_and(valid, dv_and((dv_find(state, "status", "") == "supported"), v_ancestor(events, event.id, state.event)))
                var local_3 = false
                if missing:
                    local_3 = "insufficient_evidence"
                else:
                    if valid:
                        local_3 = "supported"
                    else:
                        local_3 = "violated"
                status = local_3
                reason = "独立重演本人的假设、时序法则、条件回应及逐特征观测比较；核对真实付费执行、认知来源和串行模型预算"
                states = dv_with(states, id, dv_with({"remaining": dv_find(actual, "remaining", total), "work_remaining": dv_find(actual, "work_remaining", work), "paid": origin.id, "event": event.id}, "status", status))
            var local_4 = false
            if (kind == "factor_prune"):
                local_4 = "factor_prune_provenance"
            else:
                local_4 = "model_replay_provenance"
            rt_push(result, dv_with(dv_with(v_finding(local_4, status, reason, dv_pair(event.id, dv_find(origin, "id", false))), "actor", event.actor), "checks", checks))
        i = (i + 1)
    return result

fn v_model_checks(manifest, trace):
    if dv_has_key(trace, "judge_model_findings"):
        return trace.judge_model_findings
    else:
        return v_model_checks_compute(manifest, trace)

fn v_model_verified(manifest, trace, id):
    var findings = v_model_checks(manifest, trace)
    var i = 0
    var valid = false
    while (i < rt_count(findings)):
        var finding = findings[i]
        if dv_and((finding.evidence_refs[0] == id), (finding.status == "supported")):
            valid = true
        i = (i + 1)
    return valid

fn v_model_cache_matches(trace, cached):
    var event = v_event(v_events(trace), dv_find(cached, "event", ""))
    var body = v_record_without(cached, dv_list3("event", "validated_by_inputs", "validated_by_argument"))
    var raw = v_model_result(v_event(v_events(trace), dv_find(cached, "event", "")))
    var before = dv_find(dv_find(v_event(v_events(trace), dv_find(cached, "event", "")), "data", []), "actor_before", [])
    if dv_has_key(body, "validation_inputs"):
        var inputs = dv_explanation_model_inputs(before.mind, raw)
        var comparisons = dv_find(raw, "comparisons", [])
        var i = 0
        while (i < rt_count(comparisons)):
            inputs = dv_explanation_merge(inputs, dv_find(comparisons[i], "observed_cells", []))
            i = (i + 1)
        return dv_same(body, dv_with(dv_with(dv_with(raw, "validation_inputs", inputs), "source_adoptions", before.mind.adoptions), "source_response_models", dv_find(before, "response_models", [])))
    else:
        return dv_same(body, raw)

fn v_runtime_policy_valid(trace, event, policy):
    var frozen = v_frozen_actor(trace, event.actor).policy
    var events = v_events(trace)
    var i = 0
    var stopped = false
    var remaining = dv_find(v_frozen_actor(trace, event.actor).policy, "plan_budget", 0)
    var valid = true
    var keys = dv_list3("model_budget", "model_work_remaining", "reason_budget")
    var origin = dv_find(dv_find(trace, "configuration", []), "time_origin", [])
    var policy_time = event.time
    var receiver = dv_has(dv_pair("implicature_withdrawn", "proposal_scope_reassessment"), event.type)
    rt_push(keys, "plan_budget")
    rt_push(keys, "remaining_game_time")
    if receiver:
        policy_time = trace.initial.physical.time
    while dv_and((not stopped), (i < rt_count(events))):
        var prior = events[i]
        if (prior.id == event.id):
            stopped = true
        if dv_and((not stopped), dv_and((prior.actor == event.actor), dv_has(dv_pair("planning_choice", "planning_stop"), prior.type))):
            var spent = dv_find(prior.data, "plan_expansions", 0)
            valid = dv_and(valid, dv_and((not (spent < 0)), (not (remaining < spent))))
            remaining = (remaining - spent)
            if receiver:
                policy_time = prior.time
        i = (i + 1)
    valid = dv_and(stopped, dv_and(valid, (remaining == dv_find(policy, "plan_budget", 0))))
    if dv_has_key(policy, "remaining_game_time"):
        if dv_has_key(origin, "horizon"):
            valid = dv_and(valid, (policy.remaining_game_time == (origin.horizon - policy_time)))
        else:
            valid = false
    return dv_and(valid, dv_same(v_record_without(policy, keys), v_record_without(frozen, keys)))
