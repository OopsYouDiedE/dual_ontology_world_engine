(defn v_record_without (record keys)
  (let (copy (rt_list) i 0)
    (do (while (rt_lt i (rt_count record))
      (do (if (dv_has keys (rt_at (rt_at record i) 0)) false (rt_push copy (rt_at record i))) (set i (rt_add i 1)))) copy)))
(defn v_model_hypothesis (actor id)
  (let (items (dv_find (dv_get actor "policy") "hypotheses" (rt_list)) i 0 found (rt_list))
    (do (while (rt_lt i (rt_count items))
      (do (if (rt_eq (dv_get (rt_at items i) "id") id) (set found (rt_at items i)) false) (set i (rt_add i 1)))) found)))
(defn v_model_result (event)
  (let (data (dv_find event "data" (rt_list)))
    (dv_find data "result" (v_record_without data (dv_list3 "actor_before" "model_before" "hypothesis")))))
(defn v_cognitive_before (trace event)
  (let (events (v_events trace) mind (v_initial_mind trace (dv_get event "actor")) i 0)
    (do (while (rt_lt i (rt_count events))
      (let (prior (rt_at events i) data (dv_find (rt_at events i) "data" (rt_list)))
        (do (if (dv_and (rt_eq (dv_get prior "actor") (dv_get event "actor")) (v_ancestor events (dv_get event "id") (dv_get prior "id")))
          (let (candidate (dv_find data "mind_after" (if (rt_eq (dv_get prior "type") "inference") (dv_find (dv_find data "receipt" (rt_list)) "world" (rt_list)) (rt_list))))
            (if (rt_lt 0 (rt_count candidate))
              (if (rt_lt (dv_get mind "revision") (dv_get candidate "revision")) (set mind candidate) false) false)) false)
          (set i (rt_add i 1))))) mind)))
(defn v_model_checks_compute (manifest trace)
  (let (events (v_events trace) result (rt_list) states (rt_list) i 0 catalog (v_frozen_catalog manifest trace))
    (do (while (rt_lt i (rt_count events))
      (let (event (rt_at events i) data (dv_get (rt_at events i) "data") kind (dv_get (rt_at events i) "type"))
        (do (if (dv_has (dv_pair "mind_simulation" "model_recheck") kind)
          (let (frozen (v_frozen_actor trace (dv_get event "actor")) before (dv_find data "actor_before" (rt_list))
                origin (v_origin_execution events event) actual (v_model_result event) status "insufficient_evidence"
                reason "缺少真实模型输入、付费执行或当前本人快照，不能按explained标签判定" expected (rt_list) checks (rt_list))
            (do
              (if (dv_and (rt_lt 0 (rt_count before)) (dv_and (rt_lt 0 (rt_count frozen)) (rt_lt 0 (rt_count origin))))
                (let (id (dv_get event "actor") state (dv_find states (dv_get event "actor") (rt_list))
                      paid (dv_get origin "data") policy (dv_get before "policy") total (dv_find (dv_get frozen "policy") "model_budget" 0)
                      work (dv_find (dv_find catalog (dv_find (dv_get (dv_get origin "data") "action") "kind" "") (rt_list)) "work_limit" 0)
                      hypothesis (dv_find data "hypothesis" (rt_list)) valid true)
                  (do
                    (if (rt_lt 0 (rt_count state))
                      (do (set total (dv_get state "remaining"))
                        (if (rt_eq (dv_get state "paid") (dv_get origin "id")) (set work (dv_get state "work_remaining")) false)) false)
                    (if (rt_eq kind "model_recheck")
                      (let (old (dv_find data "model_before" (rt_list)))
                        (if (rt_lt 0 (rt_count old))
                          (do (set expected (v_model_model_recheck before old))
                            (set valid (dv_and valid (v_ancestor events (dv_get event "id") (dv_find old "event" ""))))
                            (set valid (dv_and valid (dv_same (v_record_without old (dv_single "event")) (v_model_result (v_event events (dv_find old "event" "")))))))
                          (set valid false)))
                      (if (rt_lt 0 (rt_count hypothesis))
                        (do (set valid (dv_and valid (dv_same hypothesis (v_model_hypothesis frozen (dv_get hypothesis "id")))))
                          (set expected (v_model_model before hypothesis i (dv_get event "time") "judge-local")))
                        (set valid false)))
                    (set checks (dv_m4 "actual_replay" (dv_same expected actual) "mind_origin" (dv_same (dv_get before "mind") (v_cognitive_before trace event))
                      "total_budget" (rt_eq total (dv_find policy "model_budget" -1)) "method_work_budget" (rt_eq work (dv_find policy "model_work_remaining" -1))))
                    (set valid (dv_and valid (dv_and (dv_get checks "actual_replay") (dv_and (dv_get checks "mind_origin") (dv_and (dv_get checks "total_budget") (dv_get checks "method_work_budget"))))))
                    (set valid (dv_and valid (dv_and (rt_eq (dv_find (dv_get paid "action") "kind" "") "replay")
                      (dv_and (v_action_frozen trace id (dv_get paid "action")) (rt_eq (dv_get (dv_get (dv_get paid "receipt") "execution") "status") "applied")))))
                    (set valid (dv_and valid (dv_same (dv_find before "response_models" (rt_list)) (dv_find frozen "response_models" (rt_list)))))
                    (if (rt_lt 0 (rt_count state)) (set valid (dv_and valid (dv_and (rt_eq (dv_find state "status" "") "supported") (v_ancestor events (dv_get event "id") (dv_get state "event"))))) false)
                    (set status (if valid "supported" "violated"))
                    (set reason "独立重演本人的假设、时序法则、条件回应及逐特征观测比较；核对真实付费执行、认知来源和串行模型预算")
                    (set states (dv_with states id (dv_with (dv_m4 "remaining" (dv_find actual "remaining" total) "work_remaining" (dv_find actual "work_remaining" work) "paid" (dv_get origin "id") "event" (dv_get event "id")) "status" status))))) false)
              (rt_push result (dv_with (dv_with (v_finding "model_replay_provenance" status reason (dv_pair (dv_get event "id") (dv_find origin "id" false))) "actor" (dv_get event "actor")) "checks" checks)))) false)
          (set i (rt_add i 1))))) result)))
(defn v_model_checks (manifest trace)
  (if (dv_has_key trace "judge_model_findings") (dv_get trace "judge_model_findings") (v_model_checks_compute manifest trace)))
(defn v_model_verified (manifest trace id)
  (let (findings (v_model_checks manifest trace) i 0 valid false)
    (do (while (rt_lt i (rt_count findings))
      (let (finding (rt_at findings i))
        (do (if (dv_and (rt_eq (rt_at (dv_get finding "evidence_refs") 0) id) (rt_eq (dv_get finding "status") "supported")) (set valid true) false)
          (set i (rt_add i 1))))) valid)))
