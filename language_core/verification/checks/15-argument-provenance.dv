// Defeasible model arguments are audited separately from observations and literal authority.
// Dynamic sharing retains every frozen action field and transmits only requested claims.

fn v_argument_epoch_valid(actor):
    var argument = dv_find(actor, "argument", false)
    if (argument == false):
        return false
    else:
        return dv_and(dv_same(dv_find(argument, "adoptions", []), actor.mind.adoptions), dv_has_key(dv_find(actor, "heard_topics", []), argument.question_id))

fn v_argument_inputs_current(actor):
    var argument = dv_find(actor, "argument", false)
    var valid = true
    var i = 0
    if (argument == false):
        return false
    else:
        var inputs = argument.inputs
        while (i < rt_count(inputs)):
            var input = inputs[i]
            if dv_same(input.cell, dv_read(actor.mind, input.ref)):
                false
            else:
                var changes = argument.changes
                var j = 0
                var own_transaction = false
                var current = dv_read(actor.mind, input.ref)
                while (j < rt_count(changes)):
                    var change = changes[j]
                    if dv_and(dv_same(change.ref, input.ref), dv_and((dv_find(current, "source", "") == "abduction"), dv_and(dv_has(dv_find(current, "basis", []), argument.id), dv_same(current.value, change.after.value)))):
                        own_transaction = true
                    j = (j + 1)
                if own_transaction:
                    false
                else:
                    valid = false
            i = (i + 1)
        return valid

fn v_public_question(actor):
    if dv_has_key(actor, "question_ref"):
        var cell = dv_read(actor.mind, actor.question_ref)
        if dv_uncontested(cell):
            return cell.value
        else:
            return ""
    else:
        return ""

fn v_argument_sources(trace, event, index):
    var events = v_events(trace)
    var sources = []
    var i = 0
    while (i < index):
        var prior = events[i]
        var data = events[i].data
        if (prior.actor == event.actor):
            var local_1 = false
            if (prior.type == "observation"):
                local_1 = v_observation_verified(trace, prior.id)
            else:
                if (prior.type == "listener_parse"):
                    local_1 = v_reception_verified(trace, prior.id)
                else:
                    local_1 = false
            if local_1:
                var observations = data.observations
                var j = 0
                while (j < rt_count(observations)):
                    rt_push(sources, {"event_id": prior.id, "observation": observations[j]})
                    j = (j + 1)
        i = (i + 1)
    return sources

fn v_reason_budget_before(trace, event, index):
    var events = v_events(trace)
    var actor = v_frozen_actor(trace, event.actor)
    var remaining = dv_find(v_frozen_actor(trace, event.actor).policy, "reason_budget", 0)
    var i = 0
    while (i < index):
        var prior = events[i]
        var kind = events[i].type
        if (prior.actor == event.actor):
            if dv_and(dv_has_key(prior.data, "proposal"), dv_has_key(prior.data, "charged_units")):
                remaining = (remaining - dv_find(prior.data, "charged_units", 0))
            else:
                if dv_has(dv_list3("model_argument_revoked", "model_argument_revocation_pending", "inference_dependencies_invalidated"), kind):
                    remaining = (remaining - dv_find(prior.data, "checked", 0))
                else:
                    if dv_has(dv_pair("inference", "inference_alternative_basis"), kind):
                        remaining = (remaining - 1)
                    else:
                        if dv_has(dv_pair("model_argument_accepted", "model_argument_unavailable"), kind):
                            remaining = (remaining - dv_find(dv_find(prior.data, "result", []), "expanded", 0))
        i = (i + 1)
    return remaining

fn v_argument_model(actor, hypothesis):
    var model = dv_find(dv_find(actor, "simulations", []), hypothesis.id, {"fit": 0, "status": "not-simulated"})
    if dv_or((dv_find(model, "source_revision", -1) == actor.mind.revision), dv_and(dv_explanation_model_current(actor.mind, model), dv_same(dv_find(model, "source_response_models", false), dv_find(actor, "response_models", [])))):
        return dv_with(model, "validated_by_inputs", true)
    else:
        if dv_and(v_argument_epoch_valid(actor), v_argument_inputs_current(actor)):
            var argument = actor.argument
            if dv_and((dv_find(model, "source_revision", -1) == argument.source_revision), dv_or((dv_find(model, "event", "") == argument.model_event), dv_has(argument.competitor_events, dv_find(model, "event", "")))):
                return dv_with(model, "validated_by_argument", argument.id)
            else:
                return {"fit": 0, "status": "stale-or-unavailable", "source_revision": dv_find(model, "source_revision", -1)}
        else:
            return {"fit": 0, "status": "stale-or-unavailable", "source_revision": dv_find(model, "source_revision", -1)}

fn v_argument_checks_compute(manifest, trace):
    var events = v_events(trace)
    var findings = []
    var i = 0
    while (i < rt_count(events)):
        var event = events[i]
        var data = events[i].data
        var kind = events[i].type
        if dv_has(dv_pair("model_argument_accepted", "model_argument_unavailable"), kind):
            var before = dv_find(data, "actor_before", [])
            var frozen = v_frozen_actor(trace, event.actor)
            var hypothesis = dv_find(data, "hypothesis", [])
            var status = "insufficient_evidence"
            var reason = "缺少真实本人前快照、已付费模型或完整论证记录"
            var checks = []
            var refs = dv_single(event.id)
            if dv_and((0 < rt_count(before)), dv_and((0 < rt_count(hypothesis)), dv_has_key(data, "result"))):
                var model = v_argument_model(before, hypothesis)
                var coverage = v_argument_factor_coverage(before, hypothesis, v_event_prefix(events, i))
                var slots = dv_find(hypothesis, "claim_slots", [])
                var policy = dv_find(before.policy, "abduction", [])
                var candidates = dv_find(frozen.policy, "hypotheses", [])
                var competitors = []
                var j = 0
                var valid = true
                var expected = []
                var actual = data.result
                var sources = v_argument_sources(trace, event, i)
                var budget = v_reason_budget_before(trace, event, i)
                while (j < rt_count(candidates)):
                    var candidate = candidates[j]
                    if dv_and(v_argument_topic(before, candidate), dv_and((not (candidate.id == hypothesis.id)), dv_and((dv_find(candidate, "group", "") == dv_find(hypothesis, "group", "")), (dv_truth(before.mind, dv_find(candidate, "available_when", dv_true())) == "true")))):
                        if v_argument_factor_covered(candidate, coverage.certificates):
                            false
                        else:
                            rt_push(competitors, v_argument_model(before, candidate))
                    j = (j + 1)
                var certificates = coverage.certificates
                var c = 0
                while (c < rt_count(certificates)):
                    policy = dv_with(policy, "confidence_cap", dv_min(dv_find(policy, "confidence_cap", 0), certificates[c].confidence))
                    c = (c + 1)
                expected = v_argument_factor_result(dv_accept_explanation(before.mind, model, competitors, slots, sources, policy, budget, event.time, event.id), coverage)
                checks = {"argument_replay": dv_same(expected, actual), "all_competitors": dv_same(competitors, dv_find(data, "competitors", false)), "reason_budget": (budget == dv_find(before.policy, "reason_budget", -1)), "hypothesis_binding": dv_same(v_record_without(hypothesis, dv_single("simulation")), v_model_hypothesis(frozen, hypothesis.id))}
                var local_1 = false
                if actual.accepted:
                    local_1 = checks.all_competitors
                else:
                    local_1 = true
                valid = dv_and(checks.argument_replay, dv_and(local_1, dv_and(checks.reason_budget, checks.hypothesis_binding)))
                checks = dv_with(checks, "abduction_policy", dv_same(dv_find(before.policy, "abduction", []), dv_find(frozen.policy, "abduction", [])))
                valid = dv_and(valid, checks.abduction_policy)
                checks = dv_with(checks, "cognitive_before", dv_same(before.mind, v_cognitive_before(trace, event)))
                checks = dv_with(checks, "runtime_policy", v_runtime_policy_valid(trace, event, before.policy))
                valid = dv_and(valid, checks.runtime_policy)
                var certificates = coverage.certificates
                var c = 0
                valid = dv_and(valid, (not v_argument_factor_covered(hypothesis, certificates)))
                while (c < rt_count(certificates)):
                    valid = dv_and(valid, v_model_verified(manifest, trace, certificates[c].event))
                    var roots = certificates[c].source_event_ids
                    var k = 0
                    while (k < rt_count(roots)):
                        var root = v_event(events, roots[k])
                        var local_2 = false
                        if (root.type == "observation"):
                            local_2 = v_observation_verified(trace, root.id)
                        else:
                            if (root.type == "listener_parse"):
                                local_2 = v_reception_verified(trace, root.id)
                            else:
                                local_2 = (root.type == "inference")
                        valid = dv_and(valid, local_2)
                        k = (k + 1)
                    c = (c + 1)
                if actual.accepted:
                    valid = dv_and(valid, dv_and(v_model_verified(manifest, trace, dv_find(model, "event", "")), v_model_cache_matches(trace, model)))
                    j = 0
                    while (j < rt_count(competitors)):
                        var other = competitors[j]
                        valid = dv_and(valid, dv_and(v_model_verified(manifest, trace, dv_find(other, "event", "")), v_model_cache_matches(trace, other)))
                        j = (j + 1)
                    var argument = actual.argument
                    var parents = dv_explanation_merge(dv_append(actual.argument.source_event_ids, dv_find(model, "event", "")), actual.argument.competitor_events)
                    var k = 0
                    while (k < rt_count(parents)):
                        valid = dv_and(valid, v_ancestor(events, event.id, parents[k]))
                        k = (k + 1)
                valid = dv_and(valid, ((kind == "model_argument_accepted") == actual.accepted))
                var local_3 = false
                if valid:
                    if checks.cognitive_before:
                        local_3 = "supported"
                    else:
                        local_3 = "insufficient_evidence"
                else:
                    local_3 = "violated"
                status = local_3
                if (not checks.cognitive_before):
                    var record = v_matching_cognitive_record(trace, event, before.mind, i)
                    if (0 < rt_count(record)):
                        rt_push(refs, record.id)
                var local_4 = false
                if actual.accepted:
                    local_4 = "独立重算可撤回解释采纳：完整真实付费模型、全部同题同组竞争解释、逐槽trace变化与观测源、限定置信度和reason扣费；不是观察或确定真理"
                else:
                    local_4 = "独立重算本次解释采纳被拒绝的实际原因、剩余理由预算及认知未变结果；正确拒绝不冒充完整模型论证成立"
                reason = local_4
                if (status == "insufficient_evidence"):
                    reason = "本人前认知未由本次事件的真实父链提供；相同快照的实际观察记录另列证据，缺少来源父边不能判为已核验"
            rt_push(findings, dv_with(dv_with(v_finding("explanation_argument_provenance", status, reason, refs), "actor", event.actor), "checks", checks))
        i = (i + 1)
    return findings

fn v_argument_checks(manifest, trace):
    if dv_has_key(trace, "judge_argument_findings"):
        return trace.judge_argument_findings
    else:
        return v_argument_checks_compute(manifest, trace)

fn v_argument_verified(manifest, trace, id):
    var findings = v_argument_checks(manifest, trace)
    var i = 0
    var valid = false
    while (i < rt_count(findings)):
        var finding = findings[i]
        if dv_and((finding.evidence_refs[0] == id), (finding.status == "supported")):
            valid = true
        i = (i + 1)
    return valid

fn v_argument_action_answer(action):
    var argument = dv_find(action, "argument", [])
    var requested = dv_find(action, "argument_slots", [])
    var claims = dv_find(dv_find(action, "argument", []), "claims", [])
    var i = 0
    var propositions = []
    var valid = true
    while (i < rt_count(requested)):
        var id = requested[i]
        var j = 0
        var found = false
        while (j < rt_count(claims)):
            var claim = claims[j]
            if (claim.slot_id == id):
                found = true
                rt_push(propositions, dv_fact(claim.ref, claim.value))
            j = (j + 1)
        if found:
            false
        else:
            valid = false
        i = (i + 1)
    return {"valid": dv_and(valid, (0 < rt_count(requested))), "answer": dv_all(propositions)}

fn v_physical_proposition(proposition, bindings, subject):
    var op = proposition.op
    if (op == "constant"):
        return proposition
    else:
        if (op == "not"):
            return dv_not(v_physical_proposition(proposition.item, bindings, subject))
        else:
            if (op == "all"):
                var items = proposition.items
                var i = 0
                var mapped = []
                while (i < rt_count(items)):
                    rt_push(mapped, v_physical_proposition(items[i], bindings, subject))
                    i = (i + 1)
                return dv_all(mapped)
            else:
                var ref = proposition.ref
                var i = 0
                var physical = ""
                while (i < rt_count(bindings)):
                    var binding = bindings[i]
                    if dv_and((binding.subject == subject), (binding.local == ref.object)):
                        physical = binding.physical
                    i = (i + 1)
                if (physical == ""):
                    return {"op": "constant", "value": "unknown"}
                else:
                    return dv_with(proposition, "ref", dv_ref(physical, ref.facet, ref.field))

fn v_cached_argument_verified(trace, id):
    var items = dv_find(trace, "judge_argument_findings", [])
    var i = 0
    var valid = false
    while (i < rt_count(items)):
        var finding = items[i]
        if dv_and((finding.evidence_refs[0] == id), (finding.status == "supported")):
            valid = true
        i = (i + 1)
    return valid

fn v_argument_cell_supported(trace, mind, actor, proposition):
    if dv_has_key(proposition, "ref"):
        var cell = dv_read(mind, proposition.ref)
        var basis = dv_read(mind, proposition.ref).basis
        var i = 0
        var valid = false
        while (i < rt_count(basis)):
            var id = basis[i]
            var event = v_event(v_events(trace), basis[i])
            if dv_and(v_cached_argument_verified(trace, id), (dv_find(event, "actor", "") == actor)):
                var result = event.data.result
                if dv_and(result.accepted, dv_same(cell, dv_read(result.world, proposition.ref))):
                    valid = true
            i = (i + 1)
        return valid
    else:
        return false

fn v_submitted_argument_valid(manifest, trace, submit):
    var action = v_submission_action(submit)
    var argument = dv_find(v_submission_action(submit), "argument", [])
    var mind = submit.data.mind
    var valid = false
    if (0 < rt_count(argument)):
        var id = dv_find(argument, "id", "")
        var source = v_event(v_events(trace), dv_find(argument, "id", ""))
        var inputs = dv_find(argument, "inputs", [])
        var i = 0
        if dv_and(v_argument_verified(manifest, trace, id), dv_and((dv_find(source, "actor", "") == submit.actor), v_ancestor(v_events(trace), submit.id, id))):
            valid = dv_same(v_record_without(argument, dv_list3("question_id", "hypothesis_id", "adoptions")), source.data.result.argument)
            valid = dv_and(valid, dv_same(dv_find(argument, "adoptions", []), mind.adoptions))
            valid = dv_and(valid, (dv_truth(mind, action.answer) == "true"))
            while (i < rt_count(inputs)):
                var input = inputs[i]
                valid = dv_and(valid, dv_same(input.cell, dv_read(mind, input.ref)))
                i = (i + 1)
    return valid

fn v_ready_context(trace, ready):
    var data = ready.data
    var argument = dv_find(ready.data, "argument", [])
    var actor = v_frozen_actor(trace, ready.actor)
    var actions = dv_find(v_frozen_actor(trace, ready.actor), "actions", [])
    var i = 0
    var found = []
    while (i < rt_count(actions)):
        var action = actions[i]
        if dv_and((dv_find(action, "argument_question", "") == v_question(ready)), (0 < rt_count(dv_find(action, "argument_slots", [])))):
            var candidate = dv_with(dv_with(action, "argument", argument), "argument_available", true)
            var replay = v_argument_action_answer(dv_with(action, "argument", argument))
            if replay.valid:
                found = dv_with(candidate, "answer", replay.answer)
        i = (i + 1)
    if (0 < rt_count(found)):
        return dv_with(ready, "data", dv_with(dv_with(dv_with(data, "action", found), "physical", v_authority_before(trace, ready)), "basis_event_ids", dv_find(ready, "parents", [])))
    else:
        return ready

fn v_argument_topic(actor, item):
    var topic = dv_find(item, "question", dv_find(item, "topic", ""))
    var question = v_public_question(actor)
    var bindings = dv_find(actor.policy, "topic_bindings", [])
    var i = 0
    var active = false
    if dv_and((not (question == "")), (topic == question)):
        active = true
    while (i < rt_count(bindings)):
        var binding = bindings[i]
        if dv_and((binding.topic == topic), dv_and((0 < rt_count(dv_find(binding, "basis", []))), dv_and((dv_truth(actor.mind, binding.heard_when) == "true"), (not (dv_truth(actor.mind, binding.completed_when) == "true"))))):
            active = true
        i = (i + 1)
    return active

fn v_argument_factor_coverage(actor, hypothesis, events):
    var candidates = dv_find(actor.policy, "hypotheses", [])
    var catalog = []
    var certificates = dv_find(actor, "factor_certificates", [])
    var verified = []
    var i = 0
    while (i < rt_count(candidates)):
        var candidate = candidates[i]
        if dv_and(v_argument_topic(actor, candidate), (dv_find(candidate, "group", "") == dv_find(hypothesis, "group", ""))):
            rt_push(catalog, candidate)
        i = (i + 1)
    if v_prune_factor_catalog_complete(dv_find(actor.policy, "factor_domains", []), catalog):
        i = 0
        while (i < rt_count(certificates)):
            if v_prune_factor_certificate_current(actor, certificates[i], events):
                rt_push(verified, certificates[i])
            i = (i + 1)
    return {"catalog": catalog, "certificates": verified}

fn v_argument_factor_covered(candidate, certificates):
    var i = 0
    var covered = false
    var assignments = dv_find(candidate, "variable_assignments", [])
    while (i < rt_count(certificates)):
        if v_prune_factor_covers(certificates[i], assignments):
            covered = true
        i = (i + 1)
    return covered

fn v_argument_factor_result(result, coverage):
    var argument = result.argument
    var certificates = coverage.certificates
    var i = 0
    var events = []
    var sources = []
    var inputs = []
    while (i < rt_count(certificates)):
        var certificate = certificates[i]
        var chain = certificates[i].source_chain
        var j = 0
        events = dv_explanation_merge(events, dv_single(certificate.event))
        sources = dv_explanation_merge(sources, certificate.source_event_ids)
        while (j < rt_count(chain)):
            rt_push(inputs, {"ref": chain[j].ref, "cell": chain[j].cell})
            j = (j + 1)
        i = (i + 1)
    argument = dv_with(dv_with(dv_with(dv_with(argument, "factor_coverage", coverage), "competitor_events", dv_explanation_merge(argument.competitor_events, events)), "source_event_ids", dv_explanation_merge(argument.source_event_ids, sources)), "inputs", dv_explanation_merge(argument.inputs, inputs))
    return dv_with(result, "argument", argument)

fn v_sharing_action_shape(declared, action):
    var argument = dv_find(action, "argument", [])
    var requested = dv_find(declared, "argument_slots", [])
    var claims = dv_find(dv_find(action, "argument", []), "claims", [])
    var transmitted = []
    var i = 0
    var materialized = v_argument_action_answer(action)
    var proposal = dv_find(action, "proposal", [])
    while (i < rt_count(requested)):
        var j = 0
        while (j < rt_count(claims)):
            if (requested[i] == claims[j].slot_id):
                rt_push(transmitted, claims[j])
            j = (j + 1)
        i = (i + 1)
    var expected = dv_with(dv_with(dv_with({"argument_id": dv_find(argument, "id", ""), "id": dv_find(argument, "id", ""), "estimated": true, "confidence": dv_find(argument, "confidence", 0)}, "claims", transmitted), "source_event_ids", dv_find(argument, "source_event_ids", [])), "model_event", dv_find(argument, "model_event", ""))
    return dv_and(materialized.valid, dv_and(dv_find(action, "argument_available", false), dv_and(dv_same(expected, dv_without(proposal, "reassessment_sources")), dv_same(action, dv_with(dv_with(dv_with(dv_with(dv_without(declared, "answer"), "speech", dv_with(dv_with(dv_find(declared, "speech", []), "literal_ast", materialized.answer), "proposal", proposal)), "proposal", proposal), "argument", argument), "argument_available", true)))))

fn v_matching_cognitive_record(trace, event, mind, index):
    var events = v_events(trace)
    var i = index
    var found = []
    while dv_and((0 < i), (rt_count(found) == 0)):
        i = (i - 1)
        var prior = events[i]
        var data = events[i].data
        if (prior.actor == event.actor):
            var local_1 = false
            if (prior.type == "inference"):
                local_1 = dv_find(dv_find(data, "receipt", []), "world", [])
            else:
                if (prior.type == "model_argument_accepted"):
                    local_1 = dv_find(dv_find(data, "result", []), "world", [])
                else:
                    local_1 = []
            var candidate = dv_find(data, "mind_after", local_1)
            if dv_and((0 < rt_count(candidate)), dv_same(candidate, mind)):
                found = prior
    return found
