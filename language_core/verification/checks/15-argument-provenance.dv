(defn v_argument_epoch_valid (actor)
  (let (argument (dv_find actor "argument" false))
    (if (rt_eq argument false) false
      (dv_and (dv_same (dv_find argument "adoptions" (rt_list)) (dv_get (dv_get actor "mind") "adoptions"))
        (dv_has_key (dv_find actor "heard_topics" (rt_list)) (dv_get argument "question_id"))))))
(defn v_argument_inputs_current (actor)
  (let (argument (dv_find actor "argument" false) valid true i 0)
    (if (rt_eq argument false) false
      (let (inputs (dv_get argument "inputs"))
        (do (while (rt_lt i (rt_count inputs))
          (let (input (rt_at inputs i))
            (do (if (dv_same (dv_get input "cell") (dv_read (dv_get actor "mind") (dv_get input "ref"))) false
              (let (changes (dv_get argument "changes") j 0 own_transaction false current (dv_read (dv_get actor "mind") (dv_get input "ref")))
                (do (while (rt_lt j (rt_count changes))
                  (let (change (rt_at changes j))
                    (do (if (dv_and (dv_same (dv_get change "ref") (dv_get input "ref"))
                      (dv_and (rt_eq (dv_find current "source" "") "abduction")
                        (dv_and (dv_has (dv_find current "basis" (rt_list)) (dv_get argument "id"))
                          (dv_same (dv_get current "value") (dv_get (dv_get change "after") "value")))))
                      (set own_transaction true) false) (set j (rt_add j 1)))))
                  (if own_transaction false (set valid false))))) (set i (rt_add i 1))))) valid)))))
; Defeasible model arguments are audited separately from observations and literal authority.
(defn v_public_question (actor)
  (if (dv_has_key actor "question_ref")
    (let (cell (dv_read (dv_get actor "mind") (dv_get actor "question_ref"))) (if (dv_uncontested cell) (dv_get cell "value") "")) ""))
(defn v_argument_sources (trace event index)
  (let (events (v_events trace) sources (rt_list) i 0)
    (do (while (rt_lt i index)
      (let (prior (rt_at events i) data (dv_get (rt_at events i) "data"))
        (do (if (rt_eq (dv_get prior "actor") (dv_get event "actor"))
          (if (if (rt_eq (dv_get prior "type") "observation") (v_observation_verified trace (dv_get prior "id"))
            (if (rt_eq (dv_get prior "type") "listener_parse") (v_reception_verified trace (dv_get prior "id")) false))
            (let (observations (dv_get data "observations") j 0)
              (while (rt_lt j (rt_count observations))
                (do (rt_push sources (dv_m2 "event_id" (dv_get prior "id") "observation" (rt_at observations j))) (set j (rt_add j 1))))) false) false)
          (set i (rt_add i 1))))) sources)))
(defn v_reason_budget_before (trace event index)
  (let (events (v_events trace) actor (v_frozen_actor trace (dv_get event "actor")) remaining (dv_find (dv_get (v_frozen_actor trace (dv_get event "actor")) "policy") "reason_budget" 0) i 0)
    (do (while (rt_lt i index)
      (let (prior (rt_at events i) kind (dv_get (rt_at events i) "type"))
        (do (if (rt_eq (dv_get prior "actor") (dv_get event "actor"))
          (if (dv_and (dv_has_key (dv_get prior "data") "proposal") (dv_has_key (dv_get prior "data") "charged_units"))
            (set remaining (rt_sub remaining (dv_find (dv_get prior "data") "charged_units" 0)))
          (if (dv_has (dv_list3 "model_argument_revoked" "model_argument_revocation_pending" "inference_dependencies_invalidated") kind)
            (set remaining (rt_sub remaining (dv_find (dv_get prior "data") "checked" 0)))
          (if (dv_has (dv_pair "inference" "inference_alternative_basis") kind) (set remaining (rt_sub remaining 1))
            (if (dv_has (dv_pair "model_argument_accepted" "model_argument_unavailable") kind)
              (set remaining (rt_sub remaining (dv_find (dv_find (dv_get prior "data") "result" (rt_list)) "expanded" 0))) false)))) false)
          (set i (rt_add i 1))))) remaining)))
(defn v_argument_model (actor hypothesis)
  (let (model (dv_find (dv_find actor "simulations" (rt_list)) (dv_get hypothesis "id") (dv_m2 "fit" 0 "status" "not-simulated")))
    (if (dv_or (rt_eq (dv_find model "source_revision" -1) (dv_get (dv_get actor "mind") "revision"))
      (dv_and (dv_explanation_model_current (dv_get actor "mind") model)
        (dv_same (dv_find model "source_response_models" false) (dv_find actor "response_models" (rt_list)))))
      (dv_with model "validated_by_inputs" true)
      (if (dv_and (v_argument_epoch_valid actor) (v_argument_inputs_current actor))
        (let (argument (dv_get actor "argument"))
          (if (dv_and (rt_eq (dv_find model "source_revision" -1) (dv_get argument "source_revision"))
            (dv_or (rt_eq (dv_find model "event" "") (dv_get argument "model_event"))
              (dv_has (dv_get argument "competitor_events") (dv_find model "event" ""))))
            (dv_with model "validated_by_argument" (dv_get argument "id"))
            (dv_m3 "fit" 0 "status" "stale-or-unavailable" "source_revision" (dv_find model "source_revision" -1))))
        (dv_m3 "fit" 0 "status" "stale-or-unavailable" "source_revision" (dv_find model "source_revision" -1))))))
(defn v_argument_checks_compute (manifest trace)
  (let (events (v_events trace) findings (rt_list) i 0)
    (do (while (rt_lt i (rt_count events))
      (let (event (rt_at events i) data (dv_get (rt_at events i) "data") kind (dv_get (rt_at events i) "type"))
        (do (if (dv_has (dv_pair "model_argument_accepted" "model_argument_unavailable") kind)
          (let (before (dv_find data "actor_before" (rt_list)) frozen (v_frozen_actor trace (dv_get event "actor"))
                hypothesis (dv_find data "hypothesis" (rt_list)) status "insufficient_evidence" reason "缺少真实本人前快照、已付费模型或完整论证记录" checks (rt_list) refs (dv_single (dv_get event "id")))
            (do
              (if (dv_and (rt_lt 0 (rt_count before)) (dv_and (rt_lt 0 (rt_count hypothesis)) (dv_has_key data "result")))
                (let (model (v_argument_model before hypothesis) coverage (v_argument_factor_coverage before hypothesis (v_event_prefix events i)) slots (dv_find hypothesis "claim_slots" (rt_list)) policy (dv_find (dv_get before "policy") "abduction" (rt_list))
                      candidates (dv_find (dv_get frozen "policy") "hypotheses" (rt_list)) competitors (rt_list) j 0 valid true expected (rt_list) actual (dv_get data "result")
                      sources (v_argument_sources trace event i) budget (v_reason_budget_before trace event i))
                  (do
                    (while (rt_lt j (rt_count candidates))
                      (let (candidate (rt_at candidates j))
                        (do (if (dv_and (v_argument_topic before candidate)
                          (dv_and (rt_not (rt_eq (dv_get candidate "id") (dv_get hypothesis "id")))
                            (dv_and (rt_eq (dv_find candidate "group" "") (dv_find hypothesis "group" "")) (rt_eq (dv_truth (dv_get before "mind") (dv_find candidate "available_when" (dv_true))) "true"))))
                          (if (v_argument_factor_covered candidate (dv_get coverage "certificates")) false (rt_push competitors (v_argument_model before candidate))) false) (set j (rt_add j 1)))))
                    (let (certificates (dv_get coverage "certificates") c 0) (while (rt_lt c (rt_count certificates)) (do (set policy (dv_with policy "confidence_cap" (dv_min (dv_find policy "confidence_cap" 0) (dv_get (rt_at certificates c) "confidence")))) (set c (rt_add c 1)))))
                    (set expected (v_argument_factor_result (dv_accept_explanation (dv_get before "mind") model competitors slots sources policy budget (dv_get event "time") (dv_get event "id")) coverage))
                    (set checks (dv_m4 "argument_replay" (dv_same expected actual) "all_competitors" (dv_same competitors (dv_find data "competitors" false))
                      "reason_budget" (rt_eq budget (dv_find (dv_get before "policy") "reason_budget" -1)) "hypothesis_binding" (dv_same (v_record_without hypothesis (dv_single "simulation")) (v_model_hypothesis frozen (dv_get hypothesis "id")))))
                    (set valid (dv_and (dv_get checks "argument_replay") (dv_and (if (dv_get actual "accepted") (dv_get checks "all_competitors") true) (dv_and (dv_get checks "reason_budget") (dv_get checks "hypothesis_binding")))))
                    (set checks (dv_with checks "abduction_policy" (dv_same (dv_find (dv_get before "policy") "abduction" (rt_list)) (dv_find (dv_get frozen "policy") "abduction" (rt_list)))))
                    (set valid (dv_and valid (dv_get checks "abduction_policy")))
                    (set checks (dv_with checks "cognitive_before" (dv_same (dv_get before "mind") (v_cognitive_before trace event))))
                    (set checks (dv_with checks "runtime_policy" (v_runtime_policy_valid trace event (dv_get before "policy"))))
                    (set valid (dv_and valid (dv_get checks "runtime_policy")))
                    (let (certificates (dv_get coverage "certificates") c 0)
                      (do (set valid (dv_and valid (rt_not (v_argument_factor_covered hypothesis certificates))))
                        (while (rt_lt c (rt_count certificates)) (do (set valid (dv_and valid (v_model_verified manifest trace (dv_get (rt_at certificates c) "event"))))                          (let (roots (dv_get (rt_at certificates c) "source_event_ids") k 0)
                            (while (rt_lt k (rt_count roots))
                              (let (root (v_event events (rt_at roots k)))
                                (do (set valid (dv_and valid (if (rt_eq (dv_get root "type") "observation") (v_observation_verified trace (dv_get root "id")) (if (rt_eq (dv_get root "type") "listener_parse") (v_reception_verified trace (dv_get root "id")) (rt_eq (dv_get root "type") "inference"))))) (set k (rt_add k 1)))))) (set c (rt_add c 1))))))
                    (if (dv_get actual "accepted")
                      (do
                        (set valid (dv_and valid (dv_and (v_model_verified manifest trace (dv_find model "event" ""))
                          (v_model_cache_matches trace model))))
                        (set j 0)
                        (while (rt_lt j (rt_count competitors))
                          (let (other (rt_at competitors j))
                            (do (set valid (dv_and valid (dv_and (v_model_verified manifest trace (dv_find other "event" ""))
                              (v_model_cache_matches trace other)))) (set j (rt_add j 1)))))
                        (let (argument (dv_get actual "argument") parents (dv_explanation_merge (dv_append (dv_get (dv_get actual "argument") "source_event_ids") (dv_find model "event" "")) (dv_get (dv_get actual "argument") "competitor_events")) k 0)
                          (do (while (rt_lt k (rt_count parents))
                            (do (set valid (dv_and valid (v_ancestor events (dv_get event "id") (rt_at parents k)))) (set k (rt_add k 1))))))) false)
                    (set valid (dv_and valid (rt_eq (rt_eq kind "model_argument_accepted") (dv_get actual "accepted"))))
                    (set status (if valid (if (dv_get checks "cognitive_before") "supported" "insufficient_evidence") "violated"))
                    (if (rt_not (dv_get checks "cognitive_before"))
                      (let (record (v_matching_cognitive_record trace event (dv_get before "mind") i))
                        (do (if (rt_lt 0 (rt_count record)) (rt_push refs (dv_get record "id")) false)
                          false)) false)
                    (set reason (if (dv_get actual "accepted") "独立重算可撤回解释采纳：完整真实付费模型、全部同题同组竞争解释、逐槽trace变化与观测源、限定置信度和reason扣费；不是观察或确定真理"
                      "独立重算本次解释采纳被拒绝的实际原因、剩余理由预算及认知未变结果；正确拒绝不冒充完整模型论证成立"))
                    (if (rt_eq status "insufficient_evidence")
                      (set reason "本人前认知未由本次事件的真实父链提供；相同快照的实际观察记录另列证据，缺少来源父边不能判为已核验") false))) false)
              (rt_push findings (dv_with (dv_with (v_finding "explanation_argument_provenance" status reason refs) "actor" (dv_get event "actor")) "checks" checks)))) false)
          (set i (rt_add i 1))))) findings)))
(defn v_argument_checks (manifest trace)
  (if (dv_has_key trace "judge_argument_findings") (dv_get trace "judge_argument_findings") (v_argument_checks_compute manifest trace)))
(defn v_argument_verified (manifest trace id)
  (let (findings (v_argument_checks manifest trace) i 0 valid false)
    (do (while (rt_lt i (rt_count findings))
      (let (finding (rt_at findings i))
        (do (if (dv_and (rt_eq (rt_at (dv_get finding "evidence_refs") 0) id) (rt_eq (dv_get finding "status") "supported")) (set valid true) false)
          (set i (rt_add i 1))))) valid)))
(defn v_argument_action_answer (action)
  (let (argument (dv_find action "argument" (rt_list)) requested (dv_find action "argument_slots" (rt_list)) claims (dv_find (dv_find action "argument" (rt_list)) "claims" (rt_list)) i 0 propositions (rt_list) valid true)
    (do (while (rt_lt i (rt_count requested))
      (let (id (rt_at requested i) j 0 found false)
        (do (while (rt_lt j (rt_count claims))
          (let (claim (rt_at claims j))
            (do (if (rt_eq (dv_get claim "slot_id") id) (do (set found true) (rt_push propositions (dv_fact (dv_get claim "ref") (dv_get claim "value")))) false) (set j (rt_add j 1)))))
          (if found false (set valid false)) (set i (rt_add i 1)))))
      (dv_m2 "valid" (dv_and valid (rt_lt 0 (rt_count requested))) "answer" (dv_all propositions)))))
(defn v_physical_proposition (proposition bindings subject)
  (let (op (dv_get proposition "op"))
    (if (rt_eq op "constant") proposition
      (if (rt_eq op "not") (dv_not (v_physical_proposition (dv_get proposition "item") bindings subject))
        (if (rt_eq op "all")
          (let (items (dv_get proposition "items") i 0 mapped (rt_list))
            (do (while (rt_lt i (rt_count items))
              (do (rt_push mapped (v_physical_proposition (rt_at items i) bindings subject)) (set i (rt_add i 1)))) (dv_all mapped)))
          (let (ref (dv_get proposition "ref") i 0 physical "")
            (do (while (rt_lt i (rt_count bindings))
              (let (binding (rt_at bindings i))
                (do (if (dv_and (rt_eq (dv_get binding "subject") subject) (rt_eq (dv_get binding "local") (dv_get ref "object")))
                  (set physical (dv_get binding "physical")) false) (set i (rt_add i 1)))))
              (if (rt_eq physical "") (dv_m2 "op" "constant" "value" "unknown") (dv_with proposition "ref" (dv_ref physical (dv_get ref "facet") (dv_get ref "field")))))))))))

(defn v_cached_argument_verified (trace id)
  (let (items (dv_find trace "judge_argument_findings" (rt_list)) i 0 valid false)
    (do (while (rt_lt i (rt_count items))
      (let (finding (rt_at items i))
        (do (if (dv_and (rt_eq (rt_at (dv_get finding "evidence_refs") 0) id) (rt_eq (dv_get finding "status") "supported")) (set valid true) false) (set i (rt_add i 1))))) valid)))
(defn v_argument_cell_supported (trace mind actor proposition)
  (if (dv_has_key proposition "ref")
    (let (cell (dv_read mind (dv_get proposition "ref")) basis (dv_get (dv_read mind (dv_get proposition "ref")) "basis") i 0 valid false)
      (do (while (rt_lt i (rt_count basis))
        (let (id (rt_at basis i) event (v_event (v_events trace) (rt_at basis i)))
          (do (if (dv_and (v_cached_argument_verified trace id) (rt_eq (dv_find event "actor" "") actor))
            (let (result (dv_get (dv_get event "data") "result"))
              (if (dv_and (dv_get result "accepted") (dv_same cell (dv_read (dv_get result "world") (dv_get proposition "ref")))) (set valid true) false)) false)
            (set i (rt_add i 1))))) valid)) false))
(defn v_submitted_argument_valid (manifest trace submit)
  (let (action (v_submission_action submit) argument (dv_find (v_submission_action submit) "argument" (rt_list)) mind (dv_get (dv_get submit "data") "mind") valid false)
    (do (if (rt_lt 0 (rt_count argument))
      (let (id (dv_find argument "id" "") source (v_event (v_events trace) (dv_find argument "id" "")) inputs (dv_find argument "inputs" (rt_list)) i 0)
        (do (if (dv_and (v_argument_verified manifest trace id) (dv_and (rt_eq (dv_find source "actor" "") (dv_get submit "actor")) (v_ancestor (v_events trace) (dv_get submit "id") id)))
          (do (set valid (dv_same (v_record_without argument (dv_list3 "question_id" "hypothesis_id" "adoptions")) (dv_get (dv_get (dv_get source "data") "result") "argument")))
            (set valid (dv_and valid (dv_same (dv_find argument "adoptions" (rt_list)) (dv_get mind "adoptions"))))
            (set valid (dv_and valid (rt_eq (dv_truth mind (dv_get action "answer")) "true")))
            (while (rt_lt i (rt_count inputs))
              (let (input (rt_at inputs i))
                (do (set valid (dv_and valid (dv_same (dv_get input "cell") (dv_read mind (dv_get input "ref"))))) (set i (rt_add i 1))))) ) false))) false) valid)))

(defn v_ready_context (trace ready)
  (let (data (dv_get ready "data") argument (dv_find (dv_get ready "data") "argument" (rt_list)) actor (v_frozen_actor trace (dv_get ready "actor")) actions (dv_find (v_frozen_actor trace (dv_get ready "actor")) "actions" (rt_list)) i 0 found (rt_list))
    (do (while (rt_lt i (rt_count actions))
      (let (action (rt_at actions i))
        (do (if (dv_and (rt_eq (dv_find action "argument_question" "") (v_question ready)) (rt_lt 0 (rt_count (dv_find action "argument_slots" (rt_list)))))
          (let (candidate (dv_with (dv_with action "argument" argument) "argument_available" true) replay (v_argument_action_answer (dv_with action "argument" argument)))
            (if (dv_get replay "valid") (set found (dv_with candidate "answer" (dv_get replay "answer"))) false)) false) (set i (rt_add i 1)))))
      (if (rt_lt 0 (rt_count found))
        (dv_with ready "data" (dv_with (dv_with (dv_with data "action" found) "physical" (v_authority_before trace ready)) "basis_event_ids" (dv_find ready "parents" (rt_list)))) ready))))
(defn v_argument_topic (actor item)
  (let (topic (dv_find item "question" (dv_find item "topic" "")) question (v_public_question actor)
        bindings (dv_find (dv_get actor "policy") "topic_bindings" (rt_list)) i 0 active false)
    (do (if (dv_and (rt_not (rt_eq question "")) (rt_eq topic question)) (set active true) false)
      (while (rt_lt i (rt_count bindings))
        (let (binding (rt_at bindings i))
          (do (if (dv_and (rt_eq (dv_get binding "topic") topic)
            (dv_and (rt_lt 0 (rt_count (dv_find binding "basis" (rt_list))))
              (dv_and (rt_eq (dv_truth (dv_get actor "mind") (dv_get binding "heard_when")) "true")
                (rt_not (rt_eq (dv_truth (dv_get actor "mind") (dv_get binding "completed_when")) "true")))))
            (set active true) false) (set i (rt_add i 1))))) active)))
(defn v_argument_factor_coverage (actor hypothesis events)
  (let (candidates (dv_find (dv_get actor "policy") "hypotheses" (rt_list)) catalog (rt_list) certificates (dv_find actor "factor_certificates" (rt_list)) verified (rt_list) i 0)
    (do (while (rt_lt i (rt_count candidates))
      (let (candidate (rt_at candidates i))
        (do (if (dv_and (v_argument_topic actor candidate) (rt_eq (dv_find candidate "group" "") (dv_find hypothesis "group" ""))) (rt_push catalog candidate) false) (set i (rt_add i 1)))))
      (if (v_prune_factor_catalog_complete (dv_find (dv_get actor "policy") "factor_domains" (rt_list)) catalog)
        (do (set i 0) (while (rt_lt i (rt_count certificates))
          (do (if (v_prune_factor_certificate_current actor (rt_at certificates i) events) (rt_push verified (rt_at certificates i)) false) (set i (rt_add i 1))))) false)
      (dv_m2 "catalog" catalog "certificates" verified))))
(defn v_argument_factor_covered (candidate certificates)
  (let (i 0 covered false assignments (dv_find candidate "variable_assignments" (rt_list)))
    (do (while (rt_lt i (rt_count certificates))
      (do (if (v_prune_factor_covers (rt_at certificates i) assignments) (set covered true) false) (set i (rt_add i 1)))) covered)))
(defn v_argument_factor_result (result coverage)
  (let (argument (dv_get result "argument") certificates (dv_get coverage "certificates") i 0 events (rt_list) sources (rt_list) inputs (rt_list))
    (do (while (rt_lt i (rt_count certificates))
      (let (certificate (rt_at certificates i) chain (dv_get (rt_at certificates i) "source_chain") j 0)
        (do (set events (dv_explanation_merge events (dv_single (dv_get certificate "event"))))
          (set sources (dv_explanation_merge sources (dv_get certificate "source_event_ids")))
          (while (rt_lt j (rt_count chain))
            (do (rt_push inputs (dv_m2 "ref" (dv_get (rt_at chain j) "ref") "cell" (dv_get (rt_at chain j) "cell"))) (set j (rt_add j 1)))) (set i (rt_add i 1)))))
      (set argument (dv_with (dv_with (dv_with (dv_with argument "factor_coverage" coverage)
        "competitor_events" (dv_explanation_merge (dv_get argument "competitor_events") events))
        "source_event_ids" (dv_explanation_merge (dv_get argument "source_event_ids") sources)) "inputs" (dv_explanation_merge (dv_get argument "inputs") inputs)))
      (dv_with result "argument" argument))))








; Dynamic sharing retains every frozen action field and transmits only requested claims.
(defn v_sharing_action_shape (declared action)
  (let (argument (dv_find action "argument" (rt_list)) requested (dv_find declared "argument_slots" (rt_list))
        claims (dv_find (dv_find action "argument" (rt_list)) "claims" (rt_list)) transmitted (rt_list) i 0
        materialized (v_argument_action_answer action) proposal (dv_find action "proposal" (rt_list)))
    (do (while (rt_lt i (rt_count requested))
      (let (j 0) (do (while (rt_lt j (rt_count claims))
        (do (if (rt_eq (rt_at requested i) (dv_get (rt_at claims j) "slot_id")) (rt_push transmitted (rt_at claims j)) false)
          (set j (rt_add j 1)))) (set i (rt_add i 1)))))
      (let (expected (dv_with (dv_with (dv_with (dv_m4 "argument_id" (dv_find argument "id" "") "id" (dv_find argument "id" "") "estimated" true "confidence" (dv_find argument "confidence" 0))
        "claims" transmitted) "source_event_ids" (dv_find argument "source_event_ids" (rt_list))) "model_event" (dv_find argument "model_event" "")))
        (dv_and (dv_get materialized "valid")
          (dv_and (dv_find action "argument_available" false)
            (dv_and (dv_same expected (dv_without proposal "reassessment_sources"))
              (dv_same action (dv_with (dv_with (dv_with (dv_with (dv_without declared "answer") "speech"
                (dv_with (dv_with (dv_find declared "speech" (rt_list)) "literal_ast" (dv_get materialized "answer")) "proposal" proposal))
                "proposal" proposal) "argument" argument) "argument_available" true)))))))))

(defn v_matching_cognitive_record (trace event mind index)
  (let (events (v_events trace) i index found (rt_list))
    (do (while (dv_and (rt_lt 0 i) (rt_eq (rt_count found) 0))
      (do (set i (rt_sub i 1))
        (let (prior (rt_at events i) data (dv_get (rt_at events i) "data"))
          (if (rt_eq (dv_get prior "actor") (dv_get event "actor"))
            (let (candidate (dv_find data "mind_after"
              (if (rt_eq (dv_get prior "type") "inference") (dv_find (dv_find data "receipt" (rt_list)) "world" (rt_list))
                (if (rt_eq (dv_get prior "type") "model_argument_accepted") (dv_find (dv_find data "result" (rt_list)) "world" (rt_list)) (rt_list)))))
              (if (dv_and (rt_lt 0 (rt_count candidate)) (dv_same candidate mind)) (set found prior) false)) false)))) found)))
