// Private audit replay never appends to the submitted trace.

fn v_proposal_reassess(actor, decision, events, time, parent):
    var rule = dv_find(actor.policy, "proposal_reassessment", false)
    var proposal = decision.proposal
    var interpretations = dv_find(actor, "interpretations", [])
    var remaining = dv_find(actor.policy, "reason_budget", 0)
    var last = dv_find(actor, "last_interpretation_event", "")
    var seen = dv_find(actor, "reassessed_proposals", [])
    var local_1 = false
    if (decision.proposal == false):
        local_1 = ""
    else:
        local_1 = dv_find(decision.proposal, "argument_id", "")
    var proposal_id = local_1
    if dv_and((decision.status == "accepted"), (not dv_has(seen, proposal_id))):
        if (rule == false):
            false
        else:
            if dv_and(dv_find(rule, "enabled", false), (0 < rt_count(dv_find(rule, "basis", [])))):
                var targets = dv_find(rule, "interpretation_ids", [])
                var required = dv_find(rule, "required_slots", [])
                var claims = dv_find(proposal, "claims", [])
                var complete = true
                var i = 0
                if (rt_count(required) == 0):
                    complete = false
                while (i < rt_count(required)):
                    var j = 0
                    var found = false
                    while (j < rt_count(claims)):
                        if (required[i] == claims[j].slot_id):
                            found = true
                        j = (j + 1)
                    if found:
                        false
                    else:
                        complete = false
                    i = (i + 1)
                i = 0
                while (i < rt_count(targets)):
                    var id = targets[i]
                    var old = dv_find(interpretations, targets[i], false)
                    var status = "insufficient-origin"
                    var charged = 0
                    var before = dv_with(dv_with(dv_with(actor, "interpretations", interpretations), "policy", dv_with(actor.policy, "reason_budget", remaining)), "last_interpretation_event", last)
                    if (old == false):
                        status = "no-personal-interpretation"
                    else:
                        var scope = dv_find(old, "scope_check", [])
                        var source = dv_find(old, "source_event", "")
                        if (old.status == "accepted"):
                            false
                        else:
                            status = "no-prior-accepted-interpretation"
                        if dv_and(complete, dv_and((old.status == "accepted"), dv_and(dv_has(dv_find(proposal, "reassessment_sources", []), source), dv_and((dv_find(scope, "literal_scope", "") == dv_find(rule, "source_scope", "")), (dv_find(scope, "interpretation_scope", "") == dv_find(rule, "target_scope", "")))))):
                            if (remaining < 1):
                                status = "reason-budget-exhausted"
                            else:
                                remaining = (remaining - 1)
                                charged = 1
                                var candidate = {"id": id, "utterance_scope": dv_find(scope, "literal_scope", "")}
                                var revised = v_paid_speech_interpret(actor.mind, actor.policy, {"id": id, "utterance_scope": dv_find(scope, "literal_scope", "")}, dv_find(old, "referents", []))
                                if (revised.scope_check.bridge_truth == "unknown"):
                                    status = "withdrawn"
                                    interpretations = dv_with(interpretations, id, dv_with(dv_with(dv_with(old, "status", "withdrawn"), "withdrawal_reason", "paid-scope-bridge-unsupported"), "proposal_event", parent))
                                else:
                                    status = "retained-supported-bridge"
                    var after = dv_with(dv_with(dv_with(actor, "interpretations", interpretations), "policy", dv_with(actor.policy, "reason_budget", remaining)), "last_interpretation_event", rt_cat("e", rt_show(rt_count(events))))
                    var local_2 = false
                    if (status == "withdrawn"):
                        local_2 = "implicature_withdrawn"
                    else:
                        local_2 = "proposal_scope_reassessment"
                    var local_3 = false
                    if (last == ""):
                        var local_4 = false
                        if (old == false):
                            local_4 = ""
                        else:
                            local_4 = dv_find(old, "source_event", "")
                        local_3 = dv_pair(parent, local_4)
                    else:
                        var local_5 = false
                        if (old == false):
                            local_5 = ""
                        else:
                            local_5 = dv_find(old, "source_event", "")
                        local_3 = dv_list3(parent, local_5, last)
                    var local_6 = false
                    if (old == false):
                        local_6 = ""
                    else:
                        local_6 = dv_find(old, "source_event", "")
                    last = v_retract_event(events, local_2, actor.id, time, local_3, dv_with(dv_with(dv_with(dv_with(dv_with(dv_with({"status": status, "actor_before": before, "actor_after": after, "charged_units": charged}, "mind_before", actor.mind), "mind_after", actor.mind), "interpretations_before", dv_find(before, "interpretations", [])), "interpretations_after", interpretations), "source_event", local_6), "proposal", proposal))
                    i = (i + 1)
                seen = dv_append(seen, proposal_id)
    return dv_with(dv_with(dv_with(dv_with(actor, "interpretations", interpretations), "policy", dv_with(actor.policy, "reason_budget", remaining)), "last_interpretation_event", last), "reassessed_proposals", seen)

fn v_proposal_origin_speakers(events, sources):
    var pending = dv_clone(sources)
    var visited = []
    var result = []
    var i = 0
    while (i < rt_count(pending)):
        var id = pending[i]
        var event = v_event(events, pending[i])
        if dv_has(visited, id):
            false
        else:
            rt_push(visited, id)
            if (0 < rt_count(event)):
                var kind = event.type
                var data = event.data
                if (kind == "speech_literal"):
                    result = dv_explanation_merge(result, dv_single(event.actor))
                if (kind == "public_topic_heard"):
                    pending = dv_explanation_merge(pending, dv_find(data, "source_event_ids", []))
                if dv_has(dv_pair("listener_parse", "observation"), kind):
                    var source = dv_find(data, "source_event", "")
                    if dv_and((not (source == "")), dv_has(event.parents, source)):
                        pending = dv_explanation_merge(pending, dv_single(source))
        i = (i + 1)
    return result

fn v_proposal_sources(trace, speech, action, argument):
    var events = v_events(trace)
    var speaker = speech.actor
    var topic = []
    var heard = []
    var result = []
    var i = 0
    var scope = dv_find(action, "reassessment_source_scope", "")
    var topic_index = -1
    var binding = []
    while (i < rt_count(events)):
        var e = events[i]
        var data = events[i].data
        if dv_and((e.actor == speaker), v_event_precedes(events, e, speech)):
            if dv_and((e.type == "public_topic_heard"), (dv_find(data, "topic", "") == dv_find(argument, "question_id", ""))):
                if (rt_count(topic) == 0):
                    topic = data
                    topic_index = i
            if (e.type == "listener_parse"):
                if v_reception_verified(trace, e.id):
                    var old = v_event(events, dv_find(data, "source_event", ""))
                    if dv_and((dv_find(old, "type", "") == "speech_literal"), (not (old.actor == speaker))):
                        heard = dv_with(heard, old.id, {"source_event": old.id, "speaker": old.actor, "scope": dv_find(dv_find(data, "speech", []), "scope", "")})
        i = (i + 1)
    var bindings = dv_find(v_frozen_actor(trace, speaker).policy, "topic_bindings", [])
    var j = 0
    var mind = dv_find(speech.data, "mind_before", [])
    while (j < rt_count(bindings)):
        if (bindings[j].topic == dv_find(argument, "question_id", "")):
            binding = bindings[j]
        j = (j + 1)
    if dv_and((-1 < topic_index), (0 < rt_count(binding))):
        if dv_and(dv_same(binding.heard_when, dv_find(topic, "heard_when", false)), dv_same(v_retract_support_parents(mind, v_model_sim_refs(binding.heard_when), v_event_prefix(events, topic_index), speaker), dv_find(topic, "source_event_ids", []))):
            false
        else:
            topic = []
    else:
        topic = []
    var origins = v_proposal_origin_speakers(events, dv_find(topic, "source_event_ids", []))
    i = 0
    while (i < rt_count(heard)):
        var record = heard[i][1]
        if dv_and((not (scope == "")), dv_and((scope == record.scope), dv_has(origins, record.speaker))):
            result = dv_explanation_merge(result, dv_single(record.source_event))
        i = (i + 1)
    return result

fn v_proposal_sender_valid(trace, speech):
    var origin = v_origin_execution(v_events(trace), speech)
    var valid = false
    if (0 < rt_count(origin)):
        var action = origin.data.action
        var mind = dv_find(speech.data, "mind_before", [])
        var argument = dv_find(origin.data.action, "argument", [])
        if (0 < rt_count(argument)):
            var proof = v_event(v_events(trace), dv_find(argument, "id", ""))
            var inputs = dv_find(argument, "inputs", [])
            var i = 0
            valid = dv_and(v_cached_argument_verified(trace, dv_find(argument, "id", "")), dv_and((dv_find(proof, "actor", "") == speech.actor), v_ancestor(v_events(trace), speech.id, dv_find(argument, "id", ""))))
            valid = dv_and(valid, dv_same(v_record_without(argument, dv_list3("question_id", "hypothesis_id", "adoptions")), dv_find(dv_find(dv_find(proof, "data", []), "result", []), "argument", [])))
            valid = dv_and(valid, dv_same(dv_find(argument, "adoptions", []), mind.adoptions))
            while (i < rt_count(inputs)):
                var input = inputs[i]
                valid = dv_and(valid, dv_same(input.cell, dv_read(mind, input.ref)))
                i = (i + 1)
            valid = dv_and(valid, dv_same(v_proposal_sources(trace, speech, action, argument), dv_find(dv_find(action, "proposal", []), "reassessment_sources", [])))
            valid = dv_and(valid, v_action_frozen(trace, speech.actor, action))
    return valid

fn v_proposal_parse_parent(trace, e):
    var parents = e.parents
    var i = 0
    var found = []
    while (i < rt_count(parents)):
        var candidate = v_event(v_events(trace), parents[i])
        if dv_and((dv_find(candidate, "type", "") == "listener_parse"), (dv_find(candidate, "actor", "") == e.actor)):
            found = candidate
        i = (i + 1)
    return found

fn v_proposal_reassessment_check(trace, e):
    var events = v_events(trace)
    var parse = v_proposal_parse_parent(trace, e)
    var status = "insufficient_evidence"
    var i = 0
    var start = -1
    var current = -1
    var first = []
    var reason = "缺少真实提案采纳、先前本人采纳或付费复核的完整前后记录"
    while (i < rt_count(events)):
        var candidate = events[i]
        if (candidate.id == e.id):
            current = i
        if dv_and(dv_has_key(candidate.data, "proposal"), dv_and(dv_has_key(candidate.data, "charged_units"), dv_and((candidate.actor == e.actor), dv_has(candidate.parents, dv_find(parse, "id", ""))))):
            if (start < 0):
                start = i
                first = candidate
        i = (i + 1)
    if dv_and((-1 < start), dv_and((-1 < current), (0 < rt_count(parse)))):
        var before = dv_find(first.data, "actor_before", [])
        var frozen = v_frozen_actor(trace, e.actor)
        var decision = dv_find(parse.data, "proposal_decision", [])
        var private = v_event_prefix(events, start)
        var expected = []
        var valid = true
        if (rt_count(before) == 0):
            false
        else:
            v_proposal_reassess(before, decision, private, first.time, parse.id)
            if (current < rt_count(private)):
                expected = private[current]
            valid = dv_same(expected, e)
            valid = dv_and(valid, v_runtime_policy_valid(trace, first, before.policy))
            valid = dv_and(valid, (dv_find(before.policy, "reason_budget", -1) == v_reason_budget_before(trace, first, start)))
            valid = dv_and(valid, dv_same(before.mind, parse.data.mind_after))
            var local_1 = false
            if valid:
                local_1 = "supported"
            else:
                local_1 = "violated"
            status = local_1
            reason = "逐步重演本人提案采纳后的付费桥接复核、理由预算及解释前后状态；撤销不写入相反命题"
            if dv_and(v_reception_verified(trace, parse.id), (dv_find(decision, "status", "") == "accepted")):
                false
            else:
                status = "insufficient_evidence"
                reason = "缺少实际接收并由本人策略采纳的提案来源，不能将收到冒充采纳"
            var speech = v_event(events, dv_find(parse.data, "source_event", ""))
            if v_proposal_sender_valid(trace, speech):
                false
            else:
                status = "insufficient_evidence"
                reason = "发送者的当前有效论证或真实旧话语题目来源尚未独立核验"
            i = 0
            while (i < rt_count(dv_find(before, "interpretations", []))):
                var entry = before.interpretations[i]
                if (dv_find(entry[1], "status", "") == "accepted"):
                    if v_prior_interpretation(trace, first, entry[0], entry[1]):
                        false
                    else:
                        status = "insufficient_evidence"
                        reason = "先前解释采纳缺少真实本人事件父边，不能只相信actor_before"
                i = (i + 1)
    var origin = dv_find(dv_find(trace, "configuration", []), "time_origin", [])
    if dv_has_key(origin, "horizon"):
        if (origin.horizon < e.time):
            status = "violated"
            reason = "付费撤销发生在运行起点总游戏预算之外；不能从首答重新计时"
    return dv_with(dv_with(v_finding("proposal_reassessment_provenance", status, reason, dv_pair(e.id, dv_find(parse, "id", false))), "actor", e.actor), "action", dv_find(e.data, "status", "unknown"))

fn v_proposal_withdrawn_gap(e):
    var data = e.data
    var before = dv_find(e.data, "interpretations_before", [])
    var after = dv_find(e.data, "interpretations_after", [])
    var found = false
    var i = 0
    while (i < rt_count(before)):
        var entry = before[i]
        var old = before[i][1]
        if dv_and((dv_find(old, "status", "") == "accepted"), dv_and(dv_find(dv_find(old, "scope_check", []), "gap", false), (dv_find(dv_find(after, entry[0], []), "status", "") == "withdrawn"))):
            found = true
        i = (i + 1)
    return dv_and(found, dv_and((dv_find(data, "status", "") == "withdrawn"), (dv_find(data, "charged_units", 0) == 1)))

fn v_proposal_reception_check(trace, e):
    var data = e.data
    var source = v_event(v_events(trace), dv_find(e.data, "source_event", ""))
    var actor = v_frozen_actor(trace, e.actor)
    var status = "insufficient_evidence"
    var reason = "缺少真实提案话语或本人收闻前后快照"
    if dv_and((0 < rt_count(source)), dv_and(dv_has_key(data, "mind_before"), dv_has_key(data, "mind_after"))):
        var speech = dv_find(source.data, "speech", [])
        var before = data.mind_before
        var policy = actor.policy
        var expected = []
        var after = data.mind_before
        expected = v_paid_speech_proposal_decision(before, policy, speech, dv_find(dv_find(policy, "speaker_trust", []), source.actor, 0.5))
        if (e.type == "proposal_adoption"):
            var parsed = v_language_map(before, speech.literal_ast, dv_find(speech, "referents", []))
            after = dv_update_mind(before, v_paid_speech_received_observations(before, parsed, source.id, source.actor, e.time, expected), before.revision, dv_observation_profile({"perception": 1, "testimony": 1, "recall": 1}, dv_find(policy, "observation_threshold", 0.5))).world
        expected = dv_with(dv_with(dv_with(expected, "source_event", source.id), "mind_before", before), "mind_after", after)
        var local_1 = false
        if dv_same(expected, data):
            local_1 = "supported"
        else:
            local_1 = "violated"
        status = local_1
        reason = "提案收闻回执保持本人认知不变；采纳独立按本人策略重算，拒收不写入事实"
        if dv_and(v_source_delivery(trace, source), dv_and((v_hearing(trace, source, e.actor) == "true"), v_ancestor(v_events(trace), e.id, source.id))):
            false
        else:
            status = "insufficient_evidence"
        if v_proposal_sender_valid(trace, source):
            false
        else:
            status = "insufficient_evidence"
    return dv_with(dv_with(v_finding("proposal_reception_provenance", status, reason, dv_pair(e.id, dv_find(source, "id", false))), "actor", e.actor), "action", e.type)
