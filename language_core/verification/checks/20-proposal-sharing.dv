; Private audit replay never appends to the submitted trace.
(defn v_proposal_reassess (actor decision events time parent)
  (let (rule (dv_find (dv_get actor "policy") "proposal_reassessment" false)
        proposal (dv_get decision "proposal") interpretations (dv_find actor "interpretations" (rt_list))
        remaining (dv_find (dv_get actor "policy") "reason_budget" 0) last (dv_find actor "last_interpretation_event" "")
        seen (dv_find actor "reassessed_proposals" (rt_list)) proposal_id (if (rt_eq (dv_get decision "proposal") false) "" (dv_find (dv_get decision "proposal") "argument_id" "")))
    (do
      (if (dv_and (rt_eq (dv_get decision "status") "accepted") (rt_not (dv_has seen proposal_id)))
        (if (rt_eq rule false) false
          (if (dv_and (dv_find rule "enabled" false) (rt_lt 0 (rt_count (dv_find rule "basis" (rt_list)))))
            (let (targets (dv_find rule "interpretation_ids" (rt_list)) required (dv_find rule "required_slots" (rt_list))
                  claims (dv_find proposal "claims" (rt_list)) complete true i 0)
              (do
                (if (rt_eq (rt_count required) 0) (set complete false) false)
                (while (rt_lt i (rt_count required))
                  (let (j 0 found false)
                    (do (while (rt_lt j (rt_count claims))
                      (do (if (rt_eq (rt_at required i) (dv_get (rt_at claims j) "slot_id")) (set found true) false) (set j (rt_add j 1))))
                      (if found false (set complete false)) (set i (rt_add i 1)))))
                (set i 0)
                (while (rt_lt i (rt_count targets))
                  (let (id (rt_at targets i) old (dv_find interpretations (rt_at targets i) false) status "insufficient-origin" charged 0
                        before (dv_with (dv_with (dv_with actor "interpretations" interpretations) "policy" (dv_with (dv_get actor "policy") "reason_budget" remaining)) "last_interpretation_event" last))
                    (do
                      (if (rt_eq old false) (set status "no-personal-interpretation")
                        (let (scope (dv_find old "scope_check" (rt_list)) source (dv_find old "source_event" ""))
                          (do (if (rt_eq (dv_get old "status") "accepted") false (set status "no-prior-accepted-interpretation"))
                          (if (dv_and complete (dv_and (rt_eq (dv_get old "status") "accepted")
                            (dv_and (dv_has (dv_find proposal "reassessment_sources" (rt_list)) source)
                              (dv_and (rt_eq (dv_find scope "literal_scope" "") (dv_find rule "source_scope" ""))
                                (rt_eq (dv_find scope "interpretation_scope" "") (dv_find rule "target_scope" ""))))))
                            (if (rt_lt remaining 1) (set status "reason-budget-exhausted")
                              (do (set remaining (rt_sub remaining 1)) (set charged 1)
                                (let (candidate (dv_m2 "id" id "utterance_scope" (dv_find scope "literal_scope" ""))
                                      revised (v_paid_speech_interpret (dv_get actor "mind") (dv_get actor "policy")
                                        (dv_m2 "id" id "utterance_scope" (dv_find scope "literal_scope" "")) (dv_find old "referents" (rt_list))))
                                  (if (rt_eq (dv_get (dv_get revised "scope_check") "bridge_truth") "unknown")
                                    (do (set status "withdrawn")
                                      (set interpretations (dv_with interpretations id (dv_with (dv_with (dv_with old "status" "withdrawn") "withdrawal_reason" "paid-scope-bridge-unsupported") "proposal_event" parent))))
                                    (set status "retained-supported-bridge"))))) false))))
                      (let (after (dv_with (dv_with (dv_with actor "interpretations" interpretations) "policy" (dv_with (dv_get actor "policy") "reason_budget" remaining)) "last_interpretation_event" (rt_cat "e" (rt_show (rt_count events)))))
                        (do
                          (set last (v_retract_event events (if (rt_eq status "withdrawn") "implicature_withdrawn" "proposal_scope_reassessment") (dv_get actor "id") time
                            (if (rt_eq last "") (dv_pair parent (if (rt_eq old false) "" (dv_find old "source_event" "")))
                              (dv_list3 parent (if (rt_eq old false) "" (dv_find old "source_event" "")) last))
                            (dv_with (dv_with (dv_with (dv_with (dv_with (dv_with (dv_m4 "status" status "actor_before" before "actor_after" after "charged_units" charged)
                              "mind_before" (dv_get actor "mind")) "mind_after" (dv_get actor "mind"))
                              "interpretations_before" (dv_find before "interpretations" (rt_list))) "interpretations_after" interpretations)
                              "source_event" (if (rt_eq old false) "" (dv_find old "source_event" ""))) "proposal" proposal)))
                          (set i (rt_add i 1)))))))
                (set seen (dv_append seen proposal_id)))) false)) false)
      (dv_with (dv_with (dv_with (dv_with actor "interpretations" interpretations) "policy" (dv_with (dv_get actor "policy") "reason_budget" remaining))
        "last_interpretation_event" last) "reassessed_proposals" seen))))
(defn v_proposal_origin_speakers (events sources)
  (let (pending (dv_clone sources) visited (rt_list) result (rt_list) i 0)
    (do (while (rt_lt i (rt_count pending))
      (let (id (rt_at pending i) event (v_event events (rt_at pending i)))
        (do (if (dv_has visited id) false
          (do (rt_push visited id)
            (if (rt_lt 0 (rt_count event))
              (let (kind (dv_get event "type") data (dv_get event "data"))
                (do (if (rt_eq kind "speech_literal") (set result (dv_explanation_merge result (dv_single (dv_get event "actor")))) false)
                  (if (rt_eq kind "public_topic_heard")
                    (set pending (dv_explanation_merge pending (dv_find data "source_event_ids" (rt_list)))) false)
                  (if (dv_has (dv_pair "listener_parse" "observation") kind)
                    (let (source (dv_find data "source_event" ""))
                      (if (dv_and (rt_not (rt_eq source "")) (dv_has (dv_get event "parents") source))
                        (set pending (dv_explanation_merge pending (dv_single source))) false)) false))) false)))
          (set i (rt_add i 1))))) result)))
(defn v_proposal_sources (trace speech action argument)
  (let (events (v_events trace) speaker (dv_get speech "actor") topic (rt_list) heard (rt_list) result (rt_list) i 0
        scope (dv_find action "reassessment_source_scope" "") topic_index -1 binding (rt_list))
    (do (while (rt_lt i (rt_count events))
      (let (e (rt_at events i) data (dv_get (rt_at events i) "data"))
        (do (if (dv_and (rt_eq (dv_get e "actor") speaker) (v_event_precedes events e speech))
          (do (if (dv_and (rt_eq (dv_get e "type") "public_topic_heard") (rt_eq (dv_find data "topic" "") (dv_find argument "question_id" "")))
            (if (rt_eq (rt_count topic) 0) (do (set topic data) (set topic_index i)) false) false)
            (if (rt_eq (dv_get e "type") "listener_parse")
              (if (v_reception_verified trace (dv_get e "id"))
                (let (old (v_event events (dv_find data "source_event" "")))
                  (if (dv_and (rt_eq (dv_find old "type" "") "speech_literal") (rt_not (rt_eq (dv_get old "actor") speaker)))
                    (set heard (dv_with heard (dv_get old "id") (dv_m3 "source_event" (dv_get old "id") "speaker" (dv_get old "actor") "scope" (dv_find (dv_find data "speech" (rt_list)) "scope" "")))) false)) false) false)) false)
          (set i (rt_add i 1)))))
      (let (bindings (dv_find (dv_get (v_frozen_actor trace speaker) "policy") "topic_bindings" (rt_list)) j 0
            mind (dv_find (dv_get speech "data") "mind_before" (rt_list)))
        (do (while (rt_lt j (rt_count bindings))
          (do (if (rt_eq (dv_get (rt_at bindings j) "topic") (dv_find argument "question_id" "")) (set binding (rt_at bindings j)) false) (set j (rt_add j 1))))
          (if (dv_and (rt_lt -1 topic_index) (rt_lt 0 (rt_count binding)))
            (if (dv_and (dv_same (dv_get binding "heard_when") (dv_find topic "heard_when" false))
              (dv_same (v_retract_support_parents mind (v_model_sim_refs (dv_get binding "heard_when")) (v_event_prefix events topic_index) speaker)
                (dv_find topic "source_event_ids" (rt_list)))) false (set topic (rt_list))) (set topic (rt_list)))))
      (let (origins (v_proposal_origin_speakers events (dv_find topic "source_event_ids" (rt_list))))
        (do (set i 0) (while (rt_lt i (rt_count heard))
          (let (record (rt_at (rt_at heard i) 1))
            (do (if (dv_and (rt_not (rt_eq scope "")) (dv_and (rt_eq scope (dv_get record "scope")) (dv_has origins (dv_get record "speaker"))))
              (set result (dv_explanation_merge result (dv_single (dv_get record "source_event")))) false) (set i (rt_add i 1))))) result)))))
(defn v_proposal_sender_valid (trace speech)
  (let (origin (v_origin_execution (v_events trace) speech) valid false)
    (do (if (rt_lt 0 (rt_count origin))
      (let (action (dv_get (dv_get origin "data") "action") mind (dv_find (dv_get speech "data") "mind_before" (rt_list))
            argument (dv_find (dv_get (dv_get origin "data") "action") "argument" (rt_list)))
        (if (rt_lt 0 (rt_count argument))
          (let (proof (v_event (v_events trace) (dv_find argument "id" "")) inputs (dv_find argument "inputs" (rt_list)) i 0)
            (do (set valid (dv_and (v_cached_argument_verified trace (dv_find argument "id" ""))
              (dv_and (rt_eq (dv_find proof "actor" "") (dv_get speech "actor")) (v_ancestor (v_events trace) (dv_get speech "id") (dv_find argument "id" "")))))
              (set valid (dv_and valid (dv_same (v_record_without argument (dv_list3 "question_id" "hypothesis_id" "adoptions"))
                (dv_find (dv_find (dv_find proof "data" (rt_list)) "result" (rt_list)) "argument" (rt_list)))))
              (set valid (dv_and valid (dv_same (dv_find argument "adoptions" (rt_list)) (dv_get mind "adoptions"))))
              (while (rt_lt i (rt_count inputs))
                (let (input (rt_at inputs i)) (do (set valid (dv_and valid (dv_same (dv_get input "cell") (dv_read mind (dv_get input "ref"))))) (set i (rt_add i 1)))))
              (set valid (dv_and valid (dv_same (v_proposal_sources trace speech action argument)
                (dv_find (dv_find action "proposal" (rt_list)) "reassessment_sources" (rt_list)))))
              (set valid (dv_and valid (v_action_frozen trace (dv_get speech "actor") action))))) false)) false) valid)))
(defn v_proposal_parse_parent (trace e)
  (let (parents (dv_get e "parents") i 0 found (rt_list))
    (do (while (rt_lt i (rt_count parents))
      (let (candidate (v_event (v_events trace) (rt_at parents i)))
        (do (if (dv_and (rt_eq (dv_find candidate "type" "") "listener_parse") (rt_eq (dv_find candidate "actor" "") (dv_get e "actor"))) (set found candidate) false) (set i (rt_add i 1))))) found)))
(defn v_proposal_reassessment_check (trace e)
  (let (events (v_events trace) parse (v_proposal_parse_parent trace e) status "insufficient_evidence" i 0 start -1 current -1 first (rt_list)
        reason "缺少真实提案采纳、先前本人采纳或付费复核的完整前后记录")
    (do (while (rt_lt i (rt_count events))
      (let (candidate (rt_at events i))
        (do (if (rt_eq (dv_get candidate "id") (dv_get e "id")) (set current i) false)
          (if (dv_and (dv_has_key (dv_get candidate "data") "proposal") (dv_and (dv_has_key (dv_get candidate "data") "charged_units")
            (dv_and (rt_eq (dv_get candidate "actor") (dv_get e "actor")) (dv_has (dv_get candidate "parents") (dv_find parse "id" "")))))
            (if (rt_lt start 0) (do (set start i) (set first candidate)) false) false) (set i (rt_add i 1)))))
      (if (dv_and (rt_lt -1 start) (dv_and (rt_lt -1 current) (rt_lt 0 (rt_count parse))))
        (let (before (dv_find (dv_get first "data") "actor_before" (rt_list)) frozen (v_frozen_actor trace (dv_get e "actor"))
              decision (dv_find (dv_get parse "data") "proposal_decision" (rt_list)) private (v_event_prefix events start) expected (rt_list) valid true)
          (do (if (rt_eq (rt_count before) 0) false
            (do (v_proposal_reassess before decision private (dv_get first "time") (dv_get parse "id"))
              (if (rt_lt current (rt_count private)) (set expected (rt_at private current)) false)
              (set valid (dv_same expected e))
              (set valid (dv_and valid (v_runtime_policy_valid trace first (dv_get before "policy"))))
              (set valid (dv_and valid (rt_eq (dv_find (dv_get before "policy") "reason_budget" -1) (v_reason_budget_before trace first start))))
              (set valid (dv_and valid (dv_same (dv_get before "mind") (dv_get (dv_get parse "data") "mind_after"))))
              (set status (if valid "supported" "violated"))
              (set reason "逐步重演本人提案采纳后的付费桥接复核、理由预算及解释前后状态；撤销不写入相反命题")
              (if (dv_and (v_reception_verified trace (dv_get parse "id")) (rt_eq (dv_find decision "status" "") "accepted")) false
                (do (set status "insufficient_evidence") (set reason "缺少实际接收并由本人策略采纳的提案来源，不能将收到冒充采纳")))
              (let (speech (v_event events (dv_find (dv_get parse "data") "source_event" "")))
                (if (v_proposal_sender_valid trace speech) false (do (set status "insufficient_evidence") (set reason "发送者的当前有效论证或真实旧话语题目来源尚未独立核验"))))
              (set i 0)
              (while (rt_lt i (rt_count (dv_find before "interpretations" (rt_list))))
                (let (entry (rt_at (dv_get before "interpretations") i))
                  (do (if (rt_eq (dv_find (rt_at entry 1) "status" "") "accepted")
                    (if (v_prior_interpretation trace first (rt_at entry 0) (rt_at entry 1)) false
                      (do (set status "insufficient_evidence") (set reason "先前解释采纳缺少真实本人事件父边，不能只相信actor_before"))) false) (set i (rt_add i 1))))))))) false)
      (let (origin (dv_find (dv_find trace "configuration" (rt_list)) "time_origin" (rt_list)))
        (if (dv_has_key origin "horizon")
          (if (rt_lt (dv_get origin "horizon") (dv_get e "time"))
            (do (set status "violated") (set reason "付费撤销发生在运行起点总游戏预算之外；不能从首答重新计时")) false) false))
      (dv_with (dv_with (v_finding "proposal_reassessment_provenance" status reason (dv_pair (dv_get e "id") (dv_find parse "id" false))) "actor" (dv_get e "actor")) "action" (dv_find (dv_get e "data") "status" "unknown")))))

(defn v_proposal_withdrawn_gap (e)
  (let (data (dv_get e "data") before (dv_find (dv_get e "data") "interpretations_before" (rt_list))
        after (dv_find (dv_get e "data") "interpretations_after" (rt_list)) found false i 0)
    (do (while (rt_lt i (rt_count before))
      (let (entry (rt_at before i) old (rt_at (rt_at before i) 1))
        (do (if (dv_and (rt_eq (dv_find old "status" "") "accepted")
          (dv_and (dv_find (dv_find old "scope_check" (rt_list)) "gap" false)
            (rt_eq (dv_find (dv_find after (rt_at entry 0) (rt_list)) "status" "") "withdrawn"))) (set found true) false)
          (set i (rt_add i 1)))))
      (dv_and found (dv_and (rt_eq (dv_find data "status" "") "withdrawn") (rt_eq (dv_find data "charged_units" 0) 1))))))

(defn v_proposal_reception_check (trace e)
  (let (data (dv_get e "data") source (v_event (v_events trace) (dv_find (dv_get e "data") "source_event" ""))
        actor (v_frozen_actor trace (dv_get e "actor")) status "insufficient_evidence" reason "缺少真实提案话语或本人收闻前后快照")
    (do (if (dv_and (rt_lt 0 (rt_count source)) (dv_and (dv_has_key data "mind_before") (dv_has_key data "mind_after")))
      (let (speech (dv_find (dv_get source "data") "speech" (rt_list)) before (dv_get data "mind_before")
            policy (dv_get actor "policy") expected (rt_list) after (dv_get data "mind_before"))
        (do (set expected (v_paid_speech_proposal_decision before policy speech
          (dv_find (dv_find policy "speaker_trust" (rt_list)) (dv_get source "actor") 0.5)))
          (if (rt_eq (dv_get e "type") "proposal_adoption")
            (let (parsed (v_language_map before (dv_get speech "literal_ast") (dv_find speech "referents" (rt_list))))
              (set after (dv_get (dv_update_mind before (v_paid_speech_received_observations before parsed (dv_get source "id") (dv_get source "actor") (dv_get e "time") expected)
                (dv_get before "revision") (dv_observation_profile (dv_m3 "perception" 1 "testimony" 1 "recall" 1) (dv_find policy "observation_threshold" 0.5))) "world"))) false)
          (set expected (dv_with (dv_with (dv_with expected "source_event" (dv_get source "id")) "mind_before" before) "mind_after" after))
          (set status (if (dv_same expected data) "supported" "violated"))
          (set reason "提案收闻回执保持本人认知不变；采纳独立按本人策略重算，拒收不写入事实")
          (if (dv_and (v_source_delivery trace source) (dv_and (rt_eq (v_hearing trace source (dv_get e "actor")) "true")
            (v_ancestor (v_events trace) (dv_get e "id") (dv_get source "id")))) false (set status "insufficient_evidence"))
          (if (v_proposal_sender_valid trace source) false (set status "insufficient_evidence")))) false)
      (dv_with (dv_with (v_finding "proposal_reception_provenance" status reason (dv_pair (dv_get e "id") (dv_find source "id" false))) "actor" (dv_get e "actor")) "action" (dv_get e "type")))))
