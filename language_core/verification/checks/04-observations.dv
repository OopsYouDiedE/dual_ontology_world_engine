fn v_execution_origin(events, execution_id):
    var i = 0
    var found = []
    while (i < rt_count(events)):
        var e = events[i]
        var data = dv_find(events[i], "data", [])
        if (e.type == "action_execution"):
            if (dv_find(dv_find(data, "quote", []), "event", "") == execution_id):
                found = e
        i = (i + 1)
    return found

fn v_projection_sources(items, action):
    var result = []
    var i = 0
    while (i < rt_count(items)):
        rt_push(result, dv_with(dv_with(dv_with(items[i], "source", dv_find(action, "observation_source", "perception")), "origin", dv_find(action, "observation_origin", "direct")), "trust", dv_find(action, "observation_trust", 1)))
        i = (i + 1)
    return result

fn v_observations_compute(trace):
    var events = v_events(trace)
    var result = []
    var i = 0
    while (i < rt_count(events)):
        var e = events[i]
        var data = dv_find(events[i], "data", [])
        if (e.type == "observation"):
            var origin = v_execution_origin(events, dv_find(data, "execution_id", ""))
            var status = "insufficient_evidence"
            var reason = "Actual execution origin, authorized grants and immutable mind snapshots required"
            if dv_and((0 < rt_count(origin)), dv_and(dv_has_key(data, "bindings"), dv_and(dv_has_key(data, "grants"), dv_has_key(data, "mind_before")))):
                var execution = origin.data
                var action = dv_find(data, "action", [])
                var derived = []
                derived = dv_perceive(execution.physical_after, data.mind_before, data.bindings, data.grants, data.execution_id, e.time)
                if (e.actor == origin.actor):
                    derived = v_projection_sources(derived, action)
                var local_1 = false
                if dv_and(v_ancestor(events, e.id, origin.id), dv_same(derived, dv_find(data, "observations", []))):
                    local_1 = "supported"
                else:
                    local_1 = "violated"
                status = local_1
                if dv_has_key(data, "mind_after"):
                    var next = dv_update_mind(data.mind_before, derived, data.mind_before.revision, v_actor_observation_profile(trace, e.actor)).world
                    if dv_same(next, data.mind_after):
                        false
                    else:
                        status = "violated"
                else:
                    status = "insufficient_evidence"
                reason = "Recomputed authorized projection and source metadata, then replayed actor-profile observation update against immutable after-mind"
            rt_push(result, v_finding("observation_provenance", status, reason, dv_pair(e.id, dv_find(origin, "id", false))))
        i = (i + 1)
    return result

fn v_observations(trace):
    if dv_has_key(trace, "judge_observation_findings"):
        return trace.judge_observation_findings
    else:
        return v_observations_compute(trace)

fn v_observation_verified(trace, id):
    var findings = v_observations(trace)
    var i = 0
    var valid = false
    while (i < rt_count(findings)):
        var f = findings[i]
        if dv_and(dv_has(f.evidence_refs, id), (f.status == "supported")):
            valid = true
        i = (i + 1)
    return valid

fn v_actor_observation_profile(trace, actor_id):
    var actors = trace.initial.actors
    var i = 0
    var policy = []
    while (i < rt_count(actors)):
        if (actors[i].id == actor_id):
            policy = actors[i].policy
        i = (i + 1)
    return dv_observation_profile(dv_find(policy, "observation_weights", {"perception": 1, "testimony": 1, "recall": 1}), dv_find(policy, "observation_threshold", 0.5))

fn v_prepare_evidence_cache(manifest, trace):
    var cached = []
    var i = 0
    while (i < rt_count(trace)):
        if dv_has(dv_append(dv_list3("judge_observation_findings", "judge_reception_findings", "judge_model_findings"), "judge_argument_findings"), trace[i][0]):
            false
        else:
            rt_push(cached, trace[i])
        i = (i + 1)
    rt_push(cached, dv_pair("judge_observation_findings", v_observations_compute(cached)))
    rt_push(cached, dv_pair("judge_reception_findings", v_receptions_compute(cached)))
    rt_push(cached, dv_pair("judge_model_findings", v_model_checks_compute(manifest, cached)))
    rt_push(cached, dv_pair("judge_argument_findings", v_argument_checks_compute(manifest, cached)))
    return cached
