// Autonomous formal model session. Host geometry and input are outside this model.

fn v_frozen_catalog(manifest, trace):
    return dv_find(manifest, "cost_model", dv_find(dv_find(trace, "configuration", []), "cost_model", []))

fn v_cost_check(manifest, trace, oracle):
    var events = v_events(trace)
    var catalog = v_frozen_catalog(manifest, trace)
    var result = []
    var i = 0
    var used = []
    var duration = dv_find(dv_find(oracle, "limit", []), "maximum_game_minutes", 0)
    while (i < rt_count(events)):
        var e = events[i]
        var data = dv_find(events[i], "data", [])
        if (e.type == "action_execution"):
            var status = "insufficient_evidence"
            var reason = "Frozen action catalog or immutable execution/ledger snapshots absent"
            var action = dv_find(data, "action", [])
            if dv_and(dv_and(dv_has_key(data, "quote"), dv_has_key(data, "ledger_before")), dv_and(dv_and(dv_has_key(data, "ledger_after"), dv_has_key(data, "actual")), dv_and(dv_and(dv_has_key(data, "physical_before"), dv_has_key(data, "physical_after")), dv_and(dv_has_key(data, "receipt"), dv_has_key(catalog, dv_find(action, "kind", "")))))):
                var before = data.ledger_before
                var after = data.ledger_after
                var quote = data.quote
                var actual = data.actual
                var physical_before = data.physical_before
                var physical_after = data.physical_after
                var model = dv_get(catalog, action.kind)
                var dims = dv_list3("time", "computation", "stamina")
                var j = 0
                var valid = true
                var bundle = data.receipt
                var event_id = data.quote.event
                valid = dv_and(valid, dv_same(quote.bounds, {"minimum": model.minimum, "maximum": model.maximum}))
                valid = dv_and(valid, dv_same(actual, model.actual))
                valid = dv_and(valid, v_action_frozen(trace, e.actor, action))
                valid = dv_and(valid, dv_and((quote.ledger == before.id), (quote.revision == before.revision)))
                valid = dv_and(valid, dv_and((quote.world == physical_before.id), (quote.world_revision == physical_before.revision)))
                valid = dv_and(valid, (not dv_has(used, event_id)))
                rt_push(used, event_id)
                valid = dv_and(valid, (not dv_has(before.events, event_id)))
                valid = dv_and(valid, dv_has(after.events, event_id))
                valid = dv_and(valid, (after.revision == (before.revision + 2)))
                valid = dv_and(valid, (physical_after.revision == (physical_before.revision + 1)))
                valid = dv_and(valid, ((dv_find(physical_after, "time", 0) - dv_find(physical_before, "time", 0)) == actual.time))
                valid = dv_and(valid, (bundle.execution.event == event_id))
                valid = dv_and(valid, dv_same(bundle.execution.world, physical_after))
                valid = dv_and(valid, dv_same(bundle.ledger, after))
                valid = dv_and(valid, dv_same(bundle.receipt.state, "reserved"))
                valid = dv_and(valid, dv_same(bundle.receipt.event, event_id))
                valid = dv_and(valid, dv_same(quote.action, dv_find(action, "law", action.id)))
                var legal = (dv_truth(physical_before, dv_find(action, "authority_precondition", action.precondition)) == "true")
                var derived = false
                legal = dv_and(legal, v_authority_speech_allowed(action, physical_before, e.actor))
                var local_1 = false
                if legal:
                    if (dv_find(action, "law", "") == ""):
                        local_1 = dv_action_cost_finish(before, physical_before, quote, actual, "applied")
                    else:
                        local_1 = dv_action_cost_execute(before, physical_before, quote, actual)
                else:
                    local_1 = dv_action_cost_finish(before, physical_before, quote, actual, "rejected")
                derived = local_1
                valid = dv_and(valid, dv_same(derived, bundle))
                while (j < rt_count(dims)):
                    var dim = dims[j]
                    var amount = dv_get(actual, dims[j])
                    valid = dv_and(valid, (not (amount < 0)))
                    valid = dv_and(valid, ((dv_get(before.balances, dim) - amount) == dv_get(after.balances, dim)))
                    valid = dv_and(valid, ((dv_get(before.spent, dim) + amount) == dv_get(after.spent, dim)))
                    valid = dv_and(valid, dv_and((not (amount < dv_get(model.minimum, dim))), (not (dv_get(model.maximum, dim) < amount))))
                    j = (j + 1)
                var stored = dv_find(after.receipts, event_id, [])
                valid = dv_and(valid, (dv_find(stored, "state", "") == "settled"))
                valid = dv_and(valid, dv_same(dv_find(stored, "actual", false), actual))
                valid = dv_and(valid, dv_same(dv_find(stored, "bounds", false), quote.bounds))
                valid = dv_and(valid, dv_same(dv_find(stored, "action", false), quote.action))
                valid = dv_and(valid, dv_same(before.reserved, after.reserved))
                valid = dv_and(valid, (not ((trace.initial.physical.time + duration) < (physical_before.time + model.maximum.time))))
                valid = dv_and(valid, (not ((trace.initial.physical.time + duration) < physical_after.time)))
                var local_2 = false
                if dv_and((0 < duration), (dv_find(dv_find(oracle, "limit", []), "origin", "") == "run_start")):
                    if valid:
                        local_2 = "supported"
                    else:
                        local_2 = "violated"
                else:
                    local_2 = "insufficient_evidence"
                status = local_2
                reason = "依据冻结目录重算报价、授权前提、物理法则真实执行回执与结算；逐维核对余额、预留、耗费、版本和实际游戏钟差"
            rt_push(result, v_finding("action_cost_settlement", status, reason, dv_single(e.id)))
        i = (i + 1)
    return result

fn v_game_budget_check(trace, oracle):
    var origin = dv_find(dv_find(trace, "configuration", []), "time_origin", [])
    var limit = dv_find(oracle, "limit", [])
    var start = trace.initial.physical.time
    var events = v_events(trace)
    var i = 0
    var status = "insufficient_evidence"
    var valid = true
    if dv_and(dv_has_key(limit, "maximum_game_minutes"), dv_and(dv_has_key(origin, "run_start"), dv_and(dv_has_key(origin, "duration_budget"), dv_has_key(origin, "horizon")))):
        valid = dv_and((dv_find(limit, "origin", "") == "run_start"), dv_and((start == origin.run_start), dv_and((origin.duration_budget == limit.maximum_game_minutes), (origin.horizon == (start + limit.maximum_game_minutes)))))
        while (i < rt_count(events)):
            valid = dv_and(valid, dv_and((not (events[i].time < start)), (not (origin.horizon < events[i].time))))
            i = (i + 1)
        valid = dv_and(valid, (not (origin.horizon < trace.final.physical.time)))
        var local_1 = false
        if valid:
            local_1 = "supported"
        else:
            local_1 = "violated"
        status = local_1
    return v_finding("run_start_game_budget", status, "按冻结原生验收预算核对真实运行起点、配置终点、每个事件及正式结束时间；报价和执行另逐事件核验，不从首答重新起算", [])

fn v_authority_speech_allowed(action, physical, subject):
    var contracts = dv_find(physical, "speech_contracts", [])
    var i = 0
    var registered = false
    var allowed = true
    while (i < rt_count(contracts)):
        var contract = contracts[i]
        if (contract.subject == subject):
            registered = true
            var adoption = dv_find(physical.adoptions, contract.law_id, false)
            if (adoption == false):
                allowed = false
            else:
                if dv_and(adoption.active, dv_and((adoption.mode == "enforce"), dv_and((adoption.law.version == contract.version), dv_and(contract.require_literal_truth, (0 < rt_count(contract.basis)))))):
                    false
                else:
                    allowed = false
            if dv_has_key(action, "authority_truth_gate"):
                var gate = action.authority_truth_gate
                if dv_and(dv_find(gate, "required", false), (dv_find(gate, "contract_id", "") == contract.id)):
                    false
                else:
                    allowed = false
            if dv_has_key(action, "speech"):
                if (dv_truth(physical, action.speech.literal_ast) == "true"):
                    false
                else:
                    allowed = false
            else:
                allowed = false
        i = (i + 1)
    if dv_and((not registered), dv_has_key(action, "authority_truth_gate")):
        if dv_find(action.authority_truth_gate, "required", false):
            allowed = false
    return allowed

// ---- Merged source module: 12-supplement-contracts.dv ----
// Each supplementary contract retains its own purpose. Timing is descriptive, never a truth gate.

fn v_status_join(a, b):
    if dv_or((a == "invalid_run"), (b == "invalid_run")):
        return "invalid_run"
    else:
        if dv_or((a == "violated"), (b == "violated")):
            return "violated"
        else:
            if dv_or((a == "insufficient_evidence"), (b == "insufficient_evidence")):
                return "insufficient_evidence"
            else:
                if dv_or((a == "not_observed"), (b == "not_observed")):
                    return "not_observed"
                else:
                    return "supported"

fn v_hard_constraints(report):
    var items = report.findings
    var i = 0
    var status = "supported"
    var refs = []
    var observed = false
    while (i < rt_count(items)):
        var f = items[i]
        var id = items[i].id
        var relevant = false
        relevant = dv_has(dv_list3("run_integrity", "action_cost_settlement", "observation_provenance"), id)
        relevant = dv_or(relevant, dv_has(dv_list3("formal_answer_validity", "speech_reception_boundary", "speaker_prediction_boundary"), id))
        relevant = dv_or(relevant, dv_has(dv_list3("evidence_dependency_identity", "testimony_common_origin", "listener_interpretation"), id))
        relevant = dv_or(relevant, v_extended_provenance_id(id))
        if dv_and((id == "literal_truth"), (dv_find(f, "phase", "") == "utterance")):
            relevant = true
        if relevant:
            observed = true
            status = v_status_join(status, f.status)
            rt_push(refs, f)
        i = (i + 1)
    var local_1 = false
    if observed:
        local_1 = status
    else:
        local_1 = "insufficient_evidence"
    return v_finding("per_event_hard_constraints", local_1, "逐个真实事件核对真话门禁、合法执行、来源、实际听觉、认知更新及正式判定；错误猜测或被拒答本身不当作违反硬语义", refs)

fn v_boundary_findings(configuration, reports):
    var result = []
    var i = 0
    var all_status = "supported"
    var observed = false
    var per_run = []
    all_status = v_actual_isolation_status(configuration, "evidence_boundary", reports)
    while (i < rt_count(reports)):
        var entry = reports[i]
        var report = reports[i].report
        var facts = v_findings_named(reports[i].report, "speech_reception_boundary")
        var hard = v_hard_constraints(reports[i].report)
        var j = 0
        all_status = v_status_join(all_status, hard.status)
        if (0 < rt_count(facts)):
            observed = true
        while (j < rt_count(facts)):
            all_status = v_status_join(all_status, facts[j].status)
            j = (j + 1)
        rt_push(per_run, {"source": entry.source, "reception": facts, "hard_constraints": hard})
        i = (i + 1)
    if observed:
        false
    else:
        if (all_status == "supported"):
            all_status = "not_observed"
    rt_push(result, dv_with(v_finding("evidence_boundary_legality", all_status, "边界变体须精确合法隔离，并独立重算真实交流可闻/未闻、观察到达及共同来源；主叙事未完成不抹掉已发生的边界事实", []), "runs", per_run))
    return result

fn v_parameter_value(configuration, run):
    var target = dv_find(configuration, "target_actor", "")
    var actors = run.trace.initial.actors
    var i = 0
    var value = false
    while (i < rt_count(actors)):
        if (actors[i].id == target):
            value = dv_find(actors[i].policy, "information_weight", false)
        i = (i + 1)
    return value

fn v_parameter_findings(configuration, reports):
    var result = []
    var values = []
    var required = []
    var reserve = dv_find(configuration, "reserve_set", [])
    var i = 0
    var complete = "supported"
    var hard_status = "supported"
    var causal = "supported"
    var per_run = []
    required = dv_find(configuration, "neighborhood", [])
    while (i < rt_count(reserve)):
        required = dv_append(required, reserve[i])
        i = (i + 1)
    if dv_and((0 < rt_count(required)), (0 < rt_count(reserve))):
        false
    else:
        complete = "insufficient_evidence"
    hard_status = v_actual_isolation_status(configuration, "parameter_neighborhood", reports)
    if (v_comparison_contract(configuration, "parameter_neighborhood").status == "supported"):
        if v_variants_frozen(configuration, "parameter_neighborhood", reports):
            false
        else:
            hard_status = "invalid_run"
    else:
        hard_status = v_status_join(hard_status, v_comparison_contract(configuration, "parameter_neighborhood").status)
    i = 0
    while (i < rt_count(reports)):
        var entry = reports[i]
        var run = reports[i].loaded
        var value = v_parameter_value(configuration, reports[i].loaded)
        var hard = v_hard_constraints(reports[i].report)
        var ready = v_last_finding(reports[i].report, "ready_deadline")
        if dv_same(value, false):
            complete = "insufficient_evidence"
        else:
            if dv_has(values, value):
                complete = "invalid_run"
            else:
                rt_push(values, value)
                if dv_has(required, value):
                    false
                else:
                    complete = "invalid_run"
        if (rt_count(v_first(v_events(run.trace), "session_stopped", "")) == 0):
            complete = "insufficient_evidence"
        hard_status = v_status_join(hard_status, hard.status)
        if v_main_causal_supported(entry.report, run.oracle):
            false
        else:
            causal = "insufficient_evidence"
        rt_push(per_run, {"source": entry.source, "parameter": value, "hard_constraints": hard, "scoped_readiness": ready})
        i = (i + 1)
    i = 0
    while (i < rt_count(required)):
        if dv_has(values, required[i]):
            false
        else:
            if (complete == "supported"):
                complete = "not_observed"
        i = (i + 1)
    rt_push(result, dv_with(v_finding("parameter_sample_completeness", complete, "冻结邻域和独立保留集中的每个样本都须有独立完整原始会话；不挑最快样本，不丢未完成/失败样本", []), "observed_parameters", values))
    rt_push(result, dv_with(v_finding("parameter_hard_constraints", v_status_join(complete, hard_status), "逐样本逐事件保持同一真话、因果、来源、输入执行、成本与时间口径；更早ready不是微调合法性的条件", []), "runs", per_run))
    rt_push(result, v_finding("parameter_causal_robustness", v_status_join(v_status_join(complete, hard_status), causal), "所有冻结邻域及保留样本的主因果结果须有真实证据，才支持因果稳健性；各自耗时如实列出，变慢不自动违法", []))
    return result

fn v_supplement_findings(configuration, mode, reports):
    if (mode == "evidence_boundary"):
        return v_boundary_findings(configuration, reports)
    else:
        if (mode == "parameter_neighborhood"):
            return v_parameter_findings(configuration, reports)
        else:
            return []

fn v_actual_isolation_status(configuration, mode, reports):
    var items = v_actual_isolation(configuration, mode, reports)
    var i = 0
    var status = "supported"
    if (rt_count(items) == 0):
        status = "not_observed"
    while (i < rt_count(items)):
        status = v_status_join(status, items[i].status)
        i = (i + 1)
    return status

// ---- Merged source module: 18-paid-speech.dv ----
// Only positive equals atoms support testimony cells. Other ASTs remain speech records.
// A received estimated proposal is a public record before any personal adoption.
// Only an owner's declared policy can authorize its bounded testimony support.
// Speech exposes cue identity only. Conclusions and priors belong to local rules.
// Model reception is hypothetical testimony into a private copied prediction world.
// Neither the model nor its alternatives is sourced from another actor's real mind.
// A complete candidate layer is quoted before any prediction is evaluated.
// Work draws only from the existing total model budget, never replay-work allowance.

fn v_paid_speech_ast_nodes(ast):
    var op = ast.op
    var count = 1
    if (op == "not"):
        count = (count + v_paid_speech_ast_nodes(ast.item))
    else:
        if (op == "all"):
            var items = ast.items
            var i = 0
            while (i < rt_count(items)):
                count = (count + v_paid_speech_ast_nodes(items[i]))
                i = (i + 1)
    return count

fn v_paid_speech_map(mind, proposition, bindings):
    var op = proposition.op
    if (op == "constant"):
        return proposition
    else:
        if (op == "all"):
            var mapped = []
            var i = 0
            var items = proposition.items
            while (i < rt_count(items)):
                rt_push(mapped, v_paid_speech_map(mind, items[i], bindings))
                i = (i + 1)
            return dv_all(mapped)
        else:
            if (op == "not"):
                return dv_not(v_paid_speech_map(mind, proposition.item, bindings))
            else:
                var ref = proposition.ref
                var local = dv_local(bindings, ref.object, mind.subject)
                if (local == ""):
                    if dv_has_key(mind.objects, ref.object):
                        return proposition
                    else:
                        return {"op": "constant", "value": "unknown"}
                else:
                    return dv_with(proposition, "ref", dv_ref(local, ref.facet, ref.field))

fn v_paid_speech_truth(mind, speech):
    return dv_truth(mind, v_paid_speech_map(mind, speech.literal_ast, dv_find(speech, "referents", [])))

fn v_paid_speech_presuppositions(mind, speech):
    var items = dv_find(speech, "presuppositions", [])
    var bindings = dv_find(speech, "referents", [])
    var i = 0
    var result = []
    while (i < rt_count(items)):
        var proposition = v_paid_speech_map(mind, items[i], bindings)
        rt_push(result, {"proposition": proposition, "truth": dv_truth(mind, proposition)})
        i = (i + 1)
    return result

fn v_paid_speech_observations(mind, proposition, source, origin, time, trust):
    var op = proposition.op
    var observations = []
    if (op == "all"):
        var items = proposition.items
        var i = 0
        while (i < rt_count(items)):
            var part = v_paid_speech_observations(mind, items[i], source, origin, time, trust)
            var j = 0
            while (j < rt_count(part)):
                if dv_has(observations, part[j]):
                    false
                else:
                    rt_push(observations, part[j])
                j = (j + 1)
            i = (i + 1)
    else:
        if (op == "equals"):
            var ref = proposition.ref
            rt_push(observations, dv_observation(dv_list3(source, mind.subject, ref), mind.subject, ref, proposition.value, "testimony", origin, time, trust, dv_pair(origin, ref)))
    return observations

fn v_paid_speech_proposal_decision(mind, policy, speech, trust):
    var proposal = dv_find(speech, "proposal", false)
    var status = "ordinary"
    var reason = "ordinary-testimony"
    var confidence = trust
    var units = 0
    var acceptance = dv_find(policy, "proposal_acceptance", false)
    if (proposal == false):
        false
    else:
        var claims = dv_find(proposal, "claims", [])
        var local_1 = false
        if (acceptance == false):
            local_1 = []
        else:
            local_1 = dv_find(acceptance, "required_slots", [])
        var required = local_1
        var propositions = []
        var allowed = true
        var i = 0
        var available = "unknown"
        status = "retained"
        reason = "missing-personal-proposal-policy"
        units = 1
        confidence = dv_min(trust, dv_find(proposal, "confidence", 0))
        while (i < rt_count(claims)):
            var claim = claims[i]
            rt_push(propositions, dv_fact(claim.ref, claim.value))
