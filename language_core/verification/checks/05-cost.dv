(defn v_frozen_catalog (manifest trace)
  (dv_find manifest "cost_model" (dv_find (dv_find trace "configuration" (rt_list)) "cost_model" (rt_list))))
(defn v_cost_check (manifest trace oracle)
  (let (events (v_events trace) catalog (v_frozen_catalog manifest trace) result (rt_list) i 0 used (rt_list) duration (dv_find (dv_find oracle "limit" (rt_list)) "maximum_game_minutes" 0))
    (do (while (rt_lt i (rt_count events))
      (let (e (rt_at events i) data (dv_find (rt_at events i) "data" (rt_list)))
        (do (if (rt_eq (dv_get e "type") "action_execution")
          (let (status "insufficient_evidence" reason "Frozen action catalog or immutable execution/ledger snapshots absent" action (dv_find data "action" (rt_list)))
            (do
              (if (dv_and (dv_and (dv_has_key data "quote") (dv_has_key data "ledger_before"))
                  (dv_and (dv_and (dv_has_key data "ledger_after") (dv_has_key data "actual"))
                    (dv_and (dv_and (dv_has_key data "physical_before") (dv_has_key data "physical_after"))
                      (dv_and (dv_has_key data "receipt") (dv_has_key catalog (dv_find action "kind" ""))))))
                (let (before (dv_get data "ledger_before") after (dv_get data "ledger_after") quote (dv_get data "quote") actual (dv_get data "actual")
                      physical_before (dv_get data "physical_before") physical_after (dv_get data "physical_after")
                      model (dv_get catalog (dv_get action "kind")) dims (dv_list3 "time" "computation" "stamina") j 0 valid true
                      bundle (dv_get data "receipt") event_id (dv_get (dv_get data "quote") "event"))
                  (do
                    (set valid (dv_and valid (dv_same (dv_get quote "bounds") (dv_m2 "minimum" (dv_get model "minimum") "maximum" (dv_get model "maximum")))))
                    (set valid (dv_and valid (dv_same actual (dv_get model "actual")))) (set valid (dv_and valid (v_action_frozen trace (dv_get e "actor") action)))
                    (set valid (dv_and valid (dv_and (rt_eq (dv_get quote "ledger") (dv_get before "id")) (rt_eq (dv_get quote "revision") (dv_get before "revision")))))
                    (set valid (dv_and valid (dv_and (rt_eq (dv_get quote "world") (dv_get physical_before "id")) (rt_eq (dv_get quote "world_revision") (dv_get physical_before "revision")))))
                    (set valid (dv_and valid (rt_not (dv_has used event_id)))) (rt_push used event_id)
                    (set valid (dv_and valid (rt_not (dv_has (dv_get before "events") event_id))))
                    (set valid (dv_and valid (dv_has (dv_get after "events") event_id)))
                    (set valid (dv_and valid (rt_eq (dv_get after "revision") (rt_add (dv_get before "revision") 2))))
                    (set valid (dv_and valid (rt_eq (dv_get physical_after "revision") (rt_add (dv_get physical_before "revision") 1))))
                    (set valid (dv_and valid (rt_eq (rt_sub (dv_find physical_after "time" 0) (dv_find physical_before "time" 0)) (dv_get actual "time"))))
                    (set valid (dv_and valid (rt_eq (dv_get (dv_get bundle "execution") "event") event_id)))
                    (set valid (dv_and valid (dv_same (dv_get (dv_get bundle "execution") "world") physical_after)))
                    (set valid (dv_and valid (dv_same (dv_get bundle "ledger") after)))
                    (set valid (dv_and valid (dv_same (dv_get (dv_get bundle "receipt") "state") "reserved")))
                    (set valid (dv_and valid (dv_same (dv_get (dv_get bundle "receipt") "event") event_id)))
                    (set valid (dv_and valid (dv_same (dv_get quote "action") (dv_find action "law" (dv_get action "id")))))
                    (let (legal (rt_eq (dv_truth physical_before (dv_find action "authority_precondition" (dv_get action "precondition"))) "true") derived false)
                      (do
                        (set legal (dv_and legal (v_authority_speech_allowed action physical_before (dv_get e "actor"))))
                        (set derived (if legal
                          (if (rt_eq (dv_find action "law" "") "") (dv_action_cost_finish before physical_before quote actual "applied")
                            (dv_action_cost_execute before physical_before quote actual))
                          (dv_action_cost_finish before physical_before quote actual "rejected")))
                        (set valid (dv_and valid (dv_same derived bundle)))))
                    (while (rt_lt j (rt_count dims))
                      (let (dim (rt_at dims j) amount (dv_get actual (rt_at dims j)))
                        (do
                          (set valid (dv_and valid (rt_not (rt_lt amount 0))))
                          (set valid (dv_and valid (rt_eq (rt_sub (dv_get (dv_get before "balances") dim) amount) (dv_get (dv_get after "balances") dim))))
                          (set valid (dv_and valid (rt_eq (rt_add (dv_get (dv_get before "spent") dim) amount) (dv_get (dv_get after "spent") dim))))
                          (set valid (dv_and valid (dv_and (rt_not (rt_lt amount (dv_get (dv_get model "minimum") dim))) (rt_not (rt_lt (dv_get (dv_get model "maximum") dim) amount)))))
                          (set j (rt_add j 1)))))
                    (let (stored (dv_find (dv_get after "receipts") event_id (rt_list)))
                      (do (set valid (dv_and valid (rt_eq (dv_find stored "state" "") "settled")))
                        (set valid (dv_and valid (dv_same (dv_find stored "actual" false) actual)))
                        (set valid (dv_and valid (dv_same (dv_find stored "bounds" false) (dv_get quote "bounds"))))
                        (set valid (dv_and valid (dv_same (dv_find stored "action" false) (dv_get quote "action"))))
                        (set valid (dv_and valid (dv_same (dv_get before "reserved") (dv_get after "reserved"))))))
                    (set valid (dv_and valid (rt_not (rt_lt (rt_add (dv_get (dv_get (dv_get trace "initial") "physical") "time") duration) (rt_add (dv_get physical_before "time") (dv_get (dv_get model "maximum") "time"))))))
                    (set valid (dv_and valid (rt_not (rt_lt (rt_add (dv_get (dv_get (dv_get trace "initial") "physical") "time") duration) (dv_get physical_after "time")))))
                    (set status (if (dv_and (rt_lt 0 duration) (rt_eq (dv_find (dv_find oracle "limit" (rt_list)) "origin" "") "run_start")) (if valid "supported" "violated") "insufficient_evidence"))
                    (set reason "依据冻结目录重算报价、授权前提、物理法则真实执行回执与结算；逐维核对余额、预留、耗费、版本和实际游戏钟差"))) false)
              (rt_push result (v_finding "action_cost_settlement" status reason (dv_single (dv_get e "id")))))) false)
          (set i (rt_add i 1))))) result)))


(defn v_game_budget_check (trace oracle)
  (let (origin (dv_find (dv_find trace "configuration" (rt_list)) "time_origin" (rt_list)) limit (dv_find oracle "limit" (rt_list)) start (dv_get (dv_get (dv_get trace "initial") "physical") "time") events (v_events trace) i 0 status "insufficient_evidence" valid true)
    (do (if (dv_and (dv_has_key limit "maximum_game_minutes") (dv_and (dv_has_key origin "run_start") (dv_and (dv_has_key origin "duration_budget") (dv_has_key origin "horizon"))))
      (do (set valid (dv_and (rt_eq (dv_find limit "origin" "") "run_start") (dv_and (rt_eq start (dv_get origin "run_start")) (dv_and (rt_eq (dv_get origin "duration_budget") (dv_get limit "maximum_game_minutes")) (rt_eq (dv_get origin "horizon") (rt_add start (dv_get limit "maximum_game_minutes")))))))
        (while (rt_lt i (rt_count events))
          (do (set valid (dv_and valid (dv_and (rt_not (rt_lt (dv_get (rt_at events i) "time") start)) (rt_not (rt_lt (dv_get origin "horizon") (dv_get (rt_at events i) "time")))))) (set i (rt_add i 1))))
        (set valid (dv_and valid (rt_not (rt_lt (dv_get origin "horizon") (dv_get (dv_get (dv_get trace "final") "physical") "time")))))
        (set status (if valid "supported" "violated"))) false)
      (v_finding "run_start_game_budget" status "按冻结原生验收预算核对真实运行起点、配置终点、每个事件及正式结束时间；报价和执行另逐事件核验，不从首答重新起算" (rt_list)))))


(defn v_authority_speech_allowed (action physical subject)
  (let (contracts (dv_find physical "speech_contracts" (rt_list)) i 0 registered false allowed true)
    (do (while (rt_lt i (rt_count contracts))
      (let (contract (rt_at contracts i))
        (do (if (rt_eq (dv_get contract "subject") subject)
          (do (set registered true)
            (let (adoption (dv_find (dv_get physical "adoptions") (dv_get contract "law_id") false))
              (if (rt_eq adoption false) (set allowed false)
                (if (dv_and (dv_get adoption "active")
                  (dv_and (rt_eq (dv_get adoption "mode") "enforce")
                    (dv_and (rt_eq (dv_get (dv_get adoption "law") "version") (dv_get contract "version"))
                      (dv_and (dv_get contract "require_literal_truth") (rt_lt 0 (rt_count (dv_get contract "basis"))))))) false (set allowed false))))
            (if (dv_has_key action "authority_truth_gate")
              (let (gate (dv_get action "authority_truth_gate"))
                (if (dv_and (dv_find gate "required" false) (rt_eq (dv_find gate "contract_id" "") (dv_get contract "id"))) false (set allowed false))) false)
            (if (dv_has_key action "speech")
              (if (rt_eq (dv_truth physical (dv_get (dv_get action "speech") "literal_ast")) "true") false (set allowed false))
              (set allowed false))) false) (set i (rt_add i 1)))))
      (if (dv_and (rt_not registered) (dv_has_key action "authority_truth_gate"))
        (if (dv_find (dv_get action "authority_truth_gate") "required" false) (set allowed false) false) false) allowed)))
; Autonomous formal model session. Host geometry and input are outside this model.


