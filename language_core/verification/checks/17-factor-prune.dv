// Independent paid coupled-domain source certificate replay.

fn v_prune_factor_proof_result(valid, remaining, confidence, steps, roots):
    return dv_with({"valid": valid, "remaining": remaining, "confidence": confidence, "steps": steps}, "source_events", roots)

fn v_prune_factor_merge(left, right):
    var steps = dv_clone(left.steps)
    var roots = dv_clone(left.source_events)
    var i = 0
    while (i < rt_count(right.steps)):
        rt_push(steps, right.steps[i])
        i = (i + 1)
    i = 0
    while (i < rt_count(right.source_events)):
        if dv_has(roots, right.source_events[i]):
            false
        else:
            rt_push(roots, right.source_events[i])
        i = (i + 1)
    return v_prune_factor_proof_result(dv_and(left.valid, right.valid), right.remaining, dv_min(left.confidence, right.confidence), steps, roots)

fn v_prune_factor_law_allowed(allowed, law):
    var i = 0
    var found = false
    while (i < rt_count(allowed)):
        if dv_and((allowed[i].id == law.name), (allowed[i].version == law.version)):
            found = true
        i = (i + 1)
    return found

fn v_prune_factor_roots(actor, mind, ref, events, cutoff, remaining, allowed):
    var cell = dv_read(mind, ref)
    var result = v_prune_factor_proof_result(false, remaining, 0, [], [])
    var i = 0
    if (not (remaining < 1)):
        result = v_prune_factor_proof_result(false, (remaining - 1), 0, [], [])
        if dv_and(dv_uncontested(cell), dv_and((0 < cell.confidence), dv_and((not dv_find(cell, "estimated", false)), (not (dv_find(cell, "source", "") == "abduction"))))):
            while dv_and((i < cutoff), (not result.valid)):
                var event = events[i]
                if (event.actor == actor.id):
                    var kind = event.type
                    var data = event.data
                    if dv_or((kind == "observation"), (kind == "listener_parse")):
                        if dv_has_key(data, "mind_after"):
                            if dv_same(dv_read(data.mind_after, ref), cell):
                                var observations = dv_find(data, "observations", [])
                                var j = 0
                                var claims = dv_find(cell, "claims", [])
                                var valid = true
                                var confidence = cell.confidence
                                var roots = []
                                var steps = []
                                if (rt_count(claims) == 0):
                                    valid = false
                                while (j < rt_count(claims)):
                                    var claim = claims[j]
                                    var source = claims[j].source
                                    if dv_and(dv_has(observations, claim), dv_and((claim.subject == actor.id), dv_and(dv_same(claim.ref, ref), dv_and(dv_has(data.mind_after.seen, claim.id), dv_or((source == "perception"), dv_or((source == "recall"), (source == "testimony"))))))):
                                        confidence = dv_min(confidence, claim.trust)
                                    else:
                                        valid = false
                                    j = (j + 1)
                                if dv_and(valid, (0 < confidence)):
                                    rt_push(roots, event.id)
                                    rt_push(steps, dv_with({"kind": "observation", "event": event.id, "ref": ref, "cell": cell}, "observations", claims))
                                    result = v_prune_factor_proof_result(true, result.remaining, confidence, steps, roots)
                    if (kind == "inference"):
                        result = v_prune_factor_inference(actor, mind, ref, cell, events, i, data, event, result.remaining, allowed)
                i = (i + 1)
    return result

fn v_prune_factor_refs_proof(actor, mind, refs, events, cutoff, remaining, allowed):
    var result = v_prune_factor_proof_result(true, remaining, 1, [], [])
    var i = 0
    while dv_and(result.valid, (i < rt_count(refs))):
        result = v_prune_factor_merge(result, v_prune_factor_roots(actor, mind, refs[i], events, cutoff, result.remaining, allowed))
        i = (i + 1)
    return result

fn v_prune_factor_inference(actor, mind, ref, cell, events, index, data, event, remaining, allowed):
    var law = data.law
    var before = data.mind_before
    var receipt = data.receipt
    var current = actor.mind.adoptions
    var name = data.law.name
    var result = v_prune_factor_proof_result(false, remaining, 0, [], [])
    var changes = dv_find(data.receipt, "changes", [])
    var i = 0
    var found = false
    while (i < rt_count(changes)):
        if dv_and(dv_same(changes[i].ref, ref), dv_same(changes[i].after, cell)):
            found = true
        i = (i + 1)
    if dv_and(found, dv_and((receipt.status == "applied"), dv_and(v_prune_factor_law_allowed(allowed, law), dv_and(dv_has_key(current, name), dv_has_key(before.adoptions, name))))):
        var adoption = dv_get(current, name)
        if dv_and(dv_same(adoption, dv_get(before.adoptions, name)), dv_and(adoption.active, dv_and((adoption.mode == "infer"), dv_and(dv_same(law, adoption.law), (dv_truth(before, law.premise) == "true"))))):
            if (remaining < 1):
                false
            else:
                var replayed = dv_infer(before, name, receipt.event, receipt.time, before.revision)
                result = v_prune_factor_proof_result(false, (remaining - 1), 0, [], [])
                if dv_and(dv_same(replayed, receipt), dv_same(data.mind_after, receipt.world)):
                    var sources = v_prune_factor_refs_proof(actor, before, v_model_sim_refs(law.premise), events, index, result.remaining, allowed)
                    result = sources
                    if dv_and(sources.valid, (0 < rt_count(sources.source_events))):
                        result = dv_with(dv_with(dv_with(sources, "source_events", dv_append(sources.source_events, event.id)), "confidence", dv_min(cell.confidence, dv_min(adoption.confidence, sources.confidence))), "steps", dv_append(sources.steps, dv_with({"kind": "infer", "event": event.id, "ref": ref, "cell": cell}, "adoption", adoption)))
                    else:
                        result = dv_with(sources, "valid", false)
    return result

fn v_prune_factor_domain(domains, id):
    var i = 0
    var result = false
    while (i < rt_count(domains)):
        if (domains[i].id == id):
            result = domains[i]
        i = (i + 1)
    return result

fn v_prune_factor_schema(domains, constraint):
    var assignments = constraint.assignments
    var scope = constraint.scope
    var versions = constraint.domain_versions
    var ids = []
    var facts = []
    var free = []
    var valid = true
    var i = 0
    var allids = []
    var refs = []
    if dv_or((rt_count(assignments) == 0), (rt_count(dv_find(constraint, "basis", [])) == 0)):
        valid = false
    while (i < rt_count(domains)):
        var domain = domains[i]
        var values = domains[i].values
        var j = 0
        var seen = []
        if dv_or(dv_has(allids, domain.id), dv_has(refs, domain.ref)):
            valid = false
        rt_push(allids, domain.id)
        rt_push(refs, domain.ref)
        if dv_or((rt_count(values) == 0), (not (0 < domain.version))):
            valid = false
        while (j < rt_count(values)):
            if dv_has(seen, values[j]):
                valid = false
            rt_push(seen, values[j])
            j = (j + 1)
        i = (i + 1)
    i = 0
    while (i < rt_count(assignments)):
        var assignment = assignments[i]
        var id = assignments[i].variable
        var domain = v_prune_factor_domain(domains, assignments[i].variable)
        if dv_has(ids, id):
            valid = false
        rt_push(ids, id)
        if (domain == false):
            valid = false
        else:
            if dv_and(dv_has(domain.values, assignment.value), (dv_find(versions, id, -1) == domain.version)):
                false
            else:
                valid = false
            rt_push(facts, dv_fact(domain.ref, assignment.value))
        i = (i + 1)
    if (rt_count(scope) == rt_count(ids)):
        false
    else:
        valid = false
    i = 0
    while (i < rt_count(ids)):
        if dv_has(scope, ids[i]):
            false
        else:
            valid = false
        i = (i + 1)
    i = 0
    while (i < rt_count(scope)):
        if dv_has(ids, scope[i]):
            false
        else:
            valid = false
        i = (i + 1)
    if (rt_count(facts) == 1):
        if dv_same(constraint.condition, facts[0]):
            false
        else:
            valid = false
    else:
        if dv_same(constraint.condition, dv_all(facts)):
            false
        else:
            valid = false
    i = 0
    while (i < rt_count(domains)):
        if dv_has(ids, domains[i].id):
            false
        else:
            rt_push(free, domains[i])
        i = (i + 1)
    return {"valid": valid, "fixed": assignments, "free_domains": free}

fn v_prune_factor_scope_proof(domains, fixed, proof):
    var steps = proof.steps
    var i = 0
    var valid = true
    while (i < rt_count(steps)):
        var step = steps[i]
        var j = 0
        while (j < rt_count(domains)):
            var domain = domains[j]
            var k = 0
            var included = false
            if dv_same(step.ref, domain.ref):
                while (k < rt_count(fixed)):
                    if (fixed[k].variable == domain.id):
                        included = true
                    k = (k + 1)
                if included:
                    false
                else:
                    valid = false
            j = (j + 1)
        i = (i + 1)
    return valid

fn v_prune_factor_covers(certificate, assignments):
    var fixed = certificate.covered_assignments.fixed
    var i = 0
    var valid = true
    while (i < rt_count(fixed)):
        if dv_has(assignments, fixed[i]):
            false
        else:
            valid = false
        i = (i + 1)
    return valid

fn v_prune_factor_paid(actor, events):
    var id = dv_find(actor, "model_paid_event", "")
    var i = 0
    var valid = false
    while (i < rt_count(events)):
        var event = events[i]
        if dv_and((event.id == id), dv_and((event.actor == actor.id), (event.type == "action_execution"))):
            var data = event.data
            if dv_and((data.action.kind == "replay"), dv_and((data.receipt.execution.status == "applied"), (dv_get(data.receipt.ledger.receipts, data.receipt.receipt.event).state == "settled"))):
                valid = true
        i = (i + 1)
    return valid

fn v_prune_factor_prune(actor, events, time, parent):
    var policy = actor.policy
    var mind = actor.mind
    var domains = dv_find(actor.policy, "factor_domains", [])
    var constraints = dv_find(actor.policy, "factor_constraints", [])
    var cap = dv_find(actor.policy, "prune_confidence_limit", 0)
    var remaining = v_model_sim_work_budget(actor)
    var initial = v_model_sim_work_budget(actor)
    var certificates = []
    var rejections = []
    var i = 0
    var result = false
    var paid = v_prune_factor_paid(actor, events)
    while (i < rt_count(constraints)):
        var constraint = constraints[i]
        var reason = "budget-exhausted"
        var start = remaining
        if dv_and(paid, dv_and((0 < cap), (cap < 1))):
            if (remaining < 1):
                false
            else:
                var schema = v_prune_factor_schema(domains, constraint)
                remaining = (remaining - 1)
                reason = "invalid-domain-or-coupled-condition"
                if schema.valid:
                    var condition = dv_truth(mind, constraint.condition)
                    var support = dv_truth(mind, constraint.support)
                    reason = "unknown-or-not-contradicted"
                    if dv_and((condition == "false"), (support == "true")):
                        var refs = v_model_sim_refs(dv_all(dv_pair(constraint.condition, constraint.support)))
                        var proof = v_prune_factor_refs_proof(actor, mind, v_model_sim_refs(dv_all(dv_pair(constraint.condition, constraint.support))), events, rt_count(events), remaining, constraint.infer_laws)
                        remaining = proof.remaining
                        reason = "unproven-or-inadmissible-source"
                        if dv_and(proof.valid, dv_and((0 < rt_count(proof.source_events)), v_prune_factor_scope_proof(domains, schema.fixed, proof))):
                            var certificate = dv_with(dv_with(dv_with(dv_with(dv_with(dv_with(dv_with({"constraint": constraint, "domains": domains, "current_revision": mind.revision, "source_chain": proof.steps}, "source_event_ids", proof.source_events), "covered_assignments", {"fixed": schema.fixed, "free_domains": schema.free_domains}), "confidence", dv_min(cap, proof.confidence)), "estimated", true), "paid_model_event", dv_find(actor, "model_paid_event", "")), "paid_units", (start - remaining)), "results", {"condition": condition, "support": support})
                            rt_push(certificates, certificate)
                            reason = "certified"
        else:
            reason = "unpaid-or-missing-confidence-policy"
        if (reason == "certified"):
            false
        else:
            rt_push(rejections, {"constraint": constraint.id, "reason": reason, "paid_units": (start - remaining)})
        i = (i + 1)
    result = dv_with(dv_with(dv_with({"certificates": certificates, "rejections": rejections, "expanded": (initial - remaining), "remaining": (dv_find(policy, "model_budget", 0) - (initial - remaining))}, "work_remaining", remaining), "current_revision", mind.revision), "actor_before", actor)
    return result

fn v_prune_factor_certificate_parents(certificate, parents):
    var ids = certificate.source_event_ids
    var i = 0
    var valid = true
    while (i < rt_count(ids)):
        if dv_has(parents, ids[i]):
            false
        else:
            valid = false
        i = (i + 1)
    return valid

fn v_prune_factor_certificate_bound(actor, certificate, events):
    var i = 0
    var valid = false
    var bare = dv_without(certificate, "event")
    while (i < rt_count(events)):
        var event = events[i]
        if dv_and((event.id == dv_find(certificate, "event", "")), dv_and((event.actor == actor.id), (event.type == "factor_prune"))):
            var data = event.data
            if dv_and(dv_has(data.certificates, bare), dv_and((data.actor_before.id == actor.id), dv_and((data.actor_before.mind.revision == certificate.current_revision), dv_and((dv_find(data.actor_before, "model_paid_event", "") == certificate.paid_model_event), dv_and(dv_has(event.parents, certificate.paid_model_event), v_prune_factor_certificate_parents(certificate, event.parents)))))):
                valid = true
        i = (i + 1)
    return valid

fn v_prune_factor_certificate_current(actor, certificate, events):
    var mind = actor.mind
    var policy = actor.policy
    var required = dv_list3("constraint", "domains", "source_chain")
    var i = 0
    var valid = true
    required = dv_append(required, "source_event_ids")
    required = dv_append(required, "current_revision")
    required = dv_append(required, "covered_assignments")
    required = dv_append(required, "confidence")
    required = dv_append(required, "estimated")
    required = dv_append(required, "paid_model_event")
    required = dv_append(required, "paid_units")
    required = dv_append(required, "results")
    required = dv_append(required, "event")
    while (i < rt_count(required)):
        if dv_has_key(certificate, required[i]):
            false
        else:
            valid = false
        i = (i + 1)
    if valid:
        var domains = dv_find(policy, "factor_domains", [])
        var constraint = certificate.constraint
        var cap = dv_find(policy, "prune_confidence_limit", 0)
        var units = certificate.paid_units
        if dv_and((mind.revision == certificate.current_revision), dv_and(certificate.estimated, dv_and(dv_same(domains, certificate.domains), dv_and(dv_has(dv_find(policy, "factor_constraints", []), constraint), dv_and((0 < cap), dv_and((cap < 1), dv_and((0 < units), dv_and(v_prune_factor_certificate_bound(actor, certificate, events), v_prune_factor_paid(dv_with(actor, "model_paid_event", certificate.paid_model_event), events))))))))):
            var schema = v_prune_factor_schema(domains, constraint)
            if dv_and(schema.valid, dv_and((dv_truth(mind, constraint.condition) == "false"), (dv_truth(mind, constraint.support) == "true"))):
                var proof = v_prune_factor_refs_proof(actor, mind, v_model_sim_refs(dv_all(dv_pair(constraint.condition, constraint.support))), events, rt_count(events), (units - 1), constraint.infer_laws)
                return dv_and(proof.valid, dv_and((proof.remaining == 0), dv_and((0 < rt_count(proof.source_events)), dv_and(v_prune_factor_scope_proof(domains, schema.fixed, proof), dv_and(dv_same(proof.steps, certificate.source_chain), dv_and(dv_same(proof.source_events, certificate.source_event_ids), dv_and(dv_same(certificate.results, {"condition": "false", "support": "true"}), dv_and(dv_same(certificate.covered_assignments, {"fixed": schema.fixed, "free_domains": schema.free_domains}), (certificate.confidence == dv_min(cap, proof.confidence))))))))))
            else:
                return false
        else:
            return false
    else:
        return false

fn v_prune_factor_assignment_complete(domains, assignments):
    var i = 0
    var valid = dv_and((0 < rt_count(domains)), (rt_count(domains) == rt_count(assignments)))
    var ids = []
    while (i < rt_count(assignments)):
        var item = assignments[i]
        var id = assignments[i].variable
        var domain = v_prune_factor_domain(domains, assignments[i].variable)
        if dv_has(ids, id):
            valid = false
        rt_push(ids, id)
        if (domain == false):
            valid = false
        else:
            if dv_has(domain.values, item.value):
                false
            else:
                valid = false
        i = (i + 1)
    return valid

fn v_prune_factor_assignment_key(domains, assignments):
    var i = 0
    var key = []
    while (i < rt_count(domains)):
        var domain = domains[i]
        var j = 0
        while (j < rt_count(assignments)):
            if (domain.id == assignments[j].variable):
                rt_push(key, {"variable": assignments[j].variable, "value": assignments[j].value})
            j = (j + 1)
        i = (i + 1)
    return key

fn v_prune_factor_catalog_complete(domains, hypotheses):
    var product = 1
    var i = 0
    var ids = []
    var refs = []
    var keys = []
    var valid = (0 < rt_count(domains))
    while (i < rt_count(domains)):
        var domain = domains[i]
        var values = domains[i].values
        var j = 0
        var seen = []
        if dv_or(dv_has(ids, domain.id), dv_has(refs, domain.ref)):
            valid = false
        rt_push(ids, domain.id)
        rt_push(refs, domain.ref)
        if dv_or((rt_count(values) == 0), (not (0 < domain.version))):
            valid = false
        while (j < rt_count(values)):
            if dv_has(seen, values[j]):
                valid = false
            rt_push(seen, values[j])
            j = (j + 1)
        product = (product * rt_count(values))
        i = (i + 1)
    if (product == rt_count(hypotheses)):
        false
    else:
        valid = false
    i = 0
    while (i < rt_count(hypotheses)):
        var assignments = dv_find(hypotheses[i], "variable_assignments", [])
        var key = v_prune_factor_assignment_key(domains, dv_find(hypotheses[i], "variable_assignments", []))
        if v_prune_factor_assignment_complete(domains, assignments):
            false
        else:
            valid = false
        if dv_has(keys, key):
            valid = false
        rt_push(keys, key)
        i = (i + 1)
    return valid
