(defn v_prune_factor_catalog_complete (domains hypotheses)
  (let (product 1 i 0 ids (rt_list) refs (rt_list) keys (rt_list) valid (rt_lt 0 (rt_count domains)))
    (do (while (rt_lt i (rt_count domains))
      (let (domain (rt_at domains i) values (dv_get (rt_at domains i) "values") j 0 seen (rt_list))
