          (while (rt_lt j (rt_count values)) (do (if (dv_has seen (rt_at values j)) (set valid false) false) (rt_push seen (rt_at values j)) (set j (rt_add j 1))))
          (set product (rt_mul product (rt_count values))) (set i (rt_add i 1)))))
