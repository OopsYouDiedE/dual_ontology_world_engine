; Exact initial-state comparison: only one approved actor field or two explicit position values are removed.
(defn v_initial_normalized (configuration mode run)
  (let (trace (dv_get run "trace") manifest (dv_get run "manifest") initial (dv_find (dv_get run "trace") "initial" (rt_list))
        target (dv_find configuration "target_actor" (dv_find (dv_find (dv_get run "manifest") "capability" (rt_list)) "actor" ""))
        actors (dv_find (dv_find (dv_get run "trace") "initial" (rt_list)) "actors" (rt_list)) result (rt_list) i 0 found false status "supported" physical (dv_find (dv_find (dv_get run "trace") "initial" (rt_list)) "physical" (rt_list)))
    (do
      (if (dv_or (rt_eq target "") (rt_eq (rt_count initial) 0)) (set status "insufficient_evidence") false)
      (while (rt_lt i (rt_count actors))
        (let (actor (rt_at actors i))
          (do
            (if (rt_eq (dv_get actor "id") target)
              (do (set found true)
                (if (rt_eq mode "evidence_boundary")
                  (if (dv_and (dv_has_key actor "location_ref") (dv_and (dv_has_key configuration "boundary_mind_ref") (dv_has_key actor "location")))
                    (let (physical_ref (dv_get actor "location_ref") mind_ref (dv_get configuration "boundary_mind_ref") mind (dv_get actor "mind")
                          allowed (dv_find configuration "allowed_position_values" (rt_list)))
                      (do
                        (if (dv_and (dv_same physical_ref (dv_find configuration "boundary_physical_ref" false))
                            (dv_and (rt_eq (dv_get mind_ref "object") target) (dv_has allowed (dv_get actor "location"))))
                          (let (pcell (dv_read physical physical_ref) mcell (dv_read mind mind_ref))
                            (do
                              (if (dv_and (dv_same (dv_get pcell "value") (dv_get actor "location")) (dv_same (dv_get mcell "value") (dv_get actor "location"))) false (set status "invalid_run"))
                              (if (dv_has_key configuration "approved_position_bases")
                                (if (dv_and (dv_has (dv_get configuration "approved_position_bases") (dv_find pcell "basis" false))
                                  (dv_has (dv_get configuration "approved_position_bases") (dv_find mcell "basis" false)))
                                  (do (set pcell (dv_with pcell "basis" "<approved-position-source>")) (set mcell (dv_with mcell "basis" "<approved-position-source>")))
                                  (set status "invalid_run")) false)
                              (set physical (dv_store physical physical_ref (dv_with pcell "value" "<approved-position>")))
                              (set mind (dv_store mind mind_ref (dv_with mcell "value" "<approved-position>")))
                              (set actor (dv_with (dv_with actor "mind" mind) "location" "<approved-position>"))))
                          (set status "invalid_run"))))
                    (set status "insufficient_evidence"))
                  (let (key (if (rt_eq mode "capability") "model_budget" "information_weight") policy (dv_get actor "policy"))
                    (do
                      (if (dv_has_key policy key)
                        (if (rt_eq mode "capability")
                          (if (dv_has (dv_find configuration "allowed_model_budgets" (rt_list)) (dv_get policy key)) false (set status "insufficient_evidence"))
                          (if (dv_has (dv_find configuration "allowed_variants" (rt_list)) (dv_get policy key)) false (set status "invalid_run")))
                        (set status "insufficient_evidence"))
                      (set actor (dv_with actor "policy" (dv_without policy key))))))) false)
            (rt_push result actor) (set i (rt_add i 1)))))
      (if found false (set status "insufficient_evidence"))
      (dv_m2 "status" status "initial" (dv_with (dv_with initial "actors" result) "physical" physical)))))
(defn v_actual_isolation (configuration mode reports)
  (let (findings (rt_list) i 1 baseline (rt_list))
    (do
      (if (rt_lt 0 (rt_count reports)) (set baseline (dv_get (rt_at reports 0) "loaded")) false)
      (while (rt_lt i (rt_count reports))
        (let (variant (dv_get (rt_at reports i) "loaded") base_normal (v_initial_normalized configuration mode baseline)
              next_normal (v_initial_normalized configuration mode (dv_get (rt_at reports i) "loaded")) status "supported" reason "Actual initial records equal after removing only the specifically approved actor field; public laws and cost/formal catalogs unchanged")
          (do
            (if (dv_and (rt_eq (dv_get base_normal "status") "supported") (rt_eq (dv_get next_normal "status") "supported"))
              (if (dv_same (dv_get base_normal "initial") (dv_get next_normal "initial")) false
                (do (set status "invalid_run") (set reason "Actual initial state differs outside the sole approved field or explicit physical/self positioning values")))
              (do (set status (if (dv_or (rt_eq (dv_get base_normal "status") "invalid_run") (rt_eq (dv_get next_normal "status") "invalid_run")) "invalid_run" "insufficient_evidence"))
                (set reason "Exact target actor/path/value authorization or initial record missing; no broad actor mask accepted")))
            (if (dv_and (dv_has_key (dv_find (dv_get baseline "trace") "configuration" (rt_list)) "cost_model")
                (dv_has_key (dv_find (dv_get variant "trace") "configuration" (rt_list)) "cost_model")) false
              (do (set status "insufficient_evidence") (set reason "Actual cost/public/formal configuration absent; manifest label equality cannot establish isolation")))
            (if (dv_same (dv_find (dv_get baseline "trace") "configuration" false) (dv_find (dv_get variant "trace") "configuration" false)) false
              (do (set status "invalid_run") (set reason "Actual frozen public/formal/cost configuration differs, independently of manifest labels")))
            (rt_push findings (v_finding "actual_initial_isolation" status reason (dv_pair (dv_get (dv_get (rt_at reports 0) "source") "trace") (dv_get (dv_get (rt_at reports i) "source") "trace"))))
            (set i (rt_add i 1))))) findings)))
(defn v_actual_isolation_valid (configuration mode reports)
  (let (findings (v_actual_isolation configuration mode reports) i 0 valid (rt_lt 0 (rt_count (v_actual_isolation configuration mode reports))))
    (do (while (rt_lt i (rt_count findings))
      (do (set valid (dv_and valid (rt_eq (dv_get (rt_at findings i) "status") "supported"))) (set i (rt_add i 1)))) valid)))
