// Exact initial-state comparison: only one approved actor field or two explicit position values are removed.

fn v_initial_normalized(configuration, mode, run):
    var trace = run.trace
    var manifest = run.manifest
    var initial = dv_find(run.trace, "initial", [])
    var target = dv_find(configuration, "target_actor", dv_find(dv_find(run.manifest, "capability", []), "actor", ""))
    var actors = dv_find(dv_find(run.trace, "initial", []), "actors", [])
    var result = []
    var i = 0
    var found = false
    var status = "supported"
    var physical = dv_find(dv_find(run.trace, "initial", []), "physical", [])
    if dv_or((target == ""), (rt_count(initial) == 0)):
        status = "insufficient_evidence"
    while (i < rt_count(actors)):
        var actor = actors[i]
        if (actor.id == target):
            found = true
            if (mode == "evidence_boundary"):
                if dv_and(dv_has_key(actor, "location_ref"), dv_and(dv_has_key(configuration, "boundary_mind_ref"), dv_has_key(actor, "location"))):
                    var physical_ref = actor.location_ref
                    var mind_ref = configuration.boundary_mind_ref
                    var mind = actor.mind
                    var allowed = dv_find(configuration, "allowed_position_values", [])
                    if dv_and(dv_same(physical_ref, dv_find(configuration, "boundary_physical_ref", false)), dv_and((mind_ref.object == target), dv_has(allowed, actor.location))):
                        var pcell = dv_read(physical, physical_ref)
                        var mcell = dv_read(mind, mind_ref)
                        if dv_and(dv_same(pcell.value, actor.location), dv_same(mcell.value, actor.location)):
                            false
                        else:
                            status = "invalid_run"
                        if dv_has_key(configuration, "approved_position_bases"):
                            if dv_and(dv_has(configuration.approved_position_bases, dv_find(pcell, "basis", false)), dv_has(configuration.approved_position_bases, dv_find(mcell, "basis", false))):
                                pcell = dv_with(pcell, "basis", "<approved-position-source>")
                                mcell = dv_with(mcell, "basis", "<approved-position-source>")
                            else:
                                status = "invalid_run"
                        physical = dv_store(physical, physical_ref, dv_with(pcell, "value", "<approved-position>"))
                        mind = dv_store(mind, mind_ref, dv_with(mcell, "value", "<approved-position>"))
                        actor = dv_with(dv_with(actor, "mind", mind), "location", "<approved-position>")
                    else:
                        status = "invalid_run"
                else:
                    status = "insufficient_evidence"
            else:
                var local_1 = false
                if (mode == "capability"):
                    local_1 = "model_budget"
                else:
                    local_1 = "information_weight"
                var key = local_1
                var policy = actor.policy
                if dv_has_key(policy, key):
                    if (mode == "capability"):
                        if dv_has(dv_find(configuration, "allowed_model_budgets", []), dv_get(policy, key)):
                            false
                        else:
                            status = "insufficient_evidence"
                    else:
                        if dv_has(dv_find(configuration, "allowed_variants", []), dv_get(policy, key)):
                            false
                        else:
                            status = "invalid_run"
                else:
                    status = "insufficient_evidence"
                actor = dv_with(actor, "policy", dv_without(policy, key))
        rt_push(result, actor)
        i = (i + 1)
    if found:
        false
    else:
        status = "insufficient_evidence"
    return {"status": status, "initial": dv_with(dv_with(initial, "actors", result), "physical", physical)}

fn v_actual_isolation(configuration, mode, reports):
    var findings = []
    var i = 1
    var baseline = []
    if (0 < rt_count(reports)):
        baseline = reports[0].loaded
    while (i < rt_count(reports)):
        var variant = reports[i].loaded
        var base_normal = v_initial_normalized(configuration, mode, baseline)
        var next_normal = v_initial_normalized(configuration, mode, reports[i].loaded)
        var status = "supported"
        var reason = "Actual initial records equal after removing only the specifically approved actor field; public laws and cost/formal catalogs unchanged"
        if dv_and((base_normal.status == "supported"), (next_normal.status == "supported")):
            if dv_same(base_normal.initial, next_normal.initial):
                false
            else:
                status = "invalid_run"
                reason = "Actual initial state differs outside the sole approved field or explicit physical/self positioning values"
        else:
            var local_1 = false
            if dv_or((base_normal.status == "invalid_run"), (next_normal.status == "invalid_run")):
                local_1 = "invalid_run"
            else:
                local_1 = "insufficient_evidence"
            status = local_1
            reason = "Exact target actor/path/value authorization or initial record missing; no broad actor mask accepted"
        if dv_and(dv_has_key(dv_find(baseline.trace, "configuration", []), "cost_model"), dv_has_key(dv_find(variant.trace, "configuration", []), "cost_model")):
            false
        else:
            status = "insufficient_evidence"
            reason = "Actual cost/public/formal configuration absent; manifest label equality cannot establish isolation"
        if dv_same(dv_find(baseline.trace, "configuration", false), dv_find(variant.trace, "configuration", false)):
            false
        else:
            status = "invalid_run"
            reason = "Actual frozen public/formal/cost configuration differs, independently of manifest labels"
        rt_push(findings, v_finding("actual_initial_isolation", status, reason, dv_pair(reports[0].source.trace, reports[i].source.trace)))
        i = (i + 1)
    return findings

fn v_actual_isolation_valid(configuration, mode, reports):
    var findings = v_actual_isolation(configuration, mode, reports)
    var i = 0
    var valid = (0 < rt_count(v_actual_isolation(configuration, mode, reports)))
    while (i < rt_count(findings)):
        valid = dv_and(valid, (findings[i].status == "supported"))
        i = (i + 1)
    return valid
