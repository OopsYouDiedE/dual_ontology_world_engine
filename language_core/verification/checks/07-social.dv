// Pure judge-side interpretation replay from frozen listener policy.
// Model reception is hypothetical testimony into a private copied prediction world.
// Neither the model nor its alternatives is sourced from another actor's real mind.

fn v_parse_candidates(policy, speech):
    var cues = dv_find(speech, "implicature_candidates", [])
    var rules = dv_find(policy, "implicature_bridges", [])
    var result = []
    var ids = []
    var local_ids = []
    var i = 0
    while (i < rt_count(rules)):
        var rule = rules[i]
        var id = rules[i].id
        var required = dv_find(rules[i], "cue", "")
        var j = 0
        var matched = false
        rt_push(local_ids, id)
        if (required == ""):
            matched = true
        while (j < rt_count(cues)):
            if (cues[j].id == required):
                matched = true
            j = (j + 1)
        if matched:
            rt_push(result, {"id": id, "rule_source": dv_find(rule, "basis", []), "utterance_scope": dv_find(speech, "scope", "")})
            rt_push(ids, id)
        i = (i + 1)
    i = 0
    while (i < rt_count(cues)):
        var cue_id = cues[i].id
        if dv_or(dv_has(ids, cue_id), dv_has(local_ids, cue_id)):
            false
        else:
            rt_push(result, {"id": cue_id, "rule_source": [], "utterance_scope": dv_find(speech, "scope", "")})
            rt_push(ids, cue_id)
        i = (i + 1)
    return result

fn v_parse_interpret(mind, policy, candidate, bindings):
    var bridges = dv_find(policy, "implicature_bridges", [])
    var i = 0
    var bridge = false
    var proposition = {"op": "constant", "value": "unknown"}
    var available = dv_true()
    var threshold = dv_find(policy, "implicature_threshold", 0.5)
    var confidence = 0
    var basis = []
    var status = "rejected"
    var missing = "missing-bridge"
    var scope_check = []
    while (i < rt_count(bridges)):
        var item = bridges[i]
        if (item.id == candidate.id):
            dv_require((bridge == false), "Ambiguous interpretation bridge")
            bridge = item
        i = (i + 1)
    if (bridge == false):
        false
    else:
        var premise = v_language_map(mind, bridge.premise, bindings)
        var bridge_basis = dv_find(bridge, "basis", [])
        proposition = v_language_map(mind, bridge.proposition, bindings)
        available = v_language_map(mind, dv_find(bridge, "available_when", dv_true()), bindings)
        confidence = dv_unit(dv_find(bridge, "prior", 0.5))
        basis = bridge_basis
        var literal_scope = dv_find(candidate, "utterance_scope", dv_find(bridge, "source_scope", ""))
        var interpreted_scope = dv_find(bridge, "target_scope", dv_find(bridge, "source_scope", ""))
        var scope_truth = dv_truth(mind, v_language_map(mind, dv_find(bridge, "scope_bridge", {"op": "constant", "value": "unknown"}), bindings))
        scope_check = dv_with({"literal_scope": literal_scope, "interpretation_scope": interpreted_scope, "bridge_truth": scope_truth, "check_enabled": dv_find(policy, "scope_reference_check", false)}, "gap", dv_and((not (literal_scope == interpreted_scope)), (not (scope_truth == "true"))))
        if (dv_truth(mind, v_language_map(mind, dv_find(bridge, "withdraw_when", dv_not(dv_true())), bindings)) == "true"):
            status = "withdrawn"
            missing = "explicit-withdrawal-evidence"
        else:
            if (not (dv_truth(mind, available) == "true")):
                missing = "availability-not-known"
            else:
                if (rt_count(bridge_basis) == 0):
                    missing = "bridge-without-source"
                else:
                    if (not (dv_truth(mind, premise) == "true")):
                        missing = "bridge-premise-not-known"
                    else:
                        if (rt_count(basis) == 0):
                            missing = "candidate-without-source"
                        else:
                            if (dv_truth(mind, proposition) == "false"):
                                missing = "contrary-evidence"
                            else:
                                if (confidence < threshold):
                                    missing = "below-policy-threshold"
                                else:
                                    status = "accepted"
                                    missing = ""
        if dv_and((status == "accepted"), dv_and(scope_check.check_enabled, scope_check.gap)):
            status = "retained"
            missing = "scope-reference-bridge-not-supported"
        basis = dv_append(basis, {"bridge": bridge.id, "basis": bridge_basis})
    return dv_with(dv_with(dv_with(dv_with({"id": candidate.id, "proposition": proposition, "status": status, "confidence": confidence}, "basis", basis), "missing_bridge", missing), "scope_check", scope_check), "kind", "defeasible-interpretation")

fn v_model_interpretations(mind, policy, speech, bindings):
    var candidates = v_parse_candidates(policy, speech)
    var result = []
    var i = 0
    while (i < rt_count(candidates)):
        rt_push(result, v_parse_interpret(mind, policy, candidates[i], bindings))
        i = (i + 1)
    return result

fn v_speaker_model_prediction(model, speech, speaker, source, time):
    var before = dv_clone(model.mind)
    var policy = model.policy
    var bindings = dv_find(speech, "referents", [])
    var parsed = v_language_map(model.mind, speech.literal_ast, dv_find(speech, "referents", []))
    var observations = v_testimony(before, parsed, rt_cat("prediction-", source), speaker, time, dv_find(dv_find(policy, "speaker_trust", []), speaker, 0.5))
    var profile = dv_observation_profile({"perception": 1, "testimony": 1, "recall": 1}, dv_find(policy, "observation_threshold", 0.5))
    var receipt = dv_update_mind(before, observations, before.revision, profile)
    var after = receipt.world
    return dv_with(dv_with(dv_with(dv_with({"model_before": before, "model_after": after, "predicted_literal": parsed, "observations": observations}, "observation_profile", profile), "prediction", v_model_interpretations(after, policy, speech, bindings)), "conditional_prediction", {"scope_reference_check_false": v_model_interpretations(after, dv_with(policy, "scope_reference_check", false), speech, bindings), "scope_reference_check_true": v_model_interpretations(after, dv_with(policy, "scope_reference_check", true), speech, bindings)}), "assumptions", dv_find(model, "assumptions", []))

fn v_prediction_check(trace, e):
    var data = e.data
    var source = v_event(v_events(trace), dv_find(e.data, "source_event", ""))
    var status = "insufficient_evidence"
    var reason = "缺少说话者当时本人模型与真实话语来源"
    if (0 < rt_count(source)):
        var source_data = source.data
        var models = dv_find(dv_find(source.data, "mind_before", []), "listener_models", [])
        var listener = dv_find(data, "listener", "")
        if dv_has_key(models, listener):
            var model = dv_get(models, listener)
            var speech = source_data.speech
            var predicted = []
            var candidates = []
            var i = 0
            var valid = true
            predicted = v_speaker_model_prediction(model, speech, source.actor, source.id, e.time)
            valid = dv_same(model, dv_find(data, "model", false))
            var keys = dv_list3("model_before", "model_after", "predicted_literal")
            var j = 0
            rt_push(keys, "observations")
            rt_push(keys, "observation_profile")
            rt_push(keys, "prediction")
            rt_push(keys, "conditional_prediction")
            rt_push(keys, "assumptions")
            while (j < rt_count(keys)):
                valid = dv_and(valid, dv_same(dv_find(predicted, keys[j], false), dv_find(data, keys[j], false)))
                j = (j + 1)
            valid = dv_and(valid, (0 < rt_count(dv_find(model, "basis", []))))
            valid = dv_and(valid, v_ancestor(v_events(trace), e.id, source.id))
            var local_1 = false
            if valid:
                local_1 = "supported"
            else:
                local_1 = "violated"
            status = local_1
            reason = "预测只依据说话者本人当时持有模型重算，未读取听者实际脑内；缺模型不能冒报确定理解"
            if dv_and(dv_has_key(data, "model_before"), dv_has_key(data, "model_after")):
                false
            else:
                status = "insufficient_evidence"
                reason = "旧预测记录缺模型内实际收闻前后快照，不能把旧schema缺口判为错误理解"
        else:
            var local_2 = false
            if (dv_find(data, "status", "") == "unknown-no-model"):
                local_2 = "supported"
            else:
                local_2 = "violated"
            status = local_2
            reason = "本人无该听者模型，只能保留未知预测，不用事后真实解析替代"
    return dv_with(dv_with(v_finding("speaker_prediction_boundary", status, reason, dv_single(e.id)), "actor", e.actor), "action", "speaker_prediction")

fn v_prior_interpretation(trace, e, id, before_entry):
    var events = v_events(trace)
    var i = 0
    var found = false
    while (i < rt_count(events)):
        var prior = events[i]
        var data = dv_find(events[i], "data", [])
        if dv_and((prior.actor == e.actor), dv_and((prior.type == "implicature"), (dv_find(data, "id", "") == id))):
            if dv_and((dv_find(data, "status", "") == "accepted"), v_ancestor(events, e.id, prior.id)):
                if dv_same(before_entry, dv_find(dv_find(data, "interpretations_after", []), id, false)):
                    found = true
        i = (i + 1)
    return found

fn v_interpretation_check_legacy(trace, e):
    var data = e.data
    var source = v_event(v_events(trace), dv_find(e.data, "source_event", ""))
    var actor = v_frozen_actor(trace, e.actor)
    var status = "insufficient_evidence"
    var reason = "缺少实际话语、本人的解析后快照或解释采纳前后记录"
    var refs = dv_single(e.id)
    if dv_and((0 < rt_count(source)), dv_and((0 < rt_count(actor)), dv_and(dv_has_key(data, "mind_before"), dv_and(dv_has_key(data, "interpretations_before"), dv_has_key(data, "interpretations_after"))))):
        var speech = source.data.speech
        var policy = actor.policy
        var candidates = []
        var candidate = []
        var i = 0
        var expected = []
        var before = data.interpretations_before
        var valid = true
        rt_push(refs, source.id)
        candidates = v_parse_candidates(policy, speech)
        while (i < rt_count(candidates)):
            if (candidates[i].id == data.id):
                candidate = candidates[i]
            i = (i + 1)
        if (rt_count(candidate) == 0):
            status = "violated"
            reason = "采纳了本人冻结策略与真实话语未提供的解释候选"
        else:
            expected = v_paid_speech_interpret(data.mind_before, policy, candidate, dv_find(speech, "referents", []))
            if dv_has_key(data, "calculation_units"):
                false
            else:
                expected = dv_without(expected, "calculation_units")
            expected = dv_with(dv_with(expected, "source_event", source.id), "referents", dv_find(speech, "referents", []))
            if (expected.status == "withdrawn"):
                if (dv_find(dv_find(before, candidate.id, []), "status", "") == "accepted"):
                    false
                else:
                    expected = dv_with(expected, "status", "rejected")
            var keys = dv_list3("proposition", "status", "confidence")
            var j = 0
            rt_push(keys, "basis")
            rt_push(keys, "missing_bridge")
            rt_push(keys, "scope_check")
            rt_push(keys, "kind")
            while (j < rt_count(keys)):
                valid = dv_and(valid, dv_same(dv_find(expected, keys[j], false), dv_find(data, keys[j], false)))
                j = (j + 1)
            valid = dv_and(valid, dv_same(dv_with(before, candidate.id, expected), data.interpretations_after))
            valid = dv_and(valid, dv_same(data.mind_before, dv_find(data, "mind_after", false)))
            valid = dv_and(valid, (v_hearing(trace, source, e.actor) == "true"))
            valid = dv_and(valid, v_ancestor(v_events(trace), e.id, source.id))
            var local_1 = false
            if valid:
                local_1 = "supported"
            else:
                local_1 = "violated"
            status = local_1
            reason = "按听者自己的桥接前提、来源、阈值和撤销条件重算解释；只更新暗示记录，不向事实域写入P或not P"
            if (expected.status == "withdrawn"):
                if v_prior_interpretation(trace, e, candidate.id, dv_get(before, candidate.id)):
                    false
                else:
                    status = "insufficient_evidence"
                    reason = "撤销有本人新依据，但未找到实际先前采纳事件的显式因果前驱，不能只信before自报"
    return dv_with(dv_with(v_finding("listener_interpretation", status, reason, refs), "actor", e.actor), "action", dv_find(data, "status", "unknown"))

fn v_social_check(trace):
    var events = v_events(trace)
    var result = []
    var i = 0
    while (i < rt_count(events)):
        var e = events[i]
        var type = events[i].type
        if dv_or((type == "listener_parse"), (type == "speech_unheard")):
            rt_push(result, v_listener_replay(trace, e))
        if dv_or((type == "listener_parse"), (type == "observation")):
            var extra = v_testimony_dependency(trace, e)
            var j = 0
            while (j < rt_count(extra)):
                rt_push(result, extra[j])
                j = (j + 1)
        if dv_or((type == "proposal_scope_reassessment"), dv_or((type == "implicature"), (type == "implicature_withdrawn"))):
            rt_push(result, v_interpretation_check(trace, e))
        if dv_has(dv_pair("proposal_receipt", "proposal_adoption"), type):
            rt_push(result, v_proposal_reception_check(trace, e))
        if (type == "speech_choice_prediction"):
            rt_push(result, v_paid_prediction_check(trace, e))
        if (type == "speaker_prediction"):
            var local_1 = false
            if dv_has_key(e.data, "paid_forecast"):
                local_1 = v_paid_execution_prediction_check(trace, e)
            else:
                local_1 = v_prediction_check(trace, e)
            rt_push(result, local_1)
        if dv_or((type == "answer_accepted"), (type == "answer_rejected")):
            var submit = v_parent_submission(events, e)
            var local_2 = false
            if (rt_count(submit) == 0):
                local_2 = "insufficient_evidence"
            else:
                local_2 = "supported"
            rt_push(result, dv_with(v_finding("formal_answer_dependency", local_2, "正式回答结果必须直接引用本人的真实提交；不能拿任何先前答题替代本次提交", dv_pair(e.id, dv_find(submit, "id", false))), "actor", e.actor))
        i = (i + 1)
    return result

fn v_interpretation_check(trace, e):
    if dv_and(dv_has_key(e.data, "proposal"), dv_has_key(e.data, "charged_units")):
        return v_proposal_reassessment_check(trace, e)
    else:
        return v_interpretation_check_legacy(trace, e)

// ---- Merged source module: 20-proposal-sharing.dv ----
// Private audit replay never appends to the submitted trace.

fn v_proposal_reassess(actor, decision, events, time, parent):
    var rule = dv_find(actor.policy, "proposal_reassessment", false)
    var proposal = decision.proposal
    var interpretations = dv_find(actor, "interpretations", [])
    var remaining = dv_find(actor.policy, "reason_budget", 0)
    var last = dv_find(actor, "last_interpretation_event", "")
    var seen = dv_find(actor, "reassessed_proposals", [])
    var local_1 = false
    if (decision.proposal == false):
        local_1 = ""
    else:
        local_1 = dv_find(decision.proposal, "argument_id", "")
    var proposal_id = local_1
    if dv_and((decision.status == "accepted"), (not dv_has(seen, proposal_id))):
        if (rule == false):
            false
        else:
            if dv_and(dv_find(rule, "enabled", false), (0 < rt_count(dv_find(rule, "basis", [])))):
                var targets = dv_find(rule, "interpretation_ids", [])
                var required = dv_find(rule, "required_slots", [])
                var claims = dv_find(proposal, "claims", [])
                var complete = true
                var i = 0
                if (rt_count(required) == 0):
                    complete = false
                while (i < rt_count(required)):
                    var j = 0
                    var found = false
                    while (j < rt_count(claims)):
                        if (required[i] == claims[j].slot_id):
                            found = true
                        j = (j + 1)
                    if found:
                        false
                    else:
                        complete = false
                    i = (i + 1)
                i = 0
                while (i < rt_count(targets)):
                    var id = targets[i]
                    var old = dv_find(interpretations, targets[i], false)
                    var status = "insufficient-origin"
                    var charged = 0
                    var before = dv_with(dv_with(dv_with(actor, "interpretations", interpretations), "policy", dv_with(actor.policy, "reason_budget", remaining)), "last_interpretation_event", last)
                    if (old == false):
                        status = "no-personal-interpretation"
                    else:
                        var scope = dv_find(old, "scope_check", [])
                        var source = dv_find(old, "source_event", "")
                        if (old.status == "accepted"):
                            false
                        else:
                            status = "no-prior-accepted-interpretation"
                        if dv_and(complete, dv_and((old.status == "accepted"), dv_and(dv_has(dv_find(proposal, "reassessment_sources", []), source), dv_and((dv_find(scope, "literal_scope", "") == dv_find(rule, "source_scope", "")), (dv_find(scope, "interpretation_scope", "") == dv_find(rule, "target_scope", "")))))):
                            if (remaining < 1):
                                status = "reason-budget-exhausted"
                            else:
                                remaining = (remaining - 1)
                                charged = 1
                                var candidate = {"id": id, "utterance_scope": dv_find(scope, "literal_scope", "")}
                                var revised = v_paid_speech_interpret(actor.mind, actor.policy, {"id": id, "utterance_scope": dv_find(scope, "literal_scope", "")}, dv_find(old, "referents", []))
                                if (revised.scope_check.bridge_truth == "unknown"):
                                    status = "withdrawn"
                                    interpretations = dv_with(interpretations, id, dv_with(dv_with(dv_with(old, "status", "withdrawn"), "withdrawal_reason", "paid-scope-bridge-unsupported"), "proposal_event", parent))
                                else:
                                    status = "retained-supported-bridge"
                    var after = dv_with(dv_with(dv_with(actor, "interpretations", interpretations), "policy", dv_with(actor.policy, "reason_budget", remaining)), "last_interpretation_event", rt_cat("e", rt_show(rt_count(events))))
                    var local_2 = false
                    if (status == "withdrawn"):
                        local_2 = "implicature_withdrawn"
                    else:
                        local_2 = "proposal_scope_reassessment"
                    var local_3 = false
                    if (last == ""):
                        var local_4 = false
                        if (old == false):
                            local_4 = ""
                        else:
                            local_4 = dv_find(old, "source_event", "")
                        local_3 = dv_pair(parent, local_4)
                    else:
                        var local_5 = false
                        if (old == false):
                            local_5 = ""
                        else:
                            local_5 = dv_find(old, "source_event", "")
                        local_3 = dv_list3(parent, local_5, last)
                    var local_6 = false
                    if (old == false):
                        local_6 = ""
                    else:
                        local_6 = dv_find(old, "source_event", "")
                    last = v_retract_event(events, local_2, actor.id, time, local_3, dv_with(dv_with(dv_with(dv_with(dv_with(dv_with({"status": status, "actor_before": before, "actor_after": after, "charged_units": charged}, "mind_before", actor.mind), "mind_after", actor.mind), "interpretations_before", dv_find(before, "interpretations", [])), "interpretations_after", interpretations), "source_event", local_6), "proposal", proposal))
                    i = (i + 1)
                seen = dv_append(seen, proposal_id)
    return dv_with(dv_with(dv_with(dv_with(actor, "interpretations", interpretations), "policy", dv_with(actor.policy, "reason_budget", remaining)), "last_interpretation_event", last), "reassessed_proposals", seen)

fn v_proposal_origin_speakers(events, sources):
    var pending = dv_clone(sources)
    var visited = []
    var result = []
    var i = 0
    while (i < rt_count(pending)):
        var id = pending[i]
        var event = v_event(events, pending[i])
        if dv_has(visited, id):
            false
        else:
            rt_push(visited, id)
            if (0 < rt_count(event)):
                var kind = event.type
                var data = event.data
                if (kind == "speech_literal"):
                    result = dv_explanation_merge(result, dv_single(event.actor))
                if (kind == "public_topic_heard"):
                    pending = dv_explanation_merge(pending, dv_find(data, "source_event_ids", []))
                if dv_has(dv_pair("listener_parse", "observation"), kind):
                    var source = dv_find(data, "source_event", "")
                    if dv_and((not (source == "")), dv_has(event.parents, source)):
                        pending = dv_explanation_merge(pending, dv_single(source))
        i = (i + 1)
    return result

fn v_proposal_sources(trace, speech, action, argument):
    var events = v_events(trace)
    var speaker = speech.actor
    var topic = []
    var heard = []
    var result = []
    var i = 0
    var scope = dv_find(action, "reassessment_source_scope", "")
    var topic_index = -1
    var binding = []
    while (i < rt_count(events)):
        var e = events[i]
        var data = events[i].data
        if dv_and((e.actor == speaker), v_event_precedes(events, e, speech)):
            if dv_and((e.type == "public_topic_heard"), (dv_find(data, "topic", "") == dv_find(argument, "question_id", ""))):
                if (rt_count(topic) == 0):
                    topic = data
                    topic_index = i
            if (e.type == "listener_parse"):
                if v_reception_verified(trace, e.id):
                    var old = v_event(events, dv_find(data, "source_event", ""))
                    if dv_and((dv_find(old, "type", "") == "speech_literal"), (not (old.actor == speaker))):
                        heard = dv_with(heard, old.id, {"source_event": old.id, "speaker": old.actor, "scope": dv_find(dv_find(data, "speech", []), "scope", "")})
        i = (i + 1)
    var bindings = dv_find(v_frozen_actor(trace, speaker).policy, "topic_bindings", [])
    var j = 0
    var mind = dv_find(speech.data, "mind_before", [])
    while (j < rt_count(bindings)):
        if (bindings[j].topic == dv_find(argument, "question_id", "")):
            binding = bindings[j]
        j = (j + 1)
    if dv_and((-1 < topic_index), (0 < rt_count(binding))):
        if dv_and(dv_same(binding.heard_when, dv_find(topic, "heard_when", false)), dv_same(v_retract_support_parents(mind, v_model_sim_refs(binding.heard_when), v_event_prefix(events, topic_index), speaker), dv_find(topic, "source_event_ids", []))):
            false
        else:
            topic = []
    else:
        topic = []
    var origins = v_proposal_origin_speakers(events, dv_find(topic, "source_event_ids", []))
    i = 0
    while (i < rt_count(heard)):
        var record = heard[i][1]
        if dv_and((not (scope == "")), dv_and((scope == record.scope), dv_has(origins, record.speaker))):
            result = dv_explanation_merge(result, dv_single(record.source_event))
        i = (i + 1)
    return result

fn v_proposal_sender_valid(trace, speech):
    var origin = v_origin_execution(v_events(trace), speech)
    var valid = false
    if (0 < rt_count(origin)):
        var action = origin.data.action
        var mind = dv_find(speech.data, "mind_before", [])
        var argument = dv_find(origin.data.action, "argument", [])
        if (0 < rt_count(argument)):
            var proof = v_event(v_events(trace), dv_find(argument, "id", ""))
            var inputs = dv_find(argument, "inputs", [])
            var i = 0
            valid = dv_and(v_cached_argument_verified(trace, dv_find(argument, "id", "")), dv_and((dv_find(proof, "actor", "") == speech.actor), v_ancestor(v_events(trace), speech.id, dv_find(argument, "id", ""))))
            valid = dv_and(valid, dv_same(v_record_without(argument, dv_list3("question_id", "hypothesis_id", "adoptions")), dv_find(dv_find(dv_find(proof, "data", []), "result", []), "argument", [])))
            valid = dv_and(valid, dv_same(dv_find(argument, "adoptions", []), mind.adoptions))
            while (i < rt_count(inputs)):
                var input = inputs[i]
                valid = dv_and(valid, dv_same(input.cell, dv_read(mind, input.ref)))
                i = (i + 1)
            valid = dv_and(valid, dv_same(v_proposal_sources(trace, speech, action, argument), dv_find(dv_find(action, "proposal", []), "reassessment_sources", [])))
            valid = dv_and(valid, v_action_frozen(trace, speech.actor, action))
    return valid

fn v_proposal_parse_parent(trace, e):
    var parents = e.parents
    var i = 0
    var found = []
    while (i < rt_count(parents)):
        var candidate = v_event(v_events(trace), parents[i])
        if dv_and((dv_find(candidate, "type", "") == "listener_parse"), (dv_find(candidate, "actor", "") == e.actor)):
            found = candidate
        i = (i + 1)
    return found

fn v_proposal_reassessment_check(trace, e):
    var events = v_events(trace)
    var parse = v_proposal_parse_parent(trace, e)
    var status = "insufficient_evidence"
    var i = 0
    var start = -1
    var current = -1
    var first = []
    var reason = "缺少真实提案采纳、先前本人采纳或付费复核的完整前后记录"
    while (i < rt_count(events)):
        var candidate = events[i]
        if (candidate.id == e.id):
            current = i
        if dv_and(dv_has_key(candidate.data, "proposal"), dv_and(dv_has_key(candidate.data, "charged_units"), dv_and((candidate.actor == e.actor), dv_has(candidate.parents, dv_find(parse, "id", ""))))):
            if (start < 0):
                start = i
                first = candidate
        i = (i + 1)
    if dv_and((-1 < start), dv_and((-1 < current), (0 < rt_count(parse)))):
        var before = dv_find(first.data, "actor_before", [])
        var frozen = v_frozen_actor(trace, e.actor)
        var decision = dv_find(parse.data, "proposal_decision", [])
        var private = v_event_prefix(events, start)
        var expected = []
        var valid = true
        if (rt_count(before) == 0):
            false
        else:
            v_proposal_reassess(before, decision, private, first.time, parse.id)
            if (current < rt_count(private)):
                expected = private[current]
            valid = dv_same(expected, e)
            valid = dv_and(valid, v_runtime_policy_valid(trace, first, before.policy))
            valid = dv_and(valid, (dv_find(before.policy, "reason_budget", -1) == v_reason_budget_before(trace, first, start)))
            valid = dv_and(valid, dv_same(before.mind, parse.data.mind_after))
            var local_1 = false
            if valid:
                local_1 = "supported"
            else:
                local_1 = "violated"
            status = local_1
            reason = "逐步重演本人提案采纳后的付费桥接复核、理由预算及解释前后状态；撤销不写入相反命题"
            if dv_and(v_reception_verified(trace, parse.id), (dv_find(decision, "status", "") == "accepted")):
                false
            else:
                status = "insufficient_evidence"
                reason = "缺少实际接收并由本人策略采纳的提案来源，不能将收到冒充采纳"
            var speech = v_event(events, dv_find(parse.data, "source_event", ""))
            if v_proposal_sender_valid(trace, speech):
                false
            else:
                status = "insufficient_evidence"
                reason = "发送者的当前有效论证或真实旧话语题目来源尚未独立核验"
            i = 0
            while (i < rt_count(dv_find(before, "interpretations", []))):
                var entry = before.interpretations[i]
                if (dv_find(entry[1], "status", "") == "accepted"):
                    if v_prior_interpretation(trace, first, entry[0], entry[1]):
                        false
                    else:
                        status = "insufficient_evidence"
                        reason = "先前解释采纳缺少真实本人事件父边，不能只相信actor_before"
                i = (i + 1)
    var origin = dv_find(dv_find(trace, "configuration", []), "time_origin", [])
    if dv_has_key(origin, "horizon"):
        if (origin.horizon < e.time):
            status = "violated"
            reason = "付费撤销发生在运行起点总游戏预算之外；不能从首答重新计时"
    return dv_with(dv_with(v_finding("proposal_reassessment_provenance", status, reason, dv_pair(e.id, dv_find(parse, "id", false))), "actor", e.actor), "action", dv_find(e.data, "status", "unknown"))

fn v_proposal_withdrawn_gap(e):
    var data = e.data
    var before = dv_find(e.data, "interpretations_before", [])
    var after = dv_find(e.data, "interpretations_after", [])
    var found = false
    var i = 0
    while (i < rt_count(before)):
        var entry = before[i]
        var old = before[i][1]
        if dv_and((dv_find(old, "status", "") == "accepted"), dv_and(dv_find(dv_find(old, "scope_check", []), "gap", false), (dv_find(dv_find(after, entry[0], []), "status", "") == "withdrawn"))):
            found = true
        i = (i + 1)
    return dv_and(found, dv_and((dv_find(data, "status", "") == "withdrawn"), (dv_find(data, "charged_units", 0) == 1)))

fn v_proposal_reception_check(trace, e):
    var data = e.data
    var source = v_event(v_events(trace), dv_find(e.data, "source_event", ""))
    var actor = v_frozen_actor(trace, e.actor)
    var status = "insufficient_evidence"
    var reason = "缺少真实提案话语或本人收闻前后快照"
    if dv_and((0 < rt_count(source)), dv_and(dv_has_key(data, "mind_before"), dv_has_key(data, "mind_after"))):
        var speech = dv_find(source.data, "speech", [])
        var before = data.mind_before
        var policy = actor.policy
        var expected = []
        var after = data.mind_before
        expected = v_paid_speech_proposal_decision(before, policy, speech, dv_find(dv_find(policy, "speaker_trust", []), source.actor, 0.5))
        if (e.type == "proposal_adoption"):
            var parsed = v_language_map(before, speech.literal_ast, dv_find(speech, "referents", []))
            after = dv_update_mind(before, v_paid_speech_received_observations(before, parsed, source.id, source.actor, e.time, expected), before.revision, dv_observation_profile({"perception": 1, "testimony": 1, "recall": 1}, dv_find(policy, "observation_threshold", 0.5))).world
        expected = dv_with(dv_with(dv_with(expected, "source_event", source.id), "mind_before", before), "mind_after", after)
        var local_1 = false
        if dv_same(expected, data):
            local_1 = "supported"
        else:
            local_1 = "violated"
        status = local_1
        reason = "提案收闻回执保持本人认知不变；采纳独立按本人策略重算，拒收不写入事实"
        if dv_and(v_source_delivery(trace, source), dv_and((v_hearing(trace, source, e.actor) == "true"), v_ancestor(v_events(trace), e.id, source.id))):
            false
        else:
            status = "insufficient_evidence"
        if v_proposal_sender_valid(trace, source):
            false
        else:
            status = "insufficient_evidence"
    return dv_with(dv_with(v_finding("proposal_reception_provenance", status, reason, dv_pair(e.id, dv_find(source, "id", false))), "actor", e.actor), "action", e.type)
