; Pure judge-side interpretation replay from frozen listener policy.
(defn v_parse_candidates (policy speech)
  (let (cues (dv_find speech "implicature_candidates" (rt_list)) rules (dv_find policy "implicature_bridges" (rt_list))
        result (rt_list) ids (rt_list) local_ids (rt_list) i 0)
    (do
      (while (rt_lt i (rt_count rules))
        (let (rule (rt_at rules i) id (dv_get (rt_at rules i) "id") required (dv_find (rt_at rules i) "cue" "") j 0 matched false)
          (do
            (rt_push local_ids id)
            (if (rt_eq required "") (set matched true) false)
            (while (rt_lt j (rt_count cues))
              (do (if (rt_eq (dv_get (rt_at cues j) "id") required) (set matched true) false) (set j (rt_add j 1))))
            (if matched (do (rt_push result (dv_m3 "id" id "rule_source" (dv_find rule "basis" (rt_list)) "utterance_scope" (dv_find speech "scope" ""))) (rt_push ids id)) false)
            (set i (rt_add i 1)))))
      (set i 0)
      (while (rt_lt i (rt_count cues))
        (let (cue_id (dv_get (rt_at cues i) "id"))
          (do (if (dv_or (dv_has ids cue_id) (dv_has local_ids cue_id)) false (do (rt_push result (dv_m3 "id" cue_id "rule_source" (rt_list) "utterance_scope" (dv_find speech "scope" ""))) (rt_push ids cue_id))) (set i (rt_add i 1)))))
      result)))
(defn v_parse_interpret (mind policy candidate bindings)
  (let (bridges (dv_find policy "implicature_bridges" (rt_list)) i 0 bridge false
        proposition (dv_m2 "op" "constant" "value" "unknown") available (dv_true)
        threshold (dv_find policy "implicature_threshold" 0.5) confidence 0
        basis (rt_list) status "rejected" missing "missing-bridge" scope_check (rt_list))
    (do
      (while (rt_lt i (rt_count bridges))
        (let (item (rt_at bridges i))
          (do (if (rt_eq (dv_get item "id") (dv_get candidate "id"))
            (do (dv_require (rt_eq bridge false) "Ambiguous interpretation bridge") (set bridge item)) false) (set i (rt_add i 1)))))
      (if (rt_eq bridge false) false
        (let (premise (v_language_map mind (dv_get bridge "premise") bindings)
              bridge_basis (dv_find bridge "basis" (rt_list)))
          (do
            (set proposition (v_language_map mind (dv_get bridge "proposition") bindings))
            (set available (v_language_map mind (dv_find bridge "available_when" (dv_true)) bindings))
            (set confidence (dv_unit (dv_find bridge "prior" 0.5)))
            (set basis bridge_basis)
            (let (literal_scope (dv_find candidate "utterance_scope" (dv_find bridge "source_scope" ""))
                  interpreted_scope (dv_find bridge "target_scope" (dv_find bridge "source_scope" ""))
                  scope_truth (dv_truth mind (v_language_map mind (dv_find bridge "scope_bridge" (dv_m2 "op" "constant" "value" "unknown")) bindings)))
              (set scope_check (dv_with (dv_m4 "literal_scope" literal_scope "interpretation_scope" interpreted_scope "bridge_truth" scope_truth
                "check_enabled" (dv_find policy "scope_reference_check" false)) "gap" (dv_and (rt_not (rt_eq literal_scope interpreted_scope)) (rt_not (rt_eq scope_truth "true"))))))
            (if (rt_eq (dv_truth mind (v_language_map mind (dv_find bridge "withdraw_when" (dv_not (dv_true))) bindings)) "true")
              (do (set status "withdrawn") (set missing "explicit-withdrawal-evidence"))
              (if (rt_not (rt_eq (dv_truth mind available) "true")) (set missing "availability-not-known")
                (if (rt_eq (rt_count bridge_basis) 0) (set missing "bridge-without-source")
                  (if (rt_not (rt_eq (dv_truth mind premise) "true")) (set missing "bridge-premise-not-known")
                    (if (rt_eq (rt_count basis) 0) (set missing "candidate-without-source")
                      (if (rt_eq (dv_truth mind proposition) "false") (set missing "contrary-evidence")
                        (if (rt_lt confidence threshold) (set missing "below-policy-threshold")
                          (do (set status "accepted") (set missing "")))))))))
            (if (dv_and (rt_eq status "accepted") (dv_and (dv_get scope_check "check_enabled") (dv_get scope_check "gap")))
              (do (set status "retained") (set missing "scope-reference-bridge-not-supported")) false)
            (set basis (dv_append basis (dv_m2 "bridge" (dv_get bridge "id") "basis" bridge_basis))))))
      (dv_with (dv_with (dv_with (dv_with (dv_m4 "id" (dv_get candidate "id") "proposition" proposition "status" status "confidence" confidence)
        "basis" basis) "missing_bridge" missing) "scope_check" scope_check) "kind" "defeasible-interpretation"))))
(defn v_prediction_check (trace e)
  (let (data (dv_get e "data") source (v_event (v_events trace) (dv_find (dv_get e "data") "source_event" "")) status "insufficient_evidence" reason "缺少说话者当时本人模型与真实话语来源")
    (do
      (if (rt_lt 0 (rt_count source))
        (let (source_data (dv_get source "data") models (dv_find (dv_find (dv_get source "data") "mind_before" (rt_list)) "listener_models" (rt_list)) listener (dv_find data "listener" ""))
          (if (dv_has_key models listener)
            (let (model (dv_get models listener) speech (dv_get source_data "speech") predicted (rt_list) candidates (rt_list) i 0 valid true)
              (do
                (set candidates (v_parse_candidates (dv_get model "policy") speech))
                (while (rt_lt i (rt_count candidates))
                  (do (rt_push predicted (v_parse_interpret (dv_get model "mind") (dv_get model "policy") (rt_at candidates i) (dv_find speech "referents" (rt_list)))) (set i (rt_add i 1))))
                (set valid (dv_and (dv_same model (dv_find data "model" false)) (dv_same predicted (dv_find data "prediction" false))))
                (set valid (dv_and valid (rt_lt 0 (rt_count (dv_find model "basis" (rt_list))))))
                (set valid (dv_and valid (v_ancestor (v_events trace) (dv_get e "id") (dv_get source "id"))))
                (set status (if valid "supported" "violated"))
                (set reason "预测只依据说话者本人当时持有模型重算，未读取听者实际脑内；缺模型不能冒报确定理解")))
            (do (set status (if (rt_eq (dv_find data "status" "") "unknown-no-model") "supported" "violated"))
              (set reason "本人无该听者模型，只能保留未知预测，不用事后真实解析替代")))) false)
      (dv_with (dv_with (v_finding "speaker_prediction_boundary" status reason (dv_single (dv_get e "id"))) "actor" (dv_get e "actor")) "action" "speaker_prediction"))))
(defn v_prior_interpretation (trace e id before_entry)
  (let (events (v_events trace) i 0 found false)
    (do (while (rt_lt i (rt_count events))
      (let (prior (rt_at events i) data (dv_find (rt_at events i) "data" (rt_list)))
        (do (if (dv_and (rt_eq (dv_get prior "actor") (dv_get e "actor"))
            (dv_and (rt_eq (dv_get prior "type") "implicature") (rt_eq (dv_find data "id" "") id)))
          (if (dv_and (rt_eq (dv_find data "status" "") "accepted") (v_ancestor events (dv_get e "id") (dv_get prior "id")))
            (if (dv_same before_entry (dv_find (dv_find data "interpretations_after" (rt_list)) id false)) (set found true) false) false) false)
          (set i (rt_add i 1))))) found)))
(defn v_interpretation_check (trace e)
  (let (data (dv_get e "data") source (v_event (v_events trace) (dv_find (dv_get e "data") "source_event" "")) actor (v_frozen_actor trace (dv_get e "actor"))
        status "insufficient_evidence" reason "缺少实际话语、本人的解析后快照或解释采纳前后记录" refs (dv_single (dv_get e "id")))
    (do
      (if (dv_and (rt_lt 0 (rt_count source)) (dv_and (rt_lt 0 (rt_count actor))
          (dv_and (dv_has_key data "mind_before") (dv_and (dv_has_key data "interpretations_before") (dv_has_key data "interpretations_after")))))
        (let (speech (dv_get (dv_get source "data") "speech") policy (dv_get actor "policy") candidates (rt_list) candidate (rt_list) i 0 expected (rt_list) before (dv_get data "interpretations_before") valid true)
          (do
            (rt_push refs (dv_get source "id"))
            (set candidates (v_parse_candidates policy speech))
            (while (rt_lt i (rt_count candidates))
              (do (if (rt_eq (dv_get (rt_at candidates i) "id") (dv_get data "id")) (set candidate (rt_at candidates i)) false) (set i (rt_add i 1))))
            (if (rt_eq (rt_count candidate) 0)
              (do (set status "violated") (set reason "采纳了本人冻结策略与真实话语未提供的解释候选"))
              (do
                (set expected (v_parse_interpret (dv_get data "mind_before") policy candidate (dv_find speech "referents" (rt_list))))
                (set expected (dv_with (dv_with expected "source_event" (dv_get source "id")) "referents" (dv_find speech "referents" (rt_list))))
                (if (rt_eq (dv_get expected "status") "withdrawn")
                  (if (rt_eq (dv_find (dv_find before (dv_get candidate "id") (rt_list)) "status" "") "accepted") false
                    (set expected (dv_with expected "status" "rejected"))) false)
                (let (keys (dv_list3 "proposition" "status" "confidence") j 0)
                  (do (rt_push keys "basis") (rt_push keys "missing_bridge") (rt_push keys "scope_check") (rt_push keys "kind")
                    (while (rt_lt j (rt_count keys))
                      (do (set valid (dv_and valid (dv_same (dv_find expected (rt_at keys j) false) (dv_find data (rt_at keys j) false)))) (set j (rt_add j 1))))))
                (set valid (dv_and valid (dv_same (dv_with before (dv_get candidate "id") expected) (dv_get data "interpretations_after"))))
                (set valid (dv_and valid (dv_same (dv_get data "mind_before") (dv_find data "mind_after" false))))
                (set valid (dv_and valid (rt_eq (v_hearing trace source (dv_get e "actor")) "true")))
                (set valid (dv_and valid (v_ancestor (v_events trace) (dv_get e "id") (dv_get source "id"))))
                (set status (if valid "supported" "violated"))
                (set reason "按听者自己的桥接前提、来源、阈值和撤销条件重算解释；只更新暗示记录，不向事实域写入P或not P")
                (if (rt_eq (dv_get expected "status") "withdrawn")
                  (if (v_prior_interpretation trace e (dv_get candidate "id") (dv_get before (dv_get candidate "id"))) false
                    (do (set status "insufficient_evidence") (set reason "撤销有本人新依据，但未找到实际先前采纳事件的显式因果前驱，不能只信before自报"))) false))))) false)
      (dv_with (dv_with (v_finding "listener_interpretation" status reason refs) "actor" (dv_get e "actor")) "action" (dv_find data "status" "unknown")))))
(defn v_social_check (trace)
  (let (events (v_events trace) result (rt_list) i 0)
    (do (while (rt_lt i (rt_count events))
      (let (e (rt_at events i) type (dv_get (rt_at events i) "type"))
        (do
          (if (dv_or (rt_eq type "listener_parse") (rt_eq type "speech_unheard")) (rt_push result (v_listener_replay trace e)) false)
          (if (dv_or (rt_eq type "listener_parse") (rt_eq type "observation"))
            (let (extra (v_testimony_dependency trace e) j 0)
              (while (rt_lt j (rt_count extra)) (do (rt_push result (rt_at extra j)) (set j (rt_add j 1))))) false)
          (if (dv_or (rt_eq type "implicature") (rt_eq type "implicature_withdrawn")) (rt_push result (v_interpretation_check trace e)) false)
          (if (rt_eq type "speaker_prediction") (rt_push result (v_prediction_check trace e)) false)
          (if (dv_or (rt_eq type "answer_accepted") (rt_eq type "answer_rejected"))
            (let (submit (v_parent_submission events e))
              (rt_push result (dv_with (v_finding "formal_answer_dependency" (if (rt_eq (rt_count submit) 0) "insufficient_evidence" "supported") "正式回答结果必须直接引用本人的真实提交；不能拿任何先前答题替代本次提交" (dv_pair (dv_get e "id") (dv_find submit "id" false))) "actor" (dv_get e "actor")))) false)
          (set i (rt_add i 1))))) result)))
