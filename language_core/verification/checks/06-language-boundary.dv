; Judge-side replay of structured language; no session mutation or oracle-to-policy path.
(defn v_frozen_actor (trace id)
  (let (actors (dv_find (dv_find trace "initial" (rt_list)) "actors" (rt_list)) i 0 found (rt_list))
    (do (while (rt_lt i (rt_count actors))
      (do (if (rt_eq (dv_get (rt_at actors i) "id") id) (set found (rt_at actors i)) false) (set i (rt_add i 1)))) found)))
(defn v_authority_before (trace e)
  (let (events (v_events trace) world (dv_find (dv_find trace "initial" (rt_list)) "physical" (rt_list)) i 0)
    (do (while (rt_lt i (rt_count events))
      (let (prior (rt_at events i) data (dv_find (rt_at events i) "data" (rt_list)))
        (do (if (v_ancestor events (dv_get e "id") (dv_get prior "id"))
          (let (candidate (if (rt_eq (dv_get prior "type") "action_execution") (dv_find data "physical_after" (rt_list))
            (if (rt_eq (dv_get prior "type") "question_transition") (dv_find data "world" (rt_list)) (rt_list))))
            (if (rt_lt 0 (rt_count candidate))
              (if (rt_eq (rt_count world) 0) (set world candidate)
                (if (rt_lt (dv_get world "revision") (dv_get candidate "revision")) (set world candidate) false)) false)) false)
          (set i (rt_add i 1))))) world)))
(defn v_language_map (mind p bindings)
  (let (op (dv_get p "op"))
    (if (rt_eq op "constant") p
      (if (rt_eq op "not") (dv_not (v_language_map mind (dv_get p "item") bindings))
        (if (rt_eq op "all")
          (let (items (dv_get p "items") mapped (rt_list) i 0)
            (do (while (rt_lt i (rt_count items)) (do (rt_push mapped (v_language_map mind (rt_at items i) bindings)) (set i (rt_add i 1)))) (dv_all mapped)))
          (let (ref (dv_get p "ref") local (dv_local bindings (dv_get (dv_get p "ref") "object") (dv_get mind "subject")))
            (if (rt_eq local "")
              (if (dv_has_key (dv_get mind "objects") (dv_get ref "object")) p (dv_m2 "op" "constant" "value" "unknown"))
              (dv_with p "ref" (dv_ref local (dv_get ref "facet") (dv_get ref "field"))))))))))
(defn v_testimony (mind p source origin time trust)
  (let (op (dv_get p "op") result (rt_list))
    (do (if (rt_eq op "all")
      (let (items (dv_get p "items") i 0)
        (while (rt_lt i (rt_count items))
          (let (part (v_testimony mind (rt_at items i) source origin time trust) j 0)
            (do (while (rt_lt j (rt_count part)) (do (if (dv_has result (rt_at part j)) false (rt_push result (rt_at part j))) (set j (rt_add j 1)))) (set i (rt_add i 1))))))
      (if (rt_eq op "equals")
        (let (ref (dv_get p "ref"))
          (rt_push result (dv_observation (dv_list3 source (dv_get mind "subject") ref) (dv_get mind "subject") ref (dv_get p "value") "testimony" origin time trust (dv_pair origin ref)))) false)) result)))
(defn v_hearing (trace source listener_id)
  (let (world (v_authority_before trace source) speaker (v_frozen_actor trace (dv_get source "actor")) listener (v_frozen_actor trace listener_id) speech (dv_find (dv_get source "data") "speech" (rt_list)))
    (if (dv_or (rt_eq (rt_count world) 0) (dv_or (rt_eq (rt_count speaker) 0) (rt_eq (rt_count listener) 0))) "unknown"
      (let (sref (dv_find speaker "location_ref" (dv_ref (dv_get speaker "id") "state" "location"))
            lref (dv_find listener "location_ref" (dv_ref listener_id "state" "location"))
            grants (dv_find listener "hearing_grants" (rt_list)) i 0 heard false
            scell (dv_read world (dv_find speaker "location_ref" (dv_ref (dv_get speaker "id") "state" "location")))
            lcell (dv_read world (dv_find listener "location_ref" (dv_ref listener_id "state" "location"))))
        (do
          (if (dv_and (dv_get scell "known") (dv_get lcell "known")) (set heard (dv_same (dv_get scell "value") (dv_get lcell "value"))) false)
          (while (rt_lt i (rt_count grants))
            (let (g (rt_at grants i)) (do
              (if (dv_and (rt_eq (dv_get g "speaker") (dv_get source "actor")) (rt_eq (dv_get g "channel") (dv_find speech "channel" ""))) (set heard true) false)
              (set i (rt_add i 1)))))
          (if heard "true" (if (dv_and (dv_get scell "known") (dv_get lcell "known")) "false" "unknown")))))))
(defn v_listener_replay_compute (trace e)
  (let (data (dv_get e "data") source (v_event (v_events trace) (dv_find (dv_get e "data") "source_event" ""))
        actor (v_frozen_actor trace (dv_get e "actor")) status "insufficient_evidence" reason "缺少本人快照、真实交流来源或冻结解析策略" refs (dv_single (dv_get e "id")))
    (do
      (if (rt_lt 0 (rt_count source))
        (do (rt_push refs (dv_get source "id"))
          (if (rt_eq (dv_get e "type") "speech_unheard")
            (do (set status (if (rt_eq (v_hearing trace source (dv_get e "actor")) "false") "supported" (if (rt_eq (v_hearing trace source (dv_get e "actor")) "true") "violated" "insufficient_evidence")))
              (set reason "依据实际权威位置和已授权听觉通道核对未闻；未闻不等于收到或采纳"))
            (if (dv_and (dv_and (dv_has_key data "mind_before") (dv_has_key data "mind_after")) (rt_lt 0 (rt_count actor)))
              (let (speech (dv_find (dv_get source "data") "speech" (rt_list)) before (dv_get data "mind_before") policy (dv_get actor "policy")
                    parsed (rt_list) observations (rt_list) after (rt_list) valid true)
                (do
                  (set parsed (v_language_map before (dv_get speech "literal_ast") (dv_find speech "referents" (rt_list))))
                  (set observations (v_testimony before parsed (dv_get source "id") (dv_get source "actor") (dv_get e "time")
                    (dv_find (dv_find policy "speaker_trust" (rt_list)) (dv_get source "actor") 0.5)))
                  (set after (dv_get (dv_update_mind before observations (dv_get before "revision") (dv_observation_profile (dv_m3 "perception" 1 "testimony" 1 "recall" 1) (dv_find policy "observation_threshold" 0.5))) "world"))
                  (set valid (dv_and (dv_same parsed (dv_find data "literal" false)) (dv_and (dv_same observations (dv_find data "observations" false)) (dv_same after (dv_get data "mind_after")))))
                  (set valid (dv_and valid (v_ancestor (v_events trace) (dv_get e "id") (dv_get source "id")))) (set valid (dv_and valid (v_source_delivery trace source)))
                  (set status (if valid (if (rt_eq (v_hearing trace source (dv_get e "actor")) "true") "supported" (if (rt_eq (v_hearing trace source (dv_get e "actor")) "false") "violated" "insufficient_evidence")) "violated"))
                  (set reason "从真实交流字面、本人指代绑定、信任和听觉条件重算接收、解析与认知更新；不要求解析事件已改变暗示采纳"))) false))) false)
      (dv_with (dv_with (v_finding "speech_reception_boundary" status reason refs) "actor" (dv_get e "actor")) "action" (dv_get e "type")))))
(defn v_source_delivery (trace source)
  (let (events (v_events trace) parents (dv_find source "parents" (rt_list)) i 0 execution (rt_list))
    (do (while (rt_lt i (rt_count parents))
      (let (p (v_event events (rt_at parents i)))
        (do (if (rt_eq (dv_find p "type" "") "action_execution") (set execution p) false) (set i (rt_add i 1)))))
      (if (rt_eq (rt_count execution) 0) false
        (let (data (dv_get execution "data") action (dv_get (dv_get execution "data") "action") source_data (dv_get source "data"))
          (if (dv_and (dv_has_key action "speech") (dv_has_key source_data "literal"))
            (dv_and (v_action_frozen trace (dv_get source "actor") action)
              (dv_and (rt_eq (dv_get (dv_get (dv_get data "receipt") "execution") "status") "applied")
                (dv_and (dv_same (dv_get action "speech") (dv_find source_data "speech" false))
                  (rt_eq (dv_truth (dv_get data "physical_before") (dv_get source_data "literal")) "true")))) false))))))
(defn v_reception_verified (trace id)
  (let (e (v_event (v_events trace) id))
    (if (rt_eq (rt_count e) 0) false (rt_eq (dv_get (v_listener_replay trace e) "status") "supported"))))
(defn v_testimony_dependency (trace e)
  (let (data (dv_get e "data") observations (dv_find (dv_get e "data") "observations" (rt_list)) i 0 result (rt_list))
    (do (while (rt_lt i (rt_count observations))
      (let (obs (rt_at observations i) after (dv_find data "mind_after" (rt_list)) status "insufficient_evidence" reason "缺少认知后快照，无法核对共同来源依赖" refs (dv_single (dv_get e "id")))
        (do
          (if (rt_lt 0 (rt_count after))
            (let (claims (dv_find (dv_read after (dv_get obs "ref")) "claims" (rt_list)) j 0 dependencies (rt_list) duplicate false)
              (do (while (rt_lt j (rt_count claims))
                (let (claim (rt_at claims j) dep (dv_find (rt_at claims j) "dependency" false))
                  (do (if (dv_has dependencies dep) (set duplicate true) (rt_push dependencies dep)) (set j (rt_add j 1)))))
                (set status (if duplicate "violated" "supported"))
                (set reason "同一依赖身份的重复证言在本人cell中不应作为多个独立来源重复存留"))) false)
          (rt_push result (dv_with (dv_with (v_finding "evidence_dependency_identity" status reason refs) "actor" (dv_get e "actor")) "dependencies" (dv_find obs "dependency" false)))
          (if (rt_eq (dv_get obs "source") "testimony")
            (let (source (v_event (v_events trace) (dv_find data "source_event" "")))
              (if (rt_lt 0 (rt_count source))
                (let (source_mind (dv_find (dv_get source "data") "mind_before" (rt_list)))
                  (if (rt_lt 0 (rt_count source_mind))
                    (let (upstream (dv_find (dv_read source_mind (dv_get obs "ref")) "claims" (rt_list)) k 0 relayed false)
                      (do (while (rt_lt k (rt_count upstream))
                        (do (if (rt_eq (dv_get (rt_at upstream k) "source") "testimony") (set relayed true) false) (set k (rt_add k 1))))
                        (if relayed (rt_push result (dv_with (v_finding "testimony_common_origin" "insufficient_evidence" "转述者本人的该命题已有上游证言，当前回执仅依新speaker标识；缺跨转述共同来源映射，不能宣称来源独立" refs) "actor" (dv_get e "actor"))) false))) false)) false)) false)
          (set i (rt_add i 1))))) result)))

(defn v_listener_replay (trace e)
  (let (cached (dv_find trace "judge_reception_findings" (rt_list)) i 0 found (rt_list))
    (do (while (rt_lt i (rt_count cached))
      (do (if (dv_same (rt_at (dv_get (rt_at cached i) "evidence_refs") 0) (dv_get e "id")) (set found (rt_at cached i)) false) (set i (rt_add i 1))))
      (if (rt_eq (rt_count found) 0) (v_listener_replay_compute trace e) found))))
(defn v_receptions_compute (trace)
  (let (events (v_events trace) i 0 findings (rt_list))
    (do (while (rt_lt i (rt_count events))
      (let (e (rt_at events i)) (do
        (if (dv_or (rt_eq (dv_get e "type") "listener_parse") (rt_eq (dv_get e "type") "speech_unheard"))
          (rt_push findings (v_listener_replay_compute trace e)) false) (set i (rt_add i 1))))) findings)))
