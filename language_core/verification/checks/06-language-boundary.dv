// Judge-side replay of structured language; no session mutation or oracle-to-policy path.

fn v_frozen_actor(trace, id):
    var actors = dv_find(dv_find(trace, "initial", []), "actors", [])
    var i = 0
    var found = []
    while (i < rt_count(actors)):
        if (actors[i].id == id):
            found = actors[i]
        i = (i + 1)
    return found

fn v_authority_before(trace, e):
    var events = v_events(trace)
    var world = dv_find(dv_find(trace, "initial", []), "physical", [])
    var i = 0
    var ancestors = v_ancestors(v_events(trace), e.id)
    while (i < rt_count(events)):
        var prior = events[i]
        var data = dv_find(events[i], "data", [])
        if dv_has(ancestors, prior.id):
            var local_1 = false
            if (prior.type == "action_execution"):
                local_1 = dv_find(data, "physical_after", [])
            else:
                if (prior.type == "question_transition"):
                    local_1 = dv_find(data, "world", [])
                else:
                    local_1 = []
            var candidate = local_1
            if (0 < rt_count(candidate)):
                if (rt_count(world) == 0):
                    world = candidate
                else:
                    if (world.revision < candidate.revision):
                        world = candidate
        i = (i + 1)
    return world

fn v_language_map(mind, p, bindings):
    var op = p.op
    if (op == "constant"):
        return p
    else:
        if (op == "not"):
            return dv_not(v_language_map(mind, p.item, bindings))
        else:
            if (op == "all"):
                var items = p.items
                var mapped = []
                var i = 0
                while (i < rt_count(items)):
                    rt_push(mapped, v_language_map(mind, items[i], bindings))
                    i = (i + 1)
                return dv_all(mapped)
            else:
                var ref = p.ref
                var local = dv_local(bindings, p.ref.object, mind.subject)
                if (local == ""):
                    if dv_has_key(mind.objects, ref.object):
                        return p
                    else:
                        return {"op": "constant", "value": "unknown"}
                else:
                    return dv_with(p, "ref", dv_ref(local, ref.facet, ref.field))

fn v_testimony(mind, p, source, origin, time, trust):
    var op = p.op
    var result = []
    if (op == "all"):
        var items = p.items
        var i = 0
        while (i < rt_count(items)):
            var part = v_testimony(mind, items[i], source, origin, time, trust)
            var j = 0
            while (j < rt_count(part)):
                if dv_has(result, part[j]):
                    false
                else:
                    rt_push(result, part[j])
                j = (j + 1)
            i = (i + 1)
    else:
        if (op == "equals"):
            var ref = p.ref
            rt_push(result, dv_observation(dv_list3(source, mind.subject, ref), mind.subject, ref, p.value, "testimony", origin, time, trust, dv_pair(origin, ref)))
    return result

fn v_hearing(trace, source, listener_id):
    var world = v_authority_before(trace, source)
    var speaker = v_frozen_actor(trace, source.actor)
    var listener = v_frozen_actor(trace, listener_id)
    var speech = dv_find(source.data, "speech", [])
    if dv_or((rt_count(world) == 0), dv_or((rt_count(speaker) == 0), (rt_count(listener) == 0))):
        return "unknown"
    else:
        var sref = dv_find(speaker, "location_ref", dv_ref(speaker.id, "state", "location"))
        var lref = dv_find(listener, "location_ref", dv_ref(listener_id, "state", "location"))
        var grants = dv_find(listener, "hearing_grants", [])
        var i = 0
        var heard = false
        var scell = dv_read(world, dv_find(speaker, "location_ref", dv_ref(speaker.id, "state", "location")))
        var lcell = dv_read(world, dv_find(listener, "location_ref", dv_ref(listener_id, "state", "location")))
        if dv_and(scell.known, lcell.known):
            heard = dv_same(scell.value, lcell.value)
        while (i < rt_count(grants)):
            var g = grants[i]
            if dv_and((g.speaker == source.actor), (g.channel == dv_find(speech, "channel", ""))):
                heard = true
            i = (i + 1)
        if heard:
            return "true"
        else:
            if dv_and(scell.known, lcell.known):
                return "false"
            else:
                return "unknown"

fn v_listener_replay_compute(trace, e):
    var data = e.data
    var source = v_event(v_events(trace), dv_find(e.data, "source_event", ""))
    var actor = v_frozen_actor(trace, e.actor)
    var checks = []
    var status = "insufficient_evidence"
    var reason = "缺少本人快照、真实交流来源或冻结解析策略"
    var refs = dv_single(e.id)
    if (0 < rt_count(source)):
        rt_push(refs, source.id)
        if (e.type == "speech_unheard"):
            var local_1 = false
            if (v_hearing(trace, source, e.actor) == "false"):
                local_1 = "supported"
            else:
                if (v_hearing(trace, source, e.actor) == "true"):
                    local_1 = "violated"
                else:
                    local_1 = "insufficient_evidence"
            status = local_1
            reason = "依据实际权威位置和已授权听觉通道核对未闻；未闻不等于收到或采纳"
        else:
            if dv_and(dv_and(dv_has_key(data, "mind_before"), dv_has_key(data, "mind_after")), (0 < rt_count(actor))):
                var speech = dv_find(source.data, "speech", [])
                var before = data.mind_before
                var policy = actor.policy
                var parsed = []
                var observations = []
                var after = []
                var decision = []
                var valid = true
                parsed = v_language_map(before, speech.literal_ast, dv_find(speech, "referents", []))
                decision = v_paid_speech_proposal_decision(before, policy, speech, dv_find(dv_find(policy, "speaker_trust", []), source.actor, 0.5))
                observations = v_paid_speech_received_observations(before, parsed, source.id, source.actor, e.time, decision)
                after = dv_update_mind(before, observations, before.revision, dv_observation_profile({"perception": 1, "testimony": 1, "recall": 1}, dv_find(policy, "observation_threshold", 0.5))).world
                checks = dv_with(dv_with({"literal_parse": dv_same(parsed, dv_find(data, "literal", false)), "observation_delivery": dv_same(observations, dv_find(data, "observations", false)), "mind_update": dv_same(after, data.mind_after), "execution_source": v_source_delivery(trace, source)}, "source_ancestor", v_ancestor(v_events(trace), e.id, source.id)), "hearing", v_hearing(trace, source, e.actor))
                valid = dv_and(dv_same(parsed, dv_find(data, "literal", false)), dv_and(dv_same(observations, dv_find(data, "observations", false)), dv_same(after, data.mind_after)))
                if dv_has_key(speech, "proposal"):
                    valid = dv_and(valid, dv_same(decision, dv_find(data, "proposal_decision", [])))
                valid = dv_and(valid, v_ancestor(v_events(trace), e.id, source.id))
                valid = dv_and(valid, checks.execution_source)
                var local_2 = false
                if valid:
                    if (v_hearing(trace, source, e.actor) == "true"):
                        local_2 = "supported"
                    else:
                        if (v_hearing(trace, source, e.actor) == "false"):
                            local_2 = "violated"
                        else:
                            local_2 = "insufficient_evidence"
                else:
                    local_2 = "violated"
                status = local_2
                reason = "从真实交流字面、本人指代绑定、信任和听觉条件重算接收、解析与认知更新；checks分列实际差异"
                if (rt_count(v_origin_execution(v_events(trace), source)) == 0):
                    status = "insufficient_evidence"
                    reason = "话语的真实执行祖先及其权威快照未记录，不能判接收违反"
    return dv_with(dv_with(dv_with(v_finding("speech_reception_boundary", status, reason, refs), "actor", e.actor), "action", e.type), "checks", checks)

fn v_source_delivery(trace, source):
    var execution = v_origin_execution(v_events(trace), source)
    if (rt_count(execution) == 0):
        return false
    else:
        var data = execution.data
        var action = execution.data.action
        var source_data = source.data
        if dv_and(dv_has_key(action, "speech"), dv_has_key(source_data, "literal")):
            return dv_and(v_action_frozen(trace, source.actor, action), dv_and((data.receipt.execution.status == "applied"), dv_and(dv_same(action.speech, dv_find(source_data, "speech", false)), dv_same(action.speech.literal_ast, source_data.literal))))
        else:
            return false

fn v_reception_verified(trace, id):
    var e = v_event(v_events(trace), id)
    if (rt_count(e) == 0):
        return false
    else:
        return (v_listener_replay(trace, e).status == "supported")

fn v_testimony_dependency(trace, e):
    var data = e.data
    var observations = dv_find(e.data, "observations", [])
    var i = 0
    var result = []
    while (i < rt_count(observations)):
        var obs = observations[i]
        var after = dv_find(data, "mind_after", [])
        var status = "insufficient_evidence"
        var reason = "缺少认知后快照，无法核对共同来源依赖"
        var refs = dv_single(e.id)
        if (0 < rt_count(after)):
            var claims = dv_find(dv_read(after, obs.ref), "claims", [])
            var j = 0
            var dependencies = []
            var duplicate = false
            while (j < rt_count(claims)):
                var claim = claims[j]
                var dep = dv_find(claims[j], "dependency", false)
                if dv_has(dependencies, dep):
                    duplicate = true
                else:
                    rt_push(dependencies, dep)
                j = (j + 1)
            var local_1 = false
            if duplicate:
                local_1 = "violated"
            else:
                local_1 = "supported"
            status = local_1
            reason = "同一依赖身份的重复证言在本人cell中不应作为多个独立来源重复存留"
        rt_push(result, dv_with(dv_with(v_finding("evidence_dependency_identity", status, reason, refs), "actor", e.actor), "dependencies", dv_find(obs, "dependency", false)))
        if (obs.source == "testimony"):
            var source = v_event(v_events(trace), dv_find(data, "source_event", ""))
            if (0 < rt_count(source)):
                var source_mind = dv_find(source.data, "mind_before", [])
                if (0 < rt_count(source_mind)):
                    var upstream = dv_find(dv_read(source_mind, obs.ref), "claims", [])
                    var k = 0
                    var relayed = false
                    while (k < rt_count(upstream)):
                        if (upstream[k].source == "testimony"):
                            relayed = true
                        k = (k + 1)
                    if relayed:
                        rt_push(result, dv_with(v_finding("testimony_common_origin", "insufficient_evidence", "转述者本人的该命题已有上游证言，当前回执仅依新speaker标识；缺跨转述共同来源映射，不能宣称来源独立", refs), "actor", e.actor))
        i = (i + 1)
    return result

fn v_listener_replay(trace, e):
    var cached = dv_find(trace, "judge_reception_findings", [])
    var i = 0
    var found = []
    while (i < rt_count(cached)):
        if dv_same(cached[i].evidence_refs[0], e.id):
            found = cached[i]
        i = (i + 1)
    if (rt_count(found) == 0):
        return v_listener_replay_compute(trace, e)
    else:
        return found

fn v_receptions_compute(trace):
    var events = v_events(trace)
    var i = 0
    var findings = []
    while (i < rt_count(events)):
        var e = events[i]
        if dv_or((e.type == "listener_parse"), (e.type == "speech_unheard")):
            rt_push(findings, v_listener_replay_compute(trace, e))
        i = (i + 1)
    return findings

// ---- Merged source module: 10-comparisons.dv ----
// Configuration comparisons require a prior approval record and invariant frozen domains.

fn v_load_run(run):
    var manifest = rt_json_parse(rt_read(run.manifest))
    var trace = rt_json_parse(rt_read(run.trace))
    var oracle = rt_json_parse(rt_read(run.oracle))
    return {"manifest": manifest, "trace": trace, "oracle": oracle, "report": v_judge(manifest, trace, oracle)}

fn v_compare(configuration, mode):
    var runs = dv_find(configuration, "runs", [])
    var reports = []
    var findings = []
    var baseline = []
    var i = 0
    if dv_and(dv_has_key(configuration, "approval_ref"), dv_has_key(configuration, "frozen_fields")):
        false
    else:
        rt_push(findings, v_finding("comparison_authorization", "insufficient_evidence", "Prior approval and frozen-field contract absent; no causal improvement claim permitted", []))
    while (i < rt_count(runs)):
        var run = v_load_run(runs[i])
        var manifest = run.manifest
        if (i == 0):
            baseline = manifest
        else:
            var fields = dv_find(configuration, "frozen_fields", [])
            var j = 0
            var status = "supported"
            while (j < rt_count(fields)):
                var field = fields[j]
                if dv_and(dv_has_key(baseline, field), dv_has_key(manifest, field)):
                    if (field == "initial"):
                        false
                    else:
                        if dv_same(dv_get(baseline, field), dv_get(manifest, field)):
                            false
                        else:
                            status = "invalid_run"
                else:
                    if (status == "supported"):
                        status = "insufficient_evidence"
                j = (j + 1)
            rt_push(findings, v_finding("configuration_isolation", status, "Frozen domains compared independently of outcomes", dv_single(runs[i].manifest)))
        rt_push(reports, {"source": runs[i], "report": run.report, "loaded": run})
        i = (i + 1)
    if (rt_count(runs) < 2):
        rt_push(findings, v_finding("comparison_window", "not_observed", "At least two separately frozen formal sessions required", []))
    var actual = v_actual_isolation(configuration, mode, reports)
    var j = 0
    while (j < rt_count(actual)):
        rt_push(findings, actual[j])
        j = (j + 1)
    rt_push(findings, v_comparison_contract(configuration, mode))
    if (mode == "capability"):
        rt_push(findings, v_compare_effect(configuration, mode, reports, v_outcome_differences(reports)))
    else:
        var extra = v_supplement_findings(configuration, mode, reports)
        var j = 0
        while (j < rt_count(extra)):
            rt_push(findings, extra[j])
            j = (j + 1)
    return {"mode": mode, "configuration": configuration, "findings": findings, "runs": v_public_reports(reports)}

fn v_compare_main(mode):
    dv_require((rt_arg_count() == 1), "Usage: comparison-entry comparison.json")
    return rt_print(rt_json_stringify(v_compare(rt_json_parse(rt_read(rt_arg(0))), mode)))

fn v_comparison_contract(configuration, mode):
    var status = "supported"
    var reason = "Prior approved variant scope and required frozen domains present"
    var required = dv_list3("initial", "axioms", "cost_model")
    var fields = dv_find(configuration, "frozen_fields", [])
    var i = 0
    if dv_and(dv_has_key(configuration, "approval_ref"), dv_has_key(configuration, "allowed_variants")):
        false
    else:
        status = "insufficient_evidence"
    while (i < rt_count(required)):
        if dv_has(fields, required[i]):
            false
        else:
            status = "insufficient_evidence"
        i = (i + 1)
    if (mode == "capability"):
        if dv_same(dv_find(configuration, "variable_fields", []), dv_single("capability")):
            false
        else:
            status = "invalid_run"
    else:
        if (mode == "evidence_boundary"):
            if dv_has_key(configuration, "legal_propagation_variants"):
                false
            else:
                status = "insufficient_evidence"
        else:
            if dv_and(dv_and(dv_has_key(configuration, "approved_ranges"), dv_has_key(configuration, "neighborhood")), dv_and(dv_has_key(configuration, "reserve_set"), dv_has_key(configuration, "random_stream_contract"))):
                false
            else:
                status = "insufficient_evidence"
    return v_finding("approved_configuration_contract", status, reason, dv_single(dv_find(configuration, "approval_ref", false)))

fn v_findings_named(report, id):
    var items = report.findings
    var i = 0
    var result = []
    while (i < rt_count(items)):
        if (items[i].id == id):
            if dv_or((id == "literal_truth"), dv_or((id == "epistemic_support"), (id == "causal_completeness"))):
                if (dv_find(items[i], "phase", "") == "answer"):
                    rt_push(result, items[i])
            else:
                rt_push(result, items[i])
        i = (i + 1)
    return result

fn v_last_finding(report, id):
    var items = v_findings_named(report, id)
    if (rt_count(items) == 0):
        return []
    else:
        return items[(rt_count(items) - 1)]

fn v_outcome_differences(reports):
    var result = []
    var i = 1
    var names = dv_list3("literal_truth", "epistemic_support", "causal_completeness")
    rt_push(names, "formal_answer_validity")
    rt_push(names, "ready_deadline")
    while (i < rt_count(reports)):
        var j = 0
        var left = reports[0].report
        var right = reports[i].report
        while (j < rt_count(names)):
            var id = names[j]
            var a = v_last_finding(left, names[j])
            var b = v_last_finding(right, names[j])
            rt_push(result, {"axis": id, "baseline": a, "variant": b, "difference_observed": (not dv_same(dv_find(a, "status", false), dv_find(b, "status", false)))})
            j = (j + 1)
        i = (i + 1)
    return result

fn v_last_question_finding(report, id, question):
    var items = report.findings
    var i = 0
    var found = []
    while (i < rt_count(items)):
        var item = items[i]
        if dv_and((item.id == id), (dv_find(item, "question_id", "") == question)):
            found = item
        i = (i + 1)
    return found

fn v_main_causal_supported(report, oracle):
    var required = dv_find(oracle, "milestones", [])
    var i = 0
    var valid = (0 < rt_count(dv_find(oracle, "milestones", [])))
    while (i < rt_count(required)):
        valid = dv_and(valid, (dv_find(v_last_finding(report, required[i].id), "status", "") == "supported"))
        i = (i + 1)
    valid = dv_and(valid, (dv_find(v_last_finding(report, "run_integrity"), "status", "") == "supported"))
    valid = dv_and(valid, (dv_find(v_last_question_finding(report, "causal_completeness", dv_find(oracle, "target_question_id", "")), "status", "") == "supported"))
    valid = dv_and(valid, (dv_find(v_last_question_finding(report, "formal_answer_validity", dv_find(oracle, "target_question_id", "")), "status", "") == "supported"))
    var items = report.findings
    var j = 0
    while (j < rt_count(items)):
        var f = items[j]
        if dv_or(dv_has(dv_list3("action_cost_settlement", "observation_provenance", "formal_answer_validity"), f.id), v_extended_provenance_id(f.id)):
            valid = dv_and(valid, (f.status == "supported"))
        j = (j + 1)
    return valid

fn v_compare_effect(configuration, mode, reports, differences):
    var status = "not_observed"
    var reason = "No final compared axis difference observed"
    var i = 0
    var changed = false
    while (i < rt_count(differences)):
        if differences[i].difference_observed:
            changed = true
        i = (i + 1)
    if changed:
        status = "insufficient_evidence"
        reason = "Actual axis differences recorded, but causal result or legal isolation lacks evidence"
    if dv_and(dv_and(v_actual_isolation_valid(configuration, mode, reports), v_variants_frozen(configuration, mode, reports)), dv_and((v_comparison_contract(configuration, mode).status == "supported"), (1 < rt_count(reports)))):
        var left = reports[0].report
        var right = reports[1].report
        var base_run = reports[0].loaded
        var next_run = reports[1].loaded
        if (mode == "capability"):
            if dv_and(dv_and((dv_find(v_last_finding(left, "run_integrity"), "status", "") == "supported"), (dv_find(v_last_finding(left, "epistemic_support"), "status", "") == "supported")), dv_and((dv_find(v_last_finding(left, "literal_truth"), "status", "") == "supported"), dv_and((dv_find(v_last_finding(left, "causal_completeness"), "status", "") == "violated"), v_main_causal_supported(right, next_run.oracle)))):
                status = "supported"
                reason = "Approved isolated capability variant supplies the independently checked causal result missing from literal-correct baseline"
        else:
            if dv_and(v_main_causal_supported(left, base_run.oracle), v_main_causal_supported(right, next_run.oracle)):
                var a = v_last_finding(left, "ready_deadline")
                var b = v_last_finding(right, "ready_deadline")
                if dv_and((dv_find(a, "status", "") == "supported"), (dv_find(b, "status", "") == "supported")):
                    var ta = (a.ready_game_time - a.first_acceptance_game_time)
                    var tb = (b.ready_game_time - b.first_acceptance_game_time)
                    var local_1 = false
                    if (tb < ta):
                        local_1 = "supported"
                    else:
                        local_1 = "not_observed"
                    status = local_1
                    var local_2 = false
                    if (tb < ta):
                        local_2 = "Main causal contracts supported under approved isolated variant, with earlier exact scoped readiness"
                    else:
                        local_2 = "Main causal contracts supported, but no earlier scoped readiness observed"
                    reason = local_2
    return dv_with(v_finding("causal_improvement", status, reason, []), "outcome_differences", differences)

fn v_variants_frozen(configuration, mode, reports):
    var i = 0
    var valid = true
    var baseline = []
    var fields = dv_find(configuration, "frozen_fields", [])
    while (i < rt_count(reports)):
        var run = reports[i].loaded
        var manifest = run.manifest
        var j = 0
        if (i == 0):
            baseline = manifest
        else:
            while (j < rt_count(fields)):
                var key = fields[j]
                if (key == "initial"):
                    false
                else:
                    valid = dv_and(valid, dv_and(dv_has_key(baseline, key), dv_has_key(manifest, key)))
                    if dv_and(dv_has_key(baseline, key), dv_has_key(manifest, key)):
                        valid = dv_and(valid, dv_same(dv_get(baseline, key), dv_get(manifest, key)))
                j = (j + 1)
        if (mode == "parameter_neighborhood"):
            var target = dv_find(configuration, "target_actor", dv_find(dv_find(manifest, "capability", []), "actor", ""))
            var actors = run.trace.initial.actors
            var k = 0
            var value = false
            var range = dv_find(dv_find(configuration, "approved_ranges", []), "information_weight", [])
            while (k < rt_count(actors)):
                if (actors[k].id == target):
                    value = dv_find(actors[k].policy, "information_weight", false)
                k = (k + 1)
            if dv_or(dv_same(value, false), (rt_count(range) == 0)):
                valid = false
            else:
                var local_1 = false
                if dv_record_like(range):
                    local_1 = range.minimum
                else:
                    local_1 = range[0]
                var minimum = local_1
                var local_2 = false
                if dv_record_like(range):
                    local_2 = range.maximum
                else:
                    local_2 = range[1]
                var maximum = local_2
                valid = dv_and(valid, dv_and((not (value < minimum)), (not (maximum < value))))
                valid = dv_and(valid, dv_or(dv_has(dv_find(configuration, "neighborhood", []), value), dv_has(dv_find(configuration, "reserve_set", []), value)))
        i = (i + 1)
    return valid

fn v_public_reports(reports):
    var public = []
    var i = 0
    while (i < rt_count(reports)):
        rt_push(public, {"source": reports[i].source, "report": reports[i].report})
        i = (i + 1)
    return public

// ---- Merged source module: 16-milestone-semantics.dv ----
// Milestone occurrence, ordering and semantic evidence are separate checks.

fn v_milestone_semantics(manifest, trace, oracle, spec, event):
    var kind = dv_find(spec, "semantic_kind", "")
    var data = event.data
    var status = "insufficient_evidence"
    var reason = "节点只有事件类型记录；尚缺其真实语义验收绑定"
    var refs = dv_single(event.id)
    var events = v_events(trace)
    if (kind == ""):
        if (event.type == "speech_literal"):
            kind = "legal_opening"
        else:
            if (event.type == "observation"):
                kind = "new_observation"
            else:
                if (event.type == "answer_ready"):
                    kind = "ready_argument"
    if (kind == "formal_answer"):
        if (event.type == "answer_submitted"):
            var axes = v_axis_bundle(manifest, trace, event, oracle)
            var local_1 = false
            if dv_and(v_axis_supported(axes, "literal_truth"), dv_and(v_axis_supported(axes, "epistemic_support"), v_axis_supported(axes, "causal_completeness"))):
                local_1 = "supported"
            else:
                local_1 = "insufficient_evidence"
            status = local_1
            reason = "精确答案提交已发生；独立核该问题字面、本人来源及完整因果，不能以其他题目或子题替代"
        else:
            var validation = v_answer_validation(manifest, trace, event)
            status = validation.status
            reason = validation.reason
    if (kind == "genuine_rejection"):
        var validation = v_answer_validation(manifest, trace, event)
        var submit = v_parent_submission(events, event)
        if (0 < rt_count(submit)):
            var axes = dv_find(validation, "axes", [])
            var action = v_submission_action(submit)
            if dv_and((validation.status == "supported"), dv_and((dv_find(axes, "literal_truth", "unknown") == "true"), (dv_find(axes, "question_match", "unknown") == "true"))):
                if dv_or((dv_find(axes, "answer_complete", "unknown") == "false"), (not (dv_find(axes, "epistemic_support", "unknown") == "true"))):
                    status = "supported"
        reason = "真缺口驳回须是当前题目相关的真实字面命题，正式拒绝其未完成论证或缺本人来源；错题真陈述不替代此节点"
    if (kind == "legal_opening"):
        var context = v_context_event(events, event)
        var misunderstood = false
        var differentiated = false
        var i = 0
        var statuses = []
        while (i < rt_count(events)):
            var candidate = events[i]
            var cd = events[i].data
            if dv_and((candidate.type == "implicature"), (dv_find(cd, "source_event", "") == event.id)):
                if (v_interpretation_check(trace, candidate).status == "supported"):
                    if dv_and((dv_find(cd, "status", "") == "accepted"), dv_find(dv_find(cd, "scope_check", []), "gap", false)):
                        misunderstood = true
                    if dv_has(statuses, dv_find(cd, "status", "")):
                        false
                    else:
                        if (0 < rt_count(statuses)):
                            differentiated = true
                        rt_push(statuses, dv_find(cd, "status", ""))
            i = (i + 1)
        if dv_and(v_source_delivery(trace, event), dv_and(misunderstood, differentiated)):
            var axes = v_axis_bundle(manifest, trace, context, oracle)
            if dv_and(v_axis_supported(axes, "literal_truth"), v_axis_supported(axes, "epistemic_support")):
                status = "supported"
        reason = "合法开场需真实真话及说话者来源，还须实际听者采纳了缺桥接暗示，且不同本人出现经重算验证的理解或采纳差异"
    if (kind == "new_observation"):
        if dv_has_key(spec, "requirement"):
            var requirement = spec.requirement
            if dv_and(v_observation_verified(trace, event.id), dv_and((not (dv_truth(data.mind_before, requirement) == "true")), dv_and((dv_truth(data.mind_after, requirement) == "true"), v_support(trace, data.mind_after, event.actor, requirement, [])))):
                status = "supported"
                reason = "真实新观察把所需认知从未建立变为本人有来源的支持；重复看已有事实不替代新证据"
        else:
            reason = "观察投映可以独立核验，但oracle尚未绑定需要新增的证据命题，不能把任意观察称为修正节点"
    if (kind == "serious_wrong_model_use"):
        if dv_and((event.type == "mind_simulation"), dv_and(v_model_verified(manifest, trace, event.id), dv_and(v_wrong_model_used(trace, event), v_wrong_new_refutation(manifest, trace, event)))):
            status = "supported"
        reason = "真实选中假说推动付费方法与验证选择；本次完整执行产生确定预测，后续独立新观察重核其矛盾；先验标签、枚举、未知或计算截断不计为一次错误"
    if (kind == "serious_wrong_hypothesis"):
        var current = dv_find(data, "current", [])
        var serious = false
        var refuted = false
        var i = 0
        if rt_is_list(current):
            if (0 < rt_count(current)):
                while (i < rt_count(events)):
                    var candidate = events[i]
                    var cd = events[i].data
                    if (candidate.actor == event.actor):
                        if (candidate.type == "mind_simulation"):
                            if (dv_find(dv_find(cd, "hypothesis", []), "id", "") == current.id):
                                if dv_and(v_model_verified(manifest, trace, candidate.id), v_ancestor(events, candidate.id, event.id)):
                                    serious = true
                        else:
                            if (candidate.type == "model_recheck"):
                                var old = dv_find(cd, "model_before", [])
                                var actual = v_model_result(candidate)
                                if dv_and(v_model_verified(manifest, trace, candidate.id), (dv_find(actual, "status", "unknown") == "inconsistent")):
                                    var original = v_event(events, dv_find(old, "paid_model_event", dv_find(old, "event", "")))
                                    if (dv_find(dv_find(dv_find(original, "data", []), "hypothesis", []), "id", "") == current.id):
                                        refuted = true
                    i = (i + 1)
        if dv_and(serious, refuted):
            status = "supported"
        reason = "认真错误假说需要本人真实选择后付费重演同一假说，并被后续真实观测重核为不一致；偏好标签或错误答案本身不作证"
    if (kind == "ready_argument"):
        status = v_ready_deadline(manifest, trace, oracle).status
        reason = "目标就绪必须有实际付费完整模型、本人来源及全题论证，另核运行起点总预算"
    if (kind == "sharing_withdrawal"):
        var origin = v_origin_execution(events, event)
        var targets = []
        var i = 0
        var valid = true
        var adopted = false
        if (0 < rt_count(origin)):
            targets = dv_find(origin.data.action, "listeners", [])
        else:
            valid = false
        if (rt_count(targets) == 0):
            valid = false
        while (i < rt_count(targets)):
            var actor = targets[i]
            var j = 0
            var prior_accepted = false
            var withdrawn = false
            while (j < rt_count(events)):
                var candidate = events[j]
                var cd = events[j].data
                if (candidate.actor == actor):
                    if (candidate.type == "implicature"):
                        if dv_and(dv_and((dv_find(cd, "status", "") == "accepted"), dv_find(dv_find(cd, "scope_check", []), "gap", false)), dv_and(v_event_precedes(events, candidate, event), (v_interpretation_check(trace, candidate).status == "supported"))):
                            prior_accepted = true
                    else:
                        if (candidate.type == "implicature_withdrawn"):
                            if (0 < rt_count(origin)):
                                var local_2 = false
                                if dv_has_key(cd, "proposal"):
                                    local_2 = v_proposal_withdrawn_gap(candidate)
                                else:
                                    local_2 = dv_find(dv_find(dv_find(dv_find(cd, "interpretations_before", []), dv_find(cd, "id", ""), []), "scope_check", []), "gap", false)
                                if dv_and(dv_and(v_ancestor(events, candidate.id, origin.id), (v_interpretation_check(trace, candidate).status == "supported")), local_2):
                                    withdrawn = true
                j = (j + 1)
            if prior_accepted:
                adopted = true
                valid = dv_and(valid, withdrawn)
            i = (i + 1)
        if dv_and(v_source_delivery(trace, event), dv_and(adopted, valid)):
            status = "supported"
        reason = "对真实分享听者逐人追溯其先前实际采纳，已采纳者须因该真实分享执行的新证据撤销；撤销P不写入not P"
    var required = dv_find(spec, "causal_after", [])
    var i = 0
    while (i < rt_count(required)):
        if v_ancestor(events, event.id, required[i]):
            false
        else:
            status = "insufficient_evidence"
            reason = "该语义绑定需要的真实来源前驱未记录，不能以全局顺序替代因果来源"
        i = (i + 1)
    return dv_with(dv_with(v_finding("milestone_semantics", status, reason, refs), "actor", event.actor), "action", kind)

fn v_select_milestone(manifest, trace, oracle, spec, chosen):
    var events = v_events(trace)
    var found = []
    var i = 0
    var after = dv_find(spec, "after", [])
    while dv_and((rt_count(found) == 0), (i < rt_count(events))):
        var event = events[i]
        var eligible = true
        var j = 0
        eligible = dv_and((event.type == spec.type), dv_or((dv_find(spec, "actor", "") == ""), (event.actor == spec.actor)))
        if eligible:
            eligible = v_spec_scope(events, spec, event)
        while dv_and(eligible, (j < rt_count(after))):
            var prior = dv_find(chosen, after[j], [])
            if (rt_count(prior) == 0):
                eligible = false
            else:
                eligible = v_event_precedes(events, prior, event)
            j = (j + 1)
        if eligible:
            if (v_milestone_semantics(manifest, trace, oracle, spec, event).status == "supported"):
                found = event
        i = (i + 1)
    if (0 < rt_count(found)):
        return found
    else:
        return v_first_after(events, spec, chosen)

fn v_wrong_probe_refs(hypothesis):
    var features = dv_find(hypothesis, "features", [])
    var refs = []
    var i = 0
    while (i < rt_count(features)):
        var feature = features[i]
        var local_1 = false
        if dv_has_key(feature, "proposition"):
            local_1 = feature.proposition
        else:
            local_1 = feature
        refs = dv_explanation_merge(refs, v_model_sim_refs(dv_find(feature, "observation", local_1)))
        i = (i + 1)
    return refs

fn v_wrong_model_used(trace, event):
    var events = v_events(trace)
    var origin = v_origin_execution(v_events(trace), event)
    var hypothesis = dv_find(event.data, "hypothesis", [])
    var selected = []
    var choice = []
    var adopted = false
    var verified_choice = false
    var i = 0
    var result = v_model_result(event)
    if (0 < rt_count(origin)):
        var ancestors = v_ancestors(events, origin.id)
        while (i < rt_count(events)):
            var candidate = events[i]
            var data = events[i].data
            if dv_and((candidate.actor == event.actor), dv_has(ancestors, candidate.id)):
                if dv_has(dv_pair("hypothesis_adopted", "hypothesis_revised"), candidate.type):
                    if dv_same(v_record_without(dv_find(data, "current", []), dv_single("simulation")), hypothesis):
                        adopted = true
                if (candidate.type == "action_selected"):
                    if dv_same(data.action, origin.data.action):
                        selected = candidate
                if (candidate.type == "planning_choice"):
                    if dv_same(dv_find(data, "action", false), origin.data.action):
                        choice = candidate
            i = (i + 1)
        if dv_and((0 < rt_count(selected)), (0 < rt_count(choice))):
            var data = choice.data
            var path = dv_find(choice.data, "selected_path", [])
            var plans = dv_find(choice.data, "plans", [])
            var j = 0
            while (j < rt_count(plans)):
                var plan = plans[j]
                if dv_and(dv_same(plan.path, path), dv_and((0 < rt_count(path)), (path[0] == origin.data.action.id))):
                    if dv_and(dv_same(plan.probe_refs, v_wrong_probe_refs(hypothesis)), dv_and((0 < dv_find(plan.value, "verification", 0)), (dv_find(dv_find(dv_find(selected.data, "hypothesis", []), "simulation", []), "status", "") == "stale-or-unavailable"))):
                        verified_choice = true
                j = (j + 1)
            verified_choice = dv_and(verified_choice, dv_same(v_record_without(dv_find(selected.data, "hypothesis", []), dv_single("simulation")), hypothesis))
    return dv_and(adopted, dv_and(verified_choice, dv_and((dv_find(dv_find(dv_find(origin, "data", []), "action", []), "kind", "") == "replay"), dv_and((dv_find(dv_find(dv_find(dv_find(origin, "data", []), "receipt", []), "execution", []), "status", "") == "applied"), dv_and(dv_find(result, "plan_complete", false), dv_and((rt_count(dv_find(result, "failures", [])) == 0), dv_and((0 < dv_find(result, "expanded", 0)), dv_and((not (dv_find(result, "remaining", -1) < 0)), dv_and((rt_count(dv_find(result, "predictions", [])) == rt_count(dv_find(result, "comparisons", []))), (rt_count(dv_find(result, "contradictions", [])) == 0))))))))))

fn v_wrong_new_refutation(manifest, trace, event):
    var events = v_events(trace)
    var old = v_model_result(event)
    var predictions = dv_find(v_model_result(event), "predictions", [])
    var i = 0
    var found = false
    while (i < rt_count(events)):
        var candidate = events[i]
        var data = events[i].data
        if dv_and((candidate.actor == event.actor), (candidate.type == "model_recheck")):
            if dv_and(v_model_verified(manifest, trace, candidate.id), dv_and(v_ancestor(events, candidate.id, event.id), (dv_find(dv_find(data, "model_before", []), "paid_model_event", dv_find(dv_find(data, "model_before", []), "event", "")) == event.id))):
                var comparisons = dv_find(v_model_result(candidate), "comparisons", [])
                var j = 0
                while (j < rt_count(comparisons)):
                    var comparison = comparisons[j]
                    var k = 0
                    if (dv_find(comparison, "result", "") == "contradiction"):
                        while (k < rt_count(predictions)):
                            var prediction = predictions[k]
                            if dv_and(dv_same(prediction.feature, comparison.feature), dv_and(prediction.covered, dv_and(dv_has(dv_pair("true", "false"), prediction.prediction), (prediction.prediction == comparison.prediction)))):
                                var n = 0
                                while (n < rt_count(events)):
                                    var observation = events[n]
                                    var od = events[n].data
                                    if dv_and((observation.actor == event.actor), dv_and(dv_has(dv_pair("observation", "listener_parse"), observation.type), dv_and(v_event_precedes(events, event, observation), v_ancestor(events, candidate.id, observation.id)))):
                                        var local_1 = false
                                        if (observation.type == "observation"):
                                            local_1 = v_observation_verified(trace, observation.id)
                                        else:
                                            local_1 = v_reception_verified(trace, observation.id)
                                        if local_1:
                                            var p = dv_find(prediction.feature, "observation", prediction.proposition)
                                            var physical = v_authority_before(trace, event)
                                            var local_2 = false
                                            if (0 < rt_count(physical)):
                                                local_2 = (dv_truth(physical, v_physical_proposition(p, dv_find(dv_find(trace, "configuration", []), "bindings", []), od.mind_after.subject)) == comparison.observation)
                                            else:
                                                local_2 = false
                                            var local_3 = false
                                            if (comparison.observation == "true"):
                                                local_3 = p
                                            else:
                                                local_3 = dv_not(p)
                                            if dv_and(local_2, dv_and((dv_truth(od.mind_after, p) == comparison.observation), dv_and((not (dv_truth(od.mind_before, p) == comparison.observation)), v_support(trace, od.mind_after, event.actor, local_3, [])))):
                                                found = true
                                    n = (n + 1)
                            k = (k + 1)
                    j = (j + 1)
        i = (i + 1)
    return found
