// Executable mechanism specimen. Resource units and alternatives belong to this specimen,
// not to chapter one or its characters. No story state is imported.
imprint rebalance_cognition(state, goal, variables, laws, prices):
    require capability state.imprint_allowed
    achieve goal
    vary variables
    conserve using laws
    limit using state
    minimize using prices

fn cognitive_specimen():
    let state = {subject: "specimen", revision: 0, imprint_allowed: true, balances: ["10"], values: ["0.2", "0.8"], levels: [["held", 0], ["accepted", 0.6]], search_budget: 9, work_remaining: 18}
    let variables = [
        {name: "support", options: [{value: "0.2", cost: ["0"]}, {value: "0.6", cost: ["2"]}, {value: "0.8", cost: ["5"]}]},
        {name: "counterweight", options: [{value: "0.8", cost: ["0"]}, {value: "0.4", cost: ["1"]}, {value: "0.2", cost: ["1"]}]}
    ]
    let goal = {coefficients: ["1", "0"], minimum: "0.6"}
    let laws = [{coefficients: ["1", "1"], total: "1"}]
    let prices = ["1"]
    let result = rebalance_cognition(state, goal, variables, laws, prices)
    let committed = dv_imprint_commit(state, result, goal, variables, laws, state, prices, "external-imprint")
    let restored = rt_json_parse(rt_json_stringify(result))
    let restored_valid = dv_imprint_check(restored, goal, variables, laws, state, prices)
    let forged = dv_with(result, "best", dv_with(result.best, "cost", rt_exact("0")))
    let exhausted = dv_with(state, "work_remaining", 4)
    let stopped = rebalance_cognition(exhausted, goal, variables, laws, prices)
    let stopped_receipt = dv_imprint_commit(exhausted, stopped, goal, variables, laws, exhausted, prices, "limited-imprint")
    return {restored_certificate_accepted: restored_valid, before: state, solved: result, committed: committed, forged_certificate_accepted: dv_imprint_check(forged, goal, variables, laws, state, prices), exhausted: stopped_receipt, later_degree: dv_acceptance_classify(rt_exact("0.2"), state.levels)}

fn cognitive_mind_specimen():
    var mind = dv_world("specimen-mind", "mind", "specimen")
    mind = dv_add_object(mind, dv_object("slice", "perceived", {cognition: {support: dv_cell(0.2, 1, 0, []), counterweight: dv_cell(0.8, 1, 0, [])}}))
    let physical = dv_world("specimen-world", "physical", "")
    let ledger = dv_action_cost_ledger("specimen-account", dv_action_cost_vector(10, 10, 10))
    let refs = [dv_scoped_ref("specimen", "slice", "cognition", "support"), dv_scoped_ref("specimen", "slice", "cognition", "counterweight")]
    let state = dv_imprint_prepare(mind, refs, ledger, 18, [["held", 0], ["accepted", 0.6]], 9, true)
    let variables = [
        {name: "support", options: [{value: "0.2", cost: [0, 0, 0]}, {value: "0.6", cost: [0, 0, 2]}, {value: "0.8", cost: [0, 0, 5]}]},
        {name: "counterweight", options: [{value: "0.8", cost: [0, 0, 0]}, {value: "0.4", cost: [0, 0, 1]}, {value: "0.2", cost: [0, 0, 1]}]}
    ]
    let goal = {coefficients: [1, 0], minimum: "0.6"}
    let laws = [{coefficients: [1, 1], total: 1}]
    let prices = [1, 1, 1]
    let plan = rebalance_cognition(state, goal, variables, laws, prices)
    let execution = dv_imprint_apply(mind, physical, ledger, state, plan, goal, variables, laws, prices, "specimen-imprint-1")
    return {before_mind: mind, before_ledger: ledger, execution: execution, stored_support: dv_read(execution.mind, refs[0]), stored_counterweight: dv_read(execution.mind, refs[1])}
