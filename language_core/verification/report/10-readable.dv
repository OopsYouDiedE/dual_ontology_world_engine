(defn dvr_label (id)
  (let (labels (rt_list)) (do
    (rt_push labels (dv_pair "formal_answer_validity" "正式回答接受或拒绝的独立合法性"))
    (rt_push labels (dv_pair "utterance_causal_scope" "话语的因果适用范围"))
    (rt_push labels (dv_pair "speech_reception_boundary" "话语接收与本人认知边界"))
    (rt_push labels (dv_pair "run_start_time_answer_submitted" "运行起点至实际提交的总预算"))
    (rt_push labels (dv_pair "run_start_time_answer_accepted" "运行起点至实际接受的总预算"))
    (rt_push labels (dv_pair "run_start_time_speech_literal" "运行起点至公开分享的总预算"))
    (rt_push labels (dv_pair "question_match" "是否回答当前问题"))
    (rt_push labels (dv_pair "answer_complete" "回答是否完整"))
    (rt_push labels (dv_pair "accepted_law_ready" "正式接受法则是否可执行"))
    (rt_push labels (dv_pair "observation_provenance" "观察授权、投影与本人更新"))
    (rt_push labels (dv_pair "action_cost" "冻结动作报价与实际结算"))
    (rt_push labels (dv_pair "actual_initial_isolation" "真实初始状态隔离"))
    (rt_push labels (dv_pair "approved_configuration_contract" "批准配置的精确合同"))
    (dv_find labels id (dvr_legacy_label id)))))
(defn dvr_reason (reason)
  (let (labels (rt_list)) (do
    (rt_push labels (dv_pair "Required causal predecessor not an ancestor" "要求的前驱事件虽有记录，却不在当前事件的实际因果祖先链中。"))
    (rt_push labels (dv_pair "Actual execution origin, authorized grants and immutable mind snapshots required" "需补齐真实执行来源、授权观察范围及不可变认知前后快照，才能独立核对。"))
    (rt_push labels (dv_pair "New read-only DV checker contract over unchanged historical traces; not fresh sessions" "本节以新只读DV判定合同重判同一封存轨迹；不是再次游玩。"))
    (rt_push labels (dv_pair "Recomputed structured literal at its recorded authority anchor" "按记录中的权威状态锚点重新计算了结构化字面命题。"))
    (rt_push labels (dv_pair "Answer causality is not applicable to an opening expression; implicature is audited separately" "开场表达不属于正式回答因果链；可撤销语用推断另行核对。"))
    (rt_push labels (dv_pair "Required first acceptance or independent ready event absent" "没有记录首次接受或独立的准备完成事件，因此没有对应时限证据。"))
    (rt_push labels (dv_pair "Question-specific causal and competing-explanation requirements; no confidence shortcut" "按当前题目的因果要求与竞争解释逐项核对；置信度不能代替缺失的依据。"))
    (rt_push labels (dv_pair "budget-exhausted" "剩余累计时间或资源不足原动作报价，按预算门禁停止。"))
    (dv_find labels reason (dvr_legacy_reason reason)))))
; Human-readable presentation of sealed findings and actual trace events.
; This module never advances a session, changes a mind or replaces a verdict.
(defn dvr_status (status)
  (dv_find (dv_m4 "supported" "已有具体证据支持" "violated" "实际结果与要求矛盾"
    "not_observed" "本次记录窗口未发生" "insufficient_evidence" "依据或记录不足，不能确定") status
    (if (rt_eq status "invalid_run") "本轮证据不可作为有效比较" status)))
(defn dvr_labels ()
  (dv_m4 "run_integrity" "源码与事件封存"
    "first_answer" "首个正式回答被接受"
    "ready_deadline" "充分推理的时限"
    "causal_improvement" "变化是否产生所要求的因果效果"))
(defn dvr_legacy_label (id)
  (dv_find (dv_m4 "hypothesis_adopted" "认真采纳假说" "ready" "推理达到提交准备条件"
    "second_submit" "再次正式提交" "sharing" "接受后公开分享") id
  (dv_find (dv_m4 "second_accept" "后续正式回答被接受" "revised_reasoning" "依据新证据重新推理" "hypothesis_revised" "修正假说" "original_motive" "原有动机") id
  (dv_find (dvr_labels) id
    (dv_find (dv_m4 "opening" "开场表达" "genuine_rejection" "真实缺口导致正式拒答"
      "new_evidence" "正式调查取得新证据" "second_answer" "后续完整回答被接受") id
      (dv_find (dv_m4 "literal_truth" "字面命题是否为真" "epistemic_support" "本人是否具有可知依据"
        "causal_completeness" "回答是否覆盖所问因果" "formal_acceptance" "正式回答是否合法接受") id id))))))
(defn dvr_legacy_reason (reason)
  (dv_find (dv_m4 "Required event did not occur in recorded window" "本次完整轨迹没有发生要求的事件。"
    "Required predecessor not recorded" "虽然出现后续事件，但要求的实际因果前驱没有记录。"
    "Observed with causal predecessors" "要求的事件实际发生，且所需因果前驱已有记录。"
    "Unique events and explicit earlier causal parents" "事件身份唯一，显式因果前驱均指向更早的真实事件。") reason
  (dv_find (dv_m4 "unasked-topic" "这句话没有回答当前所问，即使字面正确也应拒绝。"
    "incomplete-answer" "已知事实仍不能补齐正式回答要求；需要继续获得缺失证据。"
    "insufficient-source" "本人尚无足以提交这句话的来源支持。"
    "literal-not-established" "真实状态没有确立这句话为真。") reason
    (dv_find (dv_m4 "protocol-transition-not-ready" "正式接受规则尚不可执行，不能推进题目。"
      "undeclared-answer" "提交没有对应的冻结正式回答定义。"
      "no-admissible-action-or-budget" "选择器没有选出可继续执行的正收益动作；是否存在预算限制另看私有诊断。"
      "action-window-exhausted" "本轮声明的正式动作窗口已结束。") reason reason))))
(defn dvr_add (lines text) (rt_push lines text))
(defn dvr_join (values separator)
  (let (i 0 text "")
    (do (while (rt_lt i (rt_count values))
      (do (if (rt_lt 0 i) (set text (rt_cat text separator)) false)
        (set text (rt_cat text (rt_at values i))) (set i (rt_add i 1)))) text)))
(defn dvr_time (time)
  (if (rt_eq time false) "未记录/未发生" (rt_cat (rt_show time) "游戏分钟")))
(defn dvr_refs (refs)
  (if (rt_lt 4 (rt_count refs))
    (let (short (rt_list) i 0) (do (while (rt_lt i 4) (do (rt_push short (rt_at refs i)) (set i (rt_add i 1))))
      (rt_cat (rt_json_stringify short) "，其余完整引用见该节原始判定JSON。")))
    (rt_json_stringify refs)))
(defn dvr_clock (time)
  (let (hours 0 minutes time) (do (while (rt_eq (rt_lt minutes 60) false) (do (set hours (rt_add hours 1)) (set minutes (rt_sub minutes 60))))
    (rt_cat (rt_cat (rt_show hours) ":") (rt_cat (if (rt_lt minutes 10) "0" "") (rt_show minutes))))))
(defn dvr_node_time (time start)
  (if (rt_eq time false) "未记录/未发生"
    (rt_cat (rt_cat "运行起点经过" (rt_show (rt_sub time start))) (rt_cat "分钟；场景时钟" (dvr_clock time)))))
(defn dvr_finding (lines finding start)
  (let (id (dv_get finding "id") status (dv_get finding "status") reason (dv_find finding "reason_zh" (dv_find finding "reason" "没有记录具体理由")))
    (do
      (dvr_add lines (rt_cat (rt_cat (rt_cat "- **" (dvr_label id)) (rt_cat "：" (if (dv_and (rt_eq id "literal_truth") (rt_eq status "violated")) "客观字面不成立；是否允许发言另看正式契约" (dvr_status status)))) "**"))
      (dvr_add lines (rt_cat "  " (dvr_reason reason)))
      (if (dv_has_key finding "actor") (dvr_add lines (rt_cat "  主体：" (rt_json_stringify (dv_get finding "actor")))) false)
      (if (dv_has_key finding "action") (dvr_add lines (rt_cat "  真实行动：" (rt_json_stringify (dv_get finding "action")))) false)
      (if (dv_has_key finding "basis") (dvr_add lines (rt_cat "  本人依据：" (rt_json_stringify (dv_get finding "basis")))) false)
      (if (dv_has_key finding "first_game_time") (dvr_add lines (rt_cat "  首次时刻：" (dvr_node_time (dv_get finding "first_game_time") start))) false)
      (dvr_add lines (rt_cat "  证据引用：" (dvr_refs (dv_find finding "evidence_refs" (rt_list)))))
      (dvr_add lines ""))))
(defn dvr_primary_ids ()
  (let (ids (rt_list)) (do
    (rt_push ids "run_integrity") (rt_push ids "opening") (rt_push ids "first_answer") (rt_push ids "genuine_rejection")
    (rt_push ids "hypothesis_adopted") (rt_push ids "new_evidence") (rt_push ids "revised_reasoning") (rt_push ids "second_answer")
    (rt_push ids "implicature_withdrawn") (rt_push ids "ready_deadline") (rt_push ids "comparison_window")
    (rt_push ids "approved_configuration_contract") (rt_push ids "configuration_isolation") (rt_push ids "actual_initial_isolation")
    (rt_push ids "causal_improvement") ids)))
(defn dvr_primary_id (id) (dv_has (dvr_primary_ids) id))
(defn dvr_event_types ()
  (let (types (rt_list)) (do
    (rt_push types "action_execution") (rt_push types "answer_accepted") (rt_push types "answer_rejected")
    (rt_push types "ready") (rt_push types "inference") (rt_push types "hypothesis_adopted") (rt_push types "hypothesis_revised") types)))
(defn dvr_overlap (a b)
  (let (i 0 overlap false) (do (while (rt_lt i (rt_count a))
    (do (if (dv_has b (rt_at a i)) (set overlap true) false) (set i (rt_add i 1)))) overlap)))
(defn dvr_findings (lines report start)
  (let (findings (dv_find report "findings" (rt_list)) i 0 seen (rt_list) first_refs (rt_list) second_refs (rt_list))
    (do (while (rt_lt i (rt_count findings))
      (let (finding (rt_at findings i) signature (rt_json_stringify (rt_at findings i)))
        (do (if (rt_eq (dv_get finding "id") "first_answer") (set first_refs (dv_find finding "evidence_refs" (rt_list))) false)
          (if (rt_eq (dv_get finding "id") "second_accept") (set second_refs (dv_find finding "evidence_refs" (rt_list))) false)
          (if (dv_or (dvr_primary_id (dv_get finding "id")) (rt_not (rt_eq (dv_get finding "status") "supported")))
            (if (dv_has seen signature) false (do (rt_push seen signature) (dvr_finding lines finding start))) false)
          (set i (rt_add i 1)))))
      (if (dvr_overlap first_refs second_refs)
        (do (dvr_add lines "**判定源需复核：首个接受与后续接受节点复用了相同实际事件引用。不能仅凭两条节点结果把同一次回答当作两个不同正式题达成；原始判定保留，修正须另执行。**") (dvr_add lines "")) false)
      (if (rt_eq (rt_count findings) 0) (dvr_add lines "没有判定记录；不能据此宣布要求成立。") false))))
(defn dvr_check (lines title path start)
  (do (dvr_add lines (rt_cat "## " title)) (dvr_add lines "")
    (if (rt_eq path "")
      (do (dvr_add lines "本轮未执行该判定；不能据此声称要求成立。") (dvr_add lines ""))
      (let (report (rt_json_parse (rt_read path)))
        (do (dvr_add lines (rt_cat "原始判定输出：" path)) (dvr_add lines "")
          (dvr_findings lines report start))))))
(defn dvr_event_name (type)
  (dv_find (dv_m4 "action_selected" "选择行动" "action_execution" "实际执行"
    "answer_accepted" "正式接受回答" "answer_rejected" "正式拒绝回答") type
    (dv_find (dv_m4 "ready" "推理已充分" "inference" "按本人公理推知"
      "hypothesis_adopted" "认真采纳假说" "hypothesis_revised" "修正假说") type type)))
(defn dvr_event_line (lines event start labels)
  (let (type (dv_get event "type") data (dv_find event "data" (rt_list)))
    (do
      (dvr_add lines (rt_cat (rt_cat (rt_cat "- " (rt_cat (rt_cat "经过" (rt_show (rt_sub (dv_get event "time") start))) (rt_cat "分钟；时钟" (dvr_clock (dv_get event "time"))))) "：")
        (rt_cat (dvr_event_name type) (rt_cat "，事件 " (dv_get event "id")))))
      (if (dv_has_key data "action")
        (let (action (dv_get data "action"))
          (do (dvr_add lines (rt_cat "  输入：" (dv_find (dv_find labels "actions" (rt_list)) (dv_get action "id") (rt_cat (dv_find (dv_find labels "action_kinds" (rt_list)) (dv_get action "kind") (dv_get action "kind")) (rt_cat "；追溯ID " (dv_get action "id"))))))
            (dvr_add lines (rt_cat "  本人可知来源：" (rt_json_stringify (dv_find action "basis" (rt_list)))))
            (if (dv_has_key action "answer") (dvr_add lines (rt_cat "  提交命题：" (rt_json_stringify (dv_get action "answer")))) false))) false)
      (if (dv_has_key data "reason") (dvr_add lines (rt_cat "  后续结果：" (dvr_reason (dv_get data "reason")))) false)
      (if (dv_has_key data "literal_truth") (dvr_add lines (rt_cat "  字面真实性：" (rt_show (dv_get data "literal_truth")))) false)
      (if (dv_has_key data "epistemic_support") (dvr_add lines (rt_cat "  本人支持：" (rt_show (dv_get data "epistemic_support")))) false)
      (if (dv_has_key data "question_match") (dvr_add lines (rt_cat "  与当前题相关：" (rt_show (dv_get data "question_match")))) false)
      (if (dv_has_key data "answer_complete") (dvr_add lines (rt_cat "  回答完整性：" (rt_show (dv_get data "answer_complete")))) false)
      (if (dv_has_key data "actual") (dvr_add lines (rt_cat "  实际动作代价：" (rt_json_stringify (dv_get data "actual")))) false)
      (dvr_add lines (rt_cat "  因果前驱：" (dvr_refs (dv_find event "parents" (rt_list)))))
      (dvr_add lines ""))))
(defn dvr_session (lines entry actor)
  (let (trace (rt_json_parse (rt_read (dv_get entry "trace"))) events (rt_list) i 0 first false ready false accepted false labels (rt_list) last_stop (rt_list))
    (do (set events (dv_find trace "events" (rt_list)))
      (set labels (dv_find (dv_find trace "configuration" (rt_list)) "report_labels" (rt_list)))
      (if (dv_has_key entry "scenario") (set labels (dv_find (rt_json_parse (rt_read (dv_get entry "scenario"))) "report_labels" labels)) false)
      (if (rt_lt 0 (rt_count events)) (set first (dv_get (rt_at events 0) "time")) false)
      (dvr_add lines (rt_cat (rt_cat "### 会话 " (dv_get entry "id")) (rt_cat "；主体" (dv_find (dv_find labels "actors" (rt_list)) actor actor)))) (dvr_add lines "")
      (dvr_add lines (rt_cat "记录：" (dv_get entry "trace")))
      (dvr_add lines (rt_cat (rt_cat "现实进程耗时：" (rt_show (dv_get entry "real_elapsed_seconds"))) "秒。"))
      (dvr_add lines (rt_cat (rt_cat "共享多主体串行逻辑时钟：" (dvr_time first)) (rt_cat " → " (dvr_time (dv_find trace "time" false)))))
      (dvr_add lines (rt_cat "停止原因：" (dvr_reason (dv_find trace "status" "未记录")))) (dvr_add lines "")
      (while (rt_lt i (rt_count events))
        (let (event (rt_at events i) type (dv_get (rt_at events i) "type"))
          (do (if (rt_eq (dv_find event "actor" "") actor)
            (do (if (rt_eq type "planning_stop") (set last_stop event) false)
              (if (rt_eq type "ready") (set ready true) false)
              (if (rt_eq type "answer_accepted") (set accepted true) false)
              (if (dv_has (dvr_event_types) type)
                (dvr_event_line lines event first labels) false)) false)
            (set i (rt_add i 1)))))
      (if (dv_has_key last_stop "data")
        (let (stopped (dv_get last_stop "data"))
          (do (dvr_add lines (rt_cat "最后规划停止记录：" (dv_get last_stop "id")))
            (dvr_add lines (rt_cat "停止边界：" (dv_find (dv_m4 "incomplete-layer-budget" "展开预算不足以完成当前比较层；未将未比较路径当作已解决。"
              "no-admissible-action" "本人当前没有符合要求的可执行行动。" "plan-budget-exhausted" "本轮规划展开预算用尽。" "complete-depth" "已完成声明规划深度；是否实际执行仍须看动作记录。") (dv_find stopped "stop" "未记录") (dv_find stopped "stop" "未记录"))))
            (dvr_add lines (rt_cat "本次实际规划展开：" (rt_show (dv_find stopped "plan_expansions" 0))))
            (dvr_add lines (rt_cat "原停止记录保留的相关字段：" (rt_json_stringify (dv_find stopped "relevant_refs" (rt_list)))))
            (dvr_add lines ""))) false)
      (if ready false (dvr_add lines "本窗口未记录该主体达到ready；不补猜首次时刻。"))
      (if accepted false (dvr_add lines "本窗口未记录该主体的正式回答被接受；不能以命题为真或候选出现替代接受。"))
      (dvr_add lines "节点现实首次时刻未在原轨迹记录；上面的整进程秒数不能用于推算节点现实时刻。") (dvr_add lines ""))))
(defn dvr_private_remaining (lines trace actor)
 (let (actors (dv_find (dv_find trace "final" (rt_list)) "actors" (rt_list)) i 0)
  (do (while (rt_lt i (rt_count actors))
    (let (person (rt_at actors i))
      (do (if (rt_eq (dv_find person "id" "") actor)
        (let (policy (dv_find person "policy" (rt_list)))
          (do (dvr_add lines "私有诊断（不属于公开行为证据）：目标主体最终剩余资源。")
            (dvr_add lines (rt_cat "模型计算：" (rt_show (dv_find policy "model_budget" "未记录"))))
            (dvr_add lines (rt_cat "推理：" (rt_show (dv_find policy "reason_budget" "未记录"))))
            (dvr_add lines (rt_cat "规划展开：" (rt_show (dv_find policy "plan_budget" "未记录"))))
            (dvr_add lines (rt_cat "动作：" (rt_show (dv_find policy "budget" "未记录")))))) false)
        (set i (rt_add i 1))))))))
(defn dvr_summary (lines entries actor mainpath start)
 (do (dvr_add lines "## 本轮结论与具体缺口") (dvr_add lines "")
  (if (rt_lt 0 (rt_count entries))
   (let (entry (rt_at entries 0) trace (rt_json_parse (rt_read (dv_get (rt_at entries 0) "trace"))) events (rt_list) i 0 first false)
    (do (set events (dv_get trace "events"))
     (while (rt_lt i (rt_count events))
      (let (event (rt_at events i))
       (do (if (rt_eq first false)
        (if (rt_eq (dv_get event "actor") actor)
         (if (rt_eq (dv_get event "type") "answer_accepted") (set first event) false) false) false)
        (set i (rt_add i 1)))))
     (dvr_add lines (rt_cat "实际会话进程：" (rt_cat (rt_show (dv_find entry "real_elapsed_seconds" "未记录")) "现实秒。")))
     (dvr_add lines (rt_cat "共享串行世界时间：" (rt_cat (dvr_node_time (dv_get trace "time") start) "；不是单个主体的个人游玩时长。")))
     (if (rt_eq first false) (dvr_add lines "本轮没有记录目标主体的正式接受。")
      (dvr_add lines (rt_cat "目标主体首次实际被接受：" (rt_cat (dvr_node_time (dv_get first "time") start) (rt_cat "，事件" (dv_get first "id"))))))
     (dvr_add lines (rt_cat "实际停止原因：" (dvr_reason (dv_get trace "status"))))
     (dvr_private_remaining lines trace actor))) false)
  (if (rt_eq mainpath "") (dvr_add lines "主因果判定尚未执行。")
   (let (report (rt_json_parse (rt_read mainpath)) findings (rt_list) i 0)
    (do (set findings (dv_find report "findings" (rt_list)))
     (while (rt_lt i (rt_count findings))
      (let (finding (rt_at findings i) id (dv_get (rt_at findings i) "id"))
       (do (if (dv_has (dv_append (dv_pair "ready" "second_accept") "sharing") id)
         (dvr_add lines (rt_cat (dvr_label id) (rt_cat "：" (rt_cat (dvr_status (dv_get finding "status")) (rt_cat "。" (dvr_reason (dv_find finding "reason_zh" (dv_find finding "reason" "没有具体记录")))))))) false)
        (set i (rt_add i 1))))))))
  (dvr_add lines "实际接受与因果判定分别记录；缺少准备、完整论证或指定题目证据时，不能用一次接受替代最终目标。详细证据与完整行动表列在后文。")
  (dvr_add lines "")))
(defn dvr_main ()
  (do (dv_require (rt_eq (rt_arg_count) 6) "Usage: readable main-result capability-result boundary-result parameter-result index.json report.md")
    (let (lines (rt_list) index (rt_json_parse (rt_read (rt_arg 4))) entries (rt_list) oracle (rt_list) actor "" i 0 start 0)
      (do (set entries (dv_get index "sessions")) (set oracle (rt_json_parse (rt_read (dv_get index "oracle")))) (set actor (dv_find oracle "actor" ""))
        (if (rt_lt 0 (rt_count entries)) (set start (dv_get (dv_get (dv_get (rt_json_parse (rt_read (dv_get (rt_at entries 0) "trace"))) "initial") "physical") "time")) false)
        (dvr_add lines "# DV实际会话与只读因果判定") (dvr_add lines "")
        (dvr_add lines (dvr_reason (dv_get index "scope")))
        (if (dv_has_key index "producer_run") (dvr_add lines (rt_cat "实际会话产生目录：" (dv_get index "producer_run"))) false)
        (if (dv_has_key index "judgment_run") (dvr_add lines (rt_cat "本次只读判定目录：" (dv_get index "judgment_run"))) false)
        (if (dv_has_key index "judgment_processes") (dvr_add lines (rt_cat "只读判定进程实测秒数（与后文会话进程分列）：" (rt_json_stringify (dv_get index "judgment_processes")))) false)
        (dvr_add lines "以下正文由DV程序依据原始事件和DV判定生成。平台只提供路径、封存与实测耗时，不代判领域。")
        (dvr_add lines "不以断言数量、通过率或构建汇总评价。Godot输入、碰撞、画面和旧Core接线不由这份逻辑模型记录证明。") (dvr_add lines "")
        (dvr_summary lines entries actor (rt_arg 0) start)
        (dvr_check lines "主因果检验" (rt_arg 0) start)
        (dvr_check lines "授权能力比较" (rt_arg 1) start)
        (dvr_check lines "证据与听觉边界" (rt_arg 2) start)
        (dvr_check lines "批准参数邻域与预留集" (rt_arg 3) start)
        (dvr_add lines "## 实际关键行动、输入与后续结果") (dvr_add lines "")
        (while (rt_lt i (rt_count entries)) (do (dvr_session lines (rt_at entries i) actor) (set i (rt_add i 1))))
        (rt_write (rt_arg 5) (dvr_join lines "\n"))))))
