; Independent read-only oracle. Never linked into the session or subjective policy.
(defn c1_oracle_source (path line id) (dv_m3 "path" path "line" line "id" id))
(defn c1_oracle_fact (atom) (dv_fact (dv_ref "cognition" "state" atom) true))
(defn c1_original_heard_requirement ()
 (dv_all (dv_list3 (c1_oracle_fact "remote_voice") (c1_oracle_fact "words_bolt")
   (dv_all (dv_pair (c1_oracle_fact "trust_reason")
    (dv_fact (dv_ref "cognition" "state" "heard_at_latching_verified") true))))))
(defn c1_milestone (id type after)
 (dv_m4 "id" id "type" type "actor" "detective" "after" after))
(defn c1_oracle_milestones ()
 (let (events (rt_list))
  (do (rt_push events (dv_m4 "id" "opening" "type" "speech_literal" "actor" "demon" "after" (rt_list)))
   (rt_push events (c1_milestone "first_answer" "answer_accepted" (dv_single "opening")))
   (rt_push events (c1_milestone "genuine_rejection" "answer_rejected" (dv_single "first_answer")))
   (rt_push events (c1_milestone "hypothesis_adopted" "hypothesis_adopted" (dv_single "genuine_rejection")))
   (rt_push events (c1_milestone "new_evidence" "observation" (dv_single "hypothesis_adopted")))
   (rt_push events (c1_milestone "ready" "answer_ready" (dv_single "new_evidence")))
   (rt_push events (c1_milestone "second_submit" "answer_submitted" (dv_single "ready")))
   (rt_push events (c1_milestone "second_accept" "answer_accepted" (dv_single "second_submit")))
   (rt_push events (c1_milestone "sharing" "speech_literal" (dv_single "second_accept"))) events)))
(defn c1_oracle_questions ()
 (dv_m2 "me" (dv_m2 "causal_requirements" (dv_single (c1_oracle_fact "me")) "competing_requirements" (rt_list))
 "original_q2_complete" (dv_with (dv_m2 "causal_requirements" (dv_single (c1_original_heard_requirement))
   "competing_requirements" (rt_list)) "unbound" "Actual personally-heard-at-latching temporal history is not inferred from subquestion2 alone")))
(defn dvs_chapter1_oracle ()
 (dv_with (dv_with (dv_with (dv_with (dv_with (dv_m4
  "format" "dv-oracle-v1" "actor" "detective" "first_question_id" "me" "target_question_id" "original_q2_complete")
  "milestones" (c1_oracle_milestones)) "questions" (c1_oracle_questions))
  "causal_requirements" (dv_single (c1_original_heard_requirement)))
  "limit" (dv_m3 "origin" "run_start" "destination" "ready" "maximum_game_minutes" 360))
  "source_refs" (dv_pair
   (c1_oracle_source "godot_csharp/scenes/Awakening/Script/story/第一章/场面/01_开场.story" 46 "s5_question.004")
   (c1_oracle_source "docs/design-standard.md" 1509 "原题第二问"))))
