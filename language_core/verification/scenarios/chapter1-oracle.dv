// Independent read-only oracle. Never linked into the session or subjective policy.

fn c1_oracle_source(path, line, id):
    return {"path": path, "line": line, "id": id}

fn c1_oracle_fact(atom):
    return dv_fact(dv_ref("cognition", "state", atom), true)

fn c1_original_heard_requirement():
    return dv_all(dv_list3(dv_fact(dv_ref("history_claims", "state", "actual_heard"), "Huo-relay-and-Su-report"), dv_fact(dv_ref("history_claims", "state", "voice_source"), "Tube"), dv_fact(dv_ref("history_claims", "state", "transmission_loss"), "stressed-tail-without-leading-qualification")))

fn c1_milestone(id, type, after):
    return {"id": id, "type": type, "actor": "detective", "after": after}

fn c1_oracle_milestones():
    var events = [{"id": "opening", "type": "speech_literal", "actor": "demon", "after": []}]
    let stages = ["identity", "voice_source", "words", "trust"]
    let answers = ["me", "V3_0", "V4_0", "trust"]
    var prior = "opening"
    var i = 0
    while i < rt_count(stages):
        let id = rt_cat(stages[i], "_accepted")
        rt_push(events, dv_with_many(c1_milestone(id, "answer_accepted", [prior]), {"answer_id": answers[i], "question_id": stages[i], "semantic_kind": "formal_answer"}))
        prior = id
        i = i + 1
    return events

fn c1_oracle_questions():
    // Mirrors the formal authored evidence gates without a production dependency.
    return {"identity": {"causal_requirements": [c1_oracle_fact("me"), c1_oracle_identity_complete()], "competing_requirements": []}, "voice_source": {"causal_requirements": [c1_oracle_fact("remote_voice"), c1_oracle_voice_complete()], "competing_requirements": []}, "words": {"causal_requirements": [c1_oracle_fact("words_bolt"), c1_oracle_words_complete()], "competing_requirements": []}, "trust": {"causal_requirements": [c1_oracle_fact("trust_reason"), c1_oracle_trust_complete()], "competing_requirements": []}}

fn c1_raw_chapter1_oracle():
    return {"format": "dv-oracle-v1", "actor": "detective", "first_question_id": "identity", "target_question_id": "trust", "milestones": c1_oracle_milestones(), "questions": c1_oracle_questions(), "causal_requirements": [c1_oracle_fact("me"), c1_oracle_identity_complete(), c1_oracle_fact("remote_voice"), c1_oracle_voice_complete(), c1_oracle_fact("words_bolt"), c1_oracle_words_complete(), c1_oracle_fact("trust_reason"), c1_oracle_trust_complete()], "limit": {"origin": "run_start", "destinations": c1_oracle_destinations(), "maximum_game_minutes": 360, "destination": "trust_accepted"}, "source_refs": [c1_oracle_source("user", 0, "四步正式答辩与原始问题来源分别维护")]}

fn c1_oracle_destinations():
    return ["identity_accepted", "voice_source_accepted", "words_accepted", "trust_accepted"]

fn c1_oracle_temporal_contract():
    return dv_list3({"id": "fixed-alarm-history", "kind": "fixed_history", "actor": "detective", "not_bound": "The alarm is a fixed source-order anchor; no absolute personal wake timestamp is observed"}, dv_with({"id": "body-residence-duration", "kind": "body_cumulative", "actor": "detective", "minimum_duration": 3}, "not_bound", "No first-chapter quantified >=3-day body-history record; unsupported pragmatic adoption may be withdrawn without notP"), {"id": "recalled-latching-history", "kind": "recall", "actor": "detective", "not_bound": "Actual touch recall has source and acquisition time, but no exact past occurrence timestamp; acquisition time is not the past anchor"})

fn dvs_chapter1_oracle():
    return dv_with(c1_raw_chapter1_oracle(), "temporal_contract", c1_oracle_temporal_contract())

fn c1_oracle_any(left, right):
    return dv_not(dv_all([dv_not(left), dv_not(right)]))

fn c1_oracle_identity_complete():
    return c1_oracle_any(dv_all(dv_pair(c1_oracle_fact("boots_toward_bolt"), c1_oracle_fact("boots_fit"))), dv_all(c1_list_4(c1_oracle_fact("lens_mine"), c1_oracle_fact("slate_marks"), c1_oracle_fact("slate_person"), c1_oracle_fact("slate_code"))))

fn c1_oracle_voice_complete():
    return c1_oracle_any(dv_all(dv_pair(c1_oracle_fact("pipe_layout"), c1_oracle_fact("sound_trial"))), dv_all(dv_pair(c1_oracle_fact("fork_dent"), c1_oracle_fact("frame_hollow"))))

fn c1_oracle_words_complete():
    return dv_all([c1_oracle_fact("slate_marks"), c1_oracle_fact("slate_code"), c1_oracle_fact("score_partial")])

fn c1_oracle_trust_complete():
    return dv_all([c1_oracle_fact("trust_reason"), c1_oracle_fact("heed_huo"), c1_oracle_any(c1_oracle_fact("ash_wedge"), c1_oracle_any(c1_oracle_fact("cups_preferences"), c1_oracle_fact("starter_layers")))])
