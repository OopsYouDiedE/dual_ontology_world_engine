fn c1_hist_proposal_policy(policy):
    return dv_with(dv_with(policy, "proposal_acceptance", dv_with({"enabled": true, "basis": c1_hist_share_basis(), "required_slots": dv_list3("actual_heard", "voice_source", "transmission_loss"), "confidence_threshold": 0.5}, "available_when", dv_true())), "proposal_reassessment", dv_with(dv_with({"enabled": true, "basis": c1_hist_share_basis(), "required_slots": dv_list3("actual_heard", "voice_source", "transmission_loss"), "interpretation_ids": dv_single("short_stay")}, "source_scope", "awake_self"), "target_scope", "body_history"))

fn c1_hist_install_character(actor):
    var result = actor
    var actions = actor.actions
    var new_actions = []
    var index = 0
    while (index < rt_count(actions)):
        rt_push(new_actions, actions[index])
        index = (index + 1)
    if (actor.id == "detective"):
        rt_push(new_actions, c1_hist_complete_action(actor.id))
        rt_push(new_actions, c1_hist_partial_action(actor.id))
    rt_push(new_actions, c1_hist_share_action(actor.id))
    result = dv_with(result, "actions", new_actions)
    result = dv_with(result, "policy", c1_hist_proposal_policy(result.policy))
    if (actor.id == "detective"):
        result = dv_with(result, "mind", c1_hist_install_mind(result.mind))
        var policy = c1_hist_policy(result.policy)
        var goals = result.policy.goals
        var new_goals = []
        var goal_index = 0
        while (goal_index < rt_count(goals)):
            rt_push(new_goals, goals[goal_index])
            goal_index = (goal_index + 1)
        rt_push(new_goals, c1_hist_goal())
        rt_push(new_goals, c1_hist_share_goal(actor.id))
        result = dv_with(result, "policy", dv_with(policy, "goals", new_goals))
        result = dv_with(result, "response_models", c1_hist_response_models())
        return result
    else:
        return dv_with(result, "mind", dv_add_object(result.mind, c1_local_object("history_claims")))

fn c1_hist_goal():
    return {"kind": "know", "question": "original_q2_complete", "ref": c1_hist_claim_ref("actual_heard"), "basis": dv_single(c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/01_开场.story", 46, "s5_question.004"))}

fn c1_hist_install_scene(scene):
    var actors = scene.actors
    var result = []
    var index = 0
    var formal = scene.formal_answers
    var new_formal = []
    var world = scene.physical
    while (index < rt_count(actors)):
        var actor = actors[index]
        var local_1 = false
        if (actor.id == "demon"):
            local_1 = actor
        else:
            local_1 = c1_hist_install_character(actor)
        rt_push(result, local_1)
        index = (index + 1)
    index = 0
    while (index < rt_count(formal)):
        rt_push(new_formal, formal[index])
        index = (index + 1)
    rt_push(new_formal, c1_hist_formal_answer())
    rt_push(new_formal, c1_hist_partial_formal())
    world = dv_add_object(world, c1_hist_author_truth())
    return dv_with(dv_with(dv_with(scene, "actors", result), "physical", world), "formal_answers", new_formal)
