fn c1_hist_formal_answer():
    return dv_with(dv_with(dv_with(dv_with(dv_with(dv_with(dv_with({"id": "original_q2_complete", "condition": c1_hist_expected_answer(), "required_support": c1_hist_expected_answer(), "question_match": dv_fact(dv_ref("question", "state", "outstanding_complete"), true)}, "answer_complete", c1_hist_expected_answer()), "require_argument", true), "condition_from_answer", true), "required_argument_slots", dv_list3("actual_heard", "voice_source", "transmission_loss")), "accepted_law", "accept.original_q2_complete"), "accepted_public_grants", dv_single(dv_ref("question", "state", "outstanding_complete"))), "accepted_listeners", c1_list_5("demon", "detective", "huo", "shen", "su"))

