fn c1_hist_add_source_laws(mind):
    var result = mind
    var origins = dv_list3("R08", "hall", "pantry")
    var huos = dv_list3("hall", "R06", "foyer")
    var sources = dv_pair("Tube", "OutsideDoor")
    var words_list = dv_pair("BoltKeepShut", "OpenSaveMe")
    var listeners = dv_pair("past.su", "past.huo")
    var rooms = c1_list_6("hall", "R08", "foyer", "pantry", "R05", "R06")
    var i = 0
    var j = 0
    var k = 0
    var n = 0
    while (i < 3):
        j = 0
        while (j < 3):
            result = c1_hist_adopt(result, c1_hist_origin_id(origins[i], huos[j]), c1_hist_origin("history", "cognition", origins[i], huos[j]))
            j = (j + 1)
        i = (i + 1)
    i = 0
    while (i < 2):
        j = 0
        while (j < 2):
            var source = sources[i]
            var words = words_list[j]
            result = c1_hist_adopt(result, rt_cat("history.voice.", c1_hist_source_id(source, words)), c1_hist_voice_input("history", source, words))
            k = 0
            while (k < 2):
                n = 0
                while (n < 6):
                    var listener = listeners[k]
                    var room = rooms[n]
                    var local_1 = false
                    if (source == "Tube"):
                        if (room == "hall"):
                            local_1 = c1_hist_tube_full("history", listener, words)
                        else:
                            if dv_or((room == "R08"), (room == "foyer")):
                                var local_2 = false
                                if (words == "BoltKeepShut"):
                                    local_2 = "Open"
                                else:
                                    local_2 = "SaveMe"
                                local_1 = c1_hist_tube_tail("history", listener, room, words, local_2)
                            else:
                                if (room == "pantry"):
                                    local_1 = c1_hist_tube_hum("history", listener)
                                else:
                                    local_1 = c1_hist_room_alarm("history", listener, room)
                    else:
                        if dv_or((room == "R08"), (room == "foyer")):
                            local_1 = c1_hist_outside_received("history", listener, room, words)
                        else:
                            local_1 = c1_hist_room_silence("history", listener, room)
                    result = c1_hist_adopt(result, c1_hist_acoustic_id(source, words, listener, room), local_1)
                    n = (n + 1)
                k = (k + 1)
            j = (j + 1)
        i = (i + 1)
    return result

