fn c1_hist_adopt_routes(mind):
    var result = mind
    var routes = c1_list_12(c1_list_4("past.detective", "R05", "corridor", "seek-instruction"), c1_list_4("past.detective", "corridor", "hall", "seek-instruction"), c1_list_4("past.detective", "hall", "foyer", "visit-door"), c1_list_4("past.detective", "foyer", "hall", "return-report"), c1_list_4("past.su", "R08", "corridor", "open-and-listen"), c1_list_4("past.su", "corridor", "hall", "open-and-listen"), c1_list_4("past.su", "hall", "foyer", "open-and-listen"), c1_list_4("past.su", "foyer", "hall", "write-score"), c1_list_4("past.su", "hall", "corridor", "write-score"), c1_list_4("past.su", "corridor", "R08", "write-score"), c1_list_4("past.shen", "pantry", "hall", "place-wet-cloth"), c1_list_4("past.shen", "hall", "foyer", "place-wet-cloth"))
    var index = 0
    while (index < rt_count(routes)):
        var route = routes[index]
        result = c1_hist_add_travel(result, route[0], route[1], route[2], route[3])
        index = (index + 1)
    return result

fn c1_hist_add_variant_laws(mind):
    var result = mind
    var listeners = dv_pair("past.su", "past.huo")
    var preferences = dv_list3("huo", "su", "self")
    var index = 0
    while (index < 2):
        var listener = listeners[index]
        result = c1_hist_adopt(result, rt_cat("history.tail-belief.", listener), c1_hist_open_interpretation("history", listener))
        result = c1_hist_adopt(result, rt_cat("history.open-belief.", listener), c1_hist_open_full_interpretation("history", listener))
        result = c1_hist_adopt(result, rt_cat("history.open-door.", listener), c1_hist_open_door("history", listener, "cognition"))
        index = (index + 1)
    index = 0
    while (index < 3):
        var preference = preferences[index]
        var local_1 = false
        if (preference == "huo"):
            local_1 = 4
        else:
            local_1 = 3
        var local_2 = false
        if (preference == "su"):
            local_2 = 4
        else:
            local_2 = 3
        result = c1_hist_adopt(result, rt_cat("history.relations.", preference), c1_hist_familiar_relations("history", preference, local_1, local_2))
        index = (index + 1)
    result = c1_hist_adopt(result, "history.layout", c1_hist_layout_known("cognition", "history"))
    result = c1_hist_adopt(result, "history.slate.BoltKeepShut", c1_hist_instruction_record("history", "cognition", "BoltKeepShut"))
    result = c1_hist_adopt(result, "history.slate.OpenSaveMe", c1_hist_instruction_record("history", "cognition", "OpenSaveMe"))
    result = c1_hist_adopt(result, "history.footprint", c1_hist_footprint("history", "cognition", "PoloBoot", "Bolt", "predicted_boots_bolt"))
    result = c1_hist_adopt(result, "history.argument.source.Tube", c1_hist_argument_source("history", "cognition", "Tube", "stressed-tail-without-leading-qualification"))
    result = c1_hist_adopt(result, "history.argument.source.OutsideDoor", c1_hist_argument_source("history", "cognition", "OutsideDoor", "muffled-full-speech"))
    result = c1_hist_adopt(result, "history.argument.heard.both", c1_hist_heard_argument("history", "cognition", true, "Huo-relay-and-Su-report"))
    result = c1_hist_adopt(result, "history.argument.heard.relay", c1_hist_heard_argument("history", "cognition", false, "Huo-relay-only"))
    return result

fn c1_hist_hearing_ids(source, words):
    var result = []
    var listeners = dv_pair("past.su", "past.huo")
    var rooms = c1_list_6("hall", "R08", "foyer", "pantry", "R05", "R06")
    var i = 0
    var j = 0
    while (i < 2):
        j = 0
        while (j < 6):
            rt_push(result, c1_hist_acoustic_id(source, words, listeners[i], rooms[j]))
            j = (j + 1)
        i = (i + 1)
    return result

fn c1_hist_order(stages):
    var result = []
    var used = []
    var count = 0
    while (count < rt_count(stages)):
        var found = false
        var best = 0
        var best_at = 0
        var index = 0
        while (index < rt_count(stages)):
            if dv_has(used, index):
                false
            else:
                var local_1 = false
                if found:
                    local_1 = (stages[index].at < best_at)
                else:
                    local_1 = true
                if local_1:
                    found = true
                    best = index
                    best_at = stages[index].at
            index = (index + 1)
        rt_push(used, best)
        rt_push(result, stages[best])
        count = (count + 1)
    return result

