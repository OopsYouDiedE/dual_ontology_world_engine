(defn c1_adopt_protocol (world)
 (let (result world stages (c1_list_4 "identity" "voice_source" "words" "trust") i 0)
  (do (while (rt_lt i (rt_count stages))
   (let (stage (rt_at stages i))
    (do (set result (dv_adopt result (c1_method (rt_cat "accept." stage) (c1_question_accept "question" stage)) "enforce" 1
      (dv_single (c1_source "godot_csharp/scenes/Awakening/Script/story/第一章/场面/07_答辩.story" 2 "answer_open.001"))))
      (set i (rt_add i 1))))) result)))
(defn c1_speech (literal surface scope)
 (dv_with (dv_with (dv_with (dv_m4 "literal_ast" literal "referents" (rt_list) "scope" scope "time_anchor" "今晨醒来至当前发言")
 "surface_ref" surface) "presuppositions" (rt_list)) "implicature_candidates" (rt_list)))
(defn c1_raw_opening_action ()
 (dv_with (dv_with (dv_with (c1_once (c1_action "demon.opening" "opening" (dv_fact (dv_ref "question" "state" "stage") "opening")
  (dv_fact (dv_ref "question" "state" "stage") "opening") "demon.opening"
  (dv_single (dv_ref "question" "state" "stage"))
  (c1_source "godot_csharp/scenes/Awakening/Script/story/第一章/场面/01_开场.story" 28 "s3_broadcast.019")))
 "speech" (dv_with (dv_with (c1_speech (dv_all (dv_list3 (dv_fact (dv_ref "question" "state" "awake_scope") true)
    (dv_fact (dv_ref "question" "state" "memory_removed") true) (dv_fact (dv_ref "question" "state" "not_injury") true)))
   (c1_source "godot_csharp/scenes/Awakening/Script/story/第一章/场面/01_开场.story" 28 "s3_broadcast.019") "awake_self")
   "surface" "诸位初涉斯地，记忆有缺，并非伤病，请勿惊惶。") "implicature_candidates" (dv_single (dv_single (dv_pair "id" "short_stay")))))
 "listeners" (c1_list_4 "detective" "huo" "shen" "su")) "public_grants" (dv_list3 (dv_ref "question" "state" "awake_scope")
  (dv_ref "question" "state" "memory_removed") (dv_ref "question" "state" "not_injury"))))
(defn c1_authorized_speech (action)
 (dv_with action "authority_truth_gate" (dv_m3 "required" true "contract_id" "contract-8"
  "basis" (dv_single (c1_source "docs/design-standard.md" 462 "may-not-deceive-students")))))
(defn c1_opening_action () (c1_authorized_speech (c1_raw_opening_action)))
; Speech candidates share the one actual opening transition. Every fragment uses original words.
(defn c1_opening_memory_fragment ()
 (let (action (c1_opening_action) speech (dv_get (c1_opening_action) "speech"))
  (dv_with (dv_with (dv_with action "id" "demon.opening.memory-only")
   "speech" (dv_with (dv_with (dv_with speech "literal_ast"
    (dv_all (dv_pair (dv_fact (dv_ref "question" "state" "memory_removed") true)
     (dv_fact (dv_ref "question" "state" "not_injury") true))))
    "surface" "记忆有缺，并非伤病，请勿惊惶。") "implicature_candidates" (rt_list)))
   "public_grants" (dv_pair (dv_ref "question" "state" "memory_removed") (dv_ref "question" "state" "not_injury")))))
(defn c1_opening_illegal_fragment ()
 (let (action (c1_opening_memory_fragment) speech (dv_get (c1_opening_memory_fragment) "speech"))
  (dv_with (dv_with action "id" "demon.opening.contrary") "speech"
   (dv_with (dv_with speech "literal_ast" (dv_fact (dv_ref "question" "state" "not_injury") false))
    "surface" "是伤病。"))))
(defn c1_demon_listener_models ()
 (let (listeners (c1_list_4 "detective" "huo" "shen" "su") result (rt_list) index 0
       basis (c1_handling_basis))
  (do (while (rt_lt index (rt_count listeners))
   (do (rt_push result (dv_pair (rt_at listeners index)
     (c1_opening_listener_model (rt_at listeners index) false basis)))
    (set index (rt_add index 1)))) result)))
(defn c1_demon_policy ()
 (dv_with (dv_with (c1_player_policy) "hypotheses" (rt_list)) "communication_goals"
  (dv_single (dv_with (dv_with (dv_with (dv_m4 "id" "opening-purpose"
   "interpretation_id" "short_stay" "desired_status" "accepted" "weight" 1)
   "listeners" (c1_list_4 "detective" "huo" "shen" "su"))
   "available_when" (dv_fact (dv_ref "question" "state" "stage") "opening"))
   "basis" (dv_pair (c1_source "docs/design-standard.md" 419 "speaker-own-purpose-to-make-listeners-want-to-ask")
    (c1_source "docs/design-standard.md" 1500 "approved-defeasible-pragmatic-purpose"))))))
(defn c1_raw_question_action (stage surface first)
 (dv_with (dv_with (dv_with (c1_once (c1_action (rt_cat "demon.question." stage) (if first "question" "receive_question")
  (dv_fact (dv_ref "question" "state" "stage") stage)
  (dv_fact (dv_ref "question" "state" "stage") stage)
  (if first "demon.question" (if (rt_eq stage "voice_source") "demon.original_question" "")) (dv_single (dv_ref "question" "state" "stage")) surface))
 "speech" (dv_with (dv_with (c1_speech (dv_true) surface "正式公开问题；问句不是历史事实断言") "utterance_type" "question") "surface" (rt_cat (c1_question_text stage) " 每一问，说一句结论，再拿出一件撑得住它的东西。")))
 "listeners" (c1_list_4 "detective" "huo" "shen" "su"))
 "public_grants" (c1_list_8 (dv_ref "question" "state" "open_identity") (dv_ref "question" "state" "open_voice_source")
  (dv_ref "question" "state" "open_words") (dv_ref "question" "state" "open_trust")
  (dv_ref "question" "state" "current") (dv_ref "question" "state" "original")
  (dv_ref "question" "state" "requires_evidence") (dv_ref "question" "state" "outstanding_complete"))))
(defn c1_question_action (stage surface first)
 (c1_authorized_speech (c1_raw_question_action stage surface first)))
(defn c1_character_demon ()
 (let (mind (dv_with (dv_world "mind.demon" "mind" "demon") "time" 480))
  (do (set mind (dv_add_object mind (c1_position "demon" "hall")))
   (set mind (dv_add_object mind (c1_question_object)))
   (set mind (dv_with mind "listener_models" (c1_demon_listener_models)))
   (dv_with (dv_with (dv_m4 "id" "demon" "mind" mind "policy" (c1_demon_policy)
    "actions" (c1_list_7 (c1_opening_action) (c1_opening_memory_fragment) (c1_opening_illegal_fragment)
      (c1_question_action "prompt" (c1_source "godot_csharp/scenes/Awakening/Script/story/第一章/场面/01_开场.story" 46 "s5_question.004") true)
      (c1_question_action "voice_source" (c1_source "godot_csharp/scenes/Awakening/Script/story/第一章/场面/07_答辩.story" 16 "answer_q2.001") false)
      (c1_question_action "words" (c1_source "godot_csharp/scenes/Awakening/Script/story/第一章/场面/07_答辩.story" 30 "answer_q3.001") false)
      (c1_question_action "trust" (c1_source "godot_csharp/scenes/Awakening/Script/story/第一章/场面/07_答辩.story" 39 "answer_q4.001") false)))
    "balance" (dv_m3 "time" 100000 "computation" 100000 "stamina" 100000)) "location_ref" (dv_ref "demon" "state" "location")))))


(defn c1_costs () (c1_list_12 (dv_pair "opening" (c1_cost 20 (c1_source "godot_csharp/scenes/Awakening/Script/story/剧情时长.story" 17 "s3_broadcast：20"))) (dv_pair "question" (c1_cost 15 (c1_source "godot_csharp/scenes/Awakening/Script/story/剧情时长.story" 18 "s5_question：15"))) (dv_pair "receive_question" (c1_cost 0 (c1_source "godot_csharp/scenes/Awakening/Script/story/剧情时长.story" 30 "检视：0"))) (dv_pair "inspect" (c1_cost 0 (c1_source "godot_csharp/scenes/Awakening/Script/story/剧情时长.story" 30 "检视：0"))) (dv_pair "experiment" (c1_cost 17 (c1_source "godot_csharp/scenes/Awakening/Script/story/剧情时长.story" 31 "试验：17"))) (dv_pair "help" (c1_cost 0 (c1_source "godot_csharp/scenes/Awakening/Script/story/剧情时长.story" 30 "检视：0"))) (dv_pair "talk" (c1_cost 0 (c1_source "godot_csharp/scenes/Awakening/Script/story/剧情时长.story" 30 "检视：0"))) (dv_pair "sound_test" (c1_cost 24 (c1_source "godot_csharp/scenes/Awakening/Script/story/剧情时长.story" 34 "声路：24"))) (dv_pair "replay" (dv_with (c1_cost 29 (c1_source "godot_csharp/scenes/Awakening/Script/story/剧情时长.story" 35 "重演：29")) "work_limit" 320)) (dv_pair "answer" (c1_cost 10 (c1_source "godot_csharp/scenes/Awakening/Script/story/剧情时长.story" 36 "答辩：10"))) (dv_pair "move" (c1_cost 2 (c1_source "godot_csharp/scenes/Awakening/Script/story/剧情时长.story" 37 "走动：2"))) (dv_pair "recall" (c1_cost 0 (c1_source "godot_csharp/scenes/Awakening/Script/story/剧情时长.story" 30 "检视：0")))))

(defn c1_bindings ()
 (let (people (c1_list_5 "demon" "detective" "huo" "shen" "su") objects (c1_list_9 "demon" "detective" "huo" "shen" "su" "cognition" "question" "ritual" "coat") result (rt_list) i 0 j 0)
  (do (while (rt_lt i (rt_count people))
    (do (set j 0) (while (rt_lt j (rt_count objects))
      (do (rt_push result (dv_binding (rt_at objects j) (rt_at objects j) (rt_at people i))) (set j (rt_add j 1))))
      (set i (rt_add i 1)))) result)))
(defn c1_binding_gaps () (c1_list_5
 "No quantified >=3-day evidence; withdraw insufficient adoption without asserting its negation"
 "Historical wake latency is unknown; representative model coordinates are not a measured wake timestamp"
 "Original Q2 is distinct from literal V3; only actual paid model argument and its real support may satisfy it"
 "Historical route coordinates use existing edge/speed values; reaction/propagation real durations remain uncalibrated"
 "Demon listener models are independent provisional estimates; actual listener understanding may differ"))
(defn c1_scenario_native ()
 (dv_with (dv_with (dv_with (dv_with (dv_m4 "format" "dv-session-v1" "id" "chapter1-native-authoring"
  "physical" (c1_physical_world) "actors" (c1_list_5 (c1_character_demon) (c1_character_detective)
   (c1_character_huo) (c1_character_shen) (c1_character_su)))
  "bindings" (c1_bindings)) "cost_model" (c1_costs)) "formal_answers" (c1_formal_answers))
  "max_actions" 240))
(defn c1_variant_weight (weight id)
 (let (data (dvs_scenario_base) actors (dv_get data "actors") result (rt_list) i 0)
  (do (while (rt_lt i (rt_count actors)) (let (actor (rt_at actors i))
   (do (if (rt_eq (dv_get actor "id") "detective")
    (set actor (dv_with actor "policy" (dv_with (dv_get actor "policy") "information_weight" weight))) false)
    (rt_push result actor) (set i (rt_add i 1))))) (dv_with (dv_with data "actors" result) "id" id))))
(defn dvs_scenario_low () (c1_variant_weight 10.8 "chapter1-information-low"))
(defn dvs_scenario_holdout () (c1_variant_weight 13.2 "chapter1-information-holdout"))
(defn dvs_scenario_boundary ()
 (let (data (dvs_scenario_base) actors (dv_get data "actors") result (rt_list) i 0 position (dv_ref "su" "state" "location")
  basis (dv_single "Human-authorized noncanonical boundary initial position: Su at R05, only alarm/no-message source area"))
  (do (while (rt_lt i (rt_count actors)) (let (actor (rt_at actors i))
   (do (if (rt_eq (dv_get actor "id") "su")
     (set actor (dv_with actor "mind" (dv_store (dv_get actor "mind") position (dv_with (dv_with (dv_read (dv_get actor "mind") position) "value" "R05") "basis" basis)))) false)
    (rt_push result actor) (set i (rt_add i 1)))))
   (dv_with (dv_with (dv_with data "actors" result) "physical" (dv_store (dv_get data "physical") position (dv_with (dv_with (dv_read (dv_get data "physical") position) "value" "R05") "basis" basis)))
     "id" "chapter1-boundary-noncanonical"))))


(defn c1_report_labels ()
 (dv_m3 "actors" (c1_list_5 (dv_pair "detective" "侦探") (dv_pair "huo" "霍铎")
  (dv_pair "shen" "沈鼎") (dv_pair "su" "苏泠") (dv_pair "demon" "铜口代管者"))
 "objects" (c1_list_12 (dv_pair "E1" "内闩") (dv_pair "E2" "木楔") (dv_pair "E3" "灰上的靴印")
  (dv_pair "E4" "湿布") (dv_pair "E5" "音叉与门框") (dv_pair "E6" "苏泠的乐谱")
  (dv_pair "E7" "霍铎的石板") (dv_pair "E8" "铜口与传声管") (dv_pair "E9" "四只茶杯")
  (dv_pair "E10" "酵种罐") (dv_pair "E11" "积灰书架") (dv_pair "E12" "风衣与放大镜"))
 "action_kinds" (c1_list_12 (dv_pair "opening" "开场广播") (dv_pair "question" "提出始业之问")
  (dv_pair "receive_question" "听取问题") (dv_pair "inspect" "检视") (dv_pair "experiment" "实验")
  (dv_pair "help" "请人辨认") (dv_pair "talk" "询问证言") (dv_pair "sound_test" "声路试验")
  (dv_pair "replay" "重演昨夜") (dv_pair "answer" "提交答辩") (dv_pair "move" "走动") (dv_pair "recall" "触物回想"))))
(defn c1_active_configuration (data)
 (dv_with (dv_with (dv_with (dv_with (dv_with data "report_labels" (c1_report_labels)) "game_duration_budget" 360) "capability_actor" "detective")
  "binding_gaps" (c1_binding_gaps))
  "budget_scope" "Detective cap48 from source; NPC cap48 engineering termination only; global cap240 sums actual caps, no cost or clock relaxation"))
(defn dvs_scenario_base () (c1_active_configuration (c1_hist_install_scene (c1_scenario_native))))

(defn c1_question_text (stage)
 (if (rt_eq stage "prompt") "门是谁闩上的？闩门之时，此人可曾听见门外的呼喊？"
  (if (rt_eq stage "voice_source") "门外，有人呼喊吗？"
   (if (rt_eq stage "words") "他喊的是什么？" "闩门的人，为何不听门边那位女士的？"))))
