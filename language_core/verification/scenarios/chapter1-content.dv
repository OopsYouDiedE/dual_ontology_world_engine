  (c1_at actor "hall") (dv_all (dv_pair (c1_at actor "hall") (c1_at "demon" "hall"))) ""
  (c1_list_5 (dv_ref "question" "state" "current") (dv_ref "question" "state" "stage")
   (dv_ref "question" "state" "original") (dv_ref "question" "state" "requires_evidence")
   (dv_ref "question" "state" "outstanding_complete"))
  (c1_source "godot_csharp/scenes/Awakening/Script/story/第一章/策略轨道.story" 47 "clock_question.001"))
  "testimony" "demon" 1) "repeatable" true))
(defn c1_room_objects () (c1_list_8 (c1_local_object "hall") (c1_local_object "foyer") (c1_local_object "pantry")
 (c1_local_object "corridor") (c1_local_object "R05") (c1_local_object "R06") (c1_local_object "R07") (c1_local_object "R08")))
(defn c1_add_objects (world objects)
 (let (result world i 0) (do (while (rt_lt i (rt_count objects))
   (do (set result (dv_add_object result (rt_at objects i))) (set i (rt_add i 1)))) result)))
(defn c1_physical_world ()
 (let (world (dv_with (dv_world "chapter1.physical" "physical" "") "time" 480)
       people (c1_list_5 "detective" "huo" "shen" "su" "demon") i 0)
  (do (set world (c1_add_objects world (c1_room_objects)))
   (set world (dv_add_object world (c1_physical_cognition)))
   (set world (dv_add_object world (c1_question_object)))
   (set world (dv_add_object world (dv_object "coat" "physical" (dv_m2 "state" (rt_list) "identity" (dv_single (dv_pair "owner" (dv_field "detective")))))))
   (set world (dv_add_object world (c1_state_object "ritual" (dv_single (dv_pair "sound_trial_done" (dv_field false))))))
   (while (rt_lt i (rt_count people)) (let (actor (rt_at people i))
    (do (set world (dv_add_object world (c1_position actor "hall")))
     (set world (c1_add_move_methods world actor "enforce"))
     (set world (dv_adopt world (c1_method (rt_cat actor ".sound_trial") (c1_sound_trial actor "ritual" "hall")) "enforce" 1
       (dv_single (c1_source "godot_csharp/scenes/Awakening/Script/story/第一章/场面/05_声路与交谈.story" 13 "sound_test.003"))))
     (set i (rt_add i 1)))))
   (set world (dv_adopt world (c1_method "demon.opening" (c1_opening_emit "question")) "enforce" 1
    (dv_single (c1_source "godot_csharp/scenes/Awakening/Script/story/第一章/场面/01_开场.story" 28 "s3_broadcast.019"))))
   (set world (dv_adopt world (c1_method "demon.question" (c1_question_emit "question")) "enforce" 1
    (dv_single (c1_source "godot_csharp/scenes/Awakening/Script/story/第一章/场面/01_开场.story" 46 "s5_question.004"))))
   (set world (dv_adopt world (c1_method "demon.original_question" (c1_original_question_open "question")) "enforce" 1
    (dv_single (c1_source "godot_csharp/scenes/Awakening/Script/story/第一章/场面/07_答辩.story" 16 "answer_q2.001"))))
   (set world (dv_adopt world (c1_method "accept.original_q2_complete" (c1_original_question_accept "question")) "enforce" 1
    (dv_single (c1_source "godot_csharp/scenes/Awakening/Script/story/第一章/场面/07_答辩.story" 3 "answer_open.002"))))
   (set world (c1_adopt_protocol world)) (c1_register_speech_contract world))))
(defn c1_subjective_world (actor)
 (let (mind (dv_with (dv_world (rt_cat "mind." actor) "mind" actor) "time" 480))
  (do (set mind (dv_add_object mind (c1_position actor "hall")))
   (set mind (dv_store mind (dv_ref actor "state" "identity") (dv_field actor)))
   (set mind (dv_add_object mind (c1_local_object "cognition")))
   (set mind (dv_add_object mind (c1_local_object "ritual")))
   (set mind (dv_add_object mind (c1_local_object "question")))
   (set mind (dv_add_object mind (c1_memory_object actor)))
   (set mind (dv_add_object mind (c1_local_object "coat")))
   (if (rt_eq actor "detective") (set mind (dv_store mind (dv_ref "coat" "identity" "owner")
    (dv_with (dv_field "detective") "basis" (dv_single (c1_source "godot_csharp/scenes/Awakening/Script/story/第一章/场面/01_开场.story" 6 "s1_wake.006"))))) false)
   (set mind (c1_adopt_inferences mind))
   (c1_add_move_methods mind actor "predict"))))


(defn c1_player_policy ()
 (dv_with (dv_with (dv_with (dv_m4 "budget" 48 "reason_budget" 320 "model_budget" 320 "plan_budget" 320)
  "hypotheses" (c1_hypotheses)) "goals" (rt_list)) "observation_weights" (dv_m3 "perception" 1 "testimony" 1 "recall" 1)))

(defn c1_public_goal (question atom kind)
 (dv_with (dv_with (dv_m4 "kind" kind "question" question "ref" (c1_knowledge atom)
  "basis" (dv_single (c1_source "godot_csharp/scenes/Awakening/Script/story/第一章/场面/07_答辩.story" 3 "answer_open.002")))
  "available_when" (dv_all (dv_pair (dv_fact (dv_ref "question" "state" (rt_cat "open_" question)) true)
   (dv_fact (dv_ref "question" "state" "requires_evidence") true)))) "source" "perception"))
(defn c1_public_goals ()
 (c1_list_4 (c1_public_goal "identity" "me" "evidence")
  (c1_public_goal "voice_source" "remote_voice" "know")
  (c1_public_goal "words" "words_bolt" "know")
  (c1_public_goal "trust" "trust_reason" "know")))
(defn c1_memory_source (actor)
 (if (rt_eq actor "detective")
  (c1_source "godot_csharp/scenes/Awakening/Script/story/第一章/场面/01_开场.story" 5 "s1_wake.003")
  (c1_source "godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story"
   (if (rt_eq actor "huo") 7 (if (rt_eq actor "shen") 15 23))
   (if (rt_eq actor "huo") "opening_huo.003" (if (rt_eq actor "shen") "opening_shen.003" "opening_su.003")))))
(defn c1_memory_object (actor)
 (c1_state_object "memory" (dv_single (dv_pair "empty_school_recall"
  (dv_with (dv_field true) "basis" (dv_single (c1_memory_source actor)))))))
(defn c1_pragmatic_policy (policy scope_check)
 (dv_with (dv_with policy "scope_reference_check" scope_check) "implicature_bridges"
  (dv_single (c1_short_stay_rule "cognition" "question" "memory"
   (dv_list3
    (c1_source "docs/design-standard.md" 1500 "approved-reversible-short-stay-interpretation")
    (c1_source "docs/design-standard.md" 674 "awake-self-literal-scope")
    (c1_source "godot_csharp/scenes/Awakening/Script/story/第一章/场面/01_开场.story" 28 "s3_broadcast.019"))))))
(defn c1_raw_person_policy (id)
 (let (policy (dv_with (dv_with (c1_player_policy) "information_weight" 12) "goals" (c1_public_goals)))
  (if (rt_eq id "detective") (c1_pragmatic_policy (dv_with policy "plan_depth" 6) true)
   (c1_pragmatic_policy (dv_with (dv_with policy "model_budget" 0) "plan_depth" 1) false))))

(defn c1_person_policy (id)
 (dv_with (c1_raw_person_policy id) "topic_bindings"
  (dv_single (dv_m4 "topic" "original_q2_complete"
   "heard_when" (dv_fact (dv_ref "question" "state" "outstanding_complete") true)
   "completed_when" (dv_fact (dv_ref "question" "state" "outstanding_complete") false)
   "basis" (dv_single (c1_source "godot_csharp/scenes/Awakening/Script/story/第一章/场面/07_答辩.story" 16 "answer_q2.001"))))))
(defn c1_investigation_actions (actor)
 (let (actions (c1_move_actions actor) inspect
  (c1_list_12 (c1_inspect_E1 actor) (c1_inspect_E2 actor) (c1_inspect_E3 actor) (c1_inspect_E4 actor)
   (c1_inspect_E5 actor) (c1_inspect_E6 actor) (c1_inspect_E7 actor) (c1_inspect_E8 actor)
   (c1_inspect_E9 actor) (c1_inspect_E10 actor) (c1_inspect_E11 actor) (c1_inspect_E12 actor))
  dialogue (c1_list_7 (c1_talk_slate_code actor) (c1_talk_slate_person actor) (c1_talk_frame_hollow actor)
   (c1_talk_cups_known actor) (c1_talk_starter_kept actor) (c1_talk_recalled_copper actor) (c1_talk_recalled_names actor)) i 0)
  (do (while (rt_lt i (rt_count inspect)) (do (rt_push actions (rt_at inspect i)) (set i (rt_add i 1))))
   (set i 0) (while (rt_lt i (rt_count dialogue)) (do (rt_push actions (rt_at dialogue i)) (set i (rt_add i 1))))
   (set i 0) (while (rt_lt i (rt_count (c1_answer_actions actor)))
    (do (rt_push actions (rt_at (c1_answer_actions actor) i)) (set i (rt_add i 1))))
   (rt_push actions (c1_sound_action actor)) (rt_push actions (c1_loss_testimony actor))
   (if (rt_eq actor "detective") (rt_push actions (c1_replay_action actor)) false)
   (if (rt_eq actor "detective") (do (rt_push actions (c1_sole_test actor)) (rt_push actions (c1_touch_recall actor))) false)
   (rt_push actions (c1_identify_own_lens actor))
   (rt_push actions (c1_reask_question actor))
   (c1_public_methods actions))))
(defn c1_character (id dossier)
 (dv_with (dv_with (dv_with (dv_with (dv_with (dv_m4 "id" id "mind" (c1_subjective_world id)
  "actions" (c1_investigation_actions id) "policy" (c1_person_policy id))
  "balance" (dv_m3 "time" 100000 "computation" 100000 "stamina" 100000))
  "location_ref" (dv_ref id "state" "location")) "location" "hall")
  "question_ref" (dv_ref "question" "state" "current")) "dossier" dossier))
(defn c1_character_detective () (c1_character "detective" "保留从字面到历史时长的跨越；该差异须由实际语义机制形成，不是初始信念。记得上船。"))
(defn c1_character_huo () (c1_character "huo" "钳工；追求那张超越卡诺循环的图；仅有来源的亲见和证言进入认知。"))
(defn c1_character_shen () (c1_character "shen" "烧菜；想护住身边的人；仅记得上船，不预置相熟或天数。"))
(defn c1_character_su () (c1_character "su" "弹琴；追求未闻之声；不预置短居留采纳，须实际听闻和理解。"))


; Truth, personally supported claim, topic relevance and actual shown evidence are independent axes.
; In particular a true location or a bare trust/familiarity claim does not answer the current question.
(defn c1_any (left right) (dv_not (dv_all (dv_pair (dv_not left) (dv_not right)))))
(defn c1_current_question (stage)
 (dv_fact (dv_ref "question" "state" (rt_cat "open_" stage)) true))
(defn c1_identity_complete ()
 (c1_any (dv_all (dv_pair (c1_statement "boots_toward_bolt") (c1_statement "boots_fit")))
   (dv_all (c1_list_4 (c1_statement "lens_mine") (c1_statement "slate_marks")
                      (c1_statement "slate_person") (c1_statement "slate_code")))))
(defn c1_voice_complete ()
 ; Preserve both original lawful showings: E8 plus executed trial, or the E5 hollow-frame evidence.
 (c1_any (dv_all (dv_pair (c1_statement "pipe_layout") (c1_statement "sound_trial")))
        (dv_all (dv_pair (c1_statement "fork_dent") (c1_statement "frame_hollow")))))
(defn c1_words_complete ()
 (c1_any (c1_statement "slate_marks") (c1_statement "score_partial")))
(defn c1_trust_complete ()
 ; E9/E10/E11/E7 remain alternative showings; the reason must still be personally supported.
 (dv_all (dv_pair (c1_statement "trust_reason")
  (c1_any (c1_statement "cups_preferences")
   (c1_any (c1_statement "starter_layers")
    (c1_any (c1_statement "shelf_old") (c1_statement "slate_marks")))))))
(defn c1_complete_reply (id literal support topic complete law source)
 (dv_with (dv_with (dv_with (dv_with (dv_with (dv_with (dv_m3 "id" id "condition" literal "required_support" support)
   "question_match" topic) "answer_complete" complete) "accepted_law" law)
   "accepted_public_grants" (dv_pair (dv_ref "question" "state" "current") (dv_ref "question" "state" "stage")))
   "accepted_listeners" (dv_single "demon")) "source_refs" (dv_single source)))
(defn c1_unasked_reply (id claim source)
 (dv_with (dv_with (c1_complete_reply id claim claim (dv_not (dv_true)) (dv_not (dv_true)) "" source)
   "question_mismatch_reason" "unasked-topic") "incomplete_reason" "true statement lacks the requested cause or answer"))


