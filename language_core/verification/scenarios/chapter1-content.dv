(defn c1_raw_question_object ()
 (c1_state_object "question" (dv_with (dv_with (dv_with (dv_with (dv_with (dv_m4 "current" (dv_field "opening") "stage" (dv_field "opening")
  "original" (dv_field "门是谁闩上的？闩门之时，此人可曾听见门外的呼喊？")
  "awake_scope" (dv_field true)) "requires_evidence" (dv_with (dv_field true) "basis"
   (dv_single (c1_source "godot_csharp/scenes/Awakening/Script/story/第一章/场面/07_答辩.story" 3 "answer_open.002"))))
   "open_identity" (dv_field false)) "open_voice_source" (dv_field false)) "open_words" (dv_field false)) "open_trust" (dv_field false))))
(axiom c1_truth_contract 1 (subject) (dv_true) (rt_list))
(defn c1_register_speech_contract (world)
 (let (basis (dv_single (c1_source "docs/design-standard.md" 462 "contract-8-no-deception"))
       result (dv_adopt world (c1_method "contract-8.truth" (c1_truth_contract "demon")) "enforce" 1
        (dv_single (c1_source "docs/design-standard.md" 462 "contract-8-no-deception"))))
  (dv_with result "speech_contracts" (dv_single (dv_with (dv_with (dv_m4 "id" "contract-8" "subject" "demon"
   "law_id" "contract-8.truth" "version" 1) "require_literal_truth" true) "basis" basis)))))
(defn c1_handling_basis ()
 (dv_pair (c1_source "docs/design-standard.md" 407 "authorized-memory-handling")
  (c1_source "docs/design-standard.md" 452 "authorized-sealing-not-injury")))
(defn c1_question_object ()
 (let (world (dv_add_object (dv_world "question-definition" "physical" "") (c1_raw_question_object)))
  (do
   (set world (dv_store world (dv_ref "question" "state" "memory_removed") (dv_with (dv_field true) "basis" (c1_handling_basis))))
   (set world (dv_store world (dv_ref "question" "state" "not_injury") (dv_with (dv_field true) "basis" (c1_handling_basis))))
   (set world (dv_store world (dv_ref "question" "state" "outstanding_complete") (dv_field false)))
   (set world (dv_store world (dv_ref "question" "state" "level_identity") (dv_field 0)))
   (set world (dv_store world (dv_ref "question" "state" "level_voice_source") (dv_field 0)))
   (set world (dv_store world (dv_ref "question" "state" "level_words") (dv_field 0)))
   (set world (dv_store world (dv_ref "question" "state" "level_trust") (dv_field 0)))
   (set world (dv_store world (dv_ref "question" "state" "solved_identity") (dv_field false)))
   (set world (dv_store world (dv_ref "question" "state" "solved_voice_source") (dv_field false)))
   (set world (dv_store world (dv_ref "question" "state" "solved_words") (dv_field false)))
   (set world (dv_store world (dv_ref "question" "state" "solved_trust") (dv_field false)))
   (dv_get (dv_get world "objects") "question"))))
(axiom c1_original_question_open 1 (question)
 (dv_fact (dv_ref question "state" "stage") "voice_source")
 (dv_single (dv_assign (dv_ref question "state" "outstanding_complete") true)))
(axiom c1_original_question_accept 1 (question)
 (dv_fact (dv_ref question "state" "outstanding_complete") true)
 (dv_single (dv_assign (dv_ref question "state" "outstanding_complete") false)))
