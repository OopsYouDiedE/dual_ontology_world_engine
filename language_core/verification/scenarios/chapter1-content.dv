; Native chapter authorship: named worlds, characters, actions and structured speech.
; Old .story files are read-only provenance. This module never parses their serialized format.
(defn c1_source (path line id) (dv_m3 "path" path "line" line "id" id))
(defn c1_knowledge (atom) (dv_ref "cognition" "state" atom))
(defn c1_at (actor room) (dv_fact (dv_ref actor "state" "location") room))
(defn c1_local_object (id) (dv_object id "perceived" (dv_m2 "state" (rt_list) "identity" (rt_list))))
(defn c1_state_object (id fields) (dv_object id "physical" (dv_m2 "state" fields "identity" (rt_list))))
(defn c1_action (id kind known physical law grants source)
 (dv_with (dv_with (dv_with (dv_m4 "id" id "kind" kind "precondition" known "authority_precondition" physical)
  "law" law) "grants" grants) "source_refs" (dv_single source)))
(defn c1_public_methods (actions)
 (let (result (rt_list) n 0)
  (do (while (rt_lt n (rt_count actions))
   (do (rt_push result (c1_public_method (rt_at actions n))) (set n (rt_add n 1)))) result)))
(defn c1_public_method (action)
 (let (method (dv_with (dv_with action "purpose_refs" (dv_get action "grants")) "purpose_basis" (dv_get action "source_refs"))
       kind (dv_get action "kind"))
  (if (rt_eq kind "answer")
   (dv_with method "topic" (c1_answer_topic (dv_get action "answer_id")))
   (if (dv_or (rt_eq kind "move") (rt_eq kind "replay")) (dv_with method "repeatable" true) method))))
(defn c1_answer_topic (id)
 (if (rt_eq id "me") "identity"
  (if (dv_or (rt_eq id "V3_0") (rt_eq id "V3_1")) "voice_source"
   (if (dv_or (rt_eq id "V4_0") (rt_eq id "V4_1")) "words"
    (if (rt_eq id "trust") "trust" "auxiliary")))))
(defn c1_once (action) (dv_with action "once" true))
(defn c1_observe_as (action source origin trust)
 (dv_with (dv_with (dv_with action "observation_source" source) "observation_origin" origin) "observation_trust" trust))
(defn c1_method (name law) (dv_instance name law))
(defn c1_vector (time) (dv_m3 "time" time "computation" 1 "stamina" 0))
(defn c1_cost (time source) (dv_with (dv_m3 "minimum" (c1_vector time) "maximum" (c1_vector time) "actual" (c1_vector time)) "source_refs" (dv_single source)))


(defn c1_list_4 (p0 p1 p2 p3) (let (list (rt_list)) (do (rt_push list p0) (rt_push list p1) (rt_push list p2) (rt_push list p3) list)))

(defn c1_list_5 (p0 p1 p2 p3 p4) (let (list (rt_list)) (do (rt_push list p0) (rt_push list p1) (rt_push list p2) (rt_push list p3) (rt_push list p4) list)))

