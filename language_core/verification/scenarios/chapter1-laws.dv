; Native chapter law definitions. The original .story files are provenance only.
; Rule premises and effects are authoritative DV expressions, not imported records.

; 可习得命题.story:47, recalled_bolt + boots_toward_bolt + boots_fit => me
(axiom c1_infer_0 1 (knowledge)
  (dv_all (dv_list3
    (dv_fact (dv_ref knowledge "state" "recalled_bolt") true)
    (dv_fact (dv_ref knowledge "state" "boots_toward_bolt") true)
    (dv_fact (dv_ref knowledge "state" "boots_fit") true)))
  (dv_single (dv_assign (dv_ref knowledge "state" "me") true)))

; 可习得命题.story:48, slate_marks + slate_code + slate_person + lens_mine => me
(axiom c1_infer_1 1 (knowledge)
  (dv_all (dv_append (dv_list3
    (dv_fact (dv_ref knowledge "state" "slate_marks") true)
    (dv_fact (dv_ref knowledge "state" "slate_code") true)
    (dv_fact (dv_ref knowledge "state" "slate_person") true))
    (dv_fact (dv_ref knowledge "state" "lens_mine") true)))
  (dv_single (dv_assign (dv_ref knowledge "state" "me") true)))

; 可习得命题.story:49, recalled_bolt => me
(axiom c1_infer_2 1 (knowledge)
  (dv_fact (dv_ref knowledge "state" "recalled_bolt") true)
  (dv_single (dv_assign (dv_ref knowledge "state" "me") true)))

