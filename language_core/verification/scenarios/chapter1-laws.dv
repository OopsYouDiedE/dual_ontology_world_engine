; 热点与布局.story:340-349, 房间名; room adjacency is supplied by instance adoption.
; Only directed edges declared in content setup may be adopted. No global teleport law.
(axiom c1_move 1 (actor origin target)
  (dv_fact (dv_ref actor "state" "location") origin)
  (dv_single (dv_assign (dv_ref actor "state" "location") target)))

; 场面/01_开场.story:28, s3_broadcast.019; opening advances the public protocol only.
(axiom c1_opening_emit 1 (question)
  (dv_fact (dv_ref question "state" "stage") "opening")
  (dv_single (dv_assign (dv_ref question "state" "stage") "prompt")))

; 场面/07_答辩.story:8, answer_q1.001; dispatching a question does not answer it.
(axiom c1_question_emit 1 (question)
  (dv_fact (dv_ref question "state" "stage") "prompt")
  (dv_pair (dv_assign (dv_ref question "state" "current") "identity")
           (dv_assign (dv_ref question "state" "stage") "identity")))

; 场面/07_答辩.story:12/25/34/43, answer_ok1/2/3/4; formal acceptance gates execution.
; This scheduling law has no authority to decide literal truth or support sufficiency.
(axiom c1_question_accept 1 (question current next)
  (dv_all (dv_pair (dv_fact (dv_ref question "state" "current") current)
                   (dv_fact (dv_ref question "state" "stage") current)))
  (dv_pair (dv_assign (dv_ref question "state" "current") next)
           (dv_assign (dv_ref question "state" "stage") next)))

; 可习得命题.story:74-88: helper testimony is received through a co-located action.
; Concrete testimony and its evidential source are supplied by content, not this law.
(axiom c1_meeting 1 (requester speaker room)
  (dv_all (dv_pair (dv_fact (dv_ref requester "state" "location") room)
                   (dv_fact (dv_ref speaker "state" "location") room)))
  (rt_list))

; 场面/05_声路与交谈.story:13, sound_test.003; explicit formal action marker.
; This marker does not simulate acoustic bands or infer unheard sound contents.
(axiom c1_sound_trial 1 (actor ritual room)
  (dv_fact (dv_ref actor "state" "location") room)
  (dv_single (dv_assign (dv_ref ritual "state" "sound_trial_done") true)))
