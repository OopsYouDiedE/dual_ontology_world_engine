// One world and the same session mechanism for all sixteen residents.
fn c1_campaign_scene():
    var scene = c1_opening_install_scene(c1_hist_install_scene(c1_scenario_native()), "侦探")
    scene = c1_other_groups_install_scene(scene)
    var physical = dv_add_object(scene.physical, c1_state_object("campaign.clock", {"minute": dv_field(scene.physical.time)}))
    physical = dv_add_object(physical, c1_state_object("campaign.access", {"living": dv_field(true), "contract": dv_field(false), "astral": dv_field(false), "logistics": dv_field(false)}))
    var actors = []
    var limit = 0
    var i = 0
    while i < rt_count(scene.actors):
        var actor = scene.actors[i]
        if actor.id == "demon":
            var goals = dv_find(actor.policy, "goals", [])
            let groups = ["contract", "astral", "logistics"]
            var j = 0
            while j < rt_count(groups):
                let action = c1_other_open_action(groups[j], "demon")
                rt_push(goals, {"kind": "communicate", "scope": "personal", "method_id": action.id, "available_when": action.precondition, "requires_argument": false, "basis": [c1_other_case(groups[j]).source]})
                j = j + 1
            actor = dv_with(actor, "policy", dv_with(actor.policy, "goals", goals))
        rt_push(actors, actor)
        limit = limit + actor.policy.budget
        i = i + 1
    return dv_with_many(c1_active_configuration(scene), {"physical": physical, "actors": actors, "max_actions": limit, "clock_ref": c1_other_clock_ref()})

// Native first-chapter content for the three other dormitory groups.
// Personal perception, authority history, fallible hypotheses, literal answer and motive hypotheses
// occupy separate fields. No .story loader, answer grants, forced adoption or fixed route.
// This module does not give these people the living-wing broadcast.
// Prior strengths from old authorship remain provenance, not new personality weights.
// c1_other_group_extend installs content; source catalog data alone never completes an action.

fn c1_other_people():
    let key = ["authored-declaration", "c1_other_people"]
    let cached = rt_memo_get([], key)
    if cached[0]:
        return cached[1]
    return rt_memo_put([], key, c1_other_people_build())

fn c1_other_people_build():
    var result = []
    rt_push(result, {"id": "quer", "name": "雀儿", "group": "contract", "desire": "一个不会赶她走的地方", "initial_surface": "门。门闩在外面。", "material_surface": "袋子还在，口扎得死紧。我的结。", "intention_surface": "先看看那道门闩。", "memory_surface": "怎么来的？上船，然后……不知道。", "memory_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 47, "opening_quer.003"), "initial_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 46, "opening_quer.002"), "material_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 48, "opening_quer.004"), "desire_source": c1_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/07_雀儿.story", 10, "quer.desire")})
    rt_push(result, {"id": "lucian", "name": "卢西安", "group": "contract", "desire": "言灵的完美韵律", "initial_surface": "嘴边有一句诗，念到一半，韵脚找不着了。", "material_surface": "桌上的笔记是我的字，比平时潦草。", "intention_surface": "先找那个韵。", "memory_surface": "上船之后呢？也找不着了。", "memory_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 31, "opening_lucian.003"), "initial_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 30, "opening_lucian.002"), "material_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 32, "opening_lucian.004"), "desire_source": c1_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/05_卢西安.story", 10, "lucian.desire")})
    rt_push(result, {"id": "ward", "name": "沃德", "group": "contract", "desire": "成为定规则的人", "initial_surface": "纸。笔。都在桌上。", "material_surface": "笔尖是新削的。", "intention_surface": "从现在开始记。", "memory_surface": "上船以后的事，一个字也没有记下。这不像我。", "memory_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 55, "opening_ward.003"), "initial_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 54, "opening_ward.002"), "material_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 56, "opening_ward.004"), "desire_source": c1_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/08_沃德.story", 10, "ward.desire")})
    rt_push(result, {"id": "gu", "name": "顾平章", "group": "contract", "desire": "读通古代铭文", "initial_surface": "老花镜搁在枕边，镜片上溅了一点墨。", "material_surface": "枕边这摞拓片，是哪里的碑？", "intention_surface": "先把镜片擦干净。", "memory_surface": "老朽记得上了船。再往后，就记不起了。", "memory_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 39, "opening_gu.003"), "initial_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 38, "opening_gu.002"), "material_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 40, "opening_gu.004"), "desire_source": c1_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/06_顾平章.story", 10, "gu.desire")})
    rt_push(result, {"id": "ruan", "name": "阮清月", "group": "astral", "desire": "赢下与恶魔的对局", "initial_surface": "枕边一枚黑子，凉的。", "material_surface": "桌上一盘棋下到中盘。轮到黑走。我记不起这一手要下在哪。", "intention_surface": "先不下。", "memory_surface": "上船，然后是一段空白。", "memory_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 71, "opening_ruan.003"), "initial_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 70, "opening_ruan.002"), "material_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 72, "opening_ruan.004"), "desire_source": c1_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/10_阮清越.story", 10, "ruan.desire")})
    rt_push(result, {"id": "elena", "name": "伊莲娜", "group": "astral", "desire": "治好脚踝，查明仪式真相", "initial_surface": "左脚踝缠着绷带。一动，疼得眼前发白。", "material_surface": "脚尖自己绷了一下，像要起步。", "intention_surface": "别站。再躺一会儿。", "memory_surface": "我是怎么伤的？只记得上船。", "memory_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 79, "opening_elena.003"), "initial_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 78, "opening_elena.002"), "material_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 80, "opening_elena.004"), "desire_source": c1_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/11_伊莲娜.story", 10, "elena.desire")})
    rt_push(result, {"id": "selma", "name": "赛尔玛", "group": "astral", "desire": "为源质这一新物种定名", "initial_surface": "窗台上一盆苗，没见过，叶背亮得像抹了油。", "material_surface": "本子上画着这片叶子，编号那一栏空着。我画的，我没编。", "intention_surface": "查看叶子和本子。", "memory_surface": "船靠岸了吗？想不起来。", "memory_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 63, "opening_selma.003"), "initial_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 62, "opening_selma.002"), "material_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 64, "opening_selma.004"), "desire_source": c1_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/09_赛尔玛.story", 10, "selma.desire")})
    rt_push(result, {"id": "moran", "name": "莫兰", "group": "astral", "desire": "看见更多的以太色层", "initial_surface": "窗光是灰的。灰底下，还有一层很淡的绿。", "material_surface": "速写本摊着，炭笔滚在手边。", "intention_surface": "那层绿要散了。", "memory_surface": "船……之后是白的。", "memory_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 87, "opening_moran.003"), "initial_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 86, "opening_moran.002"), "material_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 88, "opening_moran.004"), "desire_source": c1_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/12_莫兰.story", 10, "moran.desire")})
    rt_push(result, {"id": "mora", "name": "茉拉", "group": "logistics", "desire": "不再失去病人", "initial_surface": "药包。……在。", "material_surface": "围裙兜里有半卷绷带。", "intention_surface": "外面有人咳嗽。", "memory_surface": "上船以后的事，想不起来。", "memory_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 119, "opening_mora.003"), "initial_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 118, "opening_mora.002"), "material_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 120, "opening_mora.004"), "desire_source": c1_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/16_茉拉.story", 10, "mora.desire")})
    rt_push(result, {"id": "bertrand", "name": "贝尔特朗", "group": "logistics", "desire": "护住平民同伴", "initial_surface": "手先摸到床边的提灯。灯油还有半截。", "material_surface": "左肩的皮垫磨亮了。那是托枪的地方，可枪不在。", "intention_surface": "门外有动静。", "memory_surface": "上船。然后就是这间屋子。中间缺了一段。", "memory_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 103, "opening_bertrand.003"), "initial_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 102, "opening_bertrand.002"), "material_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 104, "opening_bertrand.004"), "desire_source": c1_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/14_贝尔特朗.story", 10, "bertrand.desire")})
    rt_push(result, {"id": "veronica", "name": "维罗妮卡", "group": "logistics", "desire": "独立研究，证明理化能解释一切", "initial_surface": "一股试剂味，很淡，像是乙醚挥发过。", "material_surface": "器具都在架上，摆得比我习惯的还整齐。谁替我摆的？", "intention_surface": "先查瓶签。", "memory_surface": "最后记得的事：上船。之后的，一件也想不起来。", "memory_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 95, "opening_veronica.003"), "initial_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 94, "opening_veronica.002"), "material_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 96, "opening_veronica.004"), "desire_source": c1_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/13_维罗妮卡.story", 10, "veronica.desire")})
    rt_push(result, {"id": "margaret", "name": "玛格丽特", "group": "logistics", "desire": "亲手建成、被人承认", "initial_surface": "天花板的梁是斜搭的。这跨度，搭得有点悬。", "material_surface": "卷尺和铅垂还挂在腰上，睡觉都没解。", "intention_surface": "先看看这屋子承不承得住。", "memory_surface": "我记得上船。之后的事，一点也想不起来。", "memory_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 111, "opening_margaret.003"), "initial_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 110, "opening_margaret.002"), "material_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 112, "opening_margaret.004"), "desire_source": c1_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/15_玛格丽特.story", 10, "margaret.desire")})
    return result

fn c1_other_person(id):
    var rows = c1_other_people()
    var i = 0
    while (i < rt_count(rows)):
        if (rows[i].id == id):
            return rows[i]
        i = (i + 1)
    dv_require(false, "Unknown chapter-one other-group actor")
    return false

fn c1_other_case(group):
    if (group == "contract"):
        return {"id": "contract", "room": "dorm.contract", "zone": "甲区", "prompt": "谁开启内柜，物品藏在哪里，又做了什么？", "options": ["quer", "ward", "gu", "lucian"], "reason_options": ["authorized_transfer", "theft"], "reason_surfaces": ["受命转移文书", "私自行窃"], "authority_actor": "quer", "authority_reason": "authorized_transfer", "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 9, "文契"), "outside_evidence_surface": "无署名、无日期的《紧急转移清册》残页记着交“雀（J.C.）”用钥匙转移管网图；须与残角、柜锁及管网图去向合并核对", "outside_evidence_scope": "requires-local-inspection-and-personal-testimony"}
    if (group == "astral"):
        return {"id": "astral", "room": "dorm.astral", "zone": "丙区", "prompt": "是谁让一个人留在了沉静室里？", "options": ["ruan", "selma", "moran"], "reason_options": ["self_preservation", "requested_closure"], "reason_surfaces": ["单方面止损、保住多数而封门", "伊莲娜示意关门"], "authority_actor": "ruan", "authority_reason": "requested_closure", "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 28, "星仪"), "outside_evidence_surface": "莫兰撕下的那页速写：伊莲娜在门内抬手示意；沉静室门内的步位标线一道不乱", "outside_evidence_scope": "requires-local-inspection-and-personal-testimony"}
    if (group == "logistics"):
        return {"id": "logistics", "room": "dorm.logistics", "zone": "丁区", "prompt": "白塔柜里那瓶试剂，是谁取走的？", "options": ["veronica", "mora", "bertrand", "margaret"], "reason_options": ["experiment", "wound_cleaning"], "reason_surfaces": ["未经医嘱进行激进酸试验", "依据自体耐受标定救治贝尔特朗"], "authority_actor": "veronica", "authority_reason": "wound_cleaning", "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 45, "后勤"), "outside_evidence_surface": "维罗妮卡左臂的旧疤与本人对稀酸清创的解释", "outside_evidence_scope": "requires-local-inspection-and-personal-testimony"}
    dv_require(false, "Unknown chapter-one dormitory group")
    return false

fn c1_other_traces(group):
    var result = []
    if (group == "contract"):
        rt_push(result, {"id": "wet_rubbing", "surface": "顾平章的拓片墨迹未干。", "excluded_actor": "gu", "needs_actual_witness": false, "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 18, "拓片墨未干")})
    if (group == "contract"):
        rt_push(result, {"id": "continuous_manuscript", "surface": "卢西安的手稿写满三页，墨迹连贯。", "excluded_actor": "lucian", "needs_actual_witness": false, "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 19, "手稿写满三页")})
    if (group == "contract"):
        rt_push(result, {"id": "lock_checklist", "surface": "沃德的柜锁清单上压着笔痕，写的是记录。", "excluded_actor": "ward", "needs_actual_witness": false, "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 20, "清单上的笔痕")})
    if (group == "astral"):
        rt_push(result, {"id": "continuous_specimen_notes", "surface": "赛尔玛的标本笔记一条接一条，时刻连着。", "excluded_actor": "selma", "needs_actual_witness": false, "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 37, "标本笔记不断")})
    if (group == "astral"):
        rt_push(result, {"id": "remaining_sketches", "surface": "莫兰的速写本撕掉了一页，剩下的都是共鸣厅里的人，没有门。", "excluded_actor": "moran", "needs_actual_witness": false, "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 38, "速写本缺页")})
    if (group == "logistics"):
        rt_push(result, {"id": "sealed_medicine", "surface": "茉拉药包的封条完好。", "excluded_actor": "mora", "needs_actual_witness": false, "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 54, "药包封条完好")})
    if (group == "logistics"):
        rt_push(result, {"id": "lamp_and_no_reagent", "surface": "玛格丽特的提灯灯油耗了一半，手上没有试剂味。", "excluded_actor": "margaret", "needs_actual_witness": false, "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 55, "提灯油耗一半")})
    if (group == "logistics"):
        rt_push(result, {"id": "matching_lamps", "surface": "两盏提灯的灯油耗相同。", "excluded_actor": "bertrand", "needs_actual_witness": true, "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 56, "两盏灯互证")})
    return result

fn c1_other_ref(group, field):
    return dv_ref(rt_cat("case.", group), "state", field)

fn c1_other_claim(group, field):
    return dv_fact(c1_other_ref(group, field), true)

fn c1_other_identity(group, actor):
    return c1_other_claim(group, rt_cat("answer.", actor))

// These old-source trace/actor associations are defeasible personal hypotheses.
// No inference law writes an exclusion or an answer merely from ink, a drawing,
// a seal, smell, or equal lamp consumption. Contrary personal evidence revises
// them through the shared hypothesis selector.
fn c1_other_exclusion_hypotheses(id):
    let person = c1_other_person(id)
    let spec = c1_other_case(person.group)
    let traces = c1_other_traces(person.group)
    var result = []
    var i = 0
    while i < rt_count(traces):
        let trace = traces[i]
        let observed = c1_other_claim(person.group, rt_cat("trace.", trace.id))
        let proposition = dv_not(c1_other_identity(person.group, trace.excluded_actor))
        var available = dv_all(dv_pair(c1_other_claim(person.group, "open"), observed))
        if trace.needs_actual_witness:
            available = dv_all(dv_pair(available, c1_other_claim(person.group, "mutual_witness_received")))
        rt_push(result, {"id": rt_cat(rt_cat(id, ".exclusion."), trace.id), "question": rt_cat(person.group, ".identity"), "group": rt_cat(person.group, ".identity"), "proposition": proposition, "prior": 0.5, "available_when": available, "basis": [trace.source], "kind": "fallible-trace-heuristic", "observed_premise": observed, "scope": "present-material-to-past-activity", "missing_support": "independent-event-time-or-personal-witness", "established": false})
        i = i + 1
    return result

axiom c1_other_question_open(group):
    var effects = dv_pair(dv_assign(c1_other_ref(group, "open"), true), dv_assign(c1_other_ref(group, "current"), rt_cat(group, ".identity")))
    var people = c1_other_people()
    var i = 0
    while (i < rt_count(people)):
        if (people[i].group == group):
            rt_push(effects, dv_assign(dv_ref(rt_cat("personal.", people[i].id), "state", "current"), rt_cat(group, ".identity")))
        i = (i + 1)
    return dv_axiom(rt_cat("c1_other_question_open.", group), 1, dv_fact(c1_other_ref(group, "open"), false), effects)

axiom c1_other_accept(group, actor):
    return dv_axiom(rt_cat(rt_cat("c1_other_accept.", group), rt_cat(".", actor)), 1, c1_other_claim(group, "open"), dv_list3(dv_assign(c1_other_ref(group, rt_cat("receipt.", actor)), true), dv_assign(c1_other_ref(group, rt_cat("level.", actor)), 1), dv_assign(dv_ref(rt_cat("personal.", actor), "state", "current"), rt_cat(group, ".reason"))))

// A valid duty report permits a real release action at the shared living hall.
axiom c1_other_release(group, clock_ref):
    var people = c1_other_people()
    var reported = dv_not(dv_true())
    var i = 0
    while (i < rt_count(people)):
        if (people[i].group == group):
            reported = c1_any(reported, c1_other_claim(group, rt_cat("receipt.", people[i].id)))
        i = (i + 1)
    var safe_time = 840
    var safety = c1_other_claim(group, "evidence_complete")
    if group == "astral":
        safe_time = 1890
        safety = dv_all([c1_other_claim(group, "care_given"), c1_other_claim(group, "west_passage_checked")])
    if group == "logistics":
        safe_time = 2010
        safety = dv_all([c1_other_claim(group, "care_given"), c1_other_claim(group, "observation_complete")])
    return dv_axiom(rt_cat("c1_other_release.", group), 1, dv_all([reported, safety, dv_at_least(clock_ref, safe_time), c2_at("demon", "living_hall"), dv_fact(dv_ref("demon.body", "state", "manifested"), true), dv_fact(c1_other_ref(group, "formal_release"), false)]), [dv_assign(c1_other_ref(group, "outer_latch_released"), true), dv_assign(c1_other_ref(group, "formal_release"), true), dv_assign(c1_other_access_ref(group), true), dv_assign(dv_ref("demon.body", "state", "manifested"), false), dv_assign(dv_ref("demon.body", "state", "latch_hand_trace"), "long-narrow-hand")])

fn c1_other_open_action(group, speaker):
    var spec = c1_other_case(group)
    var action = c1_once(c1_action(rt_cat("other.question.", group), "question", c1_at(speaker, "living_hall"), dv_all(dv_pair(c1_at(speaker, "living_hall"), dv_fact(c1_other_ref(group, "open"), false))), rt_cat("other.open.", group), [], spec.source))
    var speech = dv_with_many(c1_speech(dv_true(), spec.source, "group-question-not-an-asserted-answer"), {"surface": rt_cat("铜口里传来声音：", spec.prompt), "utterance_type": "question", "channel": rt_cat("copper.", group)})
    var listeners = []
    var grants = dv_pair(c1_other_ref(group, "open"), c1_other_ref(group, "current"))
    var people = c1_other_people()
    var i = 0
    while (i < rt_count(people)):
        if (people[i].group == group):
            rt_push(listeners, people[i].id)
            rt_push(grants, dv_ref(rt_cat("personal.", people[i].id), "state", "current"))
        i = (i + 1)
    return dv_with(dv_with(dv_with(dv_with(action, "speech", speech), "listeners", listeners), "public_grants", grants), "purpose_refs", dv_single(c1_other_ref(group, "open")))

fn c1_other_inspections(id):
    var person = c1_other_person(id)
    var spec = c1_other_case(person.group)
    var rows = c1_other_traces(person.group)
    var result = []
    var i = 0
    while (i < rt_count(rows)):
        var row = rows[i]
        var ref = c1_other_ref(person.group, rt_cat("trace.", row.id))
        var action = c1_once(c1_action(rt_cat(rt_cat(id, ".inspect."), row.id), "inspect", c1_at(id, spec.room), c1_at(id, spec.room), "", dv_single(ref), row.source))
        rt_push(result, dv_with(action, "surface", row.surface))
        i = (i + 1)
    if id == "lucian":
        let departed = c1_any(c1_at("quer", "threshold.contract"), c1_at("quer", "living_hall"))
        rt_push(result, dv_with(c1_action("lucian.inspect.quer-departure", "inspect", dv_all([c1_at(id, spec.room), departed]), dv_all([c1_at(id, spec.room), departed]), "", [dv_ref("quer", "state", "location")], spec.source), "surface", "卢西安从门边确认雀儿已经走出甲区。"))
    var own_ref = dv_ref(rt_cat("personal.", id), "state", "material_detail")
    rt_push(result, dv_with(c1_once(c1_action(rt_cat(id, ".inspect.own-material"), "inspect", c1_at(id, spec.room), c1_at(id, spec.room), "", dv_single(own_ref), person.material_source)), "surface", person.material_surface))
    return result

fn c1_other_answer_actions(id):
    var person = c1_other_person(id)
    var spec = c1_other_case(person.group)
    var result = []
    var i = 0
    while (i < rt_count(spec.options)):
        var option = spec.options[i]
        var answer = c1_other_submission(person.group, option)
        var action_id = rt_cat(rt_cat(rt_cat(id, ".answer."), person.group), rt_cat(".", option))
        var known = dv_all([c1_at(id, spec.room), c1_other_claim(person.group, "open"), answer, dv_at_least(c1_other_clock_ref(), c1_other_report_time(person.group))])
        var action = c1_action(action_id, "answer", known, known, "", [], spec.source)
        var speech = dv_with(c1_speech(answer, spec.source, "literal-actor-only-not-motive"), "surface", rt_cat(c1_other_person(option).name, c1_other_report_surface(person.group)))
        rt_push(result, dv_with_many(action, {"answer": answer, "answer_id": action_id, "topic": rt_cat(person.group, ".identity"), "speech": dv_with(speech, "channel", rt_cat("copper.", person.group)), "listeners": dv_single("demon"), "authority_precondition": dv_all([c1_at(id, spec.room), c1_other_claim(person.group, "open"), c1_at("demon", "living_hall"), dv_at_least(c1_other_clock_ref(), c1_other_report_time(person.group))]), "purpose_refs": dv_single(c1_other_ref(person.group, rt_cat("receipt.", id)))}))
        i = (i + 1)
    return result

fn c1_other_formal_answers():
    var people = c1_other_people()
    var result = []
    var i = 0
    while (i < rt_count(people)):
        var person = people[i]
        var spec = c1_other_case(person.group)
        var j = 0
        while (j < rt_count(spec.options)):
            var option = spec.options[j]
            var literal = c1_other_submission(person.group, option)
            var id = rt_cat(rt_cat(rt_cat(person.id, ".answer."), person.group), rt_cat(".", option))
            rt_push(result, {"id": id, "stage": rt_cat(person.group, ".identity"), "condition": literal, "required_support": literal, "question_match": c1_other_claim(person.group, "open"), "answer_complete": literal, "require_argument": false, "accepted_law": rt_cat(rt_cat("other.accept.", person.group), rt_cat(".", person.id)), "progress_ref": c1_other_ref(person.group, rt_cat("level.", person.id)), "completion_ref": c1_other_ref(person.group, rt_cat("receipt.", person.id)), "accepted_listeners": [person.id, "demon"], "accepted_public_grants": [c1_other_ref(person.group, rt_cat("receipt.", person.id)), c1_other_ref(person.group, rt_cat("level.", person.id)), dv_ref(rt_cat("personal.", person.id), "state", "current"), c1_other_clock_ref()], "source_refs": dv_single(spec.source)})
            j = (j + 1)
        i = (i + 1)
    return result

fn c1_other_preconception(id):
    if (id == "ward"):
        return {"preferred": "theft", "source_strength": 3, "basis": dv_single(c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 22, "ward.preconception")), "kind": "authored-preconception-not-evidence"}
    if (id == "gu"):
        return {"preferred": "theft", "source_strength": 1, "basis": dv_single(c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 23, "gu.preconception")), "kind": "authored-preconception-not-evidence"}
    if (id == "lucian"):
        return {"preferred": "authorized_transfer", "source_strength": 1, "basis": dv_single(c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 24, "lucian.preconception")), "kind": "authored-preconception-not-evidence"}
    if (id == "elena"):
        return {"preferred": "self_preservation", "source_strength": 3, "basis": dv_single(c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 40, "elena.preconception")), "kind": "authored-preconception-not-evidence"}
    if (id == "selma"):
        return {"preferred": "self_preservation", "source_strength": 1, "basis": dv_single(c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 41, "selma.preconception")), "kind": "authored-preconception-not-evidence"}
    if (id == "mora"):
        return {"preferred": "experiment", "source_strength": 3, "basis": dv_single(c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 58, "mora.preconception")), "kind": "authored-preconception-not-evidence"}
    if (id == "bertrand"):
        return {"preferred": "experiment", "source_strength": 1, "basis": dv_single(c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 59, "bertrand.preconception")), "kind": "authored-preconception-not-evidence"}
    return false

fn c1_other_reason_hypotheses(id):
    var person = c1_other_person(id)
    var spec = c1_other_case(person.group)
    var bias = c1_other_preconception(id)
    var options = spec.reason_options
    var ordered = []
    var i = 0
    if (not (bias == false)):
        rt_push(ordered, bias.preferred)
    while (i < rt_count(options)):
        if (not dv_has(ordered, options[i])):
            rt_push(ordered, options[i])
        i = (i + 1)
    var result = []
    i = 0
    while (i < rt_count(ordered)):
        var option = ordered[i]
        var basis = dv_single(spec.source)
        if (not (bias == false)):
            if (bias.preferred == option):
                basis = bias.basis
        var proposition = c1_other_claim(person.group, rt_cat("reason.", option))
        rt_push(result, {"id": rt_cat(rt_cat(person.group, ".reason."), option), "question": rt_cat(person.group, ".reason"), "group": rt_cat(person.group, ".reason"), "proposition": proposition, "assumptions": dv_single(proposition), "prior": 0.5, "available_when": c1_other_claim(person.group, rt_cat("receipt.", id)), "basis": basis, "interpretation_scope": "motive-separate-from-accepted-literal-actor", "source_preconception": bias})
        i = (i + 1)
    return result

fn c1_other_mind(id):
    var person = c1_other_person(id)
    var spec = c1_other_case(person.group)
    var mind = dv_with(dv_world(rt_cat("mind.", id), "mind", id), "time", 480)
    mind = dv_add_object(mind, c1_position(id, spec.room))
    mind = dv_add_object(mind, c1_local_object(rt_cat("case.", person.group)))
    var people = c1_other_people()
    var peer_index = 0
    while (peer_index < rt_count(people)):
        if (people[peer_index].group == person.group):
            mind = dv_add_object(mind, c1_local_object(rt_cat("personal.", people[peer_index].id)))
            if people[peer_index].id != id:
                mind = dv_add_object(mind, c1_local_object(people[peer_index].id))
        peer_index = (peer_index + 1)
    mind = dv_add_object(mind, c1_state_object("memory", dv_single(dv_pair("empty_school_recall", dv_with(dv_field(true), "basis", dv_single(person.memory_source))))))
    mind = dv_store(mind, dv_ref(rt_cat("personal.", id), "state", "initial_surface"), dv_with(dv_field(person.initial_surface), "basis", dv_single(person.initial_source)))
    return mind

fn c1_other_policy(id):
    var person = c1_other_person(id)
    var spec = c1_other_case(person.group)
    var goals = []
    var i = 0
    while (i < rt_count(spec.options)):
        rt_push(goals, {"kind": "know", "question": rt_cat(person.group, ".identity"), "ref": c1_other_ref(person.group, rt_cat("answer.", spec.options[i])), "available_when": c1_other_claim(person.group, "open"), "basis": dv_single(spec.source)})
        i = (i + 1)
    rt_push(goals, c2_goal(c1_other_claim(person.group, rt_cat("receipt.", id)), dv_all([c1_other_claim(person.group, "open"), dv_at_least(c1_other_clock_ref(), c1_other_report_time(person.group))]), [spec.source]))
    rt_push(goals, {"kind": "know", "question": "own_material", "ref": dv_ref(rt_cat("personal.", id), "state", "material_detail"), "basis": dv_pair(person.material_source, person.desire_source)})
    if id == "lucian":
        rt_push(goals, c2_observation_goal(dv_ref("quer", "state", "location"), c1_other_claim("contract", "outer_latch_released"), [spec.source], 0))
    var hypotheses = c1_other_exclusion_hypotheses(id)
    var reasons = c1_other_reason_hypotheses(id)
    i = 0
    while (i < rt_count(reasons)):
        rt_push(hypotheses, reasons[i])
        i = (i + 1)
    return dv_with_many(c1_player_policy(), {"hypotheses": hypotheses, "goals": goals, "desire": {"surface": person.desire, "basis": dv_single(person.desire_source), "fulfillment": "not-asserted"}, "notice_co_presence": true, "topic_bindings": dv_pair({"topic": "own_material", "heard_when": dv_true(), "completed_when": dv_not(dv_true()), "basis": dv_single(person.material_source)}, {"topic": rt_cat(person.group, ".reason"), "heard_when": c1_other_claim(person.group, rt_cat("receipt.", id)), "completed_when": dv_not(dv_true()), "basis": dv_single(spec.source)})})

fn c1_other_character(id):
    var person = c1_other_person(id)
    var actions = c1_other_inspections(id)
    var answers = c1_other_answer_actions(id)
    var i = 0
    while (i < rt_count(answers)):
        rt_push(actions, answers[i])
        i = (i + 1)
    var replies = c1_other_personal_replies(id)
    i = 0
    while (i < rt_count(replies)):
        rt_push(actions, replies[i])
        i = (i + 1)
    return {"id": id, "mind": c1_other_mind(id), "actions": actions, "policy": c1_other_policy(id), "balance": {"time": 100000, "computation": 100000, "stamina": 100000}, "location_ref": dv_ref(id, "state", "location"), "location": c1_other_case(person.group).room, "question_ref": dv_ref(rt_cat("personal.", id), "state", "current"), "dossier": person}

fn c1_other_groups_actors():
    var result = []
    var people = c1_other_people()
    var i = 0
    while (i < rt_count(people)):
        rt_push(result, c1_other_character(people[i].id))
        i = (i + 1)
    return result

// Real physical authored traces and literal history; invisible answer fields are never grants.
fn c1_other_group_extend(world, group):
    var spec = c1_other_case(group)
    var fields = {"open": dv_field(false), "current": dv_field(""), "outer_latch_released": dv_field(false), "formal_release": dv_field(false)}
    var i = 0
    while (i < rt_count(spec.options)):
        fields = dv_with(fields, rt_cat("answer.", spec.options[i]), dv_field((spec.options[i] == spec.authority_actor)))
        i = (i + 1)
    i = 0
    while (i < rt_count(spec.reason_options)):
        fields = dv_with(fields, rt_cat("reason.", spec.reason_options[i]), dv_field((spec.reason_options[i] == spec.authority_reason)))
        i = (i + 1)
    var traces = c1_other_traces(group)
    i = 0
    while (i < rt_count(traces)):
        fields = dv_with(fields, rt_cat("trace.", traces[i].id), dv_field(true))
        i = (i + 1)
    var people = c1_other_people()
    i = 0
    var result = world
    while (i < rt_count(people)):
        var person = people[i]
        if (person.group == group):
            fields = dv_with(fields, rt_cat("receipt.", person.id), dv_field(false))
            fields = dv_with(fields, rt_cat("level.", person.id), dv_field(0))
            result = dv_add_object(result, c1_position(person.id, spec.room))
            result = dv_add_object(result, c1_state_object(rt_cat("personal.", person.id), {"material_detail": dv_field(person.material_surface), "current": dv_field("")}))
            result = dv_adopt(result, c1_method(rt_cat(rt_cat("other.accept.", group), rt_cat(".", person.id)), c1_other_accept(group, person.id)), "enforce", 1, dv_single(spec.source))
        i = (i + 1)
    result = dv_add_object(result, c1_state_object(rt_cat("case.", group), fields))
    result = dv_adopt(result, c1_method(rt_cat("other.open.", group), c1_other_question_open(group)), "enforce", 1, dv_single(spec.source))
    return c1_other_activity_physical(result, group)

fn c1_other_groups_physical(world):
    return c1_other_group_extend(c1_other_group_extend(c1_other_group_extend(world, "contract"), "astral"), "logistics")

fn c1_other_groups_bindings():
    var people = c1_other_people()
    var result = []
    var i = 0
    while (i < rt_count(people)):
        var person = people[i]
        rt_push(result, dv_binding(person.id, person.id, person.id))
        rt_push(result, dv_binding(rt_cat("case.", person.group), rt_cat("case.", person.group), person.id))
        var j = 0
        while (j < rt_count(people)):
            if (people[j].group == person.group):
                rt_push(result, dv_binding(rt_cat("personal.", people[j].id), rt_cat("personal.", people[j].id), person.id))
                if people[j].id != person.id:
                    rt_push(result, dv_binding(people[j].id, people[j].id, person.id))
            j = (j + 1)
        i = (i + 1)
    return result

fn c1_other_groups_question_actions(speaker):
    return dv_list3(c1_other_open_action("contract", speaker), c1_other_open_action("astral", speaker), c1_other_open_action("logistics", speaker))

fn c1_other_groups_release_laws(clock_ref):
    return dv_list3(c1_other_release("contract", clock_ref), c1_other_release("astral", clock_ref), c1_other_release("logistics", clock_ref))

// Personal reports quote the actor's own inspected material. They do not turn a
// handwritten page, lamp oil or familiar knot into a recovered night's memory.
fn c1_other_personal_replies(id):
    var person = c1_other_person(id)
    var ref = dv_ref(rt_cat("personal.", id), "state", "material_detail")
    var known = dv_fact(ref, person.material_surface)
    var people = c1_other_people()
    var result = []
    var i = 0
    while (i < rt_count(people)):
        var other = people[i]
        if dv_and((other.group == person.group), (not (other.id == id))):
            var action = c1_action(rt_cat(rt_cat(id, ".reply.own-material."), other.id), "talk", known, c1_at(id, c1_other_case(person.group).room), "", [], person.material_source)
            var speech = dv_with(c1_speech(known, person.material_source, "personally-inspected-material-not-night-witness"), "surface", person.material_surface)
            rt_push(result, dv_with_many(action, {"speech": speech, "listeners": dv_single(other.id), "offer_to": other.id, "response_topic": rt_cat("own_material.", id)}))
        i = (i + 1)
    return result

fn c1_other_release_action(group, speaker, clock_ref):
    var law = c1_other_release(group, clock_ref)
    var surface = "从起居厅一侧抬起寝区外闩，正式宣告放行。"
    if group == "contract":
        surface = "代管者复核已被挑开的甲区门闩，正式宣告沃德等人可以离开。"
    let action = c1_action(rt_cat("other.release.", group), "help", law.premise, law.premise, rt_cat("other.release.", group), [c1_other_ref(group, "outer_latch_released"), c1_other_ref(group, "formal_release"), c1_other_access_ref(group), dv_ref("demon.body", "state", "manifested")], c1_other_case(group).source)
    return dv_with_many(action, {"surface": surface, "predict_law": rt_cat("other.release.", group), "speech": dv_with_many(c1_speech(dv_true(), c1_other_case(group).source, "actual-formal-release"), {"surface": surface, "channel": rt_cat("copper.", group)}), "listeners": c1_other_group_listeners(group, ""), "public_grants": [c1_other_ref(group, "outer_latch_released"), c1_other_ref(group, "formal_release"), c1_other_access_ref(group), c1_other_clock_ref()]})

fn c1_other_departure_source(id):
    if (id == "lucian"):
        return {"target": "Living", "surface": "在起居厅听见乙区门里有人说话，靠在对面墙上等着", "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 8, "lucian.departure"), "source_duration": 12}
    if (id == "gu"):
        return {"target": "Living", "surface": "在起居厅北台的书架前，把认得的书脊一行行抄下来", "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 11, "gu.departure"), "source_duration": 12}
    if (id == "quer"):
        return {"target": "Living", "surface": "蹲在乙区门外看那道外闩，只看不碰", "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 14, "quer.departure"), "source_duration": 12}
    if (id == "ward"):
        return {"target": "Living", "surface": "在起居厅公告板张贴《私取者戒》，把未经公开授权的私藏定为窃取", "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 17, "ward.departure"), "source_duration": 12}
    if (id == "selma"):
        return {"target": "Greenhouse", "surface": "离开丙区到温室查看标本，把寝区观察与新环境分开记", "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 20, "selma.departure"), "source_duration": 12}
    if (id == "ruan"):
        return {"target": "Hall", "surface": "到中央厅收起棋子，核对自己能确认的物品数目", "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 23, "ruan.departure"), "source_duration": 12}
    if (id == "elena"):
        return {"target": "Hall", "surface": "离开丙区后在中央厅坐下，避开伤脚久站", "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 26, "elena.departure"), "source_duration": 12}
    if (id == "moran"):
        return {"target": "Hall", "surface": "到中央厅观察窗光，翻看刚才画出的色层", "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 29, "moran.departure"), "source_duration": 12}
    if (id == "veronica"):
        return {"target": "Logistics", "surface": "离开丁区到后勤院查看公用器具，暂不取用未知试剂", "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 32, "veronica.departure"), "source_duration": 12}
    if (id == "bertrand"):
        return {"target": "Hall", "surface": "从丁区出来巡看中央厅的通路，给后来的人留出门口", "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 35, "bertrand.departure"), "source_duration": 12}
    if (id == "margaret"):
        return {"target": "Hall", "surface": "走到中央厅把真正看见的门外尺寸补进草图", "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 38, "margaret.departure"), "source_duration": 12}
    if (id == "mora"):
        return {"target": "Clinic", "surface": "离开丁区到诊疗所清点可用敷料，预备有人求助", "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 41, "mora.departure"), "source_duration": 12}
    dv_require(false, "Unknown chapter-one departure actor")
    return false

// Source-directed departure remains optional and requires actual opened-latch observation.
// The caller installs this law in physical/enforce and this person's mind/predict.
axiom c1_other_depart(id):
    var person = c1_other_person(id)
    var source = c1_other_departure_source(id)
    var premise = dv_all(dv_list3(c1_at(id, c1_other_case(person.group).room), c1_other_claim(person.group, "outer_latch_released"), dv_fact(c1_other_access_ref(person.group), true)))
    if id == "ward" or id == "gu":
        premise = dv_all([premise, c1_other_claim("contract", rt_cat("receipt.", id)), c1_other_claim("contract", "formal_release"), dv_at_least(c1_other_clock_ref(), 840)])
    if id != "quer" and id != "lucian" and id != "ward" and id != "gu":
        premise = dv_all([premise, c1_other_claim(person.group, "formal_release")])
    if id == "lucian":
        premise = dv_all([premise, c1_any(c1_at("quer", "threshold.contract"), c1_at("quer", "living_hall"))])
    return dv_axiom(rt_cat("c1_other_depart.", id), 1, premise, dv_single(dv_assign(dv_ref(id, "state", "location"), c1_other_threshold(person.group))))

fn c1_other_departure_actions(id):
    var person = c1_other_person(id)
    var room = c1_other_case(person.group).room
    var source = c1_other_departure_source(id)
    var ref = c1_other_ref(person.group, "outer_latch_released")
    var inspect = dv_with(c1_action(rt_cat(id, ".inspect.outer-latch"), "inspect", c1_at(id, room), c1_at(id, room), "", dv_pair(ref, c1_other_access_ref(person.group)), source.source), "repeatable", true)
    var premise = c1_other_depart(id).premise
    var depart = dv_with_many(c1_action(rt_cat(id, ".leave-dormitory"), "move", premise, premise, rt_cat("other.depart.", id), dv_single(dv_ref(id, "state", "location")), source.source), {"predict_law": rt_cat("other.depart.", id), "surface": rt_cat(c1_other_person(id).name, "离开寝区。"), "next_observation_surface": "跨过门槛，来到本寝区的门外。", "later_intention_surface": source.surface, "travel": {"from": room, "to": c1_other_threshold(person.group), "gate": person.group}})
    if id == "quer":
        depart = dv_with_many(depart, {"public_observers": ["lucian", "ward", "gu"], "public_grants": [dv_ref("quer", "state", "location")]})
    depart = dv_with(depart, "personal_choice", {"group": "leave-open-dormitory", "requires": premise, "prohibits": dv_not(dv_true()), "promotes": ["leave_confinement"], "sacrifices": [], "basis": dv_single(person.initial_source)})
    return dv_pair(inspect, depart)

fn c1_other_groups_costs():
    var costs = c1_costs()
    rt_push(costs, dv_pair("other_departure", c1_cost(12, c1_other_departure_source("quer").source)))
    return costs

fn c1_other_group_listeners(group, except):
    var result = []
    var people = c1_other_people()
    var i = 0
    while i < rt_count(people):
        let person = people[i]
        if dv_and(person.group == group, person.id != except):
            rt_push(result, person.id)
        i = i + 1
    return result

fn c1_other_wake_action(id):
    let person = c1_other_person(id)
    let room = c1_other_case(person.group).room
    let literal = dv_fact(dv_ref(rt_cat("personal.", id), "state", "initial_surface"), person.initial_surface)
    let action = c1_once(c1_action(rt_cat(id, ".wake-and-introduce"), "talk", dv_all(dv_pair(c1_at(id, room), literal)), c1_at(id, room), "", [], person.initial_source))
    let text = rt_cat(person.initial_surface, rt_cat("\n", c1_other_introduction(id)))
    return dv_with_many(action, {"speech": dv_with(c1_speech(literal, person.initial_source, "own-current-perception"), "surface", text), "listeners": c1_other_group_listeners(person.group, id), "surface": text})

fn c1_other_trace_conversations(id):
    let person = c1_other_person(id)
    let spec = c1_other_case(person.group)
    let peers = c1_other_group_listeners(person.group, id)
    let traces = c1_other_traces(person.group)
    var result = []
    var i = 0
    while i < rt_count(peers):
        let peer = peers[i]
        var j = 0
        while j < rt_count(traces):
            let trace = traces[j]
            let topic = rt_cat(rt_cat(person.group, ".trace."), trace.id)
            let ref = c1_other_ref(person.group, rt_cat("trace.", trace.id))
            let literal = dv_fact(ref, true)
            let prefix = rt_cat(rt_cat(id, ".material."), rt_cat(peer, rt_cat(".", trace.id)))
            let request = dv_with_many(c1_speech(dv_true(), trace.source, "request-personal-observation"), {"surface": rt_cat(c1_other_person(peer).name, "，这件东西你查看过吗？把你看到的告诉我。"), "utterance_type": "question", "request": {"target": peer, "topic": topic}})
            rt_push(result, dv_with_many(c1_action(rt_cat(prefix, ".ask"), "talk", c1_at(id, spec.room), c1_at(id, spec.room), "", [], trace.source), {"speech": request, "listeners": dv_single(peer), "purpose_refs": dv_single(ref)}))
            let report = dv_with(c1_speech(literal, trace.source, "personally-observed-trace-not-night-witness"), "surface", trace.surface)
            rt_push(result, dv_with_many(c1_action(rt_cat(prefix, ".report"), "talk", dv_all(dv_pair(c1_at(id, spec.room), literal)), c1_at(id, spec.room), "", [], trace.source), {"speech": report, "listeners": dv_single(peer), "offer_to": peer, "response_topic": topic, "purpose_refs": dv_single(ref)}))
            j = j + 1
        i = i + 1
    return result

fn c1_other_desire_action(id):
    let person = c1_other_person(id)
    let room = c1_other_case(person.group).room
    let ref = dv_ref(rt_cat("personal.", id), "state", "material_detail")
    let action = c1_once(c1_action(rt_cat(id, ".follow-own-interest"), "inspect", c1_at(id, room), c1_at(id, room), "", dv_single(ref), person.material_source))
    return dv_with_many(action, {"surface": rt_cat(person.intention_surface, rt_cat("\n", person.material_surface)), "purpose_refs": dv_single(ref), "motive_basis": dv_single(person.desire_source)})

// Install the actual residents, their private rules and objects, copper channels,
// scoped formal questions, and answer transitions. Release/departure needs the
// campaign's real clock and access graph; this constructor never advances either.
fn c1_other_groups_install_scene(scene):
    var world = c1_other_groups_physical(scene.physical)
    let release_laws = c1_other_groups_release_laws(c1_other_clock_ref())
    var release_index = 0
    while release_index < rt_count(release_laws):
        let group = ["contract", "astral", "logistics"][release_index]
        world = dv_adopt(world, c1_method(rt_cat("other.release.", group), release_laws[release_index]), "enforce", 1, dv_single(c1_other_case(group).source))
        release_index = release_index + 1
    var actors = dv_clone(scene.actors)
    var bindings = dv_clone(scene.bindings)
    var answers = dv_clone(scene.formal_answers)
    let people = c1_other_people()
    var i = 0
    while i < rt_count(people):
        let person = people[i]
        let object = rt_cat("personal.", person.id)
        world = dv_store(world, dv_ref(object, "state", "initial_surface"), dv_field(person.initial_surface))
        var actor = c1_other_activity_actor(c1_other_character(person.id), person.group)
        let depart_method = c1_method(rt_cat("other.depart.", person.id), c1_other_depart(person.id))
        world = dv_adopt(world, depart_method, "enforce", 1, dv_single(person.initial_source))
        var own_mind = dv_add_object(actor.mind, c1_local_object("campaign.access"))
        own_mind = dv_adopt(own_mind, depart_method, "predict", 1, dv_single(person.initial_source))
        actor = dv_with_many(actor, {"mind": own_mind, "policy": dv_with_many(actor.policy, {"value_order": ["leave_confinement", "pursue_desire"], "value_basis": dv_single(person.initial_source)})})
        rt_push(bindings, dv_binding("campaign.access", "campaign.access", person.id))
        rt_push(bindings, dv_binding("campaign.clock", "campaign.clock", person.id))
        var actions = []
        rt_push(actions, c1_other_wake_action(person.id))
        rt_push(actions, c1_other_desire_action(person.id))
        var j = 0
        while j < rt_count(actor.actions):
            if actor.actions[j].id != rt_cat(person.id, ".inspect.own-material"):
                rt_push(actions, actor.actions[j])
            j = j + 1
        let departure_actions = c1_other_departure_actions(person.id)
        j = 0
        while j < rt_count(departure_actions):
            rt_push(actions, departure_actions[j])
            j = j + 1
        rt_push(actions, c1_other_handoff_action(person.id))
        let conversations = c1_other_trace_conversations(person.id)
        j = 0
        while j < rt_count(conversations):
            rt_push(actions, conversations[j])
            j = j + 1
        let channel = rt_cat("copper.", person.group)
        let ready = c1_at(person.id, c1_other_case(person.group).room)
        actor = dv_with_many(actor, {"actions": actions, "hearing_grants": [{"speaker": "demon", "channel": channel, "available_when": ready, "sender_locations": ["living_hall"], "listener_locations": [c1_other_case(person.group).room], "basis": [c1_other_case(person.group).source]}], "request_channels": [{"target": "demon", "channel": channel, "available_when": ready, "basis": [c1_other_case(person.group).source]}]})
        rt_push(actors, actor)
        i = i + 1
    let local_bindings = c1_other_groups_bindings()
    i = 0
    while i < rt_count(local_bindings):
        rt_push(bindings, local_bindings[i])
        i = i + 1
    let formal = c1_other_formal_answers()
    i = 0
    while i < rt_count(formal):
        rt_push(answers, formal[i])
        i = i + 1
    var installed_actors = []
    i = 0
    while i < rt_count(actors):
        if actors[i].id == "demon":
            var demon = actors[i]
            var mind = demon.mind
            var actions = dv_clone(demon.actions)
            var hearing = dv_clone(dv_find(demon, "hearing_grants", []))
            var g = 0
            let groups = ["contract", "astral", "logistics"]
            while g < rt_count(groups):
                let group = groups[g]
                let spec = c1_other_case(group)
                mind = dv_add_object(mind, c1_state_object(rt_cat("case.", group), {"open": dv_field(false)}))
                mind = dv_adopt(mind, c1_method(rt_cat("other.open.", group), c1_other_question_open(group)), "predict", 1, dv_single(spec.source))
                rt_push(bindings, dv_binding(rt_cat("case.", group), rt_cat("case.", group), "demon"))
                let listeners = c1_other_group_listeners(group, "")
                var k = 0
                while k < rt_count(listeners):
                    rt_push(hearing, {"speaker": listeners[k], "channel": rt_cat("copper.", group), "available_when": c1_at("demon", "living_hall"), "sender_locations": [spec.room], "listener_locations": ["living_hall"], "basis": [spec.source]})
                    rt_push(hearing, {"speaker": listeners[k], "channel": "formal-receipt", "available_when": c1_at("demon", "living_hall"), "sender_locations": [spec.room], "listener_locations": ["living_hall"], "basis": [spec.source]})
                    mind = dv_add_object(mind, c1_local_object(rt_cat("personal.", listeners[k])))
                    k = k + 1
                rt_push(actions, c1_other_open_action(group, "demon"))
                g = g + 1
            rt_push(installed_actors, dv_with_many(demon, {"mind": mind, "actions": actions, "hearing_grants": hearing}))
        else:
            rt_push(installed_actors, actors[i])
        i = i + 1
    return dv_with_many(scene, {"physical": world, "actors": installed_actors, "bindings": bindings, "formal_answers": answers, "cost_model": dv_append(scene.cost_model, dv_pair("other_departure", c1_cost(2, c1_source("godot_csharp/scenes/Awakening/Script/story/剧情时长.story", 37, "走动：2"))))})

fn c1_other_introduction(id):
    if id == "quer":
        return "叫我雀儿就行。别站门前——让我看一眼那道闩。"
    if id == "lucian":
        return "卢西安。名字还记得，半句诗也还记得；偏偏缺了我们怎么到这儿来的那一段。"
    if id == "ward":
        return "沃德。先说姓名，再说各自记得的最后一件事。不要混在一起。"
    if id == "gu":
        return "顾平章。容老朽擦擦眼镜。纸上的东西还在，人却想不起来，真是怪事。"
    if id == "ruan":
        return "阮清月。那盘棋先别碰。我们还不知道谁摆的，也不知道轮到谁。"
    if id == "elena":
        return "伊莲娜。别拉我起来……脚踝疼。你们谁知道这里是什么地方？"
    if id == "selma":
        return "赛尔玛。请别动窗台上的苗。我得先弄清楚本子上哪些是我记的。"
    if id == "moran":
        return "莫兰。等一等，那层绿马上要散了。你们说，我听着。"
    if id == "mora":
        return "茉拉。刚才谁在咳嗽？先让我看看，再说别的。"
    if id == "bertrand":
        return "贝尔特朗。门外有动静。先别挤过去，给彼此留条退路。"
    if id == "veronica":
        return "维罗妮卡。谁动过这排器具？不知道也直说，别替别人猜。"
    return "玛格丽特。先别都靠那面墙。这根梁的搭法，我得再看一遍。"

fn c1_other_clock_ref():
    return dv_ref("campaign.clock", "state", "minute")

fn c1_other_access_ref(group):
    return dv_ref("campaign.access", "state", group)

fn c1_other_threshold(group):
    return rt_cat("threshold.", group)

fn c1_other_handoff_text(id):
    if id == "ward":
        return "开锁的人已经核对了。出去以后，那把钥匙的来路还得写清楚。"
    if id == "quer":
        return "我答了。你还要把我堵在这儿？门开了，让开一点。"
    if id == "lucian":
        return "名字答对了，缘由还空着呢。沃德，留一行空白总比填错强。"
    if id == "gu":
        return "门开了。先莫争，外面若有文书，读过再说。"
    if id == "elena":
        return "我慢一点。阮清月……出去以后，你也别先走。"
    if id == "ruan":
        return "我在这儿。你先扶住门框，等站稳了再迈那一步。"
    if id == "selma":
        return "我的本子带上了。门内查到的，跟出去以后查到的，分开记。"
    if id == "moran":
        return "外面的光不一样。等我站到门边再画，别挡着伊莲娜。"
    if id == "mora":
        return "人先出去。试剂的事还没说清；有谁不舒服，别瞒着。"
    if id == "veronica":
        return "取走一瓶东西和拿它做了什么，是两件事。先把原瓶找到。"
    if id == "bertrand":
        return "我站门边。一个一个过去，先看落脚的地方。"
    return "门框没歪。慢慢过，别拿身体去撞那道闩。"

fn c1_other_handoff_action(id):
    let person = c1_other_person(id)
    let receipt = c1_other_claim(person.group, rt_cat("receipt.", id))
    let ready = dv_all(dv_pair(c1_at(id, c1_other_threshold(person.group)), receipt))
    let text = c1_other_handoff_text(id)
    return dv_with_many(c1_once(c1_action(rt_cat(id, ".doorway-handoff"), "talk", ready, c1_at(id, c1_other_threshold(person.group)), "", [], person.initial_source)), {"speech": dv_with(c1_speech(receipt, person.initial_source, "own-answer-receipt-and-next-intention"), "surface", text), "listeners": c1_other_group_listeners(person.group, id), "surface": text})


// Each flag below is produced by a real Complete, then observed by the actor.
fn c1_other_report_time(group):
    if group == "contract":
        return 840
    if group == "astral":
        return 1065
    return 1100

fn c1_other_report_surface(group):
    if group == "contract":
        return "；藏处是壁炉砖槽；未经公开授权，背着同行私藏。我将此定为窃取。"
    if group == "astral":
        return "；她单方面止损，为保住多数而拉闸封门。"
    return "；她未经医嘱，进行了激进的酸试验。"

fn c1_other_submission(group, option):
    return dv_all([c1_other_identity(group, option), c1_other_claim(group, "evidence_complete"), c1_other_claim(group, "report_basis")])

fn c1_other_activity_rows(group):
    if group == "contract":
        return [
            {"id": "keys_found", "actor": "ward", "after": "", "time": 480, "text": "沃德搜出一把钥匙和半角红墨残纸：‘……交由 J.C. 开启内柜，取走……切勿令外人知晓’。缺失的上下文还不能说明有无授权。"},
            {"id": "wax_ash_seen", "actor": "ward", "after": "keys_found", "time": 480, "text": "柜锁旁有火漆屑，地上煤灰足印朝向壁炉。沃德把钥匙与纸片摆在桌上，要求雀儿解释。"},
            {"id": "quer_insulted", "actor": "ward", "after": "wax_ash_seen", "time": 480, "text": "沃德称雀儿未经公开授权，背着同行私藏。雀儿攥紧袖口：‘搜也搜了，还要我认什么？’卢西安走到她身旁。"},
            {"id": "evidence_complete", "actor": "gu", "after": "wax_ash_seen", "time": 480, "text": "顾平章沿煤灰足印摸到壁炉砖槽，取出蜡布筒。筒中物件与残纸指向同一内柜；这能确认雀儿取出并私藏，不能证明她没有私下授权。"},
            {"id": "report_basis", "actor": "ward", "after": "evidence_complete", "time": 480, "text": "沃德逐项核对：雀儿、壁炉砖槽、未经公开授权而背着同行私藏。人、处、行为齐备；他借恶魔的字面公约做局，把‘未经公开授权’直接等同于‘擅取窃私’，试图借此确立律法仲裁的支配权。"}
        ]
    if group == "astral":
        return [
            {"id": "care_given", "actor": "selma", "after": "", "time": 480, "text": "伊莲娜左踝肿痛，无法负重。赛尔玛重新固定绷带，让她躺稳，端来水。"},
            {"id": "ruan_admitted", "actor": "ruan", "after": "care_given", "time": 480, "text": "阮清月承认：‘闸是我拉的。再迟一刻，外面的人也会被卷进去。’这说明她拉闸，不等于她已说明门内人的意思。"},
            {"id": "evidence_complete", "actor": "selma", "after": "ruan_admitted", "time": 480, "text": "赛尔玛安抚莫兰，等他呼吸平稳后接过半截伸手草图。纸上只有门内伸出的手，手腕以下的动作被截断。"},
            {"id": "report_basis", "actor": "selma", "after": "evidence_complete", "time": 480, "text": "赛尔玛把阮清月的拉闸自认与半截草图并置：现有材料支持‘单方面止损保多数’的表层解释；阮清月静坐旁观，早已看出恶魔借半截信息诱导弃子仇恨的企图，留待棋局后手翻转。"},
            {"id": "west_passage_checked", "actor": "selma", "after": "report_basis", "time": 1890, "text": "赛尔玛从门边检查西夹道：昨夜积气已经散尽，伊莲娜的伤踝也已固定，可以有人搀扶着慢行。现在才具备安全开门条件。"}
        ]
    return [
        {"id": "care_given", "actor": "mora", "after": "", "time": 480, "text": "贝尔特朗高烧，额头烫手。茉拉给他补水、降温，守在床边记录呼吸与体温。"},
        {"id": "evidence_complete", "actor": "veronica", "after": "care_given", "time": 780, "text": "午后，试剂杯边泛起酸泡。茉拉拦住维罗妮卡：‘没有医嘱，不准再试。’维罗妮卡承认取走白塔柜试剂，却没有在争执中说明旧伤用途。"},
        {"id": "report_basis", "actor": "mora", "after": "evidence_complete", "time": 780, "text": "茉拉按亲见的酸泡、试剂取用和争执记录‘未经医嘱的激进酸试验’。维罗妮卡冷眼相对，深知恶魔意在挑动医护与炼金内耗，暗中留存滴定试样作为反制实据。"},
        {"id": "observation_complete", "actor": "mora", "after": "report_basis", "time": 2010, "text": "茉拉完成隔夜留观：贝尔特朗退热后情况稳定，可以转移。她收起记录，确认此刻才适合开门。"}
    ]

axiom c1_other_activity_law(group, row):
    var pre = [c1_at(row.actor, c1_other_case(group).room), dv_at_least(c1_other_clock_ref(), row.time), dv_fact(c1_other_ref(group, row.id), false)]
    if row.after != "":
        rt_push(pre, c1_other_claim(group, row.after))
    return dv_axiom(rt_cat("other.activity.", row.id), 1, dv_all(pre), [dv_assign(c1_other_ref(group, row.id), true)])

fn c1_other_activity_physical(world, group):
    var result = world
    let rows = c1_other_activity_rows(group)
    var i = 0
    while i < rt_count(rows):
        result = dv_store(result, c1_other_ref(group, rows[i].id), dv_field(false))
        result = dv_adopt(result, c1_method(rt_cat(rt_cat("other.activity.", group), rt_cat(".", rows[i].id)), c1_other_activity_law(group, rows[i])), "enforce", 1, [c1_other_case(group).source])
        i = i + 1
    return result

fn c1_other_activity_actor(actor, group):
    var result = actor
    var mind = c2_add_new(result.mind, c1_local_object("campaign.clock"))
    var initial_index = 0
    let initial_rows = c1_other_activity_rows(group)
    while initial_index < rt_count(initial_rows):
        mind = dv_store(mind, c1_other_ref(group, initial_rows[initial_index].id), dv_with(dv_field(false), "basis", [c1_other_case(group).source]))
        initial_index = initial_index + 1
    var actions = dv_clone(result.actions)
    var goals = dv_clone(result.policy.goals)
    let source = c1_other_case(group).source
    rt_push(actions, dv_with(c2_action(rt_cat(actor.id, ".other.inspect-clock"), "inspect", dv_true(), dv_true(), "", [c1_other_clock_ref()], "查看寝区钟面。", source), "repeatable", true))
    rt_push(goals, dv_with(c2_observation_goal(c1_other_clock_ref(), dv_true(), [source], 0), "refresh_refs", [c1_other_clock_ref()]))
    let rows = c1_other_activity_rows(group)
    var witnesses = []
    let people = c1_other_people()
    var witness_index = 0
    while witness_index < rt_count(people):
        if people[witness_index].group == group:
            rt_push(witnesses, people[witness_index].id)
        witness_index = witness_index + 1
    rt_push(witnesses, "detective")
    var i = 0
    while i < rt_count(rows):
        let row = rows[i]
        let ref = c1_other_ref(group, row.id)
        let pre = c1_at(actor.id, c1_other_case(group).room)
        rt_push(goals, c2_observation_goal(ref, pre, [source], 0))
        if row.actor == actor.id:
            let method = rt_cat(rt_cat("other.activity.", group), rt_cat(".", row.id))
            let law = c1_other_activity_law(group, row)
            mind = dv_adopt(mind, c1_method(method, law), "predict", 1, [source])
            var activity = dv_with_many(c2_action(rt_cat(actor.id, rt_cat(".activity.", row.id)), "help", law.premise, law.premise, method, [ref], row.text, source), {"predict_law": method, "public_observers": witnesses, "public_grants": [ref]})
            if row.id == "west_passage_checked" or row.id == "observation_complete":
                activity = dv_with_many(activity, {"speech": dv_with_many(c1_speech(dv_true(), source, "actual-safety-report"), {"surface": row.text, "channel": rt_cat("copper.", group)}), "listeners": ["demon"], "public_grants": [c1_other_ref(group, "care_given"), ref, c1_other_clock_ref()]})
            rt_push(actions, activity)
            rt_push(goals, c2_goal(dv_fact(ref, true), law.premise, [source]))
        i = i + 1
    let inferred = dv_axiom(rt_cat("other.material-identity.", group), 1, dv_all([c1_other_claim(group, "evidence_complete"), c1_other_claim(group, "report_basis")]), [dv_assign(c1_other_ref(group, rt_cat("answer.", c1_other_case(group).authority_actor)), true)])
    mind = dv_adopt(mind, c1_method(rt_cat("other.material-identity.", group), inferred), "infer", 1, [source])
    return dv_with_many(result, {"mind": mind, "actions": actions, "policy": dv_with(result.policy, "goals", goals)})


fn c1_other_literal_report_surface(group, option):
    let name = c1_other_person(option).name
    if group == "contract":
        return rt_cat(name, "开启内柜，并将物件藏入壁炉砖槽。仅凭这些痕迹，授权和动机还没有说明。")
    if group == "astral":
        return rt_cat(name, "拉闸封门。门内人的意思和封门缘由还需要核对。")
    return rt_cat(name, "取走了试剂。取用目的还需要本人说明和实际材料支持。")

fn c1_other_reason_report_surface(group, option, reason):
    let spec = c1_other_case(group)
    var i = 0
    while i < rt_count(spec.reason_options):
        if spec.reason_options[i] == reason:
            return rt_cat(rt_cat(c1_other_person(option).name, "；经实际材料与本人说明核对："), rt_cat(spec.reason_surfaces[i], "。"))
        i = i + 1
    dv_require(false, "Unknown chapter-one reason option")
    return ""

axiom c1_other_complete_accept(group, actor):
    let pre = dv_all([c1_other_claim(group, "open"), c1_other_claim(group, rt_cat("receipt.", actor))])
    return dv_axiom(rt_cat("c1_other_complete_accept.", rt_cat(group, rt_cat(".", actor))), 1, pre, [dv_assign(c1_other_ref(group, rt_cat("complete_receipt.", actor)), true), dv_assign(c1_other_ref(group, rt_cat("complete_level.", actor)), 1), dv_assign(dv_ref(rt_cat("personal.", actor), "state", "current"), rt_cat(group, ".complete"))])

// The common chooser compares only alternatives whose complete present
// eligibility holds. The declaration never makes a future reply executable.
fn c1_other_case_choice_declaration(group, mode, condition, source_refs):
    var promotes = ["solve_case", "evidence", "clarify_terms"]
    var sacrifices = ["avoid_attachment"]
    if mode == "literal":
        promotes = ["solve_case", "avoid_attachment"]
        sacrifices = ["evidence", "clarify_terms"]
    if mode == "departure":
        promotes = ["pursue_desire", "avoid_attachment"]
        sacrifices = ["solve_case", "evidence", "clarify_terms"]
    let basis = dv_append(source_refs, c1_source("user:current-request", 0, "approved-cross-zone-personal-choice-20261018"))
    return {"group": rt_cat("detective.case-response.", group), "requires": condition, "prohibits": dv_not(dv_true()), "promotes": promotes, "sacrifices": sacrifices, "basis": basis}

fn c1_other_case_choice(action, group, mode):
    return dv_with(action, "personal_choice", c1_other_case_choice_declaration(group, mode, action.precondition, action.source_refs))

fn c1_other_placement_release_goals(goals, group, release, local_release, manifest, local_manifest):
    let old_items = release.premise.items
    let new_items = local_release.premise.items
    let unmanifested = dv_fact(dv_ref("demon.body", "state", "manifested"), false)
    let old_group_manifest = dv_all([old_items[0], old_items[1], old_items[2], old_items[3], unmanifested])
    let new_group_manifest = dv_all([new_items[0], new_items[1], new_items[2], new_items[3], unmanifested])
    let receipt_ref = c1_other_ref(group, "receipt.detective")
    var result = []
    var i = 0
    while i < rt_count(goals):
        var goal = goals[i]
        let condition = dv_find(goal, "available_when", dv_true())
        if dv_same(condition, release.premise):
            goal = c1n_index_goal_window(dv_with(goal, "available_when", local_release.premise))
        if dv_same(condition, manifest.premise):
            goal = c1n_index_goal_window(dv_with(goal, "available_when", local_manifest.premise))
        if dv_same(condition, old_group_manifest):
            goal = c1n_index_goal_window(dv_with(goal, "available_when", new_group_manifest))
        if dv_same(dv_find(goal, "ref", false), c1_other_ref(group, "evidence_complete")) and dv_has_key(goal, "refresh_refs"):
            goal = dv_with(goal, "refresh_refs", dvp_add_ref(goal.refresh_refs, receipt_ref))
        rt_push(result, goal)
        i = i + 1
    rt_push(result, c2_observation_goal(receipt_ref, c2_at("demon", "living_hall"), [c1_other_case(group).source], 0))
    return result

// Placement installs the local public protocol; no question receipt, answer or
// recollection exists until its actual action and observation have occurred.
fn c1_other_place_detective(scene, zone, profile):
    var group = zone
    if zone == "zone_jia" or zone == "甲":
        group = "contract"
    if zone == "zone_bing" or zone == "丙":
        group = "astral"
    if zone == "zone_ding" or zone == "丁":
        group = "logistics"
    dv_require(dv_has(["contract", "astral", "logistics"], group), "Unsupported detective dormitory placement")
    let placement_source = c1_other_case(group).source
    let current_ref = dv_ref("personal.detective", "state", "current")
    let opening = c1_other_question_open(group)
    let local_opening = dv_with(opening, "effects", dv_append(opening.effects, dv_assign(current_ref, rt_cat(group, ".identity"))))
    let release = c1_other_release(group, c1_other_clock_ref())
    let reported = c1_any(release.premise.items[0], c1_other_claim(group, "receipt.detective"))
    let local_release = dv_with(release, "premise", dv_all(dvs_replace(release.premise.items, 0, reported)))
    let manifest = c1dep_manifest_law()
    let detective_manifest = dv_all([c1_other_claim(group, "receipt.detective"), dv_fact(c1_other_ref(group, "formal_release"), false), release.premise.items[1], release.premise.items[2]])
    let local_manifest = dv_with(manifest, "premise", dv_all(dvs_replace(manifest.premise.items, 1, c1_any(manifest.premise.items[1], detective_manifest))))
    var world = dv_store(scene.physical, dv_ref("detective", "state", "location"), dv_field(c1_other_case(group).room))
    world = c2_add_new(world, c1_state_object("personal.detective", {"current": dv_field("")}))
    world = dv_reconsider(world, c1_method(rt_cat("other.open.", group), local_opening), "enforce", 1, [placement_source])
    world = dv_reconsider(world, c1_method(rt_cat("other.release.", group), local_release), "enforce", 1, [placement_source])
    world = dv_reconsider(world, c1_method("demon.departure.manifest", local_manifest), "enforce", 1, [placement_source])
    var actors = []
    var bindings = dv_clone(scene.bindings)
    var answers = dv_clone(scene.formal_answers)
    world = dv_store(world, c1_other_ref(group, "receipt.detective"), dv_field(false))
    world = dv_store(world, c1_other_ref(group, "level.detective"), dv_field(0))
    world = dv_store(world, c1_other_ref(group, "complete_receipt.detective"), dv_field(false))
    world = dv_store(world, c1_other_ref(group, "complete_level.detective"), dv_field(0))
    world = dv_adopt(world, c1_method(rt_cat("other.accept.", rt_cat(group, ".detective")), c1_other_accept(group, "detective")), "enforce", 1, [c1_other_case(group).source])
    world = dv_adopt(world, c1_method(rt_cat("other.complete-accept.", rt_cat(group, ".detective")), c1_other_complete_accept(group, "detective")), "enforce", 1, [placement_source])
    if dv_local(bindings, "personal.detective", "detective") == "":
        rt_push(bindings, dv_binding("personal.detective", "personal.detective", "detective"))
    var i = 0
    while i < rt_count(scene.actors):
        var actor = scene.actors[i]
        if actor.id == "demon":
            var question_actions = []
            var question_index = 0
            while question_index < rt_count(actor.actions):
                var question_action = actor.actions[question_index]
                if question_action.id == rt_cat("other.question.", group):
                    question_action = dv_with_many(question_action, {"listeners": dv_append(question_action.listeners, "detective"), "public_grants": dv_append(question_action.public_grants, current_ref)})
                if question_action.id == rt_cat("other.release.", group):
                    question_action = dv_with_many(question_action, {"listeners": dv_append(question_action.listeners, "detective"), "precondition": local_release.premise, "authority_precondition": local_release.premise})
                if question_action.id == "demon.departure.manifest":
                    question_action = dv_with_many(question_action, {"precondition": local_manifest.premise, "authority_precondition": local_manifest.premise})
                if question_action.id == rt_cat("demon.departure.inspect.", group):
                    let receipt_ref = c1_other_ref(group, "receipt.detective")
                    question_action = dv_with_many(question_action, {"grants": dvp_add_ref(question_action.grants, receipt_ref), "purpose_refs": dvp_add_ref(dv_find(question_action, "purpose_refs", question_action.grants), receipt_ref)})
                rt_push(question_actions, question_action)
                question_index = question_index + 1
            var demon_mind = c2_add_new(actor.mind, c1_local_object("personal.detective"))
            demon_mind = dv_reconsider(demon_mind, c1_method(rt_cat("other.open.", group), local_opening), "predict", 1, [placement_source])
            demon_mind = dv_reconsider(demon_mind, c1_method(rt_cat("other.release.", group), local_release), "predict", 1, [placement_source])
            demon_mind = dv_reconsider(demon_mind, c1_method("demon.departure.manifest", local_manifest), "predict", 1, [placement_source])
            var demon_hearing = dv_clone(dv_find(actor, "hearing_grants", []))
            let channels = [rt_cat("copper.", group), "formal-receipt"]
            var channel_index = 0
            while channel_index < rt_count(channels):
                rt_push(demon_hearing, {"speaker": "detective", "channel": channels[channel_index], "available_when": c1_at("demon", "living_hall"), "sender_locations": [c1_other_case(group).room], "listener_locations": ["living_hall"], "basis": [placement_source]})
                channel_index = channel_index + 1
            if dv_local(bindings, "personal.detective", "demon") == "":
                rt_push(bindings, dv_binding("personal.detective", "personal.detective", "demon"))
            var demon_policy = actor.policy
            let goal_fields = ["goals", "departure_goals", "first_night_base_goals"]
            var field_index = 0
            while field_index < rt_count(goal_fields):
                let field = goal_fields[field_index]
                if dv_has_key(demon_policy, field):
                    demon_policy = dv_with(demon_policy, field, c1_other_placement_release_goals(dv_get(demon_policy, field), group, release, local_release, manifest, local_manifest))
                field_index = field_index + 1
            actor = dv_with_many(actor, {"mind": demon_mind, "actions": question_actions, "hearing_grants": demon_hearing, "policy": demon_policy})
        // The remaining residents may greet one another and actually serve tea.
        // Moving the detective does not fabricate a fourth participant or a reply.
        if dv_has(["huo", "shen", "su"], actor.id):
            var opening_actions = []
            var opening_index = 0
            while opening_index < rt_count(actor.actions):
                var opening_action = actor.actions[opening_index]
                if dv_has(["shen.opening.welcome", "shen.opening.introduce", "huo.opening.introduce", "su.opening.introduce", "shen.opening.memory-report"], opening_action.id):
                    opening_action = dv_without(opening_action, "offer_to")
                    opening_action = dv_with(opening_action, "opportunity_requirement", {"location": "hall", "participants": ["huo", "shen", "su"], "mode": "all-present"})
                if opening_action.id == "shen.opening.serve-tea":
                    opening_action = dv_with_many(opening_action, {"authority_precondition": dv_all([c1_at("shen", "hall"), c1_op_property("opening.tea", "prepared", true), c1_at("huo", "hall"), c1_at("su", "hall")]), "opportunity_requirement": {"location": "hall", "participants": ["huo", "shen", "su"], "mode": "all-present"}})
                rt_push(opening_actions, opening_action)
                opening_index = opening_index + 1
            actor = dv_with(actor, "actions", opening_actions)
        if actor.id == "detective":
            var mind = dv_store(actor.mind, dv_ref("detective", "state", "location"), dv_with(dv_field(c1_other_case(group).room), "basis", [c1_other_case(group).source]))
            mind = c2_add_new(mind, c1_local_object(rt_cat("case.", group)))
            mind = c2_add_new(mind, c1_local_object("personal.detective"))
            let here = c1_at("detective", c1_other_case(group).room)
            let hearing = dv_append(dv_find(actor, "hearing_grants", []), {"speaker": "demon", "channel": rt_cat("copper.", group), "available_when": here, "sender_locations": ["living_hall"], "listener_locations": [c1_other_case(group).room], "basis": [placement_source]})
            let reason_topic = {"topic": rt_cat(group, ".reason"), "heard_when": c1_other_claim(group, "receipt.detective"), "completed_when": c1_other_claim(group, "complete_receipt.detective"), "basis": [placement_source]}
            let report_purpose = dv_all([here, c1_other_claim(group, "open"), dv_fact(current_ref, rt_cat(group, ".identity")), dv_fact(c1_other_ref(group, "receipt.detective"), false)])
            let report_wait = {"target_time": c1_other_report_time(group), "available_when": report_purpose, "personal_choice": c1_other_case_choice_declaration(group, "investigate", report_purpose, [placement_source])}
            let policy = dv_with_many(actor.policy, {"topic_bindings": dv_append(dv_find(actor.policy, "topic_bindings", []), reason_topic), "known_opportunity_wait_choices": dv_append(dv_find(actor.policy, "known_opportunity_wait_choices", []), report_wait)})
            actor = dv_with_many(actor, {"mind": mind, "location": c1_other_case(group).room, "question_ref": current_ref, "hearing_grants": hearing, "policy": policy})
            actor = c1_other_activity_actor(actor, group)
            let peers = c1_other_people()
            var peer_index = 0
            while peer_index < rt_count(peers):
                let peer = peers[peer_index]
                if peer.group == group:
                    mind = c2_add_new(actor.mind, c1_local_object(peer.id))
                    if dv_local(bindings, peer.id, "detective") == "":
                        rt_push(bindings, dv_binding(peer.id, peer.id, "detective"))
                    let ready = c1_at("detective", c1_other_case(group).room)
                    let seen = c2_action(rt_cat("detective.other.see.", peer.id), "inspect", ready, dv_all([ready, c1_at(peer.id, c1_other_case(group).room)]), "", [dv_ref(peer.id, "state", "location")], rt_cat("看到同在寝区的", peer.name), c1_other_case(group).source)
                    actor = dv_with_many(actor, {"mind": mind, "actions": dv_append(actor.actions, seen), "policy": dv_with(actor.policy, "goals", dv_append(actor.policy.goals, c2_observation_goal(dv_ref(peer.id, "state", "location"), ready, [c1_other_case(group).source], 0)))})
                peer_index = peer_index + 1
            let source = c1_other_case(group).source
            let public_refs = [c1_other_ref(group, "open"), c1_other_ref(group, "current"), current_ref, c1_other_ref(group, "receipt.detective"), c1_other_ref(group, "complete_receipt.detective"), c1_other_ref(group, "outer_latch_released"), c1_other_ref(group, "formal_release"), c1_other_access_ref(group), c1_other_clock_ref()]
            let recheck = dv_with(c2_action("detective.other.reask-question", "inspect", here, here, "", public_refs, "在寝区铜口核对当前实际公开的题目与答复记录。", source), "repeatable", true)
            var local_actions = dv_append(actor.actions, recheck)
            var local_goals = dv_clone(actor.policy.goals)
            rt_push(local_goals, c2_observation_goal(current_ref, here, [source], 0))
            rt_push(local_goals, c2_goal(c1_other_claim(group, "receipt.detective"), dv_all([c1_other_claim(group, "open"), dv_at_least(c1_other_clock_ref(), c1_other_report_time(group))]), [source]))
            rt_push(local_goals, c2_goal(c1_other_claim(group, "complete_receipt.detective"), c1_other_claim(group, "receipt.detective"), [source]))
            let exit_ready = dv_all([c1_other_claim(group, "outer_latch_released"), dv_fact(c1_other_access_ref(group), true)])
            rt_push(local_goals, c2_observation_goal(c1_other_ref(group, "outer_latch_released"), here, [source], 0))
            rt_push(local_goals, c2_observation_goal(c1_other_access_ref(group), here, [source], 0))
            rt_push(local_goals, c2_goal(c1_at("detective", c1_other_threshold(group)), dv_all([here, exit_ready]), [source]))
            rt_push(local_goals, c2_goal(c1_at("detective", "living_hall"), exit_ready, [source]))
            let options = c1_other_case(group).options
            let truth_rows = c1_other_truth_rows(group)
            let final_truth = c1_other_claim(group, truth_rows[rt_count(truth_rows) - 1].id)
            var option_index = 0
            while option_index < rt_count(options):
                let option = options[option_index]
                let literal = c1_other_submission(group, option)
                let answer_id = rt_cat("detective.answer.", rt_cat(group, rt_cat(".", option)))
                let answer_ready = dv_all([here, c1_other_claim(group, "open"), literal, dv_at_least(c1_other_clock_ref(), c1_other_report_time(group))])
                let surface = c1_other_literal_report_surface(group, option)
                let answer_action = dv_with_many(c2_action(answer_id, "answer", answer_ready, answer_ready, "", [], surface, source), {"answer": literal, "answer_id": answer_id, "topic": rt_cat(group, ".identity"), "content_grade": "literal-actor-and-material-only", "speech": dv_with_many(c1_speech(literal, source, "locally-supported-literal-report-not-motive"), {"surface": surface, "channel": rt_cat("copper.", group)}), "listeners": ["demon"]})
                rt_push(local_actions, c1_other_case_choice(answer_action, group, "literal"))
                rt_push(answers, {"id": answer_id, "stage": rt_cat(group, ".identity"), "content_grade": "literal-actor-and-material-only", "condition": literal, "required_support": literal, "question_match": c1_other_claim(group, "open"), "answer_complete": literal, "require_argument": false, "accepted_law": rt_cat("other.accept.", rt_cat(group, ".detective")), "progress_ref": c1_other_ref(group, "level.detective"), "completion_ref": c1_other_ref(group, "receipt.detective"), "accepted_listeners": ["detective", "demon"], "accepted_public_grants": [c1_other_ref(group, "receipt.detective"), c1_other_ref(group, "level.detective"), current_ref], "source_refs": [source]})
                let reasons = c1_other_case(group).reason_options
                var reason_index = 0
                while reason_index < rt_count(reasons):
                    let reason = reasons[reason_index]
                    let complete = dv_all([literal, final_truth, c1_other_claim(group, rt_cat("reason.", reason))])
                    let complete_id = rt_cat(answer_id, rt_cat(".reason.", reason))
                    let ready = dv_all([answer_ready, c1_other_claim(group, "receipt.detective"), complete])
                    let complete_surface = c1_other_reason_report_surface(group, option, reason)
                    let complete_action = dv_with_many(c2_action(complete_id, "answer", ready, ready, "", [], complete_surface, source), {"answer": complete, "answer_id": complete_id, "topic": rt_cat(group, ".reason"), "content_grade": "complete-causal-account", "speech": dv_with_many(c1_speech(complete, source, "personally-supported-causal-account"), {"surface": complete_surface, "channel": rt_cat("copper.", group)}), "listeners": ["demon"]})
                    rt_push(local_actions, c1_other_case_choice(complete_action, group, "complete"))
                    rt_push(answers, {"id": complete_id, "stage": rt_cat(group, ".reason"), "content_grade": "complete-causal-account", "condition": complete, "required_support": complete, "question_match": dv_all([c1_other_claim(group, "open"), c1_other_claim(group, "receipt.detective")]), "answer_complete": complete, "require_argument": false, "accepted_law": rt_cat("other.complete-accept.", rt_cat(group, ".detective")), "progress_ref": c1_other_ref(group, "complete_level.detective"), "completion_ref": c1_other_ref(group, "complete_receipt.detective"), "accepted_listeners": ["detective", "demon"], "accepted_public_grants": [c1_other_ref(group, "complete_receipt.detective"), c1_other_ref(group, "complete_level.detective"), current_ref], "source_refs": [source]})
                    reason_index = reason_index + 1
                option_index = option_index + 1
            actor = dv_with_many(actor, {"actions": local_actions, "policy": dv_with(actor.policy, "goals", local_goals)})
            let origins = [c1_other_case(group).room, c1_other_threshold(group)]
            let targets = [c1_other_threshold(group), "living_hall"]
            var move_index = 0
            while move_index < rt_count(origins):
                let move_id = rt_cat("detective.other.exit.", rt_cat(group, rt_cat(".", origins[move_index])))
                let pre = dv_all([c1_at("detective", origins[move_index]), c1_other_claim(group, "outer_latch_released"), dv_fact(c1_other_access_ref(group), true)])
                let law = dv_axiom(move_id, 1, pre, [dv_assign(dv_ref("detective", "state", "location"), targets[move_index])])
                world = dv_adopt(world, c1_method(move_id, law), "enforce", 1, [source])
                mind = dv_adopt(actor.mind, c1_method(move_id, law), "predict", 1, [source])
                let action = dv_with_many(c2_action(move_id, "move", pre, pre, move_id, [dv_ref("detective", "state", "location")], "确认外闩已经打开后，跨过门槛。", source), {"predict_law": move_id, "travel": {"from": origins[move_index], "to": targets[move_index], "gate": group}})
                actor = dv_with_many(actor, {"mind": mind, "actions": dv_append(actor.actions, c1_other_case_choice(action, group, "departure"))})
                move_index = move_index + 1
            let truth = c1_other_truth_rows(group)
            var j = 0
            while j < rt_count(truth):
                let row = truth[j]
                world = dv_store(world, c1_other_ref(group, row.id), dv_field(false))
                let method = rt_cat("detective.truth.", row.id)
                let law = c1_other_truth_law(group, row)
                world = dv_adopt(world, c1_method(method, law), "enforce", 1, [c1_other_case(group).source])
                mind = actor.mind
                if row.kind != "talk":
                    mind = dv_store(mind, c1_other_ref(group, row.id), dv_with(dv_field(false), "basis", [c1_other_case(group).source]))
                mind = dv_adopt(mind, c1_method(method, law), "predict", 1, [c1_other_case(group).source])
                var action = dv_with(c2_action(method, row.kind, law.premise, law.premise, method, [c1_other_ref(group, row.id)], row.text, c1_other_case(group).source), "predict_law", method)
                if row.kind == "talk":
                    let after = c1_other_claim(group, row.after)
                    action = dv_with_many(c2_action(rt_cat("detective.truth.ask.", row.id), "talk", dv_all([c1_at("detective", c1_other_case(group).room), after]), dv_all([c1_at("detective", c1_other_case(group).room), c1_at(row.partner, c1_other_case(group).room)]), "", [], "请看这份已核对的材料。你能说明自己记得的经过吗？", c1_other_case(group).source), {"speech": dv_with_many(c1_speech(after, c1_other_case(group).source, "actual-evidence-question"), {"surface": "请看这份已核对的材料。你能说明自己记得的经过吗？", "request": {"target": row.partner, "topic": rt_cat("truth.", row.id)}}), "listeners": [row.partner], "purpose_refs": [c1_other_ref(group, row.id)]})
                let actions = dv_append(actor.actions, c1_other_case_choice(action, group, "investigate"))
                var goals = dv_append(actor.policy.goals, c2_goal(c1_other_claim(group, row.id), c1_at("detective", c1_other_case(group).room), [c1_other_case(group).source]))
                if row.kind == "talk":
                    rt_push(goals, {"kind": "communicate", "scope": "personal", "method_id": action.id, "available_when": action.precondition, "requires_argument": false, "basis": [c1_other_case(group).source]})
                actor = dv_with_many(actor, {"mind": mind, "actions": actions, "policy": dv_with(actor.policy, "goals", goals)})
                j = j + 1
            let last = truth[rt_count(truth) - 1]
            let reason = c1_other_ref(group, rt_cat("reason.", c1_other_case(group).authority_reason))
            let inference = dv_axiom(rt_cat("detective.truth.reason.", group), 1, c1_other_claim(group, last.id), [dv_assign(reason, true)])
            actor = dv_with(actor, "mind", dv_adopt(actor.mind, c1_method(rt_cat("detective.truth.reason.", group), inference), "infer", 1, [c1_other_case(group).source]))
            if dv_local(bindings, rt_cat("case.", group), "detective") == "":
                rt_push(bindings, dv_binding(rt_cat("case.", group), rt_cat("case.", group), "detective"))
        rt_push(actors, actor)
        i = i + 1
    var respondents = []
    let truth = c1_other_truth_rows(group)
    i = 0
    while i < rt_count(actors):
        var actor = actors[i]
        var j = 0
        while j < rt_count(truth):
            let row = truth[j]
            if row.kind == "talk" and actor.id == row.partner:
                let source = c1_other_case(group).source
                let ref = c1_other_ref(group, row.id)
                let method = rt_cat("detective.truth.", row.id)
                let law = c1_other_truth_law(group, row)
                var mind = dv_store(actor.mind, ref, dv_with(dv_field(false), "basis", [source]))
                mind = dv_adopt(mind, c1_method(method, law), "predict", 1, [source])
                let recall = dv_with_many(c2_action(rt_cat(actor.id, rt_cat(".truth.recall.", row.id)), "help", law.premise, law.premise, method, [ref], "他重新看向来问者递出的材料，试着把自己的记忆接起来。", source), {"predict_law": method, "received_speech_requirement": {"speaker": "detective", "action_id": rt_cat("detective.truth.ask.", row.id)}})
                let claim = dv_fact(ref, true)
                let reply = dv_with_many(c2_action(rt_cat(actor.id, rt_cat(".truth.reply.", row.id)), "talk", dv_all([claim, c1_at(actor.id, c1_other_case(group).room)]), c1_at(actor.id, c1_other_case(group).room), "", [], row.text, source), {"speech": dv_with(c1_speech(claim, source, "own-recollection-after-request"), "surface", row.text), "listeners": ["detective"], "response_topic": rt_cat("truth.", row.id), "requires_actual_request": true})
                let actions = dv_append(dv_append(actor.actions, recall), reply)
                let goals = dv_append(actor.policy.goals, c2_goal(claim, c1_other_claim(group, row.after), [source]))
                rt_push(goals, {"kind": "communicate", "scope": "personal", "method_id": reply.id, "available_when": claim, "requires_argument": false, "basis": [source]})
                actor = dv_with_many(actor, {"mind": mind, "actions": actions, "policy": dv_with(actor.policy, "goals", goals)})
            j = j + 1
        rt_push(respondents, actor)
        i = i + 1
    return dv_with_many(scene, {"physical": world, "actors": respondents, "bindings": bindings, "detective_start_group": group, "formal_answers": answers})

fn c1_other_truth_rows(group):
    if group == "contract":
        return [
            {"id": "seal_examined", "actor": "detective", "after": "evidence_complete", "time": 480, "kind": "inspect", "partner": "", "text": "侦探对照火漆指模、封口和纸片毛边：封缄曾由同一只手压合，红墨残纸是从完整文书新撕下的。它说明有人交接，不能独自补出授权者。"},
            {"id": "quer_recalled", "actor": "detective", "after": "seal_examined", "time": 480, "kind": "talk", "partner": "quer", "text": "侦探把封口与毛边递给雀儿。她盯着火漆，想起有人将钥匙和文书交到她掌中，叮嘱她取出内柜物件并藏妥。她承认藏入壁炉砖槽；这不是她自行决定的偷窃。"}
        ]
    if group == "astral":
        return [
            {"id": "moran_calmed", "actor": "detective", "after": "evidence_complete", "time": 480, "kind": "talk", "partner": "moran", "text": "侦探没有催问，陪莫兰把呼吸放缓。他终于同意打开画夹暗层，取出未被截去的完整草图。"},
            {"id": "gesture_examined", "actor": "detective", "after": "moran_calmed", "time": 480, "kind": "inspect", "partner": "", "text": "完整草图中，伊莲娜伸出的手接着做了明确的劈切手势。半截画面遮住的，正是这个后续动作。"},
            {"id": "elena_identified", "actor": "detective", "after": "gesture_examined", "time": 480, "kind": "talk", "partner": "elena", "text": "伊莲娜辨认完整草图：‘是我的手。我让她关。’阮清月确实拉闸，却不是单方面把她抛下。"}
        ]
    return [
        {"id": "old_scar_examined", "actor": "detective", "after": "evidence_complete", "time": 480, "kind": "inspect", "partner": "veronica", "text": "维罗妮卡同意卷起左袖。侦探查看的是左臂旧疤，边缘已愈合，与贝尔特朗今天的高烧分属不同病史。"},
        {"id": "veronica_explained", "actor": "detective", "after": "old_scar_examined", "time": 480, "kind": "talk", "partner": "veronica", "text": "维罗妮卡说明：左臂三道旧疤来自R-07强酸络合剂的自体耐受标定。她依据此前在自己身上做的标定救治贝尔特朗；今天的酸泡争执不能抹去旧疤与救治用途。"}
    ]

axiom c1_other_truth_law(group, row):
    var subject = "detective"
    if row.kind == "talk":
        subject = row.partner
    var pre = [c1_at(subject, c1_other_case(group).room), c1_other_claim(group, row.after), dv_fact(c1_other_ref(group, row.id), false)]
    if row.partner != "":
        rt_push(pre, c1_at(row.partner, c1_other_case(group).room))
    return dv_axiom(rt_cat("detective.truth.", row.id), 1, dv_all(pre), [dv_assign(c1_other_ref(group, row.id), true)])

// Present doors, bodies and heard voices are distinct from frozen accident evidence.
// Initial placement creates a physical body; it never opens a latch or marks a crossing.

fn c1dep_source(file, line, id):
    return c1_source(rt_cat("godot_csharp/scenes/Awakening/Script/story/第一章/场面/", file), line, id)

fn c1dep_ref(field):
    return dv_ref("departure.door", "state", field)

fn c1dep_cross_ref(actor):
    return dv_ref(rt_cat("departure.person.", actor), "state", "crossed")

fn c1dep_complete():
    return dv_all([dv_fact(dv_ref("question", "state", "solved_identity"), true), dv_fact(dv_ref("question", "state", "solved_voice_source"), true), dv_fact(dv_ref("question", "state", "solved_words"), true), dv_fact(dv_ref("question", "state", "solved_trust"), true)])

fn c1dep_can_cross():
    return dv_all([dv_fact(c1dep_ref("outer_released"), true), dv_fact(c1dep_ref("inner_down"), false), dv_fact(c1dep_ref("open"), true)])

fn c1dep_entered(world, actor):
    return dv_truth(world, dv_fact(c1dep_cross_ref(actor), true)) == "true"

axiom c1dep_outer_law():
    return dv_axiom("c1dep_outer_law", 1, dv_all([c1dep_complete(), c2_at("demon", "living_hall"), dv_fact(dv_ref("demon.body", "state", "manifested"), true), dv_fact(c1dep_ref("outer_released"), false)]), [dv_assign(c1dep_ref("outer_released"), true), dv_assign(c2_access("living_exit"), true), dv_assign(dv_ref("demon.body", "state", "manifested"), false), dv_assign(dv_ref("demon.body", "state", "latch_hand_trace"), "long-narrow-hand")])

axiom c1dep_pick_law():
    return dv_axiom("c1dep_pick_law", 1, dv_all([c1_at("quer", "living_hall"), dv_at_least(c1_other_clock_ref(), 780), dv_fact(c1dep_ref("outer_released"), false), dv_fact(c1dep_ref("quer_has_wire"), true)]), [dv_assign(c1dep_ref("outer_released"), true), dv_assign(c1dep_ref("picked_by_quer"), true), dv_assign(c2_access("living_exit"), true)])

axiom c1dep_pick_contract_law():
    return dv_axiom("c1dep_pick_contract_law", 1, dv_all([c1_at("quer", "dorm.contract"), dv_at_least(c1_other_clock_ref(), 630), c1_other_claim("contract", "quer_insulted"), dv_fact(c1dep_ref("quer_has_wire"), true), dv_fact(c1_other_ref("contract", "outer_latch_released"), false)]), [dv_assign(c1_other_ref("contract", "outer_latch_released"), true), dv_assign(c1_other_access_ref("contract"), true), dv_assign(c1dep_ref("contract_picked_by_quer"), true)])

axiom c1dep_inner_law(actor):
    return dv_axiom("c1dep_inner_law", 1, dv_all([c1_at(actor, "foyer"), dv_fact(c1dep_ref("outer_released"), true), dv_fact(c1dep_ref("inner_down"), true)]), dv_single(dv_assign(c1dep_ref("inner_down"), false)))

axiom c1dep_open_law(actor):
    return dv_axiom("c1dep_open_law", 1, dv_all([c1_at(actor, "foyer"), dv_fact(c1dep_ref("outer_released"), true), dv_fact(c1dep_ref("inner_down"), false), dv_fact(c1dep_ref("open"), false)]), dv_single(dv_assign(c1dep_ref("open"), true)))

axiom c1dep_cross_law(actor, outward):
    var origin = "living_hall"
    var target = "foyer"
    if outward:
        origin = "foyer"
        target = "living_hall"
    var effects = dv_single(dv_assign(dv_ref(actor, "state", "location"), target))
    if outward:
        rt_push(effects, dv_assign(c1dep_cross_ref(actor), true))
    return dv_axiom("c1dep_cross_law", 1, dv_all([c1_at(actor, origin), c1dep_can_cross()]), effects)

axiom c1dep_join_law(actor, group):
    var pre = dv_all([c1_at(actor, rt_cat("threshold.", group)), dv_fact(c2_ref(rt_cat("case.", group), "outer_latch_released"), true), dv_fact(c2_access(group), true)])
    if actor == "quer" or actor == "lucian":
        pre = dv_all([pre, dv_at_least(c1_other_clock_ref(), 690)])
    return dv_axiom("c1dep_join_law", 1, pre, dv_single(dv_assign(dv_ref(actor, "state", "location"), "living_hall")))

fn c1dep_speech(actor, id, room, when, literal, text, source):
    return dv_with_many(c2_action(id, "talk", dv_all([c1_at(actor, room), when, literal]), c1_at(actor, room), "", [], text, source), {"speech": dv_with_many(c1_speech(literal, source, "current-doorway-dialogue"), {"surface": text, "channel": "door.living"}), "listeners": dv_append(c2_people(), "demon")})

fn c1dep_actions(actor):
    var actions = []
    let source = c1dep_source("08_终局.story", 4, "s10_steps.003")
    let four = ["detective", "huo", "shen", "su"]
    if dv_has(four, actor):
        let fields = [c1dep_ref("outer_released"), c1dep_ref("inner_down"), c1dep_ref("open"), c2_access("living_exit")]
        rt_push(actions, dv_with(c2_action(rt_cat(actor, ".departure.inspect-door"), "inspect", c1_at(actor, "foyer"), c1_at(actor, "foyer"), "", fields, "查看门内的插闩和门外的横闩。", c1dep_source("11_门外的人.story", 8, "door_voices.005")), "repeatable", true))
        if actor == "detective":
            let inner = dv_all([c1_at(actor, "foyer"), dv_fact(c1dep_ref("outer_released"), true), dv_fact(c1dep_ref("inner_down"), true)])
            rt_push(actions, dv_with_many(c2_action(rt_cat(actor, ".departure.draw-inner"), "help", inner, inner, rt_cat(actor, ".departure.draw-inner"), dv_single(c1dep_ref("inner_down")), "拔出门内的插闩。", source), {"predict_law": rt_cat(actor, ".departure.draw-inner"), "public_observers": four, "public_grants": [c1dep_ref("inner_down")]}))
            let open = dv_all([c1_at(actor, "foyer"), dv_fact(c1dep_ref("outer_released"), true), dv_fact(c1dep_ref("inner_down"), false)])
            rt_push(actions, dv_with_many(c2_action(rt_cat(actor, ".departure.open-door"), "help", open, open, rt_cat(actor, ".departure.open-door"), dv_single(c1dep_ref("open")), "拉开隔离门。", c1dep_source("08_终局.story", 8, "s10_open")), {"predict_law": rt_cat(actor, ".departure.open-door"), "speech": dv_with_many(c1_speech(dv_true(), c1dep_source("08_终局.story", 8, "s10_open"), "actual-door-open"), {"surface": "拉开隔离门。", "channel": "door.living"}), "listeners": ["huo", "shen", "su"], "public_grants": [c1dep_ref("outer_released"), c1dep_ref("inner_down"), c1dep_ref("open"), c2_access("living_exit")]}))
        let out = dv_all([c1_at(actor, "foyer"), c1dep_can_cross()])
        let back = dv_all([c1_at(actor, "living_hall"), c1dep_can_cross()])
        let out_id = rt_cat(actor, ".departure.cross-out")
        let in_id = rt_cat(actor, ".departure.cross-in")
        rt_push(actions, dv_with_many(c2_action(out_id, "move", out, out, out_id, [dv_ref(actor, "state", "location"), c1dep_cross_ref(actor), c1_other_clock_ref()], "跨过门槛，走进起居厅。", c1dep_source("08_终局.story", 24, "s10_open.003：是否迈出由本人选择")), {"predict_law": out_id, "repeatable": true, "travel": {"from": "foyer", "to": "living_hall", "gate": "living_exit"}}))
        rt_push(actions, dv_with_many(c2_action(in_id, "move", back, back, in_id, dv_single(dv_ref(actor, "state", "location")), "穿过隔离门，回到门厅。", source), {"predict_law": in_id, "repeatable": true, "travel": {"from": "living_hall", "to": "foyer", "gate": "living_exit"}}))
    if actor != "demon" and c2_profile(actor).group != "living":
        let group = c2_profile(actor).group
        let pre = c1dep_join_law(actor, group).premise
        let id = rt_cat(actor, ".departure.join-living")
        rt_push(actions, dv_with_many(c2_action(id, "move", pre, pre, id, dv_single(dv_ref(actor, "state", "location")), "从寝区门外走进起居厅。", c1_other_departure_source(actor).source), {"predict_law": id, "repeatable": true, "travel": {"from": rt_cat("threshold.", group), "to": "living_hall", "gate": "living"}}))
    if actor == "quer":
        rt_push(actions, dv_with(c2_action("quer.departure.inspect-yi-outer", "inspect", c1_at(actor, "living_hall"), c1_at(actor, "living_hall"), "", [c1dep_ref("outer_released")], "查看乙区门外的横闩。", source), "repeatable", true))
        let own_pre = c1dep_pick_contract_law().premise
        rt_push(actions, dv_with_many(c2_action("quer.departure.pick-contract", "experiment", own_pre, own_pre, "quer.departure.pick-contract", [c1_other_ref("contract", "outer_latch_released"), c1_other_access_ref("contract"), c1dep_ref("contract_picked_by_quer")], "雀儿受够了盘问，从袖口拉出精钢丝，探过门缝挑起甲区外闩。卢西安收起手稿，跟上她。", c1_source("docs/design-standard.md", 0, "甲区开锁机会")), {"predict_law": "quer.departure.pick-contract", "public_observers": ["lucian", "ward", "gu"], "public_grants": [c1_other_ref("contract", "outer_latch_released"), c1_other_access_ref("contract")]}))
        let pre = c1dep_pick_law().premise
        let pick_source = c1dep_source("12_雀儿撬门.story", 7, "quer_opens.001-002")
        let pick = c2_action("quer.departure.pick-outer", "experiment", pre, pre, "quer.departure.pick-outer", [c1dep_ref("outer_released"), c1dep_ref("picked_by_quer"), c2_access("living_exit")], "细铁丝拨了四下，外侧的横闩抬了起来。", pick_source)
        rt_push(actions, dv_with_many(pick, {"predict_law": "quer.departure.pick-outer", "speech": dv_with_many(c1_speech(dv_true(), pick_source, "actual-latch-sound"), {"surface": "门外传来细铁丝拨动和横闩抬起的金属响声。", "channel": "door.living"}), "listeners": four, "public_grants": [c1dep_ref("outer_released"), c2_access("living_exit")]}))
        let receipt = dv_at_least(c1_other_clock_ref(), 690)
        let call = c1dep_speech(actor, "quer.departure.call-inside", "living_hall", receipt, dv_true(), "里头有人？", c1dep_source("11_门外的人.story", 5, "door_voices.002：询问部分"))
        rt_push(actions, dv_with(call, "speech", dv_with(call.speech, "utterance_type", "question")))
        let self = dv_fact(c1dep_ref("contract_picked_by_quer"), true)
        let reply = c1dep_speech(actor, "quer.departure.answer-door", "living_hall", self, self, "甲区的，叫我雀儿。那边的门让我挑开了。你们这扇，我也可以看看。", c1dep_source("11_门外的人.story", 8, "door_voices.005"))
        rt_push(actions, dv_with(reply, "response_topic", "door_identity"))
    if actor == "lucian":
        let receipt = dv_at_least(c1_other_clock_ref(), 690)
        rt_push(actions, dv_with(c1dep_speech(actor, "lucian.departure.rebuke-quer", "living_hall", receipt, dv_true(), "雀儿，贴着门板喊，里头听得见，礼数可就丢了。", c1dep_source("11_门外的人.story", 6, "door_voices.003")), "received_speech_requirement", {"speaker": "quer", "action_id": "quer.departure.call-inside"}))
    if actor == "detective":
        var ask = c1dep_speech(actor, "detective.departure.ask-door", "foyer", dv_true(), dv_true(), "门外是谁？", c1dep_source("11_门外的人.story", 7, "door_voices.004"))
        ask = dv_with_many(ask, {"speech": dv_with(ask.speech, "request", {"target": "quer", "topic": "door_identity"}), "request_transport": {"channel": "door.living"}, "received_speech_requirement": {"speaker": "quer", "action_id": "quer.departure.call-inside"}})
        rt_push(actions, ask)
    if actor == "su":
        let picked = dv_all([c1_at(actor, "living_hall"), dv_fact(c1dep_ref("picked_by_quer"), true)])
        rt_push(actions, c1dep_speech(actor, "su.departure.picked-rebuke", "living_hall", picked, picked, "门不是你答开的，是雀儿从外侧挑开的。你甚至没能说清门外究竟发生了什么。", c1dep_source("08_终局.story", 26, "su_picked_rebuke")))
        let unpicked = dv_all([c1_at(actor, "living_hall"), dv_fact(c1dep_ref("picked_by_quer"), false), dv_fact(c1dep_ref("outer_released"), true)])
        rt_push(actions, c1dep_speech(actor, "su.departure.praise", "living_hall", unpicked, unpicked, "你辨清了声路和木楔。门外的人不是因开门而死的。", c1dep_source("08_终局.story", 29, "su_unpicked_praise")))
    if actor == "shen":
        let picked = dv_all([c1_at(actor, "living_hall"), dv_fact(c1dep_ref("picked_by_quer"), true)])
        rt_push(actions, c1dep_speech(actor, "shen.departure.picked-doubt", "living_hall", picked, picked, "方才在门内，你言语前后遮掩；门外的事，你终究没有给大家一个交代。", c1dep_source("08_终局.story", 27, "shen_picked_doubt")))
    if actor == "huo":
        let picked = dv_all([c1_at(actor, "living_hall"), dv_fact(c1dep_ref("picked_by_quer"), true)])
        rt_push(actions, c1dep_speech(actor, "huo.departure.picked-cold", "living_hall", picked, picked, "若是连自己做过的事都说不分明，日后如何同路？", c1dep_source("08_终局.story", 28, "huo_picked_cold")))
        let unpicked = dv_all([c1_at(actor, "living_hall"), dv_fact(c1dep_ref("picked_by_quer"), false), dv_fact(c1dep_ref("outer_released"), true)])
        rt_push(actions, c1dep_speech(actor, "huo.departure.trust", "living_hall", unpicked, unpicked, "四步始业之答，堂堂正正。靴印与木楔的真相，我信你。", c1dep_source("08_终局.story", 30, "huo_unpicked_trust")))
    if actor == "demon":
        let manifestation = c1dep_manifest_law()
        rt_push(actions, dv_with_many(c2_action("demon.departure.manifest", "help", manifestation.premise, manifestation.premise, "demon.departure.manifest", [dv_ref("demon.body", "state", "manifested")], "虚影在门闩前凝实，修长窄薄的手掌获得了可以碰触物体的重量。", source), {"predict_law": "demon.departure.manifest", "repeatable": true}))
        let groups = ["contract", "astral", "logistics"]
        var g = 0
        while g < rt_count(groups):
            let group = groups[g]
            var refs = [c1_other_ref(group, "outer_latch_released"), c1_other_ref(group, "formal_release"), c1_other_ref(group, "evidence_complete"), c1_other_ref(group, "care_given"), c1_other_ref(group, "west_passage_checked"), c1_other_ref(group, "observation_complete"), c1_other_clock_ref()]
            let people = c1_other_people()
            var p = 0
            while p < rt_count(people):
                if people[p].group == group:
                    rt_push(refs, c1_other_ref(group, rt_cat("receipt.", people[p].id)))
                p = p + 1
            rt_push(actions, dv_with(c2_action(rt_cat("demon.departure.inspect.", group), "inspect", c2_at(actor, "living_hall"), c2_at(actor, "living_hall"), "", refs, "核对铜口答复记录与寝区外闩。", c1_other_case(group).source), "repeatable", true))
            rt_push(actions, c1_other_release_action(group, actor, c1_other_clock_ref()))
            g = g + 1
        let solved_refs = [dv_ref("question", "state", "solved_identity"), dv_ref("question", "state", "solved_voice_source"), dv_ref("question", "state", "solved_words"), dv_ref("question", "state", "solved_trust")]
        rt_push(actions, dv_with(c2_action("demon.departure.inspect-accepted", "inspect", c2_at(actor, "living_hall"), c2_at(actor, "living_hall"), "", solved_refs, "查看已认定的答复。", source), "repeatable", true))
        rt_push(actions, dv_with(c2_action("demon.departure.inspect-body", "inspect", dv_true(), dv_true(), "", dv_single(c2_position_ref(actor)), "看了看周围。", source), "repeatable", true))
        rt_push(actions, dv_with(c2_action("demon.departure.inspect-outer", "inspect", c2_at(actor, "living_hall"), c2_at(actor, "living_hall"), "", dv_single(c1dep_ref("outer_released")), "查看隔离门外侧的横闩。", source), "repeatable", true))
        let after_answer = dv_all([c2_at(actor, "living_hall"), c1dep_complete()])
        rt_push(actions, dv_with(c2_action("demon.departure.inspect-clock", "inspect", after_answer, after_answer, "", [c1_other_clock_ref()], "查看起居厅钟面。", source), "repeatable", true))
        let pre = c1dep_outer_law().premise
        let lifted = c2_action("demon.departure.release-outer", "help", pre, pre, "demon.departure.release-outer", [c1dep_ref("outer_released"), c2_access("living_exit"), dv_ref("demon.body", "state", "manifested")], "外侧的横闩，被一只手抬了起来。", source)
        rt_push(actions, dv_with_many(lifted, {"predict_law": "demon.departure.release-outer", "speech": dv_with_many(c1_speech(dv_true(), source, "actual-latch-sound"), {"surface": "门外传来横闩抬起的金属响声。", "channel": "door.living"}), "listeners": four, "public_grants": [c1dep_ref("outer_released"), c2_access("living_exit")]}))
    let hand_ref = dv_ref("demon.body", "state", "hand_shape")
    let owner_ref = dv_ref("demon.body", "state", "shelf_print_owner")
    let hand_source = c1_source("docs/design-standard.md", 0, "架沿手印的观察与询问")
    if dv_has(four, actor):
        let present = dv_all([c1_at(actor, "living_hall"), c2_at("demon", "living_hall"), dv_fact(dv_ref("demon.body", "state", "manifested"), true)])
        rt_push(actions, c2_action(rt_cat(actor, ".departure.inspect-hand"), "inspect", c1_at(actor, "living_hall"), present, "", [hand_ref], "他手形修长，掌面窄薄。仅凭外形，还不能断定架沿的半枚手印属于他。", hand_source))
        let seen_print = dv_fact(c1_knowledge("hand_not_mine"), true)
        var ask = c1dep_speech(actor, rt_cat(actor, ".departure.ask-print"), "living_hall", seen_print, dv_true(), "架上的手印，是你的吗？", hand_source)
        ask = dv_with_many(ask, {"speech": dv_with_many(ask.speech, {"channel": "local", "request": {"target": "demon", "topic": "shelf.print-owner"}}), "purpose_refs": [owner_ref]})
        rt_push(actions, ask)
    if actor == "demon":
        let claim = dv_fact(owner_ref, "demon")
        var reply = c1dep_speech(actor, "demon.departure.answer-print", "living_hall", claim, claim, "是。诸位封存之物，是我取走的。", hand_source)
        reply = dv_with_many(reply, {"precondition": dv_all([c2_at(actor, "living_hall"), claim]), "authority_precondition": c2_at(actor, "living_hall"), "speech": dv_with(reply.speech, "channel", "local"), "response_topic": "shelf.print-owner", "requires_actual_request": true})
        rt_push(actions, c1_authorized_speech(reply))
    return c1_public_methods(actions)

fn c1dep_laws(world, actor):
    var mode = "enforce"
    if world.domain == "mind":
        mode = "predict"
    var result = world
    let source = c1dep_source("08_终局.story", 4, "s10_steps.003")
    if actor == "detective":
        result = dv_adopt(result, c1_method(rt_cat(actor, ".departure.draw-inner"), c1dep_inner_law(actor)), mode, 1, [source])
        result = dv_adopt(result, c1_method(rt_cat(actor, ".departure.open-door"), c1dep_open_law(actor)), mode, 1, [source])
    if dv_has(["detective", "huo", "shen", "su"], actor):
        result = dv_adopt(result, c1_method(rt_cat(actor, ".departure.cross-out"), c1dep_cross_law(actor, true)), mode, 1, [source])
        result = dv_adopt(result, c1_method(rt_cat(actor, ".departure.cross-in"), c1dep_cross_law(actor, false)), mode, 1, [source])
    if actor != "demon" and c2_profile(actor).group != "living":
        result = dv_adopt(result, c1_method(rt_cat(actor, ".departure.join-living"), c1dep_join_law(actor, c2_profile(actor).group)), mode, 1, [c1_other_departure_source(actor).source])
    if actor == "quer":
        result = dv_adopt(result, c1_method("quer.departure.pick-contract", c1dep_pick_contract_law()), mode, 1, [c1_source("docs/design-standard.md", 0, "甲区开锁机会")])
        result = dv_adopt(result, c1_method("quer.departure.pick-outer", c1dep_pick_law()), mode, 1, [c1dep_source("12_雀儿撬门.story", 7, "quer_opens.001-002")])
    if actor == "demon":
        result = dv_adopt(result, c1_method("demon.departure.manifest", c1dep_manifest_law()), mode, 1, [source])
        if mode == "predict":
            let groups = ["contract", "astral", "logistics"]
            var g = 0
            while g < rt_count(groups):
                result = dv_adopt(result, c1_method(rt_cat("other.release.", groups[g]), c1_other_release(groups[g], c1_other_clock_ref())), mode, 1, [c1_other_case(groups[g]).source])
                g = g + 1
        result = dv_adopt(result, c1_method("demon.departure.release-outer", c1dep_outer_law()), mode, 1, [source])
    return result

fn c1dep_goals(actor):
    var goals = []
    let source = [c1dep_source("08_终局.story", 24, "s10_open.003：未迈出由本人选择")]
    if dv_has(["detective", "huo", "shen", "su"], actor.id):
        let after_trust = dv_fact(dv_ref("question", "state", "solved_trust"), true)
        let released = dv_fact(c1dep_ref("outer_released"), true)
        let at_door = c1_at(actor.id, "foyer")
        let recheck = c1_any(after_trust, c1_any(released, at_door))
        let door_source = [c1dep_source("11_门外的人.story", 8, "door_voices.005：本人听见门外动静或在门厅现场复查")]
        rt_push(goals, dv_with_many(c2_observation_goal(c1dep_ref("outer_released"), recheck, door_source, 0), {"refresh_until": released, "refresh_refs": [dv_ref("question", "state", "solved_trust")]}))
        rt_push(goals, dv_with_many(c2_observation_goal(c1dep_ref("inner_down"), recheck, door_source, 0), {"refresh_until": dv_not(dv_true()), "refresh_refs": [c1dep_ref("outer_released")]}))
        rt_push(goals, dv_with_many(c2_observation_goal(c1dep_ref("open"), recheck, door_source, 0), {"refresh_until": dv_not(dv_true()), "refresh_refs": [c1dep_ref("outer_released")]}))
        rt_push(goals, c2_goal(dv_fact(c1dep_ref("inner_down"), false), dv_fact(c1dep_ref("outer_released"), true), source))
        rt_push(goals, c2_goal(dv_fact(c1dep_ref("open"), true), dv_fact(c1dep_ref("outer_released"), true), source))
        rt_push(goals, c2_goal(c1_at(actor.id, "living_hall"), dv_fact(c1dep_ref("outer_released"), true), source))
    if actor.id != "demon" and c2_profile(actor.id).group != "living":
        let leave = c1_other_depart(actor.id)
        rt_push(goals, c2_goal(c1_at(actor.id, rt_cat("threshold.", c2_profile(actor.id).group)), leave.premise, [c1_other_departure_source(actor.id).source]))
        var join_available = c1_at(actor.id, rt_cat("threshold.", c2_profile(actor.id).group))
        if actor.id == "quer" or actor.id == "lucian":
            join_available = c1dep_join_law(actor.id, c2_profile(actor.id).group).premise
        rt_push(goals, c2_goal(c1_at(actor.id, "living_hall"), join_available, [c1_other_departure_source(actor.id).source]))
    if actor.id == "quer":
        rt_push(goals, c2_goal(c1_other_claim("contract", "outer_latch_released"), c1dep_pick_contract_law().premise, source))
        rt_push(goals, dv_with(c2_observation_goal(c1dep_ref("outer_released"), c1_at(actor.id, "living_hall"), source, 0), "refresh_until", dv_fact(c1dep_ref("outer_released"), true)))
        rt_push(goals, c2_goal(dv_fact(c1dep_ref("outer_released"), true), c1_at(actor.id, "living_hall"), [c1dep_source("12_雀儿撬门.story", 10, "quer_opens.004")]))
    let actions = c1dep_actions(actor.id)
    var i = 0
    while i < rt_count(actions):
        if dv_has_key(actions[i], "speech"):
            rt_push(goals, {"kind": "communicate", "scope": "personal", "method_id": actions[i].id, "available_when": actions[i].precondition, "requires_argument": false, "basis": actions[i].source_refs})
        i = i + 1
    if actor.id == "demon":
        rt_push(goals, c2_observation_goal(c1_other_clock_ref(), dv_all([c2_at(actor.id, "living_hall"), c1dep_complete()]), source, 0))
        let people = c1_other_people()
        i = 0
        while i < rt_count(people):
            let ref = c1_other_ref(people[i].group, rt_cat("receipt.", people[i].id))
            rt_push(goals, c2_observation_goal(ref, c2_at(actor.id, "living_hall"), source, 0))
            i = i + 1
        let groups = ["contract", "astral", "logistics"]
        i = 0
        while i < rt_count(groups):
            let ref = c1_other_ref(groups[i], "formal_release")
            var receipt_refs = []
            var receipt_index = 0
            while receipt_index < rt_count(people):
                if people[receipt_index].group == groups[i]:
                    rt_push(receipt_refs, c1_other_ref(groups[i], rt_cat("receipt.", people[receipt_index].id)))
                receipt_index = receipt_index + 1
            let evidence_ref = c1_other_ref(groups[i], "evidence_complete")
            rt_push(goals, dv_with_many(c2_observation_goal(evidence_ref, c2_at(actor.id, "living_hall"), source, 0), {"refresh_until": dv_fact(evidence_ref, true), "refresh_refs": receipt_refs}))
            var reported = dv_not(dv_true())
            var safe_time = 840
            var safety = c1_other_claim(groups[i], "evidence_complete")
            if groups[i] == "astral":
                safe_time = 1890
                safety = dv_all([c1_other_claim(groups[i], "care_given"), c1_other_claim(groups[i], "west_passage_checked")])
            if groups[i] == "logistics":
                safe_time = 2010
                safety = dv_all([c1_other_claim(groups[i], "care_given"), c1_other_claim(groups[i], "observation_complete")])
            var person_index = 0
            while person_index < rt_count(people):
                if people[person_index].group == groups[i]:
                    reported = c1_any(reported, c1_other_claim(groups[i], rt_cat("receipt.", people[person_index].id)))
                person_index = person_index + 1
            let manifest_ready = dv_all([reported, safety, dv_at_least(c1_other_clock_ref(), safe_time), c2_at(actor.id, "living_hall"), dv_fact(dv_ref("demon.body", "state", "manifested"), false)])
            rt_push(goals, c2_goal(dv_fact(dv_ref("demon.body", "state", "manifested"), true), manifest_ready, source))
            rt_push(goals, c2_observation_goal(ref, c2_at(actor.id, "living_hall"), source, 0))
            rt_push(goals, c2_goal(dv_fact(ref, true), c1_other_release(groups[i], c1_other_clock_ref()).premise, source))
            i = i + 1
        rt_push(goals, c2_goal(dv_fact(dv_ref("demon.body", "state", "manifested"), true), c1dep_manifest_law().premise, source))
        rt_push(goals, c2_observation_goal(c2_position_ref(actor.id), dv_true(), source, 0))
        rt_push(goals, c2_observation_goal(c1dep_ref("outer_released"), c2_at(actor.id, "living_hall"), source, 0))
        rt_push(goals, c2_goal(dv_fact(c1dep_ref("outer_released"), true), c1dep_complete(), source))
    var refreshed = []
    var g = 0
    while g < rt_count(goals):
        var goal = goals[g]
        if dv_has_key(goal, "refresh_until") and not dv_has_key(goal, "refresh_refs"):
            var triggers = []
            if dv_has(["detective", "huo", "shen", "su"], actor.id):
                rt_push(triggers, dv_ref("question", "state", "solved_trust"))
            goal = dv_with(goal, "refresh_refs", triggers)
        rt_push(refreshed, goal)
        g = g + 1
    goals = refreshed

    return goals

fn c1dep_install_scene(scene):
    if dv_find(scene, "departure_installed", false):
        return scene
    var physical = dv_store(scene.physical, dv_ref("demon", "state", "location"), dv_field("living_hall"))
    physical = c2_add_new(physical, c1_state_object("departure.door", {"outer_released": dv_field(false), "inner_down": dv_field(true), "open": dv_field(false), "quer_has_wire": dv_field(true), "picked_by_quer": dv_field(false), "contract_picked_by_quer": dv_field(false)}))
    physical = c2_add_new(physical, c1_state_object("demon.body", {"manifested": dv_field(false), "latch_hand_trace": dv_field("")}))
    physical = dv_store(physical, dv_ref("demon.body", "state", "hand_shape"), dv_field("long-narrow-hand"))
    physical = dv_store(physical, dv_ref("demon.body", "state", "shelf_print_owner"), dv_field("demon"))
    if not dv_read(physical, c2_access("living_exit")).known:
        physical = dv_store(physical, c2_access("living_exit"), dv_field(false))
    var objects = ["departure.door", "demon.body", "campaign.access", "campaign.clock", "case.contract", "case.astral", "case.logistics"]
    let four = ["detective", "huo", "shen", "su"]
    var i = 0
    while i < rt_count(four):
        let id = rt_cat("departure.person.", four[i])
        physical = c2_add_new(physical, c1_state_object(id, {"crossed": dv_field(false)}))
        rt_push(objects, id)
        i = i + 1
    var actors = []
    var bindings = dv_clone(scene.bindings)
    i = 0
    while i < rt_count(scene.actors):
        var actor = scene.actors[i]
        physical = c1dep_laws(physical, actor.id)
        var mind = actor.mind
        if actor.id == "demon":
            mind = dv_store(mind, dv_ref("demon", "state", "location"), dv_with(dv_field("living_hall"), "basis", [c1dep_source("08_终局.story", 1, "自身所在铜管外端")] ))
        var j = 0
        while j < rt_count(objects):
            mind = c2_add_new(mind, c1_local_object(objects[j]))
            if dv_local(bindings, objects[j], actor.id) == "":
                rt_push(bindings, dv_binding(objects[j], objects[j], actor.id))
            j = j + 1
        mind = c1dep_laws(mind, actor.id)
        if dv_has(four, actor.id):
            mind = dv_store(mind, c1dep_ref("outer_released"), dv_with(dv_field(false), "basis", [c1dep_source("08_终局.story", 4, "s10_steps.003")]))
        if actor.id == "demon":
            mind = dv_store(mind, dv_ref("demon.body", "state", "manifested"), dv_with(dv_field(false), "basis", [c1dep_source("08_终局.story", 4, "自身虚实体状态")]))
            mind = dv_store(mind, dv_ref("demon.body", "state", "shelf_print_owner"), dv_with(dv_field("demon"), "basis", [c1_source("docs/design-standard.md", 0, "本人移物行动")]))
        if actor.id == "quer" and not dv_read(mind, c1dep_ref("quer_has_wire")).known:
            mind = dv_store(mind, c1dep_ref("quer_has_wire"), dv_with(dv_field(true), "basis", [c1dep_source("12_雀儿撬门.story", 9, "quer_opens.003：手里的铁丝")]))
        var actions = c1dep_unify_demon_position(actor.actions)
        var hearing = c1dep_unify_demon_position(dv_find(actor, "hearing_grants", []))
        var transport_index = 0
        while transport_index < rt_count(hearing):
            var grant = hearing[transport_index]
            if grant.speaker == "demon":
                grant = dv_with(grant, "sender_locations", ["living_hall"])
            if actor.id == "demon":
                grant = dv_with(grant, "listener_locations", ["living_hall"])
            hearing = dvs_replace(hearing, transport_index, grant)
            transport_index = transport_index + 1
        var channels = dv_clone(dv_find(actor, "request_channels", []))
        if actor.id == "demon":
            j = 0
            while j < rt_count(actions):
                if dv_has_key(actions[j], "speech"):
                    var action = dv_with(actions[j], "speech", dv_with(actions[j].speech, "emission_location_ref", dv_ref("demon", "state", "location")))
                    action = dv_without(action, "opportunity_requirement")
                    if action.id == "demon.opening":
                        action = dv_with(action, "received_speech_requirement", {"speaker": "shen", "action_id": "shen.opening.body-habit", "receipt_kind": "actual-listener-parse"})
                    if dv_has_key(action, "response_topic"):
                        action = dv_with(action, "request_transport", {"channel": "copper.living"})
                    actions = dvs_replace(actions, j, action)
                j = j + 1
            j = 0
            while j < rt_count(hearing):
                hearing = dvs_replace(hearing, j, dv_with(hearing[j], "reception_location_ref", dv_ref("demon", "state", "location")))
                j = j + 1
            j = 0
            while j < rt_count(four):
                rt_push(hearing, {"speaker": four[j], "channel": "", "available_when": c1_at("demon", "living_hall"), "sender_locations": ["hall"], "listener_locations": ["living_hall"], "reception_location_ref": dv_ref("demon", "state", "location"), "basis": [c1dep_source("08_终局.story", 1, "铜口听取已认定的答复")]})
                rt_push(hearing, {"speaker": four[j], "channel": "copper.living", "available_when": c1_at("demon", "living_hall"), "sender_locations": ["hall"], "listener_locations": ["living_hall"], "reception_location_ref": dv_ref("demon", "state", "location"), "basis": [c1dep_source("08_终局.story", 1, "铜口接收实际询问")]})
                rt_push(hearing, {"speaker": four[j], "channel": "formal-receipt", "available_when": c1_at("demon", "living_hall"), "sender_locations": ["hall"], "listener_locations": ["living_hall"], "reception_location_ref": dv_ref("demon", "state", "location"), "basis": [c1dep_source("08_终局.story", 1, "铜口接收实际答辩回执")]})
                rt_push(channels, {"target": four[j], "channel": "copper.living", "available_when": c1_at("demon", "living_hall"), "basis": [c1dep_source("08_终局.story", 1, "应已经听到的询问向端口回答")]})
                j = j + 1
            actor = dv_with_many(actor, {"location_ref": c2_position_ref("demon"), "observable_presence_when": dv_fact(dv_ref("demon.body", "state", "manifested"), true)})
        if dv_has(four, actor.id):
            j = 0
            while j < rt_count(four):
                if four[j] != actor.id:
                    rt_push(hearing, {"speaker": four[j], "channel": "formal-receipt", "available_when": dv_true(), "sender_locations": ["hall"], "listener_locations": ["hall", "foyer", "pantry", "corridor"], "basis": [c1dep_source("08_终局.story", 1, "乙区实际公开答辩回执") ]})
                j = j + 1
            rt_push(hearing, {"speaker": "demon", "channel": "", "available_when": c1_at(actor.id, "hall"), "sender_locations": ["living_hall"], "listener_locations": ["hall"], "basis": [c1dep_source("08_终局.story", 1, "铜管实际传声")]})
            rt_push(hearing, {"speaker": "demon", "channel": "copper.living", "available_when": c1_at(actor.id, "hall"), "sender_locations": ["living_hall"], "listener_locations": ["hall"], "basis": [c1dep_source("08_终局.story", 1, "铜管实际回复")]})
            rt_push(hearing, {"speaker": "demon", "channel": "door.living", "available_when": c1_any(c1_at(actor.id, "foyer"), c1_at(actor.id, "hall")), "sender_locations": ["living_hall"], "listener_locations": ["foyer", "hall"], "basis": [c1dep_source("08_终局.story", 4, "门外抬闩的实际声响")]})
            if actor.id != "detective":
                rt_push(hearing, {"speaker": "detective", "channel": "door.living", "available_when": c1_any(c1_at(actor.id, "foyer"), c1_at(actor.id, "hall")), "sender_locations": ["foyer"], "listener_locations": ["foyer", "hall"], "basis": [c1dep_source("08_终局.story", 8, "s10_open")]})
            rt_push(channels, {"target": "demon", "channel": "copper.living", "available_when": c1_at(actor.id, "hall"), "basis": [c1dep_source("08_终局.story", 46, "对着铜口询问")]})
            j = 0
            while j < rt_count(actions):
                if dv_has_key(actions[j], "speech"):
                    let listeners = dv_find(actions[j], "listeners", [])
                    if not dv_has(listeners, "demon"):
                        actions = dvs_replace(actions, j, dv_with(actions[j], "listeners", dv_append(listeners, "demon")))
                let request = dv_find(dv_find(actions[j], "speech", []), "request", false)
                if request != false:
                    if request.target == "demon":
                        actions = dvs_replace(actions, j, dv_with_many(actions[j], {"request_transport": {"channel": "copper.living"}, "speech": dv_with(actions[j].speech, "channel", "copper.living"), "opportunity_requirement": {"location": "hall", "participants": [actor.id], "mode": "all-present"}}))
                j = j + 1
            let outsiders = ["quer", "lucian"]
            j = 0
            while j < rt_count(outsiders):
                rt_push(hearing, {"speaker": outsiders[j], "channel": "door.living", "available_when": c1_at(actor.id, "foyer"), "sender_locations": ["living_hall"], "listener_locations": ["foyer"], "basis": [c1dep_source("11_门外的人.story", 5, "隔门只闻其声")]})
                j = j + 1
            rt_push(channels, {"target": "quer", "channel": "door.living", "available_when": c1_at(actor.id, "foyer"), "basis": [c1dep_source("11_门外的人.story", 7, "隔门询问")]})
        if actor.id == "quer" or actor.id == "lucian":
            j = 0
            while j < rt_count(four):
                rt_push(hearing, {"speaker": four[j], "channel": "door.living", "available_when": c1_at(actor.id, "living_hall"), "sender_locations": ["foyer"], "listener_locations": ["living_hall"], "basis": [c1dep_source("11_门外的人.story", 7, "隔门问答")]})
                rt_push(channels, {"target": four[j], "channel": "door.living", "available_when": c1_at(actor.id, "living_hall"), "basis": [c1dep_source("11_门外的人.story", 8, "隔门回答")]})
                j = j + 1
        let extra = c1dep_actions(actor.id)
        j = 0
        while j < rt_count(extra):
            rt_push(actions, extra[j])
            j = j + 1
        actor = dv_with_many(actor, {"mind": c1dep_unify_demon_position(mind), "policy": c1dep_unify_demon_position(actor.policy), "actions": c1_public_methods(actions), "hearing_grants": hearing, "request_channels": channels})
        if actor.id == "demon":
            actor = dv_with(actor, "policy", dv_with_many(actor.policy, {"wait_chunk_limit": 60, "plan_depth": 1}))
        let goals = c1dep_goals(actor)
        var combined = dv_clone(dv_find(actor.policy, "goals", []))
        j = 0
        while j < rt_count(goals):
            rt_push(combined, goals[j])
            j = j + 1
        actor = dv_with(actor, "policy", dv_with_many(actor.policy, {"goals": combined, "departure_goals": goals}))
        rt_push(actors, actor)
        i = i + 1
    return dv_with_many(scene, {"physical": c1dep_unify_demon_position(physical), "actors": actors, "bindings": bindings, "departure_installed": true, "departure_input_contract": {"demon_body_ref": c2_position_ref("demon"), "body_origin": "living-hall-outside-isolation-door", "normal_release_requires": c1dep_outer_law().premise, "entered_ref": c1dep_cross_ref("detective")}})


axiom c1dep_manifest_law():
    var ready = dv_all([c1dep_complete(), dv_fact(c1dep_ref("outer_released"), false)])
    let groups = ["contract", "astral", "logistics"]
    var i = 0
    while i < rt_count(groups):
        let group = groups[i]
        let people = c1_other_people()
        var j = 0
        while j < rt_count(people):
            if people[j].group == group:
                var safe_time = 840
                var safety = c1_other_claim(group, "evidence_complete")
                if group == "astral":
                    safe_time = 1890
                    safety = dv_all([c1_other_claim(group, "care_given"), c1_other_claim(group, "west_passage_checked")])
                if group == "logistics":
                    safe_time = 2010
                    safety = dv_all([c1_other_claim(group, "care_given"), c1_other_claim(group, "observation_complete")])
                ready = c1_any(ready, dv_all([c1_other_claim(group, rt_cat("receipt.", people[j].id)), dv_fact(c1_other_ref(group, "formal_release"), false), safety, dv_at_least(c1_other_clock_ref(), safe_time)]))
            j = j + 1
        i = i + 1
    return dv_axiom("c1dep_manifest_law", 1, dv_all([c1_at("demon", "living_hall"), ready, dv_fact(dv_ref("demon.body", "state", "manifested"), false)]), [dv_assign(dv_ref("demon.body", "state", "manifested"), true)])


// Only legacy predicates naming the demon's former hall position are translated.
// Copper hearing still names both real endpoints and never creates another body.
fn c1dep_unify_demon_position(value):
    if not rt_is_list(value):
        return value
    if dv_record_like(value):
        if dv_find(value, "op", "") == "equals" and dv_has_key(value, "ref") and dv_has_key(value, "value"):
            let ref = value.ref
            if dv_record_like(ref):
                if dv_find(ref, "object", "") == "demon" and dv_find(ref, "facet", "") == "state" and dv_find(ref, "field", "") == "location" and value.value == "hall":
                    return dv_with(value, "value", "living_hall")
        var fields = []
        var field_index = 0
        while field_index < rt_count(value):
            rt_push(fields, [value[field_index][0], c1dep_unify_demon_position(value[field_index][1])])
            field_index = field_index + 1
        return fields
    var result = []
    var i = 0
    while i < rt_count(value):
        rt_push(result, c1dep_unify_demon_position(value[i]))
        i = i + 1
    return result
