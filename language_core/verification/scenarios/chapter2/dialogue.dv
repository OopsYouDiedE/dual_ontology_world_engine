// Native optional chapter-two conversations. Only local successful speech is heard.
// Dates open opportunities; they do not place people, settle a dispute or invent illness.

fn c2d_ref(field):
    return c2_ref("c2.dialogue", field)

fn c2d_person_ref(actor, field):
    return c2_ref(rt_cat("c2.dialogue.person.", actor), field)

fn c2d_mark(actor, method):
    return c2d_person_ref(actor, rt_cat("said.", method))

fn c2d_source(file, line, id):
    return c2_source(file, line, id)

fn c2d_people():
    return dv_append(c2_people(), "demon")

fn c2d_row(actor, id, room, when, literal, text, source):
    return {"actor": actor, "id": id, "room": room, "when": when, "literal": literal, "text": text, "source": source}

fn c2d_question(id, room, when, target, topic, text, refs, source):
    return dv_with_many(c2d_row("detective", id, room, when, dv_true(), text, source), {"request": {"target": target, "topic": topic}, "purpose_refs": refs, "category": "case"})

fn c2d_reply(actor, id, room, when, literal, topic, text, source):
    return dv_with(c2d_row(actor, id, room, when, literal, text, source), "response_topic", topic)

fn c2d_introductions():
    let key = ["authored-declaration", "c2d_introductions"]
    let cached = rt_memo_get([], key)
    if cached[0]:
        return cached[1]
    return rt_memo_put([], key, c2d_introductions_build())

fn c2d_introductions_build():
    return [
        {"actor": "ward", "text": "弗雷德里克·沃德，执业律师，甲区。", "source": c2d_source("06_场面.story", 25, "chapter2.meet_jia.002")},
        {"actor": "gu", "text": "老朽顾平章，读碑的。", "source": c2d_source("06_场面.story", 31, "chapter2.meet_jia.008")},
        {"actor": "selma", "text": "赛尔玛，采标本的。你们是乙区的？", "source": c2d_source("06_场面.story", 57, "chapter2.meet_bing.002")},
        {"actor": "ruan", "text": "阮清月。下棋。", "source": c2d_source("06_场面.story", 58, "chapter2.meet_bing.003")},
        {"actor": "moran", "text": "……莫兰。", "source": c2d_source("06_场面.story", 60, "chapter2.meet_bing.005")},
        {"actor": "mora", "text": "茉拉，医生。", "source": c2d_source("06_场面.story", 136, "chapter2.meet_ding.003")},
        {"actor": "bertrand", "text": "贝尔特朗，丁区。", "source": c2d_source("06_场面.story", 137, "chapter2.meet_ding.004")},
        {"actor": "margaret", "text": "玛格丽特，盖房子的。", "source": c2d_source("06_场面.story", 138, "chapter2.meet_ding.005")},
        {"actor": "veronica", "text": "维罗妮卡，化学。", "source": c2d_source("06_场面.story", 139, "chapter2.meet_ding.006")}]

fn c2d_curriculum():
    return [
        {"id": "lesson11", "title": "守则读法", "text": "入夜之后，诸位留于室内。已开放的封闭连廊也须核对密封、通风和现场读数。源质计在户外仪器阵入口，先在安全侧学会读数，再定路线。低洼、夜间与无风时易积灰，风止或地震后停行复测。读数不明时，留在已确认安全处，呼叫协助。", "source": c1_source("docs/design-standard.md", 0, "最低限度安全教学")},
        {"id": "lesson12", "title": "传声与机械", "text": "传声管两端都能传声。先核对通路与盖片，发话、复述分开进行；同时说话会互相遮盖。管口附近的话也可能传到另一端。", "source": c2d_source("07_家具与文本.story", 86, "第十二课.内容")},
        {"id": "lesson13", "title": "言灵初阶", "text": "十个词、基本语法：名词居首、条件居中、动词收尾。练习：两盏灯只灭一盏。", "source": c2d_source("07_家具与文本.story", 88, "第十三课.内容")},
        {"id": "lesson14", "title": "异象与记忆", "text": "辨别自己看见的、别人告诉你的，和自己盼着是真的。熟悉感只是一条线索，地点、时长与缘由仍需各自查证。", "source": c1_source("docs/design-standard.md", 0, "前两章的信息边界")}]

fn c2d_rows():
    let key = ["authored-declaration", "c2d_rows"]
    let cached = rt_memo_get([], key)
    if cached[0]:
        return cached[1]
    return rt_memo_put([], key, c2d_rows_build())

fn c2d_rows_build():
    var rows = []
    let contract_ref = c2d_ref("contract_full_text")
    let contract_source = c1_source("docs/design-standard.md", 0, "主动询问契约全文")
    let trace = dv_all([dv_fact(c1_knowledge("shelf_old"), true), dv_fact(c1_knowledge("hand_not_mine"), true), dv_fact(dv_ref("demon.body", "state", "hand_shape"), "long-narrow-hand"), dv_fact(dv_ref("demon.body", "state", "shelf_print_owner"), "demon")])
    let rule4 = dv_fact(c2d_ref("school_rule4"), "我所立之规，皆张贴于此。")
    var authority = c2d_question("detective.c2.ask-seal-authority", "living_hall", trace, "demon", "contract.seal-authority", "架沿的窄手印与你的手形相合。你说封存之物是你取走的；谁授权你封存？", [], contract_source)
    authority = dv_with_many(authority, {"category": "contract", "received_speech_requirement": {"speaker": "demon", "action_id": "demon.departure.answer-print"}})
    rt_push(rows, authority)
    let sealed = dv_fact(c2d_ref("seal_authority"), "契约")
    rt_push(rows, c2d_reply("demon", "demon.c2.seal-authority", "living_hall", dv_true(), sealed, "contract.seal-authority", "封存的权限来自契约。", contract_source))
    var other_rules = c2d_question("detective.c2.ask-other-rules", "lecture", dv_all([rule4, sealed]), "demon", "contract.other-rules", "第四条说“我所立之规，皆张贴于此”。是否意味着尚有非你所立之规？", [], contract_source)
    other_rules = dv_with_many(other_rules, {"category": "contract", "received_speech_requirement": {"speaker": "demon", "action_id": "demon.c2.school-rule4"}})
    rt_push(rows, other_rules)
    rt_push(rows, c2d_reply("demon", "demon.c2.other-rules", "lecture", dv_true(), dv_fact(c2d_ref("authority_bounded"), true), "contract.other-rules", "是。还有我也须遵守的契约。", contract_source))
    var origin = c2d_question("detective.c2.ask-rule-authority", "lecture", rule4, "demon", "contract.rule-authority", "你既须遵守契约，又由契约取得封存权限，那么契约是谁立的？权限究竟从哪里来？", [], contract_source)
    origin = dv_with_many(origin, {"category": "contract", "received_speech_requirement": {"speaker": "demon", "action_id": "demon.c2.other-rules"}})
    rt_push(rows, origin)
    let bounded = dv_fact(c2d_ref("authority_bounded"), true)
    rt_push(rows, c2d_reply("demon", "demon.c2.rule-authority", "lecture", dv_true(), bounded, "contract.rule-authority", "我也受契约约束。", contract_source))
    var full = c2d_question("detective.c2.ask-contract", "lecture", dv_all([trace, rule4, sealed, bounded]), "demon", "contract.full-text", "那么请把约束你、也规定你权限来源的契约全文告诉我们。", [contract_ref], contract_source)
    full = dv_with_many(full, {"category": "contract", "received_speech_requirement": {"speaker": "demon", "action_id": "demon.c2.rule-authority"}})
    rt_push(rows, full)
    rt_push(rows, c2d_reply("demon", "demon.c2.contract-full-text", "lecture", dv_true(), dv_fact(contract_ref, c1_op_contract_text()), "contract.full-text", c1_op_contract_text(), contract_source))
    let people = c2_people()
    var p = 0
    while p < rt_count(people):
        let known_contract = dv_fact(contract_ref, c1_op_contract_text())
        rt_push(rows, c2d_row(people[p], rt_cat(people[p], ".c2.share-contract"), "living_hall", known_contract, known_contract, c1_op_contract_text(), contract_source))
        p = p + 1
    let daily = c2daily_rows()
    var d = 0
    while d < rt_count(daily):
        rt_push(rows, daily[d])
        d = d + 1
    let cooperation = c2_cooperation_rows()
    d = 0
    while d < rt_count(cooperation):
        rt_push(rows, cooperation[d])
        d = d + 1
    let intros = c2d_introductions()
    var i = 0
    while i < rt_count(intros):
        let intro = intros[i]
        let literal = dv_fact(c2d_person_ref(intro.actor, "introduction"), intro.text)
        let row = c2d_row(intro.actor, rt_cat(intro.actor, ".c2.dialogue.introduce"), "living_hall", literal, literal, intro.text, intro.source)
        rt_push(rows, dv_with(row, "opportunity", {"location": "living_hall", "participants": ["detective"], "mode": "all-present"}))
        i = i + 1
    let courses = c2d_curriculum()
    i = 0
    while i < rt_count(courses):
        let course = courses[i]
        let literal = dv_fact(c2d_ref(course.id), course.text)
        var row = c2d_row("demon", rt_cat("demon.c2.teach.", course.id), "lecture", dv_all([dv_fact(c2_access("north"), true), literal]), literal, course.text, course.source)
        row = dv_with(row, "opportunity", {"location": "lecture", "participants": c2_people(), "mode": "at-least-one-present"})
        rt_push(rows, row)
        i = i + 1
    let before = dv_fact(c2d_mark("demon", "demon.c2.teach.lesson11"), true)
    rt_push(rows, c2d_row("demon", "demon.c2.lesson11.close", "lecture", before, dv_true(), "本课到此。诸位所立之规，也请这样读。下课。", c2d_source("06_场面.story", 90, "chapter2.lesson.005")))
    let rooms = ["central_hall", "logistics", "clinic"]
    i = 0
    while i < rt_count(rooms):
        let room = rooms[i]
        let after_night = dv_true()
        rt_push(rows, c2d_question(rt_cat("detective.c2.ask.mora.", room), room, after_night, "mora", "night_patient_food", "台账有待核对的差额。你夜里取过口粮吗？用途是什么？", [c2_own("mora", "night_taken")], c2d_source("00_时间与文案.story", 87, "质询问题：取用")))
        rt_push(rows, c2d_question(rt_cat("detective.c2.ask.quer.", room), room, after_night, "quer", "night_self_food", "夜里取过口粮吗？", [c2_own("quer", "night_taken")], c2d_source("04_案件.story", 76, "夜取自粮的质询")))
        rt_push(rows, c2d_question(rt_cat("detective.c2.ask.latch.", room), room, after_night, "quer", "latch_repair", "粮仓的门闩修过吗？", [c2d_person_ref("quer", "repaired_latch")], c2d_source("00_时间与文案.story", 89, "质询问题：门闩")))
        rt_push(rows, c2d_question(rt_cat("detective.c2.ask.ledger.", room), room, after_night, "ruan", "night_ledger", "这些取用已经记了哪些，还有哪些待核对？", [c2_ref("c2.ledger", "night_recorded")], c2d_source("00_时间与文案.story", 90, "质询问题：台账")))
        rt_push(rows, c2d_question(rt_cat("detective.c2.ask.shadow.", room), room, after_night, "bertrand", "night_shadow", "你夜巡时，看见了什么？", [c2d_person_ref("bertrand", "small_shadow_seen")], c2d_source("04_案件.story", 19, "夜巡所见")))
        let mora_fact = dv_all([dv_fact(c2_own("mora", "night_taken"), true), dv_fact(c2d_person_ref("mora", "patient_food_reason"), true)])
        rt_push(rows, c2d_reply("mora", rt_cat("mora.c2.reply.patient_food.", room), room, mora_fact, mora_fact, "night_patient_food", "我为病人夜里取过口粮。取用和补记可以一起核对。", c2d_source("04_案件.story", 73, "夜取病粮：反应（次日措辞适配）")))
        let quer_fact = dv_all([dv_fact(c2_own("quer", "night_taken"), true), dv_fact(c2_own("quer", "accepted.mora_night"), true)])
        rt_push(rows, c2d_reply("quer", rt_cat("quer.c2.reply.self_food.", room), room, quer_fact, quer_fact, "night_self_food", "我夜里取过口粮，也认了急需可以自取、随后补记这条。记录可以一起核对。", c2d_source("04_案件.story", 80, "夜取自粮：反应·雀儿（次日措辞适配）")))
        let repaired = dv_fact(c2d_person_ref("quer", "repaired_latch"), true)
        rt_push(rows, c2d_reply("quer", rt_cat("quer.c2.reply.repair.", room), room, repaired, repaired, "latch_repair", "门闩松了，是我修的。", c2d_source("04_案件.story", 85, "修门闩：反应")))
        let ledger = dv_all([dv_fact(c2_ref("c2.ledger", "night_recorded"), 0), dv_at_least(c2_ref("c2.ledger", "day_recorded"), 1)])
        rt_push(rows, c2d_reply("ruan", rt_cat("ruan.c2.reply.ledger.", room), room, ledger, ledger, "night_ledger", "我看到的台账上已有白天领取记录，夜间补记这一栏还是空的。", c2d_source("04_案件.story", 91, "台账：反应")))
        let small = dv_fact(c2d_person_ref("bertrand", "small_shadow_seen"), true)
        rt_push(rows, c2d_reply("bertrand", rt_cat("bertrand.c2.reply.shadow.", room), room, small, small, "night_shadow", "身影是看见了。是谁，我没看清。", c2d_source("04_案件.story", 102, "夜巡望见的身影：反应")))
        i = i + 1
    let requested_repair = dv_fact(c2d_person_ref("margaret", "requested_latch_repair"), true)
    let marks = dv_fact(c2_ref("c2.granary", "tool_marks"), true)
    let repair_witness = c2d_row("margaret", "margaret.c2.testimony.repair", "central_hall", dv_all([requested_repair, marks]), dv_all([requested_repair, marks]), "我请雀儿修过门闩。现在能看见工具痕，谁实际动过手还得另问。", c2d_source("04_案件.story", 86, "修门闩：反应·雀儿"))
    rt_push(rows, dv_with(repair_witness, "opportunity", {"location": "central_hall", "participants": ["detective", "quer"], "mode": "all-present"}))
    let council = c2d_council_when()
    let places = ["oath_court", "central_hall"]
    i = 0
    while i < rt_count(places):
        let room = places[i]
        var weather = dv_fact(c2_ref("c2.weather", "wind"), true)
        if room == "central_hall":
            weather = dv_fact(c2_ref("c2.weather", "wind"), false)
        let when = dv_all([council, weather])
        let source = c1_source("docs/design-standard.md", 0, "第五日物资与安全公约")
        let proposals = c2_norms()
        var n = 0
        while n < rt_count(proposals):
            let norm = proposals[n]
            if dv_has(["open_plan", "seal_plan", "committee_plan"], norm.id):
                let literal = dv_fact(c2_ref(c2_norm_object(norm.id), "text"), norm.surface)
                let row = c2d_row(norm.owner, rt_cat(norm.owner, rt_cat(".c2.council.proposal.", rt_cat(room, norm.id))), room, dv_all([when, c2d_stance(norm.owner, norm.id)]), literal, norm.surface, source)
                rt_push(rows, dv_with(row, "norm_proposal", norm))
            n = n + 1
        i = i + 1
    let rescue_source = c1_source("docs/design-standard.md", 0, "实际夹道救援后的本人报告与现场照护")
    let rescue_history = dv_fact(c2_own("bertrand", "rescue_exposed"), true)
    var rescue_report = c2d_row("bertrand", "bertrand.c2.rescue.report", "living_hall", c2_can_act("bertrand"), rescue_history, "我刚进入过夹道救人。请医生检查我的情况。", rescue_source)
    rescue_report = dv_with_many(rescue_report, {"opportunity": {"location": "living_hall", "participants": ["mora"], "mode": "all-present"}, "listeners": ["mora"], "completed_action_requirement": {"action_id": "bertrand.c2.rescue.moran_from_alley"}})
    rt_push(rows, rescue_report)
    let comforts = c2d_companion_comfort_rows()
    var c = 0
    while c < rt_count(comforts):
        rt_push(rows, comforts[c])
        c = c + 1
    let rebukes = c2d_demon_rebuke_rows()
    c = 0
    while c < rt_count(rebukes):
        rt_push(rows, rebukes[c])
        c = c + 1
    let shura_rows = c2d_shura_rows()
    c = 0
    while c < rt_count(shura_rows):
        rt_push(rows, shura_rows[c])
        c = c + 1
    return rows

fn c2d_companion_comfort_rows():
    var rows = []
    let source = c1_source("docs/design-standard.md", 0, "愚蠢侦探路线：群像温厚包容")
    let after_night = dv_at_least(c2_clock(), 1440)
    let shen_text = "想不明白就先歇一歇。愿意的话，来后厨和我搭把手；饭食的事也可以一起商量。"
    var shen_row = c2d_row("shen", "shen.c2.dialogue.comfort_soup", "living_hall", after_night, dv_true(), shen_text, source)
    shen_row = dv_with_many(shen_row, {"opportunity": {"location": "living_hall", "participants": ["detective"], "mode": "all-present"}, "effects": [dv_assign(c2d_person_ref("shen", "comfort_soup"), true)], "personal_choice": {"group": "companion-comfort", "requires": after_night, "prohibits": dv_fact(c2d_person_ref("shen", "comfort_soup"), true), "promotes": ["solidarity", "safety"], "sacrifices": [], "basis": [source]}})
    rt_push(rows, shen_row)
    let quer_text = "大侦探，想不明白也别一个人硬撑。愿意就跟我搭个伴，进夹道前先把路看清楚。"
    var quer_row = c2d_row("quer", "quer.c2.dialogue.comfort_boxes", "living_hall", after_night, dv_true(), quer_text, source)
    quer_row = dv_with_many(quer_row, {"opportunity": {"location": "living_hall", "participants": ["detective"], "mode": "all-present"}, "effects": [dv_assign(c2d_person_ref("quer", "comfort_boxes"), true)], "personal_choice": {"group": "companion-comfort", "requires": after_night, "prohibits": dv_fact(c2d_person_ref("quer", "comfort_boxes"), true), "promotes": ["solidarity", "movement_freedom"], "sacrifices": [], "basis": [source]}})
    rt_push(rows, quer_row)
    let huo_text = "齿轮卡死时硬撬会崩齿。想不明白先放着；愿意帮忙的话，我们先一起看看手头能做什么。"
    var huo_row = c2d_row("huo", "huo.c2.dialogue.comfort_jack", "logistics", after_night, dv_true(), huo_text, source)
    huo_row = dv_with_many(huo_row, {"opportunity": {"location": "logistics", "participants": ["detective"], "mode": "all-present"}, "effects": [dv_assign(c2d_person_ref("huo", "comfort_jack"), true)], "personal_choice": {"group": "companion-comfort", "requires": after_night, "prohibits": dv_fact(c2d_person_ref("huo", "comfort_jack"), true), "promotes": ["solidarity", "measured_work"], "sacrifices": [], "basis": [source]}})
    rt_push(rows, huo_row)
    let ward_text = "证据还可以继续核对。对一份陈述有疑问，也不该因此否定陈述者的安全保障与口粮配给权。"
    var ward_row = c2d_row("ward", "ward.c2.dialogue.comfort_rights", "living_hall", after_night, dv_true(), ward_text, source)
    ward_row = dv_with_many(ward_row, {"opportunity": {"location": "living_hall", "participants": ["detective"], "mode": "all-present"}, "effects": [dv_assign(c2d_person_ref("ward", "comfort_rights"), true)], "personal_choice": {"group": "companion-comfort", "requires": after_night, "prohibits": dv_fact(c2d_person_ref("ward", "comfort_rights"), true), "promotes": ["solidarity", "ward_authority"], "sacrifices": [], "basis": [source]}})
    rt_push(rows, ward_row)
    let mora_text = "需要歇一歇就坐下。想不明白不是罪过；你若有不舒服，可以告诉我。"
    var mora_row = c2d_row("mora", "mora.c2.dialogue.comfort_care", "clinic", after_night, dv_true(), mora_text, source)
    mora_row = dv_with_many(mora_row, {"opportunity": {"location": "clinic", "participants": ["detective"], "mode": "all-present"}, "effects": [dv_assign(c2d_person_ref("mora", "comfort_care"), true)], "personal_choice": {"group": "companion-comfort", "requires": after_night, "prohibits": dv_fact(c2d_person_ref("mora", "comfort_care"), true), "promotes": ["patient_priority", "solidarity"], "sacrifices": [], "basis": [source]}})
    rt_push(rows, mora_row)
    return rows

fn c2d_demon_rebuke_rows():
    var rows = []
    let source = c1_source("docs/design-standard.md", 0, "非常规手段：驱使恶魔后的同伴严厉谴责")
    let after_demon = dv_fact(c2_ref("c2.demon", "intervened"), true)
    let mora_text = "我反对把同伴的生命当作与恶魔谈判的筹码。它是否介入、介入后发生了什么，都要逐项核对，不能把托付生命当作理所当然。"
    var mora_row = c2d_row("mora", "mora.c2.dialogue.demon_rebuke", "clinic", after_demon, dv_true(), mora_text, source)
    mora_row = dv_with_many(mora_row, {"opportunity": {"location": "clinic", "participants": ["detective"], "mode": "all-present"}, "effects": [dv_assign(c2d_person_ref("mora", "demon_rebuked"), true)]})
    rt_push(rows, mora_row)
    let elena_text = "你在走钢丝，侦探。我不信任向深渊代管者求助的选择。作出承诺前，你想清楚自己能担下什么了吗？"
    var elena_row = c2d_row("elena", "elena.c2.dialogue.demon_rebuke", "quiet_room", after_demon, dv_true(), elena_text, source)
    elena_row = dv_with_many(elena_row, {"opportunity": {"location": "quiet_room", "participants": ["detective"], "mode": "all-present"}, "effects": [dv_assign(c2d_person_ref("elena", "demon_rebuked"), true)]})
    rt_push(rows, elena_row)
    let ruan_text = "我反对这种引狼入室的劫争。借它的力量之后，条件、代价与能够制衡它的手段，你准备怎样逐项交代？"
    var ruan_row = c2d_row("ruan", "ruan.c2.dialogue.demon_rebuke", "central_hall", after_demon, dv_true(), ruan_text, source)
    ruan_row = dv_with_many(ruan_row, {"opportunity": {"location": "central_hall", "participants": ["detective"], "mode": "all-present"}, "effects": [dv_assign(c2d_person_ref("ruan", "demon_rebuked"), true)]})
    rt_push(rows, ruan_row)
    return rows

fn c2d_demon_trial_dialogues():
    var rows = []
    let source = c1_source("docs/design-standard.md", 0, "修罗侦探路线：恶魔真话背刺与大公审")
    // A received source/parse pair proves this quotation was heard. It does not
    // establish why the later choices, exposure or casualties occurred.
    let betrayal_pre = c1_any(dv_fact(c2_own("moran", "dead"), true), dv_fact(c2_own("bertrand", "stone_stupor"), true))
    let demon_text = rt_cat("我实际听到侦探对莫兰说：『", rt_cat(c2_color_encouragement_text(), "』。这句话与后来的选择、执行和伤亡，仍须逐项核对。"))
    var demon_row = c2d_row("demon", "demon.c2.truth_betrayal", "central_hall", betrayal_pre, dv_true(), demon_text, source)
    demon_row = dv_with_many(demon_row, {"received_speech_requirement": {"speaker": "detective", "action_id": "detective.c2.color.encourage"}, "opportunity": {"location": "central_hall", "participants": ["ruan", "ward", "mora"], "mode": "at-least-one-present"}, "effects": [dv_assign(c2d_ref("demon_truth_betrayal"), true)]})
    rt_push(rows, demon_row)
    let ruan_trial_text = "先核对侦探实际说过的话，再核对莫兰自己的选择、实际动线和伤情。不能仅凭言语与伤亡的先后，就把借刀杀人的推断当作定案事实。"
    let trial_pre = dv_true()
    var ruan_row = c2d_row("ruan", "ruan.c2.trial.indict", "central_hall", trial_pre, dv_true(), ruan_trial_text, source)
    ruan_row = dv_with_many(ruan_row, {"received_speech_requirement": {"speaker": "demon", "action_id": "demon.c2.truth_betrayal"}, "effects": [dv_assign(c2d_person_ref("ruan", "trial_indicted"), true)]})
    rt_push(rows, ruan_row)
    let moran_evidence = dv_fact(c2_own("moran", "dead"), true)
    let mora_trial_text = "我在现场确认莫兰已经死亡。死亡原因、言语是否影响了他的选择、又怎样造成死亡，还须另有证据。"
    var mora_trial = c2d_row("mora", "mora.c2.trial.witness", "central_hall", dv_true(), moran_evidence, mora_trial_text, source)
    mora_trial = dv_with_many(mora_trial, {"received_speech_requirement": {"speaker": "ruan", "action_id": "ruan.c2.trial.indict"}, "completed_action_requirement": {"action_id": "mora.c2.examine.moran"}, "effects": [dv_assign(c2d_person_ref("mora", "trial_witnessed"), true)]})
    rt_push(rows, mora_trial)
    let ward_trial_text = "我听到了现场死亡的证言。言论原始记录、本人选择、实际动线与死因仍须分别核对；这些证言尚不足以认定侦探有罪，不能据此直接监禁或剥夺配给。"
    var ward_row = c2d_row("ward", "ward.c2.trial.verdict", "central_hall", dv_true(), moran_evidence, ward_trial_text, source)
    ward_row = dv_with(ward_row, "received_speech_requirement", {"speaker": "mora", "action_id": "mora.c2.trial.witness"})
    rt_push(rows, ward_row)
    return rows

fn c2d_demon_incite_guard():
    var rows = []
    let source = c1_source("docs/design-standard.md", 0, "恶魔铜口挑拨看守擅离职守")
    let imprisoned = dv_fact(c2_ref("c2.trial", "detective_imprisoned"), true)
    let demon_incite_text = "守门人何必徒劳执锁？是否继续看守，是否解除门锁，请你自己作出选择，也自己承担这个选择的后果。"
    var demon_incite = c2d_row("demon", "demon.c2.intercom.incite_guard", "living_hall", imprisoned, dv_true(), demon_incite_text, source)
    rt_push(rows, demon_incite)
    return rows

fn c2d_shura_rows():
    var rows = []
    let source = c1_source("docs/design-standard.md", 0, "修罗侦探路线：恶魔背刺、公审与监禁挑拨")
    let trials = c2d_demon_trial_dialogues()
    var t = 0
    while t < rt_count(trials):
        rt_push(rows, trials[t])
        t = t + 1
    let incites = c2d_demon_incite_guard()
    t = 0
    while t < rt_count(incites):
        rt_push(rows, incites[t])
        t = t + 1
    let imprisoned = dv_fact(c2_ref("c2.trial", "detective_imprisoned"), true)
    let shen_intercom_text = "沈大哥，后厨的火若是断了，断粮的不仅是我。你愿意为了这场审判，听任一个人挨饿吗？"
    var shen_intercom = c2d_row("detective", "detective.c2.intercom.shen", "living_hall", imprisoned, dv_true(), shen_intercom_text, source)
    rt_push(rows, shen_intercom)
    let lucian_intercom_text = "高贵的骑士阁下，你愿意听我为自己辩解吗？被关押的人也应该有说话的机会吧？"
    var lucian_intercom = c2d_row("detective", "detective.c2.intercom.lucian", "living_hall", imprisoned, dv_true(), lucian_intercom_text, source)
    rt_push(rows, lucian_intercom)
    let ward_intercom_text = "弗雷德里克，被告答辩与回避程序是否完备，卷宗里的言论、动线与死因又是怎样核对的？请你逐项说明，也听取我的答辩。"
    var ward_intercom = c2d_row("detective", "detective.c2.intercom.ward", "living_hall", imprisoned, dv_true(), ward_intercom_text, source)
    rt_push(rows, ward_intercom)
    return rows

fn c2d_council_when():
    return dv_all([c2_window(5, 450, 570), dv_fact(c2_ref("c2.weather", "daylight"), true)])

// The actor must actually receive a proposal before treating council as an opportunity.
fn c2d_known_council_proposal():
    let norms = c2_norms()
    var known = dv_not(dv_true())
    var i = 0
    while i < rt_count(norms):
        let norm = norms[i]
        if dv_has(["open_plan", "seal_plan", "committee_plan"], norm.id):
            known = c1_any(known, dv_fact(c2_ref(c2_norm_object(norm.id), "text"), norm.surface))
        i = i + 1
    return known

fn c2d_stance(actor, norm):
    let accepted = dv_fact(c2_own(actor, rt_cat("accepted.", norm)), true)
    let norms = c2_norms()
    var i = 0
    while i < rt_count(norms):
        if norms[i].id == norm and norms[i].owner == actor:
            return c1_any(accepted, dv_fact(c2_ref(c2_norm_object(norm), "proposed"), true))
        i = i + 1
    return accepted

axiom c2d_row_law(row):
    var effects = dv_single(dv_assign(c2d_mark(row.actor, row.id), true))
    let extra = dv_find(row, "effects", [])
    var i = 0
    while i < rt_count(extra):
        rt_push(effects, extra[i])
        i = i + 1
    return dv_axiom("c2d_row_law", 1, dv_all([c2_at(row.actor, row.room), row.when]), effects)

axiom c2d_spoke_law(actor, method, room):
    return dv_axiom("c2d_spoke_law", 1, c2_at(actor, room), dv_single(dv_assign(c2d_mark(actor, method), true)))

axiom c2d_read_scope_law():
    return dv_axiom("c2d_read_scope_law", 1, dv_fact(c2d_ref("indoor_rule"), "入夜之后，诸位留于室内。"), dv_single(dv_assign(c2d_person_ref("detective", "scope_undefined"), true)))

fn c2d_action(row):
    var prerequisites = [c2_at(row.actor, row.room), row.when, row.literal]
    if not dv_find(row, "repeatable", false):
        rt_push(prerequisites, dv_fact(c2d_mark(row.actor, row.id), false))
    let known = dv_all(prerequisites)
    var speech = dv_with_many(c1_speech(row.literal, row.source, "chapter2-owned-statement"), {"surface": row.text, "channel": "local"})
    if dv_has_key(row, "request"):
        speech = dv_with_many(speech, {"request": row.request, "utterance_type": "question"})
    var grants = dv_single(c2d_mark(row.actor, row.id))
    let effects = dv_find(row, "effects", [])
    var e = 0
    while e < rt_count(effects):
        rt_push(grants, effects[e].ref)
        e = e + 1
    // Actor-only observations after applied Complete; never speech propagation
    // or a claim that an environment effect has already happened in prediction.
    let observation_grants = dv_find(row, "observation_grants", [])
    e = 0
    while e < rt_count(observation_grants):
        if not dv_has(grants, observation_grants[e]):
            rt_push(grants, observation_grants[e])
        e = e + 1
    var raw_listeners = dv_find(row, "listeners", c2d_people())
    if not dv_has_key(row, "listeners") and not dv_has_key(row, "norm_proposal"):
        if dv_has_key(row, "opportunity"):
            let parts = dv_find(row.opportunity, "participants", [])
            if 0 < rt_count(parts):
                raw_listeners = dvp_merge_refs(parts, ["detective"])
        else:
            if dv_has_key(row, "request"):
                raw_listeners = [row.request.target, "detective"]
            else:
                if dv_has_key(row, "response_topic"):
                    raw_listeners = ["detective"]
    var listeners = []
    var l = 0
    while l < rt_count(raw_listeners):
        if raw_listeners[l] != row.actor:
            rt_push(listeners, raw_listeners[l])
        l = l + 1
    var action = dv_with_many(c2_action(row.id, "talk", known, dv_all([c2_at(row.actor, row.room), row.when]), row.id, grants, row.text, row.source), {"speech": speech, "listeners": listeners, "predict_law": row.id, "owner": row.actor, "purpose_refs": dv_find(row, "purpose_refs", []), "required_room": row.room})
    if dv_has_key(row, "norm_proposal"):
        action = dv_with(action, "speech", dv_with_many(speech, {"utterance_type": "proposal", "norm_proposal": row.norm_proposal}))
    if dv_has_key(row, "personal_choice"):
        action = dv_with(action, "personal_choice", row.personal_choice)
    let metadata = ["public_grants", "public_observers", "work_decision", "work_reply", "work_clearance", "work_refusal", "concern_question", "repeatable", "manual_only", "safety_warning", "guard_decision", "advice_decision", "owned_decision", "owner_utility", "partner_decision", "completed_action_requirement"]
    var metadata_index = 0
    while metadata_index < rt_count(metadata):
        if dv_has_key(row, metadata[metadata_index]):
            action = dv_with(action, metadata[metadata_index], dv_get(row, metadata[metadata_index]))
        metadata_index = metadata_index + 1
    if dv_has_key(row, "manipulation"):
        action = dv_with(action, "speech", dv_with(action.speech, "manipulation", row.manipulation))
    if dv_has_key(row, "advice"):
        action = dv_with(action, "speech", dv_with(action.speech, "advice", row.advice))
    if row.actor == "demon":
        action = c1_authorized_speech(action)
    if dv_has_key(row, "response_topic"):
        action = dv_with_many(action, {"response_topic": row.response_topic, "requires_actual_request": true})
    if dv_has_key(row, "opportunity"):
        action = dv_with(action, "opportunity_requirement", row.opportunity)
    if dv_has_key(row, "received_speech_requirement"):
        action = dv_with(action, "received_speech_requirement", row.received_speech_requirement)
    if dv_find(row, "category", "") == "case":
        action = dv_with_many(action, {"case_method": true, "case_base_when": known})
    return action

axiom c2d_start_watch_law():
    return dv_axiom("c2d_start_watch_law", 1, dv_all([c1_at("bertrand", "logistics"), c2_any_night(), c2_alive("bertrand")]), dv_single(dv_assign(c2d_person_ref("bertrand", "watching"), true)))

axiom c2d_small_shadow_law(person):
    return dv_axiom("c2d_small_shadow_law", 1, dv_all([c1_at("bertrand", "logistics"), c2_any_night(), dv_fact(c2d_person_ref("bertrand", "watching"), true), c2_alive("bertrand"), dv_fact(c2d_person_ref("bertrand", "small_shadow_seen"), false), c1_at(person, "logistics"), c2_alive(person)]), dv_single(dv_assign(c2d_person_ref("bertrand", "small_shadow_seen"), true)))

fn c2d_watch_actions(actor):
    if actor != "bertrand":
        return []
    let source = c2d_source("04_案件.story", 25, "小巧身影的有限观察")
    let pre = dv_all([c2_at(actor, "logistics"), c2_any_night(), c2_alive(actor)])
    let watch = c2_action("bertrand.c2.watch.start", "help", pre, pre, "bertrand.c2.watch.start", dv_single(c2d_person_ref(actor, "watching")), "提着灯，守在后勤院。", source)
    let inspect = c2_action("bertrand.c2.watch.observe", "inspect", dv_all([pre, dv_fact(c2d_person_ref(actor, "watching"), true)]), pre, "", dv_single(c2d_person_ref(actor, "small_shadow_seen")), "留意夜里的身影。", source)
    return [dv_with(watch, "predict_law", "bertrand.c2.watch.start"), dv_with(inspect, "repeatable", true)]

axiom c2d_repair_record_law(actor):
    let original = c2_repair_latch_law(actor)
    return dv_axiom("c2d_repair_record_law", 1, original.premise, dv_append(original.effects, dv_assign(c2d_person_ref(actor, "repaired_latch"), true)))

axiom c2d_request_repair_record_law():
    let original = c2_latch_request_law("margaret", "quer")
    return dv_axiom("c2d_request_repair_record_law", 1, original.premise, dv_append(original.effects, dv_assign(c2d_person_ref("margaret", "requested_latch_repair"), true)))

axiom c2d_patient_take_record_law():
    let original = c2_night_take_law("mora", true)
    return dv_axiom("c2d_patient_take_record_law", 1, original.premise, dv_append(original.effects, dv_assign(c2d_person_ref("mora", "patient_food_reason"), true)))

fn c2d_objects():
    var objects = [c2_object("c2.dialogue", "lecture", {"indoor_rule": dv_field("入夜之后，诸位留于室内。"), "indoor_definition_given": dv_field(false), "contract_full_text": dv_field(c1_op_contract_text()), "school_rule4": dv_field("我所立之规，皆张贴于此。"), "seal_authority": dv_field("契约"), "authority_bounded": dv_field(true), "demon_truth_betrayal": dv_field(false)})]
    let courses = c2d_curriculum()
    var i = 0
    while i < rt_count(courses):
        objects = dvs_replace(objects, 0, dv_with(objects[0], "facets", dv_with(objects[0].facets, "state", dv_with(objects[0].facets.state, courses[i].id, dv_field(courses[i].text)))))
        i = i + 1
    let people = c2d_people()
    let rows = c2d_rows()
    i = 0
    while i < rt_count(people):
        var fields = {"repaired_latch": dv_field(false), "requested_latch_repair": dv_field(false), "patient_food_reason": dv_field(false), "watching": dv_field(false), "small_shadow_seen": dv_field(false), "scope_undefined": dv_unknown()}
        var j = 0
        while j < rt_count(rows):
            if rows[j].actor == people[i]:
                fields = dv_with(fields, rt_cat("said.", rows[j].id), dv_field(false))
            j = j + 1
        let intros = c2d_introductions()
        j = 0
        while j < rt_count(intros):
            if intros[j].actor == people[i]:
                fields = dv_with(fields, "introduction", dv_field(intros[j].text))
            j = j + 1
        rt_push(objects, c2_object(rt_cat("c2.dialogue.person.", people[i]), "", fields))
        i = i + 1
    return objects

fn c2d_case_gate(mind):
    let refs = [c2_ref("c2.ledger", "counted"), c2_ref("c2.ledger", "reserve_received"), c2_ref("c2.counter", "remaining"), c2_ref("c2.ledger", "day_recorded"), c2_ref("c2.ledger", "night_recorded"), c2_ref("c2.ledger", "pending_registered")]
    var values = []
    var premises = []
    var i = 0
    while i < rt_count(refs):
        let cell = dv_read(mind, refs[i])
        if not dv_uncontested(cell):
            return dv_not(dv_true())
        rt_push(values, cell.value)
        rt_push(premises, dv_fact(refs[i], cell.value))
        i = i + 1
    if values[0] > 0 and values[2] + values[3] + values[4] + values[5] < values[0] + values[1]:
        return dv_all(premises)
    return dv_not(dv_true())

// Only authored goal syntax depends on id. These caches never read an actor.
fn c2d_goal_head_build(id, tasks):
    var goals = []
    var t = 0
    while t < rt_count(tasks):
        if tasks[t].actor == id:
            rt_push(goals, dv_with_many(c2_goal(dv_fact(c2daily_ref(tasks[t].field), true), tasks[t].when, [c2_approved("real-daily-contact-action")]), {"navigation_room": tasks[t].room, "navigation_methods": [tasks[t].id]}))
        t = t + 1
    rt_push(goals, dv_with_many(c2_observation_goal(c2daily_ref("meal_prepared"), c2_window(2, 690, 810), [c2_approved("look-for-real-lunch")], 2130), {"navigation_room": "living_hall", "navigation_methods": [rt_cat(id, ".c2.inspect.c2.daily")]}))
    if id == "ward":
        rt_push(goals, dv_with_many(c2_observation_goal(c2daily_ref("draft_notes"), c2daily_notes_window(), [c2_approved("inspect-current-draft-before-owned-norm-discussion")], 2250), {"navigation_room": "central_hall", "navigation_methods": ["ward.c2.daily.inspect-central"]}))
    if id == "shen":
        rt_push(goals, dv_with_many(c2_goal(dv_fact(c2daily_ref("meal_cooked"), true), c2_window(2, 690, 810), [c2_approved("cook-real-lunch")]), {"navigation_room": "logistics", "navigation_methods": ["shen.c2.daily.cook-sixteen"]}))
        rt_push(goals, dv_with_many(c2_goal(dv_fact(c2daily_ref("meal_prepared"), true), dv_all([c2_window(2, 690, 810), dv_fact(c2daily_ref("meal_cooked"), true)]), [c2_approved("deliver-real-lunch")]), {"navigation_room": "living_hall", "navigation_methods": ["shen.c2.daily.deliver-sixteen"]}))
    if id == "ruan":
        rt_push(goals, dv_with_many(c2_goal(dv_fact(c2daily_ref("draft_notes"), true), c2daily_notes_window(), [c2_approved("draft-notes-through-real-action")]), {"navigation_room": "central_hall", "navigation_methods": ["ruan.c2.draft-notes"]}))
    return goals

fn c2d_goal_head(id, tasks):
    let key = ["c2d-goal-static-head-v1", id]
    let cached = rt_memo_get(tasks, key)
    if cached[0]:
        return cached[1]
    return rt_memo_put(tasks, key, c2d_goal_head_build(id, tasks))

fn c2d_goal_tail_build(id):
    var goals = []
    var i = 0
    let study = dv_all([dv_fact(c2_access("north"), true), c2_window(2, 600, 690)])
    rt_push(goals, dv_with_many(c2_goal(c2_at(id, "lecture"), study, [c2d_source("06_场面.story", 79, "请到讲堂")]), {"navigation_room": "lecture", "maintain_presence": true}))
    if id == "bertrand":
        rt_push(goals, dv_with(c2_goal(dv_fact(c2d_person_ref(id, "watching"), true), c2_any_night(), [c1_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/14_贝尔特朗.story", 30, "夜里巡夜：护住同伴")]), "navigation_room", "logistics"))
        rt_push(goals, dv_with(c2_observation_goal(c2d_person_ref(id, "small_shadow_seen"), dv_all([c2_any_night(), dv_fact(c2d_person_ref(id, "watching"), true)]), [c2d_source("04_案件.story", 25, "有限身影观察")], 0), "navigation_room", "logistics"))
    if id == "detective":
        let ledger_fields = ["counted", "reserve_received", "day_recorded", "night_recorded", "pending_registered"]
        rt_push(goals, c2_observation_goal(c2_ref("c2.counter", "remaining"), c2_at(id, "logistics"), [c1_source("docs/design-standard.md", 0, "实物清点与台账对照")], 0))
        i = 0
        while i < rt_count(ledger_fields):
            rt_push(goals, c2_observation_goal(c2_ref("c2.ledger", ledger_fields[i]), c2_at(id, "logistics"), [c2d_source("04_案件.story", 10, "从读到账目再判断是否有缺口")], 0))
            i = i + 1
    if id == "quer":
        rt_push(goals, dv_with(c2_goal(dv_fact(c2_ref("c2.granary", "latch_loose"), false), dv_all([dv_fact(c2_ref("c2.granary", "latch_loose"), true), c2_work_accepted(id, "quer.c2.granary.precision")]), [c2d_source("10_执行.story", 17, "RepairLatch")]), "navigation_room", "logistics"))
    let opportunity = c2d_known_council_proposal()
    let venues = [{"room": "oath_court", "wind": true}, {"room": "central_hall", "wind": false}]
    i = 0
    while i < rt_count(venues):
        let venue = venues[i]
        let when = dv_all([c2d_council_when(), c2_alive(id), opportunity, dv_fact(c2_ref("c2.weather", "wind"), venue.wind), dv_fact(c2daily_ref(rt_cat("signed.", id)), false)])
        rt_push(goals, dv_with(c2_goal(c2_at(id, venue.room), when, [c2d_source("06_场面.story", 340, "章二议事机会")]), "navigation_room", venue.room))
        // Ballot effects increment the actually inspected tally, never an assumed zero.
        let tally = ["votes.open_plan", "votes.seal_plan", "votes.committee_plan"]
        var n = 0
        while n < rt_count(tally):
            rt_push(goals, dv_with(c2_observation_goal(c2daily_ref(tally[n]), when, [c2_approved("actual-council-tally-before-personal-ballot")], 6210), "navigation_room", venue.room))
            n = n + 1
        i = i + 1
    return goals

fn c2d_goal_tail(id):
    let key = ["c2d-goal-static-tail-v1", id]
    let cached = rt_memo_get([], key)
    if cached[0]:
        return cached[1]
    return rt_memo_put([], key, c2d_goal_tail_build(id))

// All live qualification stays in c2d_goals. Only the resulting declaration
// is memoized by its complete row, owner and already computed condition.
fn c2d_row_goal(row, id, when):
    let key = ["c2d-row-goal-declaration-v1", id, when]
    let cached = rt_memo_get(row, key)
    if cached[0]:
        return cached[1]
    return rt_memo_put(row, key, c1n_index_goal_window({"kind": "communicate", "scope": "personal", "method_id": row.id, "available_when": when, "basis": [row.source], "requires_argument": false, "navigation_room": row.room}))

// These goals ask for local perception. The source receipt does not reveal
// a patient's location or condition; only a known location guides navigation.
fn c2d_trial_evidence_goals(actor):
    var goals = []
    var patients = []
    if actor.id == "mora" and c2_received_requirement(actor, {"speaker": "ruan", "action_id": "ruan.c2.trial.indict"}):
        patients = ["moran"]
    if actor.id == "demon" and c2_received_requirement(actor, {"speaker": "detective", "action_id": "detective.c2.color.encourage"}):
        patients = ["moran", "bertrand"]
    let source = c1_source("docs/design-standard.md", 0, "修罗侦探路线：实际伤情核对")
    var i = 0
    while i < rt_count(patients):
        let patient = patients[i]
        var field = "dead"
        if patient == "bertrand":
            field = "stone_stupor"
        var goal = c2_observation_goal(c2_own(patient, field), dv_at_least(c2_clock(), 6120), [source], 6120)
        let place = dv_read(actor.mind, c2_position_ref(patient))
        if dv_uncontested(place) and dv_has(c2_rooms(), place.value):
            goal = dv_with_many(goal, {"navigation_room": place.value, "navigation_methods": [rt_cat(actor.id, rt_cat(".c2.examine.", patient))]})
        rt_push(goals, goal)
        i = i + 1
    return goals

fn c2d_goals(actor):
    var goals = []
    let rows = c2d_rows()
    let tasks = c2daily_tasks()
    goals = dv_clone(c2d_goal_head(actor.id, tasks))
    // Invocation-local reuse: actor/mind remain unchanged throughout this loop.
    // Evaluate lazily at the original first use so unrelated errors keep order.
    var concerned_ready = false
    var concerned = false
    var notice_ready = false
    var notice = false
    var case_ready = false
    var case_gate = false
    var i = 0
    while i < rt_count(rows):
        let row = rows[i]
        if row.actor == actor.id and (not dv_find(row, "manual_only", false) or (dv_has_key(row, "manipulation") and dv_find(actor.policy, "allow_manipulation_candidates", false))):
            var when = dv_all([row.when, row.literal])
            if not dv_find(row, "repeatable", false):
                when = dv_all([when, dv_fact(c2d_mark(actor.id, row.id), false)])
            if dv_has_key(row, "owned_decision"):
                let candidate = dvp_find_action(actor.actions, row.id)
                if candidate == false or not dvp_owned_decision_ready(actor, candidate, actor.mind):
                    when = dv_not(dv_true())
            if dv_has_key(row, "partner_decision"):
                let candidate = dvp_find_action(actor.actions, row.id)
                if candidate == false or not dvp_personal_ready(actor.mind, candidate.personal_choice):
                    when = dv_not(dv_true())
            if dv_find(row, "work_refusal", false) or dv_find(row, "concern_question", false):
                if not concerned_ready:
                    concerned = c2_quer_concerned(actor)
                    concerned_ready = true
                if not concerned:
                    when = dv_not(dv_true())
            if dv_find(row, "safety_warning", false) or dv_find(row, "guard_decision", false):
                if not notice_ready:
                    notice = c2_owned_safety_notice(actor)
                    notice_ready = true
                if not notice:
                    when = dv_not(dv_true())
            if dv_find(row, "category", "") == "case":
                if not case_ready:
                    case_gate = c2d_case_gate(actor.mind)
                    case_ready = true
                when = dv_all([when, case_gate])
            if dv_has_key(row, "received_speech_requirement"):
                if not c2_received_requirement(actor, row.received_speech_requirement):
                    when = dv_not(dv_true())
            if dv_has_key(row, "completed_action_requirement"):
                if not dv_has(dv_find(actor, "completed_actions", []), row.completed_action_requirement.action_id):
                    when = dv_not(dv_true())
            if dv_has_key(row, "response_topic"):
                if rt_count(dvs_pending_request(actor, row)) == 0:
                    when = dv_not(dv_true())
            if dv_has_key(row, "advice_decision"):
                let candidate = dvp_find_action(actor.actions, row.id)
                if candidate == false or not dvs_advice_decision_ready(actor, candidate, actor.mind):
                    when = dv_not(dv_true())
            if dv_has_key(row, "opportunity"):
                let opp = row.opportunity
                var opp_present = true
                if opp.mode == "all-present":
                    var p = 0
                    while p < rt_count(opp.participants):
                        if opp.participants[p] != actor.id and dv_truth(actor.mind, c2_at(opp.participants[p], opp.location)) != "true":
                            opp_present = false
                        p = p + 1
                else:
                    if opp.mode == "at-least-one-present":
                        var p = 0
                        var any_present = false
                        while p < rt_count(opp.participants):
                            if opp.participants[p] == actor.id or dv_truth(actor.mind, c2_at(opp.participants[p], opp.location)) == "true":
                                any_present = true
                            p = p + 1
                        if not any_present:
                            opp_present = false
                    else:
                        if opp.mode == "none-present":
                            var p = 0
                            while p < rt_count(opp.participants):
                                if opp.participants[p] != actor.id and dv_truth(actor.mind, c2_at(opp.participants[p], opp.location)) == "true":
                                    opp_present = false
                                p = p + 1
                if not opp_present:
                    when = dv_not(dv_true())
            rt_push(goals, c2d_row_goal(row, actor.id, when))
        i = i + 1
    // Tail is first requested only after the original dynamic row loop.
    let tail = dv_clone(c2d_goal_tail(actor.id))
    i = 0
    while i < rt_count(tail):
        rt_push(goals, tail[i])
        i = i + 1
    let evidence_goals = c2d_trial_evidence_goals(actor)
    i = 0
    while i < rt_count(evidence_goals):
        rt_push(goals, evidence_goals[i])
        i = i + 1
    return goals

fn c2d_refresh_actor_goals(actor):
    return c2d_refresh_goals_from(c2_refresh_content_actions(actor))

fn c2d_refresh_goals_from(actor):
    let goals = c2d_goals(actor)
    var policy = dv_with(actor.policy, "chapter2_dialogue_goals", goals)
    var combined = c2_personal_goals(actor)
    var i = 0
    // Actual self-location is the arrival receipt; content installation is not arrival.
    if actor.id != "demon" and dv_truth(actor.mind, c2_at(actor.id, "living_hall")) == "true":
        policy = dv_with(policy, "chapter1_carried_goals", [])
    let carried = dv_find(policy, "chapter1_carried_goals", [])
    if actor.id == "demon" or dv_truth(actor.mind, c2_at(actor.id, "living_hall")) != "true":
        while i < rt_count(carried):
            rt_push(combined, carried[i])
            i = i + 1
    i = 0
    while i < rt_count(goals):
        rt_push(combined, goals[i])
        i = i + 1
    let original_actions = actor.actions
    var actions = []
    var case_ready = false
    var case_gate = false
    i = 0
    while i < rt_count(original_actions):
        var action = original_actions[i]
        if dv_find(action, "case_method", false):
            let base_when = action.case_base_when
            if not case_ready:
                case_gate = c2d_case_gate(actor.mind)
                case_ready = true
            action = dv_with(action, "precondition", dv_all([base_when, case_gate]))
        rt_push(actions, action)
        i = i + 1
    let view = dv_with_many(actor, {"policy": dv_with(policy, "goals", combined), "actions": actions})
    return dv_with(view, "policy", dv_with(view.policy, "goals", c2_navigation_goals(view, combined)))

fn c2d_install_scene(scene):
    if dv_find(scene, "chapter2_dialogue_installed", false):
        return scene
    var physical = scene.physical
    var bindings = dv_clone(scene.bindings)
    let objects = c2d_objects()
    var i = 0
    while i < rt_count(objects):
        physical = c2_add_new(physical, objects[i])
        i = i + 1
    let rows = c2d_rows()
    i = 0
    while i < rt_count(rows):
        physical = dv_adopt(physical, c1_method(rows[i].id, c2d_row_law(rows[i])), "enforce", 1, rows[i].source)
        i = i + 1
    physical = dv_adopt(physical, c1_method("bertrand.c2.watch.start", c2d_start_watch_law()), "enforce", 1, c2d_source("04_案件.story", 25, "有限巡夜"))
    var processes = dv_clone(dv_find(scene, "world_processes", []))
    let small_people = ["quer", "su", "elena"]
    i = 0
    while i < rt_count(small_people):
        let id = rt_cat("c2.dialogue.shadow.", small_people[i])
        let source = c2d_source("04_案件.story", 25, "瘦小身影：不据此辨人")
        physical = dv_adopt(physical, c1_method(id, c2d_small_shadow_law(small_people[i])), "enforce", 1, source)
        rt_push(processes, {"id": id, "law": id, "basis": [source]})
        i = i + 1
    let repair_source = c2d_source("10_执行.story", 17, "真实修理的本人记录")
    physical = dv_adopt(physical, c1_method("quer.c2.dialogue.record-repair", c2d_repair_record_law("quer")), "enforce", 1, repair_source)
    physical = dv_adopt(physical, c1_method("huo.c2.dialogue.record-repair", c2d_repair_record_law("huo")), "enforce", 1, repair_source)
    physical = dv_adopt(physical, c1_method("margaret.c2.dialogue.record-request", c2d_request_repair_record_law()), "enforce", 1, c2d_source("04_案件.story", 86, "玛格丽特的请托"))
    physical = dv_adopt(physical, c1_method("mora.c2.dialogue.record-patient-take", c2d_patient_take_record_law()), "enforce", 1, c2d_source("10_执行.story", 7, "NightTakeSick：本人行动理由"))
    var actors = []
    i = 0
    while i < rt_count(scene.actors):
        var actor = scene.actors[i]
        var mind = actor.mind
        var j = 0
        while j < rt_count(objects):
            mind = c2_add_new(mind, c1_local_object(objects[j].id))
            if dv_local(bindings, objects[j].id, actor.id) == "":
                rt_push(bindings, dv_binding(objects[j].id, objects[j].id, actor.id))
            j = j + 1
        // Only new protocol/identity self fields are initialized; all inherited bodies stay untouched.
        let own_fields = dv_get(dv_get(dv_find(physical, "objects", []), rt_cat("c2.dialogue.person.", actor.id)), "facets")
        let self_fields = own_fields.state
        j = 0
        while j < rt_count(self_fields):
            let field = self_fields[j]
            if field[0] != "small_shadow_seen" and field[0] != "scope_undefined":
                if not dv_read(mind, c2d_person_ref(actor.id, field[0])).known:
                    mind = dv_store(mind, c2d_person_ref(actor.id, field[0]), field[1])
            j = j + 1
        if actor.id == "demon":
            let curriculum_fields = objects[0].facets.state
            j = 0
            while j < rt_count(curriculum_fields):
                mind = dv_store(mind, c2d_ref(curriculum_fields[j][0]), curriculum_fields[j][1])
                j = j + 1
        var actions = dv_clone(actor.actions)
        j = 0
        while j < rt_count(rows):
            if rows[j].actor == actor.id:
                rt_push(actions, c2d_action(rows[j]))
                mind = dv_adopt(mind, c1_method(rows[j].id, c2d_row_law(rows[j])), "predict", 1, rows[j].source)
            j = j + 1
        let watch = c2d_watch_actions(actor.id)
        j = 0
        while j < rt_count(watch):
            rt_push(actions, watch[j])
            j = j + 1
        if actor.id == "demon":
            let examinations = c2_casualty_actions("demon")
            j = 0
            while j < rt_count(examinations):
                rt_push(actions, examinations[j])
                j = j + 1
        if actor.id == "bertrand":
            mind = dv_adopt(mind, c1_method("bertrand.c2.watch.start", c2d_start_watch_law()), "predict", 1, c2d_source("04_案件.story", 25, "本人巡夜选择"))
        j = 0
        while j < rt_count(actions):
            var action = actions[j]
            if actor.id == "quer" or actor.id == "huo":
                if action.id == rt_cat(actor.id, ".c2.repair.latch"):
                    let law = rt_cat(actor.id, ".c2.dialogue.record-repair")
                    action = dv_with_many(action, {"law": law, "predict_law": law, "grants": dv_append(action.grants, c2d_person_ref(actor.id, "repaired_latch"))})
                    mind = dv_adopt(mind, c1_method(law, c2d_repair_record_law(actor.id)), "predict", 1, repair_source)
            if action.id == "margaret.c2.request.repair_latch":
                let law = "margaret.c2.dialogue.record-request"
                action = dv_with_many(action, {"law": law, "predict_law": law, "grants": dv_append(action.grants, c2d_person_ref(actor.id, "requested_latch_repair"))})
                mind = dv_adopt(mind, c1_method(law, c2d_request_repair_record_law()), "predict", 1, c2d_source("04_案件.story", 86, "本人请求记录"))
            if action.id == "mora.c2.night_take.patient":
                let law = "mora.c2.dialogue.record-patient-take"
                action = dv_with_many(action, {"law": law, "predict_law": law, "grants": dv_append(action.grants, c2d_person_ref(actor.id, "patient_food_reason"))})
                mind = dv_adopt(mind, c1_method(law, c2d_patient_take_record_law()), "predict", 1, c2d_source("10_执行.story", 7, "NightTakeSick：本人行动理由"))
            actions = dvs_replace(actions, j, action)
            j = j + 1
        actor = dv_with_many(actor, {"mind": mind, "actions": c1_public_methods(actions), "policy": dv_with(actor.policy, "notice_co_presence", true)})
        rt_push(actors, c2d_refresh_actor_goals(actor))
        i = i + 1
    return dv_with_many(scene, {"physical": physical, "actors": actors, "bindings": bindings, "world_processes": processes, "chapter2_dialogue_installed": true})

// Display labels require the viewer's actual self-introduction receipt.
fn c2d_known_speaker_name(mind, actor):
    let intros = c2d_introductions()
    var i = 0
    while i < rt_count(intros):
        let intro = intros[i]
        if intro.actor == actor and dv_truth(mind, dv_fact(c2d_person_ref(actor, "introduction"), intro.text)) == "true":
            return c1_other_person(actor).name
        i = i + 1
    return ""
