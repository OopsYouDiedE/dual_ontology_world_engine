    return dv_axiom("c2_open_granary_law", 1, dv_all([c2_at(actor, "logistics"), c2_alive(actor), access]), dv_single(dv_assign(c2_ref("c2.granary", "locked"), false)))

axiom c2_initial_count_law(actor):
    return dv_axiom("c2_initial_count_law", 1, dv_all([c2_at(actor, "logistics"), c2_alive(actor), dv_fact(c2_ref("c2.counter", "remaining"), 99), dv_fact(c2_ref("c2.ledger", "counted"), 0)]), [dv_assign(c2_ref("c2.ledger", "counted"), 99)])

axiom c2_distribute_law(actor):
