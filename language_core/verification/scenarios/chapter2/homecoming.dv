// Article 11 negotiation only. No departure, safety oracle or seed-selected dissenter.
fn c2h_ref(field):
    return c2_ref("c2.homecoming", field)

fn c2h_person(actor, field):
    return c2h_ref(rt_cat(actor, rt_cat(".", field)))

fn c2h_source():
    return c2_approved("user:2026-10-18-article11-owned-negotiation")

fn c2h_contract():
    return dv_fact(c2d_ref("contract_full_text"), c1_op_contract_text())

// A promise from a companion is not an island-exit promise. These unmet
// premises remain unknown until a separately authorized real source exists.
fn c2h_consent_requires(actor):
    var clauses = [c2h_contract()]
    if dv_has(["ward", "veronica", "ruan"], actor):
        rt_push(clauses, dv_fact(c2h_ref("safety_verified"), true))
    if dv_has(["margaret", "shen", "mora", "bertrand"], actor):
        rt_push(clauses, dv_fact(c2_ref("c2.granary", "reserve_added"), true))
        rt_push(clauses, dv_fact(c2h_ref("care_continuity_verified"), true))
    if actor == "quer":
        rt_push(clauses, dv_fact(c2_ref("case.contract", "gu_apologized"), true))
        rt_push(clauses, dv_fact(c2_own("ward", "restriction_withdrawn"), true))
        rt_push(clauses, dv_fact(c2h_ref("outside_promise.quer"), true))
    if actor == "elena":
        rt_push(clauses, dv_fact(c2_ref("case.astral", "abandoned_child_misunderstanding_resolved"), true))
        rt_push(clauses, dv_fact(c2h_ref("outside_promise.elena"), true))
    return dv_all(clauses)

fn c2h_objection(actor):
    if dv_has(["ward", "veronica", "ruan"], actor):
        return "我对契约履行的安全仍有保留，暂不赞成。条文、本人实证与履行结果需要分别核对。"
    if dv_has(["huo", "su", "moran", "gu"], actor):
        return "尽忘意味着放弃在这里取得的认识。我仍要比较求知与生存的价值，现在保留意见。"
    if dv_has(["margaret", "shen", "mora", "bertrand"], actor):
        return "粮仓和病人的责任还要依据我实际知道的情况核对。我暂不把归乡当作这些责任已经解决。"
    if actor == "quer" or actor == "elena":
        return "旧怨是否真正修复，岛外是否有可以依靠的承诺，都要由我自己确认。现在我保留意见。"
    return "我还愿意继续核对留岛与尽忘归乡的代价，暂不赞成。"

fn c2h_rows():
    var rows = []
    let source = c2h_source()
    let proposal_id = "detective.c2.homecoming.propose"
    var propose = c2d_row("detective", proposal_id, "living_hall", c2h_contract(), dv_true(), "我提议按契约第十一条协商尽忘归乡。我的愿意另行表态；其余仍存活在岛上的每个人都须本人同意，听见提议不算同意。", source)
    propose = dv_with_many(propose, {"effects": [dv_assign(c2h_ref("proposed"), true)], "received_speech_requirement": {"speaker": "demon", "action_id": "demon.c2.contract-full-text"}})
    rt_push(rows, propose)
    let people = c2_people()
    var i = 0
    while i < rt_count(people):
        let actor = people[i]
        let ready = dv_all([c2_alive(actor), c2h_contract()])
        let consent = c2h_consent_requires(actor)
        let options = ["consent", "defer"]
        var n = 0
        while n < rt_count(options):
            let accepts = options[n] == "consent"
            var when = ready
            var text = c2h_objection(actor)
            if accepts:
                when = dv_all([ready, consent])
                text = "这是我本人的选择：我愿意尽忘归乡。这句话只记录我的愿意，不能代替任何其他人的同意。"
            var decision_field = "consent_detective"
            if actor == "detective":
                decision_field = "willing"
            elif accepts:
                text = "我同意侦探按契约第十一条申请尽忘归乡。这只表示我对他的申请的表态，不表示我自己也决定离开。"
            let id = rt_cat(actor, rt_cat(".c2.homecoming.", options[n]))
            var row = c2d_row(actor, id, "living_hall", when, dv_true(), text, source)
            row = dv_with_many(row, {"effects": [dv_assign(c2h_person(actor, "decided"), true), dv_assign(c2h_person(actor, decision_field), accepts), dv_assign(c2h_person(actor, "stance"), options[n])], "repeatable": true, "owned_decision": c2h_decision(actor, options[n]), "received_speech_requirement": {"speaker": "detective", "action_id": proposal_id}})
            if actor == "detective":
                row = dv_without(row, "received_speech_requirement")
                row = dv_with(row, "when", dv_all([when, dv_fact(c2h_ref("proposed"), true)]))
            rt_push(rows, row)
            n = n + 1
        i = i + 1
    // Departure requires a separately implemented execution contract. A proposal
    // and elapsed time never stand in for consent, safety or actual departure.
    let ruan_id = "ruan.c2.exile.dead_stone"
    let proposal = "ward.c2.exile.motion"
    let ruan_pre = dv_all([c2h_present("ruan"), dv_fact(c2_ref("c2.casualty", "casualty_occurred"), true)])
    var ruan = c2d_row("ruan", ruan_id, "central_hall", ruan_pre, dv_true(), "我主张把伤亡与配给责任放在一起对账，并提出是否继续承担侦探配给的问题。这只是我的主张。", source)
    ruan = dv_with_many(ruan, {"effects": [dv_assign(c2h_person("ruan", "dead_stone_declared"), true)], "public_grants": [c2h_person("ruan", "dead_stone_declared"), c2d_mark("ruan", ruan_id)], "personal_choice": c2h_exile_choice("ruan-declaration", ruan_pre, ["controlled_audit", "records"], ["patient_priority"])})
    rt_push(rows, ruan)
    let ward_pre = dv_all([c2h_present("ward"), dv_fact(c2h_person("ruan", "dead_stone_declared"), true), c2h_balance_condition()])
    var ward = c2d_row("ward", proposal, "central_hall", ward_pre, dv_true(), "我提出《剥夺配给与放逐动议》，请各位分别表态。提出动议尚不代表动议通过或已经执行。", source)
    ward = dv_with_many(ward, {"effects": [dv_assign(c2h_ref("exile_motion_proposed"), true)], "public_grants": [c2h_ref("exile_motion_proposed"), c2d_mark("ward", proposal)], "received_speech_requirement": {"speaker": "ruan", "action_id": ruan_id}, "personal_choice": c2h_exile_choice("ward-motion", ward_pre, ["committee", "records"], ["patient_priority"])})
    rt_push(rows, ward)
    i = 0
    while i < rt_count(people):
        let actor = people[i]
        let ready = dv_all([c2h_present(actor), dv_fact(c2h_ref("exile_motion_proposed"), true)])
        let options = ["consent", "reject"]
        var n = 0
        while n < rt_count(options):
            let accepts = options[n] == "consent"
            var promotes = ["patient_priority", "solidarity"]
            var sacrifices = ["restriction"]
            var text = "我反对放逐侦探。这只记录我本人的意见。"
            if accepts:
                promotes = ["safety", "records", "restriction"]
                sacrifices = ["patient_priority", "solidarity"]
                text = "我同意这项放逐动议。这只记录我本人的意见，不能替他人投票，也不代表已执行。"
            let id = rt_cat(actor, rt_cat(".c2.exile.", options[n]))
            var row = c2d_row(actor, id, "central_hall", ready, dv_true(), text, source)
            row = dv_with_many(row, {"effects": [dv_assign(c2h_person(actor, "exile_stance"), options[n])], "public_grants": [c2h_person(actor, "exile_stance"), c2d_mark(actor, id)], "repeatable": true, "owned_decision": c2h_exile_decision(actor, options[n]), "received_speech_requirement": {"speaker": "ward", "action_id": proposal}, "personal_choice": c2h_exile_choice(rt_cat("exile.", actor), ready, promotes, sacrifices)})
            rt_push(rows, row)
            n = n + 1
        i = i + 1
    // A unanimous decision records deprivation of rations; it never moves or
    // exiles anyone. There is no escort execution contract in this module.
    let passed = c2h_motion_passed_condition()
    var record = c2d_row("ward", "ward.c2.exile.record-unanimous", "central_hall", passed, dv_true(), "本次在场有能力参与者已分别同意，记录一致剥夺配给的决议。放逐尚待实际执行。", source)
    record = dv_with_many(record, {"effects": [dv_assign(c2h_ref("exile_motion_passed"), true), dv_assign(c2h_ref("ration_deprivation_decided"), true)], "public_grants": [c2h_ref("exile_motion_passed"), c2h_ref("ration_deprivation_decided")], "personal_choice": c2h_exile_choice("ward-record-unanimous", passed, ["committee", "records"], [])})
    rt_push(rows, record)
    let refuse_pre = dv_all([c2h_present("veronica"), dv_fact(c2h_ref("exile_motion_passed"), true), dv_fact(c2h_person("veronica", "exile_stance"), "consent")])
    var refuse = c2d_row("veronica", "veronica.c2.exile.refuse", "central_hall", refuse_pre, dv_true(), "我拒绝继续为这项配给责任提供防护。这是我本人的决定。", source)
    refuse = dv_with_many(refuse, {"effects": [dv_assign(c2h_person("veronica", "protection_refused"), true)], "received_speech_requirement": {"speaker": "ward", "action_id": "ward.c2.exile.record-unanimous"}, "personal_choice": c2h_exile_choice("veronica-refuse-protection", refuse_pre, ["safety", "avoid_ethics_review"], ["patient_priority"])})
    rt_push(rows, refuse)
    return rows

fn c2h_present(actor):
    return dv_all([c2_at(actor, "central_hall"), c2_alive(actor), dv_fact(c2_own(actor, "stone_stupor"), false), dv_fact(c2_own(actor, "in_coma"), false)])

fn c2h_exile_choice(group, requires, promotes, sacrifices):
    return {"group": group, "requires": requires, "prohibits": dv_not(dv_true()), "promotes": promotes, "sacrifices": sacrifices, "require_positive": true, "basis": [c2h_source()]}

fn c2h_exile_decision(actor, stance):
    var refs = [c2h_ref("exile_motion_proposed"), c2_ref("c2.casualty", "casualty_occurred"), c2_own(actor, "hungry"), c2_own(actor, "alive"), c2_own(actor, "stone_stupor"), c2_own(actor, "in_coma")]
    return {"id": rt_cat("exile.", actor), "stance": stance, "context_refs": refs, "context_policy_keys": ["value_order", "speaker_trust", "class_bias"], "request_topics": [], "basis": [c2h_source()]}

// Existing group balance is a background prerequisite, never a voting rule.
// Cardinality is compiled into ordinary propositions and evaluated in the same
// world as the actual law; the summary does not publish authority effects.
fn c2h_at_least_conditions(items, start, count):
    if count <= 0:
        return dv_true()
    if rt_count(items) - start < count:
        return dv_not(dv_true())
    return c1_any(dv_all([items[start], c2h_at_least_conditions(items, start + 1, count - 1)]), c2h_at_least_conditions(items, start + 1, count))

fn c2h_balance_condition():
    let guardians = ["shen", "mora", "huo", "quer", "bertrand", "margaret"]
    let calculators = ["ruan", "ward", "veronica"]
    var g = []
    var c = []
    var i = 0
    while i < rt_count(guardians):
        rt_push(g, c2h_present(guardians[i]))
        i = i + 1
    i = 0
    while i < rt_count(calculators):
        rt_push(c, c2h_present(calculators[i]))
        i = i + 1
    var cases = []
    i = 1
    while i <= rt_count(calculators):
        rt_push(cases, dv_all([c2h_at_least_conditions(c, 0, i), dv_not(c2h_at_least_conditions(g, 0, i))]))
        i = i + 1
    return dv_not(dv_all(c2_negated_conditions(cases)))

fn c2h_motion_passed_condition():
    var clauses = [c2h_present("ward"), dv_fact(c2h_ref("exile_motion_proposed"), true), c2h_balance_condition()]
    let people = c2_people()
    var i = 0
    while i < rt_count(people):
        let actor = people[i]
        // An absent living capable person is unresolved, never an implicit yes.
        let excluded = c1_any(dv_fact(c2_own(actor, "alive"), false), dv_fact(c2_own(actor, "stone_stupor"), true))
        let consent = dv_all([c2h_present(actor), dv_fact(c2h_person(actor, "exile_stance"), "consent"), dv_fact(c2d_mark(actor, rt_cat(actor, ".c2.exile.consent")), true)])
        rt_push(clauses, c1_any(excluded, consent))
        i = i + 1
    return dv_all(clauses)

fn c2h_inspect_ballot(actor, person):
    let pre = dv_all([c2_at(actor, "central_hall"), c2_at(person, "central_hall"), c2_alive(actor)])
    let refs = [c2_own(person, "alive"), c2_own(person, "stone_stupor"), c2_own(person, "in_coma"), c2h_person(person, "exile_stance"), c2d_mark(person, rt_cat(person, ".c2.exile.consent")), c2d_mark(person, rt_cat(person, ".c2.exile.reject"))]
    return dv_with(c2_action(rt_cat(actor, rt_cat(".c2.exile.inspect.", person)), "inspect", pre, pre, "", refs, "核对在场者的状态与本人表态记录。", c2h_source()), "repeatable", true)

fn c2h_is_exile(id):
    if dv_has(["ruan.c2.exile.dead_stone", "ward.c2.exile.motion", "ward.c2.exile.record-unanimous", "veronica.c2.exile.refuse"], id):
        return true
    let people = c2_people()
    var i = 0
    while i < rt_count(people):
        if id == rt_cat(people[i], ".c2.exile.consent") or id == rt_cat(people[i], ".c2.exile.reject"):
            return true
        i = i + 1
    return false

fn c2h_install_scene(scene):
    if dv_find(scene, "chapter2_homecoming_installed", false):
        return scene
    var fields = {"proposed": dv_field(false), "departed": dv_field(false), "trauma_imprints_sealed": dv_field(false), "ration_deprivation_decided": dv_field(false), "exile_motion_proposed": dv_field(false), "exile_motion_passed": dv_field(false), "safety_verified": dv_unknown(), "outside_promise.quer": dv_unknown(), "outside_promise.elena": dv_unknown(), "care_continuity_verified": dv_unknown()}
    let people = c2_people()
    var i = 0
    while i < rt_count(people):
        fields = dv_with_many(fields, [[rt_cat(people[i], ".decided"), dv_field(false)], [rt_cat(people[i], ".willing"), dv_unknown()], [rt_cat(people[i], ".consent_detective"), dv_unknown()], [rt_cat(people[i], ".stance"), dv_unknown()], [rt_cat(people[i], ".exile_stance"), dv_unknown()]])
        i = i + 1
    var physical = c2_add_new(scene.physical, c2_object("c2.homecoming", "living_hall", fields))
    var bindings = dv_clone(scene.bindings)
    var actors = []
    let rows = c2h_rows()
    i = 0
    while i < rt_count(rows):
        physical = dv_store(physical, c2d_mark(rows[i].actor, rows[i].id), dv_field(false))
        physical = dv_adopt(physical, c1_method(rows[i].id, c2d_row_law(rows[i])), "enforce", 1, [rows[i].source])
        i = i + 1
    i = 0
    while i < rt_count(scene.actors):
        var actor = scene.actors[i]
        var mind = c2_add_new(actor.mind, c1_local_object("c2.homecoming"))
        if dv_local(bindings, "c2.homecoming", actor.id) == "":
            rt_push(bindings, dv_binding("c2.homecoming", "c2.homecoming", actor.id))
        var actions = dv_clone(actor.actions)
        if dv_has(people, actor.id):
            mind = dv_store(mind, c2h_person(actor.id, "decided"), dv_field(false))
        var j = 0
        while j < rt_count(rows):
            let row = rows[j]
            if row.actor == actor.id:
                mind = dv_store(mind, c2d_mark(actor.id, row.id), dv_field(false))
                mind = dv_adopt(mind, c1_method(row.id, c2d_row_law(row)), "predict", 1, [row.source])
                let is_exile = c2h_is_exile(row.id)
                var act = c2d_action(row)
                if not is_exile:
                    act = dv_with(act, "manual_only", true)
                rt_push(actions, act)
            j = j + 1
        if dv_has(people, actor.id):
            j = 0
            while j < rt_count(people):
                if actor.id == "ward" or people[j] == actor.id:
                    rt_push(actions, c2h_inspect_ballot(actor.id, people[j]))
                j = j + 1
        rt_push(actors, dv_with_many(actor, {"mind": mind, "actions": c1_public_methods(actions)}))
        i = i + 1
    return dv_with_many(scene, {"physical": physical, "actors": actors, "bindings": bindings, "chapter2_homecoming_installed": true})

// Both stances share an identity: only new relevant owned facts reopen a vote.
fn c2h_decision(actor, stance):
    var refs = [c2d_ref("contract_full_text"), c2h_ref("proposed")]
    if dv_has(["ward", "veronica", "ruan"], actor):
        rt_push(refs, c2h_ref("safety_verified"))
    if dv_has(["margaret", "shen", "mora", "bertrand"], actor):
        refs = dvp_merge_refs(refs, [c2_ref("c2.granary", "reserve_added"), c2h_ref("care_continuity_verified"), c2_own("moran", "fever"), c2_own("moran", "hungry")])
    if actor == "quer":
        refs = dvp_merge_refs(refs, [c2_ref("case.contract", "gu_apologized"), c2_own("ward", "restriction_withdrawn"), c2h_ref("outside_promise.quer")])
    if actor == "elena":
        refs = dvp_merge_refs(refs, [c2_ref("case.astral", "abandoned_child_misunderstanding_resolved"), c2h_ref("outside_promise.elena")])
    if dv_has(["huo", "su", "moran", "gu"], actor):
        refs = dvp_merge_refs(refs, [c2_own(actor, "hungry"), c2_own(actor, "fever"), c2_ref("c2.weather", "earthquake_recent"), c2_ref("c2.meter", "safe")])
    return {"id": rt_cat("homecoming.", actor), "stance": stance, "context_refs": refs, "context_policy_keys": ["drive", "caution", "speaker_trust", "class_bias"], "request_topics": [], "basis": [c2h_source()]}

fn c2h_owner_utility(actor, action, consent):
    var direction = 1
    if not consent:
        direction = -1
    // Drive values preserving inquiry; caution values survival. The known
    // substantive requirements still gate consent before either is compared.
    let trust = dvs_speaker_trust(actor.policy, "detective")
    let basis = [c2h_source(), {"samples": dv_find(actor, "cognitive_samples", []), "policy_drive": dv_find(actor.policy, "drive", false), "policy_caution": dv_find(actor.policy, "caution", false), "speaker": "detective", "speaker_trust": trust, "speaker_trust_policy": dv_find(actor.policy, "speaker_trust", []), "class_bias": dv_find(actor.policy, "class_bias", []), "owned_inputs": dvs_owned_decision_inputs(actor, action.owned_decision, actor.mind).sources}]
    return {"requires": action.precondition, "basis": basis, "terms": [{"quantity": {"policy_key": "drive"}, "weight": -direction}, {"quantity": {"policy_key": "caution"}, "weight": direction}, {"quantity": {"speaker": "detective"}, "weight": direction}]}

// Call after c2d_refresh_actor_goals, which rebuilds the base goal list.
// Recompute navigation after adding these communication goals so another room
// is a real known-path movement opportunity rather than a local-only label.
fn c2h_refresh_actor(actor):
    var actions = actor.actions
    var goals = actor.policy.goals
    var i = 0
    while i < rt_count(actions):
        var action = actions[i]
        if dv_has_key(action, "owned_decision") and action.owned_decision.id == rt_cat("homecoming.", actor.id):
            action = dv_without(action, "personal_choice")
            action = dv_with(action, "owner_utility", c2h_owner_utility(actor, action, action.owned_decision.stance == "consent"))
            actions = dvs_replace(actions, i, action)
        if c2h_is_exile(action.id):
            var available = action.precondition
            if dv_has_key(action, "received_speech_requirement") and not c2_received_requirement(actor, action.received_speech_requirement):
                available = dv_not(dv_true())
            if not dvp_owned_decision_ready(actor, action, actor.mind):
                available = dv_not(dv_true())
            rt_push(goals, c1n_index_goal_window({"kind": "communicate", "scope": "personal", "method_id": action.id, "available_when": available, "basis": [c2h_source()], "requires_argument": false, "navigation_room": "central_hall"}))
        if dv_has(["detective.c2.homecoming.propose", rt_cat(actor.id, ".c2.homecoming.consent"), rt_cat(actor.id, ".c2.homecoming.defer")], action.id) and dv_find(actor.policy, "homecoming_negotiation", false):
            action = dv_with(action, "manual_only", false)
            actions = dvs_replace(actions, i, action)
            var available = action.precondition
            if dv_has_key(action, "received_speech_requirement") and not c2_received_requirement(actor, action.received_speech_requirement):
                available = dv_not(dv_true())
            if not dvp_owned_decision_ready(actor, action, actor.mind):
                available = dv_not(dv_true())
            rt_push(goals, c1n_index_goal_window({"kind": "communicate", "scope": "personal", "method_id": action.id, "available_when": available, "basis": [c2h_source()], "requires_argument": false, "navigation_room": "living_hall"}))
        i = i + 1
    if dv_has(c2_people(), actor.id):
        var people = [actor.id]
        if actor.id == "ward":
            people = c2_people()
        i = 0
        while i < rt_count(people):
            let person = people[i]
            var opened = dv_fact(c2h_ref("exile_motion_proposed"), true)
            if actor.id == "ward":
                opened = c1_any(opened, dv_fact(c2h_person("ruan", "dead_stone_declared"), true))
            let ready = dv_all([c2_at(actor.id, "central_hall"), c2_at(person, "central_hall"), opened])
            let refs = [c2_own(person, "alive"), c2_own(person, "stone_stupor"), c2_own(person, "in_coma"), c2h_person(person, "exile_stance")]
            var r = 0
            while r < rt_count(refs):
                rt_push(goals, dv_with(c2_observation_goal(refs[r], ready, [c2h_source()], 0), "navigation_room", "central_hall"))
                r = r + 1
            i = i + 1
    var substantive = []
    i = 0
    while i < rt_count(goals):
        if not dv_has_key(goals[i], "navigation_intention"):
            rt_push(substantive, goals[i])
        i = i + 1
    let view = dv_with_many(actor, {"actions": actions, "policy": dv_with(actor.policy, "goals", substantive)})
    return dv_with(view, "policy", dv_with(view.policy, "goals", c2_navigation_goals(view, substantive)))

fn c2h_guardian_balance(physical):
    let groups = [["shen", "mora", "huo", "quer", "bertrand", "margaret"], ["ruan", "ward", "veronica"]]
    var counts = []
    var ballots = []
    var group = 0
    while group < rt_count(groups):
        var present = 0
        var i = 0
        while i < rt_count(groups[group]):
            let actor = groups[group][i]
            let eligible = dv_truth(physical, c2h_present(actor))
            if eligible == "true":
                present = present + 1
            rt_push(ballots, {"actor": actor, "present_capable": eligible, "stance": dv_read(physical, c2h_person(actor, "exile_stance"))})
            i = i + 1
        rt_push(counts, present)
        group = group + 1
    var all_ballots = []
    let people = c2_people()
    var i = 0
    while i < rt_count(people):
        let actor = people[i]
        rt_push(all_ballots, {"actor": actor, "present_capable": dv_truth(physical, c2h_present(actor)), "alive": dv_read(physical, c2_own(actor, "alive")), "permanently_disabled": dv_read(physical, c2_own(actor, "stone_stupor")), "stance": dv_read(physical, c2h_person(actor, "exile_stance")), "consent_execution": dv_read(physical, c2d_mark(actor, rt_cat(actor, ".c2.exile.consent"))), "reject_execution": dv_read(physical, c2d_mark(actor, rt_cat(actor, ".c2.exile.reject")))})
        i = i + 1
    return {"guardians_present_capable": counts[0], "calculators_present_capable": counts[1], "background_gate": dv_truth(physical, c2h_balance_condition()), "group_members": ballots, "ballots": all_ballots, "unanimous_decision_eligible": dv_truth(physical, c2h_motion_passed_condition()), "motion_proposed": dv_read(physical, c2h_ref("exile_motion_proposed")), "motion_passed": dv_read(physical, c2h_ref("exile_motion_passed")), "ration_deprivation_decided": dv_read(physical, c2h_ref("ration_deprivation_decided")), "exile_execution": "not-implemented"}

// These are event-grounded literary candidates, not personal cognitive imprints.
// The caller has no actor contact history, so no recipient or sealing is asserted.
fn c2h_trauma_imprints(physical):
    var imprints = []
    let rows = [
        {"ref": c2_ref("c2.casualty", "moran_dead"), "id": "imprint_avoid_doors", "description": "对死亡留下的恐惧"},
        {"ref": c2_ref("c2.casualty", "bertrand_stupor"), "id": "imprint_empty_chair_stone", "description": "对石雕般失能留下的创伤"},
        {"ref": c2_ref("c2.weather", "earthquake_recent"), "id": "imprint_wind_flinch", "description": "对地震留下的惊惧"},
        {"ref": c2_own("detective", "hungry"), "id": "imprint_empty_plate_tears", "description": "对饥饿留下的恐惧"}]
    var i = 0
    while i < rt_count(rows):
        let st = dv_read(physical, rows[i].ref)
        if dv_uncontested(st) and st.value == true:
            rt_push(imprints, {"id": rows[i].id, "description": rows[i].description, "basis": {"ref": rows[i].ref, "state": st}, "status": "event-grounded-candidate-contact-unverified"})
        i = i + 1
    return imprints

fn c2h_summary(physical):
    var others = []
    var unanimous = true
    let people = c2_people()
    var i = 0
    while i < rt_count(people):
        let id = people[i]
        if id != "detective":
            let alive = dv_read(physical, c2_own(id, "alive"))
            let willing = dv_read(physical, c2h_person(id, "consent_detective"))
            rt_push(others, {"actor": id, "alive": alive, "consent_detective": willing, "stance": dv_read(physical, c2h_person(id, "stance"))})
            if not dv_uncontested(alive) or (alive.value == true and (not dv_uncontested(willing) or willing.value != true)):
                unanimous = false
        i = i + 1
    let balance = c2h_guardian_balance(physical)
    return {"scope": "negotiation-only", "proposed": dv_read(physical, c2h_ref("proposed")), "own_willing": dv_read(physical, c2h_person("detective", "willing")), "others": others, "all_other_living_consent": unanimous, "safety_verification": dv_read(physical, c2h_ref("safety_verified")), "seed_specific_homecoming_utility": "declared-shared-owner-utility", "departure": dv_read(physical, c2h_ref("departed")), "guardian_balance": balance, "trauma_imprints": c2h_trauma_imprints(physical)}
