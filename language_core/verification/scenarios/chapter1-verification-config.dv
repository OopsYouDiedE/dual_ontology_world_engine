// Native verification configuration. No oracle or outcome enters a policy.

fn dvs_manifest(scenario, capability, initial_scope):
    var actors = scenario.actors
    var minds = []
    var i = 0
    var laws = []
    while (i < rt_count(actors)):
        var actor = actors[i]
        rt_push(minds, dv_pair(actor.id, actor.mind))
        rt_push(laws, dv_pair(actor.id, actor.mind.adoptions))
        i = (i + 1)
    return dv_with(dv_with(dv_with({"initial": {"physical": scenario.physical, "minds": minds}, "axioms": {"physical": scenario.physical.adoptions, "minds": laws}, "cost_model": scenario.cost_model, "capability": capability}, "source_ref", "language_core/verification/scenarios/chapter1-content.dv"), "initial_scope", initial_scope), "declared_action_budget_scope", "Detective 48 source action_budget; NPC 48 engineering cap only; total is sum, no time/cost relaxation")

fn dvs_manifest_enabled():
    return dvs_manifest(dvs_scenario_base(), {"actor": "detective", "model_budget": 320, "mode": "enabled"}, "canonical")

fn dvs_manifest_disabled():
    return dvs_manifest(dvs_scenario_base(), {"actor": "detective", "model_budget": 0, "mode": "disabled"}, "canonical")

fn dvs_manifest_boundary():
    return dvs_manifest(dvs_scenario_boundary(), {"actor": "detective", "model_budget": 320, "mode": "enabled"}, "noncanonical: only Su physical/self position differs at R05")

fn dvs_manifest_low():
    return dvs_manifest(dvs_scenario_low(), {"actor": "detective", "model_budget": 320, "mode": "enabled"}, "canonical initial; information_weight10.8 only")

fn dvs_manifest_holdout():
    return dvs_manifest(dvs_scenario_holdout(), {"actor": "detective", "model_budget": 320, "mode": "enabled"}, "canonical initial; information_weight13.2 reserve only")

fn dvs_comparison_run(id):
    return {"manifest": rt_cat(rt_cat("{inputs}/manifest-", id), ".json"), "trace": rt_cat(rt_cat("{out}/trace-", id), ".json"), "oracle": "{inputs}/chapter1-oracle.json"}

fn dvs_comparison_base(runs, variables, variants):
    return dv_with(dv_with({"runs": runs, "frozen_fields": dv_list3("initial", "axioms", "cost_model"), "variable_fields": variables, "allowed_variants": variants}, "approval_ref", "Current human authorization: full native-DV verification, capability toggle, R05 boundary diagnosis and information_weight neighborhood"), "interpretation", "No forced failures or best-seed selection; unknown and unobserved results retained")

fn c1_compare_capability_raw():
    return dvs_comparison_base(dv_pair(dvs_comparison_run("disabled"), dvs_comparison_run("enabled")), dv_single("capability"), dv_single("detective model_budget=0 vs320 only"))

fn c1_compare_boundary_raw():
    return dv_with(dvs_comparison_base(dv_pair(dvs_comparison_run("enabled"), dvs_comparison_run("boundary")), dv_single("initial_position"), dv_single("noncanonical Su R05 physical+self location")), "legal_propagation_variants", dv_single("R05 remains original no-message/only-alarm acoustic area; no observation deletion or law change"))

fn c1_compare_parameters_raw():
    return dv_with(dv_with(dv_with(dv_with(dvs_comparison_base(dv_list3(dvs_comparison_run("enabled"), dvs_comparison_run("low"), dvs_comparison_run("holdout")), dv_single("information_weight"), dv_list3(12, 10.8, 13.2)), "approved_ranges", {"information_weight": dv_pair(10.8, 13.2), "scope": "engineering exploration, not psychological calibration"}), "neighborhood", dv_pair(12, 10.8)), "reserve_set", dv_single(13.2)), "random_stream_contract", "No stochastic outcomes or seed optimization added; existing seed source unchanged")

fn dvs_compare_capability():
    return dv_with(dv_with(c1_compare_capability_raw(), "target_actor", "detective"), "allowed_model_budgets", dv_pair(0, 320))

fn dvs_compare_boundary():
    return dv_with(dv_with(dv_with(dv_with(dv_with(c1_compare_boundary_raw(), "target_actor", "su"), "boundary_physical_ref", dv_ref("su", "state", "location")), "boundary_mind_ref", dv_ref("su", "state", "location")), "allowed_position_values", dv_pair("hall", "R05")), "approved_position_bases", dv_pair([], dv_single("Human-authorized noncanonical boundary initial position: Su at R05, only alarm/no-message source area")))

fn dvs_compare_parameters():
    return dv_with(c1_compare_parameters_raw(), "target_actor", "detective")
