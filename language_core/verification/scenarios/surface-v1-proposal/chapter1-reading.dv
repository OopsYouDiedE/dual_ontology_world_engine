// DESIGN INPUT ONLY: surface-v1 is not implemented; this file is not in a run manifest.
// Source: ../chapter1-pragmatics.dv:c1_short_stay_rule, same fields and expressions.
// dv.compat is a planned checked signature/DTO bridge, not an existing module.
// No new facts, answers, personality parameters or probability policy are introduced.
module dv.chapter1.syntax_proposal;
import dv.compat as legacy;
export c1_short_stay_rule;

interpretation c1_short_stay_rule(
    knowledge: Value,
    question: Value,
    memory: Value,
    basis: Value
) version 1 {
    id: "short_stay";
    cue: "short_stay";

    when: legacy.dv_all(legacy.dv_pair(
        legacy.dv_fact(legacy.dv_ref(question, "state", "awake_scope"), true),
        legacy.dv_fact(legacy.dv_ref(memory, "state", "empty_school_recall"), true)
    ));

    conclude: legacy.dv_fact(
        legacy.dv_ref(knowledge, "state", "short_stay"), true
    );

    support: weight(0.6);
    basis: basis;
    source_scope: legacy.scope("awake_self");
    target_scope: legacy.scope("body_history");
    bridge: legacy.dv_m2("op", "constant", "value", "unknown");
    available: legacy.dv_true();

    withdraw: legacy.dv_not(legacy.dv_all(legacy.dv_list3(
        legacy.dv_not(legacy.dv_fact(
            legacy.dv_ref(knowledge, "state", "familiar"), true
        )),
        legacy.dv_not(legacy.dv_fact(
            legacy.dv_ref(knowledge, "state", "long_residence_traces"), true
        )),
        legacy.dv_not(legacy.dv_fact(
            legacy.dv_ref(knowledge, "state", "replay_reason_complete"), true
        ))
    )));
}

// Checked bridge contract: Value inputs/results are schema-checked before entering
// typed domain operations. The historical id/cue/premise/proposition/prior/basis,
// source_scope/target_scope/scope_bridge/available_when/withdraw_when DTO fields
// retain the original values. "prior" is a legacy support field, not a new probability.
// Actor policies, scope_reference_check and threshold are NOT supplied by this rule.
// Each real actor retains its original personally sourced adoption and scope policy.
