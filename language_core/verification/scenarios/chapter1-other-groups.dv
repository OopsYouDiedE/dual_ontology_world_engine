    var speech = dv_with_many(c1_speech(dv_true(), spec.source, "group-question-not-an-asserted-answer"), {"surface": rt_cat("铜口里传来声音：", spec.prompt), "utterance_type": "question", "channel": rt_cat("copper.", group)})
    var listeners = []
