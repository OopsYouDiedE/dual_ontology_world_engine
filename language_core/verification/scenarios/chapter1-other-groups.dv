        var action_id = rt_cat(rt_cat(rt_cat(id, ".answer."), person.group), rt_cat(".", option))
        var known = dv_all([c1_at(id, spec.room), c1_other_claim(person.group, "open"), answer, dv_at_least(c1_other_clock_ref(), c1_other_report_time(person.group))])
        var action = c1_action(action_id, "answer", known, known, "", [], spec.source)
        var speech = dv_with(c1_speech(answer, spec.source, "literal-actor-only-not-motive"), "surface", rt_cat(c1_other_person(option).name, c1_other_report_surface(person.group)))
        rt_push(result, dv_with_many(action, {"answer": answer, "answer_id": action_id, "topic": rt_cat(person.group, ".identity"), "speech": dv_with(speech, "channel", rt_cat("copper.", person.group)), "listeners": dv_single("demon"), "authority_precondition": dv_all([c1_at(id, spec.room), c1_other_claim(person.group, "open"), c1_at("demon", "living_hall"), dv_at_least(c1_other_clock_ref(), c1_other_report_time(person.group))]), "purpose_refs": dv_single(c1_other_ref(person.group, rt_cat("receipt.", id)))}))
        i = (i + 1)
    return result

fn c1_other_formal_answers():
    var people = c1_other_people()
    var result = []
