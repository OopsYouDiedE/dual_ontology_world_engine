// Native first-chapter content for the three other dormitory groups.
// Personal perception, authority history, fallible hypotheses, literal answer and motive hypotheses
// occupy separate fields. No .story loader, answer grants, forced adoption or fixed route.
// This module does not give these people the living-wing broadcast.
// Prior strengths from old authorship remain provenance, not new personality weights.
// c1_other_group_extend installs content; source catalog data alone never completes an action.

fn c1_other_people():
    var result = []
    rt_push(result, {"id": "quer", "name": "雀儿", "group": "contract", "desire": "一个不会赶她走的地方", "initial_surface": "门。门闩在外面。", "material_surface": "袋子还在，口扎得死紧。我的结。", "intention_surface": "先看看那道门闩。", "memory_surface": "怎么来的？上船，然后……不知道。", "memory_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 47, "opening_quer.003"), "initial_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 46, "opening_quer.002"), "material_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 48, "opening_quer.004"), "desire_source": c1_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/07_雀儿.story", 10, "quer.desire")})
    rt_push(result, {"id": "lucian", "name": "卢西安", "group": "contract", "desire": "言灵的完美韵律", "initial_surface": "嘴边有一句诗，念到一半，韵脚找不着了。", "material_surface": "桌上的笔记是我的字，比平时潦草。", "intention_surface": "先找那个韵。", "memory_surface": "上船之后呢？也找不着了。", "memory_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 31, "opening_lucian.003"), "initial_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 30, "opening_lucian.002"), "material_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 32, "opening_lucian.004"), "desire_source": c1_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/05_卢西安.story", 10, "lucian.desire")})
    rt_push(result, {"id": "ward", "name": "沃德", "group": "contract", "desire": "成为定规则的人", "initial_surface": "纸。笔。都在桌上。", "material_surface": "笔尖是新削的。", "intention_surface": "从现在开始记。", "memory_surface": "上船以后的事，一个字也没有记下。这不像我。", "memory_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 55, "opening_ward.003"), "initial_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 54, "opening_ward.002"), "material_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 56, "opening_ward.004"), "desire_source": c1_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/08_沃德.story", 10, "ward.desire")})
    rt_push(result, {"id": "gu", "name": "顾平章", "group": "contract", "desire": "读通古代铭文", "initial_surface": "老花镜搁在枕边，镜片上溅了一点墨。", "material_surface": "枕边这摞拓片，是哪里的碑？", "intention_surface": "先把镜片擦干净。", "memory_surface": "老朽记得上了船。再往后，就记不起了。", "memory_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 39, "opening_gu.003"), "initial_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 38, "opening_gu.002"), "material_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 40, "opening_gu.004"), "desire_source": c1_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/06_顾平章.story", 10, "gu.desire")})
    rt_push(result, {"id": "ruan", "name": "阮清月", "group": "astral", "desire": "赢下与恶魔的对局", "initial_surface": "枕边一枚黑子，凉的。", "material_surface": "桌上一盘棋下到中盘。轮到黑走。我记不起这一手要下在哪。", "intention_surface": "先不下。", "memory_surface": "上船，然后是一段空白。", "memory_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 71, "opening_ruan.003"), "initial_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 70, "opening_ruan.002"), "material_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 72, "opening_ruan.004"), "desire_source": c1_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/10_阮清越.story", 10, "ruan.desire")})
    rt_push(result, {"id": "elena", "name": "伊莲娜", "group": "astral", "desire": "治好脚踝，查明仪式真相", "initial_surface": "左脚踝缠着绷带。一动，疼得眼前发白。", "material_surface": "脚尖自己绷了一下，像要起步。", "intention_surface": "别站。再躺一会儿。", "memory_surface": "我是怎么伤的？只记得上船。", "memory_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 79, "opening_elena.003"), "initial_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 78, "opening_elena.002"), "material_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 80, "opening_elena.004"), "desire_source": c1_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/11_伊莲娜.story", 10, "elena.desire")})
    rt_push(result, {"id": "selma", "name": "赛尔玛", "group": "astral", "desire": "为源质这一新物种定名", "initial_surface": "窗台上一盆苗，没见过，叶背亮得像抹了油。", "material_surface": "本子上画着这片叶子，编号那一栏空着。我画的，我没编。", "intention_surface": "查看叶子和本子。", "memory_surface": "船靠岸了吗？想不起来。", "memory_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 63, "opening_selma.003"), "initial_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 62, "opening_selma.002"), "material_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 64, "opening_selma.004"), "desire_source": c1_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/09_赛尔玛.story", 10, "selma.desire")})
    rt_push(result, {"id": "moran", "name": "莫兰", "group": "astral", "desire": "看见更多的以太色层", "initial_surface": "窗光是灰的。灰底下，还有一层很淡的绿。", "material_surface": "速写本摊着，炭笔滚在手边。", "intention_surface": "那层绿要散了。", "memory_surface": "船……之后是白的。", "memory_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 87, "opening_moran.003"), "initial_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 86, "opening_moran.002"), "material_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 88, "opening_moran.004"), "desire_source": c1_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/12_莫兰.story", 10, "moran.desire")})
    rt_push(result, {"id": "mora", "name": "茉拉", "group": "logistics", "desire": "不再失去病人", "initial_surface": "药包。……在。", "material_surface": "围裙兜里有半卷绷带。", "intention_surface": "外面有人咳嗽。", "memory_surface": "上船以后的事，想不起来。", "memory_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 119, "opening_mora.003"), "initial_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 118, "opening_mora.002"), "material_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 120, "opening_mora.004"), "desire_source": c1_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/16_茉拉.story", 10, "mora.desire")})
    rt_push(result, {"id": "bertrand", "name": "贝尔特朗", "group": "logistics", "desire": "护住平民同伴", "initial_surface": "手先摸到床边的提灯。灯油还有半截。", "material_surface": "左肩的皮垫磨亮了。那是托枪的地方，可枪不在。", "intention_surface": "门外有动静。", "memory_surface": "上船。然后就是这间屋子。中间缺了一段。", "memory_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 103, "opening_bertrand.003"), "initial_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 102, "opening_bertrand.002"), "material_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 104, "opening_bertrand.004"), "desire_source": c1_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/14_贝尔特朗.story", 10, "bertrand.desire")})
    rt_push(result, {"id": "veronica", "name": "维罗妮卡", "group": "logistics", "desire": "独立研究，证明理化能解释一切", "initial_surface": "一股试剂味，很淡，像是乙醚挥发过。", "material_surface": "器具都在架上，摆得比我习惯的还整齐。谁替我摆的？", "intention_surface": "先查瓶签。", "memory_surface": "最后记得的事：上船。之后的，一件也想不起来。", "memory_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 95, "opening_veronica.003"), "initial_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 94, "opening_veronica.002"), "material_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 96, "opening_veronica.004"), "desire_source": c1_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/13_维罗妮卡.story", 10, "veronica.desire")})
    rt_push(result, {"id": "margaret", "name": "玛格丽特", "group": "logistics", "desire": "亲手建成、被人承认", "initial_surface": "天花板的梁是斜搭的。这跨度，搭得有点悬。", "material_surface": "卷尺和铅垂还挂在腰上，睡觉都没解。", "intention_surface": "先看看这屋子承不承得住。", "memory_surface": "我记得上船。之后的事，一点也想不起来。", "memory_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 111, "opening_margaret.003"), "initial_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 110, "opening_margaret.002"), "material_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 112, "opening_margaret.004"), "desire_source": c1_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/15_玛格丽特.story", 10, "margaret.desire")})
    return result

fn c1_other_person(id):
    var rows = c1_other_people()
    var i = 0
    while (i < rt_count(rows)):
        if (rows[i].id == id):
            return rows[i]
        i = (i + 1)
    dv_require(false, "Unknown chapter-one other-group actor")
    return false

fn c1_other_case(group):
    if (group == "contract"):
        return {"id": "contract", "room": "dorm.contract", "zone": "甲区", "prompt": "谁开启内柜，物品藏在哪里，又做了什么？", "options": ["quer", "ward", "gu", "lucian"], "reason_options": ["authorized_transfer", "theft"], "reason_surfaces": ["受命转移文书", "私自行窃"], "authority_actor": "quer", "authority_reason": "authorized_transfer", "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 9, "文契"), "outside_evidence_surface": "无署名、无日期的《紧急转移清册》残页记着交“雀（J.C.）”用钥匙转移管网图；须与残角、柜锁及管网图去向合并核对", "outside_evidence_scope": "requires-local-inspection-and-personal-testimony"}
    if (group == "astral"):
        return {"id": "astral", "room": "dorm.astral", "zone": "丙区", "prompt": "是谁让一个人留在了沉静室里？", "options": ["ruan", "selma", "moran"], "reason_options": ["self_preservation", "requested_closure"], "reason_surfaces": ["单方面止损、保住多数而封门", "伊莲娜示意关门"], "authority_actor": "ruan", "authority_reason": "requested_closure", "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 28, "星仪"), "outside_evidence_surface": "莫兰撕下的那页速写：伊莲娜在门内抬手示意；沉静室门内的步位标线一道不乱", "outside_evidence_scope": "requires-local-inspection-and-personal-testimony"}
    if (group == "logistics"):
        return {"id": "logistics", "room": "dorm.logistics", "zone": "丁区", "prompt": "白塔柜里那瓶试剂，是谁取走的？", "options": ["veronica", "mora", "bertrand", "margaret"], "reason_options": ["experiment", "wound_cleaning"], "reason_surfaces": ["未经医嘱进行激进酸试验", "依据自体耐受标定救治贝尔特朗"], "authority_actor": "veronica", "authority_reason": "wound_cleaning", "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 45, "后勤"), "outside_evidence_surface": "维罗妮卡左臂的旧疤与本人对稀酸清创的解释", "outside_evidence_scope": "requires-local-inspection-and-personal-testimony"}
    dv_require(false, "Unknown chapter-one dormitory group")
    return false

fn c1_other_traces(group):
    var result = []
    if (group == "contract"):
        rt_push(result, {"id": "wet_rubbing", "surface": "顾平章的拓片墨迹未干。", "excluded_actor": "gu", "needs_actual_witness": false, "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 18, "拓片墨未干")})
    if (group == "contract"):
        rt_push(result, {"id": "continuous_manuscript", "surface": "卢西安的手稿写满三页，墨迹连贯。", "excluded_actor": "lucian", "needs_actual_witness": false, "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 19, "手稿写满三页")})
    if (group == "contract"):
        rt_push(result, {"id": "lock_checklist", "surface": "沃德的柜锁清单上压着笔痕，写的是记录。", "excluded_actor": "ward", "needs_actual_witness": false, "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 20, "清单上的笔痕")})
    if (group == "astral"):
        rt_push(result, {"id": "continuous_specimen_notes", "surface": "赛尔玛的标本笔记一条接一条，时刻连着。", "excluded_actor": "selma", "needs_actual_witness": false, "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 37, "标本笔记不断")})
    if (group == "astral"):
        rt_push(result, {"id": "remaining_sketches", "surface": "莫兰的速写本撕掉了一页，剩下的都是共鸣厅里的人，没有门。", "excluded_actor": "moran", "needs_actual_witness": false, "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 38, "速写本缺页")})
    if (group == "logistics"):
        rt_push(result, {"id": "sealed_medicine", "surface": "茉拉药包的封条完好。", "excluded_actor": "mora", "needs_actual_witness": false, "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 54, "药包封条完好")})
    if (group == "logistics"):
        rt_push(result, {"id": "lamp_and_no_reagent", "surface": "玛格丽特的提灯灯油耗了一半，手上没有试剂味。", "excluded_actor": "margaret", "needs_actual_witness": false, "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 55, "提灯油耗一半")})
    if (group == "logistics"):
        rt_push(result, {"id": "matching_lamps", "surface": "两盏提灯的灯油耗相同。", "excluded_actor": "bertrand", "needs_actual_witness": true, "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 56, "两盏灯互证")})
    return result

fn c1_other_ref(group, field):
    return dv_ref(rt_cat("case.", group), "state", field)

fn c1_other_claim(group, field):
    return dv_fact(c1_other_ref(group, field), true)

fn c1_other_identity(group, actor):
    return c1_other_claim(group, rt_cat("answer.", actor))

// These old-source trace/actor associations are defeasible personal hypotheses.
// No inference law writes an exclusion or an answer merely from ink, a drawing,
// a seal, smell, or equal lamp consumption. Contrary personal evidence revises
// them through the shared hypothesis selector.
fn c1_other_exclusion_hypotheses(id):
    let person = c1_other_person(id)
    let spec = c1_other_case(person.group)
    let traces = c1_other_traces(person.group)
    var result = []
    var i = 0
    while i < rt_count(traces):
        let trace = traces[i]
        let observed = c1_other_claim(person.group, rt_cat("trace.", trace.id))
        let proposition = dv_not(c1_other_identity(person.group, trace.excluded_actor))
        var available = dv_all(dv_pair(c1_other_claim(person.group, "open"), observed))
        if trace.needs_actual_witness:
            available = dv_all(dv_pair(available, c1_other_claim(person.group, "mutual_witness_received")))
        rt_push(result, {"id": rt_cat(rt_cat(id, ".exclusion."), trace.id), "question": rt_cat(person.group, ".identity"), "group": rt_cat(person.group, ".identity"), "proposition": proposition, "prior": 0.5, "available_when": available, "basis": [trace.source], "kind": "fallible-trace-heuristic", "observed_premise": observed, "scope": "present-material-to-past-activity", "missing_support": "independent-event-time-or-personal-witness", "established": false})
        i = i + 1
    return result

axiom c1_other_question_open(group):
    var effects = dv_pair(dv_assign(c1_other_ref(group, "open"), true), dv_assign(c1_other_ref(group, "current"), rt_cat(group, ".identity")))
    var people = c1_other_people()
    var i = 0
    while (i < rt_count(people)):
        if (people[i].group == group):
            rt_push(effects, dv_assign(dv_ref(rt_cat("personal.", people[i].id), "state", "current"), rt_cat(group, ".identity")))
        i = (i + 1)
    return dv_axiom(rt_cat("c1_other_question_open.", group), 1, dv_fact(c1_other_ref(group, "open"), false), effects)

axiom c1_other_accept(group, actor):
    return dv_axiom(rt_cat(rt_cat("c1_other_accept.", group), rt_cat(".", actor)), 1, c1_other_claim(group, "open"), dv_list3(dv_assign(c1_other_ref(group, rt_cat("receipt.", actor)), true), dv_assign(c1_other_ref(group, rt_cat("level.", actor)), 1), dv_assign(dv_ref(rt_cat("personal.", actor), "state", "current"), rt_cat(group, ".reason"))))

// A valid duty report permits a real release action at the shared living hall.
axiom c1_other_release(group, clock_ref):
    var people = c1_other_people()
    var reported = dv_not(dv_true())
    var i = 0
    while (i < rt_count(people)):
        if (people[i].group == group):
            reported = c1_any(reported, c1_other_claim(group, rt_cat("receipt.", people[i].id)))
        i = (i + 1)
    var safe_time = 840
    var safety = c1_other_claim(group, "evidence_complete")
    if group == "astral":
        safe_time = 1890
        safety = dv_all([c1_other_claim(group, "care_given"), c1_other_claim(group, "west_passage_checked")])
    if group == "logistics":
        safe_time = 2010
        safety = dv_all([c1_other_claim(group, "care_given"), c1_other_claim(group, "observation_complete")])
    return dv_axiom(rt_cat("c1_other_release.", group), 1, dv_all([reported, safety, dv_at_least(clock_ref, safe_time), c2_at("demon", "living_hall"), dv_fact(dv_ref("demon.body", "state", "manifested"), true), dv_fact(c1_other_ref(group, "outer_latch_released"), false)]), [dv_assign(c1_other_ref(group, "outer_latch_released"), true), dv_assign(c1_other_access_ref(group), true), dv_assign(dv_ref("demon.body", "state", "manifested"), false), dv_assign(dv_ref("demon.body", "state", "latch_hand_trace"), "long-narrow-hand")])

fn c1_other_open_action(group, speaker):
    var spec = c1_other_case(group)
