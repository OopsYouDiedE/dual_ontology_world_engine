fn c2_norm_actions(actor, norm):
    let object = c2_norm_object(norm.id)
    var result = []
    if actor == norm.owner:
        let id = rt_cat(actor, rt_cat(".c2.propose.", norm.id))
        let speech = dv_with_many(c1_speech(dv_fact(c2_ref(object, "text"), norm.surface), norm.source, "personal-norm-proposal"), {"surface": norm.surface, "utterance_type": "proposal", "norm_proposal": norm})
        rt_push(result, dv_with_many(c2_action(id, "talk", c2_alive(actor), c2_alive(actor), id, dv_single(c2_ref(object, "proposed")), norm.surface, norm.source), {"speech": speech, "listeners": c2_people()}))
        let post_id = rt_cat(actor, rt_cat(".c2.post.", norm.id))
        let pre = dv_all(dv_pair(c2_at(actor, norm.board), dv_fact(c2_ref(object, "proposed"), true)))
        rt_push(result, c2_action(post_id, "help", pre, pre, post_id, dv_single(c2_ref(object, "posted")), rt_cat("在公告板上贴出：", norm.surface), norm.source))
    let peek = rt_cat(actor, rt_cat(".c2.inspect.board.", norm.id))
    rt_push(result, dv_with(c2_action(peek, "inspect", c2_at(actor, norm.board), c2_at(actor, norm.board), "", dv_single(c2_ref(object, "posted")), "查看公告板。", norm.source), "repeatable", true))
    let read_id = rt_cat(actor, rt_cat(".c2.read.", norm.id))
    let read_pre = dv_all([c2_at(actor, norm.board), dv_fact(c2_ref(object, "posted"), true), dv_fact(c2_own(actor, rt_cat("read.", norm.id)), false)])
    rt_push(result, c2_action(read_id, "read", read_pre, read_pre, read_id, dv_pair(c2_ref(object, "text"), c2_own(actor, rt_cat("read.", norm.id))), norm.surface, norm.source))
    let known = dv_fact(c2_ref(object, "text"), norm.surface)
    var accepted = true
    var n = 0
    while n < 2:
        var verb = "accept"
        var promotes = norm.promotes
        var sacrifices = norm.sacrifices
        var surface = "我照这条做。"
        if not accepted:
            verb = "decline"
            promotes = norm.sacrifices
            sacrifices = norm.promotes
            surface = "这条我不认。"
        let id = rt_cat(actor, rt_cat(".c2.", rt_cat(verb, rt_cat(".", norm.id))))
        let grants = dv_pair(c2_own(actor, rt_cat("decided.", norm.id)), c2_own(actor, rt_cat("accepted.", norm.id)))
        let speech = dv_with(c1_speech(dv_true(), norm.source, "personal-norm-decision"), "surface", surface)
        let choice = {"group": rt_cat("norm.", norm.id), "requires": known, "prohibits": dv_fact(c2_own(actor, rt_cat("decided.", norm.id)), true), "promotes": promotes, "sacrifices": sacrifices, "basis": [norm.source]}
        var supported_choice = choice
        if accepted:
            supported_choice = dv_with(choice, "require_positive", true)
        rt_push(result, dv_with_many(c2_action(id, "talk", known, dv_all([c2_alive(actor), dv_fact(c2_own(actor, rt_cat("decided.", norm.id)), false)]), id, grants, surface, norm.source), {"speech": speech, "listeners": c2_people(), "personal_choice": supported_choice, "norm_decision": {"id": norm.id, "accepted": accepted, "norm": norm}}))
        accepted = false
        n = n + 1
    return result

fn c2_station_room(station):
    if station == "weight":
        return "archive_weight"
    if station == "lock":
        return "archive_lock"
    return "central_hall"

axiom c2_station_claim_law(actor, station, guarding):
    let field = rt_cat(station, "_owner")
    var capable = dv_fact(c2_own(actor, rt_cat("can_", station)), true)
    var effects = dv_pair(dv_assign(c2_ref("c2.archive", field), actor), dv_assign(c2_own(actor, "station"), station))
    if guarding:
        capable = dv_fact(c2_own(actor, "guard_commitment"), true)
    if station == "weight":
        var mode = "lift"
        if guarding:
            mode = "guard"
        rt_push(effects, dv_assign(c2_ref("c2.archive", "weight_mode"), mode))
    return dv_axiom("c2_station_claim_law", 1, dv_all([c2_at(actor, c2_station_room(station)), dv_fact(c2_ref("c2.archive", field), ""), dv_fact(c2_own(actor, "station"), ""), capable, c2_alive(actor)]), effects)

axiom c2_station_release_law(actor, station):
    let field = rt_cat(station, "_owner")
    return dv_axiom("c2_station_release_law", 1, dv_all(dv_pair(dv_fact(c2_ref("c2.archive", field), actor), dv_fact(c2_own(actor, "station"), station))), dv_pair(dv_assign(c2_ref("c2.archive", field), ""), dv_assign(c2_own(actor, "station"), "")))

axiom c2_archive_open_law(weight, lock, signal):
    return dv_axiom("c2_archive_open_law", 1, dv_all([dv_fact(c2_ref("c2.archive", "open"), false), dv_fact(c2_ref("c2.archive", "weight_owner"), weight), dv_fact(c2_ref("c2.archive", "weight_mode"), "lift"), dv_fact(c2_ref("c2.archive", "lock_owner"), lock), dv_fact(c2_ref("c2.archive", "relay_owner"), signal), c1_at(weight, "archive_weight"), c1_at(lock, "archive_lock"), c1_at(signal, "central_hall"), dv_fact(c2_own(weight, "station"), "weight"), dv_fact(c2_own(lock, "station"), "lock"), dv_fact(c2_own(signal, "station"), "relay"), c2_alive(weight), c2_alive(lock), c2_alive(signal)]), dv_single(dv_assign(c2_ref("c2.archive", "open"), true)))

axiom c2_guard_commit_law(actor):
