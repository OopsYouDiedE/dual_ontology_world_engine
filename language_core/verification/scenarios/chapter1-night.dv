// First evening opportunities: time opens actions, never performs them.
// Numeric provisions are engineering serving units; no earlier stock history is asserted.
fn c1n_ref(field):
    return dv_ref("night.first", "state", field)

fn c1n_source(id):
    return c1_source("language_core/verification/scenarios/chapter1-night.dv", 0, rt_cat("authorized-first-night-20261016.", id))

fn c1n_mark(id):
    return c1n_ref(rt_cat("done.", id))

fn c1n_row(actor, id, start, end, when, text):
    return {"actor": actor, "id": rt_cat("night.", id), "start": start, "end": end, "when": when, "text": text, "kind": "talk", "effects": [], "grants": [], "literal": dv_true()}

fn c1n_rows():
    let key = ["authored-declaration", "c1n_rows"]
    let cached = rt_memo_get([], key)
    if cached[0]:
        return cached[1]
    return rt_memo_put([], key, c1n_rows_build())

fn c1n_rows_build():
    var rows = []
    let meet = dv_all([c1_at("detective", "living_hall"), c1_at("huo", "living_hall"), c1_at("shen", "living_hall")])
    rt_push(rows, c1n_row("quer", "greeting", 750, 810, meet, "老霍！沈叔！……咦，我怎么张嘴就这么叫了？"))
    rt_push(rows, c1n_row("shen", "apron", 750, 810, c1_at("quer", "living_hall"), "沈鼎摸了摸围裙口袋，摸出一点零嘴，递向雀儿。"))
    var show = c1n_row("ward", "show-evidence", 840, 930, dv_all([dv_fact(c1_other_ref("contract", "evidence_complete"), true), dv_fact(c1_other_ref("contract", "keys_found"), true), dv_fact(c1_other_ref("contract", "wax_ash_seen"), true)]), "沃德摊开半角红纸，又放下管网图的蜡布筒：先限制雀儿的自由，待事情查明。")
    show = dv_with_many(show, {"kind": "help", "effects": [dv_assign(dv_ref("night.evidence", "state", "displayed"), true)], "grants": [dv_ref("night.evidence", "state", "displayed")], "public_observers": c2_people(), "public_grants": [dv_ref("night.evidence", "state", "displayed")]})
    rt_push(rows, show)
    let inspected = dv_all([dv_fact(dv_ref("night.evidence", "state", "wax_seal_intact"), true), dv_fact(dv_ref("night.evidence", "state", "fresh_torn_edge"), true)])
    rt_push(rows, c1n_row("detective", "defer-judgment", 840, 930, inspected, "蜡布筒的火漆封口完好，红纸毛边却是新撕的。另一半多半仍在文献工房；明日到现场勘验，再作判断。"))
    var defer = c1n_row("gu", "corroborate", 840, 930, dv_true(), "孤证不立。待明日去文献工房，把另一半找来核对。")
    defer = dv_with(defer, "received", {"speaker": "detective", "action_id": "night.defer-judgment"})
    rt_push(rows, defer)
    rt_push(rows, c1n_row("detective", "ask-closed-doors", 960, 1101, dv_true(), "丙区、丁区里的人怎么样了？伤者还好吗？"))
    var count = c1n_row("shen", "count-provisions", 1110, 1230, dv_true(), "实际清点甲乙两区带来的余粮，按八份备餐用量记账。")
    count = dv_with_many(count, {"kind": "inspect", "effects": [dv_assign(dv_ref("night.provisions", "state", "counted"), true)], "grants": [dv_ref("night.provisions", "state", "counted"), dv_ref("night.provisions", "state", "bread"), dv_ref("night.provisions", "state", "onion"), dv_ref("night.provisions", "state", "meat")]})
    rt_push(rows, count)
    var cook = c1n_row("shen", "cook", 1110, 1230, dv_all([dv_fact(dv_ref("night.provisions", "state", "counted"), true), dv_at_least(dv_ref("night.provisions", "state", "bread"), 8), dv_at_least(dv_ref("night.provisions", "state", "onion"), 8), dv_at_least(dv_ref("night.provisions", "state", "meat"), 8)]), "沈鼎用甲乙两区清点出的余粮，烤面包，煮洋葱碎肉汤，备出八人份。")
    cook = dv_with_many(cook, {"kind": "help", "effects": [dv_increment(dv_ref("night.provisions", "state", "bread"), -8), dv_increment(dv_ref("night.provisions", "state", "onion"), -8), dv_increment(dv_ref("night.provisions", "state", "meat"), -8), dv_assign(dv_ref("night.provisions", "state", "evening_servings"), 8)], "grants": [dv_ref("night.provisions", "state", "bread"), dv_ref("night.provisions", "state", "onion"), dv_ref("night.provisions", "state", "meat"), dv_ref("night.provisions", "state", "evening_servings"), dv_ref("night.provisions", "state", "consumed")], "public_observers": c2_people(), "public_grants": [dv_ref("night.provisions", "state", "evening_servings"), dv_ref("night.provisions", "state", "consumed")]})
    rt_push(rows, cook)
    rt_push(rows, c1n_row("quer", "cold-hand", 1260, 1440, c1_at("detective", "living_hall"), "壁炉边，雀儿压低声音：递钥匙的那只手，很凉。那人说，‘别让它落进下面那东西手里。’我只知道自己听到了这句话。"))
    var partner = c1n_row("quer", "partner", 1260, 1440, c1_at("detective", "living_hall"), "明日一起去文献工房。我替你开学园里的锁，咱们搭档，怎么样？")
    partner = dv_with_many(partner, {"effects": [dv_assign(c1n_ref("partner_offered"), true)], "grants": [c1n_ref("partner_offered")]})
    rt_push(rows, partner)
    var accept = c1n_row("detective", "accept-partner", 1260, 1440, c1_at("quer", "living_hall"), "好。明日先去文献工房，到了现场再核对。")
    accept = dv_with_many(accept, {"received": {"speaker": "quer", "action_id": "night.partner"}, "effects": [dv_assign(c1n_ref("partner_promised"), true)], "grants": [c1n_ref("partner_promised")]})
    rt_push(rows, accept)
    rt_push(rows, c1n_row("huo", "watch-offer", 1260, 1440, c1_at("detective", "living_hall"), "夜里总得有人醒着。我跟你分班，先把这一夜守过去。"))
    var watch = c1n_row("detective", "watch-agree", 1260, 1440, c1_at("huo", "living_hall"), "我们分班守夜。交班时把听见、看见的事情说清楚。")
    watch = dv_with_many(watch, {"received": {"speaker": "huo", "action_id": "night.watch-offer"}, "effects": [dv_assign(c1n_ref("watch_agreed"), true)], "grants": [c1n_ref("watch_agreed")], "public_grants": [c1n_ref("watch_agreed")]})
    rt_push(rows, watch)
    let diners = ["detective", "huo", "shen", "su", "quer", "ward", "gu", "lucian"]
    var diner_index = 0
    while diner_index < rt_count(diners):
        let diner = diners[diner_index]
        var meal = c1n_row(diner, rt_cat("eat.", diner), 1110, 1260, dv_at_least(dv_ref("night.provisions", "state", "evening_servings"), 1), "取一份烤面包和洋葱碎肉汤，用过晚餐。")
        meal = dv_with_many(meal, {"kind": "help", "effects": [dv_increment(dv_ref("night.provisions", "state", "evening_servings"), -1), dv_increment(dv_ref("night.provisions", "state", "consumed"), 1)], "grants": [dv_ref("night.provisions", "state", "evening_servings"), dv_ref("night.provisions", "state", "consumed")], "public_observers": c2_people(), "public_grants": [c1n_mark(meal.id)]})
        rt_push(rows, meal)
        diner_index = diner_index + 1
    var first_watch = c1n_row("huo", "first-watch", 1320, 1440, dv_fact(c1n_ref("watch_agreed"), true), "霍铎留在壁炉旁守前半夜，留意门口和走廊里的实际动静。")
    first_watch = dv_with(first_watch, "kind", "help")
    rt_push(rows, first_watch)
    var second_watch = c1n_row("detective", "second-watch", 1440, 1800, dv_fact(c1n_ref("watch_agreed"), true), "侦探接过后半夜的守候，核对门口和走廊里的动静。")
    second_watch = dv_with(second_watch, "kind", "help")
    rt_push(rows, second_watch)
    return rows

fn c1n_pre(row):
    return dv_all([c1_at(row.actor, "living_hall"), c2_window(1, row.start, row.end), row.when, dv_fact(c1n_mark(row.id), false)])

axiom c1n_law(row):
    return dv_axiom("c1n_law", 1, c1n_pre(row), dv_append(row.effects, dv_assign(c1n_mark(row.id), true)))

fn c1n_action(row):
    var action = c2_action(row.id, row.kind, c1n_pre(row), c1n_pre(row), row.id, dv_append(row.grants, c1n_mark(row.id)), row.text, c1n_source(row.id))
    action = dv_with(action, "predict_law", row.id)
    if row.kind == "talk":
        var listeners = []
        let people = c2_people()
        var listener_index = 0
        while listener_index < rt_count(people):
            if people[listener_index] != row.actor:
                rt_push(listeners, people[listener_index])
            listener_index = listener_index + 1
        action = dv_with_many(action, {"speech": dv_with_many(c1_speech(row.literal, c1n_source(row.id), "personally-owned-evening-statement"), {"surface": row.text, "channel": "local"}), "listeners": listeners})
    if dv_has_key(row, "public_grants"):
        action = dv_with(action, "public_grants", row.public_grants)
    if dv_has_key(row, "public_observers"):
        action = dv_with(action, "public_observers", row.public_observers)
    if dv_has_key(row, "received"):
        action = dv_with(action, "received_speech_requirement", row.received)
    return action

fn c1n_inspections(actor):
    if actor == "demon":
        return []
    let here = c1_at(actor, "living_hall")
    var actions = []
    rt_push(actions, dv_with(c2_action(rt_cat("night.inspect-room.", actor), "inspect", here, here, "", [c1n_ref("watch_agreed"), dv_ref("night.provisions", "state", "evening_servings")], "查看公共备餐和守夜交班的实际情况。", c1n_source("room-status")), "repeatable", true))
    if actor == "detective":
        let pre = dv_all([here, dv_fact(dv_ref("night.evidence", "state", "displayed"), true)])
        rt_push(actions, c2_action("night.inspect-evidence", "inspect", pre, pre, "", [dv_ref("night.evidence", "state", "displayed"), dv_ref("night.evidence", "state", "wax_seal_intact"), dv_ref("night.evidence", "state", "fresh_torn_edge")], "近看蜡布筒的火漆封口与红纸的新撕毛边。", c1n_source("inspect-evidence")))
    if actor == "detective":
        rt_push(actions, c2_action("night.inspect-displayed", "inspect", here, here, "", [dv_ref("night.evidence", "state", "displayed")], "查看沃德是否已把证物摆在面前。", c1n_source("displayed")))
    let call_source = c1n_source("personally-heard-midnight-copper-call")
    let night_when = dv_all([c2_window(1, 1440, 1800), dv_fact(c1n_night_seen_ref(actor), true)])
    let notice_id = rt_cat(actor, ".night.notice-time")
    let notice_when = dv_all([c1_at(actor, "living_hall"), c2_window(1, 1440, 1800)])
    rt_push(actions, dv_with(c2_action(notice_id, "inspect", notice_when, notice_when, notice_id, [c1_other_clock_ref(), c1n_night_seen_ref(actor)], "留意起居厅里此刻的光线与时钟，确认已经入夜。", c1n_source("own-observed-midnight-time")), "predict_law", notice_id))
    let call_ref = c1n_call_ref(actor)
    let call_id = rt_cat(actor, ".night.hear-private-call")
    let call_when = dv_all([c1_at(actor, "living_hall"), night_when, dv_fact(call_ref, false)])
    var call = c2_action(call_id, "inspect", call_when, call_when, call_id, [call_ref], "铜口深处有个声音，低低唤着你。那种熟悉感只落进你自己的耳中。", call_source)
    call = dv_with_many(call, {"predict_law": call_id, "night_call_requirement": {"basis": [call_source], "night_when": night_when}, "sensory_mode": "private-night-copper-call", "grant_observation_sources": [{"ref": call_ref, "source": "perception", "origin": "personally-heard-midnight-copper-call", "trust": 1}], "purpose_refs": [call_ref]})
    rt_push(actions, call)
    return actions

fn c1n_goals(actor):
    if actor.id == "demon":
        return []
    var goals = []
    let rows = c1n_rows()
    var i = 0
    while i < rt_count(rows):
        let row = rows[i]
        if row.actor == actor.id:
            if row.kind == "talk":
                rt_push(goals, {"kind": "communicate", "scope": "personal", "method_id": row.id, "available_when": c1n_pre(row), "requires_argument": false, "basis": [c1n_source(row.id)]})
            else:
                rt_push(goals, c2_goal(dv_fact(c1n_mark(row.id), true), c1n_pre(row), [c1n_source(row.id)]))
        i = i + 1
    let inspections = c1n_inspections(actor.id)
    i = 0
    while i < rt_count(inspections):
        let action = inspections[i]
        var j = 0
        while j < rt_count(action.grants):
            var goal = c2_observation_goal(action.grants[j], action.precondition, action.source_refs, 0)
            if action.id == rt_cat("night.inspect-room.", actor.id):
                // Recheck only after related received activity, never after the
                // inspection's own timestamp or an unrelated observation.
                let triggers = [c1n_mark("night.watch-agree"), c1n_mark("night.cook")]
                goal = dv_with_many(goal, {"refresh_until": dv_not(dv_true()), "refresh_refs": triggers})
            rt_push(goals, goal)
            j = j + 1
        i = i + 1
    return goals

fn c1n_refresh_actor_goals(actor):
    if not dv_has_key(actor.policy, "first_night_goals"):
        var combined = dv_clone(dv_find(actor.policy, "first_night_base_goals", actor.policy.goals))
        let goals = c1n_goals(actor)
        var i = 0
        while i < rt_count(goals):
            rt_push(combined, goals[i])
            i = i + 1
        actor = dv_with(actor, "policy", dv_with_many(actor.policy, {"goals": combined, "first_night_goals": goals}))
    return c1n_known_future_wait_actor(actor)

fn c1n_morning_ready(world):
    return world.time >= 1800

fn c1n_install_scene(scene):
    if dv_find(scene, "first_night_installed", false):
        return scene
    let rows = c1n_rows()
    var fields = {"partner_offered": dv_field(false), "partner_promised": dv_field(false), "watch_agreed": dv_field(false)}
    var i = 0
    while i < rt_count(rows):
        fields = dv_with(fields, rt_cat("done.", rows[i].id), dv_field(false))
        i = i + 1
    let objects = [c1_state_object("night.first", fields), c1_state_object("night.evidence", {"displayed": dv_field(false), "wax_seal_intact": dv_field(true), "fresh_torn_edge": dv_field(true)}), c1_state_object("night.provisions", {"counted": dv_field(false), "bread": dv_field(8), "onion": dv_field(8), "meat": dv_field(8), "evening_servings": dv_field(0), "consumed": dv_field(0)})]
    var physical = scene.physical
    var bindings = dv_clone(scene.bindings)
    i = 0
    while i < rt_count(objects):
        physical = c2_add_new(physical, objects[i])
        i = i + 1
    i = 0
    while i < rt_count(rows):
        physical = dv_adopt(physical, c1_method(rows[i].id, c1n_law(rows[i])), "enforce", 1, [c1n_source(rows[i].id)])
        i = i + 1
    var costs = dv_clone(scene.cost_model)
    let durations = c1n_wait_durations()
    var duration_index = 0
    while duration_index < rt_count(durations):
        let minutes = durations[duration_index]
        costs = dv_with(costs, c1n_wait_kind(minutes), c1_cost(minutes, c1n_source("bounded-wait-engineering-duration")))
        duration_index = duration_index + 1
    var actors = []
    i = 0
    while i < rt_count(scene.actors):
        var actor = scene.actors[i]
        var mind = actor.mind
        var j = 0
        while j < rt_count(objects):
            mind = c2_add_new(mind, c1_local_object(objects[j].id))
            if dv_local(bindings, objects[j].id, actor.id) == "":
                rt_push(bindings, dv_binding(objects[j].id, objects[j].id, actor.id))
            j = j + 1
        let call_object = rt_cat("night.call.", actor.id)
        physical = c2_add_new(physical, c1_state_object(call_object, {"heard": dv_field(false), "night_observed": dv_field(false)}))
        mind = c2_add_new(mind, c1_local_object(call_object))
        mind = dv_store(mind, c1n_call_ref(actor.id), dv_with(dv_field(false), "basis", [c1n_source("own-night-call-not-yet-heard")]))
        if dv_local(bindings, call_object, actor.id) == "":
            rt_push(bindings, dv_binding(call_object, call_object, actor.id))
        let notice_id = rt_cat(actor.id, ".night.notice-time")
        physical = dv_adopt(physical, c1_method(notice_id, c1n_night_seen_law(actor.id)), "enforce", 1, [c1n_source("own-observed-midnight-time")])
        mind = dv_adopt(mind, c1_method(notice_id, c1n_night_seen_law(actor.id)), "predict", 1, [c1n_source("own-observed-midnight-time")])
        let call_id = rt_cat(actor.id, ".night.hear-private-call")
        physical = dv_adopt(physical, c1_method(call_id, c1n_call_law(actor.id)), "enforce", 1, [c1n_source("personally-heard-midnight-copper-call")])
        mind = dv_adopt(mind, c1_method(call_id, c1n_call_law(actor.id)), "predict", 1, [c1n_source("personally-heard-midnight-copper-call")])
        let wait_id = rt_cat("night.wait.", actor.id)
        physical = c2_add_new(physical, c1_state_object(wait_id, {"elapsed": dv_field(0)}))
        mind = c2_add_new(mind, c1_local_object(wait_id))
        mind = dv_store(mind, c1n_wait_ref(actor.id), dv_with(dv_field(0), "basis", [c1n_source("own-wait-account-initial")]))
        if dv_local(bindings, wait_id, actor.id) == "":
            rt_push(bindings, dv_binding(wait_id, wait_id, actor.id))
        duration_index = 0
        while duration_index < rt_count(durations):
            let minutes = durations[duration_index]
            let wait_method = c1n_wait_id(actor.id, minutes)
            physical = dv_adopt(physical, c1_method(wait_method, c1n_wait_law(actor.id, minutes)), "enforce", 1, [c1n_source("own-bounded-wait")])
            mind = dv_adopt(mind, c1_method(wait_method, c1n_wait_law(actor.id, minutes)), "predict", 1, [c1n_source("own-bounded-wait")])
            duration_index = duration_index + 1
        var actions = dv_clone(actor.actions)
        var hearing = dv_clone(dv_find(actor, "hearing_grants", []))
        let people = c2_people()
        j = 0
        while j < rt_count(people):
            if people[j] != actor.id:
                mind = c2_add_new(mind, c1_local_object(people[j]))
                if dv_local(bindings, people[j], actor.id) == "":
                    rt_push(bindings, dv_binding(people[j], people[j], actor.id))
                rt_push(hearing, {"speaker": people[j], "channel": "local", "available_when": c1_at(actor.id, "living_hall"), "sender_locations": ["living_hall"], "listener_locations": ["living_hall"], "basis": [c1n_source("actual-co-present-evening-speech")]})
            j = j + 1
        j = 0
        while j < rt_count(rows):
            let row = rows[j]
            if row.actor == actor.id:
                mind = dv_store(mind, c1n_mark(row.id), dv_field(false))
                mind = dv_adopt(mind, c1_method(row.id, c1n_law(row)), "predict", 1, [c1n_source(row.id)])
                rt_push(actions, c1n_action(row))
            j = j + 1
        let inspect = c1n_inspections(actor.id)
        j = 0
        while j < rt_count(inspect):
            rt_push(actions, inspect[j])
            j = j + 1
        actor = dv_with_many(actor, {"mind": mind, "actions": c1_public_methods(actions), "hearing_grants": hearing, "policy": dv_with(actor.policy, "first_night_base_goals", actor.policy.goals)})
        rt_push(actors, c1n_refresh_actor_goals(actor))
        i = i + 1
    return dv_with_many(scene, {"physical": physical, "actors": actors, "bindings": bindings, "cost_model": costs, "first_night_installed": true})

// These are finite costed action lengths, not speed multipliers or world-clock writes.
fn c1n_wait_durations():
    return [180, 120, 60, 30, 15, 5, 1]

fn c1n_wait_kind(minutes):
    return rt_cat("wait.first_night.", rt_show(minutes))

fn c1n_wait_id(actor, minutes):
    return rt_cat(rt_cat(actor, "."), c1n_wait_kind(minutes))

fn c1n_wait_ref(actor):
    return dv_ref(rt_cat("night.wait.", actor), "state", "elapsed")

axiom c1n_wait_law(actor, minutes):
    return dv_axiom("c1n_wait_law", 1, dv_true(), [dv_increment(c1n_wait_ref(actor), minutes)])

// Callers must supply a future opportunity from this actor's own authored intention
// or actual received information, never another mind or a physical future fact.
// The ordinary decision comparison remains responsible for choosing this action.
fn c1n_known_wait_actor(actor, target, basis):
    var actions = []
    var i = 0
    while i < rt_count(actor.actions):
        if not dv_find(actor.actions[i], "known_opportunity_wait", false):
            rt_push(actions, actor.actions[i])
        i = i + 1
    var goals = []
    let existing = dv_find(actor.policy, "goals", [])
    i = 0
    while i < rt_count(existing):
        if not dv_find(existing[i], "known_opportunity_wait", false):
            rt_push(goals, existing[i])
        i = i + 1
    let elapsed = dv_read(actor.mind, c1n_wait_ref(actor.id))
    let progress_weight = dv_find(actor.policy, "progress_weight", 1)
    let time_cost = dv_find(actor.policy, "time_cost", 0.01)
    var current_night_action = false
    let rows = c1n_rows()
    i = 0
    while i < rt_count(rows):
        if rows[i].actor == actor.id and dv_truth(actor.mind, c1n_pre(rows[i])) == "true":
            current_night_action = true
        i = i + 1
    if elapsed.known and actor.mind.time < target and 0 < rt_count(basis) and 0 < progress_weight and not current_night_action:
        let durations = c1n_wait_durations()
        var minutes = 0
        i = 0
        var wait_chunk_limit = dv_find(actor.policy, "wait_chunk_limit", 180)
        if actor.mind.time < 900 and dv_has(["detective", "huo", "shen", "su", "quer", "ward", "gu", "lucian"], actor.id) and dv_truth(actor.mind, c1_at(actor.id, "living_hall")) == "true":
            wait_chunk_limit = 60
            if actor.mind.time >= 810 and actor.mind.time < 900:
                wait_chunk_limit = 30
        while i < rt_count(durations):
            if minutes == 0 and durations[i] >= 15 and durations[i] <= wait_chunk_limit and actor.mind.time + durations[i] <= target + 14:
                minutes = durations[i]
            i = i + 1
        // Arrive within fourteen minutes after the known opportunity starts;
        // completion does not claim an exact appointment arrival.
        if minutes == 0:
            minutes = 15
        if 0 < minutes:
            let id = c1n_wait_id(actor.id, minutes)
            let known = dv_true()
            let result = dv_at_least(c1n_wait_ref(actor.id), elapsed.value + minutes)
            let text = rt_cat(rt_cat("留在原处，等候本人已知的下一次作息机会（", rt_show(minutes)), "分钟）。")
            let action = c2_action(id, c1n_wait_kind(minutes), known, dv_true(), id, [c1n_wait_ref(actor.id), c1_other_clock_ref()], text, c1n_source("own-bounded-wait"))
            rt_push(actions, c1_public_method(dv_with_many(action, {"predict_law": id, "repeatable": true, "known_opportunity_wait": true, "wait_until": target, "wait_basis": basis})))
            // Engineering preference: knowingly spend this time for the next
            // personally declared opportunity. Reimburse its ordinary time score
            // and retain only .01 net utility; other actions compete unchanged.
            let net_utility = 0.01
            let wait_value = (minutes * time_cost + net_utility) / progress_weight
            rt_push(goals, dv_with_many(c2_goal(result, known, basis), {"weight": wait_value, "known_opportunity_wait": true, "wait_valuation": {"role": "engineering-personal-willingness-to-wait", "time_opportunity_cost": minutes * time_cost, "net_utility": net_utility, "progress_weight": progress_weight, "future_outcome": "unknown"}}))
    var policy = dv_with(actor.policy, "goals", goals)
    if actor.mind.time < 1440 and dv_has(["detective", "huo", "shen", "su", "quer", "ward", "gu", "lucian"], actor.id) and dv_truth(actor.mind, c1_at(actor.id, "living_hall")) == "true":
        if not dv_has_key(policy, "first_night_plan_depth"):
            policy = dv_with(policy, "first_night_plan_depth", dv_find(policy, "plan_depth", 2))
        policy = dv_with_many(policy, {"plan_depth": 1, "first_night_plan_active": true})
    else:
        if dv_find(policy, "first_night_plan_active", false):
            policy = dv_with_many(policy, {"plan_depth": policy.first_night_plan_depth, "first_night_plan_active": false})
    return dv_with_many(actor, {"actions": actions, "policy": policy})

// Only positive lower bounds in the actor's declared goal conditions qualify.
// A negated bound denotes an upper limit, so its subtree is deliberately opaque.
fn c1n_positive_clock_bounds(condition):
    var result = []
    let op = dv_find(condition, "op", "")
    if op == "at_least":
        if dv_same(condition.ref, c1_other_clock_ref()):
            rt_push(result, condition.value)
    if op == "all":
        let items = dv_find(condition, "items", [])
        var i = 0
        while i < rt_count(items):
            let nested = c1n_positive_clock_bounds(items[i])
            var j = 0
            while j < rt_count(nested):
                rt_push(result, nested[j])
                j = j + 1
            i = i + 1
    return result

// Time alone may open a known opportunity. All remaining conditions must
// already hold in the owner's mind, including being at its execution site.
fn c1n_without_clock(condition):
    let op = dv_find(condition, "op", "")
    if dv_record_like(condition) and dv_has_key(condition, "ref") and dv_find(condition.ref, "object", "") == "c2.weather":
        return dv_true()
    if op == "at_least" and dv_same(condition.ref, c1_other_clock_ref()):
        return dv_true()
    if op == "not":
        let inner = dv_find(condition, "item", false)
        if inner != false and dv_record_like(inner) and dv_has_key(inner, "ref") and dv_find(inner.ref, "object", "") == "c2.weather":
            return dv_true()
        if inner != false and dv_find(inner, "op", "") == "at_least" and dv_same(inner.ref, c1_other_clock_ref()):
            return dv_true()
    if op == "all":
        var items = []
        var i = 0
        while i < rt_count(condition.items):
            rt_push(items, c1n_without_clock(condition.items[i]))
            i = i + 1
        return dv_all(items)
    return condition

fn c1n_future_goal_pending(actor, goal):
    let kind = dv_find(goal, "kind", "")
    if kind == "achieve":
        return dv_truth(actor.mind, goal.proposition) != "true"
    if kind == "communicate":
        return not dv_has(dv_find(actor, "completed_actions", []), dv_find(goal, "method_id", ""))
    if kind == "know" or kind == "evidence":
        return not dv_uncontested(dv_read(actor.mind, goal.ref))
    return false

// Static syntax metadata is built with the goal, never from physical future state.
fn c1n_index_goal_window(goal):
    let condition = dv_find(goal, "available_when", dv_true())
    let key = ["c1n_goal_window"]
    let cached = rt_memo_get(condition, key)
    var window = []
    if cached[0]:
        window = cached[1]
    else:
        window = rt_memo_put(condition, key, {"future_clock_condition": condition, "future_clock_bounds": c1n_positive_clock_bounds(condition), "future_nonclock": c1n_without_clock(condition)})
    return dv_with_many(goal, window)

fn c1n_known_future_wait_actor(actor):
    if actor.id == "demon" and not dv_has_key(actor.policy, "chapter2_profile"):
        return actor
    var target = -1
    var basis = []
    let goals = dv_find(actor.policy, "goals", [])
    var i = 0
    while i < rt_count(goals):
        let goal = goals[i]
        let own_basis = dv_find(goal, "basis", [])
        if not dv_find(goal, "known_opportunity_wait", false) and 0 < rt_count(own_basis):
            var indexed = goal
            if not dv_has_key(goal, "future_clock_bounds") or not dv_same(dv_find(goal, "future_clock_condition", false), dv_find(goal, "available_when", dv_true())):
                indexed = c1n_index_goal_window(goal)
            let bounds = indexed.future_clock_bounds
            var candidate = -1
            var j = 0
            while j < rt_count(bounds):
                if actor.mind.time < bounds[j] and (candidate < 0 or bounds[j] < candidate):
                    candidate = bounds[j]
                j = j + 1
            if candidate >= 0 and (target < 0 or candidate < target) and c1n_future_goal_pending(actor, goal) and dv_truth(actor.mind, indexed.future_nonclock) == "true":
                target = candidate
                basis = dv_append(own_basis, {"kind": "own-declared-future-opportunity", "condition": goal.available_when, "scope": "time-opportunity-only-not-future-success"})
        i = i + 1
    if 0 <= target:
        return c1n_known_wait_actor(actor, target, basis)
    // Also removes a previous waiting candidate when its opportunity is no longer future.
    return c1n_known_wait_actor(actor, actor.mind.time, [])

fn c1n_call_ref(actor):
    return dv_ref(rt_cat("night.call.", actor), "state", "heard")

axiom c1n_call_law(actor):
    return dv_axiom("c1n_call_law", 1, dv_all([c1_at(actor, "living_hall"), c2_window(1, 1440, 1800), dv_fact(c1n_night_seen_ref(actor), true), dv_fact(c1n_call_ref(actor), false)]), [dv_assign(c1n_call_ref(actor), true)])

fn c1n_night_seen_ref(actor):
    return dv_ref(rt_cat("night.call.", actor), "state", "night_observed")

axiom c1n_night_seen_law(actor):
    return dv_axiom("c1n_night_seen_law", 1, dv_all([c1_at(actor, "living_hall"), c2_window(1, 1440, 1800)]), [dv_assign(c1n_night_seen_ref(actor), true)])
