// One world and the same session mechanism for all sixteen residents.
fn c1_campaign_scene():
    var scene = c1_opening_install_scene(c1_hist_install_scene(c1_scenario_native()), "侦探")
    scene = c1_other_groups_install_scene(scene)
    var physical = dv_add_object(scene.physical, c1_state_object("campaign.clock", {"minute": dv_field(scene.physical.time)}))
    physical = dv_add_object(physical, c1_state_object("campaign.access", {"living": dv_field(true), "contract": dv_field(false), "astral": dv_field(false), "logistics": dv_field(false)}))
    var actors = []
    var limit = 0
    var i = 0
    while i < rt_count(scene.actors):
        var actor = scene.actors[i]
        if actor.id == "demon":
            var goals = dv_find(actor.policy, "goals", [])
            let groups = ["contract", "astral", "logistics"]
            var j = 0
            while j < rt_count(groups):
                let action = c1_other_open_action(groups[j], "demon")
                rt_push(goals, {"kind": "communicate", "scope": "personal", "method_id": action.id, "available_when": action.precondition, "requires_argument": false, "basis": [c1_other_case(groups[j]).source]})
                j = j + 1
            actor = dv_with(actor, "policy", dv_with(actor.policy, "goals", goals))
        rt_push(actors, actor)
        limit = limit + actor.policy.budget
        i = i + 1
    return dv_with_many(c1_active_configuration(scene), {"physical": physical, "actors": actors, "max_actions": limit, "clock_ref": c1_other_clock_ref()})
