// Source module: language_core/game/player-content.dv
// Presentation migrated from the existing first-chapter authored cards and routes.
// Labels offer an interaction, not its unobserved result. Card prose is post-execution only.
fn c1_ui_ends(text, suffix):
    return rt_length(suffix) <= rt_length(text) and rt_slice(text, rt_length(text) - rt_length(suffix), rt_length(suffix)) == suffix

fn c1_player_scene(scene):
    var actors = []
    var i = 0
    while i < rt_count(scene.actors):
        let actor = scene.actors[i]
        var actions = []
        var j = 0
        while j < rt_count(actor.actions):
            rt_push(actions, c1_player_display(actor.actions[j]))
            j = j + 1
        rt_push(actors, dv_with(actor, "actions", actions))
        i = i + 1
    return dv_with(scene, "actors", actors)

fn c1_player_display(action):
    var result = action
    if action.kind == "move" and dv_has_key(action, "travel"):
        let rooms = {"R05": "自己的卧室", "R06": "霍铎的卧室", "R07": "沈鼎的卧室", "R08": "苏泠的卧室", "hall": "活动厅", "foyer": "门厅", "pantry": "茶水间", "corridor": "走廊"}
        if dv_has_key(rooms, action.travel.to):
            result = dv_with(result, "label", rt_cat("前往", dv_get(rooms, action.travel.to)))
    let cards = [
        {"id": "E1", "title": "隔离门", "text": c1_visible_E1()},
        {"id": "E2", "title": "墙角的木楔与门底的灰", "text": c1_visible_E2()},
        {"id": "E3", "title": "灰上的鞋印", "text": c1_visible_E3()},
        {"id": "E4", "title": "门底的湿布", "text": c1_visible_E4()},
        {"id": "E5", "title": "地上的音叉", "text": c1_visible_E5()},
        {"id": "E6", "title": "书桌上的乐谱", "text": c1_visible_E6()},
        {"id": "E7", "title": "长桌上的石板", "text": c1_visible_E7()},
        {"id": "E8", "title": "铜口", "text": c1_visible_E8()},
        {"id": "E9", "title": "水槽里的杯子", "text": c1_visible_E9()},
        {"id": "E10", "title": "碗柜上的罐子", "text": c1_visible_E10()},
        {"id": "E11", "title": "书架", "text": c1_visible_E11()},
        {"id": "E12", "title": "风衣", "text": c1_visible_E12()}]
    var i = 0
    while i < rt_count(cards):
        let card = cards[i]
        if c1_ui_ends(action.id, rt_cat(".inspect.", card.id)):
            result = dv_with_many(result, {"label": rt_cat("检视", card.title), "presentation": c1_op_presentation("detective", "visible-inspection", [card.text])})
        i = i + 1
    let named = {".opening.wake": "回想醒来前的事", ".opening.empty-slot": "查看自己的标签柜", ".opening.wear-coat": "穿上风衣", ".identify-own-lens": "辨认自己的放大镜", ".replay": "在手稿上重演昨夜", ".sound_trial": "进行声路试验", ".reask_question": "询问当前的问题", ".compare_sole": "查看自己的鞋底", ".loss_testimony": "请苏泠说说声路试验中的所闻", ".talk.slate_code": "询问石板刻痕", ".talk.slate_person": "询问石板上的人形线条", ".talk.frame_hollow": "询问门框的声响", ".talk.cups_known": "询问杯子的摆放", ".talk.starter_kept": "询问罐中留存的酵头", ".talk.recalled_copper": "询问关于铜口的记忆", ".talk.recalled_names": "询问关于姓名的记忆"}
    i = 0
    while i < rt_count(named):
        if c1_ui_ends(action.id, named[i][0]):
            result = dv_with(result, "label", named[i][1])
        i = i + 1
    if c1_ui_ends(action.id, ".touch_latch"):
        result = dv_with(result, "label", "走近并触碰插闩")
    if action.kind == "answer":
        let answers = {"me": "闩门的是我", "V1_0": "苏泠在卧室", "V1_1": "苏泠在活动厅", "V1_2": "苏泠在备餐间", "V3_0": "声音来自铜口在墙内与门框处的管道漏音", "V3_1": "门外有人呼喊", "V4_0": "喊的是闩门，别开", "V4_1": "喊的是开门", "trust": "说明为何信任霍铎的速记并闩门"}
        let id = dv_find(action, "answer_id", "")
        if dv_has_key(answers, id):
            result = dv_with(result, "label", rt_cat("答辩：", dv_get(answers, id)))
    if c1_ui_ends(action.id, ".reask_question"):
        let questions = {"opening": "正式问题尚未提出。", "questions_open": c1_question_text("prompt"), "identity": c1_question_text("prompt"), "voice_source": c1_question_text("voice_source"), "words": c1_question_text("words"), "trust": c1_question_text("trust")}
        result = dv_with(result, "presentation", {"lines": [{"template": "当前问题：{question}", "bindings": [{"name": "question", "ref": dv_ref("question", "state", "current"), "labels": questions}]}]})
    if c1_ui_ends(action.id, ".compare_sole"):
        result = dv_with(result, "presentation", {"actor": "detective", "lines": [{"template": "马球靴的鞋底纹路，与门前灰上的印迹一模一样。靴齿里嵌着同样的炭灰。", "when": c1_statement("boots_fit")} ]})
    if c1_ui_ends(action.id, ".identify-own-lens"):
        result = dv_with(result, "presentation", {"actor": "detective", "lines": [{"template": "风衣内袋里的铜框放大镜，把柄刻痕与石板上的图记完全吻合。", "when": c1_statement("lens_mine")} ]})
    if c1_ui_ends(action.id, ".opening.wear-coat"):
        result = dv_with(result, "presentation", {"actor": "detective", "lines": [{"template": "你披上了这件熟悉的呢料风衣，领口与袖口早已磨平。", "when": dv_fact(dv_ref("coat", "state", "worn_by"), "detective")} ]})
    if c1_ui_ends(action.id, ".sound_trial"):
        result = dv_with(result, "presentation", {"voice": "visible-action", "lines": [{"template": "声路试验完成。各处听见了什么，还需分别询问实际在场的人。", "when": dv_fact(dv_ref("ritual", "state", "sound_trial_done"), true)} ]})
    if c1_ui_ends(action.id, ".loss_testimony"):
        result = dv_with(result, "presentation", {"actor": "su", "lines": [{"template": "苏泠：‘昨夜我听见的“开门”，和刚才铜管漏出的那半句很像。我当时把声音当成了门外的人……可我并没有看见他。’"} ]})
    if c1_ui_ends(action.id, ".talk.frame_hollow"):
        result = dv_with(result, "presentation", {"actor": "su", "lines": [{"template": "苏泠用音叉轻敲门框：‘门框后面是空的，贴着走去主楼的传声铜管。松动的接头就在这里。’"} ]})
    if c1_ui_ends(action.id, ".talk.slate_code"):
        result = dv_with(result, "presentation", {"actor": "huo", "lines": [{"template": "霍铎摸了摸石板上的刻痕：‘⊥是落闩，✕是切勿开门，◎指研习长桌旁的传声铜口。这是我的速记习惯。’"} ]})
    if c1_ui_ends(action.id, ".talk.cups_known"):
        result = dv_with(result, "presentation", {"actor": "shen", "lines": [{"template": "沈鼎擦着水槽里的杯子：‘阿泠喜淡茶不加糖，老霍嗜甜必加两勺。我这双手比脑子灵光，早就习惯这么泡茶了。’"} ]})
    if c1_ui_ends(action.id, ".talk.starter_kept"):
        result = dv_with(result, "presentation", {"actor": "shen", "lines": [{"template": "沈鼎揭开陶罐看了看：‘罐壁上留着好几层旧面痕。我喂它的动作这么顺手……可这罐子从哪儿来，谁在这里养过，我想不起来。’"} ]})
    return result

fn c1_player_replay_summary(actor):
    let candidates = dv_find(actor.policy, "hypotheses", [])
    var i = 0
    while i < rt_count(candidates):
        let candidate = candidates[i]
        if dvs_working_explanation(actor, candidate):
            let model = dvs_cached_model(actor, candidate)
            if dv_explanation_model_complete(model, "explained", actor.mind.revision):
                return "重演结果：已有解释与现有观察相符。这仍是推演，尚不是正式答辩。"
        i = i + 1
    if dv_find(actor.policy, "model_budget", 0) <= 0:
        return "这次重演尚未形成能够完整说明现有观察的解释。推演总预算已耗尽。"
    return "这次重演尚未形成能够完整说明现有观察的解释。"

// Source module: language_core/game/presentation.dv
// Authored location bindings. Geometry remains owned by the existing map assets.
fn dvg_place(location):
    let places = {
        "living_hall": {"map": "living_hall", "room": "living_hall:hall", "spawn": "east_south"},
        "central_hall": {"map": "central_hall", "room": "central_hall:central_hall"},
        "lecture": {"map": "lecture", "room": "lecture:lecture"},
        "logistics": {"map": "logistics", "room": "logistics:dining"},
        "clinic": {"map": "clinic", "room": "clinic:ward"},
        "greenhouse": {"map": "greenhouse", "room": "greenhouse:greenhouse"},
        "document_workshop": {"map": "archive", "room": "archive:works"},
        "resonance_hall": {"map": "resonance", "room": "resonance:hall"},
        "quiet_room": {"map": "resonance", "room": "resonance:silent"},
        "white_tower_safe": {"map": "clinic", "room": "clinic:safety"},
        "washroom": {"map": "living_hall", "room": "living_hall:bath"},
        "resonance": {"map": "resonance", "room": "resonance:hall"},
        "oath_court": {"map": "campus_s", "room": "campus_s:campus_s", "anchor": "site:oath_court"},
        "threshold.contract": {"map": "living_hall", "room": "living_hall:hall", "anchor": "west_north"},
        "threshold.astral": {"map": "living_hall", "room": "living_hall:hall", "anchor": "west_south"},
        "threshold.logistics": {"map": "living_hall", "room": "living_hall:hall", "anchor": "east_north"},
        "dorm.contract": {"map": "zone_jia", "room": "zone_jia:hall"},
        "dorm.astral": {"map": "zone_bing", "room": "zone_bing:hall"},
        "dorm.logistics": {"map": "zone_ding", "room": "zone_ding:hall"},
        "dorm.yi": {"map": "zone_yi", "room": "zone_yi:hall"},
        "foyer": {"map": "zone_yi", "room": "zone_yi:foyer", "spawn": "door_west"},
        "hall": {"map": "zone_yi", "room": "zone_yi:hall", "spawn": "table"},
        "R05": {"map": "zone_yi", "room": "zone_yi:R05", "spawn": "bed"},
        "R06": {"map": "zone_yi", "room": "zone_yi:R06"},
        "R07": {"map": "zone_yi", "room": "zone_yi:R07"},
        "R08": {"map": "zone_yi", "room": "zone_yi:R08"},
        "corridor": {"map": "zone_yi", "room": "zone_yi:corridor"},
        "pantry": {"map": "zone_yi", "room": "zone_yi:pantry"}}
    return dv_find(places, location, {"map": "", "room": location})

fn dvg_intent(state):
    let intent = dvs_session_intent(state)
    if intent.status != "prepared" or intent.action.kind != "move":
        return intent
    let travel = dv_find(intent.action, "travel", [])
    let target = dv_find(travel, "to", "")
    var destination = dvg_place(target)
    if dv_has_key(travel, "station"):
        destination = dv_with(destination, "departure_station", travel.station)
    if dv_find(travel, "from", "") == "foyer" and target == "living_hall":
        destination = dv_with_many(destination, {"departure_station": "lounge", "execution_room": "lounge"})
    return dv_with(intent, "destination", destination)

fn dvg_clock(time):
    let minute = rt_floor(time)
    let hour = rt_floor(minute / 60)
    let rest = minute - hour * 60
    var text = rt_show(rest)
    if rest < 10:
        text = rt_cat("0", text)
    return rt_cat(rt_show(hour - rt_floor(hour / 24) * 24), rt_cat(":", text))

fn dvg_presentation(state, viewer):
    var result = dvs_session_presentation(state, viewer)
    let actor = dv_find(result, "actor", "")
    var display = ""
    var i = 0
    while i < rt_count(state.actors):
        if state.actors[i].id == viewer:
            let subject = state.actors[i]
            let name = dv_read(subject.mind, c1_op_person_ref(actor, "name"))
            if dv_uncontested(name):
                display = name.value
            if display == "":
                display = c1_op_known_speaker_label(subject.mind, actor)
            if display == "":
                display = c2d_known_speaker_name(subject.mind, actor)
            if actor == viewer and dv_find(result, "status", "") == "applied" and c1_ui_ends(dv_find(result, "action_id", ""), ".replay"):
                result = dv_with(result, "lines", dv_append(dv_find(result, "lines", []), c1_player_replay_summary(subject)))
        i = i + 1
    return dv_with(result, "speaker_name", display)

fn dvg_people(state, viewer):
    let sprites = {"detective": "detective", "huo": "engineer", "shen": "chef", "su": "musician", "lucian": "poet", "gu": "archaeologist", "quer": "thief", "ward": "lawyer", "selma": "naturalist", "ruan": "chessplayer", "elena": "dancer", "moran": "painter", "veronica": "chemist", "bertrand": "marksman", "margaret": "architect", "mora": "doctor"}
    var people = []
    var i = 0
    while i < rt_count(state.actors):
        let actor = state.actors[i]
        let position = dv_read(state.physical, c2_position_ref(actor.id))
        if actor.id != viewer and dv_uncontested(position) and dv_has_key(sprites, actor.id):
            let place = dvg_place(position.value)
            if place.map != "":
                rt_push(people, {"key": actor.id, "map": place.map, "present": true, "sprite": dv_find(sprites, actor.id, ""), "frame": ""})
        i = i + 1
    return people

fn dvg_snapshot(state, viewer):
    let position = dv_read(state.physical, c2_position_ref(viewer))
    var place = {"map": "zone_yi", "room": "zone_yi:R05", "spawn": "bed"}
    if dv_uncontested(position):
        let located = dvg_place(position.value)
        if located.map != "":
            place = located
    let cast = {"detective": "detective", "huo": "engineer", "shen": "chef", "su": "musician", "quer": "thief", "lucian": "poet", "ward": "lawyer", "gu": "archaeologist", "ruan": "chessplayer", "elena": "dancer", "selma": "naturalist", "moran": "painter", "veronica": "chemist", "bertrand": "marksman", "margaret": "architect", "mora": "doctor"}
    let opened = dv_truth(state.physical, dv_fact(c1dep_ref("open"), true)) == "true"
    return {"chapter": dv_find(state.story, "chapter", 1), "game_time": state.physical.time, "active": dvs_session_active(state), "viewer": viewer, "resource": "res://scenes/Chapter2/Field/CampusMapView.tscn", "map": place.map, "spawn": dv_find(place, "spawn", "bed"), "field_enabled": true, "player_control": dv_find(state, "player_actor", "") == viewer, "initial_placements": [], "hud": {"title": "安眠者有福", "time": dvg_clock(state.physical.time)}, "access": {"dorms": true, "isolation_open": opened, "door_prints": false}, "traces": dvg_traces(state.physical), "people": dvg_people(state, viewer), "presentation": {"player_actor": viewer, "player_sprite": "detective"}, "cast": cast, "pending": dvg_intent(state), "chapter_summary": dvg_chapter_summary(state)}

// A system closing record is not fed into any actor's cognition or choices.
fn dvg_chapter_summary(state):
    if dv_find(state.story, "chapter", 1) != 2:
        return false
    if dv_truth(state.physical, dv_fact(c2daily_ref("council_closed"), true)) != "true":
        return false
    return c2daily_chapter_summary(state.physical)

// Source module: language_core/game/campaign.dv
// Production composition. Chapter content owns its transition conditions.
fn dvg_open():
    return dvg_open_config({"seed": 1, "profile": "Standard_Detective", "detective_zone": "zone_yi"})

// Initial configuration changes the declared cognition and starting room only.
// Budgets and receipts retain their production contracts; no result is seeded.
fn dvg_open_config(config):
    var scene = c1n_install_scene(c1dep_install_scene(c1_campaign_scene()))
    let zone = dv_find(config, "detective_zone", "zone_yi")
    let profile = dv_find(config, "profile", "Standard_Detective")
    if zone != "zone_yi":
        scene = c1_other_place_detective(scene, zone, profile)
    scene = c1c_install_scene(scene, dv_find(config, "seed", 1), profile)
    scene = dv_with_many(scene, {"chapter": 1, "game_duration_budget": 5 * 1440 - scene.physical.time, "execution_scope": "DV production session; Godot execution receipts; offscreen non-movement uses DV world laws"})
    return dvs_session_open(c1_player_scene(scene), "enabled")

fn dvg_chapter_two_ready(state):
    return c1n_morning_ready(state.physical)

fn dvg_extend(state):
    if dv_find(state.story, "chapter", 0) != 1 or not dvg_chapter_two_ready(state):
        return state
    let live = dv_with_many(state.story, {"physical": state.physical, "actors": state.actors, "bindings": state.bindings})
    let expanded = dv_with(c2daily_install_scene(c2d_install_scene(c2_extend_scene(live))), "chapter", 2)
    var events = state.events
    dvs_event(events, "chapter_content_available", "", state.physical.time, [], {"chapter": 2, "source": c2_approved("chapter-state-inheritance"), "movement": false})
    // Content availability neither relocates a resident nor grants perceptions.
    return dvs_owned_state_update(state, {"story": expanded, "physical": expanded.physical, "actors": expanded.actors, "bindings": expanded.bindings, "events": events, "horizon": 5 * 1440, "duration_budget": 5 * 1440 - state.run_start, "idle": 0})

fn dvg_refresh_goals(current):
    var actors = current.actors
    var i = current.cursor
    var changed = false
    let chapter = dv_find(current.story, "chapter", 1)
    // The production scheduler selects the actor before content preparation.
    while i < current.cursor + 1:
        let actor = current.actors[i]
        if dv_find(actor, "scheduled_action", false) == false and (dv_has(c2_people(), actor.id) or actor.id == "demon") and (actor.mind.revision != dv_find(actor, "campaign_goals_revision", -1) or actor.mind.time != dv_find(actor, "campaign_goals_time", -1) or chapter != dv_find(actor, "campaign_goals_chapter", 0)):
            var refreshed = actor
            if chapter == 1:
                if actor.id != "demon":
                    refreshed = c1n_refresh_actor_goals(actor)
                actors = dvs_replace(actors, i, dv_with_many(refreshed, {"campaign_goals_revision": actor.mind.revision, "campaign_goals_time": actor.mind.time, "campaign_goals_chapter": chapter}))
            else:
                let navigation_input = c2i_navigation_input(actor)
                let needs_c1_wait = (actor.id == "selma" and dv_truth(actor.mind, c1_other_claim("astral", "west_passage_checked")) != "true") or (actor.id == "mora" and dv_truth(actor.mind, c1_other_claim("logistics", "observation_complete")) != "true")
                let in_living = (dv_truth(actor.mind, c2_at(actor.id, "living_hall")) == "true")
                let case_open = (dv_truth(actor.mind, c2d_case_gate(actor.mind)) == "true")
                if not dv_same(navigation_input, dv_find(actor, "c2_goals_navigation_input", [])) or needs_c1_wait or chapter != dv_find(actor, "campaign_goals_chapter", 0) or in_living != dv_find(actor, "c2_goals_in_living", false) or case_open != dv_find(actor, "c2_goals_case_open", false) or dv_find(actor, "c2_goals_needs_wait", false) != needs_c1_wait:
                    refreshed = c2d_refresh_actor_goals(actor)
                refreshed = c1n_known_future_wait_actor(refreshed)
                actors = dvs_replace(actors, i, dv_with_many(refreshed, {"campaign_goals_revision": actor.mind.revision, "campaign_goals_time": actor.mind.time, "campaign_goals_chapter": chapter, "c2_goals_in_living": in_living, "c2_goals_case_open": case_open, "c2_goals_needs_wait": needs_c1_wait, "c2_goals_navigation_input": c2i_navigation_input(refreshed)}))
            changed = true
        i = i + 1
    if changed:
        return dvs_owned_state_update(current, {"actors": actors})
    return current

fn dvg_prepare(state):
    var current = dvg_extend(state)
    while dvs_session_active(current) and dv_find(current, "pending", false) == false and not dv_find(current, "awaiting_player", false):
        if dv_find(current, "player_selection", "") == "":
            current = dvs_schedule(current)
        if dv_find(current, "pending", false) == false and dvs_session_active(current):
            current = dvs_prepare_actor(dvg_refresh_goals(current))
        if dv_find(current, "pending", false) == false:
            current = dvg_extend(current)
    return current

fn dvg_complete(state, receipt):
    return dvg_extend(dvs_session_complete(state, receipt))

// Geometry identifiers bind to native authored material facts, never an oracle.
fn dvg_traces(world):
    let mapping = {"ash": "ash_wedge", "boots": "boots_toward_bolt", "cloth": "cloth_after_boots", "dent": "fork_dent", "joint_west": "pipe_layout", "joint_east": "pipe_layout", "shelf_R05": "shelf_old", "shelf_R06": "shelf_old", "shelf_R07": "shelf_old", "shelf_R08": "shelf_old", "shelf_EN": "shelf_old", "shelf_ES": "shelf_old"}
    var result = []
    var i = 0
    while i < rt_count(mapping):
        result = dv_with(result, mapping[i][0], dv_truth(world, dv_fact(c1_knowledge(mapping[i][1]), true)) == "true")
        i = i + 1
    return result

// Reporting selection only; all residents retain the same decision mechanism.
fn dvg_tracked_actors():
    return dvg_debug_config().actors

fn dvg_chronological_trace(state):
    return dv_debug_events(state.events, 0, dvg_debug_config()).events

// Bounded formal-model adapter; false uses the authored session action limit.
// Returns the live state without closing it or resetting at chapter expansion.
fn dvg_run_campaign(max_steps):
    var state = dvg_open()
    var limit = max_steps
    if limit == false:
        limit = state.limit
    dv_require(0 <= limit, "Negative campaign step limit")
    var steps = 0
    while dvs_session_active(state) and steps < limit:
        state = dvg_prepare(state)
        let pending = dv_find(state, "pending", false)
        if pending != false:
            state = dvg_complete(state, {"action_event": pending.action_event, "outcome": "applied", "actual": pending.model.actual, "executor": "formal-model"})
            steps = steps + 1
    return state

// Source module: language_core/game/entry.dv
// Production composition and read-only diagnostic configuration.

fn dvg_debug_config():
    return {"viewer": "detective", "actors": [], "event_types": [], "max_steps": false, "phase_progress": false}
