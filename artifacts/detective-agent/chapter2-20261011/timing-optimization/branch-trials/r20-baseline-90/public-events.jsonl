{"elapsed_ms": 34647, "kind": "shown", "sequence": 1687, "value": {"kind": "lines", "lines": [["铜口", "门，是谁闩上的？"]]}}
{"elapsed_ms": 34761, "kind": "shown", "sequence": 1693, "value": {"actions": ["陈述", "出示", "暂且不答", "作答"], "kind": "form", "title": "始业之答"}}
