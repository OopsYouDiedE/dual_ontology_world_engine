+    private sealed record SpeechDelivery(string Actor, string Method, string Receipt);
+    private readonly Dictionary<string, List<SpeechDelivery>> _speechDeliveries = new(StringComparer.Ordinal);
+
+    public void BeginSpeechDelivery(MorningWorld world, string deliveryId, IReadOnlyList<InteractionLine> lines)
+    {
+        if (!_speechDeliveries.TryGetValue(deliveryId, out var pending))
+            _speechDeliveries.Add(deliveryId, pending = []);
+        foreach (var topic in Content.RootElement.GetProperty("TOPICS").EnumerateObject())
+        foreach (var author in topic.Value.GetProperty("responses").EnumerateObject())
+        foreach (var response in author.Value.EnumerateObject())
+        {
+            var ids = response.Value.EnumerateArray().Where(i => i.TryGetProperty("line_id", out _))
+                .Select(i => i.GetProperty("line_id").GetString()).ToHashSet();
+            var delivered = lines.Where(l => ids.Contains(l.LineId)).ToArray();
+            if (delivered.Length == 0) continue;
+            var actor = author.Name;
+            if (actor == "any")
+            {
+                var speakers = delivered.Select(l => l.Speaker).Distinct().ToArray();
+                if (speakers.Length != 1) continue;
+                actor = Content.RootElement.GetProperty("PERSON_NAMES").EnumerateObject()
+                    .Where(p => p.Value.GetString() == speakers[0]).Select(p => p.Name).FirstOrDefault() ?? "";
+            }
+            if (!world.MorningActors.Contains(actor)) continue;
+            var method = "speech:" + topic.Name + ":" + response.Name;
+            if (pending.Any(p => p.Actor == actor && p.Method == method)) continue;
+            var receipt = deliveryId + ":" + actor + ":" + method;
+            SubjectiveAgent.Feedback(world.ActorAgency(actor), new(receipt + ":started", method,
+                "listener:detective", DecisionOutcomeV1.Attempted));
+            pending.Add(new(actor, method, receipt));
+        }
+    }
+
+    public void EndSpeechDelivery(MorningWorld world, string deliveryId, bool completed)
+    {
+        if (!_speechDeliveries.Remove(deliveryId, out var pending)) return;
+        foreach (var delivery in pending)
+            SubjectiveAgent.Feedback(world.ActorAgency(delivery.Actor), new(delivery.Receipt + ":finished",
+                delivery.Method, "listener:detective", completed ? DecisionOutcomeV1.Succeeded : DecisionOutcomeV1.Interrupted));
+    }
