+      "text": "（门纹丝不动。门的另一侧，横闩卡得很死。）",
+      "speaker": ""
+    },
+    "exp_E1.open.001": {
+      "text": "（门是开着的。内闩仍在门上。）",
+      "speaker": ""
+    },
+    "exp_E2.002": {
+      "text": "（楔尖那道新磨痕，正对上门底的擦痕。门内那片扇形的灰，窄头恰好是楔背那么宽。）",
+      "speaker": ""
+    },
+    "exp_E3.002": {
+      "text": "（马球靴的鞋底纹路，与灰上那枚印一模一样。纹槽里嵌着同样的灰。）",
+      "speaker": ""
+    },
+    "help_E10.002": {
+      "text": "是我喂的。续种，刮壁，盖布——这手法我认得。",
+      "speaker": "沈鼎"
+    },
+    "help_E10.003": {
+      "text": "罐里是活的。没人喂，三天就塌了。",
+      "speaker": "沈鼎"
+    },
+    "help_E10.004": {
+      "text": "……这罐子，不像是昨天才养的。",
+      "speaker": "沈鼎"
+    },
+    "help_E11_detective.002": {
+      "text": "（半枚手印比你的手掌窄一圈。手指也短。不是你的。）",
+      "speaker": ""
+    },
+    "help_E11_huo.002": {
+      "text": "（你记下霍铎的掌缘：比这枚手印宽。）",
+      "speaker": ""
+    },
+    "help_E11_shen.002": {
+      "text": "（你记下沈鼎的掌缘：比这枚手印宽。）",
+      "speaker": ""
+    },
+    "help_E11_su.002": {
+      "text": "（你记下苏泠的掌缘：比这枚手印宽。）",
+      "speaker": ""
+    },
+    "help_E4.002": {
+      "text": "这布是我拧的。先对折，再顺着拧三道，拧到不滴水，再压。船上堵舱门缝的手法。",
+      "speaker": "沈鼎"
+    },
+    "help_E4.003": {
+      "text": "这么拧的人不多，我师父教的。",
+      "speaker": "沈鼎"
+    },
+    "help_E4.004": {
+      "text": "……可我不记得来过这儿。",
+      "speaker": "沈鼎"
+    },
+    "help_E5.004": {
+      "text": "不一样。门框后面是空的。贴着一根管子。",
+      "speaker": "苏泠"
+    },
+    "help_E5.005": {
+      "text": "音叉是我的。柄上的字，我母亲刻的。……我不记得把它放在这儿。",
+      "speaker": "苏泠"
+    },
+    "help_E6.001": {
+      "text": "是我的字。按纸上的音高和重音，像是在记一个很低的男声。",
+      "speaker": "苏泠"
+    },
+    "help_E6.002": {
+      "text": "前两拍是弱音，只留下两个问号；后两拍重读，写的是“开门”。",
+      "speaker": "苏泠"
+    },
+    "help_E6.003": {
+      "text": "（指尖停在第一拍，静了片刻）……我刚读到哪一拍？",
+      "speaker": "苏泠"
+    },
+    "help_E6.004": {
+      "text": "（重新看向纸面）同一小节写了两遍。下面那一行，墨色不一样。",
+      "speaker": "苏泠"
+    },
+    "help_E7.001": {
+      "text": "……我的字。",
+      "speaker": "霍铎"
+    },
+    "help_E7.002": {
+      "text": "G，一个人。我记人，先写他的头一个字母。",
+      "speaker": "霍铎"
+    },
+    "help_E7.003": {
+      "text": "⊥，闩。✕，禁止。✕开，不许开。",
+      "speaker": "霍铎"
+    },
+    "help_E7.004": {
+      "text": "◎……不确定。图纸上见过这个记号。",
+      "speaker": "霍铎"
+    },
+    "help_E7.005": {
+      "text": "下面这行。小图代人，我习惯这样——画他手里常拿的家伙。⊥✓，闩好了。",
+      "speaker": "霍铎"
+    },
+    "help_E7.006": {
+      "text": "这个图……我认不出是谁。",
+      "speaker": "霍铎"
+    },
+    "help_E9.002": {
+      "text": "青瓷小杯，干净，没糖。锡杯，两勺往上。白杯是清茶，不放奶。粗瓷大杯——这是我的，我喝茶就用大碗。",
+      "speaker": "沈鼎"
+    },
+    "help_E9.003": {
+      "text": "给人倒茶我向来不问，看一眼就知道放几勺。",
+      "speaker": "沈鼎"
+    },
+    "help_E9.004": {
+      "text": "……可这几个人，我才刚认识啊。",
+      "speaker": "沈鼎"
+    },
+    "recall_detective.002": {
+      "text": "霍铎说闩。我就闩了。……我信他。",
+      "speaker": "侦探（心声）"
+    },
+    "recall_huo.003": {
+      "text": "“等我下一次通知。”◎，铜口。他叫我守铜口。",
+      "speaker": "霍铎"
+    },
+    "recall_shen.003": {
+      "text": "阿泠的茶不放糖。老霍的放两勺。那位——（他看了你一眼）——清茶，不放奶。",
+      "speaker": "沈鼎"
+    },
+    "recall_su.002": {
+      "text": "门边……有人在喊开门。",
+      "speaker": "苏泠"
+    },
+    "recall_su.003": {
+      "text": "我想开门，让他进来。",
+      "speaker": "苏泠"
+    },
+    "sole_huo.002": {
+      "text": "（厚底工装靴，粗齿纹。比灰上那枚宽了一指。）",
+      "speaker": ""
+    },
+    "sole_shen.002": {
+      "text": "（布底没有纹。灰上那枚，纹路清清楚楚。）",
+      "speaker": ""
+    },
+    "sole_su.002": {
+      "text": "（软底小皮鞋，比灰上那枚短了一截。）",
+      "speaker": ""
+    },
+    "sound_test.003": {
+      "text": "（{{heard_where(\"detective\")}}）{{heard(\"detective\")}}",
+      "speaker": "侦探（心声）"
+    },
+    "sound_test.004": {
+      "text": "（在{{heard_where(\"huo\")}}，扬声）{{heard(\"huo\")}}",
+      "speaker": "霍铎"
+    },
+    "sound_test.005": {
+      "text": "（在{{heard_where(\"shen\")}}，扬声）{{heard(\"shen\")}}",
+      "speaker": "沈鼎"
+    },
+    "sound_test.006": {
+      "text": "（在{{heard_where(\"su\")}}，扬声）{{heard(\"su\")}}",
+      "speaker": "苏泠"
     }
   }
 }
