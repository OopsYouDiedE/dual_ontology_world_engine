+		var center := threshold.get_center()
+		var normal := Vector2.DOWN if threshold.size.x >= threshold.size.y else Vector2.RIGHT
+		var side := signf((player.position - center).dot(normal))
+		if side == 0.0: side = 1.0
+		var crossing := center - normal * side * 48.0
+		result.append({"identity": str(objects.get_path_to(door)), "point": center, "crossing": crossing,
+			"open": float(door.get("openness")) > 0.05,
+			"label": FieldVocabulary.word("宿舍门开") if float(door.get("openness")) > 0.05 else FieldVocabulary.word("宿舍门关")})
+	return result
