+## Door leaves are drawn even while the room behind them is unknown.
+## Publish only their visible threshold positions, never the room or access state.
+func player_visible_doorways() -> Array[Vector2]:
+	var result: Array[Vector2] = []
+	if not is_inside_tree() or not is_instance_valid(adapter) or not is_instance_valid(player): return result
+	var objects: Node = adapter.objects_root()
+	if not is_instance_valid(objects): return result
+	for node in objects.get_children():
+		if node is not Node2D or not node.has_method("door_click_rect") or not _player_object_drawn(node): continue
+		var door := node as Node2D
+		var leaf := door.get("left") as Texture2D
+		if leaf == null: continue
+		var width := roundf(32.0 * (1.0 - float(door.get("openness"))) + 5.0 * float(door.get("openness")))
+		var transform := door.get_global_transform_with_canvas()
+		var left := _player_object_exposed(transform * Rect2(-32, -leaf.get_height(), width, leaf.get_height()), [])
+		var right := _player_object_exposed(transform * Rect2(32 - width, -leaf.get_height(), width, leaf.get_height()), [])
+		if not _player_object_unshaded(left) and not _player_object_unshaded(right): continue
+		result.append(to_local(door.global_position))
+	return result
+
