+## A visible doorway is a concrete exploration target, unlike an arbitrary wall edge.
+## Approach over remembered ground; cross using ordinary input and real collisions.
+static func doorways(field, known: AStarGrid2D) -> Array:
+	var result := []
+	for point in field.player_visible_doorways():
+		var observed_sides := []
+		for side in [-1.0, 1.0]:
+			var cell := Vector2i(((point + Vector2(0, side * 64.0)) / known.cell_size).floor())
+			if known.region.has_point(cell) and not known.is_point_solid(cell): observed_sides.append(side)
+		if observed_sides.size() != 1: continue
+		var heading := Vector2(0, -float(observed_sides[0]))
+		var approach: Vector2 = point - heading * 64.0
+		var input: Dictionary
+		var target: Vector2
+		if absf(field.player.position.x - point.x) <= 8.0 and absf(field.player.position.y - point.y) <= 96.0:
+			target = field.player.position + heading * 32.0
+			input = _step_input(heading)
+		else:
+			var route := Navigation.route_on_grid(field.player.position, approach, known)
+			if route.is_empty(): continue
+			target = route[0]
+			var distance: float = field.player.position.distance_to(target)
+			for next in route:
+				var step: float = target.distance_to(next)
+				if distance + step > 128.0: break
+				distance += step
+				target = next
+			input = {"kind": "field_action", "action": "move", "point": [target.x, target.y]}
+		result.append({"label": "%d,%d" % [target.x, target.y], "kind": "move", "new": false,
+			"purpose": "frontier", "location": [target.x, target.y], "input": input})
 	return result
 
