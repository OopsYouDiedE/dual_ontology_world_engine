+func _waypoint_costs() -> void:
+	var field := Field.new()
+	# A one-cell neutral turn has a unique route: down 64px, then right.
+	for y in range(5, 14): field.adapter.floors[Vector2i(5, y)] = true
+	for x in range(5, 30): field.adapter.floors[Vector2i(x, 13)] = true
+	field.player.position = Vector2(44, 44)
+	field.all_visible = true
+	var known := PlayerNavigation.remember_grid(field)
+	field.all_visible = false
+	field.visible[Vector2i(5, 5)] = true
+	var short_places := {"neutral-turn": {"point": Vector2(172, 108), "reach": 12.0}}
+	var long_places := {"neutral-turn": {"point": Vector2(236, 108), "reach": 12.0}}
+	var short := PlayerNavigation.approaches(field, short_places, known)
+	var long := PlayerNavigation.approaches(field, long_places, known)
+	check(short.size() == 1 and long.size() == 1, "both observed endpoints offer their common route prefix")
+	if short.size() == 1 and long.size() == 1:
+		check(short[0].input.point == [108.0, 108.0] and short[0].input.point == short[0].location,
+			"turned waypoint sends its actual short click endpoint")
+		check(short[0].input.point == long[0].input.point and is_equal_approx(short[0].travel_distance, long[0].travel_distance),
+			"extending only the destination leaves the same first-input cost unchanged")
+		var chord := field.player.position.distance_to(Vector2(short[0].location[0], short[0].location[1]))
+		check(is_equal_approx(short[0].travel_distance, 128.0) and short[0].travel_distance > chord
+			and is_equal_approx(short[0].travel_distance, _input_route_length(field, short[0], known)),
+			"turned input cost uses travelled legs instead of the straight chord")
+		check(short[0].travel_distance <= 128.0 and long[0].travel_distance <= 128.0,
+			"all short approach prefixes obey the route-length limit")
+		print("OBSERVATION turned-common-prefix " + JSON.stringify({"short": short[0], "extended": long[0], "straight_chord": chord}))
+	var direct_short := PlayerNavigation.travel_distance(field, Vector2(172, 108), 12.0, known)
+	var direct_long := PlayerNavigation.travel_distance(field, Vector2(236, 108), 12.0, known)
+	check(is_equal_approx(direct_short, 180.0) and is_equal_approx(direct_long, 244.0),
+		"direct interactions retain complete turned routes minus interaction reach")
+	check(direct_short > field.player.position.distance_to(Vector2(172, 108)) - 12.0
+		and direct_long > field.player.position.distance_to(Vector2(236, 108)) - 12.0,
+		"direct interaction costs still reflect observed detours")
+	field.player.position = Vector2(42, 42)
+	var off_center := PlayerNavigation.approaches(field, long_places, known)
+	check(off_center.size() == 1, "off-centre ordinary starting position retains its remembered route")
+	if off_center.size() == 1:
+		check(off_center[0].input.point == [100.0, 108.0]
+			and is_equal_approx(off_center[0].travel_distance, 120.0 + Vector2(42, 42).distance_to(Vector2(44, 44)))
+			and is_equal_approx(off_center[0].travel_distance, _input_route_length(field, off_center[0], known))
+			and off_center[0].travel_distance <= 128.0,
+			"prefix cost includes the actual connector from an off-centre start")
+		print("OBSERVATION off-centre-prefix " + JSON.stringify(off_center[0]))
+	_no_hidden_reads(field, "waypoint and direct cost calculations use only remembered geometry")
+	var unknown := PlayerNavigation.remember_grid(field)
+	check(PlayerNavigation.approaches(field, long_places, unknown).is_empty(),
+		"known target coordinates do not invent a route across unknown ground")
+	_no_hidden_reads(field, "missing route calculation never reads unknown ground")
+	print("OBSERVATION direct-route-costs " + JSON.stringify({"short": direct_short, "extended": direct_long}))
