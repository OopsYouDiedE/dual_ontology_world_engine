+func _input_route_length(field, offer: Dictionary, known: AStarGrid2D) -> float:
+	var emitted := Vector2(offer.input.point[0], offer.input.point[1])
+	var route := Navigation.route_on_grid(field.player.position, emitted, known)
+	var length := 0.0
+	var previous: Vector2 = field.player.position
+	for point in route:
+		length += previous.distance_to(point)
+		previous = point
+	return length
+
