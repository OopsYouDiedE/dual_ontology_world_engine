// Neutral language cases: no Core, session, content, or oracle import.

neutral_square(x: Number) -> Number = x * x
neutral_pair(a, b) = [a, b]

function result: Number = neutral_absolute(x: Number)
if x < 0
result = -x
elseif x == 0
result = 0
else
result = x
end
end

function [sum: Number, product: Number] = neutral_arithmetic(a: Number, b: Number)
sum = a + b
product = a * b
end

function result = neutral_early_return(x: Number) -> Number
if x < 0
result = 0
return
end
result = x + 1
end

function result: Number = neutral_sum_to(n: Number)
result = 0
var i = 0
while i < n:
i = i + 1
result = result + i
end
end

fn neutral_old_fn(x: Number) -> Number:
    if x > 0:
        return x + 2
    else:
        return 2

fn neutral_expect(condition, label):
    if not condition:
        return rt_fail(label)
    return true

fn checks_main():
    neutral_expect(neutral_square(-3) == 9, "Formula result differs")
    neutral_expect(neutral_pair(2, 5)[1] == 5, "Formula list result differs")
    neutral_expect(neutral_absolute(-3) == 3 and neutral_absolute(0) == 0 and neutral_absolute(4) == 4, "Named-output branch result differs")
    let values = neutral_arithmetic(3, 4)
    neutral_expect(rt_count(values) == 2 and values[0] == 7 and values[1] == 12, "Multiple outputs do not retain list order")
    neutral_expect(neutral_early_return(-1) == 0 and neutral_early_return(2) == 3, "Bare return path differs")
    neutral_expect(neutral_sum_to(0) == 0 and neutral_sum_to(4) == 10, "Initialized loop output differs")
    neutral_expect(neutral_old_fn(3) == 5 and neutral_old_fn(0) == 2, "Existing fn syntax changed")
    rt_print("CHECK syntax-positive completed")
    return true
