#include ../../../language_core/20-core.dv

// Neutral finite-domain models. These are engineering witnesses, not story data.

fn neutral_limits(balance, search_budget, work_remaining):
    return {balances: [balance], search_budget: search_budget, work_remaining: work_remaining, revision: 0, subject: "neutral-solver"}

fn neutral_binary_model(count):
    var variables = []
    var coefficients = []
    var i = 0
    while i < count:
        rt_push(variables, {options: [{value: 0, cost: [0]}, {value: 1, cost: [1]}]})
        rt_push(coefficients, 0)
        i = i + 1
    return {variables: variables, goal: {coefficients: coefficients, minimum: 0}}

fn neutral_compare(goal, variables, laws, limits, prices):
    let before = dv_clone({goal: goal, variables: variables, laws: laws, limits: limits, prices: prices})
    let reference = dv_imprint_solve_with(true, goal, variables, laws, limits, prices, "enumerate")
    let bounded = dv_imprint_solve_with(true, goal, variables, laws, limits, prices, "branch_bound")
    dv_require(reference.status == bounded.status and reference.visited == bounded.visited and reference.total == bounded.total, "Solver status or covered prefix differs")
    dv_require(reference.charged_work == bounded.charged_work and bounded.charged_work == bounded.visited * 2, "Solver budget accounting differs")
    if reference.best == false:
        dv_require(bounded.best == false, "Bounded solver invented a witness")
    else:
        dv_require(bounded.best != false and dv_balance_same_witness(reference.best, bounded.best), "Bounded solver changed the exact or earliest witness")
    dv_require(dv_imprint_check(reference, goal, variables, laws, limits, prices), "Reference certificate was rejected")
    dv_require(dv_imprint_check(bounded, goal, variables, laws, limits, prices), "Interval certificate was rejected")
    dv_require(dv_same(before, {goal: goal, variables: variables, laws: laws, limits: limits, prices: prices}), "Solver changed original model inputs")
    return {reference: reference, bounded: bounded}

fn neutral_coverage_change(result, field, value):
    var coverage = dv_clone(result.coverage)
    rt_replace(coverage, 0, dv_with(coverage[0], field, value))
    return dv_with(result, "coverage", coverage)

fn neutral_solver_success():
    let model = neutral_binary_model(10)
    let limits = neutral_limits(10, 1024, 2048)
    let prices = [1]
    let full = neutral_compare(model.goal, model.variables, [], limits, prices)
    dv_require(full.bounded.status == "Optimal" and full.bounded.complete and full.bounded.visited == 1024, "Complete finite model was not certified optimal")
    dv_require(full.bounded.best.index == 0 and full.bounded.best.cost == rt_exact("0"), "Cheapest neutral witness differs")
    dv_require(full.reference.candidate_evaluations == 1024 and full.bounded.candidate_evaluations < full.reference.candidate_evaluations and full.bounded.bound_checks > 0, "Interval pruning did not avoid candidate evaluations")
    let analysis = dv_imprint_analyze(model.goal, model.variables, [], limits, prices)
    dv_require(analysis.branch_bound_applicable and analysis.arithmetic == "exact-rational" and analysis.budget_covers_domain, "Solver applicability or precision analysis differs")
    dv_require(analysis.candidate_limit == 1024 and analysis.budget_unit == "covered-candidate-prefix" and analysis.work_per_covered_candidate == 2, "Analyzer changed the budget unit")
    let automatic = dv_imprint_solve(true, model.goal, model.variables, [], limits, prices)
    dv_require(automatic.status == full.reference.status and dv_balance_same_witness(automatic.best, full.reference.best), "Automatic solver selection changed the result")

    let prefix_limits = neutral_limits(10, 37, 74)
    let prefix = neutral_compare(model.goal, model.variables, [], prefix_limits, prices)
    dv_require(prefix.bounded.status == "Feasible" and not prefix.bounded.complete and prefix.bounded.visited == 37 and prefix.bounded.charged_work == 74, "Incomplete prefix was presented as global optimality")
    dv_require(prefix.bounded.stop_reason == "search-and-work-budget", "Prefix stop reason differs")
    dv_require(not dv_imprint_check(dv_with(prefix.bounded, "status", "Optimal"), model.goal, model.variables, [], prefix_limits, prices), "False optimal status was accepted")
    let work_limits = neutral_limits(10, 1024, 75)
    let work_prefix = neutral_compare(model.goal, model.variables, [], work_limits, prices)
    dv_require(work_prefix.bounded.visited == 37 and work_prefix.bounded.stop_reason == "work-budget", "Odd remaining work changed the prefix")
    let zero_limits = neutral_limits(10, 0, 2048)
    let zero = neutral_compare(model.goal, model.variables, [], zero_limits, prices)
    dv_require(zero.bounded.status == "Unresolved" and zero.bounded.visited == 0 and zero.bounded.best == false, "Zero search budget produced an unsupported result")
    let exact_limits = neutral_limits(10, 2, rt_exact("39999999999999999999/10000000000000000000"))
    let exact_prefix = neutral_compare(model.goal, model.variables, [], exact_limits, prices)
    dv_require(exact_prefix.bounded.visited == 1 and exact_prefix.bounded.charged_work == 2, "Exact work boundary was rounded up to another candidate")

    let impossible_laws = [{coefficients: model.goal.coefficients, total: 1}]
    let impossible = neutral_compare(model.goal, model.variables, impossible_laws, limits, prices)
    dv_require(impossible.bounded.status == "Infeasible" and impossible.bounded.best == false and impossible.bounded.candidate_evaluations == 0, "Contradictory linear equality was not safely pruned")
    let tight_resources = neutral_compare(model.goal, model.variables, [], neutral_limits(0, 1024, 2048), prices)
    dv_require(tight_resources.bounded.status == "Optimal" and tight_resources.bounded.best.cost == 0, "Resource-bound equality was rejected")

    let fractional_variables = [{options: [{value: "-1/2", cost: ["1/3"]}, {value: "1/2", cost: ["1/5"]}]}, {options: [{value: "0", cost: ["0"]}, {value: "1", cost: ["1/7"]}]}]
    let fractional_goal = {coefficients: ["-1", "1/2"], minimum: "1"}
    let fractional_laws = [{coefficients: ["1", "1"], total: "1/2"}]
    let fractional = neutral_compare(fractional_goal, fractional_variables, fractional_laws, neutral_limits(10, 4, 8), prices)
    dv_require(fractional.bounded.status == "Optimal" and fractional.bounded.best.index == 2 and fractional.bounded.best.degree == rt_exact("1") and fractional.bounded.best.cost == rt_exact("10/21"), "Signed rational bounds changed an exact boundary witness")
    let tied_variables = [{options: [{value: 0, cost: [1]}, {value: 1, cost: [1]}]}]
    let tied = neutral_compare({coefficients: [0], minimum: 0}, tied_variables, [], neutral_limits(1, 2, 4), prices)
    dv_require(tied.bounded.best.index == 0, "Equal-cost options changed original tie order")
    let later_cheaper = neutral_compare({coefficients: [0], minimum: 0}, [{options: [{value: 0, cost: [1]}, {value: 1, cost: [0]}]}], [], neutral_limits(1, 2, 4), prices)
    dv_require(later_cheaper.bounded.best.index == 1 and later_cheaper.bounded.best.cost == 0, "Incumbent pruning hid a later cheaper option")
    let empty_variables = neutral_compare({coefficients: [], minimum: 0}, [], [], neutral_limits(0, 1, 2), prices)
    dv_require(empty_variables.bounded.status == "Optimal" and empty_variables.bounded.total == 1 and empty_variables.bounded.algorithm == "enumerate", "Zero-dimensional reference fallback differs")

    let result = full.bounded
    dv_require(rt_count(result.coverage) > 1, "Neutral pruning model did not produce partitioned coverage")
    var missing = []
    var i = 0
    while i + 1 < rt_count(result.coverage):
        rt_push(missing, dv_clone(result.coverage[i]))
        i = i + 1
    dv_require(not dv_imprint_check(dv_with(result, "coverage", missing), model.goal, model.variables, [], limits, prices), "Missing certificate coverage was accepted")
    var duplicated = dv_clone(result.coverage)
    rt_push(duplicated, dv_clone(result.coverage[0]))
    dv_require(not dv_imprint_check(dv_with(result, "coverage", duplicated), model.goal, model.variables, [], limits, prices), "Repeated certificate coverage was accepted")
    dv_require(not dv_imprint_check(neutral_coverage_change(result, "start", 1), model.goal, model.variables, [], limits, prices), "Coverage gap was accepted")
    dv_require(not dv_imprint_check(neutral_coverage_change(result, "depth", 11), model.goal, model.variables, [], limits, prices), "Out-of-range certificate depth was accepted")
    dv_require(not dv_imprint_check(neutral_coverage_change(result, "depth", 0.5), model.goal, model.variables, [], limits, prices), "Fractional certificate depth was accepted")
    dv_require(not dv_imprint_check(neutral_coverage_change(result, "count", 0), model.goal, model.variables, [], limits, prices), "Empty certificate block was accepted")
    dv_require(not dv_imprint_check(neutral_coverage_change(result, "kind", "unproved"), model.goal, model.variables, [], limits, prices), "Unknown certificate claim was accepted")
    dv_require(not dv_imprint_check(dv_with(result, "proof_kind", "unsupported-v999"), model.goal, model.variables, [], limits, prices), "Unknown certificate format was accepted")
    let forged_best = dv_with(result.best, "cost", rt_exact("1"))
    dv_require(not dv_imprint_check(dv_with(result, "best", forged_best), model.goal, model.variables, [], limits, prices), "Unreconstructed witness cost was accepted")
    let worse_best = dv_balance_candidate(1, model.goal, model.variables, [], limits, prices)
    dv_require(not dv_imprint_check(dv_with(result, "best", worse_best), model.goal, model.variables, [], limits, prices), "Suboptimal feasible witness was accepted")
    dv_require(not dv_imprint_check(result, dv_with(model.goal, "minimum", 1), model.variables, [], limits, prices), "Certificate replaced the original goal")
    dv_require(not dv_imprint_check(dv_with(result, "revision", 1), model.goal, model.variables, [], limits, prices), "Stale certificate revision was accepted")
    let legacy = {status: result.status, best: result.best, visited: result.visited, total: result.total, revision: result.revision, subject: result.subject}
    dv_require(dv_imprint_check(legacy, model.goal, model.variables, [], limits, prices), "Legacy six-field certificate lost reference verification")
    let exchanged = rt_json_parse(rt_json_stringify(result))
    dv_require(dv_imprint_check(exchanged, model.goal, model.variables, [], limits, prices), "Exact witness changed through the exchange representation")
    rt_print(rt_cat("CHECK solver-pruning candidate-evaluations enumerate=", rt_cat(rt_show(full.reference.candidate_evaluations), rt_cat(" branch=", rt_show(full.bounded.candidate_evaluations)))))
    rt_print("CHECK finite-solvers completed")
    return true

fn checks_main():
    if rt_arg_count() == 0:
        return neutral_solver_success()
    let command = rt_arg(0)
    if command == "empty-domain":
        return dv_imprint_solve_with(true, {coefficients: [0], minimum: 0}, [{options: []}], [], neutral_limits(0, 1, 2), [1], "enumerate")
    if command == "no-capability":
        return dv_imprint_solve_with(false, {coefficients: [], minimum: 0}, [], [], neutral_limits(0, 1, 2), [1], "enumerate")
    return rt_fail("Unknown neutral solver check command")
