{"event":"snapshot","status":{"accepted":true,"ack_seq":28,"command_seq":28,"controls":[{"control_id":"c1","disabled":false,"kind":"Button","rect":[952,755,104,37],"text":"返回现场"}],"elapsed_ms":319048,"error":"","name":"snapshot","pending":{"command_running":false},"run_id":"1791115384898-894298845","screenshot":"0028-snapshot.png","session":"shared-ch2-blind-03","visible_text":[{"rect":[24,18,760,34],"text":"第二章 · 名录库前厅"},{"rect":[340,940,600,30],"text":"第2日　晨　【上午】　午　下午　傍晚　夜"},{"rect":[700,20,556,30],"text":"点击 移动 / 交互　E 交互　Tab 笔记　R 重演　Q 行动"},{"rect":[224,200,832,27],"text":"库门锁芯"},{"rect":[534,252,522,66],"text":"十六人在中央厅会合。文契组里，沃德的目光一直没离开雀儿；星仪组的伊莲娜站得离阮清越很远；后勤组的茉拉不和维罗妮卡说话。"},{"rect":[534,328,522,44],"text":"【广播】诸位晨安。按课表，今日讲守则的读法。讲堂门外贴着课表。"},{"rect":[534,382,522,22],"text":"【广播】封存之物存于名录库，凡学员皆可取回己物。"},{"rect":[534,414,522,44],"text":"【广播】另：入夜后，名录库中若有人以你之名唤你，勿应。"},{"rect":[534,468,522,44],"text":"教师逐一对每个人低声说了一句话，说的都是那人最想要的东西。"},{"rect":[534,522,522,44],"text":"教师低声对你说：“你的封存匣在名录库里，标签上写着你的名字。”"},{"rect":[534,576,522,22],"text":"你细看了名录库前厅："},{"rect":[534,608,522,44],"text":"· 三道机关：配重室（要力气）、锁芯（要细手）、传声中继（要信号）。三处须同时施力。"},{"rect":[534,662,522,44],"text":"【第2日 · 上午】你在名录库前厅。"}]}}
