{"data":{"provenance":{"blind_playtest":false,"capture_type":"production_ui_render_sample","card_id":"E1","event_kind":"card","line_id":"","map_sequence":-1,"output_index":0,"panel":"card","presentation_id":"a3cc2fff7fc041168d340753ac36ab09","screenshot":"C:/Users/iii/Desktop/dual_ontology_world_engine/godot_csharp/../artifacts/basic-ui-system/ui-rounds/round-04-compact/03-c1-evidence-card.png","selector":{"card_id":"E1","kind":"card","slug":"03-c1-evidence-card"},"slug":"03-c1-evidence-card","source_sequence":106,"state_sequence":106,"trace_id":"20261008T115922890-0d3ed0bfc77448e688f2f65ca2e07924:output:246","view_sequence":1,"viewport":[1280,720]},"visible":{"capture_type":"production_ui_render_sample","event":"visible_frame","frame":34,"objects":["壁灯","隔离门（关闭）"],"output_index":0,"panel":"card","presentation_id":"a3cc2fff7fc041168d340753ac36ab09","source_sequence":106,"texts":[{"complete":true,"content_clipped":false,"text":"闩上的隔离门","visible_characters":-1},{"complete":true,"content_clipped":false,"text":"门内侧的插闩落在闩槽里。\n门外侧另有一道横闩，从这一侧拉不动。\n门上的猫眼，玻璃外侧糊满烟灰，看出去一片黑。\n门内侧压着一张泛黄的旧纸，题头是导师的《事故隔离规程》，角上盖着褪色的红印；纸色和笔迹都不同于新抄的《学园守则》。\n旧纸写着：泄漏后，各寝区的隔离门从外侧落闩。查明本区事故经过，由当值者向铜口陈述前，不得开启。\n末行另写：急病者可经铜口呼叫转移。","visible_characters":-1},{"complete":true,"content_clipped":false,"text":"来源：门厅 · 隔离门内侧","visible_characters":-1},{"content_clipped":false,"text":"拔闩推门"},{"content_clipped":false,"text":"握住插闩，往下想"},{"content_clipped":false,"text":"返回现场"}],"trace_id":"20261008T115922890-0d3ed0bfc77448e688f2f65ca2e07924:output:246","view_schema":2}},"elapsed_ms":1284,"kind":"visible_sample"}
