{"data":{"provenance":{"blind_playtest":false,"capture_type":"production_ui_render_sample","card_id":"","event_kind":"form","line_id":"","map_sequence":-1,"output_index":0,"panel":"form","presentation_id":"89315e3283e84f55be07d582b4bf67a4","screenshot":"C:/Users/iii/Desktop/dual_ontology_world_engine/godot_csharp/../artifacts/basic-ui-system/ui-rounds/round-04-compact/04-c1-defense-form.png","selector":{"field_ids":["say","show"],"kind":"form","layout":"tabs","slug":"04-c1-defense-form"},"slug":"04-c1-defense-form","source_sequence":1301,"state_sequence":1301,"trace_id":"20261008T115922890-0d3ed0bfc77448e688f2f65ca2e07924:output:841","view_sequence":1,"viewport":[1280,720]},"visible":{"capture_type":"production_ui_render_sample","event":"visible_frame","frame":42,"objects":["书架","公告框","宿舍门（关闭）","铜口"],"output_index":0,"panel":"form","presentation_id":"89315e3283e84f55be07d582b4bf67a4","source_sequence":1301,"texts":[{"complete":true,"content_clipped":false,"text":"始业之答","visible_characters":-1},{"complete":true,"content_clipped":false,"text":"铜口问：门，是谁闩上的？","visible_characters":-1},{"complete":true,"content_clipped":false,"text":"陈述一句结论，再出示一件能支撑它的东西。","visible_characters":-1},{"complete":true,"content_clipped":false,"text":"陈述：（未选）\n出示：（未选）","visible_characters":-1},{"content_clipped":false,"text":"是我闩的门。"},{"content_clipped":false,"text":"苏泠当时在她房里。"},{"content_clipped":false,"text":"霍铎当时守在铜口旁。"},{"content_clipped":false,"text":"门外没有人。那声音是从主楼对着铜口说的，从管接头漏到了门边。"},{"content_clipped":false,"text":"他说的是：闩门，别开。"},{"content_clipped":false,"text":"我信霍铎。"},{"content_clipped":false,"text":"我们早已相熟。"},{"content_clipped":false,"text":"陈述"},{"content_clipped":false,"text":"出示"},{"content_clipped":false,"text":"暂且不答"},{"content_clipped":false,"text":"作答"}],"trace_id":"20261008T115922890-0d3ed0bfc77448e688f2f65ca2e07924:output:841","view_schema":2}},"elapsed_ms":1432,"kind":"visible_sample"}
