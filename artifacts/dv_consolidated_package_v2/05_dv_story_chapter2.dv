// DV SOURCE REVIEW PACKAGE — preserves original file boundaries.
// This combined file is not a directly linkable program.
// ----- SOURCE: language_core/verification/scenarios/chapter2/content.dv | SHA256: d21f4fcca6015a63523d050b028e1e7093612555dcc263bbbe08de4f8eb1cf91 -----
// Native chapter-two content. No scheduled loss, illness, death, adoption or answer.
// Install into a committed chapter-one handoff; retain every existing mind and world object.
// Missing environment/physiology inputs remain unknown, never replaced by authored outcomes.

fn c2_source(file, line, id):
    return c1_source(rt_cat("godot_csharp/scenes/Awakening/Script/story/续篇/", file), line, id)

fn c2_approved(id):
    return c1_source("docs/design-standard.md", 0, id)

fn c2_ref(object, field):
    return dv_ref(object, "state", field)

fn c2_body(actor):
    return rt_cat("c2.person.", actor)

fn c2_own(actor, field):
    return c2_ref(c2_body(actor), field)

fn c2_clock():
    return dv_ref("campaign.clock", "state", "minute")

fn c2_access(gate):
    return dv_ref("campaign.access", "state", gate)

fn c2_position_ref(actor):
    return dv_ref(actor, "state", "location")

fn c2_at(actor, room):
    return dv_fact(c2_position_ref(actor), room)

fn c2_window(day, start, end):
    let origin = (day - 1) * 1440
    return dv_all(dv_pair(dv_at_least(c2_clock(), origin + start), dv_not(dv_at_least(c2_clock(), origin + end))))

fn c2_night(day):
    return c2_window(day, 1260, 1800)

fn c2_any_night():
    return c1_any(c2_night(1), c1_any(c2_night(2), c1_any(c2_night(3), c1_any(c2_night(4), c2_night(5)))))

fn c2_people():
    return ["detective", "huo", "shen", "su", "lucian", "gu", "quer", "ward", "selma", "ruan", "elena", "moran", "veronica", "bertrand", "margaret", "mora"]

fn c2_person_source(actor):
    let rows = [["detective", "01_侦探.story", 11], ["huo", "02_霍铎.story", 48], ["shen", "03_沈鼎.story", 45], ["su", "04_苏泠.story", 43], ["lucian", "05_卢西安.story", 25], ["gu", "06_顾平章.story", 25], ["quer", "07_雀儿.story", 27], ["ward", "08_沃德.story", 24], ["selma", "09_赛尔玛.story", 25], ["ruan", "10_阮清越.story", 24], ["elena", "11_伊莲娜.story", 24], ["moran", "12_莫兰.story", 23], ["veronica", "13_维罗妮卡.story", 25], ["bertrand", "14_贝尔特朗.story", 26], ["margaret", "15_玛格丽特.story", 27], ["mora", "16_茉拉.story", 26]]
    var i = 0
    while i < rt_count(rows):
        if rows[i][0] == actor:
            return c1_source(rt_cat("godot_csharp/scenes/Awakening/Script/story/生态/人物/", rows[i][1]), rows[i][2], rt_cat(actor, ".personal-values"))
        i = i + 1
    return c2_approved("unknown-person-profile-needs-source")

fn c2_profile(actor):
    var group = "living"
    var domain = "investigation"
    var roles = []
    var values = ["evidence", "safety", "patient_priority", "records"]
    if dv_has(["quer", "ward", "gu", "lucian"], actor):
        group = "contract"
    if dv_has(["selma", "ruan", "elena", "moran"], actor):
        group = "astral"
    if dv_has(["veronica", "bertrand", "margaret", "mora"], actor):
        group = "logistics"
    if dv_has(["mora", "shen", "ruan"], actor):
        domain = "resources"
    if dv_has(["selma", "veronica", "gu", "lucian"], actor):
        domain = "research"
    if dv_has(["bertrand", "margaret", "huo"], actor):
        domain = "safety"
    if actor == "huo":
        roles = ["weight"]
        values = ["measured_work", "records", "central_cooking", "evidence", "safety"]
    if actor == "quer":
        roles = ["lock"]
        values = ["not_targeted", "evidence", "movement_freedom", "night_exception", "measured_work"]
    if actor == "su":
        roles = ["relay"]
        values = ["measured_work", "signal", "evidence"]
    if actor == "bertrand":
        roles = ["weight"]
        values = ["patient_priority", "records", "safety"]
    if actor == "margaret":
        roles = ["weight"]
        values = ["evidence", "central_cooking", "records", "safety"]
    if actor == "mora":
        values = ["patient_priority", "cautious_travel", "evidence", "night_exception"]
    if actor == "shen":
        values = ["central_cooking", "patient_priority", "per_person", "not_targeted", "cautious_travel"]
    if actor == "ruan":
        values = ["records", "per_person", "committee", "witnesses", "evidence"]
    if actor == "ward":
        values = ["committee", "records", "ward_authority", "restriction", "no_exception", "witnesses", "evidence"]
    if actor == "gu":
        values = ["cautious_travel", "tradition", "records", "evidence", "contract"]
    if actor == "lucian":
        values = ["not_targeted", "evidence", "movement_freedom", "patient_priority", "contract", "records"]
    if actor == "selma":
        values = ["patient_priority", "evidence", "research"]
    if actor == "veronica":
        values = ["evidence", "records", "committee", "research"]
    if actor == "elena":
        values = ["tradition", "evidence", "contract", "safety", "cautious_travel"]
    if actor == "moran":
        values = ["measured_work", "research"]
    return {"id": actor, "group": group, "domain": domain, "station_roles": roles, "value_order": values, "basis": [c2_person_source(actor), c2_approved("chapter-two-role-groups")]}

fn c2_edges():
    let key = ["authored-declaration", "c2_edges"]
    let cached = rt_memo_get([], key)
    if cached[0]:
        return cached[1]
    return rt_memo_put([], key, c2_edges_build())

