{"event":"snapshot","status":{"accepted":true,"ack_seq":17,"command_seq":17,"controls":[{"control_id":"c1","disabled":false,"kind":"Button","rect":[952,755,104,37],"text":"返回现场"}],"elapsed_ms":157249,"error":"","name":"notice-action-settle","pending":{"command_running":false},"run_id":"1791121142375-833641084","screenshot":"0017-notice-action-settle.png","session":"ui-title-fix-20261004b","visible_text":[{"rect":[422,414,20,14],"text":"霍铎"},{"rect":[102,286,20,14],"text":"沈鼎"},{"rect":[550,126,20,14],"text":"苏泠"},{"rect":[705,478,30,14],"text":"卢西安"},{"rect":[289,670,30,14],"text":"顾平章"},{"rect":[294,126,20,14],"text":"雀儿"},{"rect":[134,510,20,14],"text":"沃德"},{"rect":[513,638,30,14],"text":"赛尔玛"},{"rect":[673,286,30,14],"text":"阮清越"},{"rect":[257,350,30,14],"text":"伊莲娜"},{"rect":[422,222,20,14],"text":"莫兰"},{"rect":[284,510,40,14],"text":"维罗妮卡"},{"rect":[540,350,40,14],"text":"贝尔特朗"},{"rect":[540,510,40,14],"text":"玛格丽特"},{"rect":[422,542,20,14],"text":"茉拉"},{"rect":[24,18,760,34],"text":"第二章 · 中央厅"},{"rect":[340,940,600,30],"text":"第2日　晨　【上午】　午　下午　傍晚　夜"},{"rect":[700,20,556,30],"text":"E / 点击  检视　　Tab  笔记本　　R  重演　　Q  行动　　H  回看"},{"rect":[224,200,832,27],"text":"中央公告板"},{"rect":[534,252,514,66],"text":"十六人在中央厅会合。文契组里，沃德的目光一直没离开雀儿；星仪组的伊莲娜站得离阮清越很远；后勤组的茉拉不和维罗妮卡说话。"},{"rect":[534,328,514,22],"text":"贝尔特朗在中央厅报告：昨夜巡夜无异常。"},{"rect":[534,360,514,44],"text":"【广播】诸位晨安。按课表，今日讲守则的读法。讲堂门外贴着课表。"},{"rect":[534,414,514,22],"text":"【广播】封存之物存于名录库，凡学员皆可取回己物。"},{"rect":[534,446,514,44],"text":"【广播】另：入夜后，名录库中若有人以你之名唤你，勿应。"},{"rect":[534,500,514,44],"text":"教师逐一对每个人低声说了一句话，说的都是那人最想要的东西。"},{"rect":[534,554,514,44],"text":"教师低声对你说：“你的封存匣在名录库里，标签上写着你的名字。”"},{"rect":[534,608,514,22],"text":"赛尔玛说：我一早从温室剪了一枝源质样本"},{"rect":[534,640,514,22],"text":"伊莲娜说：我又去诊疗所给脚踝换了药"},{"rect":[534,672,514,22],"text":"你细看了中央厅："},{"rect":[534,704,514,22],"text":"· 板上什么也没贴。"},{"rect":[534,736,514,22],"text":"· 中央基座完好，石面上光洁，没有刻字。"},{"rect":[534,768,514,44],"text":"你看见：贝尔特朗在中央厅报告昨夜夜巡所见；雀儿一见沃德就走开了；伊莲娜一见阮清越就走开了。"},{"r