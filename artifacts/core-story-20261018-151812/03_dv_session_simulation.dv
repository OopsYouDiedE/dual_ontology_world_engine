// The selector receives only one actor snapshot. No authority or oracle argument.

fn dvs_event(events, kind, actor, time, parents, data):
    var id = rt_cat("e", rt_show(rt_count(events)))
    let frozen_event = rt_snapshot({"id": id, "type": kind, "actor": actor, "time": time, "parents": parents, "data": data})
    rt_raw_event(frozen_event)
    rt_push(events, frozen_event)
    return id

fn dvs_find_event_by_id(events, id):
    if (rt_length(id) > 1 and rt_chr(id, 0) == "e"):
        let num_str = rt_slice(id, 1, rt_length(id) - 1)
        if rt_is_number(num_str):
            let idx = rt_number(num_str)
            if (0 <= idx and idx < rt_count(events)):
                let candidate = events[idx]
                if (candidate.id == id):
                    return candidate
    var i = rt_count(events) - 1
    while (i >= 0):
        let event = events[i]
        if (event.id == id):
            return event
        i = i - 1
    return false

fn dvs_cognitive_parents(actor, parents):
    var previous = dv_find(actor, "last_cognitive_event", "")
    if (previous == ""):
        return parents
    else:
        return dv_explanation_merge(parents, dv_single(previous))

fn dvs_reason_cell(cell):
    return dv_without(cell, "time")

fn dvs_reason_value(cell):
    return {"known": cell.known, "value": cell.value, "confidence": cell.confidence, "conflicted": cell.conflicted}

fn dvs_reason_premises(mind, proposition):
    var op = proposition.op
    if (op == "constant"):
        return proposition
    else:
        if (op == "not"):
            return dvs_reason_premises(mind, proposition.item)
        else:
            if (op == "all"):
                var items = proposition.items
                var result = []
                var i = 0
                while (i < rt_count(items)):
                    rt_push(result, dvs_reason_premises(mind, items[i]))
                    i = (i + 1)
                return result
            else:
                return {"proposition": proposition, "support": dvs_reason_cell(dv_read(mind, proposition.ref))}

fn dvs_reason_signature(mind, adoption):
    var law = adoption.law
    var effects = adoption.law.effects
    var outputs = []
    var i = 0
    while (i < rt_count(effects)):
        var cell = dv_read(mind, effects[i].ref)
        rt_push(outputs, {"known": cell.known, "value": cell.value, "confidence": cell.confidence, "conflicted": cell.conflicted})
        i = (i + 1)
    return dv_with({"law": law, "confidence": adoption.confidence, "basis": adoption.basis, "premises": dvs_reason_premises(mind, law.premise)}, "outputs", outputs)

fn dvs_reason_changes(changes):
    var i = 0
    var changed = false
    while (i < rt_count(changes)):
        var change = changes[i]
        if dv_same(dvs_reason_value(change.before), dvs_reason_value(change.after)):
            false
        else:
            changed = true
        i = (i + 1)
    return changed

fn dvs_reason_monotone_satisfied(mind, effects):
    var e = 0
    let n = rt_count(effects)
    while e < n:
        let eff = effects[e]
        if dv_find(eff, "op", "") != "assign":
            return false
        let cell = dv_read(mind, eff.ref)
        if not cell.known or cell.value != eff.value or cell.confidence < 1:
            return false
        e = e + 1
    return true

fn dvs_reason_run(actor, events, time, parent):
    var mind = actor.mind
    var policy = actor.policy
    var budget = dv_find(policy, "reason_budget", 0)
    var count = 0
    var changed = true
    var signatures = dv_find(actor, "inference_signatures", [])
    var derivations = dv_find(actor, "inference_derivations", [])
    while dv_and(changed, (count < budget)):
        var adoptions = mind.adoptions
        var i = 0
        changed = false
        while dv_and((i < rt_count(adoptions)), (count < budget)):
            var entry = adoptions[i]
            var law = entry[1].law
            if dv_and(entry[1].active, (entry[1].mode == "infer")):
                var skip = false
                if dv_find(signatures, entry[0], false) != false and dvs_reason_monotone_satisfied(mind, law.effects):
                    skip = true
                if not skip and (dv_truth(mind, law.premise) == "true"):
                    let sig = dvs_reason_signature(mind, entry[1])
                    if not dv_same(dv_find(signatures, entry[0], false), sig):
                        var stage = dv_stage(mind, law.effects, time, entry[1].basis, entry[1].confidence)
                        if dv_and((stage.status == "ready"), dvs_reason_changes(stage.changes)):
                            var before = mind
                            var result = dv_infer(mind, entry[0], rt_cat("infer", rt_show(rt_count(events))), time, mind.revision)
                            mind = result.world
                            changed = true
                            count = (count + 1)
                            signatures = dv_with(signatures, entry[0], sig)
                            var event = dvs_event(events, "inference", actor.id, time, dv_explanation_merge(dvs_cognitive_parents(actor, dv_single(parent)), dvs_support_parents(before, dvs_sim_refs(law.premise), events, actor)), {"mind_before": before, "mind_after": mind, "law": law, "receipt": result})
                            actor = dv_with(actor, "last_cognitive_event", event)
                            rt_push(derivations, dv_with({"event": event, "adoption": entry[1], "inputs": dvs_sim_inputs(before, law.premise), "changes": result.changes}, "valid", true))
                        else:
                            if (stage.status == "ready"):
                                count = (count + 1)
                                signatures = dv_with(signatures, entry[0], sig)
                                dvs_event(events, "inference_alternative_basis", actor.id, time, dvs_cognitive_parents(actor, dv_single(parent)), {"law": law, "basis": entry[1].basis, "premises": dvs_reason_premises(mind, law.premise), "mind_revision": mind.revision})
            i = (i + 1)
    var local_1 = false
    if (count < budget):
        local_1 = "no-new-effective-conclusion"
    else:
        local_1 = "budget-exhausted"
    let report = {"steps": count, "remaining": budget - count, "stop": local_1, "mind_revision": mind.revision}
    if count > 0 or not dv_same(report, dv_find(actor, "last_reason_report", false)):
        actor = dv_with_many(actor, {"last_cognitive_event": dvs_event(events, "reason_stop", actor.id, time, dvs_cognitive_parents(actor, dv_single(parent)), report), "last_reason_report": report})
    return dv_with_many(actor, {"mind": mind, "inference_derivations": derivations, "inference_signatures": signatures, "policy": dv_with(policy, "reason_budget", (budget - count))})

fn dvs_cached_model(actor, hypothesis):
    var model = dv_find(dv_find(actor, "simulations", []), hypothesis.id, {"fit": 0, "status": "not-simulated"})
    if dv_or((dv_find(model, "source_revision", -1) == actor.mind.revision), dv_and(dv_explanation_model_current(actor.mind, model), dv_same(dv_find(model, "source_response_models", false), dv_find(actor, "response_models", [])))):
        return dv_with(model, "validated_by_inputs", true)
    else:
        if dv_and(dvs_argument_valid(actor), dvs_argument_inputs_current(actor)):
            var argument = actor.argument
            if dv_and((dv_find(model, "source_revision", -1) == argument.source_revision), dv_or((dv_find(model, "event", "") == argument.model_event), dv_has(argument.competitor_events, dv_find(model, "event", "")))):
                return dv_with(model, "validated_by_argument", argument.id)
            else:
                return {"fit": 0, "status": "stale-or-unavailable", "source_revision": dv_find(model, "source_revision", -1)}
        else:
            return {"fit": 0, "status": "stale-or-unavailable", "source_revision": dv_find(model, "source_revision", -1)}

fn dvs_working_explanation(actor, hypothesis):
    if dvs_factor_candidate_rejected(actor, hypothesis):
        return false
    return dv_and(dvp_topic(actor, hypothesis), dv_and((0 < rt_count(dv_find(hypothesis, "features", []))), dv_and((0 < rt_count(dvs_sim_plan(hypothesis))), dv_and((0 < rt_count(dv_find(hypothesis, "basis", []))), dv_and((dv_truth(actor.mind, dv_find(hypothesis, "available_when", dv_true())) == "true"), (not (dv_truth(actor.mind, hypothesis.proposition) == "false")))))))

fn dvs_hypotheses(actor, events, time, parent):
    var mind = actor.mind
    var candidates = dv_find(actor.policy, "hypotheses", [])
    var i = 0
    var best = false
    var score = -1
    var working = false
    while (i < rt_count(candidates)):
        if dvs_working_explanation(actor, candidates[i]):
            working = true
        i = (i + 1)
    i = 0
    while (i < rt_count(candidates)):
        var h = candidates[i]
        if not dvs_factor_candidate_rejected(actor, h):
            var available = dv_find(h, "available_when", dv_true())
            var local_1 = false
            if working:
                local_1 = dvs_working_explanation(actor, h)
            else:
                local_1 = true
            if dv_and(local_1, dv_and(dvp_topic(actor, h), dv_and((0 < rt_count(dv_find(h, "basis", []))), (dv_truth(mind, available) == "true")))):
                var truth = dv_truth(mind, h.proposition)
                var local_2 = false
                if (truth == "false"):
                    local_2 = -1
                else:
                    if (truth == "true"):
                        local_2 = 1
                    else:
                        local_2 = dv_find(h, "prior", 0.5)
                var weight = local_2
                var model = dvs_cached_model(actor, h)
                weight = (weight + model.fit)
                if dv_or((truth == "false"), (dv_find(model, "status", "unknown") == "inconsistent")):
                    false
                else:
                    if (score < weight):
                        best = dv_with(h, "simulation", model)
                        score = weight
        i = (i + 1)
    var previous = dv_find(actor, "hypothesis", false)
    var event = dv_find(actor, "hypothesis_event", "")
    if dv_same(previous, best):
        false
    else:
        var local_3 = false
        if (previous == false):
            local_3 = "hypothesis_adopted"
        else:
            local_3 = "hypothesis_revised"
        event = dvs_event(events, local_3, actor.id, time, dvs_cognitive_parents(actor, dv_single(parent)), {"previous": previous, "current": best, "mind": mind, "preference": score})
    if (event == dv_find(actor, "hypothesis_event", "")):
        false
    else:
        actor = dv_with(actor, "last_cognitive_event", event)
    return dv_with_many(actor, {"hypothesis": best, "hypothesis_event": event})

fn dvs_choose(actor, bindings, costs):
    let key = ["dvp_plan", dvp_memo_input(actor, costs), bindings, costs]
    let cached = rt_memo_get(actor.mind, key)
    if cached[0]:
        return dvs_honor_planned_followup(actor, dv_with_many(cached[1], {"plan_expansions": 0, "dependency_expansions": 0, "plan_cache_hit": true, "reused_plan_expansions": cached[1].plan_expansions, "reused_dependency_expansions": dv_find(cached[1], "dependency_expansions", 0)}))
    return dvs_honor_planned_followup(actor, rt_memo_put(actor.mind, key, dvp_plan(actor, bindings, costs)))

// Keep the actor's own predicted next step after a successful move, provided
// the fresh plan still finds that action directly eligible and valuable.
fn dvs_honor_planned_followup(actor, choice):
    let followup = dv_find(actor, "planned_followup", "")
    if followup == "":
        return choice
    var i = 0
    while i < rt_count(choice.plans):
        let plan = choice.plans[i]
        if rt_count(plan.path) == 1 and plan.path[0] == followup and 0 < plan.score:
            let action = dvp_find_action(actor.actions, followup)
            if action != false:
                return dv_with_many(choice, {"action": action, "score": plan.score, "selected_path": plan.path, "planned_followup_honored": true, "superseded_path": choice.selected_path})
        i = i + 1
    return dv_with(choice, "planned_followup_honored", false)

fn dvs_ready(actor, events, time, parent):
    var hypothesis = dv_find(actor, "hypothesis", false)
    var ready = true
    var reasons = []
    var parents = dvs_cognitive_parents(actor, dv_single(parent))
    var local_1 = false
    if dv_has_key(actor, "question_ref"):
        local_1 = dv_read(actor.mind, actor.question_ref)
    else:
        local_1 = dv_unknown()
    var question = local_1
    if dv_uncontested(question):
        false
    else:
        ready = false
        rt_push(reasons, "current-public-question-unobserved")
    if (hypothesis == false):
        ready = false
        rt_push(reasons, "no-seriously-adopted-hypothesis")
    else:
        var simulation = dv_find(hypothesis, "simulation", [])
        var candidates = dv_find(actor.policy, "hypotheses", [])
        var i = 0
        var simulations = dv_find(actor, "simulations", [])
        var mind = actor.mind
        var local_2 = false
        if dv_has_key(simulation, "validated_by_argument"):
            local_2 = dv_and(dvs_argument_valid(actor), dvs_argument_inputs_current(actor))
        else:
            local_2 = false
        if dv_or((dv_find(simulation, "source_revision", -1) == mind.revision), dv_or(dv_find(simulation, "validated_by_inputs", false), local_2)):
            false
        else:
            ready = false
            rt_push(reasons, "simulation-evidence-version-stale")
        var local_3 = false
        if dv_has_key(simulation, "validated_by_argument"):
            local_3 = actor.argument.source_revision
        else:
            local_3 = mind.revision
        if dv_explanation_model_complete(simulation, "explained", local_3):
            false
        else:
            ready = false
            rt_push(reasons, "simulation-incomplete-or-unknown")
        if dv_has_key(simulation, "validated_by_argument"):
            rt_push(parents, simulation.validated_by_argument)
        if dv_has_key(simulation, "event"):
            rt_push(parents, simulation.event)
        else:
            ready = false
            rt_push(reasons, "missing-paid-simulation-event")
        while (i < rt_count(candidates)):
            var candidate = candidates[i]
            if dv_and((not (candidate.id == hypothesis.id)), dv_and(dvp_topic(actor, candidate), dv_and((dv_find(candidate, "group", "") == dv_find(hypothesis, "group", "")), (dv_truth(mind, dv_find(candidate, "available_when", dv_true())) == "true")))):
                var other = dvs_cached_model(actor, candidate)
                var local_4 = false
                if dv_and(dvs_argument_valid(actor), dvs_argument_inputs_current(actor)):
                    local_4 = dvs_factor_covered(candidate, dv_find(actor.argument, "factor_coverage", {"catalog": [], "certificates": []}).certificates)
                else:
                    local_4 = false
                if dv_or((dv_find(other, "status", "unknown") == "inconsistent"), local_4):
                    if dv_has_key(other, "event"):
                        rt_push(parents, other.event)
                    else:
                        if dv_and(dvs_argument_valid(actor), dvs_argument_inputs_current(actor)):
                            rt_push(parents, actor.argument.id)
                        else:
                            ready = false
                            rt_push(reasons, "missing-competitor-simulation-event")
                else:
                    ready = false
                    rt_push(reasons, rt_cat("unresolved-competitor:", candidate.id))
            i = (i + 1)
    if ready:
        if dv_same(dv_find(actor, "ready_hypothesis", false), hypothesis):
            return actor
        else:
            actor = dv_with(actor, "last_cognitive_event", dvs_event_prepared(events, "answer_ready", actor.id, time, parents, dv_with_many({"hypothesis": hypothesis, "mind_revision": actor.mind.revision, "question_id": dv_find(hypothesis, "question", question.value), "actor_id": actor.id}, {"argument": dv_find(actor, "argument", false), "argument_question": dv_find(hypothesis, "question", question.value)})))
            return dv_with(actor, "ready_hypothesis", hypothesis)
    else:
        let report = {"reasons": reasons, "hypothesis": hypothesis, "mind_revision": actor.mind.revision}
        let previous_report = dv_find(actor, "last_readiness_report", false)
        // Revision alone is not a new readiness explanation; retain the original
        // event's revision, and emit again if reasons or the supported model change.
        if previous_report == false or not dv_same(dv_without(report, "mind_revision"), dv_without(previous_report, "mind_revision")):
            dvs_event(events, "why_not_ready", actor.id, time, parents, report)
        return dv_with(actor, "last_readiness_report", report)

fn dvs_reason(actor, events, time, parent):
    var refreshed = dvs_refresh_derivations(actor, events, time, parent)
    if dv_find(refreshed, "cognition_blocked", false):
        return refreshed
    else:
        return dvs_reason_run(refreshed, events, time, parent)

// Fresh prepared data and borrowed data share the same immutable evidence boundary.
fn dvs_event_prepared(events, kind, actor, time, parents, data):
    return dvs_event(events, kind, actor, time, parents, data)

// Stage-local memo: only inference is reused; other cognition keeps its normal order.
fn dvs_reason_input(actor):
    let adoptions = actor.mind.adoptions
    let key = ["reason_input_refs"]
    let cached = rt_memo_get(adoptions, key)
    var refs = []
    if cached[0]:
        refs = cached[1]
    else:
        var i = 0
        while i < rt_count(adoptions):
            let adoption = adoptions[i][1]
            if adoption.mode == "infer":
                refs = dvp_merge_refs(refs, dvs_sim_refs(adoption.law.premise))
                var j = 0
                while j < rt_count(adoption.law.effects):
                    refs = dvp_add_ref(refs, adoption.law.effects[j].ref)
                    j = j + 1
            i = i + 1
        rt_memo_put(adoptions, key, refs)
    let derivations = dv_find(actor, "inference_derivations", [])
    var i = 0
    while i < rt_count(derivations):
        let inputs = derivations[i].inputs
        var j = 0
        while j < rt_count(inputs):
            refs = dvp_add_ref(refs, inputs[j].ref)
            j = j + 1
        i = i + 1
    var cells = []
    i = 0
    while i < rt_count(refs):
        rt_push(cells, {"ref": refs[i], "cell": dvs_reason_cell(dv_read(actor.mind, refs[i]))})
        i = i + 1
    return {"adoptions": adoptions, "inputs": cells, "derivations": derivations, "signatures": dv_find(actor, "inference_signatures", []), "budget": dv_find(actor.policy, "reason_budget", 0), "blocked": dv_find(actor, "cognition_blocked", false)}

fn dvs_prepare_cognition(actor, events, time, parent, chapter):
    let input = dvs_reason_input(actor)
    var reused = dv_same(input, dv_find(actor, "reason_fixed_input", false))
    if not reused:
        actor = dvs_reason(actor, events, time, parent)
        let completed = dvs_reason_input(actor)
        if dv_same(input, completed) and not dv_find(actor, "cognition_blocked", false):
            actor = dv_with(actor, "reason_fixed_input", rt_snapshot(completed))
        else:
            actor = dv_with(actor, "reason_fixed_input", false)
    actor = dvs_ready(dvs_hypotheses(dvs_pragmatics_reconsider(actor, events, time, parent), events, time, parent), events, time, parent)
    actor = dvs_update_support_events(actor, events)
    actor = dvs_capture_public_topics(actor, events, time, parent)
    actor = dvs_materialize_arguments(dvs_arguments(actor, events, time, parent))
    actor = dvs_prepare_speech_choices(actor, events, time, parent)
    return dv_with_many(actor, {"cognition_input": false, "cognition_reused": false, "reason_reused": reused})

// ---- Merged source module: 16-personal-choice.dv ----
fn dvp_choice_groups(actions):
    var groups = []
    var i = 0
    while i < rt_count(actions):
        let action = actions[i]
        if dv_has_key(action, "personal_choice"):
            let group = action.personal_choice.group
            groups = dv_with(groups, group, dv_append(dv_find(groups, group, []), action))
        i = i + 1
    return groups

// Ordinal personal values are owned by the subject, not by the proposed action.

fn dvp_personal_ready(mind, choice):
    return (0 < rt_count(dv_find(choice, "basis", [])) and dv_truth(mind, choice.requires) == "true" and dv_truth(mind, choice.prohibits) == "false")

fn dvp_personal_impact(choice, value):
    var impact = 0
    if dv_has(choice.promotes, value):
        impact = impact + 1
    if dv_has(choice.sacrifices, value):
        impact = impact - 1
    return impact

fn dvp_personal_better(order, left, right):
    var i = 0
    while (i < rt_count(order)):
        let a = dvp_personal_impact(left, order[i])
        let b = dvp_personal_impact(right, order[i])
        if (a != b):
            return b < a
        i = i + 1
    return false

fn dvp_received_speech_matches(receipts, requirement):
    dv_require(dv_record_like(requirement), "Received speech requirement must be a record")
    var i = 0
    while i < rt_count(receipts):
        let receipt = receipts[i]
        if receipt.speaker == requirement.speaker and receipt.action_id == requirement.action_id and receipt.parse_event != "" and receipt.source_event != "":
            return true
        i = i + 1
    return false

fn dvp_owner_requirements(actor, action, mind):
    if not dvs_actor_can_act(actor):
        return false
    if not dvp_owned_decision_ready(actor, action, mind):
        return false
    if not dvs_advice_decision_ready(actor, action, mind):
        return false
    let resonance = dv_find(action, "resonance", false)
    if resonance != false:
        dv_require(dv_record_like(resonance), "Resonance must be a record")
        if not dv_find(resonance, "passive", false):
            if not (0 < dvp_resonance_utility(actor, action, mind)):
                return false
    let night_call = dv_find(action, "night_call_requirement", false)
    if night_call != false:
        dv_require(dv_record_like(night_call), "Night call requirement must be a record")
        if not dv_find(actor, "night_call_eligible", false) or rt_count(dv_find(night_call, "basis", [])) == 0 or dv_truth(mind, night_call.night_when) != "true":
            return false
    let conflict = dv_find(action, "received_claim_conflict", false)
    if conflict != false:
        dv_require(dv_record_like(conflict), "Received claim conflict must be a record")
        let conflicts = dv_find(actor, "observed_claim_conflicts", [])
        var found_conflict = false
        var conflict_index = 0
        while conflict_index < rt_count(conflicts):
            let evidence = conflicts[conflict_index]
            dv_require(dv_record_like(evidence), "Observed claim conflict must be a record")
            if evidence.key == conflict.key and evidence.speaker == conflict.speaker:
                if dv_find(evidence, "source_event", "") != "" and dv_find(evidence, "previous_source", "") != "" and dv_find(evidence, "parse_event", "") != "" and 0 < rt_count(dv_find(evidence, "basis", [])):
                    found_conflict = true
            conflict_index = conflict_index + 1
        if not found_conflict:
            return false
    let opportunity = dv_find(action, "opportunity_requirement", false)
    if opportunity != false:
        dv_require(dv_record_like(opportunity), "Opportunity requirement must be a record")
        dv_require(dv_has(["all-present", "at-least-one-present", "none-present"], opportunity.mode), "Unknown opportunity mode")
        let own = dv_read(mind, actor.location_ref)
        if not dv_uncontested(own) or own.value != opportunity.location:
            return false
        let context = dv_find(actor, "visible_context", [])
        var present = 0
        var i = 0
        while i < rt_count(opportunity.participants):
            let id = opportunity.participants[i]
            let peer = dv_find(context, id, false)
            if id == actor.id:
                present = present + 1
            else:
                if peer != false:
                    if peer.location == opportunity.location:
                        present = present + 1
            i = i + 1
        if opportunity.mode == "all-present" and present != rt_count(opportunity.participants):
            return false
        if opportunity.mode == "at-least-one-present" and present == 0:
            return false
        if opportunity.mode == "none-present":
            // An empty projected list at an unvisited destination is not an observation.
            if present != 0 or not dv_find(actor, "visible_context_clear", false) or dv_find(actor, "visible_context_location", false) != own.value:
                return false
    let heard = dv_find(action, "received_speech_requirement", false)
    if heard != false:
        dv_require(dv_record_like(heard), "Received speech requirement must be a record")
        let receipts = dv_find(actor, "received_speeches", [])
        var found = false
        if dv_has_key(heard, "any_of"):
            dv_require(rt_is_list(heard.any_of), "Received speech any_of must be a list")
            var i = 0
            while i < rt_count(heard.any_of):
                if dvp_received_speech_matches(receipts, heard.any_of[i]):
                    found = true
                i = i + 1
        else:
            found = dvp_received_speech_matches(receipts, heard)
        if not found:
            return false
    if dv_find(action, "response_once", false) and dv_has(dv_find(actor, "completed_actions", []), action.id):
        return false
    let superseded = dv_find(action, "suppress_after_received_speech", false)
    if superseded != false:
        dv_require(dv_record_like(superseded), "Suppressing speech requirement must be a record")
        if dvp_received_speech_matches(dv_find(actor, "received_speeches", []), superseded):
            return false
    let completed = dv_find(action, "completed_action_requirement", false)
    if completed != false:
        dv_require(dv_record_like(completed), "Completed action requirement must be a record")
        if not dv_has(dv_find(actor, "completed_actions", []), completed.action_id):
            return false
    let desire = dv_find(action, "desire_requirement", false)
    if desire != false:
        dv_require(dv_record_like(desire), "Desire requirement must be a record")
        if desire.subject != actor.id:
            return false
        let desires = dv_find(actor.policy, "desires", [])
        var found = false
        var i = 0
        while i < rt_count(desires):
            if desires[i].id == desire.desire_id and 0 < rt_count(dv_find(desires[i], "basis", [])):
                found = true
            i = i + 1
        if not found:
            return false
    return true

fn dvp_eligible(actor, action, mind, relevant):
    if (not dvp_eligible_base(actor, action, mind, relevant)):
        return false
    return dvp_eligible_after_base(actor, action, mind, relevant)

fn dvp_owner_interpretation_ready(actor, action):
    let attitude = dv_find(action, "owner_interpretation_requirement", false)
    if attitude != false:
        dv_require(dv_record_like(attitude), "Owner interpretation requirement must be a record")
        let interpretation = dv_find(dv_find(actor, "interpretations", []), attitude.interpretation_id, false)
        if interpretation == false:
            return false
        dv_require(dv_record_like(interpretation), "Owner interpretation must be a record")
        if attitude.subject != actor.id or interpretation.status != attitude.required_status or dv_find(interpretation, "source_event", "") == "":
            return false
    return true

// This single-owner gate is deliberately nonrecursive; group comparison calls it
// for each alternative without re-entering the alternative's whole choice group.
fn dvp_personal_admissible(actor, action, mind):
    if not dv_has_key(action, "personal_choice"):
        return true
    let choice = action.personal_choice
    if not dvp_personal_ready(mind, choice):
        return false
    let order = dv_find(actor.policy, "value_order", [])
    if rt_count(order) == 0 or rt_count(dv_find(actor.policy, "value_basis", [])) == 0:
        return false
    if dv_find(choice, "require_positive", false):
        var i = 0
        var first = 0
        while i < rt_count(order) and first == 0:
            first = dvp_personal_impact(choice, order[i])
            i = i + 1
        if first <= 0:
            return false
    return true

fn dvp_eligible_after_base(actor, action, mind, relevant):
    if not dvp_owner_requirements(actor, action, mind):
        return false
    if not dvp_normative_ready(actor, action, mind):
        return false
    if not dvp_owner_interpretation_ready(actor, action):
        return false
    if (not dv_has_key(action, "personal_choice")):
        return true
    let choice = action.personal_choice
    if not dvp_personal_admissible(actor, action, mind):
        return false
    let order = dv_find(actor.policy, "value_order", [])
    var alternatives = actor.actions
    if dv_has_key(actor, "planning_choice_groups"):
        alternatives = dv_find(actor.planning_choice_groups, choice.group, [])
    var i = 0
    while (i < rt_count(alternatives)):
        let other = alternatives[i]
        if (other.id != action.id and dv_has_key(other, "personal_choice")):
            if (other.personal_choice.group == choice.group and dvp_personal_admissible(actor, other, mind)):
                if (dvp_eligible_base(actor, other, mind, relevant) and dvp_owner_requirements(actor, other, mind) and dvp_normative_ready(actor, other, mind) and dvp_owner_interpretation_ready(actor, other) and dvp_personal_better(order, other.personal_choice, choice)):
                    return false
        i = i + 1
    return true

// Norms affect this owner's choice; they never become physical prohibitions.
fn dvp_normative_ready(actor, action, mind):
    let decision = dv_find(action, "norm_decision", false)
    if decision != false:
        dv_require(dv_record_like(decision), "Norm decision must be a record")
        let proposal = dv_find(dv_find(actor, "norm_proposals", []), decision.id, false)
        if proposal == false:
            return false
        dv_require(dv_record_like(proposal), "Received norm proposal must be a record")
        if dv_find(proposal, "source_event", "") == "" or dv_find(proposal, "parse_event", "") == "" or not dv_same(proposal.norm, decision.norm):
            return false
    // An unsupervised act is valued by its owner, independently of a public pledge.
    let private = dv_find(action, "private_execution", false)
    if private != false:
        dv_require(dv_record_like(private), "Private execution must be a record")
        if rt_count(dv_find(private, "basis", [])) == 0 or dv_truth(mind, private.requires) != "true":
            return false
        if dvp_private_execution_utility(actor, action, mind) <= 0:
            return false
    let method = dv_find(action, "normative_method", "")
    if method == "":
        return true
    let rules = dv_find(actor.policy, "norm_rules", [])
    let order = dv_find(actor.policy, "value_order", [])
    let choice = dv_find(action, "personal_choice", {"promotes": [], "sacrifices": []})
    var matched = false
    var applicable = []
    var i = 0
    while i < rt_count(rules):
        let rule = rules[i]
        if method != "" and rule.method == method and 0 < rt_count(rule.basis) and dv_truth(mind, rule.available_when) == "true":
            rt_push(applicable, rule)
            matched = true
        i = i + 1
    if not matched:
        return true
    i = 0
    while i < rt_count(order):
        var impact = dvp_personal_impact(choice, order[i])
        var j = 0
        while j < rt_count(applicable):
            let rule = applicable[j]
            let value = dvp_personal_impact({"promotes": dv_find(rule, "promotes", []), "sacrifices": dv_find(rule, "sacrifices", [])}, order[i])
            if rule.mode == "forbid":
                impact = impact - value
            else:
                impact = impact + value
            j = j + 1
        if impact != 0:
            return 0 < impact
        i = i + 1
    return true

// All numeric inputs are explicit owner declarations or uncontested owner knowledge.
fn dvp_owned_quantity(actor, mind, declaration):
    if rt_is_numeric_value(declaration):
        return declaration
    if declaration == false:
        return 0
    dv_require(dv_record_like(declaration), "Owned quantity must be a number or record")
    if dv_has_key(declaration, "speaker"):
        return dvs_speaker_trust(actor.policy, declaration.speaker)
    if dv_has_key(declaration, "policy_key"):
        let quantity = dv_find(actor.policy, declaration.policy_key, 0)
        dv_require(rt_is_numeric_value(quantity), "Owned policy quantity must be numeric")
        return quantity
    dv_require(dv_has_key(declaration, "ref"), "Owned quantity needs policy_key or ref")
    dv_require(dv_record_like(declaration.ref), "Owned quantity ref must be a record")
    let cell = dv_read(mind, declaration.ref)
    if dv_uncontested(cell) and rt_is_numeric_value(cell.value):
        return cell.value
    return 0

fn dvp_owner_utility(actor, action, mind):
    let declaration = dv_find(action, "owner_utility", false)
    if declaration == false:
        return {"value": 0, "terms": []}
    dv_require(dv_record_like(declaration), "Owner utility must be a record")
    if rt_count(dv_find(declaration, "basis", [])) == 0 or dv_truth(mind, declaration.requires) != "true":
        return {"value": 0, "terms": []}
    var value = 0
    var inputs = []
    var i = 0
    while i < rt_count(declaration.terms):
        let term = declaration.terms[i]
        dv_require(rt_is_numeric_value(term.weight), "Owner utility weight must be numeric")
        let quantity = dvp_owned_quantity(actor, mind, term.quantity)
        let contribution = quantity * term.weight
        value = value + contribution
        rt_push(inputs, {"declaration": term.quantity, "quantity": quantity, "weight": term.weight, "contribution": contribution})
        i = i + 1
    return {"value": value, "terms": inputs, "basis": declaration.basis}

fn dvp_private_execution_utility(actor, action, mind):
    let private = dv_find(action, "private_execution", false)
    if private == false:
        return 0
    dv_require(dv_record_like(private), "Private execution must be a record")
    if rt_count(dv_find(private, "basis", [])) == 0 or dv_truth(mind, private.requires) != "true":
        return 0
    let multiplier = dv_find(actor.policy, "private_execution_benefit_multiplier", 1)
    dv_require(rt_is_numeric_value(multiplier), "Private benefit multiplier must be numeric")
    dv_require(0 <= multiplier, "Private benefit multiplier must be nonnegative")
    return dvp_owned_quantity(actor, mind, private.benefit) * multiplier - dvp_owned_quantity(actor, mind, private.resource_cost)

fn dvp_resonance_utility(actor, action, mind):
    let r = action.resonance
    dv_require(dv_record_like(r), "Resonance must be a record")
    if rt_count(dv_find(r, "basis", [])) == 0 or dv_truth(mind, dv_find(r, "requires", dv_true())) != "true":
        return 0
    let retrieved = dv_find(r, "retrieved_when", false)
    if retrieved != false and dv_truth(mind, retrieved) == "true":
        return 0
    let drive = dvp_owned_quantity(actor, mind, r.drive)
    let relevance = dvp_owned_quantity(actor, mind, r.relevance)
    let bonus = dvp_owned_quantity(actor, mind, r.truth_bonus)
    let caution = dvp_owned_quantity(actor, mind, r.caution)
    let risk = dvp_owned_quantity(actor, mind, r.perceived_risk)
    return drive * relevance + bonus - caution - risk

// Keep owner-only utility inputs in the planning dependency signature and slice.
fn dvp_owner_requirement_refs(action):
    var refs = []
    let utility = dv_find(action, "owner_utility", false)
    if utility != false:
        refs = dvp_merge_refs(refs, dvs_sim_refs(utility.requires))
        var ui = 0
        while ui < rt_count(utility.terms):
            let quantity = utility.terms[ui].quantity
            if quantity != false and not rt_is_numeric_value(quantity):
                if dv_has_key(quantity, "ref"):
                    refs = dvp_add_ref(refs, quantity.ref)
            ui = ui + 1
    let private = dv_find(action, "private_execution", false)
    if private != false:
        dv_require(dv_record_like(private), "Private execution must be a record")
        refs = dvp_merge_refs(refs, dvs_sim_refs(private.requires))
        let quantities = [private.benefit, private.resource_cost]
        var pi = 0
        while pi < rt_count(quantities):
            let quantity = quantities[pi]
            if quantity != false and not rt_is_numeric_value(quantity):
                dv_require(dv_record_like(quantity), "Owned quantity must be a number or record")
                if not dv_has_key(quantity, "policy_key") and not dv_has_key(quantity, "speaker"):
                    dv_require(dv_has_key(quantity, "ref"), "Owned quantity needs policy_key or ref")
                    dv_require(dv_record_like(quantity.ref), "Owned quantity ref must be a record")
                    refs = dvp_add_ref(refs, quantity.ref)
            pi = pi + 1
    let r = dv_find(action, "resonance", false)
    if r != false:
        dv_require(dv_record_like(r), "Resonance must be a record")
        if not dv_find(r, "passive", false):
            refs = dvp_merge_refs(refs, dvs_sim_refs(dv_find(r, "requires", dv_true())))
            let retrieved = dv_find(r, "retrieved_when", false)
            if retrieved != false:
                refs = dvp_merge_refs(refs, dvs_sim_refs(retrieved))
            let quantities = [r.drive, r.relevance, r.truth_bonus, r.caution, r.perceived_risk]
            var i = 0
            while i < rt_count(quantities):
                let quantity = quantities[i]
                if quantity != false and not rt_is_numeric_value(quantity):
                    dv_require(dv_record_like(quantity), "Owned quantity must be a number or record")
                    if not dv_has_key(quantity, "policy_key") and not dv_has_key(quantity, "speaker"):
                        dv_require(dv_has_key(quantity, "ref"), "Owned quantity needs policy_key or ref")
                        dv_require(dv_record_like(quantity.ref), "Owned quantity ref must be a record")
                        refs = dvp_add_ref(refs, quantity.ref)
                i = i + 1
    let night = dv_find(action, "night_call_requirement", false)
    if night != false:
        dv_require(dv_record_like(night), "Night call requirement must be a record")
        refs = dvp_merge_refs(refs, dvs_sim_refs(night.night_when))
    let decision = dv_find(action, "owned_decision", false)
    if decision != false:
        refs = dvp_merge_refs(refs, dv_find(decision, "context_refs", []))
    return refs

fn dvs_actor_can_act(actor):
    let stage = dv_find(actor, "erosion_stage", "early")
    return stage != "terminal" and stage != "death"

// A reproducible integer stream; samples are selected only from declared options.
fn dvs_cognitive_seed_next(seed):
    let n = seed * 48271 + 1
    return n - rt_floor(n / 2147483647) * 2147483647

fn dvs_initialize_cognition(actor, seed, ordinal):
    dv_require(0 <= seed and rt_floor(seed) == seed, "Opening seed must be a nonnegative integer")
    let declaration = dv_find(actor, "cognitive_initialization", false)
    if declaration == false:
        if dv_has_key(actor, "erosion"):
            return dv_with(actor, "first_day_mind", actor.mind)
        return actor
    dv_require(rt_count(dv_find(declaration, "basis", [])) > 0, "Cognitive initialization needs declared provenance")
    var stream = dvs_cognitive_seed_next(seed + ordinal)
    var policy = actor.policy
    let samples = dv_find(declaration, "samples", [])
    var selected = []
    var i = 0
    while i < rt_count(samples):
        let sample = samples[i]
        dv_require(0 < rt_count(dv_find(sample, "basis", [])), "Cognitive sample needs provenance")
        let options = sample.options
        dv_require(0 < rt_count(options), "Empty cognitive sample domain")
        stream = dvs_cognitive_seed_next(stream)
        let index = stream - rt_floor(stream / rt_count(options)) * rt_count(options)
        policy = dv_with(policy, sample.key, options[index])
        selected = dv_with(selected, sample.key, options[index])
        i = i + 1
    policy = dv_with_many(policy, dv_find(declaration, "profile", []))
    return dv_with_many(actor, {"policy": policy, "cognitive_seed": seed, "cognitive_samples": selected, "first_day_mind": actor.mind})

// Erosion is content-defined exposure/threshold data, with an explicit first-day snapshot.
fn dvs_erosion_update(actor, physical, time):
    let erosion = dv_find(actor, "erosion", false)
    if erosion == false:
        return actor
    let exposure_cell = dv_read(physical, erosion.physical_ref)
    var exposure = 0
    if dv_uncontested(exposure_cell) and rt_is_numeric_value(exposure_cell.value):
        exposure = exposure_cell.value
    exposure = exposure * (1 + dv_find(actor, "resonance_coupling", 0) * dv_find(erosion, "coupling_factor", 0))
    let stages = ["early", "middle", "late", "terminal", "death"]
    var rank = dv_find(actor, "erosion_rank", 0)
    var i = 0
    while i < rt_count(erosion.thresholds):
        let threshold = erosion.thresholds[i]
        if threshold.at <= exposure and rank < threshold.rank:
            rank = threshold.rank
        i = i + 1
    dv_require(0 <= rank and rank < rt_count(stages), "Invalid erosion stage")
    var result = dv_with_many(actor, {"erosion_rank": rank, "erosion_stage": stages[rank]})
    let memory_period = dv_find(erosion, "memory_period", 1440)
    dv_require(0 < memory_period, "Erosion memory period must be positive")
    let memory_epoch = rt_floor(time / memory_period)
    if 2 <= rank and (not dv_find(actor, "erosion_memory_truncated", false) or dv_find(actor, "erosion_memory_epoch", -1) != memory_epoch):
        dv_require(dv_has_key(actor, "first_day_mind"), "Late erosion needs declared first-day memory snapshot")
        let old = actor.mind
        let memory = dv_with_many(actor.first_day_mind, {"time": time, "revision": old.revision + 1})
        result = dv_with_many(result, {"mind": memory, "erosion_memory_truncated": true, "erosion_memory_epoch": memory_epoch, "simulations": [], "interpretations": [], "response_models": [], "proposals": [], "received_speeches": [], "received_advice": [], "owned_decisions": [], "pending_heard": [], "observed_public_claims": [], "observed_claim_conflicts": [], "pending_player_influences": [], "dependency_cache": false})
    return result

// Only the actual audible reception path invokes this, never speaker forecasts.
fn dvs_receive_public_claim(listener, speech, speaker, source, parse_event):
    let claim = dv_find(speech, "public_claim", false)
    if claim == false:
        return listener
    dv_require(0 < rt_count(dv_find(claim, "basis", [])), "Public claim needs content provenance")
    let history = dv_find(listener, "observed_public_claims", [])
    var conflicts = dv_find(listener, "observed_claim_conflicts", [])
    var i = 0
    while i < rt_count(history):
        let prior = history[i]
        if prior.speaker == speaker and prior.key == claim.key and dv_has(dv_find(claim, "conflicts_with", []), prior.value):
            conflicts = dv_append(conflicts, {"speaker": speaker, "key": claim.key, "previous_source": prior.source_event, "source_event": source, "parse_event": parse_event, "basis": claim.basis})
        i = i + 1
    let received = {"speaker": speaker, "key": claim.key, "value": claim.value, "source_event": source, "parse_event": parse_event}
    return dv_with_many(listener, {"observed_public_claims": dv_append(history, received), "observed_claim_conflicts": conflicts})

fn dvs_recorded_event_position(events, id):
    var i = rt_count(events) - 1
    while i >= 0:
        if events[i].id == id:
            return i
        i = i - 1
    return -1

// Follow only the actual execution's host/quote/planning chain. Cognitive
// ancestors can contain an older selection of the same action and are not used.
fn dvs_action_selection_evidence(events, actor, action, execution_event):
    var cursor = execution_event
    var seen = []
    while cursor != "" and not dv_has(seen, cursor):
        rt_push(seen, cursor)
        let current = dvs_find_event_by_id(events, cursor)
        if current == false or current.actor != actor.id:
            return false
        if current.type == "action_selected":
            if dv_find(dv_find(current.data, "action", []), "id", "") == action.id:
                return {"event": current.id, "position": dvs_recorded_event_position(events, current.id), "time": current.time}
            return false
        if not dv_has(["action_execution", "host_completion", "cost_quote", "planning_choice", "action_scheduled"], current.type) or rt_count(current.parents) != 1:
            return false
        cursor = current.parents[0]
    return false

fn dvs_heard_before_selection(events, actor, action, execution_event, parse_event, source_event):
    let selection = dvs_action_selection_evidence(events, actor, action, execution_event)
    let parsed = dvs_find_event_by_id(events, parse_event)
    if selection == false or parsed == false:
        return false
    if parsed.type != "listener_parse" or parsed.actor != actor.id or dv_find(parsed.data, "source_event", "") != source_event:
        return false
    let position = dvs_recorded_event_position(events, parse_event)
    if position < 0 or selection.position <= position:
        return false
    return selection

// A decision keeps its semantic inputs separate from evidence provenance. A
// repeated inspection of the same value does not create a new decision context.
fn dvs_owned_decision_request(actor, topic):
    let requests = dv_find(actor, "received_requests", [])
    var latest = false
    var i = 0
    while i < rt_count(requests):
        let receipt = requests[i]
        if receipt.topic == topic and dv_find(receipt, "source_event", "") != "" and dv_find(receipt, "parse_event", "") != "":
            latest = receipt
        i = i + 1
    return latest

fn dvs_owned_decision_inputs(actor, decision, mind):
    dv_require(dv_record_like(decision), "Owned decision must be a record")
    dv_require(dv_find(decision, "id", "") != "" and dv_find(decision, "stance", "") != "", "Owned decision needs identity and stance")
    dv_require(rt_count(dv_find(decision, "basis", [])) > 0, "Owned decision needs declared provenance")
    let refs = dv_find(decision, "context_refs", [])
    let topics = dv_find(decision, "request_topics", [])
    dv_require(rt_is_list(refs) and rt_is_list(topics), "Owned decision references and request topics must be lists")
    var values = []
    var sources = []
    var requests = []
    var request_sources = []
    var i = 0
    while i < rt_count(refs):
        let ref = refs[i]
        dv_require(dv_record_like(ref) and dv_find(ref, "type", "") == "ref", "Owned decision context needs field references")
        let subject = dv_find(ref, "subject", actor.id)
        dv_require(subject == "" or subject == actor.id, "Owned decision context must belong to this subject")
        let local = dv_scoped_ref(actor.id, ref.object, ref.facet, ref.field)
        let cell = dv_read(mind, local)
        rt_push(values, {"ref": local, "known": cell.known, "conflicted": cell.conflicted, "value": cell.value})
        rt_push(sources, {"ref": local, "cell": cell})
        i = i + 1
    i = 0
    while i < rt_count(topics):
        let topic = topics[i]
        let receipt = dvs_owned_decision_request(actor, topic)
        var identity = false
        if receipt != false:
            identity = {"requester": receipt.requester, "source_event": receipt.source_event, "parse_event": receipt.parse_event}
        rt_push(requests, {"topic": topic, "receipt": identity})
        rt_push(request_sources, {"topic": topic, "receipt": receipt})
        i = i + 1
    let policy_keys = dv_find(decision, "context_policy_keys", [])
    dv_require(rt_is_list(policy_keys), "Owned decision policy keys must be a list")
    var policy_values = []
    i = 0
    while i < rt_count(policy_keys):
        rt_push(policy_values, {"key": policy_keys[i], "value": dv_find(actor.policy, policy_keys[i], false)})
        i = i + 1
    return {"context": {"values": values, "requests": requests, "policy_values": policy_values}, "sources": {"fields": sources, "requests": request_sources, "policy_values": policy_values}}

fn dvs_owned_decision_context(actor, decision, mind):
    return dvs_owned_decision_inputs(actor, decision, mind).context

fn dvp_owned_decision_ready(actor, action, mind):
    let decision = dv_find(action, "owned_decision", false)
    if decision == false:
        return true
    let context = dvs_owned_decision_context(actor, decision, mind)
    let previous = dv_find(dv_find(actor, "owned_decisions", []), decision.id, false)
    return previous == false or not dv_same(previous.context, context)

// Stored only in the real action_selected event; forecasts never call this.
fn dvs_owned_decision_selection(actor, action):
    let decision = dv_find(action, "owned_decision", false)
    if decision == false:
        return false
    return dv_with(dvs_owned_decision_inputs(actor, decision, actor.mind), "declaration", decision)

// Also used before publishing actual effects, so a changed queued decision is
// rejected rather than recorded as if it had been selected under the new input.
fn dvs_owned_decision_completion_selection(actor, action, events, parent):
    let decision = dv_find(action, "owned_decision", false)
    if decision == false:
        return true
    if not dvp_owned_decision_ready(actor, action, actor.mind):
        return false
    let selection = dvs_action_selection_evidence(events, actor, action, parent)
    if selection == false:
        return false
    let selected_event = dvs_find_event_by_id(events, selection.event)
    let snapshot = dv_find(selected_event.data, "owned_decision", false)
    if snapshot == false or not dv_same(snapshot.declaration, decision) or not dv_same(snapshot.context, dvs_owned_decision_context(actor, decision, actor.mind)):
        return false
    let requests = snapshot.sources.requests
    var i = 0
    while i < rt_count(requests):
        let receipt = requests[i].receipt
        if receipt != false:
            let source = dvs_find_event_by_id(events, receipt.source_event)
            if source == false or source.type != "speech_literal" or source.actor != receipt.requester:
                return false
            let request = dv_find(dv_find(source.data, "speech", []), "request", false)
            if request == false or request.target != actor.id or request.topic != requests[i].topic or not dv_same(request, receipt.request):
                return false
            if dvs_heard_before_selection(events, actor, action, parent, receipt.parse_event, receipt.source_event) == false:
                return false
            let parsed = dvs_find_event_by_id(events, receipt.parse_event)
            if not dv_has(parsed.parents, receipt.source_event) or dvs_recorded_event_position(events, receipt.parse_event) <= dvs_recorded_event_position(events, receipt.source_event):
                return false
        i = i + 1
    return dv_with(snapshot, "selection_event", selection.event)

// Called only by actual Complete. Passive flashbacks do not acquire paid coupling.
fn dvs_complete_cognitive_effects(actor, action, success, events, event, time):
    if not success:
        return actor
    var result = actor
    let r = dv_find(action, "resonance", false)
    if r != false:
        dv_require(dv_record_like(r), "Resonance must be a record")
    if r != false and not dv_find(r, "passive", false):
        let retrieved = dv_find(r, "retrieved_when", {"op": "constant", "value": "false"})
        if dv_truth(actor.mind, retrieved) == "true":
            let coupling = dv_find(actor, "resonance_coupling", 0) + dv_find(r, "coupling", 0)
            var policy = actor.policy
            var trust = dv_find(policy, "speaker_trust", [])
            let changes = dv_find(r, "trust_changes", [])
            var i = 0
            while i < rt_count(changes):
                let change = changes[i]
                trust = dv_with(trust, change.subject, dv_unit(dv_min(1, dv_max(0, dv_find(trust, change.subject, 0.5) + change.delta))))
                i = i + 1
            policy = dv_with(policy, "speaker_trust", trust)
            result = dv_with_many(result, {"resonance_coupling": coupling, "night_call_eligible": dv_find(actor, "night_call_eligible", false) or dv_find(r, "night_call", false), "policy": policy, "resonance_receipts": dv_append(dv_find(actor, "resonance_receipts", []), {"event": event, "time": time, "action": action.id, "coupling": coupling})})
    let influence = dv_find(action, "influence_consequence", false)
    if influence != false:
        if 0 < rt_count(dv_find(influence, "basis", [])) and dv_truth(actor.mind, influence.consequence_when) == "true":
            let heard = dv_find(actor, "received_speeches", [])
            var i = 0
            while i < rt_count(heard):
                let speech = heard[i]
                if speech.speaker == influence.speaker and speech.action_id == influence.action_id:
                    let selection = dvs_heard_before_selection(events, actor, action, event, speech.parse_event, speech.source_event)
                    if selection != false:
                        result = dv_with(result, "influence_consequences", dv_append(dv_find(result, "influence_consequences", []), {"speech_event": speech.source_event, "parse_event": speech.parse_event, "selection_event": selection.event, "execution_event": event, "action": action.id, "time": time, "basis": influence.basis, "record_kind": "post-advice-matching-behavior", "causal_attribution": "not-established", "consequence_transition": "not-assessed"}))
                i = i + 1
    return result

// An explicit speech declaration records intent only after actual emission
// and audible parsing. No forecast enters this provenance ledger.
fn dvs_receive_player_influence(listener, speech, speaker, source, parse_event):
    let manipulation = dv_find(speech, "manipulation", false)
    if manipulation == false or dv_find(speech, "actual_influence_actor", dv_find(speech, "actual_player_actor", "")) != speaker or dv_find(speech, "actual_literal_truth", "unknown") != "true":
        return listener
    if not dv_has(dv_find(manipulation, "targets", []), listener.id) or rt_count(dv_find(manipulation, "basis", [])) == 0:
        return listener
    let receipt = {"player": speaker, "control": dv_find(speech, "actual_influence_control", "player"), "target": listener.id, "method": manipulation.method, "speech_event": source, "parse_event": parse_event, "declaration": manipulation}
    return dv_with(listener, "pending_player_influences", dv_append(dv_find(listener, "pending_player_influences", []), receipt))

// Advice is a received recommendation, never a granted fact or an action order.
fn dvs_receive_advice(listener, speech, speaker, source, parse_event, literal):
    let proposal = dv_find(speech, "advice", false)
    if proposal == false:
        return listener
    if not dv_has(dv_find(proposal, "targets", []), listener.id) or rt_count(dv_find(proposal, "basis", [])) == 0:
        return listener
    dv_require(dv_has_key(proposal, "id") and dv_has_key(proposal, "position"), "Advice needs an identity and a recommendation position")
    let receipt = {"id": proposal.id, "speaker": speaker, "source_event": source, "parse_event": parse_event, "literal": literal, "proposal": proposal, "meaning": "recommendation-received-not-adopted-or-executed"}
    return dv_with_many(listener, {"received_advice": dv_with(dv_find(listener, "received_advice", []), proposal.id, receipt), "advice_receipts": dv_append(dv_find(listener, "advice_receipts", []), receipt)})

// Reuse the owner's existing action motivation/risk formula, without changing its
// inputs, granting a forecast or attaching resonance to the response action.
fn dvs_advice_assessment(actor, receipt, action_id, mind):
    if not dv_has(dv_find(receipt.proposal, "proposed_action_ids", []), action_id):
        return false
    let target = dvp_find_action(actor.actions, action_id)
    if target == false:
        return false
    let resonance = dv_find(target, "resonance", false)
    if resonance == false:
        let choice = dv_find(target, "personal_choice", false)
        let order = dv_find(actor.policy, "value_order", [])
        if choice == false or rt_count(order) == 0 or rt_count(dv_find(actor.policy, "value_basis", [])) == 0:
            return false
        let ready = dv_truth(mind, target.precondition) == "true" and dvp_personal_ready(mind, choice) and dvp_normative_ready(actor, target, mind)
        var impact = 0
        var i = 0
        while i < rt_count(order) and impact == 0:
            impact = dvp_personal_impact(choice, order[i])
            i = i + 1
        var accepted = false
        if receipt.proposal.position == "consider":
            accepted = ready and impact > 0
        if receipt.proposal.position == "avoid":
            accepted = ready and impact <= 0
        if receipt.proposal.position == "owner-decides":
            accepted = ready
        return {"accepted": accepted, "target_action": action_id, "assessment_kind": "existing-owner-ordinal-values", "first_impact": impact, "requires_truth": dv_truth(mind, target.precondition), "basis": dv_find(actor.policy, "value_basis", []), "value_order": order, "choice": choice, "meaning": "owner-assessment-only; acceptance-does-not-execute-or-reweight-target"}
    if dv_find(resonance, "passive", false):
        return false
    let requires = dv_find(resonance, "requires", dv_true())
    let ready = dv_truth(mind, requires) == "true" and 0 < rt_count(dv_find(resonance, "basis", []))
    let utility = dvp_resonance_utility(actor, target, mind)
    var accepted = false
    if receipt.proposal.position == "consider":
        accepted = ready and utility > 0
    if receipt.proposal.position == "avoid":
        accepted = ready and utility <= 0
    if receipt.proposal.position == "owner-decides":
        accepted = ready
    return {"accepted": accepted, "target_action": action_id, "assessment_kind": "existing-owner-resonance-utility", "utility": utility, "requires_truth": dv_truth(mind, requires), "basis": resonance.basis, "inputs": {"drive": dvp_owned_quantity(actor, mind, resonance.drive), "relevance": dvp_owned_quantity(actor, mind, resonance.relevance), "truth_bonus": dvp_owned_quantity(actor, mind, resonance.truth_bonus), "caution": dvp_owned_quantity(actor, mind, resonance.caution), "perceived_risk": dvp_owned_quantity(actor, mind, resonance.perceived_risk)}, "meaning": "owner-assessment-only; acceptance-does-not-execute-or-reweight-target"}

fn dvs_advice_decision_ready(actor, action, mind):
    let decision = dv_find(action, "advice_decision", false)
    if decision == false:
        return true
    let receipt = dv_find(dv_find(actor, "received_advice", []), decision.advice_id, false)
    if receipt == false or receipt.source_event == "" or receipt.parse_event == "":
        return false
    let stance = dv_find(dv_find(actor, "advice_stances", []), decision.advice_id, false)
    if stance != false and dv_find(stance, "parse_event", "") == receipt.parse_event:
        return false
    let assessment = dvs_advice_assessment(actor, receipt, decision.assessment_action_id, mind)
    return assessment != false and assessment.accepted == decision.accepted

// A declared behavioral effect must actually execute and its physical consequence
// must become true. Intent, interpretation and prediction do not count as outcome.
fn dvs_complete_player_influences(actor, action, before, after, success, events, event, time):
    if not success:
        return actor
    let pending = dv_find(actor, "pending_player_influences", [])
    if rt_count(pending) == 0:
        return actor
    var retained = []
    var history = dv_find(actor, "player_influence_history", [])
    var i = 0
    while i < rt_count(pending):
        let influence = pending[i]
        let declaration = influence.declaration
        var completed = false
        let selection = dvs_heard_before_selection(events, actor, action, event, influence.parse_event, influence.speech_event)
        if selection != false and dv_has(dv_find(declaration, "action_ids", []), action.id):
            let prior = dv_truth(before, declaration.consequence_when)
            let actual = dv_truth(after, declaration.consequence_when)
            if prior != "true" and actual == "true":
                var stance = dv_find(dv_find(actor, "advice_stances", []), dv_find(declaration, "advice_id", ""), false)
                if stance != false:
                    let stance_position = dvs_recorded_event_position(events, stance.event)
                    if stance.parse_event != influence.parse_event or stance_position < 0 or selection.position <= stance_position:
                        stance = false
                history = dv_append(history, {"player": influence.player, "control": dv_find(influence, "control", "player"), "target": actor.id, "method": influence.method, "speech_event": influence.speech_event, "parse_event": influence.parse_event, "selection_event": selection.event, "execution_event": event, "action": action.id, "time": time, "consequence": declaration.consequence_when, "before": prior, "after": actual, "basis": declaration.basis, "advice_stance_before_selection": stance, "record_kind": "post-advice-matching-behavior", "causal_attribution": "not-established"})
                completed = true
        if not completed:
            rt_push(retained, influence)
        i = i + 1
    return dv_with_many(actor, {"pending_player_influences": retained, "player_influence_history": history})

// ---- Merged source module: 18-requests.dv ----
// Requests are received speech; replies remain the other subject's paid action.

fn dvs_pending_request(actor, action):
    var topic = dv_find(action, "response_topic", "")
    var requests = dv_find(actor, "received_requests", [])
    var answered = dv_find(actor, "answered_requests", [])
    var result = []
    var i = 0
    while dv_and((rt_count(result) == 0), (i < rt_count(requests))):
        var request = requests[i]
        if dv_and((request.topic == topic), (not dv_has(answered, request.parse_event))):
            result = request
        i = (i + 1)
    return result

fn dvs_receive_request(actor, speech, parse_event, source, speaker):
    var request = dv_find(speech, "request", false)
    if (request == false):
        return actor
    else:
        if (request.target == actor.id):
            return dv_with(actor, "received_requests", dv_append(dv_find(actor, "received_requests", []), dv_with_many({"topic": request.topic, "parse_event": parse_event, "source_event": source}, {"requester": speaker, "request": request})))
        else:
            return actor

fn dvs_finish_reply(actor, action):
    var request = dvs_pending_request(actor, action)
    if (0 < rt_count(request)):
        return dv_with(actor, "answered_requests", dv_append(dv_find(actor, "answered_requests", []), request.parse_event))
    else:
        return actor

fn dvs_record_request(actor, action):
    var request = dv_find(dv_find(action, "speech", []), "request", false)
    if (request == false):
        return actor
    else:
        return dv_with(actor, "request_contexts", dv_with(dv_find(actor, "request_contexts", []), action.id, dvs_request_context(actor, action, request.target)))

fn dvs_request_inputs(mind, proposition):
    let refs = dvs_sim_refs(proposition)
    var inputs = []
    var i = 0
    while i < rt_count(refs):
        let cell = dv_read(mind, refs[i])
        rt_push(inputs, {"ref": refs[i], "known": dv_find(cell, "known", false), "value": dv_find(cell, "value", false), "conflicted": dv_find(cell, "conflicted", false)})
        i = i + 1
    return {"inputs": inputs, "truth": dv_truth(mind, proposition)}

fn dvs_request_context(actor, action, target):
    let topic = dv_find(dv_find(dv_find(action, "speech", []), "request", []), "topic", dv_find(action, "response_topic", ""))
    let visible = dv_find(dv_find(actor, "visible_context", []), target, false)
    if (visible != false):
        return {"target": target, "topic": topic, "location": visible.location, "inputs": dvs_request_inputs(actor.mind, action.precondition)}
    let transport = dv_find(action, "request_transport", false)
    if (transport == false):
        return false
    let channels = dv_find(actor, "request_channels", [])
    var i = 0
    while (i < rt_count(channels)):
        let channel = channels[i]
        if (channel.target == target and channel.channel == transport.channel and 0 < rt_count(channel.basis)):
            if (dv_truth(actor.mind, channel.available_when) == "true"):
                return {"target": target, "topic": topic, "channel": channel.channel, "basis": channel.basis, "inputs": dvs_request_inputs(actor.mind, action.precondition), "channel_inputs": dvs_request_inputs(actor.mind, channel.available_when)}
        i = i + 1
    return false

fn dvs_visible_context(actor, physical, actors):
    var result = []
    if dv_truth(physical, dv_find(actor.policy, "visual_identity_when", dv_true())) != "true":
        return result
    var own = dv_read(physical, actor.location_ref)
    var i = 0
    while (i < rt_count(actors)):
        var other = actors[i]
        var position = dv_read(physical, actors[i].location_ref)
        if (other.id != actor.id) and dv_uncontested(own) and dv_uncontested(position) and dv_same(own.value, position.value):
            if dv_truth(physical, dv_find(other, "observable_presence_when", dv_true())) == "true":
                result = dv_with(result, other.id, {"location": position.value})
        i = (i + 1)
    return result

fn dvs_notice_peers(actor, physical, actors, bindings, events, time, parent):
    if dv_find(actor.policy, "notice_co_presence", false):
        var context = dvs_visible_context(actor, physical, actors)
        var old = dv_find(actor, "visible_context", [])
        let position = dv_read(physical, actor.location_ref)
        var location = false
        if dv_uncontested(position):
            location = position.value
        let clear = location != false and dv_truth(physical, dv_find(actor.policy, "visual_identity_when", dv_true())) == "true"
        if dv_same(context, old) and dv_find(actor, "visible_context_location", false) == location and dv_find(actor, "visible_context_clear", false) == clear:
            return actor
        else:
            var event = dvs_event(events, "co_presence", actor.id, time, dvs_cognitive_parents(actor, dv_single(parent)), {"context_before": old, "context_after": context, "location_ref": actor.location_ref, "observed_location": location, "visibility_available": clear})
            var grants = []
            var i = 0
            while i < rt_count(actors):
                let peer = actors[i]
                let now = dv_find(context, peer.id, false)
                let previous = dv_find(old, peer.id, false)
                if now != false and (previous == false or previous.location != now.location):
                    rt_push(grants, peer.location_ref)
                i = i + 1
            var mind = actor.mind
            if 0 < rt_count(grants):
                let observations = dv_perceive(physical, actor.mind, bindings, grants, event, time)
                if 0 < rt_count(observations):
                    let next = dv_update_mind(mind, observations, mind.revision, dvs_observation_profile(actor)).world
                    event = dvs_event_prepared(events, "observation", actor.id, time, dv_single(event), {"observations": observations, "revision_before": mind.revision, "revision_after": next.revision, "bindings": bindings, "grants": grants, "execution_id": event})
                    mind = next
            return dv_with_many(actor, {"visible_context": context, "visible_context_location": location, "visible_context_clear": clear, "mind": mind, "last_cognitive_event": event})
    else:
        return actor

fn dvs_visible_action_grants(actors, speaker_index, action, before, physical, bindings, events, time, parent, execution_id):
    var listeners = dv_find(action, "public_observers", [])
    var grants = dv_find(action, "public_grants", [])
    if rt_count(listeners) == 0 or rt_count(grants) == 0:
        return actors
    var speaker = actors[speaker_index]
    var result = actors
    var i = 0
    var own = dv_read(physical, actors[speaker_index].location_ref)
    var origin = dv_read(before, actors[speaker_index].location_ref)
    while (i < rt_count(actors)):
        var actor = result[i]
        if (i != speaker_index) and dv_has(listeners, actor.id):
            var position = dv_read(physical, actor.location_ref)
            var position_before = dv_read(before, actor.location_ref)
            var present_after = dv_and(dv_uncontested(own), dv_and(dv_uncontested(position), dv_same(own.value, position.value)))
            var present_at_departure = action.kind == "move" and dv_and(dv_uncontested(origin), dv_and(dv_uncontested(position_before), dv_same(origin.value, position_before.value)))
            if dv_or(present_after, present_at_departure) and (dv_truth(physical, dv_find(actor.policy, "visual_identity_when", dv_true())) == "true"):
                var mind = actor.mind
                var observations = dv_perceive(physical, actor.mind, bindings, grants, execution_id, time)
                if (0 < rt_count(observations)):
                    var next = dv_update_mind(mind, observations, mind.revision, dvs_observation_profile(actor)).world
                    var event = dvs_event_prepared(events, "observation", actor.id, time, dvs_cognitive_parents(actor, dv_single(parent)), dv_with_many({"observations": observations, "revision_before": mind.revision, "revision_after": next.revision, "action": action}, {"bindings": bindings, "grants": grants, "execution_id": execution_id}))
                    result = dvs_replace(result, i, dv_with_many(actor, {"mind": next, "last_cognitive_event": event}))
        i = (i + 1)
    return result

// ----- SOURCE: language_core/verification/session/15-action-planning.dv | SHA256: f0745af05e4d4e339cd758c9e5e6ef0bfc3e0ce237cb49f9602966138fa0456a -----
// Planning retains cognition and revision; append-only audit logs are not decision inputs.
fn dvp_memo_input(actor, costs):
    var policy = actor.policy
    if dv_has_key(policy, "remaining_game_time"):
        var maximum = 0
        var i = 0
        while i < rt_count(costs):
            maximum = dv_max(maximum, costs[i][1].maximum.time)
            i = i + 1
        let bound = dv_find(policy, "plan_depth", 2) * maximum
        if bound <= policy.remaining_game_time:
            policy = dv_with(policy, "remaining_game_time", bound)
    var result = []
    var i = 0
    while i < rt_count(actor):
        let entry = actor[i]
        let key = entry[0]
        if key != "reason_fixed_input" and key != "reason_reused" and key != "decision_time" and key != "decision_revision" and key != "planning_work_total" and key != "last_cognitive_event" and key != "dependency_work_total" and key != "cognition_input" and key != "last_cognition_revision" and key != "last_cognition_time" and key != "cognition_reused" and key != "cognition_cache_reuses" and key != "last_reason_report" and key != "last_readiness_report":
            if key == "policy":
                rt_push(result, dv_pair(key, policy))
            else:
                if key == "mind":
                    rt_push(result, dv_pair(key, dv_without(dv_without(entry[1], "history"), "seen")))
                else:
                    rt_push(result, entry)
        i = i + 1
    return result

// Subject-local goals, method scopes and bounded complete-layer comparison.
// Observing a scope has information value; its unknown result is never inserted into a forecast.
// Scoring reads this local view; persistent actor updates happen outside planning.
// Public transmission progress never predicts another subject's acceptance.

fn dvp_question(actor):
    if dv_has_key(actor, "question_ref"):
        var cell = dv_read(actor.mind, actor.question_ref)
        if dv_uncontested(cell):
            return cell.value
        else:
            return ""
    else:
        return ""

fn dvp_topic(actor, item):
    if dv_find(item, "scope", "") == "personal" and 0 < rt_count(dv_find(item, "basis", [])):
        return true
    var topic = dv_find(item, "question", dv_find(item, "topic", ""))
    var question = dvp_question(actor)
    var bindings = dv_find(actor.policy, "topic_bindings", [])
    // Preserve the original item/question/binding read order before caching.
    // The full mind plus all external inputs determines this pure Bool.
    let mind = dv_find(actor, "mind", false)
    if not rt_is_list(mind):
        return dvp_topic_scan(actor, topic, question, bindings)
    let key = ["dvp_topic", item, dv_has_key(actor, "question_ref"), dv_find(actor, "question_ref", false), bindings, dv_find(actor, "heard_topics", [])]
    let cached = rt_memo_get(mind, key)
    if cached[0]:
        return cached[1]
    return rt_memo_put(mind, key, dvp_topic_scan(actor, topic, question, bindings))

fn dvp_topic_scan(actor, topic, question, bindings):
    var i = 0
    var active = false
    if dv_and((not (question == "")), (topic == question)):
        active = true
    while (i < rt_count(bindings)):
        var binding = bindings[i]
        if dv_and((binding.topic == topic), dv_and((0 < rt_count(dv_find(binding, "basis", []))), dv_and(dv_or(dvs_topic_was_heard(actor, topic), (dv_truth(actor.mind, binding.heard_when) == "true")), (not (dv_truth(actor.mind, binding.completed_when) == "true"))))):
            active = true
        i = (i + 1)
    return active

fn dvp_add_ref(refs, ref):
    if dv_has(refs, ref):
        return refs
    else:
        return dv_append(refs, ref)

fn dvp_merge_refs(refs, extra):
    var result = refs
    var i = 0
    while (i < rt_count(extra)):
        result = dvp_add_ref(result, extra[i])
        i = (i + 1)
    return result

fn dvp_unmet_refs(mind, proposition, include_known):
    var op = proposition.op
    if (op == "constant"):
        return []
    else:
        if (op == "not"):
            return dvp_unmet_refs(mind, proposition.item, include_known)
        else:
            if (op == "all"):
                var items = proposition.items
                var result = []
                var i = 0
                while (i < rt_count(items)):
                    result = dvp_merge_refs(result, dvp_unmet_refs(mind, items[i], include_known))
                    i = (i + 1)
                return result
            else:
                if dv_or(include_known, (not (dv_truth(mind, proposition) == "true"))):
                    return dv_single(proposition.ref)
                else:
                    return []

fn dvp_dependency_add(graph, ref, inputs):
    let key = rt_json_stringify(ref)
    return dv_with(graph, key, dvp_merge_refs(dv_find(graph, key, []), inputs))

fn dvp_dependency_topology(mind, methods):
    let key = ["dvp_dependency_topology", methods]
    let cached = rt_memo_get(mind.adoptions, key)
    if cached[0]:
        return cached[1]
    var graph = []
    var i = 0
    while i < rt_count(mind.adoptions):
        let adoption = mind.adoptions[i][1]
        if adoption.active and adoption.mode == "infer":
            let inputs = dvs_sim_refs(adoption.law.premise)
            var j = 0
            while j < rt_count(adoption.law.effects):
                graph = dvp_dependency_add(graph, adoption.law.effects[j].ref, inputs)
                j = j + 1
        i = i + 1
    i = 0
    while i < rt_count(methods):
        let method = methods[i]
        let inputs = dvp_merge_refs(dvs_sim_refs(method.premise), dv_find(method, "owner_refs", []))
        var j = 0
        while j < rt_count(method.scope):
            graph = dvp_dependency_add(graph, method.scope[j], inputs)
            j = j + 1
        i = i + 1
    return rt_memo_put(mind.adoptions, key, graph)

fn dvp_dependencies(mind, seeds, budget, methods):
    let graph = dvp_dependency_topology(mind, methods)
    var refs = dv_clone(seeds)
    var cursor = 0
    while cursor < rt_count(refs) and cursor < budget:
        let inputs = dv_find(graph, rt_json_stringify(refs[cursor]), [])
        var i = 0
        while i < rt_count(inputs):
            if not dv_has(refs, inputs[i]):
                rt_push(refs, inputs[i])
            i = i + 1
        cursor = cursor + 1
    var stop = "dependency-closure"
    if cursor < rt_count(refs):
        stop = "dependency-budget"
    return {"refs": refs, "expanded": cursor, "stop": stop}

fn dvp_goal_refs(actor):
    var goals = dv_find(actor.policy, "goals", [])
    var mind = actor.mind
    var refs = []
    var i = 0
    while (i < rt_count(goals)):
        var goal = goals[i]
        if dv_and(dvp_topic(actor, goal), (dv_truth(actor.mind, dv_find(goal, "available_when", dv_true())) == "true")):
            if dv_has_key(goal, "ref"):
                refs = dvp_add_ref(refs, goal.ref)
            else:
                if dv_has_key(goal, "proposition"):
                    refs = dvp_merge_refs(refs, dvp_unmet_refs(mind, goal.proposition, true))
        i = (i + 1)
    return refs

fn dvp_probe_refs(actor):
    var hypothesis = dv_find(actor, "hypothesis", false)
    var refs = []
    if (hypothesis == false):
        false
    else:
        if dvp_topic(actor, hypothesis):
            var features = dv_find(hypothesis, "features", [])
            var i = 0
            while (i < rt_count(features)):
                var feature = features[i]
                var local_1 = false
                if dv_has_key(feature, "proposition"):
                    local_1 = feature.proposition
                else:
                    local_1 = feature
                refs = dvp_merge_refs(refs, dvs_sim_refs(dv_find(feature, "observation", local_1)))
                i = (i + 1)
    return refs

fn dvp_scope(actor, action, bindings):
    var declared = dv_find(action, "purpose_refs", [])
    var grants = dv_find(action, "grants", [])
    var refs = declared
    var i = 0
    while (i < rt_count(grants)):
        var ref = grants[i]
        var local = dv_local(bindings, grants[i].object, actor.id)
        if (local == ""):
            false
        else:
            refs = dvp_add_ref(refs, dv_ref(local, ref.facet, ref.field))
        i = (i + 1)
    return refs

fn dvp_answer_reward(actor, action, mind):
    if dv_find(action, "answer_form", "complete-answer") == "supporting-statement":
        return 0
    if dv_has_key(action, "answer"):
        if (dv_truth(mind, action.answer) == "true"):
            return 1.0
        else:
            if dv_and(dv_has_key(actor, "argument"), (dv_find(dv_find(actor, "argument", []), "question", "") == dv_find(action, "argument_question", ""))):
                return 1.0
            else:
                var hypothesis = dv_find(actor, "hypothesis", false)
                if (hypothesis == false):
                    return 0
                else:
                    if dv_same(hypothesis.proposition, action.answer):
                        return dv_find(hypothesis, "prior", 0.5)
                    else:
                        return 0
    else:
        return 0

fn dvp_input_signature(actor, action, refs):
    var mind = actor.mind
    var inputs = []
    var i = 0
    var local_1 = false
    if dv_has_key(action, "answer"):
        local_1 = dvs_sim_refs(action.answer)
    else:
        local_1 = []
    var selected = dvp_merge_refs(refs, local_1)
    if dv_has_key(action, "support"):
        selected = dvp_merge_refs(selected, dvs_sim_refs(action.support))
    while (i < rt_count(selected)):
        rt_push(inputs, {"ref": selected[i], "cell": dvs_reason_cell(dv_read(mind, selected[i]))})
        i = (i + 1)
    return dv_with({"question": dvp_question(actor), "claim": dv_find(action, "answer", false), "inputs": inputs}, "reward", dvp_answer_reward(actor, action, mind))

fn dvp_answer_relevant(actor, action):
    if dv_has_key(action, "topic"):
        return dvp_topic(actor, action)
    else:
        var refs = dvs_sim_refs(action.answer)
        var goals = dvp_goal_refs(actor)
        var i = 0
        var found = false
        while (i < rt_count(refs)):
            if dv_has(goals, refs[i]):
                found = true
            i = (i + 1)
        return found

fn dvp_answer_attempt_allowed(prev_sig, cur_sig):
    if (prev_sig == false):
        return true
    else:
        if (not dv_same(prev_sig.inputs, cur_sig.inputs)):
            return true
        else:
            if (not dv_same(prev_sig.claim, cur_sig.claim)):
                return true
            else:
                if (not dv_same(prev_sig.question, cur_sig.question)):
                    return true
                else:
                    var r1 = dv_find(prev_sig, "reward", 0)
                    var r2 = dv_find(cur_sig, "reward", 0)
                    var local_1 = false
                    if (r1 < r2):
                        local_1 = (r2 - r1)
                    else:
                        local_1 = (r1 - r2)
                    var diff = local_1
                    return (not (diff < 0.2))

fn dvp_inspection_signature(actor, action, mind):
    let refs = dvp_merge_refs(dv_find(action, "grants", []), dvs_sim_refs(action.precondition))
    var inputs = []
    var i = 0
    while i < rt_count(refs):
        let cell = dv_read(mind, refs[i])
        rt_push(inputs, {"ref": refs[i], "known": cell.known, "value": cell.value, "conflicted": cell.conflicted})
        i = i + 1
    let evidence = dvp_inspection_freshness(actor, mind)
    var freshness = []
    i = 0
    while i < rt_count(refs):
        let entries = dv_find(evidence, rt_json_stringify(refs[i]), [])
        var j = 0
        while j < rt_count(entries):
            rt_push(freshness, entries[j])
            j = j + 1
        i = i + 1
    return {"inputs": inputs, "freshness": freshness}

// Only personally known execution inputs release a rejected attempt. Numeric
// thresholds retain their truth, so an advancing clock alone cannot retry them.
fn dvp_rejected_condition_signature(mind, proposition):
    if proposition.op == "all":
        var items = []
        var i = 0
        while i < rt_count(proposition.items):
            rt_push(items, dvp_rejected_condition_signature(mind, proposition.items[i]))
            i = i + 1
        return items
    if proposition.op == "not":
        return dvp_rejected_condition_signature(mind, proposition.item)
    if proposition.op == "equals":
        let cell = dv_read(mind, proposition.ref)
        return {"ref": proposition.ref, "known": cell.known, "value": cell.value, "conflicted": cell.conflicted}
    return {"condition": proposition, "truth": dv_truth(mind, proposition)}

fn dvp_rejected_signature(actor, action, mind):
    let adoption = dv_find(mind.adoptions, dv_find(action, "predict_law", ""), false)
    var prediction = false
    if adoption != false:
        prediction = {"active": adoption.active, "mode": adoption.mode, "law": adoption.law, "inputs": dvp_rejected_condition_signature(mind, adoption.law.premise)}
    var location = false
    if dv_has_key(actor, "location_ref"):
        let cell = dv_read(mind, actor.location_ref)
        location = {"known": cell.known, "value": cell.value, "conflicted": cell.conflicted}
    var opportunity = false
    if dv_has_key(action, "opportunity_requirement"):
        opportunity = {"context": dv_find(actor, "visible_context", []), "observed_location": dv_find(actor, "visible_context_location", false), "visibility_available": dv_find(actor, "visible_context_clear", false)}
    return {"precondition": dvp_rejected_condition_signature(mind, action.precondition), "prediction": prediction, "location": location, "opportunity": opportunity}

fn dvp_eligible_base(actor, action, mind, relevant):
    if dv_find(action, "manual_only", false) and not dv_find(actor, "manual_input", false):
        return false
    var id = action.id
    var used = dv_find(actor, "used", [])
    let rejected = dv_find(dv_find(actor, "rejected_attempt_signatures", []), id, false)
    if rejected != false:
        if dv_same(rejected, dvp_rejected_signature(actor, action, mind)):
            return false
    if dv_and((not dv_find(actor, "cognition_blocked", false)), dv_and(dv_find(action, "argument_available", true), (dv_truth(mind, action.precondition) == "true"))):
        if action.kind == "inspect":
            let inspection_actor = dvp_actor_view(actor, mind)
            if dv_same(dv_find(dv_find(actor, "inspection_attempt_signatures", []), id, false), dvp_inspection_signature(inspection_actor, action, mind)):
                return false
        if dv_has_key(action, "answer"):
            var local_1 = false
            if dv_has_key(action, "argument"):
                local_1 = 2
            else:
                local_1 = 1
            if dv_and(dvp_answer_relevant(actor, action), (dv_find(dv_find(actor, "accepted_answers", []), dv_find(action, "topic", ""), 0) < local_1)):
                var speech_ready = true
                if dv_has_key(action, "speech"):
                    speech_ready = (dvs_speech_truth(actor.mind, action.speech) == "true")
                return dv_and(speech_ready, dv_and((not (dv_truth(actor.mind, action.answer) == "false")), dvp_answer_attempt_allowed(dv_find(dv_find(actor, "answer_attempt_signatures", []), id, false), dvp_input_signature(actor, action, relevant))))
            else:
                return false
        else:
            if dv_has_key(action, "speech"):
                var local_2 = false
                if dv_has_key(action, "response_topic"):
                    var request = dvs_pending_request(actor, action)
                    if (0 < rt_count(request)):
                        local_2 = (dvs_request_context(actor, action, request.requester) != false)
                    else:
                        local_2 = dv_and((not dv_has(used, id)), dv_or(dv_has_key(dv_find(actor, "visible_context", []), dv_find(action, "offer_to", "")), dv_find(action, "opportunity_requirement", false) != false and dvp_communication_progress(actor, action)))
                else:
                    if dv_has_key(action.speech, "request"):
                        var context = dvs_request_context(actor, action, action.speech.request.target)
                        local_2 = dv_and((not (context == false)), (not dv_same(context, dv_find(dv_find(actor, "request_contexts", []), id, false))))
                    else:
                        local_2 = not dv_has(used, id) or (dv_find(action, "repeatable", false) and not dv_find(action, "once", false) and not dv_find(action, "response_once", false))
                return dv_and((dvs_speech_truth(actor.mind, action.speech) == "true"), local_2)
            else:
                if (action.kind == "replay"):
                    return 0 < dv_find(actor.policy, "model_budget", 0) and (not dv_same(dv_find(dv_find(actor, "replay_attempt_signatures", []), id, false), dvp_input_signature(actor, action, relevant)))
                else:
                    if dv_find(action, "once", false):
                        return (not dv_has(used, id))
                    else:
                        if dv_find(action, "repeatable", false):
                            return true
                        else:
                            return (not dv_has(used, id))
    else:
        return false

fn dvp_source_supported(cell, source):
    return dvp_source_supported_since(cell, source, 0)

fn dvp_source_supported_since(cell, source, minimum_time):
    var claims = dv_find(cell, "claims", [])
    var i = 0
    var found = false
    while (i < rt_count(claims)):
        var claim = claims[i]
        if dv_and((claim.source == source), dv_same(claim.value, cell.value)) and minimum_time <= dv_find(claim, "time", 0):
            found = true
        i = (i + 1)
    return found

fn dvp_needs_evidence(actor, ref):
    var goals = dv_find(actor.policy, "goals", [])
    var i = 0
    var needed = false
    while (i < rt_count(goals)):
        var goal = goals[i]
        if dv_and(dvp_topic(actor, goal), (dv_truth(actor.mind, dv_find(goal, "available_when", dv_true())) == "true")):
            if (dv_find(goal, "kind", "know") == "evidence"):
                if dv_has_key(goal, "ref"):
                    if dv_same(goal.ref, ref):
                        var cell = dv_read(actor.mind, ref)
                        if dvp_source_supported_since(cell, dv_find(goal, "source", "perception"), dv_find(goal, "minimum_time", 0)):
                            false
                        else:
                            needed = true
        i = (i + 1)
    return needed

fn dvp_action_value(actor, action, bindings, relevant, probes):
    return dvp_action_value_context(actor, action, bindings, relevant, probes, dvp_value_context(actor))

fn dvp_value_context(actor):
    var evidence = []
    var achievements = []
    var communications = []
    let goals = dv_find(actor.policy, "goals", [])
    var i = 0
    while i < rt_count(goals):
        let goal = goals[i]
        let kind = dv_find(goal, "kind", "know")
        if kind == "evidence" and dv_has_key(goal, "ref"):
            if dvp_topic(actor, goal) and dv_truth(actor.mind, dv_find(goal, "available_when", dv_true())) == "true":
                if not dvp_source_supported_since(dv_read(actor.mind, goal.ref), dv_find(goal, "source", "perception"), dv_find(goal, "minimum_time", 0)):
                    rt_push(evidence, goal.ref)
        if kind == "achieve" and dvp_topic(actor, goal) and 0 < rt_count(dv_find(goal, "basis", [])):
            if not dv_has(dv_find(actor, "planning_achievements", []), i):
                if dv_truth(actor.mind, dv_find(goal, "available_when", dv_true())) == "true" and dv_truth(actor.mind, goal.proposition) != "true":
                    rt_push(achievements, dv_with(goal, "planning_refs", dvs_sim_refs(goal.proposition)))
        if kind == "communicate" and 0 < rt_count(dv_find(goal, "basis", [])) and dv_truth(actor.mind, dv_find(goal, "available_when", dv_true())) == "true":
            rt_push(communications, goal)
        i = i + 1
    return {"evidence": evidence, "achievements": achievements, "communications": communications, "speech_goals": dvs_speech_goals(actor)}

fn dvp_context_communication(action, goals):
    var i = 0
    var value = false
    while i < rt_count(goals):
        let goal = goals[i]
        if dv_find(goal, "method_id", "") == action.id:
            if not dv_find(goal, "requires_argument", false) or (dv_find(action, "speech_from_argument", false) and dv_find(action, "argument_available", false)):
                value = true
        i = i + 1
    return value

fn dvp_action_value_context(actor, action, bindings, relevant, probes, context):
    var mind = actor.mind
    var policy = actor.policy
    var scope = dvp_scope(actor, action, bindings)
    var i = 0
    var information = 0
    var verification = 0
    var progress = 0
    var hypothesis = dv_find(actor, "hypothesis", false)
    while (i < rt_count(scope)):
        var ref = scope[i]
        var cell = dv_read(mind, scope[i])
        if dv_or((not dv_uncontested(cell)), dv_has(context.evidence, ref)):
            if dv_has(relevant, ref):
                information = (information + 1)
            if dv_has(probes, ref):
                verification = (verification + 1)
        i = (i + 1)
    if dv_has_key(action, "answer"):
        progress = dvp_answer_reward(actor, action, mind)
    if dv_has_key(action, "speech") and not dv_has_key(action, "answer"):
        if (0 < rt_count(context.speech_goals)):
            var choice = dv_find(dv_find(actor, "speech_choice_values", []), action.id, [])
            if (dv_find(choice, "status", "") == "ready"):
                // Reuse only the already paid forecast whose actual inputs
                // still match this node. Planning does not prepare a new model.
                let signature = dvs_speech_choice_signature(actor, action, context.speech_goals, dv_find(actor, "decision_time", dv_find(mind, "time", 0)))
                if dv_same(dv_find(choice, "signature", false), signature):
                    progress = choice.utility
        else:
            if dv_has_key(action.speech, "request"):
                false
            else:
                progress = 1
    if dv_has_key(action, "response_topic"):
        if (0 < rt_count(dvs_pending_request(actor, action))):
            information = (information + 1)
    if dvp_context_communication(action, context.communications):
        progress = 1
    if dv_has_key(action, "personal_choice"):
        progress = 1
    let private_utility = dvp_private_execution_utility(actor, action, mind)
    progress = progress + private_utility
    let owner_utility = dvp_owner_utility(actor, action, mind)
    progress = progress + owner_utility.value
    let resonance = dv_find(action, "resonance", false)
    if resonance != false:
        dv_require(dv_record_like(resonance), "Resonance must be a record")
        if not dv_find(resonance, "passive", false):
            progress = progress + dvp_resonance_utility(actor, action, mind)
    if (action.kind == "replay"):
        if (0 < dv_find(policy, "model_budget", 0)):
            if (hypothesis == false):
                false
            else:
                if dv_and(dvp_topic(actor, hypothesis), dv_and((0 < rt_count(dv_find(hypothesis, "features", []))), (0 < rt_count(dvs_sim_plan(hypothesis))))):
                    var known_features = 0
                    var feats = dv_find(hypothesis, "features", [])
                    var fi = 0
                    while fi < rt_count(feats):
                        var f = feats[fi]
                        var obs = dv_find(f, "observation", dv_find(f, "proposition", false))
                        if obs != false:
                            var feature_known = true
                            var f_refs = dvs_sim_refs(obs)
                            var fri = 0
                            while fri < rt_count(f_refs):
                                if not dv_uncontested(dv_read(mind, f_refs[fri])):
                                    feature_known = false
                                fri = fri + 1
                            if feature_known and dv_truth(mind, obs) != "unknown":
                                known_features = known_features + 1
                        fi = fi + 1
                    let cached = dvs_cached_model(actor, hypothesis)
                    if known_features > 0 and 0 < rt_count(dv_find(hypothesis, "basis", [])) and not dv_explanation_model_complete(cached, "explained", mind.revision) and dv_find(cached, "status", "unknown") != "inconsistent":
                        verification = verification + 1
    let achievement = dvp_achievement_pending(actor, action, context.achievements)
    return {"information": information, "verification": verification, "progress": progress, "private_utility": private_utility, "owner_utility": owner_utility, "achievement": achievement, "value": (((information + verification) * dv_find(policy, "information_weight", 1)) + ((progress + achievement) * dv_find(policy, "progress_weight", 1)))}

// Access to an already owned communication goal is not its fulfillment.
// Predict only the subject's adopted effect; never supply a listener or an answer.
fn dvp_opportunities(actor, action):
    if action.kind != "move":
        return []
    let goals = dv_find(actor.policy, "goals", [])
    var pending = []
    var i = 0
    while i < rt_count(goals):
        let goal = goals[i]
        if dv_find(goal, "kind", "") == "communicate" and dv_find(goal, "scope", "") == "personal" and dv_find(goal, "owner", "") == actor.id:
            let method = dvp_find_action(actor.actions, dv_find(goal, "method_id", ""))
            if method != false and 0 < rt_count(dv_find(goal, "basis", [])) and not dv_has(dv_find(actor, "used", []), method.id):
                if not dv_has(dv_find(actor, "planning_opportunities", []), i):
                    if not dv_find(goal, "requires_argument", false) or (dv_find(method, "speech_from_argument", false) and dv_find(method, "argument_available", false)):
                        rt_push(pending, {"key": i, "goal": goal, "method": method})
        i = i + 1
    let adoption = dv_find(actor.mind.adoptions, dv_find(action, "predict_law", ""), false)
    if rt_count(pending) == 0 or adoption == false:
        return []
    if not adoption.active or adoption.mode != "predict":
        return []
    i = 0
    while i < rt_count(adoption.law.effects):
        if not dv_same_local_ref(actor.id, adoption.law.effects[i].ref, actor.location_ref):
            return []
        i = i + 1
    let prediction = dvp_forecast(actor.mind, action.predict_law)
    if prediction.status != "applied":
        return []
    var result = []
    let predicted_actor = dvp_actor_view(actor, prediction.world)
    let before = dv_read(actor.mind, actor.location_ref)
    let after = dv_read(prediction.world, actor.location_ref)
    if not dv_uncontested(before) or not dv_uncontested(after) or before.value == after.value:
        return []
    i = 0
    while i < rt_count(pending):
        let item = pending[i]
        if dv_truth(prediction.world, dv_find(item.goal, "available_when", dv_true())) == "true" and dv_truth(prediction.world, item.method.precondition) == "true":
            let method = dv_without(item.method, "opportunity_requirement")
            let spatial = dv_find(item.method, "opportunity_requirement", false)
            if spatial != false:
                if before.value != spatial.location and after.value == spatial.location and dvp_eligible_base(predicted_actor, item.method, prediction.world, dvp_goal_refs(predicted_actor)) and dvp_eligible_after_base(predicted_actor, method, prediction.world, dvp_goal_refs(predicted_actor)):
                    rt_push(result, {"key": item.key, "method_id": item.method.id, "weight": dv_find(item.goal, "weight", 1), "goal_basis": item.goal.basis, "prediction_basis": adoption.basis, "position_before": before, "position_after": after, "nonspatial_eligible": true, "availability_before": dv_truth(actor.mind, dv_find(item.goal, "available_when", dv_true())), "goal_available_after": "true", "access_only": true, "based_on": "subject_prediction", "method_eligible": dvp_eligible(predicted_actor, item.method, prediction.world, dvp_goal_refs(predicted_actor)), "participants_status": "not-predicted", "unresolved_spatial_requirement": spatial, "fulfillment": false})
        i = i + 1
    return result

fn dvp_initial_access(actor):
    let goals = dv_find(actor.policy, "goals", [])
    let position = dv_read(actor.mind, actor.location_ref)
    var result = []
    var i = 0
    while i < rt_count(goals):
        let goal = goals[i]
        if dv_find(goal, "kind", "") == "communicate" and dv_find(goal, "scope", "") == "personal" and dv_find(goal, "owner", "") == actor.id:
            let method = dvp_find_action(actor.actions, dv_find(goal, "method_id", ""))
            if method != false and dv_uncontested(position):
                let spatial = dv_find(method, "opportunity_requirement", false)
                if spatial != false:
                    if position.value == spatial.location:
                        rt_push(result, i)
        i = i + 1
    return result

fn dvp_join_items(list):
    var s = ""
    var i = 0
    let n = rt_count(list)
    while i < n:
        if i > 0:
            s = rt_cat(s, ",")
        s = rt_cat(s, rt_show(list[i]))
        i = i + 1
    return s

fn dvp_state_key(room, tasks, visible_context):
    return dv_pair(rt_cat(room, rt_cat("|", dvp_join_items(tasks))), visible_context)

fn dvp_extract_required_room(prop, loc_ref):
    if not dv_record_like(prop):
        return ""
    let op = dv_find(prop, "op", "")
    if op == "equals":
        let ref = dv_find(prop, "ref", false)
        if ref != false and dv_same(ref, loc_ref):
            let val = dv_find(prop, "value", "")
            if not dv_record_like(val):
                return val
    if op == "all":
        let items = dv_find(prop, "items", [])
        var i = 0
        let n = rt_count(items)
        while i < n:
            let r = dvp_extract_required_room(items[i], loc_ref)
            if r != "":
                return r
            i = i + 1
    return ""

fn dvp_node_key(node):
    return node.key

fn dvp_frontier_put(frontier, node):
    var key = dvp_node_key(node)
    var i = 0
    var result = []
    var dominated = false
    var node_score = node.score
    var node_elapsed = dv_find(node, "elapsed", 0)
    while (i < rt_count(frontier)):
        var existing = frontier[i]
        var ex_key = dvp_node_key(existing)
        var ex_score = existing.score
        var ex_elapsed = dv_find(existing, "elapsed", 0)
        if dv_same(key, ex_key):
            if dv_and((not (ex_score < node_score)), (not (node_elapsed < ex_elapsed))):
                dominated = true
                rt_push(result, existing)
            else:
                if dv_and((not (node_score < ex_score)), (not (ex_elapsed < node_elapsed))):
                    false
                else:
                    rt_push(result, existing)
        else:
            rt_push(result, existing)
        i = (i + 1)
    if dominated:
        false
    else:
        rt_push(result, node)
    return result

fn dvp_dependency_methods(actor):
    let key = ["dvp_dependency_methods"]
    let cached = rt_memo_get(actor.actions, key)
    if cached[0]:
        return cached[1]
    var actions = actor.actions
    var methods = []
    var i = 0
    while (i < rt_count(actions)):
        if not dv_find(actions[i], "known_opportunity_wait", false):
            rt_push(methods, {"scope": dv_find(actions[i], "purpose_refs", dv_find(actions[i], "grants", [])), "premise": actions[i].precondition, "owner_refs": dvp_owner_requirement_refs(actions[i])})
        i = (i + 1)
    return rt_memo_put(actor.actions, key, methods)

fn dvp_cached_dependencies(actor, seeds, budget):
    var methods = dvp_dependency_methods(actor)
    var signature = {"seeds": seeds, "budget": budget, "adoptions": actor.mind.adoptions, "methods": methods}
    var cache = dv_find(actor, "dependency_cache", false)
    if (cache == false):
        var result = dvp_dependencies(actor.mind, seeds, budget, methods)
        var local_1 = false
        if (result.stop == "dependency-closure"):
            local_1 = {"signature": signature, "result": result}
        else:
            local_1 = false
        return dv_with_many(result, {"cache_hit": false, "cache": local_1})
    else:
        if dv_same(cache.signature, signature):
            return dv_with_many(cache.result, {"expanded": 0, "cache_hit": true, "cache": cache})
        else:
            var result = dvp_dependencies(actor.mind, seeds, budget, methods)
            var local_2 = false
            if (result.stop == "dependency-closure"):
                local_2 = {"signature": signature, "result": result}
            else:
                local_2 = false
            return dv_with_many(result, {"cache_hit": false, "cache": local_2})

fn dvp_plan(actor, bindings, costs):
    let indexed = dvp_actor_view(actor, dv_with_many(actor.mind, {"history": [], "seen": []}))
    rt_push(indexed, dv_pair("planning_choice_groups", dvp_choice_groups(actor.actions)))
    actor = indexed
    // Refresh declared evidence goals for every chapter in the read-only planning view.
    let owned_goals = dv_find(actor.policy, "goals", [])
    var refresh = false
    var goal_index = 0
    while goal_index < rt_count(owned_goals):
        if dv_find(owned_goals[goal_index], "kind", "") == "evidence" and dv_has_key(owned_goals[goal_index], "refresh_until"):
            refresh = true
        goal_index = goal_index + 1
    if refresh:
        let view = dvp_actor_view(actor, actor.mind)
        let policy = dv_with(actor.policy, "goals", dvp_refresh_current_evidence(actor, owned_goals))
        rt_replace(view, rt_record_index(view, "policy"), dv_pair("policy", policy))
        actor = view
    var budget = dv_find(actor.policy, "plan_budget", 0)
    var depth_limit = dv_find(actor.policy, "plan_depth", 2)
    var goals = dvp_goal_refs(actor)
    var probes = dvp_probe_refs(actor)
    var dependencies = dvp_cached_dependencies(actor, dvp_merge_refs(goals, probes), dv_find(actor.policy, "dependency_budget", dv_find(actor, "planning_limit", budget)))
    var relevant = dependencies.refs
    var expanded = 0
    var best = false
    var best_score = -100000
    var best_path = []
    var current_action = false
    var current_score = 0
    var current_value = []
    var root_best = []
    var best_after_successor_layer = []
    let initial_achievements = dvp_satisfied_goals(actor, actor.mind, [])
    let initial_access = dvp_initial_access(actor)
    var root_room = ""
    if dv_has_key(actor, "location_ref"):
        let cur_loc = dv_read(actor.mind, actor.location_ref)
        if dv_uncontested(cur_loc):
            root_room = rt_show(cur_loc.value)
    let initial_context = dv_find(actor, "visible_context", [])
    let initial_seen = dvp_state_key(root_room, [], initial_context)
    let init_key = dv_list3(initial_seen, initial_achievements, initial_access)
    var plans = []
    var frontier = dv_single({"mind": actor.mind, "visible_context": initial_context, "path": [], "score": 0, "room": root_room, "tasks": [], "seen": dv_single(initial_seen), "key": init_key, "achievements": initial_achievements, "opportunities": initial_access})
    var depth = 0
    var time_blocked = 0
    var stop = "complete-depth"
    var actions = actor.actions
    var visited = []
    visited = dv_single({"key": init_key, "score": 0, "elapsed": 0})
    while dv_and((depth < depth_limit), (0 < rt_count(frontier))):
        if ((budget - expanded) < rt_count(frontier)):
            stop = "incomplete-layer-budget"
            frontier = []
        else:
            var next_frontier = []
            var n = 0
            while (n < rt_count(frontier)):
                var node = frontier[n]
                var i = 0
                var mind = frontier[n].mind
                var node_actor = dvp_actor_view(dv_with(actor, "visible_context", node.visible_context), mind)
                rt_push(node_actor, dv_pair("planning_achievements", node.achievements))
                rt_push(node_actor, dv_pair("planning_opportunities", node.opportunities))
                let node_actions = dvp_room_actions(actions, node.room, dv_find(actor, "location_ref", false))
                let value_context = dvp_value_context(node_actor)
                expanded = (expanded + 1)
                while (i < rt_count(node_actions)):
                    var action = node_actions[i]
                    var local_1 = false
                    var spatially_possible = true
                    if node.room != "":
                        if dv_has_key(action, "travel"):
                            if action.travel.from != node.room:
                                spatially_possible = false
                        else:
                            let req_room = dv_find(action, "required_room", "")
                            if req_room != "" and req_room != node.room:
                                spatially_possible = false
                    if spatially_possible and (depth == 0 or not dv_find(action, "known_opportunity_wait", false)) and dvp_eligible(node_actor, action, mind, relevant):
                        if dv_has_key(actor.policy, "remaining_game_time"):
                            if (actor.policy.remaining_game_time < (dv_find(node, "elapsed", 0) + dv_get(costs, action.kind).maximum.time)):
                                time_blocked = (time_blocked + 1)
                                local_1 = false
                            else:
                                local_1 = true
                        else:
                            local_1 = true
                    else:
                        local_1 = false
                    if local_1:
                        var value = dvp_action_value_context(node_actor, action, bindings, relevant, probes, value_context)
                        let opportunities = dvp_opportunities(node_actor, action)
                        var opportunity_keys = node.opportunities
                        var opportunity_value = 0
                        var k = 0
                        while k < rt_count(opportunities):
                            opportunity_keys = dv_append(opportunity_keys, opportunities[k].key)
                            opportunity_value = opportunity_value + opportunities[k].weight
                            k = k + 1
                        value = dv_with_many(value, {"opportunity": opportunity_value, "opportunity_evidence": opportunities, "value": value.value + opportunity_value * dv_find(actor.policy, "progress_weight", 1)})
                        var cost = dv_get(costs, action.kind).actual
                        var path = dv_append(node.path, action.id)
                        var score = 0
                        score = (node.score + (value.value - (cost.time * dv_find(actor.policy, "time_cost", 0.01))))
                        if depth == 0 and (action.kind != "move" or (dv_find(actor.policy, "positive_move_root_stop", false) and value.achievement > 0)) and not dv_find(action, "known_opportunity_wait", false) and current_score < score and 0 < value.information + value.verification + value.progress + value.achievement:
                            current_action = action
                            current_score = score
                            current_value = value
                        rt_push(plans, dv_with_many({"path": path, "score": score, "value": value, "relevant_refs": relevant}, {"probe_refs": probes, "mind_revision": actor.mind.revision, "prediction_basis": dv_find(node, "prediction_basis", [])}))
                        if (best_score < score):
                            best_score = score
                            best_path = path
                            best = dvp_find_action(actions, path[0])
                        if (depth + 1 < depth_limit) and not dv_find(action, "known_opportunity_wait", false) and not (depth == 1 and current_action != false) and dv_and((0 < rt_count(relevant)), dv_has_key(action, "predict_law")):
                            var name = action.predict_law
                            var adoptions = mind.adoptions
                            if dv_has_key(adoptions, name):
                                var adoption = dv_get(adoptions, name)
                                if dv_and(adoption.active, (adoption.mode == "predict")):
                                    var prediction = dvp_forecast(mind, name)
                                    if (prediction.status == "applied"):
                                        var predicted = prediction.world
                                        let predicted_actor = dvp_actor_view(node_actor, predicted)
                                        let predicted_context = dv_find(predicted_actor, "visible_context", [])
                                        let achieved = dvp_satisfied_goals(predicted_actor, predicted, node.achievements)
                                        var is_transit = false
                                        var room = node.room
                                        if dv_has_key(action, "travel"):
                                            let tr = action.travel
                                            if tr.from != tr.to:
                                                is_transit = true
                                                room = tr.to
                                        var next_tasks = node.tasks
                                        if not is_transit:
                                            next_tasks = dv_append(node.tasks, action.id)
                                        let seen_key = dvp_state_key(room, next_tasks, predicted_context)
                                        let pred_key = dv_list3(seen_key, achieved, opportunity_keys)
                                        if dv_has(node.seen, seen_key) or (not is_transit and dv_has(node.tasks, action.id)):
                                            false
                                        else:
                                            var candidate_node = {"mind": predicted, "visible_context": predicted_context, "path": path, "score": score - opportunity_value * dv_find(actor.policy, "progress_weight", 1), "room": room, "tasks": next_tasks, "seen": dv_append(node.seen, seen_key), "key": pred_key, "prediction_basis": adoption.basis, "elapsed": dv_find(node, "elapsed", 0) + dv_get(costs, action.kind).maximum.time, "achievements": achieved, "opportunities": opportunity_keys}
                                            if dvp_dominated(visited, candidate_node):
                                                false
                                            else:
                                                visited = dvp_frontier_put(visited, {"key": pred_key, "score": candidate_node.score, "elapsed": candidate_node.elapsed})
                                                next_frontier = dvp_frontier_put(next_frontier, candidate_node)
                    i = (i + 1)
                n = (n + 1)
            if depth == 0:
                root_best = {"path": best_path, "net_score": best_score}
                if current_action != false:
                    best_after_successor_layer = root_best
                    next_frontier = []
                    stop = "current-affordance-root"
            frontier = next_frontier
            depth = (depth + 1)
    var local_2 = false
    if (0 < best_score):
        local_2 = best
    else:
        local_2 = false
    var local_3 = false
    if dv_and((not (0 < best_score)), (0 < time_blocked)):
        local_3 = "duration-budget"
    else:
        local_3 = stop
    return dv_with_many(dv_with_many({"action": local_2, "score": best_score, "plan_expansions": expanded, "plans": plans}, {"selected_path": best_path, "relevant_refs": relevant, "stop": local_3, "time_blocked": time_blocked, "dependency_expansions": dependencies.expanded, "dependency_stop": dependencies.stop, "dependency_cache": dependencies.cache, "dependency_cache_hit": dependencies.cache_hit, "current_affordance": {"action": current_action, "net_score": current_score, "value": current_value, "authority_acceptance": "not-predicted"}}), {"completed_layers": depth, "root_best": root_best, "best_after_successor_layer": best_after_successor_layer})

fn dvp_find_action(actions, id):
    let key = ["dvp-find-action", id]
    let cached = rt_memo_get(actions, key)
    if cached[0]:
        return cached[1]
    var i = 0
    var result = false
    while (i < rt_count(actions)):
        if (actions[i].id == id):
            result = actions[i]
        i = (i + 1)
    return rt_memo_put(actions, key, result)

// A forecast may discard old co-presence but never discover a peer at a new
// location. The search carries this filtered record forward, so returning to a
// previous room does not restore a context discarded earlier on that branch.
fn dvp_view_visible_context(actor, mind):
    var result = []
    if not dv_has_key(actor, "location_ref"):
        return result
    let own = dv_read(mind, actor.location_ref)
    if not dv_uncontested(own):
        return result
    let previous = dv_find(actor, "visible_context", [])
    var i = 0
    while i < rt_count(previous):
        let entry = previous[i]
        if dv_find(entry[1], "location", false) == own.value:
            rt_push(result, entry)
        i = i + 1
    return result

fn dvp_actor_view(actor, mind):
    var result = []
    var i = 0
    while (i < rt_count(actor)):
        var entry = actor[i]
        var local_1 = false
        if (entry[0] == "mind"):
            local_1 = dv_pair("mind", mind)
        else:
            if entry[0] == "visible_context":
                local_1 = dv_pair("visible_context", dvp_view_visible_context(actor, mind))
            else:
                local_1 = entry
        rt_push(result, local_1)
        i = (i + 1)
    return result

fn dvp_dominated(nodes, candidate):
    var i = 0
    var found = false
    while dv_and((not found), (i < rt_count(nodes))):
        var node = nodes[i]
        if dv_and(dv_same(dvp_node_key(node), dvp_node_key(candidate)), dv_and((not (node.score < candidate.score)), (not (dv_find(candidate, "elapsed", 0) < dv_find(node, "elapsed", 0))))):
            found = true
        i = (i + 1)
    return found

fn dvp_communication_progress(actor, action):
    var goals = dv_find(actor.policy, "goals", [])
    var i = 0
    var value = false
    while (i < rt_count(goals)):
        var goal = goals[i]
        if (dv_find(goal, "kind", "") == "communicate"):
            if dv_and((dv_find(goal, "method_id", "") == action.id), dv_and((0 < rt_count(dv_find(goal, "basis", []))), (dv_truth(actor.mind, dv_find(goal, "available_when", {"op": "constant", "value": "true"})) == "true"))):
                if dv_and(dv_find(goal, "requires_argument", false), dv_find(action, "speech_from_argument", false)):
                    if dv_find(action, "argument_available", false):
                        value = true
                if not dv_find(goal, "requires_argument", false):
                    value = true
        i = (i + 1)
    return value

fn dvp_satisfied_goals(actor, mind, previous):
    var result = []
    let goals = dv_find(actor.policy, "goals", [])
    var i = 0
    while i < rt_count(goals):
        let goal = goals[i]
        if dv_find(goal, "kind", "") == "achieve":
            if (dv_truth(mind, goal.proposition) == "true" or dv_has(previous, i)) and not dv_has(result, i):
                result = dv_append(result, i)
        i = i + 1
    return result

fn dvp_achievement_value(actor, action):
    let goals = dv_find(actor.policy, "goals", [])
    var pending = []
    var i = 0
    while i < rt_count(goals):
        let goal = goals[i]
        if dv_find(goal, "kind", "") == "achieve" and dvp_topic(actor, goal) and 0 < rt_count(dv_find(goal, "basis", [])):
            if not dv_has(dv_find(actor, "planning_achievements", []), i):
                if dv_truth(actor.mind, dv_find(goal, "available_when", dv_true())) == "true" and dv_truth(actor.mind, goal.proposition) != "true":
                    rt_push(pending, goal)
        i = i + 1
    return dvp_achievement_pending(actor, action, pending)

fn dvp_achievement_pending(actor, action, pending):
    var i = 0
    if rt_count(pending) == 0:
        return 0
    let name = dv_find(action, "predict_law", "")
    let adoption = dv_find(actor.mind.adoptions, name, false)
    if adoption == false:
        return 0
    if not adoption.active or adoption.mode != "predict":
        return 0
    var relevant = false
    i = 0
    while i < rt_count(pending) and not relevant:
        var refs = []
        if dv_has_key(pending[i], "planning_refs"):
            refs = pending[i].planning_refs
        else:
            refs = dvs_sim_refs(pending[i].proposition)
        var j = 0
        while j < rt_count(adoption.law.effects) and not relevant:
            var r = 0
            while r < rt_count(refs):
                if dv_same_local_ref(actor.id, adoption.law.effects[j].ref, refs[r]):
                    relevant = true
                r = r + 1
            j = j + 1
        i = i + 1
    if not relevant:
        return 0
    let prediction = dvp_forecast(actor.mind, name)
    if prediction.status != "applied":
        return 0
    var value = 0
    i = 0
    while i < rt_count(pending):
        if dv_truth(prediction.world, pending[i].proposition) == "true":
            value = value + dv_find(pending[i], "weight", 1)
        i = i + 1
    return value

// Only declared relevant received references can refresh an evidence requirement.
fn dvp_refresh_current_evidence(actor, goals):
    var result = []
    var i = 0
    while i < rt_count(goals):
        var goal = goals[i]
        if dv_find(goal, "kind", "") == "evidence" and dv_has_key(goal, "refresh_until"):
            if dv_truth(actor.mind, goal.refresh_until) != "true":
                if dv_has_key(goal, "refresh_refs"):
                    var relevant_time = dv_find(goal, "minimum_time", 0)
                    var r = 0
                    while r < rt_count(goal.refresh_refs):
                        let cell = dv_read(actor.mind, goal.refresh_refs[r])
                        if cell.known:
                            relevant_time = dv_max(relevant_time, dv_find(cell, "time", 0))
                        r = r + 1
                    goal = dv_with(goal, "minimum_time", relevant_time)
        rt_push(result, goal)
        i = i + 1
    return result

// Pure prediction only; this cache never writes actual action or evidence events.
fn dvp_forecast(mind, name):
    let key = ["dvp_forecast", name]
    let cached = rt_memo_get(mind, key)
    if cached[0]:
        return cached[1]
    let result = dv_predict(dv_with_many(mind, {"domain": "mind", "history": [], "seen": []}), name, rt_cat("planning-forecast-", rt_show(mind.revision)), dv_find(mind, "time", 0), mind.revision)
    return rt_memo_put(mind, key, result)

// Catalog-only filtering; dynamic eligibility is still checked on the node mind.
fn dvp_room_actions(actions, room, location_ref):
    if room == "" or location_ref == false:
        return actions
    let key = ["dvp_room_actions", room, location_ref]
    let cached = rt_memo_get(actions, key)
    if cached[0]:
        return cached[1]
    var result = []
    var i = 0
    while i < rt_count(actions):
        let action = actions[i]
        var required = dv_find(action, "required_room", "")
        if dv_has_key(action, "travel"):
            required = action.travel.from
        else:
            if required == "":
                required = dvp_extract_required_room(action.precondition, location_ref)
        if required == "" or required == room:
            rt_push(result, action)
        i = i + 1
    return rt_memo_put(actions, key, result)

// Every inspection in the same mind reuses the evidence refresh and availability reads.
fn dvp_inspection_freshness(actor, mind):
    let declared = dv_find(actor.policy, "goals", [])
    let key = ["dvp_inspection_freshness", declared]
    let cached = rt_memo_get(mind, key)
    if cached[0]:
        return cached[1]
    let goals = dvp_refresh_current_evidence(dvp_actor_view(actor, mind), declared)
    var index = []
    var i = 0
    while i < rt_count(goals):
        let goal = goals[i]
        if dv_find(goal, "kind", "") == "evidence" and dv_has_key(goal, "ref"):
            let name = rt_json_stringify(goal.ref)
            let entries = dv_append(dv_find(index, name, []), {"ref": goal.ref, "minimum_time": dv_find(goal, "minimum_time", 0), "available": dv_truth(mind, dv_find(goal, "available_when", dv_true()))})
            // Private construction; publish only the complete independent index.
            let owned_entries = dv_clone(entries)
            let position = rt_record_index(index, name)
            let pair = [name, owned_entries]
            if 0 <= position:
                rt_replace(index, position, pair)
            else:
                rt_push(index, pair)
        i = i + 1
    return rt_memo_put(mind, key, index)

// ----- SOURCE: language_core/verification/session/20-speech.dv | SHA256: 52436c00db27fc0a8ad53a488756ed1f03631246f020bcb0a8440c700f7d1ec3 -----
// Structured speech: authority is checked by execution, cognition by each owner.
// Only positive equals atoms support testimony cells. Other ASTs remain speech records.
// A received estimated proposal is a public record before any personal adoption.
// Only an owner's declared policy can authorize its bounded testimony support.
// Speech exposes cue identity only. Conclusions and priors belong to local rules.
// Model reception is hypothetical testimony into a private copied prediction world.
// Neither the model nor its alternatives is sourced from another actor's real mind.
// A complete candidate layer is quoted before any prediction is evaluated.
// Work draws only from the existing total model budget, never replay-work allowance.
// Reassessment consumes personal reasoning and withdraws only a scoped interpretation.
// New personal evidence can defeat an earlier interpretation without new speech.
// This operation never writes observations or negates the interpreted proposition.

fn dvs_speech_cognitive_parents(parents, previous):
    if dv_or((previous == ""), dv_has(parents, previous)):
        return parents
    else:
        return dv_append(parents, previous)

fn dvs_speech_ast_nodes(ast):
    var op = ast.op
    var count = 1
    if (op == "not"):
        count = (count + dvs_speech_ast_nodes(ast.item))
    else:
        if (op == "all"):
            var items = ast.items
            var i = 0
            while (i < rt_count(items)):
                count = (count + dvs_speech_ast_nodes(items[i]))
                i = (i + 1)
    return count

fn dvs_speech_map(mind, proposition, bindings):
    var op = proposition.op
    if (op == "constant"):
        return proposition
    else:
        if (op == "all"):
            var mapped = []
            var i = 0
            var items = proposition.items
            while (i < rt_count(items)):
                rt_push(mapped, dvs_speech_map(mind, items[i], bindings))
                i = (i + 1)
            return dv_all(mapped)
        else:
            if (op == "not"):
                return dv_not(dvs_speech_map(mind, proposition.item, bindings))
            else:
                var ref = proposition.ref
                var local = dv_local(bindings, ref.object, mind.subject)
                if (local == ""):
                    if dv_has_key(mind.objects, ref.object):
                        return proposition
                    else:
                        return {"op": "constant", "value": "unknown"}
                else:
                    return dv_with(proposition, "ref", dv_ref(local, ref.facet, ref.field))

fn dvs_speech_truth(mind, speech):
    return dv_truth(mind, dvs_speech_map(mind, speech.literal_ast, dv_find(speech, "referents", [])))

fn dvs_speech_presuppositions(mind, speech):
    var items = dv_find(speech, "presuppositions", [])
    var bindings = dv_find(speech, "referents", [])
    var i = 0
    var result = []
    while (i < rt_count(items)):
        var proposition = dvs_speech_map(mind, items[i], bindings)
        rt_push(result, {"proposition": proposition, "truth": dv_truth(mind, proposition)})
        i = (i + 1)
    return result

fn dvs_emission_location(speaker, speech, physical):
    let ref = dv_find(speech, "emission_location_ref", speaker.location_ref)
    let cell = dv_read(physical, ref)
    if dv_uncontested(cell):
        return cell.value
    return ""

fn dvs_speech_hearing(speaker, listener, speech, physical):
    var source = speaker.id
    var channel = dv_find(speech, "channel", "")
    var source_location = dvs_emission_location(speaker, speech, physical)
    let target_cell = dv_read(physical, listener.location_ref)
    var target_location = ""
    if dv_uncontested(target_cell):
        target_location = target_cell.value
    var grants = dv_find(listener, "hearing_grants", [])
    if (source_location != "") and dv_same(source_location, target_location):
        return true
    var heard = false
    var i = 0
    while (i < rt_count(grants)):
        var grant = grants[i]
        if dv_and((grant.speaker == source), (grant.channel == channel)):
            let sender_locations = dv_find(grant, "sender_locations", [])
            let listener_locations = dv_find(grant, "listener_locations", [])
            var reception = target_location
            if dv_has_key(grant, "reception_location_ref"):
                let endpoint = dv_read(physical, grant.reception_location_ref)
                reception = ""
                if dv_uncontested(endpoint):
                    reception = endpoint.value
            if (dv_truth(listener.mind, dv_find(grant, "available_when", dv_true())) == "true") and dv_truth(physical, dv_find(grant, "authority_when", dv_true())) == "true":
                if source_location != "" and reception != "" and ((rt_count(sender_locations) == 0 or dv_has(sender_locations, source_location)) and (rt_count(listener_locations) == 0 or dv_has(listener_locations, reception))):
                    heard = true
        i = (i + 1)
    return heard

fn dvs_speech_observations(mind, proposition, source, origin, time, trust):
    var op = proposition.op
    var observations = []
    if (op == "all"):
        var items = proposition.items
        var i = 0
        while (i < rt_count(items)):
            var part = dvs_speech_observations(mind, items[i], source, origin, time, trust)
            var j = 0
            while (j < rt_count(part)):
                if dv_has(observations, part[j]):
                    false
                else:
                    rt_push(observations, part[j])
                j = (j + 1)
            i = (i + 1)
    else:
        if (op == "equals"):
            var ref = proposition.ref
            rt_push(observations, dv_observation(dv_list3(source, mind.subject, ref), mind.subject, ref, proposition.value, "testimony", origin, time, trust, dv_pair(origin, ref)))
    return observations

fn dvs_speaker_trust(policy, speaker):
    var trust = dv_find(dv_find(policy, "speaker_trust", []), speaker, 0.5)
    let biases = dv_find(policy, "class_bias", [])
    var i = 0
    while i < rt_count(biases):
        let bias = biases[i]
        if 0 < rt_count(dv_find(bias, "basis", [])) and dv_has(bias.speakers, speaker):
            trust = trust + bias.delta
        i = i + 1
    return dv_min(1, dv_max(0, trust))

fn dvs_speech_proposal_decision(mind, policy, speech, trust):
    var proposal = dv_find(speech, "proposal", false)
    var status = "ordinary"
    var reason = "ordinary-testimony"
    var confidence = trust
    var units = 0
    var acceptance = dv_find(policy, "proposal_acceptance", false)
    if (proposal == false):
        false
    else:
        var claims = dv_find(proposal, "claims", [])
        var local_1 = false
        if (acceptance == false):
            local_1 = []
        else:
            local_1 = dv_find(acceptance, "required_slots", [])
        var required = local_1
        var propositions = []
        var allowed = true
        var i = 0
        var available = "unknown"
        status = "retained"
        reason = "missing-personal-proposal-policy"
        units = 1
        confidence = dv_min(trust, dv_find(proposal, "confidence", 0))
        while (i < rt_count(claims)):
            var claim = claims[i]
            rt_push(propositions, dv_fact(claim.ref, claim.value))
            units = (units + 1)
            i = (i + 1)
        i = 0
        while (i < rt_count(required)):
            var j = 0
            var found = false
            while (j < rt_count(claims)):
                if (required[i] == claims[j].slot_id):
                    found = true
                units = (units + 1)
                j = (j + 1)
            if found:
                false
            else:
                allowed = false
            i = (i + 1)
        if (acceptance == false):
            false
        else:
            available = dv_truth(mind, dvs_speech_map(mind, dv_find(acceptance, "available_when", dv_true()), dv_find(speech, "referents", [])))
            units = (units + (2 * dvs_speech_ast_nodes(dv_find(acceptance, "available_when", dv_true()))))
            reason = "personal-proposal-policy-withheld"
            if dv_find(acceptance, "enabled", false):
                false
            else:
                allowed = false
            if (0 < rt_count(dv_find(acceptance, "basis", []))):
                false
            else:
                allowed = false
            if (available == "true"):
                false
            else:
                allowed = false
            if (0 < rt_count(required)):
                false
            else:
                allowed = false
            if (0 < rt_count(claims)):
                false
            else:
                allowed = false
            if dv_find(proposal, "estimated", false):
                false
            else:
                allowed = false
            if (dv_find(proposal, "argument_id", "") == ""):
                allowed = false
            if dv_and((0 < dv_find(proposal, "confidence", 0)), (dv_find(proposal, "confidence", 0) < 1)):
                false
            else:
                allowed = false
            if (0 < rt_count(dv_find(proposal, "source_event_ids", []))):
                false
            else:
                allowed = false
            if (dv_find(proposal, "model_event", "") == ""):
                allowed = false
            if dv_same(dv_all(propositions), speech.literal_ast):
                false
            else:
                allowed = false
            if (confidence < dv_find(acceptance, "confidence_threshold", 0.5)):
                allowed = false
            if allowed:
                status = "accepted"
                reason = "personal-bounded-proposal-adoption"
    var local_2 = false
    if (acceptance == false):
        local_2 = []
    else:
        local_2 = dv_find(acceptance, "basis", [])
    return dv_with_many({"status": status, "reason": reason, "confidence_cap": confidence, "proposal": proposal}, {"policy_basis": local_2, "calculation_units": units})

fn dvs_speech_received_observations(mind, parsed, source, speaker, time, decision):
    if (decision.status == "retained"):
        return []
    else:
        var items = dvs_speech_observations(mind, parsed, source, speaker, time, decision.confidence_cap)
        var i = 0
        var result = []
        while (i < rt_count(items)):
            var local_1 = false
            if (decision.status == "ordinary"):
                local_1 = items[i]
            else:
                local_1 = dv_with_many(items[i], {"estimated": true, "proposal_source": decision.proposal})
            rt_push(result, local_1)
            i = (i + 1)
        return result

fn dvs_speech_candidates(policy, speech):
    var cues = dv_find(speech, "implicature_candidates", [])
    var rules = dv_find(policy, "implicature_bridges", [])
    var result = []
    var ids = []
    var local_ids = []
    var i = 0
    while (i < rt_count(rules)):
        var rule = rules[i]
        var id = rules[i].id
        var required = dv_find(rules[i], "cue", "")
        var j = 0
        var matched = false
        rt_push(local_ids, id)
        if (required == ""):
            matched = true
        while (j < rt_count(cues)):
            if (cues[j].id == required):
                matched = true
            j = (j + 1)
        if matched:
            rt_push(result, {"id": id, "rule_source": dv_find(rule, "basis", []), "utterance_scope": dv_find(speech, "scope", "")})
            rt_push(ids, id)
        i = (i + 1)
    i = 0
    while (i < rt_count(cues)):
        var cue_id = cues[i].id
        if dv_or(dv_has(ids, cue_id), dv_has(local_ids, cue_id)):
            false
        else:
            rt_push(result, {"id": cue_id, "rule_source": [], "utterance_scope": dv_find(speech, "scope", "")})
            rt_push(ids, cue_id)
        i = (i + 1)
    return result

mapping dvs_listener_mapping(mind, policy, bindings):
    input Percept
    output InterpretationSet
    using dvs_speech_interpret(mind, policy, bindings)

fn dvs_speech_interpret(mind, policy, bindings, candidate):
    var bridges = dv_find(policy, "implicature_bridges", [])
    var i = 0
    var bridge = false
    var proposition = {"op": "constant", "value": "unknown"}
    var available = dv_true()
    var threshold = dv_max(dv_find(policy, "implicature_threshold", 0.5), dv_find(policy, "Implicature_Resistance", 0))
    var confidence = 0
    var adoption = {degree: 0, level: "held"}
    var basis = []
    var status = "rejected"
    var missing = "missing-bridge"
    var scope_check = []
    var withdrawal_evidence = false
    var work = 0
    while (i < rt_count(bridges)):
        var item = bridges[i]
        if (item.id == candidate.id):
            dv_require((bridge == false), "Ambiguous interpretation bridge")
            bridge = item
        i = (i + 1)
    if (bridge == false):
        false
    else:
        var premise = dvs_speech_map(mind, bridge.premise, bindings)
        var bridge_basis = dv_find(bridge, "basis", [])
        var withdrawal = dvs_speech_map(mind, dv_find(bridge, "withdraw_when", dv_not(dv_true())), bindings)
        var scope_ast = dvs_speech_map(mind, dv_find(bridge, "scope_bridge", {"op": "constant", "value": "unknown"}), bindings)
        proposition = dvs_speech_map(mind, bridge.proposition, bindings)
        available = dvs_speech_map(mind, dv_find(bridge, "available_when", dv_true()), bindings)
        confidence = dv_unit(dv_find(bridge, "prior", 0.5))
        basis = bridge_basis
        work = (1 + (2 * ((dvs_speech_ast_nodes(premise) + dvs_speech_ast_nodes(proposition)) + (dvs_speech_ast_nodes(available) + (dvs_speech_ast_nodes(withdrawal) + dvs_speech_ast_nodes(scope_ast))))))
        var literal_scope = dv_find(candidate, "utterance_scope", dv_find(bridge, "source_scope", ""))
        var interpreted_scope = dv_find(bridge, "target_scope", dv_find(bridge, "source_scope", ""))
        var scope_truth = dv_truth(mind, scope_ast)
        var withdraw_truth = dv_truth(mind, withdrawal)
        withdrawal_evidence = {"condition": withdrawal, "truth": withdraw_truth, "inputs": dvs_sim_inputs(mind, withdrawal), "scope": "owner-known-cells-only"}
        var available_truth = dv_truth(mind, available)
        var premise_truth = dv_truth(mind, premise)
        var proposition_truth = dv_truth(mind, proposition)
        scope_check = dv_with({"literal_scope": literal_scope, "interpretation_scope": interpreted_scope, "bridge_truth": scope_truth, "check_enabled": dv_find(policy, "scope_reference_check", false)}, "gap", dv_and((not (literal_scope == interpreted_scope)), (not (scope_truth == "true"))))
        if (withdraw_truth == "true"):
            status = "withdrawn"
            missing = "explicit-withdrawal-evidence"
        else:
            if (not (available_truth == "true")):
                missing = "availability-not-known"
            else:
                if (rt_count(bridge_basis) == 0):
                    missing = "bridge-without-source"
                else:
                    if (not (premise_truth == "true")):
                        missing = "bridge-premise-not-known"
                    else:
                        if (rt_count(basis) == 0):
                            missing = "candidate-without-source"
                        else:
                            if (proposition_truth == "false"):
                                missing = "contrary-evidence"
                            else:
                                adoption = dv_threshold_acceptance(confidence, threshold)
                                if adoption.level != "accepted":
                                    missing = "below-policy-threshold"
                                else:
                                    status = "accepted"
                                    missing = ""
        if dv_and((status == "accepted"), dv_and(scope_check.check_enabled, scope_check.gap)):
            status = "retained"
            adoption = dv_threshold_acceptance(0, threshold)
            missing = "scope-reference-bridge-not-supported"
        basis = dv_append(basis, {"bridge": bridge.id, "basis": bridge_basis})
    return dv_with_many({"id": candidate.id, "proposition": proposition, "status": status, "confidence": confidence}, {"basis": basis, "missing_bridge": missing, "scope_check": scope_check, "withdrawal_evidence": withdrawal_evidence, "kind": "defeasible-interpretation", "calculation_units": work, "acceptance": adoption})

fn dvs_speech_model_interpretations(mind, policy, speech, bindings):
    var candidates = dvs_speech_candidates(policy, speech)
    var result = []
    var i = 0
    while (i < rt_count(candidates)):
        rt_push(result, (dvs_listener_mapping(mind, policy, bindings) × candidates[i]))
        i = (i + 1)
    return result

fn dvs_speech_model_prediction(model, speech, speaker, source, time):
    var before = dv_with_many(model.mind, {"history": [], "seen": []})
    var policy = model.policy
    var bindings = dv_find(speech, "referents", [])
    var parsed = dvs_speech_map(model.mind, speech.literal_ast, dv_find(speech, "referents", []))
    var decision = dvs_speech_proposal_decision(before, policy, speech, dvs_speaker_trust(policy, speaker))
    var observations = dvs_speech_received_observations(before, parsed, rt_cat("prediction-", source), speaker, time, decision)
    var profile = dv_observation_profile({"perception": 1, "testimony": 1, "recall": 1}, dv_find(policy, "observation_threshold", 0.5))
    var receipt = dv_update_mind(before, observations, before.revision, profile)
    var after = receipt.world
    var primary = dvs_speech_model_interpretations(after, policy, speech, bindings)
    var checked = dv_find(policy, "scope_reference_check", false)
    var local_1 = false
    if checked:
        local_1 = dvs_speech_model_interpretations(after, dv_with(policy, "scope_reference_check", false), speech, bindings)
    else:
        local_1 = primary
    var local_2 = false
    if checked:
        local_2 = primary
    else:
        local_2 = dvs_speech_model_interpretations(after, dv_with(policy, "scope_reference_check", true), speech, bindings)
    var local_3 = false
    if checked:
        local_3 = "scope_reference_check_true=primary"
    else:
        local_3 = "scope_reference_check_false=primary"
    return dv_with_many({"model_before": before, "model_after": after, "predicted_literal": parsed, "observations": observations}, {"observation_profile": profile, "prediction": primary, "conditional_prediction": {"scope_reference_check_false": local_1, "scope_reference_check_true": local_2}, "assumptions": dv_find(model, "assumptions", []), "conditional_reuse": local_3, "proposal_decision": decision})

fn dvs_speech_rule_units(rule):
    return (1 + (2 * ((dvs_speech_ast_nodes(rule.premise) + dvs_speech_ast_nodes(rule.proposition)) + (dvs_speech_ast_nodes(dv_find(rule, "available_when", dv_true())) + (dvs_speech_ast_nodes(dv_find(rule, "withdraw_when", dv_not(dv_true()))) + dvs_speech_ast_nodes(dv_find(rule, "scope_bridge", {"op": "constant", "value": "unknown"})))))))

fn dvs_speech_prediction_units(model, speech):
    var rules = dv_find(model.policy, "implicature_bridges", [])
    var candidates = dvs_speech_candidates(model.policy, speech)
    var work = (dvs_speech_proposal_decision(model.mind, model.policy, speech, 0.5).calculation_units + (1 + (2 * dvs_speech_ast_nodes(speech.literal_ast))))
    var i = 0
    while (i < rt_count(candidates)):
        var j = 0
        var id = candidates[i].id
        while (j < rt_count(rules)):
            if (rules[j].id == id):
                work = (work + (2 * dvs_speech_rule_units(rules[j])))
            j = (j + 1)
        i = (i + 1)
    return work

fn dvs_speech_goals(actor):
    var goals = dv_find(actor.policy, "communication_goals", [])
    var active = []
    var i = 0
    while (i < rt_count(goals)):
        var goal = goals[i]
        if dv_and((0 < rt_count(dv_find(goal, "basis", []))), (dv_truth(actor.mind, dv_find(goal, "available_when", dv_true())) == "true")):
            dv_require((not (goal.weight < 0)), "Negative communication weight")
            rt_push(active, goal)
        i = (i + 1)
    return active

fn dvs_speech_choice_signature(actor, action, goals, time):
    let listeners = dv_find(action, "listeners", [])
    let models = dv_find(actor.mind, "listener_models", [])
    var selected = []
    var i = 0
    while i < rt_count(listeners):
        let listener = listeners[i]
        let model = dv_find(models, listener, false)
        var gates = []
        if model != false:
            let parsed = dvs_speech_map(model.mind, action.speech.literal_ast, dv_find(action.speech, "referents", []))
            let refs = dvs_sim_refs(parsed)
            var j = 0
            while j < rt_count(refs):
                rt_push(gates, time < dv_read(model.mind, refs[j]).time)
                j = j + 1
        rt_push(selected, {"listener": listener, "model": model, "older_observation": gates})
        i = i + 1
    return {"speaker": actor.id, "literal_truth": dvs_speech_truth(actor.mind, action.speech), "speech": action.speech, "goals": goals, "models": selected}

fn dvs_speech_goal_value(goals, listener, prediction):
    var value = 0
    var i = 0
    var interpretations = prediction.prediction
    while (i < rt_count(goals)):
        var goal = goals[i]
        var targets = dv_find(goals[i], "listeners", [])
        var j = 0
        if dv_or((rt_count(targets) == 0), dv_has(targets, listener)):
            while (j < rt_count(interpretations)):
                var interpretation = interpretations[j]
                if dv_and((interpretation.id == goal.interpretation_id), (interpretation.status == goal.desired_status)):
                    value = (value + (goal.weight * interpretation.confidence))
                j = (j + 1)
        i = (i + 1)
    return value

fn dvs_prepare_speech_choices(actor, events, time, parent):
    var goals = dvs_speech_goals(actor)
    if rt_count(goals) == 0:
        return actor
    var actions = actor.actions
    var mind = actor.mind
    var models = dv_find(actor.mind, "listener_models", [])
    var cache = dv_find(actor, "speech_choice_values", [])
    var candidates = []
    var eligible = []
    var total = 0
    var i = 0
    var before = actor
    var remaining = dv_find(actor.policy, "model_budget", 0)
    var budget_parent = dv_find(actor, "model_previous_event", "")
    var choice_cognitive = dv_find(actor, "last_cognitive_event", "")
    if (rt_count(goals) == 0):
        false
    else:
        while (i < rt_count(actions)):
            var action = actions[i]
            var id = actions[i].id
            if dv_and(dv_has_key(action, "speech"), dv_find(action, "argument_available", true)):
                if dvp_eligible(actor, action, mind, []):
                    var truth = dvs_speech_truth(mind, action.speech)
                    var signature = dvs_speech_choice_signature(actor, action, goals, time)
                    if (not (truth == "true")):
                        cache = dv_with(cache, id, {"status": "illegal-literal", "utility": 0, "signature": signature})
                        dvs_event(events, "speech_choice_rejected", actor.id, time, dv_single(parent), {"action": action, "actor_before": before, "truth": truth, "charged_units": 0})
                    else:
                        rt_push(eligible, dv_pair(id, signature))
                        var local_1 = false
                        if dv_has_key(cache, id):
                            local_1 = dv_and((dv_get(cache, id).status == "ready"), dv_same(dv_get(cache, id).signature, signature))
                        else:
                            local_1 = false
                        if local_1:
                            false
                        else:
                            var listeners = dv_find(action, "listeners", [])
                            var j = 0
                            var units = 0
                            while (j < rt_count(listeners)):
                                var listener = listeners[j]
                                var local_2 = false
                                if dv_has_key(models, listener):
                                    local_2 = (0 < rt_count(dv_find(dv_get(models, listener), "basis", [])))
                                else:
                                    local_2 = false
                                if local_2:
                                    units = (units + dvs_speech_prediction_units(dv_get(models, listener), action.speech))
                                j = (j + 1)
                            rt_push(candidates, {"action": action, "signature": signature, "units": units})
                            total = (total + units)
            i = (i + 1)
    i = 0
    if (remaining < total):
        while (i < rt_count(eligible)):
            var entry = eligible[i]
            cache = dv_with(cache, entry[0], {"status": "unknown-incomplete-layer", "utility": 0, "signature": entry[1]})
            i = (i + 1)
        if (0 < rt_count(candidates)):
            dvs_event(events, "speech_choice_budget_stop", actor.id, time, dv_single(parent), {"actor_before": dv_without(before, "simulations"), "required_units": total, "available_units": remaining, "charged_units": 0})
    else:
        while (i < rt_count(candidates)):
            var entry = candidates[i]
            var action = candidates[i].action
            var forecasts = []
            var event_ids = []
            var listeners = dv_find(candidates[i].action, "listeners", [])
            var j = 0
            var value = 0
            while (j < rt_count(listeners)):
                var listener = listeners[j]
                var data = false
                var units = 0
                var local_3 = false
                if dv_has_key(models, listener):
                    local_3 = (0 < rt_count(dv_find(dv_get(models, listener), "basis", [])))
                else:
                    local_3 = false
                if local_3:
                    units = dvs_speech_prediction_units(dv_get(models, listener), action.speech)
                    data = dvs_speech_model_prediction(dv_get(models, listener), action.speech, actor.id, rt_cat("preselect-", action.id), time)
                    data = dv_with_many(data, {"status": "model-based", "model": dv_get(models, listener)})
                    value = (value + dvs_speech_goal_value(goals, listener, data))
                else:
                    data = {"status": "unknown-no-model", "prediction": []}
                data = dv_with_many(data, {"listener": listener, "action": action, "actor_before": dv_without(dv_with_many(actor, {"policy": dv_with(actor.policy, "model_budget", remaining), "model_previous_event": budget_parent, "last_cognitive_event": choice_cognitive}), "simulations"), "budget_before": remaining, "charged_units": units, "goals": goals})
                remaining = (remaining - units)
                data = dv_with(data, "budget_after", remaining)
                data = dv_with(data, "prediction_time", time)
                var local_4 = false
                if (0 < units):
                    local_4 = rt_cat("e", rt_show(rt_count(events)))
                else:
                    local_4 = budget_parent
                var local_5 = false
                if (0 < units):
                    local_5 = rt_cat("e", rt_show(rt_count(events)))
                else:
                    local_5 = choice_cognitive
                data = dv_with(data, "actor_after", dv_with_many(actor, {"policy": dv_with(actor.policy, "model_budget", remaining), "model_previous_event": local_4, "last_cognitive_event": local_5}))
                var local_6 = false
                if (budget_parent == ""):
                    local_6 = dv_single(parent)
                else:
                    local_6 = dv_pair(parent, budget_parent)
                let prediction_index = rt_count(events)
                var prediction_id = dvs_event(events, "speech_choice_prediction", actor.id, time, dvs_speech_cognitive_parents(local_6, choice_cognitive), data)
                rt_push(event_ids, prediction_id)
                if (0 < units):
                    budget_parent = prediction_id
                    choice_cognitive = prediction_id
                rt_push(forecasts, dv_pair(listener, prediction_index))
                j = (j + 1)
            cache = dv_with(cache, action.id, dv_with_many({"status": "ready", "utility": value, "signature": entry.signature, "forecasts": forecasts}, {"prediction_events": event_ids, "charged_units": entry.units}))
            i = (i + 1)
    return dv_with_many(actor, {"speech_choice_values": cache, "policy": dv_with(actor.policy, "model_budget", remaining), "model_previous_event": budget_parent, "last_cognitive_event": choice_cognitive})

fn dvs_proposal_reassess(actor, decision, events, time, parent):
    var rule = dv_find(actor.policy, "proposal_reassessment", false)
    var proposal = decision.proposal
    var interpretations = dv_find(actor, "interpretations", [])
    var remaining = dv_find(actor.policy, "reason_budget", 0)
    var last = dv_find(actor, "last_interpretation_event", "")
    var cognitive = dv_find(actor, "last_cognitive_event", "")
    var seen = dv_find(actor, "reassessed_proposals", [])
    var local_1 = false
    if (decision.proposal == false):
        local_1 = ""
    else:
        local_1 = dv_find(decision.proposal, "argument_id", "")
    var proposal_id = local_1
    if dv_and((decision.status == "accepted"), (not dv_has(seen, proposal_id))):
        if (rule == false):
            false
        else:
            if dv_and(dv_find(rule, "enabled", false), (0 < rt_count(dv_find(rule, "basis", [])))):
                var targets = dv_find(rule, "interpretation_ids", [])
                var required = dv_find(rule, "required_slots", [])
                var claims = dv_find(proposal, "claims", [])
                var complete = true
                var i = 0
                if (rt_count(required) == 0):
                    complete = false
                while (i < rt_count(required)):
                    var j = 0
                    var found = false
                    while (j < rt_count(claims)):
                        if (required[i] == claims[j].slot_id):
                            found = true
                        j = (j + 1)
                    if found:
                        false
                    else:
                        complete = false
                    i = (i + 1)
                i = 0
                while (i < rt_count(targets)):
                    var id = targets[i]
                    var old = dv_find(interpretations, targets[i], false)
                    var status = "insufficient-origin"
                    var charged = 0
