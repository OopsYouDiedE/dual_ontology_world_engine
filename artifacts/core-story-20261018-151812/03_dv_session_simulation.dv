                                var revised = (dvs_listener_mapping(actor.mind, actor.policy, dv_find(old, "referents", [])) × {"id": id, "utterance_scope": dv_find(scope, "literal_scope", "")})
                                if (revised.scope_check.bridge_truth == "unknown"):
                                    status = "withdrawn"
                                    interpretations = dv_with(interpretations, id, dv_with_many(old, {"status": "withdrawn", "withdrawal_reason": "paid-scope-bridge-unsupported", "proposal_event": parent}))
                                else:
