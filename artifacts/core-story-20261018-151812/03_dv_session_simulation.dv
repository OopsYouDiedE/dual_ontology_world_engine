    return false

fn dvs_factor_prune(actor, events, time, parent):
    var policy = actor.policy
    var mind = actor.mind
    var domains = dv_find(actor.policy, "factor_domains", [])
    var constraints = dv_find(actor.policy, "factor_constraints", [])
    var cap = dv_find(actor.policy, "prune_confidence_limit", 0)
    var remaining = dvs_sim_work_budget(actor)
    var initial = dvs_sim_work_budget(actor)
    var certificates = []
    var rejections = []
    var i = 0
    var result = false
    var paid = dvs_factor_paid(actor, events)
    while (i < rt_count(constraints)):
        var constraint = constraints[i]
        var reason = "budget-exhausted"
        var start = remaining
        if dv_and(paid, dv_and((0 < cap), (cap < 1))):
            if (remaining < 1):
                false
            else:
                var schema = dvs_factor_schema(domains, constraint)
                remaining = (remaining - 1)
                reason = "invalid-domain-or-coupled-condition"
                if schema.valid:
                    var condition = dv_truth(mind, constraint.condition)
                    var support = dv_truth(mind, constraint.support)
                    reason = "unknown-or-not-contradicted"
                    if dv_and((condition == "false"), (support == "true")):
                        var refs = dvs_sim_refs(dv_all(dv_pair(constraint.condition, constraint.support)))
                        var proof = dvs_factor_refs_proof(actor, mind, dvs_sim_refs(dv_all(dv_pair(constraint.condition, constraint.support))), events, rt_count(events), remaining, constraint.infer_laws)
                        remaining = proof.remaining
                        reason = "unproven-or-inadmissible-source"
                        if dv_and(proof.valid, dv_and((0 < rt_count(proof.source_events)), dvs_factor_scope_proof(domains, schema.fixed, proof))):
                            var certificate = dv_with_many({"constraint": constraint, "domains": domains, "current_revision": mind.revision, "source_chain": proof.steps}, {"source_event_ids": proof.source_events, "covered_assignments": {"fixed": schema.fixed, "free_domains": schema.free_domains}, "confidence": dv_min(cap, proof.confidence), "estimated": true, "paid_model_event": dv_find(actor, "model_paid_event", ""), "paid_units": (start - remaining), "results": {"condition": condition, "support": support}})
                            rt_push(certificates, certificate)
                            reason = "certified"
        else:
            reason = "unpaid-or-missing-confidence-policy"
        if (reason == "certified"):
            false
        else:
            rt_push(rejections, {"constraint": constraint.id, "reason": reason, "paid_units": (start - remaining)})
        i = (i + 1)
    result = dv_with_many({"certificates": certificates, "rejections": rejections, "expanded": (initial - remaining), "remaining": (dv_find(policy, "model_budget", 0) - (initial - remaining))}, {"work_remaining": remaining, "current_revision": mind.revision, "actor_before": dv_without(actor, "simulations")})
    var parents = dvs_cognitive_parents(actor, dv_single(parent))
    var j = 0
    if (dv_find(actor, "model_paid_event", "") == ""):
        false
    else:
        if dv_has(parents, actor.model_paid_event):
            false
        else:
            rt_push(parents, actor.model_paid_event)
    if (dv_find(actor, "model_previous_event", "") == ""):
        false
    else:
        if dv_has(parents, actor.model_previous_event):
            false
        else:
            rt_push(parents, actor.model_previous_event)
    while (j < rt_count(certificates)):
        var roots = certificates[j].source_event_ids
        var k = 0
        while (k < rt_count(roots)):
            if dv_has(parents, roots[k]):
                false
            else:
                rt_push(parents, roots[k])
            k = (k + 1)
        j = (j + 1)
    return dv_with(result, "event", dvs_event(events, "factor_prune", actor.id, time, parents, result))

