fn dvs_factor_certificate_current(actor, certificate, events):
    var mind = actor.mind
    var policy = actor.policy
    var required = dv_list3("constraint", "domains", "source_chain")
    var i = 0
    var valid = true
    required = dv_append(required, "source_event_ids")
