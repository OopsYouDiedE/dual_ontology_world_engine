                var proof = dvs_factor_refs_proof(actor, mind, dvs_sim_refs(dv_all(dv_pair(constraint.condition, constraint.support))), events, rt_count(events), (units - 1), constraint.infer_laws)
                return dv_and(proof.valid, dv_and((proof.remaining == 0), dv_and((0 < rt_count(proof.source_events)), dv_and(dvs_factor_scope_proof(domains, schema.fixed, proof), dv_and(dv_same(proof.steps, certificate.source_chain), dv_and(dv_same(proof.source_events, certificate.source_event_ids), dv_and(dv_same(certificate.results, {"condition": "false", "support": "true"}), dv_and(dv_same(certificate.covered_assignments, {"fixed": schema.fixed, "free_domains": schema.free_domains}), (certificate.confidence == dv_min(cap, proof.confidence))))))))))
            else:
                return false
        else:
            return false
    else:
        return false

fn dvs_factor_assignment_complete(domains, assignments):
