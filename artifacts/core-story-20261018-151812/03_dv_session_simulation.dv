                    var after = dv_with_many(actor, {"interpretations": interpretations, "policy": dv_with(actor.policy, "reason_budget", remaining), "last_interpretation_event": rt_cat("e", rt_show(rt_count(events))), "last_cognitive_event": rt_cat("e", rt_show(rt_count(events)))})
                    var local_2 = false
                    if (status == "withdrawn"):
                        local_2 = "implicature_withdrawn"
                    else:
                        local_2 = "proposal_scope_reassessment"
                    var local_3 = false
                    if (last == ""):
                        var local_4 = false
                        if (old == false):
                            local_4 = ""
                        else:
