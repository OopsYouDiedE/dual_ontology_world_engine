#include ../../../language_core/20-core.dv

// New declaration words remain legal names in established formula/local syntax.
称谓 兼容样本 为「compat.sample」。

行动(x) = x
称谓(x) = x
法则(x) = x
叙述(x) = x
台词(x) = x

叙述 compatibility_text：
    新的叙述仍然保留正文。

台词 compatibility_lines：
    新的台词仍然保留第一句。
    第二句也保留。

法则 compatibility_rule：
    当 兼容样本 的「flag」为 真。
    效果 []

行动 compatibility_action：
    编号「compat.inspect」
    类别「inspect」
    本人须知 无条件
    现场要求 无条件
    遵循「compatibility_rule」
    可获知 []
    依据 [「neutral-compatibility-fixture」]
    表述：
        这只是一个行动数据声明。

fn legacy_locals():
    var 叙述 = 2
    var 台词 = 3
    叙述 = 叙述 + 5
    台词 = 台词 * 2
    return [叙述, 台词]

fn contextual_text(flag):
    var 叙述 = "existing local"
    叙述 = rt_cat(叙述, " value")
    if flag:
        叙述：
            同一函数中的自然正文。
    return 叙述

fn contextual_lines(flag):
    var 台词 = ["existing local"]
    台词 = [台词[0], "value"]
    if flag:
        台词：
            同一函数中的第一句。
            同一函数中的第二句。
    return 台词

fn checks_main():
    dv_require(行动(11) == 11 and 称谓(12) == 12 and 法则(13) == 13 and 叙述(14) == 14 and 台词(15) == 15, "A new declaration word intercepted an existing formula name")
    let calls = []
    叙述(rt_push(calls, "narrative-call"))
    台词(rt_push(calls, "dialogue-call"))
    dv_require(dv_same(calls, ["narrative-call", "dialogue-call"]), "A declaration word intercepted an ordinary call statement")
    dv_require(dv_same(legacy_locals(), [7, 6]), "A new declaration word intercepted a local assignment or read")
    dv_require(contextual_text(false) == "existing local value" and contextual_text(true) == "同一函数中的自然正文。", "Narrative local and raw return do not coexist")
    dv_require(dv_same(contextual_lines(false), ["existing local", "value"]) and dv_same(contextual_lines(true), ["同一函数中的第一句。", "同一函数中的第二句。"]), "Dialogue local and raw return do not coexist")
    rt_print("SCENARIO legacy-formula-local-and-call-compatibility completed")
    dv_require(compatibility_text() == "新的叙述仍然保留正文。", "Top-level natural narrative was lost")
    dv_require(dv_same(compatibility_lines(), ["新的台词仍然保留第一句。", "第二句也保留。"]), "Top-level natural dialogue was lost")
    let expected_rule = dv_axiom("compatibility_rule", 1, dv_fact(dv_ref("compat.sample", "state", "flag"), true), [])
    dv_require(dv_same(compatibility_rule(), expected_rule), "Natural law or appellation changed while retaining legacy names")
    let expected_action = {id: "compat.inspect", kind: "inspect", precondition: dv_true(), authority_precondition: dv_true(), law: "compatibility_rule", grants: [], source_refs: ["neutral-compatibility-fixture"], surface: "这只是一个行动数据声明。"}
    dv_require(dv_same(compatibility_action(), expected_action), "Natural action changed while retaining legacy names")
    rt_print("SCENARIO new-natural-declarations-coexist-with-legacy-names completed")
    return true
