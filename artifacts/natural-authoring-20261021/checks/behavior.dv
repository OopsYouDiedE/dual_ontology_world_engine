#include ../../../language_core/20-core.dv
#include fragments/raw-module.dv
#include fragments/crlf-module.dv
#include fragments/no-final-newline.dv
#include fragments/raw-module.dv
#include fragments/alias-scope.dv

// Neutral authored values only. No chapter or session is imported.

称谓 样本 为「sample」。
称谓 门厅 为「room」。

fn conditional_text(flag):
    if flag:
        叙述：
            条件成立时的正文。
            即使写下 return false，也保留为正文。
    叙述：
        条件未成立时的正文。

fn conditional_dialogue(flag):
    if flag:
        台词：
            第一声。

            第二声。
    台词：
        安静。

法则 natural_rule，给定 actor、amount：
    名为 rt_cat("law.", actor)
    版本 2
    当 actor 位于「room」。
    并且 非 actor 的「body」的「asleep」为 真。
    并且 actor 的「value」至少 amount / 2 + 1。
    则 actor 的「value」变为 amount + 1。
    并使 actor 的「body」的「stamina」增加 -2。

fn legacy_rule(actor, amount):
    return dv_axiom(rt_cat("law.", actor), 2, dv_all([dv_fact(dv_ref(actor, "state", "location"), "room"), dv_not(dv_fact(dv_ref(actor, "body", "asleep"), true)), dv_at_least(dv_ref(actor, "state", "value"), amount / 2 + 1)]), [dv_assign(dv_ref(actor, "state", "value"), amount + 1), dv_increment(dv_ref(actor, "body", "stamina"), -2)])

法则 natural_mixed(actor, amount)：
    前提 dv_all([actor 位于「room」, dv_fact(dv_ref(actor, "body", "asleep"), false)])
    效果 [dv_assign(actor 的「value」, amount * 2), dv_increment(dv_ref(actor, "body", "stamina"), -1)]

法则 natural_unknown：
    当 非「sample」的「missing」为 真。
    效果 []

法则 natural_and：
    当「sample」的「missing」为 真 并且「sample」的「value」为 5。
    效果 []

法则 natural_or：
    当「sample」的「missing」为 真 或者「sample」的「value」为 5。
    效果 []

法则 natural_false_or：
    当「sample」的「missing」为 真 或者「sample」的「value」为 9。
    效果 []

法则 natural_grouping：
    当 (「sample」的「missing」为 真 或者「sample」的「value」为 5) 并且 非「sample」的「body」的「asleep」为 真。
    效果 []

法则 natural_alias：
    当 样本 位于 门厅。
    效果 []

法则 natural_unconditional：
    当 无条件。
    效果 []

行动 natural_minimal，给定 id、kind、known、physical、law、grants、basis：
    编号 id
    类别 kind
    本人须知 known
    现场要求 physical
    遵循 law
    可获知 grants
    依据 basis

行动 natural_action，给定 name、known、physical、grants、source：
    编号 name
    类别「inspect」
    本人须知 known
    现场要求 physical
    遵循「law.sample」
    可获知 grants
    依据 [source]
    仅一次 真
    表述：
        拿起样本，核对刻痕。
        #include 这一行只作正文.dv

fn legacy_action(name, known, physical, grants, source):
    let base = {"id": name, "kind": "inspect", "precondition": known, "authority_precondition": physical}
    let action = dv_with(dv_with(dv_with(base, "law", "law.sample"), "grants", grants), "source_refs", [source])
    return dv_with(dv_with(action, "once", true), "surface", "拿起样本，核对刻痕。\n#include 这一行只作正文.dv")

fn neutral_world():
    return dv_add_object(dv_world("neutral", "physical", ""), dv_object("sample", "fixture", {state: {location: dv_field("room"), value: dv_field(5)}, body: {asleep: dv_field(false), stamina: dv_field(10)}}))

fn check_text():
    rt_print(rt_cat("RAW ", rt_json_stringify(raw_text())))
    rt_print(rt_cat("DIALOGUE ", rt_json_stringify(raw_dialogue())))
    rt_print(rt_cat("CRLF ", rt_json_stringify(crlf_text())))
    rt_print(rt_cat("TERMINAL ", rt_json_stringify(terminal_text())))
    dv_require(conditional_text(true) == "条件成立时的正文。\n即使写下 return false，也保留为正文。", "Nested narrative block changed")
    dv_require(conditional_text(false) == "条件未成立时的正文。", "Narrative return changed conditional branch")
    dv_require(dv_same(conditional_dialogue(true), ["第一声。", "第二声。"]), "Dialogue lines or blank separator changed")
    dv_require(dv_same(conditional_dialogue(false), ["安静。"]), "Dialogue false branch changed")
    rt_print("SCENARIO literal-text-and-conditional-dialogue completed")
    return true

fn check_rules():
    let world = neutral_world()
    let snapshot = dv_clone(world)
    let natural = natural_rule("sample", 8)
    dv_require(dv_same(natural, legacy_rule("sample", 8)), "Natural law differs from legacy dv_axiom structure")
    let mixed = natural_mixed("sample", 3)
    let expected_mixed = dv_axiom("natural_mixed", 1, dv_all([dv_fact(dv_ref("sample", "state", "location"), "room"), dv_fact(dv_ref("sample", "body", "asleep"), false)]), [dv_assign(dv_ref("sample", "state", "value"), 6), dv_increment(dv_ref("sample", "body", "stamina"), -1)])
    dv_require(dv_same(mixed, expected_mixed), "Mixed natural and legacy expression lowering differs")
    dv_require(dv_truth(world, natural.premise) == "true", "Natural law lost an alternate-facet reference or arithmetic")
    dv_require(dv_truth(world, natural_unknown().premise) == "unknown", "Natural negation converted unknown to false")
    dv_require(dv_truth(world, natural_and().premise) == "unknown", "Natural conjunction changed three-valued unknown")
    dv_require(dv_truth(world, natural_or().premise) == "true", "Natural disjunction changed unknown or true")
    dv_require(dv_truth(world, natural_false_or().premise) == "unknown", "Natural disjunction changed unknown or false")
    dv_require(dv_truth(world, natural_grouping().premise) == "true", "Parenthesized natural proposition precedence differs")
    dv_require(dv_same(natural_alias().premise, dv_fact(dv_ref("sample", "state", "location"), "room")), "Declared appellations changed their literal values")
    dv_require(alias_scope(7) == 7, "A file-local appellation leaked into an included module")
    dv_require(dv_same(natural_unconditional().premise, dv_true()), "Unconditional clause was lowered to a Boolean value")
    dv_require(dv_same(world, snapshot), "Declaring or evaluating law data mutated the world")
    let adopted = dv_adopt(world, natural, "enforce", 1, ["neutral-fixture"])
    let before = dv_clone(adopted)
    let request = {operation: "verify", mode: "enforce", event: "neutral-event", time: 1, revision: adopted.revision}
    let verified = dv_evaluate(adopted, "law.sample", request)
    dv_require(verified.status == "verified" and dv_same(verified.world, before) and dv_same(adopted, before), "Natural rule verification committed its effects")
    dv_require(rt_count(verified.world.history) == 0 and rt_count(verified.world.seen) == 0, "Verification published an event")
    let executed = dv_evaluate(adopted, "law.sample", dv_with(request, "operation", "run"))
    dv_require(executed.status == "applied", "Natural law could not use the existing execution path")
    dv_require(dv_read(executed.world, dv_ref("sample", "state", "value")).value == 9, "Natural assignment changed its amount")
    dv_require(dv_read(executed.world, dv_ref("sample", "body", "stamina")).value == 8, "Natural increment changed its facet or amount")
    dv_require(dv_same(adopted, before), "Natural execution mutated its input snapshot")
    rt_print("SCENARIO law-structure-three-valued-logic-and-explicit-execution completed")
    return true

fn check_actions():
    let world = neutral_world()
    let world_before = dv_clone(world)
    let known = dv_all([dv_fact(dv_ref("sample", "state", "location"), "room")])
    let physical = dv_fact(dv_ref("sample", "body", "asleep"), false)
    let grants = [dv_ref("sample", "state", "value")]
    let source = {id: "fixture-source", path: "neutral"}
    let declared = natural_action("neutral.inspect", known, physical, grants, source)
    dv_require(dv_same(declared, legacy_action("neutral.inspect", known, physical, grants, source)), "Natural action differs from legacy fields, once, or surface")
    let minimal = natural_minimal("minimal", "inspect", known, physical, "law.sample", grants, [source])
    let expected_minimal = {id: "minimal", kind: "inspect", precondition: known, authority_precondition: physical, law: "law.sample", grants: grants, source_refs: [source]}
    dv_require(dv_same(minimal, expected_minimal), "Minimal natural action did not retain its seven declared fields")
    dv_require(dv_same(world, world_before) and rt_count(world.history) == 0, "Action declaration executed a world change")
    let saved = dv_clone(declared)
    let saved_minimal = dv_clone(minimal)
    rt_push(grants, dv_ref("sample", "body", "stamina"))
    rt_push(known.items, dv_true())
    rt_replace(source, 0, ["id", "mutated-source"])
    rt_replace(physical, 2, ["value", true])
    dv_require(dv_same(declared, saved) and dv_same(minimal, saved_minimal), "Natural action shares mutable input fields")
    rt_print("SCENARIO action-data-once-surface-and-independent-ownership completed")
    return true

fn checks_main():
    check_text()
    check_rules()
    check_actions()
    return true
