fn neutral_wait_actor(time, day_limit, base_limit):
    let id = "neutral-wait-owner"
    var mind = dv_add_object(dv_world("neutral-wait-mind", "mind", id), c1_state_object(rt_cat("night.wait.", id), {"elapsed": dv_field(0)}))
    mind = dv_with(mind, "time", time)
    var policy = {"goals": [], "progress_weight": 1, "time_cost": 0.01, "plan_depth": 2, "wait_chunk_limit": base_limit, "chapter2_profile": []}
    if day_limit != false:
        policy = dv_with(policy, "daytime_wait_chunk_limit", day_limit)
    return {"id": id, "mind": mind, "actions": [], "policy": policy}

fn neutral_wait_probe():
    let clock = c1_other_clock_ref()
    let other = dv_ref("neutral", "state", "ready")
    let inputs = [dv_true(), dv_at_least(clock, 480), dv_not(dv_at_least(clock, 1260)), dv_all([dv_at_least(clock, 480), dv_not(dv_at_least(clock, 1260)), dv_fact(other, true)]), dv_all([dv_not(dv_not(dv_at_least(clock, 570))), dv_at_least(clock, 570)]), c1_any(dv_at_least(clock, 480), dv_fact(other, false))]
    var comparisons = []
    var i = 0
    while i < rt_count(inputs):
        let condition = inputs[i]
        rt_push(comparisons, {"boundaries_same": dv_same(before_c1n_clock_boundaries(condition), c1n_clock_boundaries(condition)), "without_same": dv_same(before_c1n_without_clock(condition), c1n_without_clock(condition))})
        i = i + 1
    let nested = inputs[3]
    var detached = c1n_clock_boundaries(nested)
    rt_push(detached, 9999)
    let alias_isolated = not dv_has(c1n_clock_boundaries(nested), 9999)
    let changed = dv_with(inputs[1], "value", 600)
    let mutation_invalidates = dv_same(c1n_clock_boundaries(changed), [600])
    let morning = neutral_wait_actor(1800, 30, 180)
    let old_wait = before_c1n_known_wait_actor(morning, 2400, ["neutral-authored-opportunity"])
    let new_wait = c1n_known_wait_actor(morning, 2400, ["neutral-authored-opportunity"])
    let before_morning = neutral_wait_actor(1919, 30, 180)
    let edge_wait = c1n_known_wait_actor(before_morning, 2400, ["neutral-authored-opportunity"])
    let shorter = neutral_wait_actor(1800, 30, 60)
    let shorter_wait = c1n_known_wait_actor(shorter, 2400, ["neutral-authored-opportunity"])
    let undeclared = neutral_wait_actor(1800, false, 180)
    let no_day_wait = c1n_known_wait_actor(undeclared, 2400, ["neutral-authored-opportunity"])
    return {"metadata_differences": comparisons, "cache_return_alias_isolated": alias_isolated, "changed_full_condition_uses_new_key": mutation_invalidates, "morning_old_kind": old_wait.actions[0].kind, "morning_new_kind": new_wait.actions[0].kind, "one_minute_before_boundary_kind": edge_wait.actions[0].kind, "shorter_owned_cap_kind": shorter_wait.actions[0].kind, "undeclared_day_policy_kind": no_day_wait.actions[0].kind, "original_actor_unchanged": dv_same(morning, neutral_wait_actor(1800, 30, 180))}

fn neutral_wait_main():
    let mode = rt_arg(1)
    let malformed = {"op": "not"}
    if mode == "old-bound-error":
        return before_c1n_clock_boundaries(malformed)
    if mode == "new-bound-error":
        return c1n_clock_boundaries(malformed)
    if mode == "old-without-error":
        return before_c1n_without_clock({"op": "all"})
    if mode == "new-without-error":
        return c1n_without_clock({"op": "all"})
    return neutral_wait_probe()

(main (rt_print (rt_json_stringify (neutral_wait_main))))
