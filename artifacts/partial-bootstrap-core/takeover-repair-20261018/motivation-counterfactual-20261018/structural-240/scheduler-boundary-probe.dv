#include ../../../../../language_core/game/entry.dv

// Neutral pure helpers only; no actor preparation or formal session.
fn structural_clock_boundary_probe():
    let clock = dv_ref("neutral-clock", "state", "minute")
    let other = dv_ref("neutral-object", "state", "available")
    return [dvs_known_clock_boundary(dv_true(), clock, 10, 30), dvs_known_clock_boundary(dv_at_least(clock, 20), clock, 10, 30), dvs_known_clock_boundary(dv_fact(clock, 10), clock, 10, 30), dvs_known_clock_boundary(dv_fact(clock, 9), clock, 10, 30), dvs_known_clock_boundary(dv_not(dv_at_least(clock, 20)), clock, 10, 30), dvs_known_clock_boundary(dv_all([dv_at_least(clock, 25), dv_at_least(clock, 20)]), clock, 10, 30), dvs_known_clock_boundary(dv_fact(other, true), clock, 10, 30), dvs_known_clock_boundary({"op": "unknown-dynamic"}, clock, 10, 30), dvs_known_clock_boundary(dv_at_least(clock, 40), clock, 10, 30), dvs_known_clock_boundary(dv_at_least(clock, 12), clock, 10.5, 30)]

// Synthetic guard-level state only. This does not start or advance a session.
fn structural_idle_fixture():
    let location = dv_ref("neutral-owner", "state", "location")
    let clock = dv_ref("neutral-clock", "state", "minute")
    var physical = dv_world("neutral-world", "physical", "")
    physical = dv_add_object(physical, dv_object("neutral-owner", "physical", {"state": {"location": dv_field("room")}}))
    physical = dv_add_object(physical, dv_object("neutral-peer", "physical", {"state": {"location": dv_field("room")}}))
    physical = dv_add_object(physical, dv_object("neutral-clock", "physical", {"state": {"minute": dv_cell(10, 1, 10, [])}}))
    physical = dv_with(physical, "time", 10)
    let costs = {"wait": {"maximum": {"time": 1}}}
    let actor = {"id": "neutral-owner", "location_ref": location, "mind": dv_world("neutral-mind", "mind", "neutral-owner"), "actions": [], "policy": {"budget": 2, "reason_budget": 2, "plan_depth": 1, "remaining_game_time": 100, "goals": [], "notice_co_presence": true}}
    let peer = {"id": "neutral-peer", "location_ref": dv_ref("neutral-peer", "state", "location")}
    let actors = [actor, peer]
    let story = {"clock_ref": clock}
    let stop = {"id": "e0", "type": "planning_stop", "actor": actor.id, "time": 10}
    let guard = rt_snapshot({"time": 10, "until": 20, "source_stop": "e0", "subject": dvs_idle_subject_input(actor, costs), "physical": dvs_idle_physical_input(physical, story), "contact": dvs_idle_contact_input(actor, physical, actors), "bindings": [], "costs": costs, "story": story, "event_cursor": 1, "event_anchor": stop})
    var later = dv_with(physical, "time", 11)
    later = dv_store(later, clock, dv_cell(11, 1, 11, []))
    return {"actor": dv_with(actor, "idle_guard", guard), "physical": later, "actors": actors, "story": story, "costs": costs, "bindings": [], "events": [stop]}

fn structural_idle_invalidation_probe():
    let state = structural_idle_fixture()
    let actor = state.actor
    var support_events = dv_clone(state.events)
    rt_push(support_events, {"id": "e1", "type": "observation", "actor": "neutral-peer"})
    var unknown_events = dv_clone(state.events)
    rt_push(unknown_events, {"id": "e1", "type": "new-unreviewed-event", "actor": "neutral-peer"})
    let changed_peer = dv_with(state.actors[1], "observable_presence_when", dv_not(dv_true()))
    let changed_actors = [state.actors[0], changed_peer]
    return {"cross_minute_same_inputs": dvs_idle_guard_matches(actor, state), "pending_reception_wakes": not dvs_idle_guard_matches(dv_with(actor, "pending_heard", [true]), state), "support_wakes": not dvs_idle_guard_matches(actor, dv_with(state, "events", support_events)), "unknown_event_wakes": not dvs_idle_guard_matches(actor, dv_with(state, "events", unknown_events)), "budget_wakes": not dvs_idle_guard_matches(dv_with(actor, "policy", dv_with(actor.policy, "reason_budget", 1)), state), "actual_presence_wakes_without_mind_change": not dvs_idle_guard_matches(actor, dv_with(state, "actors", changed_actors)), "boundary_wakes": not dvs_idle_guard_matches(actor, dv_with(state, "physical", dv_with(state.physical, "time", 20)))}

fn dvg_debug_run():
    rt_print(rt_json_stringify({"kind": "neutral-scheduler-guard", "boundaries": structural_clock_boundary_probe(), "invalidation": structural_idle_invalidation_probe(), "scope": "pure synthetic state; no session or cognition executed"}))
    return true
