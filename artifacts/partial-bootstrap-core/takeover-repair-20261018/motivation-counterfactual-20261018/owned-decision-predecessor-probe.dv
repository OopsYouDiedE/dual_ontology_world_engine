#include ../../../../language_core/game/entry.dv
// Neutral engineering only; not a formal session or game completion claim.
// Legacy function below differs from current only in the prior-event guard.
fn old_dvs_complete_owned_decision(actor, action, success, events, execution_event, time):
    let decision = dv_find(action, "owned_decision", false)
    if not success or decision == false:
        return actor
    let snapshot = dvs_owned_decision_completion_selection(actor, action, events, execution_event)
    let execution = dvs_find_event_by_id(events, execution_event)
    if snapshot == false or execution == false or execution.type != "action_execution" or execution.actor != actor.id:
        dvs_event(events, "owned_decision_unavailable", actor.id, time, [execution_event], {"decision": decision, "reason": "current-context-or-actual-selection-unavailable"})
        return actor
    if execution.data.receipt.execution.status != "applied":
        return actor
    let inputs = dvs_owned_decision_inputs(actor, decision, actor.mind)
    let previous = dv_find(dv_find(actor, "owned_decisions", []), decision.id, false)
    let receipt = {"id": decision.id, "stance": decision.stance, "context": inputs.context, "basis": decision.basis, "declaration": decision, "selection_sources": snapshot.sources, "completion_sources": inputs.sources, "selection_event": snapshot.selection_event, "execution_event": execution_event, "previous_event": dv_find(previous, "event", ""), "time": time, "meaning": "actual-owner-decision-not-performance-or-outcome"}
    var parents = [execution_event, snapshot.selection_event]
    var i = 0
    while i < rt_count(snapshot.sources.requests):
        let request = snapshot.sources.requests[i].receipt
        if request != false:
            parents = dv_explanation_merge(parents, [request.source_event, request.parse_event])
        i = i + 1
    let event = dvs_event(events, "owned_decision", actor.id, time, parents, receipt)
    let recorded = dv_with(receipt, "event", event)
    return dv_with_many(actor, {"owned_decisions": dv_with(dv_find(actor, "owned_decisions", []), decision.id, recorded), "owned_decision_history": dv_append(dv_find(actor, "owned_decision_history", []), recorded), "last_cognitive_event": event})


fn odp_actor():
    let mind = dv_add_object(dv_world("neutral-owned-decision", "mind", "owner"), dv_object("neutral-input", "neutral", {"state": {"signal": dv_field(0)}}))
    return {"id": "owner", "mind": mind, "policy": {}}

fn odp_action(stance):
    return {"id": "neutral-action", "owned_decision": {"id": "neutral-decision", "stance": stance, "context_refs": [dv_ref("neutral-input", "state", "signal")], "request_topics": [], "basis": ["neutral-engineering-declaration"]}}

// Use the same helpers that freeze the actual selected snapshot and execution
// ancestry. These are neutral helper inputs, not game state or a session run.
fn odp_execution(actor, action, events, status):
    let selection = dvs_event(events, "action_selected", actor.id, 0, [], {"action": action, "owned_decision": dvs_owned_decision_selection(actor, action)})
    return dvs_event(events, "action_execution", actor.id, 0, [selection], {"action": action, "receipt": {"execution": {"status": status}}})

fn odp_report(name, expected, actual):
    rt_json_print({"case": name, "same": dv_same(expected, actual), "expected": expected, "actual": actual})
    return true

fn dvg_debug_run():
    let actor = odp_actor()
    let action = odp_action("accepted")
    var events = []
    let execution = odp_execution(actor, action, events, "applied")
    if rt_arg_count() > 0 and rt_arg(0) == "legacy-first":
        rt_json_print({"scope": "neutral-helper-only", "phase": "before-legacy-first-completion", "expected_error": "prior false used as record", "events": events})
        old_dvs_complete_owned_decision(actor, action, true, events, execution, 0)
        rt_json_print({"phase": "unexpected-legacy-return"})
        return false
    let first = dvs_complete_owned_decision(actor, action, true, events, execution, 0)
    let first_receipt = dv_get(first.owned_decisions, "neutral-decision")
    odp_report("first-empty-predecessor", "", first_receipt.previous_event)
    odp_report("first-real-selected-event", "e0", first_receipt.selection_event)
    odp_report("first-real-execution-event", execution, first_receipt.execution_event)
    odp_report("first-owned-event-kind", "owned_decision", dvs_find_event_by_id(events, first_receipt.event).type)
    let changed = dv_with(first, "mind", dv_store(first.mind, dv_ref("neutral-input", "state", "signal"), dv_field(1)))
    let next_action = odp_action("deferred")
    let next_execution = odp_execution(changed, next_action, events, "applied")
    let second = dvs_complete_owned_decision(changed, next_action, true, events, next_execution, 1)
    let next_receipt = dv_get(second.owned_decisions, "neutral-decision")
    odp_report("second-correct-predecessor", first_receipt.event, next_receipt.previous_event)
    odp_report("second-new-stance", "deferred", next_receipt.stance)
    odp_report("second-selection-inputs", dvs_owned_decision_context(changed, next_action.owned_decision, changed.mind), next_receipt.context)
    var failure_events = []
    let failure_execution = odp_execution(actor, action, failure_events, "applied")
    let before_failure_events = dv_clone(failure_events)
    let unsuccessful = dvs_complete_owned_decision(actor, action, false, failure_events, failure_execution, 0)
    odp_report("unsuccessful-no-extra-event", before_failure_events, failure_events)
    odp_report("unsuccessful-unchanged-owner", actor, unsuccessful)
    odp_report("unsuccessful-no-completion-event", false, dv_has_key(unsuccessful, "owned_decisions"))
    var rejected_events = []
    let rejected_execution = odp_execution(actor, action, rejected_events, "rejected")
    let before_rejected_events = dv_clone(rejected_events)
    let rejected = dvs_complete_owned_decision(actor, action, true, rejected_events, rejected_execution, 0)
    odp_report("non-applied-no-extra-event", before_rejected_events, rejected_events)
    odp_report("non-applied-execution-unchanged", actor, rejected)
    var missing_events = []
    let missing_execution = dvs_event(missing_events, "action_execution", actor.id, 0, [], {"action": action, "receipt": {"execution": {"status": "applied"}}})
    let missing = dvs_complete_owned_decision(actor, action, true, missing_events, missing_execution, 0)
    odp_report("no-real-selection-owner-unchanged", actor, missing)
    odp_report("no-real-selection-recorded-unavailable", "owned_decision_unavailable", missing_events[1].type)
    odp_report("no-decision-unchanged", actor, dvs_complete_owned_decision(actor, {"id": "neutral-no-decision"}, true, [], "", 0))
    rt_json_print({"scope": "neutral-owned-decision-helper-only", "formal_session": "not-started", "game_acceptance": "not-performed", "first": first_receipt, "second": next_receipt, "events": events, "failure_events": failure_events, "rejected_events": rejected_events, "missing_selection_events": missing_events})
    return true
