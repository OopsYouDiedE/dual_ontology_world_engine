// Neutral mechanism data only. No chapter source or game session is loaded.
#include ../../../../../language_core/core/00-data.dv
#include ../../../../../language_core/core/20-observation.dv
#include ../../../../../language_core/core/40-value.dv
#include ../../../../../language_core/core/70-reasoning-cost.dv
#include ../../../../../language_core/core/95-model-argument.dv
#include ../../../../../language_core/verification/session/10-subjective.dv
#include ../../../../../language_core/verification/session/15-action-planning.dv
#include ../../../../../language_core/verification/session/20-speech.dv
#include ../../../../../language_core/verification/session/25-simulation.dv
#include ../../../../../language_core/verification/session/30-runner.dv

fn neutral_choice_probe():
    let mind = {"objects": [], "adoptions": [], "revision": 0, "time": 0}
    let plain = {"id": "neutral.manual", "kind": "wait", "precondition": dv_true(), "repeatable": true, "manual_only": true, "label": "neutral interaction"}
    let policy = {"goals": [], "value_order": ["value_a", "value_b"], "value_basis": ["neutral-source"]}
    let actor = {"id": "neutral-owner", "mind": mind, "actions": [plain], "policy": policy, "used": []}
    let manual = dv_with(actor, "manual_input", true)
    let current_choice = {"group": "neutral-group", "requires": dv_true(), "prohibits": dv_not(dv_true()), "promotes": [], "sacrifices": ["value_a", "value_b"], "basis": ["neutral-source"]}
    let other_choice = dv_with_many(current_choice, {"promotes": ["value_b"], "sacrifices": ["value_a"], "require_positive": true})
    let current = {"id": "neutral.current", "kind": "wait", "precondition": dv_true(), "repeatable": true, "personal_choice": current_choice}
    let other = dv_with_many(current, {"id": "neutral.other", "personal_choice": other_choice})
    let comparer = dv_with(actor, "actions", [current, other])
    let say = {"id": "neutral.say", "kind": "talk", "precondition": dv_true(), "repeatable": true, "speech": {"literal_ast": dv_true()}}
    let speaker = dv_with(actor, "used", ["neutral.say"])
    let events = [
        {"id": "e0", "type": "listener_parse", "actor": actor.id, "data": {"source_event": "neutral-speech"}},
        {"id": "e1", "type": "action_selected", "actor": actor.id, "time": 1, "data": {"action": current}},
        {"id": "e2", "type": "planning_choice", "actor": actor.id, "parents": ["e1"]},
        {"id": "e3", "type": "cost_quote", "actor": actor.id, "parents": ["e2"]},
        {"id": "e4", "type": "host_completion", "actor": actor.id, "parents": ["e3"]},
        {"id": "e5", "type": "action_execution", "actor": actor.id, "parents": ["e4"]},
        {"id": "e6", "type": "listener_parse", "actor": actor.id, "data": {"source_event": "later-speech"}}
    ]
    return {"scope": "constructed neutral mechanism inputs; no gameplay evidence", "autonomous_manual_candidate": dvp_eligible_base(actor, plain, mind, []), "manual_view_candidate": dvp_eligible_base(manual, plain, mind, []), "manual_options": dvs_player_options(actor), "original_actor_received_manual_flag": dv_has_key(actor, "manual_input"), "negative_positive_required_alternative": dvp_personal_admissible(comparer, other, mind), "current_candidate_with_inadmissible_alternative": dvp_eligible(comparer, current, mind, []), "used_explicit_repeatable_speech": dvp_eligible_base(speaker, say, mind, []), "used_once_speech": dvp_eligible_base(speaker, dv_with(say, "once", true), mind, []), "advice_before_selection": dvs_heard_before_selection(events, actor, current, "e5", "e0", "neutral-speech"), "advice_after_selection": dvs_heard_before_selection(events, actor, current, "e5", "e6", "later-speech")}
