#include ../../../language_core/game/entry.dv

// Neutral records exercise only the cache qualification helper, not a session or model.
fn neutral_model_cache_probe():
    let adoptions = {"neutral.rule": {"mode": "predict", "active": true, "basis": ["neutral-source"]}}
    let responses = {"neutral.response": {"confidence": 0.5}}
    let mind = {"revision": 7, "time": 12, "adoptions": adoptions}
    let actor = {"id": "neutral-owner", "mind": mind, "policy": {"Replay_Depth": 4}, "response_models": responses}
    let hypothesis = {"id": "neutral-hypothesis", "timeline": [{"at": 0, "law": "neutral.rule"}], "features": []}
    let model = {"plan_complete": true, "failures": [], "source_revision": 7, "source_mind_time": 12, "source_hypothesis": hypothesis, "source_adoptions": adoptions, "source_response_models": responses, "source_replay_depth": 4, "start_time": 12}
    let unchanged = dvs_model_recheck_eligible(actor, hypothesis, model, 12)
    let independent_copy = dvs_model_recheck_eligible(dv_clone(actor), dv_clone(hypothesis), dv_clone(model), 12)
    let incomplete = dvs_model_recheck_eligible(actor, hypothesis, dv_with(model, "plan_complete", false), 12)
    let sliced = dvs_model_recheck_eligible(actor, hypothesis, dv_with(model, "evaluation_scope", {"kind": "causal-refutation"}), 12)
    let failed = dvs_model_recheck_eligible(actor, hypothesis, dv_with(model, "failures", [{"reason": "neutral-failure"}]), 12)
    let revised_actor = dv_with(actor, "mind", dv_with(mind, "revision", 8))
    let revised = dvs_model_recheck_eligible(revised_actor, hypothesis, model, 12)
    let later_mind = dvs_model_recheck_eligible(dv_with(actor, "mind", dv_with(mind, "time", 13)), hypothesis, model, 12)
    let changed_law = dv_with(actor, "mind", dv_with(mind, "adoptions", dv_with(adoptions, "neutral.rule", {"mode": "predict", "active": false, "basis": ["neutral-source"]})))
    let different_law = dvs_model_recheck_eligible(changed_law, hypothesis, model, 12)
    let different_response = dvs_model_recheck_eligible(dv_with(actor, "response_models", {"neutral.response": {"confidence": 0.6}}), hypothesis, model, 12)
    let changed_candidate = dv_with(hypothesis, "timeline", [{"at": 1, "law": "neutral.rule"}])
    let different_candidate = dvs_model_recheck_eligible(actor, changed_candidate, model, 12)
    let different_depth = dvs_model_recheck_eligible(dv_with(actor, "policy", {"Replay_Depth": 3}), hypothesis, model, 12)
    let later_start = dvs_model_recheck_eligible(actor, hypothesis, model, 13)
    let missing_metadata = dvs_model_recheck_eligible(actor, hypothesis, dv_without(model, "source_hypothesis"), 12)
    let missing_cache = dvs_model_recheck_eligible(actor, hypothesis, false, 12)
    let fallback_actor = dv_with(actor, "policy", [])
    let fallback_changed = dvs_model_recheck_eligible(fallback_actor, hypothesis, model, 12)
    let fallback_matching = dvs_model_recheck_eligible(fallback_actor, hypothesis, dv_with(model, "source_replay_depth", 1), 12)
    let anchored = dv_with(hypothesis, "start_time", 2)
    let anchored_model = dv_with_many(model, {"source_hypothesis": anchored, "start_time": 2})
    let anchored_matching = dvs_model_recheck_eligible(actor, anchored, anchored_model, 99)
    let anchored_mismatch = dvs_model_recheck_eligible(actor, anchored, dv_with(anchored_model, "start_time", 3), 99)
    dv_require(unchanged and independent_copy, "Identical completed neutral context could not be rechecked")
    dv_require(not incomplete and not failed, "Partial or failed neutral plan reused old predictions")
    dv_require(not sliced, "Neutral causal-refutation slice reused as a complete model")
    dv_require(not revised and not later_mind, "Changed neutral knowledge context reused old predictions")
    dv_require(not different_law and not different_response, "Changed neutral model inputs reused old predictions")
    dv_require(not different_candidate and not different_depth and not later_start, "Changed neutral declaration, depth or origin reused old predictions")
    dv_require(not missing_metadata and not missing_cache, "Missing neutral cache provenance was accepted")
    dv_require(not fallback_changed and fallback_matching, "Effective fallback replay depth was not checked")
    dv_require(anchored_matching and not anchored_mismatch, "Explicit neutral origin time was not checked")
    return {"scope": "neutral-model-cache-qualification-only; no session opened and no simulation executed", "unchanged": unchanged, "independent_copy": independent_copy, "incomplete": incomplete, "failed": failed, "revised": revised, "later_mind": later_mind, "different_law": different_law, "different_response": different_response, "different_candidate": different_candidate, "different_depth": different_depth, "later_start": later_start, "missing_metadata": missing_metadata, "missing_cache": missing_cache, "fallback_changed": fallback_changed, "fallback_matching": fallback_matching, "anchored_matching": anchored_matching, "anchored_mismatch": anchored_mismatch}
