#include ../../../language_core/game/entry.dv

fn neutral_navigation_probe():
    let id = "neutral-owner"
    let source = {"path": "neutral-probe", "line": 1, "id": "owned-method"}
    var mind = dv_world("neutral-navigation", "mind", id)
    mind = dv_add_object(mind, c1_state_object(id, {"location": dv_field("living_hall"), "done": dv_field(false)}))
    mind = dv_add_object(mind, c1_state_object("campaign.clock", {"minute": dv_field(2250)}))
    mind = dv_add_object(mind, c1_state_object("campaign.access", {"north": dv_field(true), "east": dv_field(false), "living": dv_field(true)}))
    let edges = c2_edges()
    var i = 0
    while i < rt_count(edges):
        let edge = edges[i]
        let action = c2_move_action(id, edge.from, edge.to, edge.gate)
        mind = dv_adopt(mind, c1_method(action.id, c2_move_law(id, edge.from, edge.to, edge.gate)), "predict", 1, [source])
        let back = c2_move_action(id, edge.to, edge.from, edge.gate)
        mind = dv_adopt(mind, c1_method(back.id, c2_move_law(id, edge.to, edge.from, edge.gate)), "predict", 1, [source])
        i = i + 1
    let blocked = c2_action("neutral.blocked", "help", dv_not(dv_true()), dv_not(dv_true()), "", [], "neutral", source)
    let local = dv_with_many(c2_goal(dv_fact(dv_ref(id, "state", "done"), true), dv_true(), [source]), {"navigation_room": "living_hall", "navigation_methods": [blocked.id]})
    let remote = dv_with(c2_goal(dv_fact(dv_ref(id, "state", "remote"), true), dv_true(), [source]), "navigation_room", "quiet_room")
    let goals = [local, remote]
    let actor = {"id": id, "mind": mind, "actions": [blocked], "policy": {"goals": goals}, "location_ref": c2_position_ref(id), "completed_actions": [], "used": []}
    let navigation = c2_navigation_goals(actor, goals)
    let prefix = c2_navigation_route(actor, "logistics")
    dv_require(rt_count(navigation) == 3, "Blocked local task suppressed the reachable remote intention")
    dv_require(navigation[2].navigation_intention.next == "central_hall", "Remote intention did not retain the current executable first edge")
    dv_require(prefix.target == "central_hall" and prefix.requested_target == "logistics", "Closed downstream gate became a claimed arrival")
    dv_require(dv_truth(mind, c2_at(id, "living_hall")) == "true" and dv_truth(mind, dv_fact(c2_access("east"), false)) == "true", "Navigation changed actual input knowledge")
    let bindings = [dv_binding("campaign.clock", "campaign.clock", id)]
    let clock_ref = dv_scoped_ref(id, "campaign.clock", "state", "minute")
    let existing = [dv_observation(["action-neutral", id, clock_ref], id, clock_ref, 2252, "perception", "direct", 2252, 1, ["action-neutral", clock_ref])]
    let clock_receipt = dvs_receipt_clock_observations({"clock_ref": c2_clock()}, mind, bindings, existing, "action-neutral", "event-neutral", 2252)
    let updated = dv_update_mind(mind, clock_receipt, mind.revision, dvs_observation_profile(actor)).world
    dv_require(rt_count(clock_receipt) == 1 and clock_receipt[0].origin == "execution-receipt" and clock_receipt[0].value == 2252, "Clock receipt duplicated perception or charged time twice")
    dv_require(dv_read(updated, c2_clock()).value == 2252 and dv_read(mind, c2_clock()).value == 2250, "Receipt clock did not advance an independent mind")
    let unknown = dv_store(mind, c2_clock(), dv_unknown())
    dv_require(rt_count(dvs_receipt_clock_observations({"clock_ref": c2_clock()}, unknown, bindings, [], "action-unknown", "event-unknown", 2252)) == 0, "Receipt invented an unknown local clock")
    return {"scope": "neutral-owned-navigation-and-clock-only; no session opened", "blocked_local_does_not_pin": navigation[2].navigation_intention, "closed_gate_prefix": prefix, "original_position": dv_read(mind, c2_position_ref(id)), "original_closed_gate": dv_read(mind, c2_access("east")), "clock_receipt": clock_receipt, "updated_clock": dv_read(updated, c2_clock())}
