; Native DV authorship candidate, loaded after chapter1-content.dv; not installed.
; No oracle, route, timing override, personality score, enforced belief or outcome.
; Requirement strings describe bindings the host must resolve against actual events.
; They are not cognition atoms and must never be treated as completed observations.
; source_refs preserve literary provenance; they do not grant runtime knowledge.
(defn c1_response_source (file line id)
 (c1_source (rt_cat "godot_csharp/scenes/Awakening/Script/story/第一章/场面/" file) line id))
(defn c1_response_clause (kind surface requirement)
 (dv_m3 "kind" kind "surface" surface "requires_actual_binding" requirement))
(defn c1_response_candidate (id actor clauses sources)
 (dv_with (dv_with (dv_m4 "id" id "speaker" actor "clauses" clauses "source_refs" sources)
  "status" "uninstalled-authoring-candidate") "grants" (rt_list)))
(defn c1_response_opening_source () (c1_response_source "01_开场.story" 28 "s3_broadcast.019"))
(defn c1_response_material_source () (c1_response_source "01_开场.story" 30 "s3_broadcast.020"))
(defn c1_response_personal_memory_source (actor)
 (c1_response_source "10_开场独白.story"
  (if (rt_eq actor "huo") 7 (if (rt_eq actor "shen") 15 23))
  (if (rt_eq actor "huo") "opening_huo.003" (if (rt_eq actor "shen") "opening_shen.003" "opening_su.003"))))

; Showing has actual execution, then each observer's own visibility/hearing, then
; a separate personal appraisal. Publishing this declaration cannot complete any stage.
; Cabinet placement and contents must be represented by real scene resources first.
(defn c1_response_showing ()
 (dv_with
  (c1_response_candidate "candidate.demon.reward-showing" "demon"
   (c1_list_4
    (c1_response_clause "literal-public-speech"
     "诸位的报偿，就在铜口下方的领取柜里，各有名签。请亲手核验。"
     "Only assert cabinet, placement and labels after authoritative scene realization; each listener must actually hear this utterance.")
    (c1_response_clause "candidate-physical-action"
     "沈鼎走到柜前，咬了一枚银元。"
     "Execute Shen's chosen inspection with the real cabinet and silver; observers receive only what they actually see. Authenticity is Shen's subsequent appraisal.")
    (c1_response_clause "candidate-physical-action"
     "霍铎把试件举到灯下，刮配合面。"
     "Execute Huo's chosen inspection on the actual test piece. This shows a test, not an achieved impossible drawing or a test verdict absent from the source.")
    (c1_response_clause "candidate-physical-action"
     "苏泠摇响柜旁的试听机。"
     "Execute Su's chosen audition on the actual machine. Bind audible output to each actual listener; do not declare that everyone heard it or that it was previously unheard."))
   (dv_pair (c1_response_source "01_开场.story" 29 "s4_rewards.004") (c1_response_material_source)))
  "support_boundary"
  "名签、银元、试件和试听使报偿显得可核验；它们没有记载谁何时登岛，不能证明身体短居留，也不能授予 short_stay。三人的动作是各自可选行动，不由铜口的一句话替他们执行。"))

(defn c1_response_demon_followup ()
 (c1_response_candidate "candidate.demon.material-reminder" "demon"
  (dv_pair
   (c1_response_clause "literal-public-speech" "银元在柜里，沈师傅。"
    "Only after silver has actually been placed and is still there; hearers need their own hearing receipt.")
   (c1_response_clause "literal-public-speech" "请亲手核验。"
    "An invitation to inspect available materials, never an assertion that inspection or adoption occurred."))
  (dv_pair (c1_response_source "01_开场.story" 31 "s3_broadcast.021")
   (c1_response_source "01_开场.story" 29 "s4_rewards.004"))))

; Belief reports assert 'this is how I heard/adopted it', not the truth of short stay.
; Maintenance requires that adoption still exists; withdrawn views are not restored.
(defn c1_response_huo_basis ()
 (c1_response_candidate "candidate.huo.basis" "huo"
  (c1_list_4
   (c1_response_clause "personal-observation-report" "上船以后的事，没了。"
    "Huo actually has this present memory gap; suppress after contrary recall changes its scope.")
   (c1_response_clause "personal-action-report" "试件，我刮过。"
    "Huo actually performed the reward test-piece inspection.")
   (c1_response_clause "interpretation-report" "初涉。……我听着，是刚来这里。"
    "Huo actually heard the opening and personally adopted this interpretation; never grants short_stay.")
   (c1_response_clause "personal-intention-report" "那张图，我得找。"
    "Huo actually heard the drawing offer and still wants to find it; the offer is not proof the drawing exists."))
  (dv_list3 (c1_response_personal_memory_source "huo") (c1_response_material_source)
   (c1_response_source "01_开场.story" 40 "s4_rewards.023"))))
(defn c1_response_huo_challenge ()
 (c1_response_candidate "candidate.huo.challenge" "huo"
  (dv_pair
   (c1_response_clause "question-only" "你说早就认识。……凭哪一处？拿来，我看。"
    "Huo actually heard this claim from the other speaker; does not assert the claim or any unseen evidence.")
   (c1_response_clause "question-only" "杯子、罐子。……哪一处能看出，在这里多久？"
    "Huo actually heard an argument naming both objects; if only one was named, omit the unmentioned object."))
  (dv_single (c1_response_source "05_声路与交谈.story" 67 "talk_huo_menu.017"))))
(defn c1_response_huo_scope ()
 (c1_response_candidate "candidate.huo.scope" "huo"
  (dv_single (c1_response_clause "question-only" "初涉。……说的是今早，还是上岛？说清楚。"
   "Huo actually heard the word and has a reason to request its scope; neither alternative is asserted."))
  (dv_single (c1_response_opening_source))))
(defn c1_response_huo_maintain ()
 (c1_response_candidate "candidate.huo.maintain" "huo"
  (dv_list3
   (c1_response_clause "interpretation-report" "你说的，我听见了。……刚来这里，这个说法，我还没改。"
    "Huo actually heard the counterargument and still personally adopts short_stay; this is a belief report, not world truth.")
   (c1_response_clause "personal-action-report" "试件，我验过。"
    "Huo actually inspected the test piece; this is not a verdict on an impossible drawing.")
   (c1_response_clause "question-only" "可它能告诉我，是什么时候来的？你那一处，怎么接上？"
    "Huo actually inspected the test piece and heard the particular counterargument; does not invent an absent timestamp or replace unknown evidence with an answer."))
  (dv_pair (c1_response_material_source) (c1_response_source "05_声路与交谈.story" 67 "talk_huo_menu.017"))))

(defn c1_response_shen_basis ()
 (c1_response_candidate "candidate.shen.basis" "shen"
  (c1_list_4
   (c1_response_clause "personal-observation-report" "我就记得上船。往后，白茫茫一片。"
    "Shen's actual present memory remains this limited; do not erase acquired recall.")
   (c1_response_clause "personal-appraisal-report" "钱是真的，我咬过。这活，我接着干。"
    "Shen actually bit the silver, appraised it as genuine and still has this intention; others need to hear his appraisal instead of inheriting it.")
   (c1_response_clause "personal-action-report" "茶是我倒的。顺手，真是顺手，我自己也纳闷。"
    "Shen actually served the tea and personally knows the puzzling unasked preference; not a generic profession-based explanation imposed on him.")
   (c1_response_clause "interpretation-report" "他说初涉，我就当咱们才刚来。"
    "Shen actually heard and personally adopted that reading; not proof of bodily arrival time."))
  (c1_list_4 (c1_response_personal_memory_source "shen")
   (c1_response_source "01_开场.story" 39 "s3_broadcast.022")
   (c1_response_source "05_声路与交谈.story" 108 "talk_shen_menu.004")
   (c1_response_source "05_声路与交谈.story" 109 "talk_shen_menu.005"))))
(defn c1_response_shen_challenge ()
 (c1_response_candidate "candidate.shen.challenge" "shen"
  (dv_pair
   (c1_response_clause "question-only" "会给人倒茶，就算老相识了？你得让我明白，这回为什么不一样。"
    "Shen actually heard a tea-based familiarity argument and knows his own serving habit; asks for the link, does not deny evidence not inspected.")
   (c1_response_clause "personal-conflict-report" "这罐子，不像昨天才养的。可我刚才还当咱们才来。……这两头，怎么接？"
    "Shen actually inspected old jar traces, appraised its age and remembers his prior reading. Optional after that inspection; must not appear before it."))
  (dv_pair (c1_response_source "05_声路与交谈.story" 108 "talk_shen_menu.004")
   (c1_response_source "03_协助.story" 44 "help_E10.004"))))
(defn c1_response_shen_scope ()
 (c1_response_candidate "candidate.shen.scope" "shen"
  (dv_single (c1_response_clause "question-only" "喂，你那句初涉，到底是今早醒来，还是咱们上岛？别叫我们猜。"
   "Shen actually heard the opening word; neither proposed scope is asserted."))
  (dv_single (c1_response_opening_source))))
(defn c1_response_shen_maintain ()
 (c1_response_candidate "candidate.shen.maintain" "shen"
  (dv_list3
   (c1_response_clause "interpretation-report" "顺手的事，我认。我自己也纳闷。可才刚来这个说法，我还没改过来。"
    "Shen actually served tea, knows the preference puzzle, heard the counterargument and still adopts short_stay; suppress when he withdraws it.")
   (c1_response_clause "personal-appraisal-report" "钱是真的，我认。"
    "Shen actually inspected and appraised the silver as genuine; no arrival-time grant follows.")
   (c1_response_clause "question-only" "可光看钱，怎么看出咱们是哪天来的？你说的那一段，再说清楚点。"
    "Shen actually appraised silver as genuine and heard a counterargument; the question requests its basis, never forces a change of mind."))
  (dv_list3 (c1_response_source "01_开场.story" 39 "s3_broadcast.022")
   (c1_response_source "05_声路与交谈.story" 108 "talk_shen_menu.004")
   (c1_response_source "05_声路与交谈.story" 109 "talk_shen_menu.005"))))

(defn c1_response_su_basis ()
 (c1_response_candidate "candidate.su.basis" "su"
  (dv_list3
   (c1_response_clause "personal-observation-report" "最后记得的，是船上的汽笛。"
    "Su's present memory actually remains so limited; do not overwrite subsequent recall.")
   (c1_response_clause "personal-perception-report" "……试听机里的声音，我听见了。"
    "Su actually heard an audible output from the reward audition; does not assert its novelty or everyone else's hearing.")
   (c1_response_clause "interpretation-report" "他说初涉。……我听成了，刚到这里。"
    "Su actually heard the opening and personally adopted this interpretation."))
  (dv_pair (c1_response_personal_memory_source "su") (c1_response_material_source))))
(defn c1_response_su_challenge ()
 (c1_response_candidate "candidate.su.challenge" "su"
  (dv_pair
   (c1_response_clause "personal-observation-report" "……是我的字。可我不知道什么时候记的。"
    "Su actually inspected and recognized her score handwriting, and has not since learned its date.")
   (c1_response_clause "question-only" "你说早就认识。哪一处，能把那一段接上？"
    "Su actually heard a familiarity counterargument; she asks for its link instead of claiming an unknown date."))
  (dv_pair (c1_response_source "03_协助.story" 17 "help_E6.001")
   (c1_response_source "05_声路与交谈.story" 201 "talk_su_menu.011"))))
(defn c1_response_su_scope ()
 (c1_response_candidate "candidate.su.scope" "su"
  (dv_single (c1_response_clause "question-only" "……初涉。说的是今早醒来的我吗？前面那一句，再说一遍。"
   "Su actually heard the opening fragment she is asking about. A request for replay is not a prewritten correct paraphrase."))
  (dv_single (c1_response_opening_source))))
(defn c1_response_su_maintain ()
 (c1_response_candidate "candidate.su.maintain" "su"
  (dv_pair
   (c1_response_clause "interpretation-report" "……声音我听过。初涉，我还是按刚来这里听着。"
    "Su actually heard the audition and opening, heard the counterargument and still adopts short_stay. Audition only anchors her attention, not arrival time.")
   (c1_response_clause "question-only" "你的那一段……让我再听一次。"
    "Su actually heard this counterargument at least once; otherwise ask to hear it rather than 'again'."))
  (dv_pair (c1_response_material_source) (c1_response_personal_memory_source "su"))))

(defn c1_substantive_response_candidates ()
 (dv_with (dv_m3 "id" "chapter1-substantive-response-candidates"
  "status" "uninstalled-review-content"
  "candidates" (c1_list_14 (c1_response_showing) (c1_response_demon_followup)
   (c1_response_huo_basis) (c1_response_huo_challenge) (c1_response_huo_scope) (c1_response_huo_maintain)
   (c1_response_shen_basis) (c1_response_shen_challenge) (c1_response_shen_scope) (c1_response_shen_maintain)
   (c1_response_su_basis) (c1_response_su_challenge) (c1_response_su_scope) (c1_response_su_maintain)))
  "integration_boundary"
  "逐句独立核对实际认知与事件回执，不因同属一个候选而整段解锁。question-only 只能构造询问，不进入断言集。本人观察与他人证言分开；维护是可选表达，不写回 short_stay、不保证输赢。材料呈示和各人检视须实际执行，不能只投放展示文本。"))
