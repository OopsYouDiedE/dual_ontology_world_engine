fn neutral_horizon_probe():
    let zero = dv_action_cost_vector(0, 0, 0)
    let one = dv_action_cost_vector(1, 0, 0)
    let action = {"id": "neutral-wait", "kind": "wait", "precondition": dv_true()}
    let queued = {"action": action, "start": 19, "due": 20, "parent": "neutral-parent", "model": {"minimum": one, "maximum": one, "actual": one}, "choice": {"relevant_refs": []}}
    let actor = {"id": "neutral", "mind": dv_with(dv_world("neutral-mind", "mind", "neutral"), "time", 19), "policy": {"budget": 1}, "ledger": dv_action_cost_ledger("neutral", dv_action_cost_vector(10, 10, 10))}
    let state = {"physical": dv_with(dv_world("neutral-world", "physical", ""), "time", 19), "story": [], "actors": [actor], "events": [], "horizon": 20, "executed": 0, "limit": 10, "idle": 0, "cursor": 0}
    let exact = dv_with(state, "physical", dv_with(state.physical, "time", 20))
    let above = dv_with(state, "physical", dv_with(state.physical, "time", 21))
    let waiting = dv_with(state, "actors", [dv_with(actor, "scheduled_action", queued)])
    let due = dv_with(exact, "actors", waiting.actors)
    let future = dv_with(exact, "actors", [dv_with(actor, "scheduled_action", dv_with(queued, "due", 21))])
    let dispatched = dvs_schedule(waiting)
    let idle = dvs_schedule(exact)
    return {"below_active": dvs_session_active(state), "exact_no_work_stops": not dvs_session_active(exact), "above_stops": not dvs_session_active(above), "exact_pending_active": dvs_session_active(dv_with(exact, "pending", {"neutral": true})), "exact_due_active": dvs_session_active(due), "exact_future_stops": not dvs_session_active(future), "above_pending_stops": not dvs_session_active(dv_with(above, "pending", {"neutral": true})), "due_dispatch_time": dispatched.physical.time, "due_pending_present": dv_has_key(dispatched, "pending"), "due_pending_duration": dispatched.pending.model.actual.time, "exact_no_new_decision_idle": idle.idle, "exact_no_overshoot": idle.physical.time == 20, "budgets_unchanged": dv_same(dispatched.actors[0].policy, actor.policy)}
(main (rt_print (rt_json_stringify (neutral_horizon_probe))))
