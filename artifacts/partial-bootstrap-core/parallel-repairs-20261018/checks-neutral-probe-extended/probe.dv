fn neutral_probe():
    let x = dv_ref("sample", "state", "x")
    let a = dv_ref("sample", "state", "a")
    let b = dv_ref("sample", "state", "b")
    var mind = dv_add_object(dv_world("neutral", "mind", "reader"), dv_object("sample", "perceived", {"state": {"x": dv_field(1), "a": dv_field(9), "b": dv_field(8)}}))
    mind = dv_adopt(mind, dv_axiom("one", 1, dv_fact(x, 1), [dv_assign(a, 2)]), "predict", 1, ["neutral-law"])
    mind = dv_adopt(mind, dv_axiom("two", 1, dv_fact(x, 2), [dv_assign(b, 3)]), "predict", 1, ["neutral-law"])
    let h = {"id": "neutral", "basis": ["neutral"], "timeline": [{"at": 0, "dispatch": {"selector": x, "laws": ["one", "two"]}}], "features": [dv_fact(a, 2)]}
    let plan = v_model_sim_plan(h)
    let dispatch = v_model_sim_dispatch(mind, mind, plan[0])
    dv_require(dispatch.indexed and rt_count(dispatch.steps) == 1 and dispatch.steps[0].law == "one" and rt_count(dispatch.excluded) == 1, "Neutral dispatch failed")
    let masked = v_model_sim_mask(mind, plan, 0)
    dv_require(not dv_read(masked, a).known and not dv_read(masked, b).known and dv_read(mind, a).value == 9, "Neutral full output masking failed")
    let actor = {"id": "reader", "mind": mind, "policy": {"model_budget": 20, "Replay_Depth": 0, "reason_budget": 10}, "inference_derivations": [], "argument": {"id": "argument-neutral", "changes": []}}
    let bounded = v_model_model(actor, h, 0, 0, "")
    dv_require(bounded.replay_depth_exhausted and not bounded.plan_complete and bounded.stop_reason == "replay-depth-exhausted" and bounded.status != "explained", "Neutral replay bound failed")
    let unlimited = v_model_model(dv_with(actor, "policy", dv_with(actor.policy, "Replay_Depth", 10)), h, 0, 0, "")
    dv_require(unlimited.plan_complete and dv_read(unlimited.predicted, a).value == 2 and not dv_read(unlimited.predicted, b).known, "Neutral dispatch replay failed")
    let policy = {"Implicature_Resistance": 0.9, "implicature_threshold": 0.2, "implicature_bridges": [{"id": "candidate", "premise": dv_true(), "proposition": dv_true(), "prior": 0.8, "basis": ["neutral-bridge"]}]}
    let interpretation = v_paid_speech_interpret(mind, policy, {"id": "candidate"}, [])
    dv_require(interpretation.status == "rejected" and interpretation.acceptance.level != "accepted", "Neutral resistance failed")
    let accepted = v_paid_speech_interpret(mind, dv_with(policy, "Implicature_Resistance", 0.1), {"id": "candidate"}, [])
    dv_require(accepted.status == "accepted" and accepted.acceptance.level == "accepted", "Neutral acceptance failed")
    var published = []
    var audited = []
    let after = dvs_argument_revoke(actor, published, 0, "parent")
    let reviewed = v_retract_argument_revoke(actor, audited, 0, "parent")
    dv_require(dv_same(after, reviewed) and dv_same(published, audited), "Neutral complete retraction event mismatch")
    dv_require(dv_same(published[0].data.actor_before, actor) and dv_same(published[0].data.actor_after, after), "Neutral retraction evidence missing")
    let long_h = dv_with(h, "timeline", [{"at": 0, "laws": ["two"]}, {"at": 1, "laws": ["two"]}, {"at": 2, "laws": ["two"]}, {"at": 3, "laws": ["two"]}, {"at": 4, "laws": ["one"]}])
    let trial = v_model_trial(actor, long_h)
    dv_require(trial != false and rt_count(trial.timeline) == 1 and rt_count(trial.mask_plan) == 5 and trial.evaluation_scope.kind == "causal-refutation", "Neutral frozen slice reconstruction failed")
    dv_require(not dv_same(trial, dv_with(trial, "assumptions", [dv_fact(x, 2)])), "Neutral tampered slice became equal")
    var source_events = []
    var judge_events = []
    let stale = dv_with(actor, "inference_derivations", [{"event": "missing-neutral", "adoption": dv_get(mind.adoptions, "one"), "inputs": [{"ref": x, "cell": dv_field(2)}], "changes": [], "valid": true}])
    let refreshed = dvs_refresh_derivations(stale, source_events, 0, "parent")
    let reaudited = v_retract_refresh_derivations(stale, judge_events, 0, "parent")
    dv_require(dv_same(refreshed, reaudited) and dv_same(source_events, judge_events), "Neutral invalidation replay mismatch")
    dv_require(rt_count(source_events) == 1 and source_events[0].data.checked == 1 and dv_same(source_events[0].data.actor_before, stale), "Neutral invalidation evidence missing")
    rt_print(rt_json_stringify({"dispatch": dispatch, "masked_outputs_known": [dv_read(masked, a).known, dv_read(masked, b).known], "depth_stop": bounded.stop_reason, "acceptance": accepted.acceptance, "retraction_event": published[0]}))
    return true

(main (neutral_probe))
