            var data = event.data
            if dv_and(dv_has(data.certificates, bare), dv_and((data.actor_before.id == actor.id), dv_and((data.actor_before.mind.revision == certificate.current_revision), dv_and((dv_find(data.actor_before, "model_paid_event", "") == certificate.paid_model_event), dv_and(dv_has(event.parents, certificate.paid_model_event), v_prune_factor_certificate_parents(certificate, event.parents)))))):
