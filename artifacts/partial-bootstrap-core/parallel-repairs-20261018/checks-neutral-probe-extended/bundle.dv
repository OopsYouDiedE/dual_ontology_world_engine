        if dv_or((rt_count(values) == 0), (not (0 < domain.version))):
            valid = false
        while (j < rt_count(values)):
            if dv_has(seen, values[j]):
                valid = false
            rt_push(seen, values[j])
            j = (j + 1)
        i = (i + 1)
    i = 0
    while (i < rt_count(assignments)):
        var assignment = assignments[i]
        var id = assignments[i].variable
        var domain = dvs_factor_domain(domains, assignments[i].variable)
        if dv_has(ids, id):
            valid = false
        rt_push(ids, id)
        if (domain == false):
            valid = false
        else:
            if dv_and(dv_has(domain.values, assignment.value), (dv_find(versions, id, -1) == domain.version)):
                false
            else:
                valid = false
            rt_push(facts, dv_fact(domain.ref, assignment.value))
        i = (i + 1)
    if (rt_count(scope) == rt_count(ids)):
        false
    else:
        valid = false
    i = 0
    while (i < rt_count(ids)):
        if dv_has(scope, ids[i]):
            false
        else:
            valid = false
        i = (i + 1)
    i = 0
    while (i < rt_count(scope)):
        if dv_has(ids, scope[i]):
            false
        else:
            valid = false
        i = (i + 1)
    if (rt_count(facts) == 1):
        if dv_same(constraint.condition, facts[0]):
            false
        else:
            valid = false
    else:
        if dv_same(constraint.condition, dv_all(facts)):
            false
        else:
            valid = false
    i = 0
    while (i < rt_count(domains)):
        if dv_has(ids, domains[i].id):
            false
        else:
            rt_push(free, domains[i])
        i = (i + 1)
    return {"valid": valid, "fixed": assignments, "free_domains": free}

