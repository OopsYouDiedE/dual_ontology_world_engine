    var seen = false
    var precedes = false
    while (i < rt_count(events)):
        if (events[i].id == current.id):
            precedes = seen
        if (events[i].id == prior.id):
            seen = true
        i = (i + 1)
    return dv_and(precedes, (not (current.time < prior.time)))

fn v_spec_scope(events, spec, event):
