fn v_prune_factor_certificate_current(actor, certificate, events):
    var mind = actor.mind
    var policy = actor.policy
    var required = dv_list3("constraint", "domains", "source_chain")
    var i = 0
    var valid = true
    required = dv_append(required, "source_event_ids")
    required = dv_append(required, "current_revision")
    required = dv_append(required, "covered_assignments")
    required = dv_append(required, "confidence")
    required = dv_append(required, "estimated")
    required = dv_append(required, "paid_model_event")
    required = dv_append(required, "paid_units")
    required = dv_append(required, "results")
    required = dv_append(required, "event")
    while (i < rt_count(required)):
        if dv_has_key(certificate, required[i]):
            false
        else:
            valid = false
        i = (i + 1)
    if valid:
        var domains = dv_find(policy, "factor_domains", [])
        var constraint = certificate.constraint
        var cap = dv_find(policy, "prune_confidence_limit", 0)
        var units = certificate.paid_units
        if dv_and((mind.revision == certificate.current_revision), dv_and(certificate.estimated, dv_and(dv_same(domains, certificate.domains), dv_and(dv_has(dv_find(policy, "factor_constraints", []), constraint), dv_and((0 < cap), dv_and((cap < 1), dv_and((0 < units), dv_and(v_prune_factor_certificate_bound(actor, certificate, events), v_prune_factor_paid(dv_with(actor, "model_paid_event", certificate.paid_model_event), events))))))))):
            var schema = v_prune_factor_schema(domains, constraint)
            if dv_and(schema.valid, dv_and((dv_truth(mind, constraint.condition) == "false"), (dv_truth(mind, constraint.support) == "true"))):
                var proof = v_prune_factor_refs_proof(actor, mind, v_model_sim_refs(dv_all(dv_pair(constraint.condition, constraint.support))), events, rt_count(events), (units - 1), constraint.infer_laws)
                return dv_and(proof.valid, dv_and((proof.remaining == 0), dv_and((0 < rt_count(proof.source_events)), dv_and(v_prune_factor_scope_proof(domains, schema.fixed, proof), dv_and(dv_same(proof.steps, certificate.source_chain), dv_and(dv_same(proof.source_events, certificate.source_event_ids), dv_and(dv_same(certificate.results, {"condition": "false", "support": "true"}), dv_and(dv_same(certificate.covered_assignments, {"fixed": schema.fixed, "free_domains": schema.free_domains}), (certificate.confidence == dv_min(cap, proof.confidence))))))))))
            else:
                return false
        else:
            return false
    else:
        return false

fn v_prune_factor_assignment_complete(domains, assignments):
    var i = 0
    var valid = dv_and((0 < rt_count(domains)), (rt_count(domains) == rt_count(assignments)))
    var ids = []
    while (i < rt_count(assignments)):
        var item = assignments[i]
        var id = assignments[i].variable
        var domain = v_prune_factor_domain(domains, assignments[i].variable)
        if dv_has(ids, id):
            valid = false
        rt_push(ids, id)
        if (domain == false):
            valid = false
        else:
            if dv_has(domain.values, item.value):
                false
            else:
                valid = false
        i = (i + 1)
    return valid

fn v_prune_factor_assignment_key(domains, assignments):
    var i = 0
    var key = []
    while (i < rt_count(domains)):
        var domain = domains[i]
        var j = 0
        while (j < rt_count(assignments)):
            if (domain.id == assignments[j].variable):
                rt_push(key, {"variable": assignments[j].variable, "value": assignments[j].value})
            j = (j + 1)
        i = (i + 1)
    return key

fn v_prune_factor_catalog_complete(domains, hypotheses):
    var product = 1
    var i = 0
    var ids = []
    var refs = []
    var keys = []
    var valid = (0 < rt_count(domains))
    while (i < rt_count(domains)):
        var domain = domains[i]
        var values = domains[i].values
        var j = 0
        var seen = []
        if dv_or(dv_has(ids, domain.id), dv_has(refs, domain.ref)):
            valid = false
        rt_push(ids, domain.id)
        rt_push(refs, domain.ref)
        if dv_or((rt_count(values) == 0), (not (0 < domain.version))):
            valid = false
        while (j < rt_count(values)):
            if dv_has(seen, values[j]):
                valid = false
            rt_push(seen, values[j])
            j = (j + 1)
        product = (product * rt_count(values))
        i = (i + 1)
    if (product == rt_count(hypotheses)):
        false
    else:
        valid = false
    i = 0
    while (i < rt_count(hypotheses)):
        var assignments = dv_find(hypotheses[i], "variable_assignments", [])
        var key = v_prune_factor_assignment_key(domains, dv_find(hypotheses[i], "variable_assignments", []))
        if v_prune_factor_assignment_complete(domains, assignments):
            false
        else:
            valid = false
        if dv_has(keys, key):
            valid = false
        rt_push(keys, key)
        i = (i + 1)
    return valid

// Independent judge helpers: private replay only, never session publication.
fn v_model_sim_rule(predicted, covered, step, mind, confidence, start, i, event_count, selected_index):
    var name = step.law
    var at = step.at
    var adoptions = mind.adoptions
    var complete = true
    var failures = []
    var trace = []
    if dv_has_key(adoptions, name):
        var adoption = dv_get(adoptions, name)
        if dv_and(adoption.active, (adoption.mode == "predict")):
            var law = adoption.law
            var premise = dv_truth(predicted, adoption.law.premise)
            var inputs = v_model_sim_inputs(predicted, adoption.law.premise)
            var local_confidence = dv_min(adoption.confidence, dv_min(confidence, dv_premise_confidence(predicted, adoption.law.premise)))
            var result = false
            var withheld = []
            predicted = dv_with(predicted, "adoptions", dv_with(adoptions, name, dv_with(adoption, "confidence", local_confidence)))
            let event_id = rt_cat(rt_cat(rt_cat("hypothetical-", rt_show(event_count)), rt_cat("-", rt_show(i))), rt_cat("-", rt_show(selected_index)))
            result = dv_predict(dv_with(predicted, "domain", "mind"), name, event_id, (start + at), predicted.revision)
            if (premise == "unknown"):
                var uncertain = v_model_sim_withhold(predicted, law.effects)
                predicted = uncertain.world
                withheld = uncertain.refs
            var local_1 = false
            if (premise == "false"):
                if step.optional:
                    local_1 = "condition-false-not-applicable"
                else:
                    local_1 = "required-premise-false"
            else:
                if (premise == "unknown"):
                    local_1 = "conditional-output-unknown"
                else:
                    local_1 = result.status
            rt_push(trace, dv_with_many({"step": i, "at": at, "law": name, "premise": premise}, {"inputs": inputs, "status": result.status, "changes": result.changes, "basis": adoption.basis, "stage": step.stage, "optional": step.optional, "withheld": withheld, "reason": local_1}))
            if (result.status == "applied"):
                var changes = result.changes
                var j = 0
                predicted = result.world
                while (j < rt_count(changes)):
                    if dv_has(covered, changes[j].ref):
                        false
                    else:
                        rt_push(covered, changes[j].ref)
                    j = (j + 1)
            else:
                if dv_and((premise == "false"), step.optional):
                    false
                else:
                    complete = false
                    rt_push(failures, {"law": name, "reason": result.status, "premise": premise})
        else:
            complete = false
            rt_push(failures, {"law": name, "reason": "not-adopted-predict"})
    else:
        complete = false
        rt_push(failures, {"law": name, "reason": "unknown-law"})
    return {"world": predicted, "coverage": covered, "complete": complete, "failures": failures, "trace": trace}

fn v_model_sim_equal_guard(proposition, ref):
    if (proposition.op == "equals"):
        if dv_same(proposition.ref, ref):
            return {"found": true, "value": proposition.value}
    if (proposition.op == "all"):
        var i = 0
        while (i < rt_count(proposition.items)):
            let result = v_model_sim_equal_guard(proposition.items[i], ref)
            if result.found:
                return result
            i = i + 1
    return {"found": false, "value": false}

fn v_model_sim_dispatch(mind, predicted, step):
    let table = step.dispatch
    let selector = dv_read(predicted, table.selector)
    var indexed = dv_uncontested(selector)
    var entries = []
    var i = 0
    while (i < rt_count(table.laws)):
        let name = table.laws[i]
        let adoption = dv_find(mind.adoptions, name, false)
        var guard = {"found": false, "value": false}
        if (adoption == false):
            indexed = false
        else:
            if (not adoption.active or adoption.mode != "predict"):
                indexed = false
            guard = v_model_sim_equal_guard(adoption.law.premise, table.selector)
            if (not guard.found):
                indexed = false
            var j = 0
            while (j < rt_count(adoption.law.effects)):
                if dv_same(adoption.law.effects[j].ref, table.selector):
                    indexed = false
                j = j + 1
        rt_push(entries, {"law": name, "guard": guard})
        i = i + 1
    var selected = []
    var excluded = []
    i = 0
    while (i < rt_count(entries)):
        let entry = entries[i]
        if (indexed and not dv_same(entry.guard.value, selector.value)):
            rt_push(excluded, entry)
        else:
            rt_push(selected, {"law": entry.law, "at": step.at, "stage": step.stage, "optional": step.optional})
        i = i + 1
    return {"steps": selected, "indexed": indexed, "excluded": excluded, "inputs": [{"ref": table.selector, "cell": selector}]}


fn v_model_slice_intersects(left, right):
    var i = 0
    while (i < rt_count(left)):
        if dv_has(right, left[i]):
            return true
        i = i + 1
    return false


fn v_model_slice_law_io(mind, name):
    let adoption = dv_find(mind.adoptions, name, false)
    if (adoption == false):
        return {"known": false, "reads": [], "writes": []}
    let law = adoption.law
    var reads = v_model_sim_refs(law.premise)
    var writes = []
    var i = 0
    while (i < rt_count(law.effects)):
        let effect = law.effects[i]
        writes = dv_explanation_merge(writes, [effect.ref])
        if (effect.op == "increment"):
            reads = dv_explanation_merge(reads, [effect.ref])
        i = i + 1
    return {"known": adoption.active and adoption.mode == "predict", "reads": reads, "writes": writes}


fn v_model_slice_step_io(actor, step):
    if dv_has_key(step, "response"):
        let model = dv_find(dv_find(actor, "response_models", []), step.response.model, false)
        if (model == false):
            return {"known": false, "reads": [], "writes": []}
        var response_reads = v_model_sim_refs(dv_find(step, "available_when", dv_true()))
        var response_writes = []
        let context = dv_find(model, "context", [])
        var k = 0
        while (k < rt_count(context)):
            response_reads = dv_explanation_merge(response_reads, [context[k].from])
            k = k + 1
        if dv_has_key(model, "choice_ref"):
            response_writes = [model.choice_ref]
        k = 0
        var response_known = true
        while (k < rt_count(step.response.options)):
            let option = dv_find(model.options, step.response.options[k], [])
            let bridge = v_model_slice_law_io(actor.mind, dv_find(option, "bridge_law", ""))
            response_known = response_known and bridge.known
            response_reads = dv_explanation_merge(response_reads, bridge.reads)
            response_writes = dv_explanation_merge(response_writes, bridge.writes)
            k = k + 1
        return {"known": response_known, "reads": response_reads, "writes": response_writes}
    var names = [step.law]
    var reads = []
    var writes = []
    var known = true
    if dv_has_key(step, "dispatch"):
        names = step.dispatch.laws
        reads = [step.dispatch.selector]
    var i = 0
    while (i < rt_count(names)):
        let io = v_model_slice_law_io(actor.mind, names[i])
        known = known and io.known
        reads = dv_explanation_merge(reads, io.reads)
        writes = dv_explanation_merge(writes, io.writes)
        i = i + 1
    return {"known": known, "reads": reads, "writes": writes}


fn v_model_slice_feature(hypothesis, feature, plan, plan_io):
    var needed = v_model_sim_refs(v_model_sim_feature(feature))
    var selected = []
    var keep_prefix = false
    var i = rt_count(plan) - 1
    while (0 <= i):
        let step = plan[i]
        if (not dv_has_key(feature, "at") or step.at <= feature.at):
            let io = plan_io[i]
            if (keep_prefix or not io.known or v_model_slice_intersects(io.writes, needed)):
                selected = dv_explanation_merge(selected, [i])
                needed = dv_explanation_merge(needed, io.reads)
                if (not io.known):
                    keep_prefix = true
        i = i - 1
    var timeline = []
    i = 0
    while (i < rt_count(plan)):
        if dv_has(selected, i):
            rt_push(timeline, plan[i])
        i = i + 1
    var assumptions = []
    let original = dv_find(hypothesis, "assumptions", [])
    i = 0
    while (i < rt_count(original)):
        if (keep_prefix or v_model_slice_intersects(v_model_sim_refs(original[i]), needed)):
            rt_push(assumptions, original[i])
        i = i + 1
    return {"timeline": timeline, "assumptions": assumptions, "feature": dv_without(feature, "at"), "original_feature": feature, "size": rt_count(timeline) + rt_count(assumptions), "mask_plan": plan}


// Reconstruct the only authorized causal-refutation probe from the frozen full hypothesis.
// A matching probe never establishes a full explanation; its scope stays explicit.
fn v_model_trial(actor, hypothesis):
    let features = dv_find(hypothesis, "features", [])
    let plan = v_model_sim_plan(hypothesis)
    var io = []
    var i = 0
    while i < rt_count(plan):
        rt_push(io, v_model_slice_step_io(actor, plan[i]))
        i = i + 1
    var smallest = false
    i = 0
    while i < rt_count(features):
        let feature = features[i]
        if dv_truth(actor.mind, dv_find(feature, "observation", v_model_sim_feature(feature))) != "unknown":
            let slice = v_model_slice_feature(hypothesis, feature, plan, io)
            if smallest == false:
                smallest = slice
            else:
                if slice.size < smallest.size:
                    smallest = slice
        i = i + 1
    if smallest == false:
        return false
    if not (smallest.size * 2 < rt_count(plan) + rt_count(dv_find(hypothesis, "assumptions", []))):
        return false
    return dv_with_many(hypothesis, {"timeline": smallest.timeline, "assumptions": smallest.assumptions, "features": [smallest.feature], "mask_plan": smallest.mask_plan, "evaluation_scope": {"kind": "causal-refutation", "feature": smallest.original_feature}})
fn neutral_probe():
    let x = dv_ref("sample", "state", "x")
    let a = dv_ref("sample", "state", "a")
    let b = dv_ref("sample", "state", "b")
    var mind = dv_add_object(dv_world("neutral", "mind", "reader"), dv_object("sample", "perceived", {"state": {"x": dv_field(1), "a": dv_field(9), "b": dv_field(8)}}))
    mind = dv_adopt(mind, dv_axiom("one", 1, dv_fact(x, 1), [dv_assign(a, 2)]), "predict", 1, ["neutral-law"])
    mind = dv_adopt(mind, dv_axiom("two", 1, dv_fact(x, 2), [dv_assign(b, 3)]), "predict", 1, ["neutral-law"])
    let h = {"id": "neutral", "basis": ["neutral"], "timeline": [{"at": 0, "dispatch": {"selector": x, "laws": ["one", "two"]}}], "features": [dv_fact(a, 2)]}
    let plan = v_model_sim_plan(h)
    let dispatch = v_model_sim_dispatch(mind, mind, plan[0])
    dv_require(dispatch.indexed and rt_count(dispatch.steps) == 1 and dispatch.steps[0].law == "one" and rt_count(dispatch.excluded) == 1, "Neutral dispatch failed")
    let masked = v_model_sim_mask(mind, plan, 0)
    dv_require(not dv_read(masked, a).known and not dv_read(masked, b).known and dv_read(mind, a).value == 9, "Neutral full output masking failed")
    let actor = {"id": "reader", "mind": mind, "policy": {"model_budget": 20, "Replay_Depth": 0, "reason_budget": 10}, "inference_derivations": [], "argument": {"id": "argument-neutral", "changes": []}}
    let bounded = v_model_model(actor, h, 0, 0, "")
    dv_require(bounded.replay_depth_exhausted and not bounded.plan_complete and bounded.stop_reason == "replay-depth-exhausted" and bounded.status != "explained", "Neutral replay bound failed")
    let unlimited = v_model_model(dv_with(actor, "policy", dv_with(actor.policy, "Replay_Depth", 10)), h, 0, 0, "")
    dv_require(unlimited.plan_complete and dv_read(unlimited.predicted, a).value == 2 and not dv_read(unlimited.predicted, b).known, "Neutral dispatch replay failed")
    let policy = {"Implicature_Resistance": 0.9, "implicature_threshold": 0.2, "implicature_bridges": [{"id": "candidate", "premise": dv_true(), "proposition": dv_true(), "prior": 0.8, "basis": ["neutral-bridge"]}]}
    let interpretation = v_paid_speech_interpret(mind, policy, {"id": "candidate"}, [])
    dv_require(interpretation.status == "rejected" and interpretation.acceptance.level != "accepted", "Neutral resistance failed")
    let accepted = v_paid_speech_interpret(mind, dv_with(policy, "Implicature_Resistance", 0.1), {"id": "candidate"}, [])
    dv_require(accepted.status == "accepted" and accepted.acceptance.level == "accepted", "Neutral acceptance failed")
    var published = []
    var audited = []
    let after = dvs_argument_revoke(actor, published, 0, "parent")
    let reviewed = v_retract_argument_revoke(actor, audited, 0, "parent")
    dv_require(dv_same(after, reviewed) and dv_same(published, audited), "Neutral complete retraction event mismatch")
    dv_require(dv_same(published[0].data.actor_before, actor) and dv_same(published[0].data.actor_after, after), "Neutral retraction evidence missing")
    let long_h = dv_with(h, "timeline", [{"at": 0, "laws": ["two"]}, {"at": 1, "laws": ["two"]}, {"at": 2, "laws": ["two"]}, {"at": 3, "laws": ["two"]}, {"at": 4, "laws": ["one"]}])
    let trial = v_model_trial(actor, long_h)
    dv_require(trial != false and rt_count(trial.timeline) == 1 and rt_count(trial.mask_plan) == 5 and trial.evaluation_scope.kind == "causal-refutation", "Neutral frozen slice reconstruction failed")
    dv_require(not dv_same(trial, dv_with(trial, "assumptions", [dv_fact(x, 2)])), "Neutral tampered slice became equal")
    var source_events = []
    var judge_events = []
    let stale = dv_with(actor, "inference_derivations", [{"event": "missing-neutral", "adoption": dv_get(mind.adoptions, "one"), "inputs": [{"ref": x, "cell": dv_field(2)}], "changes": [], "valid": true}])
    let refreshed = dvs_refresh_derivations(stale, source_events, 0, "parent")
    let reaudited = v_retract_refresh_derivations(stale, judge_events, 0, "parent")
    dv_require(dv_same(refreshed, reaudited) and dv_same(source_events, judge_events), "Neutral invalidation replay mismatch")
    dv_require(rt_count(source_events) == 1 and source_events[0].data.checked == 1 and dv_same(source_events[0].data.actor_before, stale), "Neutral invalidation evidence missing")
    rt_print(rt_json_stringify({"dispatch": dispatch, "masked_outputs_known": [dv_read(masked, a).known, dv_read(masked, b).known], "depth_stop": bounded.stop_reason, "acceptance": accepted.acceptance, "retraction_event": published[0]}))
    return true
(main (neutral_probe))
