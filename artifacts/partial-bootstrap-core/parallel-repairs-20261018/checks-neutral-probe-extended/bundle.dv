// Pure audit replay writes only to a audit_events counterfactual log.

fn v_retract_add_ref(refs, ref):
    if dv_has(refs, ref):
        return refs
    else:
        return dv_append(refs, ref)

fn v_retract_reason_cell(cell):
    return dv_without(cell, "time")

fn v_retract_event(events, kind, actor, time, parents, data):
    var id = rt_cat("e", rt_show(rt_count(events)))
    var projected = []
    if dv_has_key(data, "argument"):
        projected = {"argument": data.argument, "mind_revision_before": data.mind_before.revision, "mind_revision_after": data.mind_after.revision, "restored": data.restored, "checked": data.checked, "remaining": data.remaining, "actor_id": actor, "actor_before": data.actor_before, "actor_after": data.actor_after, "mind_before": data.mind_before, "mind_after": data.mind_after}
    else:
        projected = {"mind_revision_before": data.mind_before.revision, "mind_revision_after": data.mind_after.revision, "restored": data.restored, "checked": data.checked, "budget_blocked": data.budget_blocked, "remaining": data.remaining, "actor_id": actor, "actor_before": data.actor_before, "actor_after": data.actor_after, "mind_before": data.mind_before, "mind_after": data.mind_after}
    rt_push(events, {"id": id, "type": kind, "actor": actor, "time": time, "parents": parents, "data": projected})
    return id

fn v_retract_replace(items, index, value):
    var result = []
    var i = 0
    while (i < rt_count(items)):
        var local_1 = false
        if (i == index):
            local_1 = dv_clone(value)
        else:
            local_1 = dv_clone(items[i])
        rt_push(result, local_1)
        i = (i + 1)
    return result

fn v_retract_argument_revoke(actor, events, time, parent):
    var argument = actor.argument
    var world = actor.mind
    var changes = actor.argument.changes
    var i = 0
    var restored = []
    var derivations = dv_find(actor, "inference_derivations", [])
    var contaminated = []
    var remaining = dv_find(actor.policy, "reason_budget", 0)
    var checked = 0
    var blocked = false
    var descendants = []
    var updated = false
    while (i < rt_count(changes)):
        contaminated = v_retract_add_ref(contaminated, changes[i].ref)
        i = (i + 1)
    i = (rt_count(derivations) - 1)
    while dv_and((not (i < 0)), (not blocked)):
        var derivation = derivations[i]
        var dependent = false
        var inputs = derivations[i].inputs
        var j = 0
        if (remaining < 1):
            blocked = true
        else:
            remaining = (remaining - 1)
            checked = (checked + 1)
            while (j < rt_count(inputs)):
                if dv_has(contaminated, inputs[j].ref):
                    dependent = true
                j = (j + 1)
        if dv_and((not blocked), dv_and(dependent, dv_find(derivation, "valid", true))):
            var outputs = derivation.changes
            var k = 0
            while (k < rt_count(outputs)):
                var change = outputs[k]
                var current = dv_read(world, outputs[k].ref)
                if dv_same(current, change.after):
                    world = dv_store(world, change.ref, change.before)
                    contaminated = v_retract_add_ref(contaminated, change.ref)
                    rt_push(restored, change)
                k = (k + 1)
            rt_push(descendants, derivation.event)
            derivations = v_retract_replace(derivations, i, dv_with(derivation, "valid", false))
        i = (i - 1)
    i = 0
    if blocked:
        false
    else:
        while (i < rt_count(changes)):
            var change = changes[i]
            var cell = dv_read(world, changes[i].ref)
            if dv_and((dv_find(cell, "source", "") == "abduction"), dv_has(dv_find(cell, "basis", []), argument.id)):
                world = dv_store(world, change.ref, change.before)
                rt_push(restored, change)
            i = (i + 1)
    if (0 < rt_count(restored)):
        world = dv_with(world, "revision", (world.revision + 1))
    var local_1 = false
    if blocked:
        local_1 = argument
    else:
        local_1 = false
    updated = dv_with(dv_with(dv_with(dv_with(dv_with(dv_with(actor, "mind", world), "argument", local_1), "ready_hypothesis", false), "inference_derivations", derivations), "cognition_blocked", blocked), "policy", dv_with(actor.policy, "reason_budget", remaining))
    updated = dv_with(updated, "last_cognitive_event", rt_cat("e", rt_show(rt_count(events))))
    var local_2 = false
    if blocked:
        local_2 = "model_argument_revocation_pending"
    else:
        local_2 = "model_argument_revoked"
    v_retract_event(events, local_2, actor.id, time, v_retract_cognitive_parents(actor, dv_explanation_merge(dv_pair(parent, argument.id), descendants)), dv_with(dv_with(dv_with(dv_with({"argument": argument, "mind_before": actor.mind, "mind_after": world, "restored": restored}, "checked", checked), "remaining", remaining), "actor_before", actor), "actor_after", updated))
    return updated

fn v_retract_refresh_derivations(actor, events, time, parent):
    var derivations = dv_find(actor, "inference_derivations", [])
    var world = actor.mind
    var i = (rt_count(dv_find(actor, "inference_derivations", [])) - 1)
    var contaminated = []
    var restored = []
    var parents = dv_explanation_merge(dv_single(parent), dv_single(dv_find(actor, "last_cognitive_event", "")))
    if dv_find(actor, "last_cognitive_event", "") == "":
        parents = dv_single(parent)
    var remaining = dv_find(actor.policy, "reason_budget", 0)
    var checked = 0
    var blocked = false
    var updated = false
    while dv_and((not (i < 0)), (not blocked)):
        var derivation = derivations[i]
        var inputs = derivations[i].inputs
        var stale = false
        var j = 0
        if dv_find(derivation, "valid", true):
            if dv_same(derivation.adoption, dv_find(world.adoptions, derivation.adoption.law.name, false)):
                false
            else:
                stale = true
            while (j < rt_count(inputs)):
                var input = inputs[j]
                if dv_or(dv_has(contaminated, input.ref), (not dv_same(v_retract_reason_cell(input.cell), v_retract_reason_cell(dv_read(world, input.ref))))):
                    stale = true
                j = (j + 1)
            if stale:
                if (remaining < 1):
                    blocked = true
                else:
                    var changes = derivation.changes
                    var k = 0
                    remaining = (remaining - 1)
                    checked = (checked + 1)
                    parents = dv_explanation_merge(parents, v_retract_support_parents(actor.mind, v_model_sim_refs(derivation.adoption.law.premise), events, actor.id))
                    while (k < rt_count(changes)):
                        var change = changes[k]
                        if dv_same(dv_read(world, change.ref), change.after):
                            world = dv_store(world, change.ref, change.before)
                            contaminated = v_retract_add_ref(contaminated, change.ref)
                            rt_push(restored, change)
                        k = (k + 1)
                    parents = dv_explanation_merge(parents, dv_single(derivation.event))
                    derivations = v_retract_replace(derivations, i, dv_with(derivation, "valid", false))
        i = (i - 1)
    if (0 < rt_count(restored)):
        world = dv_with(world, "revision", (world.revision + 1))
    updated = dv_with(dv_with(dv_with(dv_with(actor, "mind", world), "inference_derivations", derivations), "cognition_blocked", blocked), "policy", dv_with(actor.policy, "reason_budget", remaining))
    if dv_or(blocked, (0 < checked)):
        updated = dv_with(updated, "last_cognitive_event", rt_cat("e", rt_show(rt_count(events))))
    if dv_or(blocked, (0 < checked)):
        parent = v_retract_event(events, "inference_dependencies_invalidated", actor.id, time, parents, dv_with(dv_with(dv_with(dv_with({"mind_before": actor.mind, "mind_after": world, "restored": restored, "checked": checked}, "budget_blocked", blocked), "remaining", remaining), "actor_before", actor), "actor_after", updated))
    if dv_and((not blocked), (0 < checked)):
        return v_retract_refresh_derivations(updated, events, time, parent)
    else:
        return updated

fn v_retraction_checks(trace):
    var events = v_events(trace)
    var states = []
    var prior_statuses = []
    var findings = []
    var i = 0
    while (i < rt_count(events)):
        var e = events[i]
        var kind = events[i].type
        var data = events[i].data
        var actor = events[i].actor
        var derivations = dv_find(states, events[i].actor, [])
