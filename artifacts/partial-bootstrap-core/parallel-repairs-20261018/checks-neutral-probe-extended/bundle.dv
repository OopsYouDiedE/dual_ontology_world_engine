                if result.accepted:
                    local_2 = "model_argument_accepted"
                else:
                    local_2 = "model_argument_unavailable"
                actor = dv_with(actor, "last_cognitive_event", dvs_event(events, local_2, actor.id, time, parents, {"actor_id": actor.id, "actor_revision": actor.mind.revision, "hypothesis": hypothesis, "competitors": competitors, "result": result}))
                actor = dv_with_many(actor, {"argument_attempt": signature, "policy": dv_with(actor.policy, "reason_budget", result.remaining)})
                if result.accepted:
                    return dv_with_many(actor, {"mind": result.world, "argument": dv_with_many(result.argument, {"adoptions": actor.mind.adoptions, "question_id": dv_find(hypothesis, "question", dv_find(hypothesis, "topic", "")), "hypothesis_id": hypothesis.id})})
                else:
                    return actor

fn dvs_argument_action(actor, action):
    if dv_has_key(action, "argument_slots"):
        if dv_and(dvs_argument_valid(actor), dvs_argument_inputs_current(actor)):
            var argument = actor.argument
            var requested = action.argument_slots
            var claims = actor.argument.claims
            var i = 0
            var propositions = []
            var transmitted = []
            var valid = true
            if (dv_find(action, "argument_question", argument.question_id) == argument.question_id):
                false
            else:
                valid = false
            while (i < rt_count(requested)):
                var slot_id = requested[i]
                var j = 0
                var found = false
                while (j < rt_count(claims)):
                    var claim = claims[j]
                    if (slot_id == claim.slot_id):
                        found = true
                        rt_push(propositions, dv_fact(claim.ref, claim.value))
                        rt_push(transmitted, claim)
                    j = (j + 1)
                if found:
                    false
                else:
                    valid = false
                i = (i + 1)
            if (rt_count(requested) == 0):
                valid = false
            if dv_find(action, "speech_from_argument", false):
                var proposal = dv_with_many({"argument_id": argument.id, "id": argument.id, "estimated": true, "confidence": argument.confidence}, {"claims": transmitted, "source_event_ids": argument.source_event_ids, "model_event": argument.model_event})
                return dv_with_many(dv_without(action, "answer"), {"speech": dv_with_many(dv_find(action, "speech", []), {"literal_ast": dv_all(propositions), "proposal": dv_with(proposal, "reassessment_sources", dvs_argument_reassessment_sources(actor, action, argument))}), "proposal": dv_with(proposal, "reassessment_sources", dvs_argument_reassessment_sources(actor, action, argument)), "argument": argument, "argument_available": valid})
            else:
                return dv_with_many(action, {"answer": dv_all(propositions), "argument": argument, "argument_available": valid})
        else:
            return dv_with(action, "argument_available", false)
    else:
        return action

fn dvs_materialize_arguments(actor):
    var actions = actor.actions
    var i = 0
    var result = []
    while (i < rt_count(actions)):
        rt_push(result, dvs_argument_action(actor, actions[i]))
        i = (i + 1)
