        i = (i + 1)
    argument = dv_with_many(argument, {"factor_coverage": coverage, "competitor_events": dv_explanation_merge(argument.competitor_events, events), "source_event_ids": dv_explanation_merge(argument.source_event_ids, sources), "inputs": dv_explanation_merge(argument.inputs, inputs)})
    return dv_with(result, "argument", argument)

fn dvs_arguments(actor, events, time, parent):
    if (dv_find(actor, "argument", false) == false):
        false
    else:
        if dv_and(dvs_argument_valid(actor), dvs_argument_inputs_current(actor)):
            false
        else:
            actor = dvs_argument_revoke(actor, events, time, parent)
    if dv_and(dvs_argument_valid(actor), dvs_argument_inputs_current(actor)):
        return actor
    else:
        var hypothesis = dv_find(actor, "hypothesis", false)
        var local_1 = false
        if (hypothesis == false):
            local_1 = true
        else:
            local_1 = (not dv_and((0 < rt_count(dv_find(hypothesis, "claim_slots", []))), dv_and((0 < rt_count(dv_find(hypothesis, "features", []))), dv_and((0 < rt_count(dvs_sim_plan(hypothesis))), dv_has_key(dv_find(dv_find(actor, "simulations", []), hypothesis.id, []), "event")))))
        if local_1:
            return actor
        else:
            var model = dvs_cached_model(actor, hypothesis)
            var candidates = dv_find(actor.policy, "hypotheses", [])
            var i = 0
            var competitors = []
            var coverage = dvs_factor_coverage(actor, hypothesis, events)
            var slots = dv_find(hypothesis, "claim_slots", [])
            var policy = dv_find(actor.policy, "abduction", [])
            var signature = {"model": dv_find(dvs_cached_model(actor, hypothesis), "event", ""), "revision": actor.mind.revision, "slots": dv_find(hypothesis, "claim_slots", []), "policy": dv_find(actor.policy, "abduction", [])}
            if dv_same(signature, dv_find(actor, "argument_attempt", false)):
                return actor
            else:
                if dvs_factor_covered(hypothesis, coverage.certificates):
                    model = {"status": "certificate-refuted", "fit": -1000000}
                while (i < rt_count(candidates)):
                    var candidate = candidates[i]
                    if dv_and(dvp_topic(actor, candidate), dv_and((not (candidate.id == hypothesis.id)), dv_and((dv_find(candidate, "group", "") == dv_find(hypothesis, "group", "")), (dv_truth(actor.mind, dv_find(candidate, "available_when", dv_true())) == "true")))):
                        if dvs_factor_covered(candidate, coverage.certificates):
                            false
                        else:
                            rt_push(competitors, dvs_cached_model(actor, candidate))
                    i = (i + 1)
                var certificates = coverage.certificates
                var c = 0
                while (c < rt_count(certificates)):
                    policy = dv_with(policy, "confidence_cap", dv_min(dv_find(policy, "confidence_cap", 0), certificates[c].confidence))
                    c = (c + 1)
                var result = dvs_factor_argument(dv_accept_explanation(actor.mind, model, competitors, slots, dvs_argument_sources(events, actor), policy, dv_find(actor.policy, "reason_budget", 0), time, rt_cat("e", rt_show(rt_count(events)))), coverage)
                var parents = dvs_cognitive_parents(actor, dv_single(parent))
                if dv_has_key(model, "event"):
