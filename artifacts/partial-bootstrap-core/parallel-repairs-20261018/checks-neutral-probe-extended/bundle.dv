        while (j < rt_count(rules)):
            if (rules[j].id == id):
                work = (work + (2 * v_paid_speech_rule_units(rules[j])))
            j = (j + 1)
        i = (i + 1)
    return work

fn v_paid_speech_goals(actor):
    var goals = dv_find(actor.policy, "communication_goals", [])
    var active = []
    var i = 0
    while (i < rt_count(goals)):
        var goal = goals[i]
        if dv_and((0 < rt_count(dv_find(goal, "basis", []))), (dv_truth(actor.mind, dv_find(goal, "available_when", dv_true())) == "true")):
            dv_require((not (goal.weight < 0)), "Negative communication weight")
            rt_push(active, goal)
        i = (i + 1)
    return active

fn v_paid_speech_goal_value(goals, listener, prediction):
    var value = 0
    var i = 0
    var interpretations = prediction.prediction
    while (i < rt_count(goals)):
        var goal = goals[i]
        var targets = dv_find(goals[i], "listeners", [])
        var j = 0
        if dv_or((rt_count(targets) == 0), dv_has(targets, listener)):
            while (j < rt_count(interpretations)):
                var interpretation = interpretations[j]
                if dv_and((interpretation.id == goal.interpretation_id), (interpretation.status == goal.desired_status)):
                    value = (value + (goal.weight * interpretation.confidence))
                j = (j + 1)
        i = (i + 1)
    return value

fn v_paid_prediction_check(trace, e):
    var data = e.data
    var before = dv_find(e.data, "actor_before", [])
    var status = "insufficient_evidence"
    var valid = true
    if dv_and((0 < rt_count(before)), dv_has_key(data, "action")):
        var action = data.action
        var listener = data.listener
        var models = dv_find(before.mind, "listener_models", [])
        var expected = {"status": "unknown-no-model", "prediction": []}
        var units = 0
        var keys = []
        var local_1 = false
        if dv_has_key(models, listener):
            local_1 = (0 < rt_count(dv_find(dv_get(models, listener), "basis", [])))
        else:
            local_1 = false
        if local_1:
            expected = dv_with(dv_with(v_paid_speech_model_prediction(dv_get(models, listener), action.speech, e.actor, rt_cat("preselect-", action.id), e.time), "status", "model-based"), "model", dv_get(models, listener))
            units = v_paid_speech_prediction_units(dv_get(models, listener), action.speech)
        rt_push(keys, "listener")
        rt_push(keys, "action")
        rt_push(keys, "actor_before")
        rt_push(keys, "actor_after")
        rt_push(keys, "budget_before")
        rt_push(keys, "budget_after")
        rt_push(keys, "charged_units")
        rt_push(keys, "goals")
        rt_push(keys, "prediction_time")
        valid = dv_same(expected, v_record_without(data, keys))
        valid = dv_and(valid, dv_and(v_action_frozen(trace, e.actor, action), dv_same(before.mind, v_cognitive_before(trace, e))))
        valid = dv_and(valid, dv_and((units == data.charged_units), dv_and((data.budget_before == before.policy.model_budget), (data.budget_after == (data.budget_before - units)))))
        var local_2 = false
        if (0 < units):
            local_2 = e.id
        else:
            local_2 = dv_find(before, "model_previous_event", "")
        valid = dv_and(valid, dv_same(data.actor_after, dv_with(dv_with(before, "policy", dv_with(before.policy, "model_budget", data.budget_after)), "model_previous_event", local_2)))
        valid = dv_and(valid, dv_same(data.goals, v_paid_speech_goals(before)))
        valid = dv_and(valid, v_runtime_policy_valid(trace, e, before.policy))
        var local_3 = false
        if valid:
            local_3 = "supported"
        else:
            local_3 = "violated"
        status = local_3
    return v_finding("paid_speech_prediction", status, "独立重算本人预选时的听者模型、条件分支复用及逐节点收费；保留实际预算前后与本人可知来源", dv_single(e.id))

fn v_paid_execution_prediction_check(trace, e):
    var data = e.data
    var paid = dv_find(e.data, "paid_forecast", [])
    var ids = dv_find(e.data, "paid_prediction_events", [])
    var i = 0
    var found = false
    var valid = true
    while (i < rt_count(ids)):
        var prior = v_event(v_events(trace), ids[i])
        if (dv_find(prior, "type", "") == "speech_choice_prediction"):
            valid = dv_and(valid, dv_and((prior.actor == e.actor), v_ancestor(v_events(trace), e.id, prior.id)))
            valid = dv_and(valid, (v_paid_prediction_check(trace, prior).status == "supported"))
            if dv_same(prior.data, paid):
                found = true
        else:
            valid = false
        i = (i + 1)
    var keys = dv_list3("source_event", "paid_prediction_events", "paid_forecast")
    rt_push(keys, "charged_units")
    rt_push(keys, "execution_charged_units")
    rt_push(keys, "speaker_after")
    rt_push(keys, "preselection_source_revision")
    valid = dv_and(valid, dv_same(v_record_without(data, keys), v_record_without(paid, dv_single("charged_units"))))
    if (0 < rt_count(paid)):
        var source = v_event(v_events(trace), dv_find(data, "source_event", ""))
        valid = dv_and(valid, dv_and((dv_find(source, "actor", "") == e.actor), v_ancestor(v_events(trace), e.id, dv_find(source, "id", ""))))
        valid = dv_and(valid, dv_and(dv_same(dv_find(dv_find(source, "data", []), "speech", false), paid.action.speech), (dv_find(data, "listener", "") == paid.listener)))
    var local_1 = false
    if (rt_count(paid) == 0):
        local_1 = "insufficient_evidence"
    else:
        if dv_and(found, dv_and(valid, dv_and((dv_find(data, "charged_units", -1) == 0), (dv_find(data, "execution_charged_units", -1) == 0)))):
            local_1 = "supported"
        else:
            local_1 = "violated"
    return v_finding("speaker_prediction_boundary", local_1, "实际发言复用已付费的本人预选记录；核对真实父链与原付费结果，执行时不再免费预测或重复收费", dv_append(ids, e.id))

fn v_paid_speaker_trust(policy, speaker):
    var trust = dv_find(dv_find(policy, "speaker_trust", []), speaker, 0.5)
    let biases = dv_find(policy, "class_bias", [])
    var i = 0
    while i < rt_count(biases):
        let bias = biases[i]
        if 0 < rt_count(dv_find(bias, "basis", [])) and dv_has(bias.speakers, speaker):
            trust = trust + bias.delta
        i = i + 1
    return dv_min(1, dv_max(0, trust))
// Judge-side replay of structured language; no session mutation or oracle-to-policy path.

fn v_frozen_actor(trace, id):
    var actors = dv_find(dv_find(trace, "initial", []), "actors", [])
    var i = 0
    var found = []
    while (i < rt_count(actors)):
        if (actors[i].id == id):
            found = actors[i]
        i = (i + 1)
    return found

fn v_authority_before(trace, e):
    var events = v_events(trace)
    var world = dv_find(dv_find(trace, "initial", []), "physical", [])
    var i = 0
    var ancestors = v_ancestors(v_events(trace), e.id)
    while (i < rt_count(events)):
        var prior = events[i]
        var data = dv_find(events[i], "data", [])
        if dv_has(ancestors, prior.id):
            var local_1 = false
            if (prior.type == "action_execution"):
                local_1 = dv_find(data, "physical_after", [])
            else:
                if (prior.type == "question_transition"):
                    local_1 = dv_find(data, "world", [])
                else:
                    local_1 = []
            var candidate = local_1
            if (0 < rt_count(candidate)):
                if (rt_count(world) == 0):
                    world = candidate
                else:
                    if (world.revision < candidate.revision):
                        world = candidate
        i = (i + 1)
    return world

fn v_language_map(mind, p, bindings):
    var op = p.op
    if (op == "constant"):
        return p
    else:
        if (op == "not"):
            return dv_not(v_language_map(mind, p.item, bindings))
        else:
            if (op == "all"):
                var items = p.items
                var mapped = []
                var i = 0
                while (i < rt_count(items)):
                    rt_push(mapped, v_language_map(mind, items[i], bindings))
                    i = (i + 1)
                return dv_all(mapped)
            else:
                var ref = p.ref
                var local = dv_local(bindings, p.ref.object, mind.subject)
                if (local == ""):
                    if dv_has_key(mind.objects, ref.object):
                        return p
                    else:
                        return {"op": "constant", "value": "unknown"}
                else:
                    return dv_with(p, "ref", dv_ref(local, ref.facet, ref.field))

fn v_testimony(mind, p, source, origin, time, trust):
    var op = p.op
    var result = []
    if (op == "all"):
        var items = p.items
        var i = 0
        while (i < rt_count(items)):
            var part = v_testimony(mind, items[i], source, origin, time, trust)
            var j = 0
            while (j < rt_count(part)):
                if dv_has(result, part[j]):
                    false
                else:
                    rt_push(result, part[j])
                j = (j + 1)
            i = (i + 1)
    else:
        if (op == "equals"):
            var ref = p.ref
            rt_push(result, dv_observation(dv_list3(source, mind.subject, ref), mind.subject, ref, p.value, "testimony", origin, time, trust, dv_pair(origin, ref)))
    return result

fn v_hearing(trace, source, listener_id):
    var world = v_authority_before(trace, source)
    var speaker = v_frozen_actor(trace, source.actor)
    var listener = v_frozen_actor(trace, listener_id)
    var speech = dv_find(source.data, "speech", [])
    if dv_or((rt_count(world) == 0), dv_or((rt_count(speaker) == 0), (rt_count(listener) == 0))):
        return "unknown"
    else:
        var sref = dv_find(speaker, "location_ref", dv_ref(speaker.id, "state", "location"))
        var lref = dv_find(listener, "location_ref", dv_ref(listener_id, "state", "location"))
        var grants = dv_find(listener, "hearing_grants", [])
        var i = 0
        var heard = false
        var scell = dv_read(world, dv_find(speaker, "location_ref", dv_ref(speaker.id, "state", "location")))
        var lcell = dv_read(world, dv_find(listener, "location_ref", dv_ref(listener_id, "state", "location")))
        if dv_and(scell.known, lcell.known):
            heard = dv_same(scell.value, lcell.value)
        while (i < rt_count(grants)):
            var g = grants[i]
            if dv_and((g.speaker == source.actor), (g.channel == dv_find(speech, "channel", ""))):
                heard = true
            i = (i + 1)
        if heard:
            return "true"
        else:
            if dv_and(scell.known, lcell.known):
                return "false"
            else:
                return "unknown"

fn v_listener_replay_compute(trace, e):
    var data = e.data
    var source = v_event(v_events(trace), dv_find(e.data, "source_event", ""))
    var actor = v_frozen_actor(trace, e.actor)
    var checks = []
    var status = "insufficient_evidence"
    var reason = "缺少本人快照、真实交流来源或冻结解析策略"
    var refs = dv_single(e.id)
    if (0 < rt_count(source)):
        rt_push(refs, source.id)
        if (e.type == "speech_unheard"):
            var local_1 = false
            if (v_hearing(trace, source, e.actor) == "false"):
                local_1 = "supported"
            else:
                if (v_hearing(trace, source, e.actor) == "true"):
                    local_1 = "violated"
                else:
                    local_1 = "insufficient_evidence"
            status = local_1
            reason = "依据实际权威位置和已授权听觉通道核对未闻；未闻不等于收到或采纳"
        else:
            if dv_and(dv_and(dv_has_key(data, "mind_before"), dv_has_key(data, "mind_after")), (0 < rt_count(actor))):
                var speech = dv_find(source.data, "speech", [])
                var before = data.mind_before
                var policy = actor.policy
                var parsed = []
                var observations = []
                var after = []
                var decision = []
                var valid = true
                parsed = v_language_map(before, speech.literal_ast, dv_find(speech, "referents", []))
                decision = v_paid_speech_proposal_decision(before, policy, speech, dv_find(dv_find(policy, "speaker_trust", []), source.actor, 0.5))
                observations = v_paid_speech_received_observations(before, parsed, source.id, source.actor, e.time, decision)
                after = dv_update_mind(before, observations, before.revision, dv_observation_profile({"perception": 1, "testimony": 1, "recall": 1}, dv_find(policy, "observation_threshold", 0.5))).world
                checks = dv_with(dv_with({"literal_parse": dv_same(parsed, dv_find(data, "literal", false)), "observation_delivery": dv_same(observations, dv_find(data, "observations", false)), "mind_update": dv_same(after, data.mind_after), "execution_source": v_source_delivery(trace, source)}, "source_ancestor", v_ancestor(v_events(trace), e.id, source.id)), "hearing", v_hearing(trace, source, e.actor))
                valid = dv_and(dv_same(parsed, dv_find(data, "literal", false)), dv_and(dv_same(observations, dv_find(data, "observations", false)), dv_same(after, data.mind_after)))
                if dv_has_key(speech, "proposal"):
                    valid = dv_and(valid, dv_same(decision, dv_find(data, "proposal_decision", [])))
                valid = dv_and(valid, v_ancestor(v_events(trace), e.id, source.id))
                valid = dv_and(valid, checks.execution_source)
                var local_2 = false
                if valid:
                    if (v_hearing(trace, source, e.actor) == "true"):
                        local_2 = "supported"
                    else:
                        if (v_hearing(trace, source, e.actor) == "false"):
                            local_2 = "violated"
                        else:
                            local_2 = "insufficient_evidence"
                else:
                    local_2 = "violated"
                status = local_2
                reason = "从真实交流字面、本人指代绑定、信任和听觉条件重算接收、解析与认知更新；checks分列实际差异"
                if (rt_count(v_origin_execution(v_events(trace), source)) == 0):
                    status = "insufficient_evidence"
                    reason = "话语的真实执行祖先及其权威快照未记录，不能判接收违反"
    return dv_with(dv_with(dv_with(v_finding("speech_reception_boundary", status, reason, refs), "actor", e.actor), "action", e.type), "checks", checks)

fn v_source_delivery(trace, source):
    var execution = v_origin_execution(v_events(trace), source)
    if (rt_count(execution) == 0):
        return false
    else:
        var data = execution.data
        var action = execution.data.action
        var source_data = source.data
        if dv_and(dv_has_key(action, "speech"), dv_has_key(source_data, "literal")):
            return dv_and(v_action_frozen(trace, source.actor, action), dv_and((data.receipt.execution.status == "applied"), dv_and(dv_same(action.speech, dv_find(source_data, "speech", false)), dv_same(action.speech.literal_ast, source_data.literal))))
        else:
            return false

fn v_reception_verified(trace, id):
    var e = v_event(v_events(trace), id)
    if (rt_count(e) == 0):
        return false
    else:
        return (v_listener_replay(trace, e).status == "supported")

fn v_testimony_dependency(trace, e):
    var data = e.data
    var observations = dv_find(e.data, "observations", [])
    var i = 0
    var result = []
    while (i < rt_count(observations)):
        var obs = observations[i]
        var after = dv_find(data, "mind_after", [])
        var status = "insufficient_evidence"
        var reason = "缺少认知后快照，无法核对共同来源依赖"
        var refs = dv_single(e.id)
        if (0 < rt_count(after)):
            var claims = dv_find(dv_read(after, obs.ref), "claims", [])
            var j = 0
            var dependencies = []
            var duplicate = false
            while (j < rt_count(claims)):
                var claim = claims[j]
                var dep = dv_find(claims[j], "dependency", false)
                if dv_has(dependencies, dep):
                    duplicate = true
                else:
                    rt_push(dependencies, dep)
                j = (j + 1)
            var local_1 = false
            if duplicate:
                local_1 = "violated"
            else:
                local_1 = "supported"
            status = local_1
            reason = "同一依赖身份的重复证言在本人cell中不应作为多个独立来源重复存留"
        rt_push(result, dv_with(dv_with(v_finding("evidence_dependency_identity", status, reason, refs), "actor", e.actor), "dependencies", dv_find(obs, "dependency", false)))
        if (obs.source == "testimony"):
            var source = v_event(v_events(trace), dv_find(data, "source_event", ""))
            if (0 < rt_count(source)):
                var source_mind = dv_find(source.data, "mind_before", [])
                if (0 < rt_count(source_mind)):
                    var upstream = dv_find(dv_read(source_mind, obs.ref), "claims", [])
                    var k = 0
                    var relayed = false
                    while (k < rt_count(upstream)):
                        if (upstream[k].source == "testimony"):
                            relayed = true
                        k = (k + 1)
                    if relayed:
                        rt_push(result, dv_with(v_finding("testimony_common_origin", "insufficient_evidence", "转述者本人的该命题已有上游证言，当前回执仅依新speaker标识；缺跨转述共同来源映射，不能宣称来源独立", refs), "actor", e.actor))
        i = (i + 1)
    return result

fn v_listener_replay(trace, e):
    var cached = dv_find(trace, "judge_reception_findings", [])
    var i = 0
    var found = []
    while (i < rt_count(cached)):
        if dv_same(cached[i].evidence_refs[0], e.id):
            found = cached[i]
        i = (i + 1)
    if (rt_count(found) == 0):
        return v_listener_replay_compute(trace, e)
    else:
        return found

fn v_receptions_compute(trace):
    var events = v_events(trace)
    var i = 0
    var findings = []
    while (i < rt_count(events)):
        var e = events[i]
        if dv_or((e.type == "listener_parse"), (e.type == "speech_unheard")):
            rt_push(findings, v_listener_replay_compute(trace, e))
        i = (i + 1)
    return findings

// ---- Merged source module: 10-comparisons.dv ----
// Configuration comparisons require a prior approval record and invariant frozen domains.

fn v_load_run(run):
    var manifest = rt_json_parse(rt_read(run.manifest))
    var trace = rt_json_parse(rt_read(run.trace))
    var oracle = rt_json_parse(rt_read(run.oracle))
    return {"manifest": manifest, "trace": trace, "oracle": oracle, "report": v_judge(manifest, trace, oracle)}

fn v_compare(configuration, mode):
    var runs = dv_find(configuration, "runs", [])
    var reports = []
    var findings = []
    var baseline = []
    var i = 0
    if dv_and(dv_has_key(configuration, "approval_ref"), dv_has_key(configuration, "frozen_fields")):
        false
    else:
        rt_push(findings, v_finding("comparison_authorization", "insufficient_evidence", "Prior approval and frozen-field contract absent; no causal improvement claim permitted", []))
    while (i < rt_count(runs)):
        var run = v_load_run(runs[i])
        var manifest = run.manifest
        if (i == 0):
            baseline = manifest
        else:
            var fields = dv_find(configuration, "frozen_fields", [])
            var j = 0
            var status = "supported"
            while (j < rt_count(fields)):
                var field = fields[j]
                if dv_and(dv_has_key(baseline, field), dv_has_key(manifest, field)):
                    if (field == "initial"):
                        false
                    else:
                        if dv_same(dv_get(baseline, field), dv_get(manifest, field)):
                            false
                        else:
                            status = "invalid_run"
                else:
                    if (status == "supported"):
                        status = "insufficient_evidence"
                j = (j + 1)
            rt_push(findings, v_finding("configuration_isolation", status, "Frozen domains compared independently of outcomes", dv_single(runs[i].manifest)))
        rt_push(reports, {"source": runs[i], "report": run.report, "loaded": run})
        i = (i + 1)
    if (rt_count(runs) < 2):
        rt_push(findings, v_finding("comparison_window", "not_observed", "At least two separately frozen formal sessions required", []))
    var actual = v_actual_isolation(configuration, mode, reports)
    var j = 0
    while (j < rt_count(actual)):
        rt_push(findings, actual[j])
        j = (j + 1)
    rt_push(findings, v_comparison_contract(configuration, mode))
    if (mode == "capability"):
        rt_push(findings, v_compare_effect(configuration, mode, reports, v_outcome_differences(reports)))
    else:
        var extra = v_supplement_findings(configuration, mode, reports)
        var j = 0
        while (j < rt_count(extra)):
            rt_push(findings, extra[j])
            j = (j + 1)
    return {"mode": mode, "configuration": configuration, "findings": findings, "runs": v_public_reports(reports)}

fn v_compare_main(mode):
    dv_require((rt_arg_count() == 1), "Usage: comparison-entry comparison.json")
    return rt_print(rt_json_stringify(v_compare(rt_json_parse(rt_read(rt_arg(0))), mode)))

fn v_comparison_contract(configuration, mode):
    var status = "supported"
    var reason = "Prior approved variant scope and required frozen domains present"
    var required = dv_list3("initial", "axioms", "cost_model")
    var fields = dv_find(configuration, "frozen_fields", [])
    var i = 0
    if dv_and(dv_has_key(configuration, "approval_ref"), dv_has_key(configuration, "allowed_variants")):
        false
    else:
        status = "insufficient_evidence"
    while (i < rt_count(required)):
        if dv_has(fields, required[i]):
            false
        else:
            status = "insufficient_evidence"
        i = (i + 1)
    if (mode == "capability"):
        if dv_same(dv_find(configuration, "variable_fields", []), dv_single("capability")):
            false
        else:
            status = "invalid_run"
    else:
        if (mode == "evidence_boundary"):
            if dv_has_key(configuration, "legal_propagation_variants"):
                false
            else:
                status = "insufficient_evidence"
        else:
            if dv_and(dv_and(dv_has_key(configuration, "approved_ranges"), dv_has_key(configuration, "neighborhood")), dv_and(dv_has_key(configuration, "reserve_set"), dv_has_key(configuration, "random_stream_contract"))):
                false
            else:
                status = "insufficient_evidence"
    return v_finding("approved_configuration_contract", status, reason, dv_single(dv_find(configuration, "approval_ref", false)))

fn v_findings_named(report, id):
    var items = report.findings
    var i = 0
    var result = []
    while (i < rt_count(items)):
        if (items[i].id == id):
            if dv_or((id == "literal_truth"), dv_or((id == "epistemic_support"), (id == "causal_completeness"))):
                if (dv_find(items[i], "phase", "") == "answer"):
                    rt_push(result, items[i])
            else:
                rt_push(result, items[i])
        i = (i + 1)
    return result

fn v_last_finding(report, id):
    var items = v_findings_named(report, id)
    if (rt_count(items) == 0):
        return []
    else:
        return items[(rt_count(items) - 1)]

fn v_outcome_differences(reports):
    var result = []
    var i = 1
    var names = dv_list3("literal_truth", "epistemic_support", "causal_completeness")
