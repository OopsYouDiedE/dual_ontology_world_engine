// Persistent-by-copy data operations. Unchanged branches are frozen and thawed
// only when accessed through an output owner, so output mutations stay independent.

fn dv_pair(a, b):
    var r = []
    rt_push(r, a)
    rt_push(r, b)
    return r

fn dv_single(a):
    var r = []
    rt_push(r, a)
    return r

fn dv_list3(a, b, c):
    var r = dv_pair(a, b)
    rt_push(r, c)
    return r

fn dv_and(a, b):
    if a:
        return b
    else:
        return false

fn dv_or(a, b):
    if a:
        return true
    else:
        return b

fn dv_require(condition, message):
    if condition:
        return true
    else:
        return rt_fail(message)

fn dv_clone(value):
    return rt_copy_value(value)

fn dv_same(a, b):
    return rt_same_value(a, b)

fn dv_append(items, value):
    var r = dv_clone(items)
    rt_push(r, dv_clone(value))
    return r

fn dv_has(items, value):
    return rt_has_value(items, value)

fn dv_find(record, key, fallback):
    return rt_record_find(record, key, fallback)

fn dv_has_key(record, key):
    return 0 <= rt_record_index(record, key)

fn dv_record_like(value):
    if rt_is_list(value):
        var i = 0
        var valid = true
        while dv_and(valid, (i < rt_count(value))):
            var entry = value[i]
            var local_1 = false
            if rt_is_list(entry):
                local_1 = (rt_count(entry) == 2)
            else:
                local_1 = false
            valid = local_1
            i = (i + 1)
        return valid
    else:
        return false

fn dv_get(record, key):
    let val = rt_record_find(record, key, "__dv_missing_field_sentinel__")
    if (val == "__dv_missing_field_sentinel__"):
        if (rt_record_index(record, key) < 0):
            rt_fail(rt_cat("Missing field: ", key))
    return val

fn dv_with(record, key, value):
    return rt_record_with(record, key, value)

fn dv_m2(k1, v1, k2, v2):
    return dv_pair(dv_pair(k1, v1), dv_pair(k2, v2))

fn dv_without(record, key):
    var result = []
    var i = 0
    while (i < rt_count(record)):
        var entry = record[i]
        if (entry[0] == key):
            false
        else:
            rt_push(result, dv_clone(entry))
        i = (i + 1)
    return result

fn dv_m3(k1, v1, k2, v2, k3, v3):
    return dv_with_many([], dv_list3(dv_pair(k1, v1), dv_pair(k2, v2), dv_pair(k3, v3)))

fn dv_m4(k1, v1, k2, v2, k3, v3, k4, v4):
    var updates = dv_list3(dv_pair(k1, v1), dv_pair(k2, v2), dv_pair(k3, v3))
    rt_push(updates, dv_pair(k4, v4))
    return dv_with_many([], updates)

fn dv_unit(x):
    dv_require(dv_and((not (x < 0)), (not (1 < x))), "Expected weight in [0,1]")
    return x

fn dv_unknown():
    return dv_with_many({"known": false, "value": false, "confidence": 0, "time": -1}, {"claims": [], "conflicted": false})

fn dv_min(a, b):
    if (a < b):
        return a
    else:
        return b

fn dv_max(a, b):
    if (a < b):
        return b
    else:
        return a

fn dv_cell(value, confidence, time, claims):
    return dv_with_many({"known": true, "value": dv_clone(value), "confidence": dv_unit(confidence), "time": time}, {"claims": [], "basis": claims, "conflicted": false})

fn dv_entity_ref(id):
    return {"type": "entity-ref", "id": id}

fn dv_ref(object_id, facet, field):
    return {"type": "ref", "object": object_id, "facet": facet, "field": field}

fn dv_scoped_ref(subject, object_id, facet, field):
    return dv_with(dv_ref(object_id, facet, field), "subject", subject)

fn dv_same_local_ref(subject, left, right):
    if dv_find(left, "subject", subject) != subject or dv_find(right, "subject", subject) != subject:
        return false
    return left.type == right.type and left.object == right.object and left.facet == right.facet and left.field == right.field

fn dv_world(id, domain, subject):
    dv_require(dv_or((domain == "physical"), (domain == "mind")), "Invalid world domain")
    var local_1 = false
    if (domain == "physical"):
        local_1 = (subject == "")
    else:
        local_1 = (0 < rt_length(subject))
    dv_require(local_1, "World subject mismatch")
    return dv_with_many({"id": id, "domain": domain, "subject": subject, "revision": 0}, {"objects": [], "adoptions": [], "history": [], "seen": []})

fn dv_domain(world, domain):
    return dv_require((world.domain == domain), "Wrong world domain")

fn dv_object(id, kind, facets):
    var local_1 = false
    if (kind == "perceived"):
        local_1 = dv_unknown()
    else:
        local_1 = dv_field(kind)
    return {"id": id, "kind": kind, "facets": dv_with(facets, "identity", dv_with(dv_find(facets, "identity", []), "kind", local_1))}

fn dv_add_object(world, object):
    var objects = world.objects
    var id = object.id
    dv_require((not dv_has_key(objects, id)), "Duplicate object identity")
    return dv_with_many(world, {"objects": dv_with(objects, id, object), "revision": (world.revision + 1)})

fn dv_read(world, ref):
    if dv_has_key(ref, "subject"):
        var subj = ref.subject
        if (not (subj == "")):
            dv_require((subj == world.subject), "Cross-subject reference access")
    var objects = world.objects
    var id = ref.object
    if dv_has_key(objects, id):
        var facets = dv_get(objects, id).facets
        var facet = ref.facet
        if dv_has_key(facets, facet):
            var fields = dv_get(facets, facet)
            var field_key = ref.field
            if dv_has_key(fields, field_key):
                return dv_clone(dv_get(fields, field_key))
            else:
                return dv_unknown()
        else:
            return dv_unknown()
    else:
        return dv_unknown()

fn dv_store(world, ref, cell):
    var objects = world.objects
    var id = ref.object
    dv_require(dv_has_key(objects, id), "Unknown object identity")
    var object = dv_get(objects, id)
    var facets = object.facets
    var facet = ref.facet
    var fields = dv_find(facets, facet, [])
    return dv_with_path(world, ["objects", id, "facets", facet, ref.field], 0, cell)

fn dv_slice(world, object_id, facet, fields):
    var result = []
    var i = 0
    while (i < rt_count(fields)):
        var field = fields[i]
        rt_push(result, dv_pair(field, dv_read(world, dv_ref(object_id, facet, field))))
        i = (i + 1)
    return dv_with_many({"world": world.id, "domain": world.domain, "subject": world.subject, "revision": world.revision}, {"object": object_id, "facet": facet, "fields": result})

fn dv_field(value):
    return dv_cell(value, 1, 0, [])

fn dv_uncontested(cell):
    return dv_and(cell.known, (not cell.conflicted))

fn dv_door(id, from, to, closed, held, inside, outside, automatic, gap):
    return dv_object(id, "door", {"link": {"from": dv_field(dv_entity_ref(from)), "to": dv_field(dv_entity_ref(to))}, "mechanical": dv_with_many({"closed": dv_field(closed), "held": dv_field(held), "inside_latch": dv_field(inside), "outside_latch": dv_field(outside)}, {"automatic": dv_field(automatic), "gap": dv_field(gap), "sealed": dv_field(false)})})

fn dv_channel(id, from, to, medium, enabled, gain, gate):
    dv_unit(gain)
    return dv_object(id, "channel", {"link": {"from": dv_field(dv_entity_ref(from)), "to": dv_field(dv_entity_ref(to)), "medium": dv_field(medium), "gate": dv_field(gate)}, "transport": {"enabled": dv_field(enabled), "gain": dv_field(gain), "bands": dv_field([])}})

fn dv_with_many(record, updates):
    return rt_record_with_many(record, updates)

// Copy the updated spine; unchanged branches use immutable snapshots.
// Validation of the world/ref remains in dv_store before this data operation.
fn dv_with_path(record, keys, depth, value):
    let key = keys[depth]
    var result = []
    var found = false
    var i = 0
    while i < rt_count(record):
        let entry = record[i]
        if entry[0] == key:
            var next = false
            if depth + 1 == rt_count(keys):
                next = dv_clone(value)
            else:
                next = dv_with_path(dv_get(record, key), keys, depth + 1, value)
            rt_push(result, dv_pair(dv_clone(entry[0]), next))
            found = true
        else:
            rt_push(result, rt_snapshot(entry))
        i = i + 1
    if not found:
        var next = false
        if depth + 1 == rt_count(keys):
            next = dv_clone(value)
        else:
            next = dv_with_path([], keys, depth + 1, value)
        rt_push(result, dv_pair(dv_clone(key), next))
    return result

// Private transaction builder: owned is a fresh dv_clone, never a published world.
// Only law stages and dv_update_mind may call this; observed cells are copied.
fn dv_stage_store_owned(owned, ref, cell):
    let objects = owned.objects
    dv_require(dv_has_key(objects, ref.object), "Unknown object identity")
    let object = dv_get(objects, ref.object)
    let facets = object.facets
    let fields = dv_find(facets, ref.facet, [])
    let updated = dv_with(object, "facets", dv_with(facets, ref.facet, dv_with(fields, ref.field, cell)))
    var i = 0
    while i < rt_count(objects):
        if objects[i][0] == ref.object:
            rt_replace(objects, i, dv_pair(dv_clone(objects[i][0]), dv_clone(updated)))
        i = i + 1
    return owned

// --- merged from 10-laws.dv ---

// Law schema is data. Adoption in each world determines how the schema is used.

fn dv_true():
    return {"op": "constant", "value": "true"}

fn dv_fact(ref, expected):
    return {"op": "equals", "ref": ref, "value": expected}

fn dv_at_least(ref, minimum):
    return {"op": "at_least", "ref": ref, "value": minimum}

fn dv_all(conditions):
    return {"op": "all", "items": conditions}

fn dv_not(condition):
    return {"op": "not", "item": condition}

fn dv_truth(world, proposition):
    let key = ["dv_truth", proposition]
    let cached = rt_memo_get(world, key)
    if cached[0]:
        return cached[1]
    return rt_memo_put(world, key, dv_truth_uncached(world, proposition))

fn dv_truth_uncached(world, proposition):
    var op = proposition.op
    if (op == "constant"):
        return proposition.value
    else:
        if (op == "not"):
            var inner = dv_truth(world, proposition.item)
            if (inner == "unknown"):
                return "unknown"
            else:
                if (inner == "true"):
                    return "false"
                else:
                    return "true"
        else:
            if (op == "all"):
                var items = proposition.items
                var i = 0
                var result = "true"
                while (i < rt_count(items)):
                    var truth = dv_truth(world, items[i])
                    if (truth == "false"):
                        result = "false"
                    else:
                        if dv_and((truth == "unknown"), (result == "true")):
                            result = "unknown"
                    i = (i + 1)
                return result
            else:
                var cell = dv_read(world, proposition.ref)
                if dv_or((not cell.known), cell.conflicted):
                    return "unknown"
                else:
                    if (op == "equals"):
                        if dv_same(cell.value, proposition.value):
                            return "true"
                        else:
                            return "false"
                    else:
                        if (op == "at_least"):
                            if (cell.value < proposition.value):
                                return "false"
                            else:
                                return "true"
                        else:
                            return rt_fail("Unknown proposition operator")

fn dv_assign(ref, value):
    return {"op": "assign", "ref": ref, "value": value}

fn dv_increment(ref, amount):
    return {"op": "increment", "ref": ref, "value": amount}

fn dv_axiom(name, version, premise, effects):
    return {"name": name, "version": version, "premise": dv_clone(premise), "effects": dv_clone(effects)}

fn dv_instance(id, law):
    return dv_with_many(law, {"schema": law.name, "name": id})

fn dv_checked_adoption(domain, adoptions, law, mode, confidence, basis):
    dv_unit(confidence)
    var local_1 = false
    if (domain == "physical"):
        local_1 = (confidence == 1)
    else:
        local_1 = true
    dv_require(local_1, "Physical laws require certainty")
    dv_require((0 < rt_count(basis)), "Adoption needs a basis")
    dv_require((not dv_has_key(adoptions, law.name)), "Duplicate law instance: provide a distinct instance identity")
    var local_2 = false
    if (domain == "physical"):
        local_2 = (mode == "enforce")
    else:
        local_2 = dv_and((domain == "mind"), dv_or((mode == "predict"), dv_or((mode == "infer"), (mode == "norm"))))
    dv_require(local_2, "Adoption mode is incompatible with world")
    return dv_with({"law": law, "mode": mode, "confidence": confidence, "basis": basis}, "active", true)

fn dv_adopt(world, law, mode, confidence, basis):
    let adoption = dv_checked_adoption(world.domain, world.adoptions, law, mode, confidence, basis)
    return dv_with_many(world, {"adoptions": dv_with(world.adoptions, law.name, adoption), "revision": (world.revision + 1)})

// Initialization-only builder: owned_adoptions is a private clone, never a world field.
fn dv_adopt_into(domain, owned_adoptions, law, mode, confidence, basis):
    let adoption = dv_checked_adoption(domain, owned_adoptions, law, mode, confidence, basis)
    rt_push(owned_adoptions, dv_pair(law.name, adoption))
    return true

fn dv_finish_owned_adoptions(world, owned_adoptions):
    let previous_count = rt_count(world.adoptions)
    dv_require(previous_count <= rt_count(owned_adoptions), "Adoption builder removed inherited entries")
    var i = 0
    while i < previous_count:
        dv_require(dv_same(world.adoptions[i], owned_adoptions[i]), "Adoption builder changed inherited entries")
        i = i + 1
    if previous_count == rt_count(owned_adoptions):
        return world
    return dv_with_many(world, {"adoptions": owned_adoptions, "revision": world.revision + rt_count(owned_adoptions) - previous_count})

fn dv_suspend(world, name):
    var adoptions = world.adoptions
    return dv_with_many(world, {"adoptions": dv_with(adoptions, name, dv_with(dv_get(adoptions, name), "active", false)), "revision": (world.revision + 1)})

fn dv_reconsider(world, law, mode, confidence, basis):
    var name = law.name
    var previous = dv_get(world.adoptions, name)
    var updated = dv_adopt(dv_with(world, "adoptions", dv_without(world.adoptions, name)), law, mode, confidence, basis)
    return dv_with(updated, "history", dv_append(world.history, {"kind": "reconsideration", "previous": previous, "current": dv_get(updated.adoptions, name), "basis": basis}))

fn dv_premise_confidence(world, proposition):
    var op = proposition.op
    if (op == "constant"):
        return 1
    else:
        if (op == "not"):
            return dv_premise_confidence(world, proposition.item)
        else:
            if (op == "all"):
                var items = proposition.items
                var i = 0
                var confidence = 1
                while (i < rt_count(items)):
                    confidence = dv_min(confidence, dv_premise_confidence(world, items[i]))
                    i = (i + 1)
                return confidence
            else:
                return dv_read(world, proposition.ref).confidence

fn dv_result(status, world, changes, basis):
    return {"status": status, "world": dv_clone(world), "changes": changes, "basis": basis}

fn dv_stage(world, effects, time, basis, confidence):
    var stage = dv_clone(world)
    var changes = []
    var touched = []
    var i = 0
    var status = "ready"
    while dv_and((status == "ready"), (i < rt_count(effects))):
        var effect = effects[i]
        var ref = effect.ref
        var op = effect.op
        var before = dv_read(stage, ref)
        if (not dv_has_key(stage.objects, ref.object)):
            status = "unknown-object"
        else:
            if dv_has(touched, ref):
                status = "duplicate-write"
            else:
                if dv_and((op == "increment"), dv_or((not before.known), before.conflicted)):
                    status = "conflicted-state"
                else:
                    dv_require(dv_or((op == "assign"), (op == "increment")), "Unknown effect operator")
                    var local_1 = false
                    if (op == "assign"):
                        local_1 = effect.value
                    else:
                        local_1 = (before.value + effect.value)
                    var value = local_1
                    stage = dv_stage_store_owned(stage, ref, dv_cell(value, confidence, time, basis))
                    rt_push(changes, {"ref": ref, "before": before, "after": dv_read(stage, ref)})
                    rt_push(touched, dv_clone(ref))
        i = (i + 1)
    if (status == "ready"):
        return {"status": "ready", "world": stage, "changes": changes, "basis": basis}
    else:
        return dv_result(status, world, [], basis)

fn dv_infer_stage(world, effects, time, basis, confidence, law_name, event_id):
    var stage = dv_clone(world)
    var changes = []
    var touched = []
    var i = 0
    var status = "ready"
    var profile = dv_find(world, "profile", dv_observation_profile({"perception": 1, "testimony": 1, "recall": 1, "inference": 1}, 0.5))
    while dv_and((status == "ready"), (i < rt_count(effects))):
        var effect = effects[i]
        var ref = effect.ref
        var op = effect.op
        var before = dv_read(stage, ref)
        if (not dv_has_key(stage.objects, ref.object)):
            status = "unknown-object"
        else:
            if dv_has(touched, ref):
                status = "duplicate-write"
            else:
                if dv_and((op == "increment"), dv_or((not before.known), before.conflicted)):
                    status = "conflicted-state"
                else:
                    dv_require(dv_or((op == "assign"), (op == "increment")), "Unknown effect operator")
                    var local_1 = false
                    if (op == "assign"):
                        local_1 = effect.value
                    else:
                        local_1 = (before.value + effect.value)
                    var value = local_1
                    var claim = dv_with_many({"id": dv_list3(event_id, law_name, ref), "subject": stage.subject, "ref": ref, "value": dv_clone(value)}, {"source": "inference", "origin": law_name, "time": time, "trust": confidence, "dependency": dv_list3("inference", law_name, ref)})
                    var old_claims = before.claims
                    var local_2 = false
                    if dv_and(before.known, (rt_count(old_claims) == 0)):
                        local_2 = dv_single(dv_with_many({"id": dv_pair("initial", ref), "subject": stage.subject, "ref": ref, "value": before.value}, {"source": "initial", "origin": "initial", "time": before.time, "trust": before.confidence, "dependency": dv_pair("initial", ref)}))
                    else:
                        local_2 = old_claims
                    var claims = local_2
                    var new_claims = dv_replace_claim(claims, claim)
                    var new_cell = dv_aggregate(new_claims, profile, time)
                    stage = dv_stage_store_owned(stage, ref, new_cell)
                    rt_push(changes, {"ref": ref, "before": before, "after": dv_read(stage, ref)})
                    rt_push(touched, dv_clone(ref))
        i = (i + 1)
    if (status == "ready"):
        return {"status": "ready", "world": stage, "changes": changes, "basis": basis}
    else:
        return dv_result(status, world, [], basis)

fn dv_apply_law(world, name, mode, event_id, time, expected_revision):
    dv_require((world.revision == expected_revision), "Stale world revision")
    dv_require((not dv_has(world.seen, event_id)), "Repeated world event")
    dv_require((not (time < dv_find(world, "time", 0))), "World time cannot move backwards")
    var adoption = dv_get(world.adoptions, name)
    var law = adoption.law
    var basis = adoption.basis
    if (not adoption.active):
        return dv_result("not-adopted", world, [], basis)
    else:
        if (not (adoption.mode == mode)):
            return dv_result("wrong-adoption-mode", world, [], basis)
        else:
            var truth = dv_truth(world, law.premise)
            if (not (truth == "true")):
                return dv_result(rt_cat("premise-", truth), world, [], basis)
            else:
                var local_1 = false
                if (mode == "infer"):
                    var infer_confidence = dv_min(dv_premise_confidence(world, law.premise), adoption.confidence)
                    local_1 = dv_infer_stage(world, law.effects, time, basis, infer_confidence, name, event_id)
                else:
                    local_1 = dv_stage(world, law.effects, time, basis, adoption.confidence)
                var staged = local_1
                if (not (staged.status == "ready")):
                    return staged
                else:
                    var next = staged.world
                    var revision = (expected_revision + 1)
                    var event = dv_with_many({"id": event_id, "time": time, "law": name, "law_version": law.version}, {"changes": staged.changes, "basis": basis})
                    rt_push(next.seen, dv_clone(event_id))
                    rt_push(next.history, event)
                    next = dv_with_many(next, {"revision": revision, "time": time})
                    return {"status": "applied", "world": next, "changes": dv_clone(staged.changes), "basis": dv_clone(basis), "event": event_id, "time": time}

fn dv_execute(physical, name, event_id, time, expected_revision):
    dv_domain(physical, "physical")
    return dv_apply_law(physical, name, "enforce", event_id, time, expected_revision)

fn dv_predict(mind, name, event_id, time, expected_revision):
    dv_domain(mind, "mind")
    var result = dv_apply_law(mind, name, "predict", event_id, time, expected_revision)
    return dv_with_many(result, {"world": dv_with_many(result.world, {"domain": "prediction", "source_revision": expected_revision}), "source_revision": expected_revision})

fn dv_infer(mind, name, event_id, time, expected_revision):
    dv_domain(mind, "mind")
    return dv_apply_law(mind, name, "infer", event_id, time, expected_revision)

fn dv_norm(mind, name):
    dv_domain(mind, "mind")
    var adoption = dv_get(mind.adoptions, name)
    dv_require((adoption.mode == "norm"), "Not a normative adoption")
    if adoption.active:
        return dv_truth(mind, adoption.law.premise)
    else:
        return "unknown"

// --- merged from 60-object-laws.dv ---

// Generic operational axioms. No chapter identities, answers or authored dialogue.

axiom door_open(door):
    return dv_axiom("door_open", 1, dv_all(dv_pair(dv_fact(dv_ref(door, "mechanical", "inside_latch"), false), dv_fact(dv_ref(door, "mechanical", "outside_latch"), false))), dv_single(dv_assign(dv_ref(door, "mechanical", "closed"), false)))

axiom door_self_close(door):
    return dv_axiom("door_self_close", 1, dv_all(dv_pair(dv_fact(dv_ref(door, "mechanical", "automatic"), true), dv_fact(dv_ref(door, "mechanical", "held"), false))), dv_pair(dv_assign(dv_ref(door, "mechanical", "closed"), true), dv_assign(dv_ref(door, "mechanical", "gap"), 0)))

axiom door_latch(door):
    return dv_axiom("door_latch", 1, dv_fact(dv_ref(door, "mechanical", "closed"), true), dv_single(dv_assign(dv_ref(door, "mechanical", "inside_latch"), true)))

axiom door_seal(door):
    return dv_axiom("door_seal", 1, dv_fact(dv_ref(door, "mechanical", "closed"), true), dv_single(dv_assign(dv_ref(door, "mechanical", "sealed"), true)))

axiom channel_reconfigure(channel, gain):
    return dv_axiom("channel_reconfigure", 1, dv_true(), dv_single(dv_assign(dv_ref(channel, "transport", "gain"), dv_unit(gain))))

axiom channel_flow(channel):
    return dv_axiom("channel_flow", 1, dv_fact(dv_ref(channel, "transport", "enabled"), true), [])
// Observation adaptation is an explicit trusted boundary. Minds receive no world pointer.

fn dv_binding(physical, local, subject):
    return {"physical": physical, "local": local, "subject": subject}

// Subject-specific index over the exact binding value. Ambiguity remains a
// lookup error only for the requested physical identity, as with the linear scan.
fn dv_local(bindings, physical, subject):
    let lookup_key = [rt_cat("projection-local:", subject), physical]
    let lookup = rt_memo_get(bindings, lookup_key)
    if lookup[0]:
        dv_require(not lookup[1].ambiguous, "Ambiguous projection binding")
        return lookup[1].local
    let key = ["projection-index", subject]
    let cached = rt_memo_get(bindings, key)
    var index = []
    if cached[0]:
        index = cached[1]
    else:
        var i = 0
        while i < rt_count(bindings):
            let binding = bindings[i]
            if binding.subject == subject:
                let previous = dv_find(index, binding.physical, {"local": "", "ambiguous": false})
                let entry = {"local": binding.local, "ambiguous": previous.ambiguous or previous.local != ""}
                let slot = rt_record_index(index, binding.physical)
                if slot < 0:
                    rt_push(index, dv_pair(binding.physical, entry))
                else:
                    rt_replace(index, slot, dv_pair(binding.physical, entry))
            i = i + 1
        rt_memo_put(bindings, key, index)
    let found = dv_find(index, physical, {"local": "", "ambiguous": false})
    rt_memo_put(bindings, lookup_key, found)
    dv_require(not found.ambiguous, "Ambiguous projection binding")
    return found.local

fn dv_validate_bindings(bindings, subject):
    let key = ["validated-projection", subject]
    if rt_memo_get(bindings, key)[0]:
        return true
    var i = 0
    var locals = []
    var physicals = []
    while (i < rt_count(bindings)):
        var b = bindings[i]
        if (b.subject == subject):
            dv_require((0 < rt_length(b.local)), "Empty local identity")
            dv_require((not dv_has(locals, b.local)), "Local projection cannot bind two objects")
            dv_require((not dv_has(physicals, b.physical)), "Ambiguous physical binding")
            rt_push(locals, b.local)
            rt_push(physicals, b.physical)
        i = (i + 1)
    return rt_memo_put(bindings, key, true)

fn dv_project_value(value, bindings, subject):
    if rt_is_list(value):
        if dv_record_like(value):
            if dv_same(dv_find(value, "type", ""), "entity-ref"):
                var local = dv_local(bindings, value.id, subject)
                if (local == ""):
                    return {"known": false, "value": false}
                else:
                    return {"known": true, "value": dv_entity_ref(local)}
            else:
                if dv_or(dv_same(dv_find(value, "type", ""), "ref"), dv_and(dv_has_key(value, "object"), dv_and(dv_has_key(value, "facet"), dv_has_key(value, "field")))):
                    var local = dv_local(bindings, value.object, subject)
                    if (local == ""):
                        return {"known": false, "value": false}
                    else:
                        return {"known": true, "value": dv_scoped_ref(subject, local, value.facet, value.field)}
                else:
                    if dv_has_key(value, "op"):
                        var op = value.op
                        if (op == "constant"):
                            return {"known": true, "value": value}
                        else:
                            if dv_or((op == "equals"), (op == "at_least")):
                                var p_ref = dv_project_value(value.ref, bindings, subject)
                                var p_val = dv_project_value(value.value, bindings, subject)
                                if dv_and(p_ref.known, p_val.known):
                                    return {"known": true, "value": dv_with_many(value, {"ref": p_ref.value, "value": p_val.value})}
                                else:
                                    return {"known": false, "value": false}
                            else:
                                if (op == "not"):
                                    var p_item = dv_project_value(value.item, bindings, subject)
                                    if p_item.known:
                                        return {"known": true, "value": dv_with(value, "item", p_item.value)}
                                    else:
                                        return {"known": false, "value": false}
                                else:
                                    if (op == "all"):
                                        var items = value.items
                                        var i = 0
                                        var p_items = []
                                        var all_known = true
                                        while (i < rt_count(items)):
                                            var p_sub = dv_project_value(items[i], bindings, subject)
                                            all_known = dv_and(all_known, p_sub.known)
                                            rt_push(p_items, p_sub.value)
                                            i = (i + 1)
                                        if all_known:
                                            return {"known": true, "value": dv_with(value, "items", p_items)}
                                        else:
                                            return {"known": false, "value": false}
                                    else:
                                        return {"known": false, "value": false}
                    else:
                        var i = 0
                        var items = []
                        var known = true
                        while (i < rt_count(value)):
                            var projected = dv_project_value(value[i], bindings, subject)
                            known = dv_and(known, projected.known)
                            rt_push(items, projected.value)
                            i = (i + 1)
                        return {"known": known, "value": items}
        else:
            var i = 0
            var items = []
            var known = true
            while (i < rt_count(value)):
                var projected = dv_project_value(value[i], bindings, subject)
                known = dv_and(known, projected.known)
                rt_push(items, projected.value)
                i = (i + 1)
            return {"known": known, "value": items}
    else:
        return {"known": true, "value": value}

fn dv_observation(id, subject, ref, value, source, origin, time, trust, dependency):
    dv_unit(trust)
    dv_require((not (time < 0)), "Negative observation time")
    dv_require(dv_has(dv_append(dv_list3("perception", "testimony", "recall"), dv_pair("inference", "initial")), source), "Observations use perception, testimony, recall, inference or initial")
    return dv_with_many({"id": id, "subject": subject, "ref": ref, "value": dv_clone(value)}, {"source": source, "origin": origin, "time": time, "trust": trust, "dependency": dependency})

fn dv_perceive(physical, mind, bindings, grants, event_id, time):
    dv_domain(physical, "physical")
    dv_domain(mind, "mind")
    dv_validate_bindings(bindings, mind.subject)
    var observations = []
    var i = 0
    var subject = mind.subject
    while (i < rt_count(grants)):
        var ref = grants[i]
        var local = dv_local(bindings, ref.object, subject)
        var cell = dv_read(physical, ref)
        if dv_and((not (local == "")), cell.known):
            var mapped = dv_project_value(cell.value, bindings, subject)
            var local_ref = dv_scoped_ref(subject, local, ref.facet, ref.field)
            if mapped.known:
                rt_push(observations, dv_with(dv_observation(dv_list3(event_id, subject, local_ref), subject, local_ref, mapped.value, "perception", "direct", time, 1, dv_pair(event_id, local_ref)), "world_version", {"id": physical.id, "revision": physical.revision}))
        i = (i + 1)
    return observations

fn dv_perceive_changes(receipt, mind, bindings, grants):
    dv_require((receipt.status == "applied"), "Only applied world changes can be perceived")
    var changes = receipt.changes
    var exposed = []
    var i = 0
    while (i < rt_count(changes)):
        var ref = changes[i].ref
        if dv_has(grants, ref):
            rt_push(exposed, ref)
        i = (i + 1)
    return dv_perceive(receipt.world, mind, bindings, exposed, receipt.event, receipt.time)

fn dv_observation_profile(source_weights, threshold):
    return {"weights": source_weights, "threshold": dv_unit(threshold)}

fn dv_weight(observation, profile):
    var weights = profile.weights
    var source = observation.source
    var weight = dv_find(weights, source, 1)
    dv_require((not (weight < 0)), "Negative evidence weight")
    return (weight * dv_unit(observation.trust))

fn dv_replace_claim(claims, observation):
    var result = []
    var i = 0
    while (i < rt_count(claims)):
        var old = claims[i]
        if dv_same(old.dependency, observation.dependency):
            false
        else:
            rt_push(result, dv_clone(old))
        i = (i + 1)
    rt_push(result, dv_clone(observation))
    return result

fn dv_aggregate(claims, profile, time):
    var alternatives = []
    var i = 0
    var total = 0
    var best = 0
    var chosen = false
    var best_rel = 0
    while (i < rt_count(claims)):
        var claim = claims[i]
        var weight = dv_weight(claim, profile)
        var value = claim.value
        var j = 0
        var found = false
        var new_items = []
        while (j < rt_count(alternatives)):
            var alternative = alternatives[j]
            if dv_same(alternative[0], value):
                rt_push(new_items, dv_list3(value, (alternative[1] + weight), dv_max(alternative[2], dv_unit(claim.trust))))
                found = true
            else:
                rt_push(new_items, alternative)
            j = (j + 1)
        if dv_or(found, (weight == 0)):
            false
        else:
            rt_push(new_items, dv_list3(value, weight, dv_unit(claim.trust)))
        alternatives = new_items
        total = (total + weight)
        i = (i + 1)
    i = 0
    var distribution = []
    while (i < rt_count(alternatives)):
        var alternative = alternatives[i]
        var weight = alternative[1]
        var rel = alternative[2]
        if (best < weight):
            best = weight
            chosen = alternative[0]
            best_rel = rel
        var local_1 = false
        if (total == 0):
            local_1 = 0
        else:
            local_1 = (weight / total)
        rt_push(distribution, dv_pair(alternative[0], local_1))
        i = (i + 1)
    var local_2 = false
    if (total == 0):
        local_2 = 0
    else:
        local_2 = (best / total)
    var support_share = local_2
    // Agreement measures support, not source independence. Repeating uncertain
    // evidence cannot establish certainty without an independent model of it.
    var epistemic_confidence = (support_share * best_rel)
    var cell = dv_cell(chosen, epistemic_confidence, time, claims)
    return dv_with_many(cell, {"known": dv_and((0 < total), (not (epistemic_confidence < profile.threshold))), "conflicted": (1 < rt_count(alternatives)), "claims": claims, "alternatives": distribution, "support_share": support_share, "source_reliability": best_rel})

fn dv_update_mind(mind, observations, expected_revision, profile):
    dv_domain(mind, "mind")
    dv_require((mind.revision == expected_revision), "Stale cognition revision")
    var next = dv_clone(mind)
    var i = 0
    var accepted = []
    var dispositions = []
    var latest_time = dv_find(mind, "time", 0)
    while (i < rt_count(observations)):
        var observation = observations[i]
        var id = observation.id
        var ref = observation.ref
        var object_id = ref.object
        dv_require((observation.subject == mind.subject), "Foreign observation")
        dv_require((not dv_has(next.seen, id)), "Repeated observation")
        dv_weight(observation, profile)
        if dv_has_key(next.objects, object_id):
            false
        else:
            next = dv_add_object(next, dv_object(object_id, "perceived", []))
        var old = dv_read(next, ref)
        var time = observation.time
        latest_time = dv_max(latest_time, time)
        if (time < old.time):
            rt_push(dispositions, dv_pair(id, "older-than-current"))
        else:
            var is_perception = (observation.source == "perception")
            let version = dv_find(observation, "world_version", false)
            let previous_version = dv_find(old, "world_version", false)
            var later_version = false
            if (version != false and previous_version != false):
                later_version = (version.id == previous_version.id and previous_version.revision < version.revision)
            let replaces_current = is_perception and (old.time < time or later_version)
            var local_1 = false
            if replaces_current:
                local_1 = []
            else:
                local_1 = old.claims
            var claims = local_1
            if dv_and(old.known, (rt_count(claims) == 0)):
                if (not replaces_current):
                    claims = dv_single(dv_with_many({"id": dv_pair("initial", ref), "subject": next.subject, "ref": ref, "value": old.value}, {"source": "initial", "origin": "initial", "time": old.time, "trust": old.confidence, "dependency": dv_pair("initial", ref)}))
            var new_time = dv_max(old.time, time)
            var updated = dv_aggregate(dv_replace_claim(claims, observation), profile, new_time)
            if (is_perception and version != false):
                updated = dv_with(updated, "world_version", version)
            else:
                if (previous_version != false):
                    updated = dv_with(updated, "world_version", previous_version)
            next = dv_stage_store_owned(next, ref, updated)
            rt_push(dispositions, dv_pair(id, "updated"))
        rt_push(next.seen, dv_clone(id))
        rt_push(accepted, dv_clone(observation))
        i = (i + 1)
    var local_2 = false
    if (rt_count(observations) == 0):
        local_2 = expected_revision
    else:
        local_2 = (expected_revision + 1)
    rt_push(next.history, {"kind": "observation-batch", "observations": accepted, "dispositions": dispositions})
    next = dv_with_many(next, {"time": latest_time, "revision": local_2})
    return {"world": next, "dispositions": dispositions, "revision": next.revision}

// --- merged from 30-transport.dv ---

// Signals are segmented by the author/host. No hidden reconstruction of lost words.

fn dv_segment(content, strength, band):
    return {"content": content, "strength": strength, "band": band}

fn dv_signal(location, medium, segments):
    return {"location": dv_entity_ref(location), "medium": medium, "segments": segments}

fn dv_filter_signal(segments, gain, threshold, bands):
    var result = []
    var i = 0
    while (i < rt_count(segments)):
        var segment = segments[i]
        var strength = (segment.strength * gain)
        if dv_and((not (strength < threshold)), dv_or((rt_count(bands) == 0), dv_has(bands, segment.band))):
            rt_push(result, dv_segment(segment.content, strength, segment.band))
        i = (i + 1)
    return result

fn dv_transport(world, path, signal, threshold):
    dv_require((not (threshold < 0)), "Negative perception threshold")
    var i = 0
    var location = signal.location
    var segments = dv_clone(signal.segments)
    var status = "delivered"
    var trace = []
    while dv_and((status == "delivered"), (i < rt_count(path))):
        var channel = path[i]
        var objects = world.objects
        dv_require(dv_has_key(objects, channel), "Unknown channel")
        dv_require((dv_truth(world, dv_fact(dv_ref(channel, "identity", "kind"), "channel")) == "true"), "Transport object must be known as a channel")
        var from = dv_read(world, dv_ref(channel, "link", "from"))
        var to = dv_read(world, dv_ref(channel, "link", "to"))
        var medium = dv_read(world, dv_ref(channel, "link", "medium"))
        var gate = dv_read(world, dv_ref(channel, "link", "gate"))
        var enabled = dv_read(world, dv_ref(channel, "transport", "enabled"))
        var gain = dv_read(world, dv_ref(channel, "transport", "gain"))
        if dv_and(dv_and(dv_uncontested(from), dv_uncontested(to)), dv_and(dv_and(dv_uncontested(medium), dv_uncontested(gate)), dv_and(dv_uncontested(enabled), dv_uncontested(gain)))):
            dv_require(dv_same(location, from.value), "Discontinuous channel path")
            dv_require((signal.medium == medium.value), "Channel medium mismatch")
            var gate_truth = dv_truth(world, gate.value)
            if dv_and(enabled.value, (gate_truth == "true")):
                var bands_cell = dv_read(world, dv_ref(channel, "transport", "bands"))
                if dv_uncontested(bands_cell):
                    segments = dv_filter_signal(segments, dv_unit(gain.value), threshold, bands_cell.value)
                    location = to.value
                    rt_push(trace, channel)
                else:
                    status = "unknown"
            else:
                var local_1 = false
                if (gate_truth == "unknown"):
                    local_1 = "unknown"
                else:
                    local_1 = "blocked"
                status = local_1
        else:
            status = "unknown"
        i = (i + 1)
    var local_2 = false
    if (status == "delivered"):
        local_2 = segments
    else:
        local_2 = []
    return dv_with({"status": status, "location": location, "segments": local_2, "trace": trace}, "world_revision", world.revision)

fn dv_hear(delivery, subject, local_ref, perceived_origin, event_id, time):
    dv_require((delivery.status == "delivered"), "No delivered signal")
    dv_require((dv_find(delivery, "hypothetical", true) == false), "Predicted or unauthorised transmission cannot become perception")
    return dv_observation(event_id, subject, local_ref, delivery.segments, "perception", perceived_origin, time, 1, event_id)

fn dv_transport_theory(law):
    return dv_with(law, "operation", "attenuate-filter")

fn dv_transmit(world, law_name, path, signal, threshold):
    var adoption = dv_get(world.adoptions, law_name)
    var law = adoption.law
    dv_require(adoption.active, "Transmission law is not active")
    dv_require((law.operation == "attenuate-filter"), "Not a transport theory")
    var local_1 = false
    if (world.domain == "physical"):
        local_1 = (adoption.mode == "enforce")
    else:
        local_1 = dv_and((world.domain == "mind"), (adoption.mode == "predict"))
    dv_require(local_1, "Wrong transmission adoption")
    dv_require((dv_truth(world, law.premise) == "true"), "Transmission premise is not established")
    return dv_with_many(dv_transport(world, path, signal, threshold), {"basis": adoption.basis, "hypothetical": (not (world.domain == "physical"))})
// Value is computed against an explicit rubric, not a truth or legality judgement.

fn dv_criterion(id, ref, mode, target, weight):
    dv_require(dv_or((mode == "numeric"), (mode == "matches")), "Unsupported value criterion")
    return dv_with({"id": id, "ref": ref, "mode": mode, "target": target}, "weight", weight)

fn dv_measure(value, criterion):
    if (criterion.mode == "numeric"):
        return (value * criterion.weight)
    else:
        if dv_same(value, criterion.target):
            return criterion.weight
        else:
            return 0

fn dv_expected_measure(cell, criterion):
    var alternatives = dv_find(cell, "alternatives", [])
    var sum = 0
    var i = 0
    if (rt_count(alternatives) == 0):
        return (dv_measure(cell.value, criterion) * cell.confidence)
    else:
        while (i < rt_count(alternatives)):
            var alternative = alternatives[i]
            sum = (sum + (dv_measure(alternative[0], criterion) * alternative[1]))
            i = (i + 1)
        return (sum * cell.confidence)

fn dv_value(world, criteria, subjective):
    var i = 0
    var score = 0
    var details = []
    var unknown = []
    var ids = []
    while (i < rt_count(criteria)):
        var criterion = criteria[i]
        var id = criterion.id
        var cell = dv_read(world, criterion.ref)
        dv_require((not dv_has(ids, id)), "Duplicate value criterion")
        rt_push(ids, id)
        if cell.known:
            var local_1 = false
            if subjective:
                local_1 = dv_expected_measure(cell, criterion)
            else:
                local_1 = dv_measure(cell.value, criterion)
            var amount = local_1
            score = (score + amount)
            rt_push(details, {"criterion": id, "contribution": amount, "confidence": cell.confidence, "conflicted": cell.conflicted})
        else:
            rt_push(unknown, id)
        i = (i + 1)
    return dv_with_many({"score": score, "details": details, "unknown": unknown, "complete": (rt_count(unknown) == 0)}, {"world": world.id, "revision": world.revision, "subject": world.subject})

fn dv_value_subjective(mind, criteria):
    dv_require(dv_or((mind.domain == "mind"), (mind.domain == "prediction")), "Subjective value requires a mind or prediction")
    return dv_value(mind, criteria, true)

fn dv_value_objective(physical, criteria):
    dv_domain(physical, "physical")
    return dv_value(physical, criteria, false)

fn dv_value_change(before, after, criteria):
    dv_require(dv_and((before.id == after.id), (before.subject == after.subject)), "Value comparison crosses worlds")
    var subjective = (not (before.domain == "physical"))
    var local_1 = false
    if subjective:
        local_1 = dv_and((before.domain == "mind"), dv_or((after.domain == "mind"), (after.domain == "prediction")))
    else:
        local_1 = (after.domain == "physical")
    dv_require(local_1, "Value domain mismatch")
    var a = dv_value(before, criteria, subjective)
    var b = dv_value(after, criteria, subjective)
    return {"delta": (b.score - a.score), "before": a, "after": b, "complete": dv_and(a.complete, b.complete)}

// --- merged from 50-response.dv ---

// Appraisal-inspired game mechanism, not a clinical or psychometric model.
// Intent, instrumental value and expression are separate outputs.

fn dv_request(id, requester, self):
    return {"id": id, "requester": requester, "self": self}

fn dv_feature_refs(request):
    var speaker = request.requester
    var self = request.self
    var id = request.id
    var refs = []
    rt_push(refs, dv_pair("trust", dv_ref(speaker, "relationship", "trust")))
    rt_push(refs, dv_pair("closeness", dv_ref(speaker, "relationship", "closeness")))
    rt_push(refs, dv_pair("respect", dv_ref(speaker, "relationship", "respect")))
    rt_push(refs, dv_pair("reciprocity", dv_ref(speaker, "relationship", "reciprocity")))
    rt_push(refs, dv_pair("valence", dv_ref(self, "affect", "valence")))
    rt_push(refs, dv_pair("arousal", dv_ref(self, "affect", "arousal")))
    rt_push(refs, dv_pair("fatigue", dv_ref(self, "resources", "fatigue")))
    rt_push(refs, dv_pair("stress", dv_ref(self, "resources", "stress")))
    rt_push(refs, dv_pair("attention", dv_ref(self, "resources", "attention")))
    rt_push(refs, dv_pair("threat", dv_ref(id, "appraisal", "threat")))
    rt_push(refs, dv_pair("fairness", dv_ref(id, "appraisal", "fairness")))
    rt_push(refs, dv_pair("control", dv_ref(id, "appraisal", "control")))
    rt_push(refs, dv_pair("certainty", dv_ref(id, "appraisal", "certainty")))
    rt_push(refs, dv_pair("importance", dv_ref(id, "appraisal", "importance")))
    return refs

fn dv_appraise_request(mind, request):
    dv_domain(mind, "mind")
    var refs = dv_feature_refs(request)
    var features = []
    var unknown = []
    var basis = []
    var i = 0
    while (i < rt_count(refs)):
        var entry = refs[i]
        var key = entry[0]
        var cell = dv_read(mind, entry[1])
        if dv_and(cell.known, (not cell.conflicted)):
            rt_push(features, dv_pair(key, cell.value))
            rt_push(basis, {"feature": key, "ref": entry[1], "cell": cell})
        else:
            rt_push(unknown, key)
        i = (i + 1)
    return dv_with_many({"features": features, "unknown": unknown, "basis": basis, "revision": mind.revision}, {"subject": mind.subject, "request": request.id})

fn dv_dot(features, weights):
    var i = 0
    var score = 0
    var terms = []
    var unknown = []
    while (i < rt_count(weights)):
        var entry = weights[i]
        var key = entry[0]
        if dv_has_key(features, key):
            var contribution = (dv_get(features, key) * entry[1])
            score = (score + contribution)
            rt_push(terms, dv_pair(key, contribution))
        else:
            rt_push(unknown, key)
        i = (i + 1)
    return {"score": score, "terms": terms, "unknown": unknown}

fn dv_clamp_signed(value):
    if (value < -1):
        return -1
    else:
        if (1 < value):
            return 1
        else:
            return value

fn dv_expression(appraisal, expression_policy):
    var axes = []
    var i = 0
    while (i < rt_count(expression_policy)):
        var axis = expression_policy[i]
        var evaluation = dv_dot(appraisal.features, axis[1])
        rt_push(axes, dv_pair(axis[0], dv_with_many(evaluation, {"value": dv_clamp_signed(evaluation.score), "complete": (rt_count(evaluation.unknown) == 0)})))
        i = (i + 1)
    return axes

fn dv_no_change_prediction(mind):
    dv_domain(mind, "mind")
    return dv_with_many(mind, {"domain": "prediction", "source_revision": mind.revision})

fn dv_response_option(id, intent, feasible, prediction, effort, feature_weights):
    dv_require((not (effort < 0)), "Negative effort")
    return dv_with_many({"id": id, "intent": intent, "feasible": feasible, "prediction": prediction}, {"effort": effort, "feature_weights": feature_weights})

fn dv_validate_expression_policy(expression_policy):
    dv_require(dv_record_like(expression_policy), "Expression policy must be an axis-to-weight-record matrix")
    var i = 0
    while (i < rt_count(expression_policy)):
        var axis = expression_policy[i]
        var key = expression_policy[i][0]
        var weights = expression_policy[i][1]
        var j = 0
        dv_require((rt_slice(rt_json_stringify(key), 0, 1) == "\""), "Expression policy axis name must be Text")
        dv_require(dv_record_like(weights), rt_cat("Expression policy axis weights must be a record: ", key))
        while (j < rt_count(weights)):
            var weight = weights[j]
            var feature = weights[j][0]
            dv_require((rt_slice(rt_json_stringify(feature), 0, 1) == "\""), "Expression policy feature name must be Text")
            dv_require(rt_is_numeric_value(weight[1]), rt_cat(rt_cat(rt_cat("Expression policy weight must be a finite Number: ", key), "."), feature))
            j = (j + 1)
        i = (i + 1)
    return true

fn dv_person_policy(subject, values, effort_cost, uncertainty_cost, expression_policy):
    dv_validate_expression_policy(expression_policy)
    dv_require(dv_and((not (effort_cost < 0)), (not (uncertainty_cost < 0))), "Negative policy cost")
    return dv_with({"subject": subject, "values": values, "effort_cost": effort_cost, "uncertainty_cost": uncertainty_cost}, "expression", expression_policy)

fn dv_accept_policy(mind, id, policy, basis):
    dv_domain(mind, "mind")
    dv_require((mind.subject == policy.subject), "Foreign value policy")
    dv_require((0 < rt_count(basis)), "Value policy needs an acceptance basis")
    var policies = dv_find(mind, "policies", [])
    dv_require((not dv_has_key(policies, id)), "Duplicate accepted policy")
    return dv_with_many(mind, {"policies": dv_with(policies, id, {"policy": policy, "basis": basis, "active": true}), "revision": (mind.revision + 1)})

fn dv_respond_adopted(mind, request, options, policy_id):
    var accepted = dv_get(mind.policies, policy_id)
    dv_require(accepted.active, "Response policy is not adopted")
    return dv_with(dv_respond(mind, request, options, accepted.policy), "policy_basis", accepted.basis)

fn dv_response_score(mind, option, appraisal, policy):
    var prediction = option.prediction
    dv_domain(prediction, "prediction")
    dv_require((prediction.source_revision == mind.revision), "Stale response prediction")
    var value = dv_value_change(mind, prediction, policy.values)
    var relation_and_state = dv_dot(appraisal.features, option.feature_weights)
    var effort = (option.effort * policy.effort_cost)
    var uncertainty = ((rt_count(relation_and_state.unknown) + rt_count(value.after.unknown)) * policy.uncertainty_cost)
    return dv_with({"score": ((value.delta + relation_and_state.score) - (effort + uncertainty)), "value": value, "relationship_and_state": relation_and_state, "effort": effort}, "uncertainty_cost", uncertainty)

fn dv_respond(mind, request, options, policy):
    dv_domain(mind, "mind")
    dv_require((mind.subject == policy.subject), "Foreign person policy")
    var appraisal = dv_appraise_request(mind, request)
    var i = 0
    var found = false
    var best = 0
    var chosen = false
    var evaluated = []
    var rejected = []
    var ids = []
    while (i < rt_count(options)):
        var option = options[i]
        var id = option.id
        var legal = dv_truth(mind, option.feasible)
        dv_require((not dv_has(ids, id)), "Duplicate response identity")
        rt_push(ids, id)
        if (legal == "true"):
            var evaluation = dv_response_score(mind, option, appraisal, policy)
            rt_push(evaluated, dv_pair(id, evaluation))
            var local_1 = false
            if found:
                local_1 = (best < evaluation.score)
            else:
                local_1 = true
            if local_1:
                found = true
                best = evaluation.score
                chosen = option
        else:
            rt_push(rejected, dv_pair(id, legal))
        i = (i + 1)
    var local_2 = false
    if found:
        local_2 = "selected"
    else:
        local_2 = "no-response"
    return dv_with_many({"status": local_2, "choice": chosen, "appraisal": appraisal, "evaluated": evaluated}, {"rejected": rejected, "expression": dv_expression(appraisal, policy.expression), "committed": false})

fn dv_relax(current, baseline, retention):
    return (baseline + ((current - baseline) * dv_unit(retention)))

fn dv_affect_proposal(mind, request, policy):
    var appraisal = dv_appraise_request(mind, request)
    var features = appraisal.features
    var self = request.self
    var valence_ref = dv_ref(self, "affect", "valence")
    var arousal_ref = dv_ref(self, "affect", "arousal")
    var valence = dv_read(mind, valence_ref)
    var arousal = dv_read(mind, arousal_ref)
    dv_require(dv_and(valence.known, arousal.known), "Unknown current affect")
    var v_delta = dv_dot(features, policy.valence_weights)
    var a_delta = dv_dot(features, policy.arousal_weights)
    return {"source_revision": mind.revision, "basis": appraisal, "effects": dv_pair(dv_assign(valence_ref, dv_clamp_signed((dv_relax(valence.value, policy.baseline_valence, policy.retention) + v_delta.score))), dv_assign(arousal_ref, dv_clamp_signed((dv_relax(arousal.value, policy.baseline_arousal, policy.retention) + a_delta.score))))}

// --- merged from 55-cognition.dv ---

// Cognitive acceptance is a derived value. Levels are ordered lower bounds.
fn dv_acceptance_classify(degree, levels):
    dv_unit(degree)
    dv_require(rt_count(levels) > 0, "Acceptance requires levels")
    dv_require(levels[0][1] == 0, "Acceptance levels must start at zero")
    var previous = -1
    var selected = ""
    var i = 0
    while i < rt_count(levels):
        let threshold = dv_unit(levels[i][1])
        dv_require(previous < threshold, "Acceptance thresholds must increase")
        if degree >= threshold:
            selected = levels[i][0]
        previous = threshold
        i = i + 1
    return {degree: degree, level: selected}

acceptance dv_threshold_acceptance(value, threshold):
    degree item: Acceptance = value
    levels:
        held from 0
        accepted from threshold

fn dv_acceptance_transition(previous, current, source):
    var transition = "unchanged"
    if previous.level != current.level:
        transition = "changed"
        if previous.level == "accepted" and current.level != "accepted":
            transition = "withdrawn"
    return {before: previous, after: current, transition: transition, source: source}

// Finite balance kernel. Values and charges use exact rational arithmetic.
// The model declares each allowed structural change, its resource charges and laws.
fn dv_balance_dot(a, b):
    dv_require(rt_count(a) == rt_count(b), "Balance dimensions differ")
    var result = rt_exact("0")
    var i = 0
    while i < rt_count(a):
        result = result + rt_exact(a[i]) * rt_exact(b[i])
        i = i + 1
    return result

fn dv_balance_extent(variables):
    var total = 1
    var i = 0
    while i < rt_count(variables):
        let count = rt_count(variables[i].options)
        dv_require(count > 0, "Balance variable has an empty domain")
        total = total * count
        dv_require(total <= 9007199254740991, "Finite domain index exceeds exact integer range")
        i = i + 1
    return total

fn dv_balance_candidate(index, goal, variables, laws, limits, prices):
    var cursor = index
    var values = []
    var costs = []
    var choices = []
    var j = 0
    while j < rt_count(limits.balances):
        rt_push(costs, rt_exact("0"))
        dv_require(rt_exact(limits.balances[j]) >= 0, "Negative resource balance")
        dv_require(rt_exact(prices[j]) >= 0, "Negative resource price")
        j = j + 1
    var i = 0
    while i < rt_count(variables):
        let count = rt_count(variables[i].options)
        let quotient = rt_floor(cursor / count)
        let choice = cursor - quotient * count
        cursor = quotient
        let option = variables[i].options[choice]
        rt_push(choices, choice)
        rt_push(values, rt_exact(option.value))
        dv_require(rt_count(option.cost) == rt_count(costs), "Resource cost dimensions differ")
        j = 0
        while j < rt_count(costs):
            let charge = rt_exact(option.cost[j])
            dv_require(charge >= 0, "Negative imprint charge")
            rt_replace(costs, j, costs[j] + charge)
            j = j + 1
        i = i + 1
    let degree = dv_balance_dot(goal.coefficients, values)
    var feasible = degree >= rt_exact(goal.minimum) and degree >= 0 and degree <= 1
    i = 0
    while i < rt_count(laws):
        if dv_balance_dot(laws[i].coefficients, values) != rt_exact(laws[i].total):
            feasible = false
        i = i + 1
    j = 0
    while j < rt_count(costs):
        if costs[j] > rt_exact(limits.balances[j]):
            feasible = false
        j = j + 1
    return {index: index, choices: choices, values: values, degree: degree, charges: costs, cost: dv_balance_dot(costs, prices), feasible: feasible}

// Search produces a witness; it does not certify its own optimality.
fn dv_imprint_solve(capability, goal, variables, laws, limits, prices):
    dv_require(capability, "Imprint capability is required")
    dv_require(rt_count(prices) == rt_count(limits.balances), "Resource price dimensions differ")
    dv_require(limits.search_budget >= 0 and rt_floor(limits.search_budget) == limits.search_budget, "Invalid search budget")
    let total = dv_balance_extent(variables)
    var visited = 0
    var best = false
    while visited < total and visited < limits.search_budget and (visited + 1) * 2 <= limits.work_remaining:
        let candidate = dv_balance_candidate(visited, goal, variables, laws, limits, prices)
        if candidate.feasible:
            if best == false:
                best = candidate
            else:
                if candidate.cost < best.cost:
                    best = candidate
        visited = visited + 1
    var status = "Unresolved"
    if best != false:
        status = "Feasible"
        if visited == total:
            status = "Optimal"
    else:
        if visited == total:
            status = "Infeasible"
    return {status: status, best: best, visited: visited, total: total, revision: limits.revision, subject: limits.subject}

// Numeric witnesses retain meaning after the JSON exchange representation is read back.
fn dv_balance_same_numbers(left, right):
    if rt_count(left) != rt_count(right):
        return false
    var i = 0
    while i < rt_count(left):
        if rt_exact(left[i]) != rt_exact(right[i]):
            return false
        i = i + 1
    return true

fn dv_balance_same_witness(left, right):
    return left.index == right.index and left.feasible == right.feasible and dv_same(left.choices, right.choices) and dv_balance_same_numbers(left.values, right.values) and dv_balance_same_numbers(left.charges, right.charges) and rt_exact(left.degree) == right.degree and rt_exact(left.cost) == right.cost

// Trusted finite proof kernel: reconstruct the witness and independently check coverage.
// The caller supplies the original model; certificates cannot replace its constraints.
fn dv_imprint_check(result, goal, variables, laws, limits, prices):
    let total = dv_balance_extent(variables)
    if result.total != total or result.revision != limits.revision or result.subject != limits.subject:
        return false
    if result.visited < 0 or result.visited > total or result.visited > limits.search_budget or result.visited * 2 > limits.work_remaining or rt_floor(result.visited) != result.visited:
        return false
    var best = result.best
    var verified = false
    if best != false:
        if best.index < 0 or best.index >= result.visited or rt_floor(best.index) != best.index:
            return false
        verified = dv_balance_candidate(best.index, goal, variables, laws, limits, prices)
        if not verified.feasible or not dv_balance_same_witness(best, verified):
            return false
    var i = 0
    while i < result.visited:
        var alternative = verified
        if best == false:
            alternative = dv_balance_candidate(i, goal, variables, laws, limits, prices)
        else:
            if i != best.index:
                alternative = dv_balance_candidate(i, goal, variables, laws, limits, prices)
        if alternative.feasible:
            if best == false:
                return false
            if alternative.cost < best.cost:
                return false
        i = i + 1
    if result.visited == total:
        if best == false:
            return result.status == "Infeasible"
        return result.status == "Optimal"
    if best == false:
        return result.status == "Unresolved"
    return result.status == "Feasible"

fn dv_imprint_commit(state, result, goal, variables, laws, limits, prices, source):
    dv_require(state.subject == limits.subject and state.revision == limits.revision, "Imprint source state changed")
    dv_require(dv_same(state.balances, limits.balances), "Imprint resource snapshot changed")
    dv_require(dv_imprint_check(result, goal, variables, laws, limits, prices), "Invalid balance certificate")
    dv_require(state.work_remaining == limits.work_remaining, "Imprint work snapshot changed")
    let work_spent = result.visited * 2
    let paid = dv_with_many(state, [["work_remaining", state.work_remaining - work_spent], ["revision", state.revision + 1]])
    if result.status != "Optimal":
        return {applied: false, state: paid, result: result, work_spent: work_spent}
    let best = result.best
    var balances = []
    var i = 0
    while i < rt_count(state.balances):
        let before = rt_exact(state.balances[i])
        let after = before - best.charges[i]
        dv_require(before == after + best.charges[i], "Resource conservation failed")
        rt_push(balances, after)
        i = i + 1
    let degree = dv_balance_dot(goal.coefficients, best.values)
    let accepted = dv_acceptance_classify(degree, state.levels)
    let previous = dv_acceptance_classify(dv_balance_dot(goal.coefficients, state.values), state.levels)
    let transition = dv_acceptance_transition(previous, accepted, source)
    let receipt = {kind: "Imprint", source: source, before: state.values, after: best.values, charges: best.charges, proof: result, transition: transition}
    let next = dv_with_many(paid, [["values", best.values], ["balances", balances], ["revision", state.revision + 1], ["acceptance", accepted], ["imprint_receipt", receipt]])
    return {applied: true, state: next, result: result, work_spent: work_spent}

// Adapter to authoritative Core mind cells and the existing action-cost ledger.
fn dv_imprint_prepare(mind, refs, ledger, work_remaining, levels, search_budget, capability):
    dv_domain(mind, "mind")
    var values = []
    var i = 0
    while i < rt_count(refs):
        let cell = dv_read(mind, refs[i])
        dv_require(cell.known and not cell.conflicted, "Imprint structural coordinate is not established")
        rt_push(values, rt_exact(cell.value))
        i = i + 1
    return {subject: mind.subject, revision: mind.revision, mind_id: mind.id, refs: refs, values: values, balances: [ledger.balances.time, ledger.balances.computation, ledger.balances.stamina], ledger_id: ledger.id, ledger_revision: ledger.revision, work_remaining: work_remaining, levels: levels, search_budget: search_budget, imprint_allowed: capability}

fn dv_imprint_apply(mind, physical, ledger, state, result, goal, variables, laws, prices, event):
    dv_domain(mind, "mind")
    dv_require(state.imprint_allowed, "Imprint capability is required")
    dv_require(mind.id == state.mind_id and mind.subject == state.subject and mind.revision == state.revision, "Imprint target snapshot changed")
    dv_require(ledger.id == state.ledger_id and ledger.revision == state.ledger_revision, "Imprint ledger snapshot changed")
    let current = dv_imprint_prepare(mind, state.refs, ledger, state.work_remaining, state.levels, state.search_budget, state.imprint_allowed)
    dv_require(dv_balance_same_numbers(current.values, state.values), "Imprint structural input changed")
    let committed = dv_imprint_commit(current, result, goal, variables, laws, state, prices, event)
    var next_mind = mind
    var actual = dv_action_cost_vector(0, 0, 0)
    var outcome = "rejected"
    if committed.applied:
        let charges = committed.state.imprint_receipt.charges
        actual = dv_action_cost_vector(charges[0], charges[1], charges[2])
        outcome = "applied"
        let origin = {kind: "Imprint", event: event, subject: mind.subject, proof: result}
        var i = 0
        while i < rt_count(state.refs):
            next_mind = dv_store(next_mind, state.refs[i], dv_cell(committed.state.values[i], 1, dv_find(physical, "time", 0) + actual.time, [origin]))
            i = i + 1
        next_mind = dv_with_many(next_mind, [["revision", committed.state.revision], ["history", dv_append(mind.history, committed.state.imprint_receipt)], ["imprint_acceptance", committed.state.acceptance]])
        let observed = dv_imprint_prepare(next_mind, state.refs, ledger, committed.state.work_remaining, state.levels, state.search_budget, state.imprint_allowed)
        dv_require(dv_balance_dot(goal.coefficients, observed.values) >= rt_exact(goal.minimum), "Stored cognition did not achieve imprint goal")
    let bounds = dv_action_cost_bounds(actual, actual)
    let quote = dv_action_cost_quote(ledger, physical, "cognitive-imprint", event, bounds)
    let settlement = dv_action_cost_finish(ledger, physical, quote, actual, outcome)
    return {applied: committed.applied, mind: next_mind, physical: settlement.execution.world, ledger: settlement.ledger, work_remaining: committed.state.work_remaining, work_spent: committed.work_spent, proof: result, cost_receipt: dv_get(settlement.ledger.receipts, event)}
// Validity is checked before cost. Cost is not truth, probability or action utility.

fn dv_proof_step(id, kind, conclusion, parents, law):
    return dv_with({"id": id, "kind": kind, "conclusion": conclusion, "parents": parents}, "law", law)

fn dv_cost_policy(step, evidence, assumption, conflict, reference, maximum, allow_assumptions, budget):
    dv_require(dv_and(dv_and((not (step < 0)), (not (evidence < 0))), dv_and(dv_and((0 < assumption), (not (conflict < 0))), dv_and((0 < reference), (not (maximum < 0))))), "Invalid reasoning costs")
    dv_require((0 < budget), "Invalid proof budget")
    return dv_with_many({"step": step, "evidence": evidence, "assumption": assumption, "conflict": conflict}, {"reference": reference, "maximum": maximum, "allow_assumptions": allow_assumptions, "budget": budget})

fn dv_rule_concludes(law, conclusion):
    var effects = law.effects
    var i = 0
    var found = false
    while (i < rt_count(effects)):
        var effect = effects[i]
        if (effect.op == "assign"):
            if dv_same(conclusion, dv_fact(effect.ref, effect.value)):
                found = true
        i = (i + 1)
    return found

fn dv_match_premises(premise, supplied):
    if dv_same(premise, dv_true()):
        return (rt_count(supplied) == 0)
    else:
        if (premise.op == "all"):
            var required = premise.items
            var i = 0
            var valid = (rt_count(supplied) == rt_count(required))
            while (i < rt_count(required)):
                valid = dv_and(valid, dv_has(supplied, required[i]))
                i = (i + 1)
            return valid
        else:
            return dv_same(supplied, dv_single(premise))

fn dv_check_step(world, step, checked, policy):
    var kind = step.kind
    var conclusion = step.conclusion
    var parents = step.parents
    var supplied = []
    var confidence = 1
    var i = 0
    var hypothetical = false
    while (i < rt_count(parents)):
        var parent = dv_get(checked, parents[i])
        rt_push(supplied, parent.conclusion)
        confidence = dv_min(confidence, parent.confidence)
        hypothetical = dv_or(hypothetical, parent.hypothetical)
        i = (i + 1)
    var assumptions = 0
    var conflicts = 0
    var local_uncertainty = 0
    if (kind == "known"):
        dv_require((rt_count(parents) == 0), "Known premise cannot hide parents")
        dv_require((dv_truth(world, conclusion) == "true"), "Conclusion is not available in this view")
        confidence = dv_premise_confidence(world, conclusion)
        local_uncertainty = (1 - confidence)
    else:
        if (kind == "assume"):
            dv_require((rt_count(parents) == 0), "Assumption cannot hide parents")
            dv_require(dv_and(policy.allow_assumptions, (not (world.domain == "physical"))), "Assumption not permitted")
            hypothetical = true
            assumptions = 1
            confidence = 0
            if (dv_truth(world, conclusion) == "false"):
                conflicts = 1
        else:
            if (kind == "axiom"):
                var adoption = dv_get(world.adoptions, step.law)
                var law = adoption.law
                dv_require(adoption.active, "Proof uses a suspended axiom")
                dv_require((adoption.mode == "infer"), "Operational effects do not prove that an event occurred")
                dv_require(dv_rule_concludes(law, conclusion), "Axiom does not conclude this proposition")
                dv_require(dv_match_premises(law.premise, supplied), "Axiom premises are not established")
                confidence = dv_min(confidence, adoption.confidence)
                local_uncertainty = (1 - adoption.confidence)
            else:
                rt_fail("Unsupported proof step")
    return dv_with_many(dv_clone(step), {"confidence": confidence, "hypothetical": hypothetical, "assumptions": assumptions, "conflicts": conflicts, "local_uncertainty": local_uncertainty})

fn dv_judge_conclusion(world, conclusion, proof, policy):
    dv_require((0 < rt_count(proof)), "Empty derivation")
    dv_require((not (policy.budget < rt_count(proof))), "Derivation budget exhausted")
    var checked = []
    var i = 0
    while (i < rt_count(proof)):
        var step = proof[i]
        var id = step.id
        dv_require((not dv_has_key(checked, id)), "Repeated proof node identity")
        checked = dv_with(checked, id, dv_check_step(world, step, checked, policy))
        i = (i + 1)
    var root = dv_get(checked, proof[(rt_count(proof) - 1)].id)
    var queue = dv_single(root.id)
    var visited = []
    var cursor = 0
    var steps = 0
    var uncertainty = 0
    var assumptions = 0
    var conflicts = 0
    dv_require(dv_same(conclusion, root.conclusion), "Derivation concludes another proposition")
    while (cursor < rt_count(queue)):
        var id = queue[cursor]
        if dv_has(visited, id):
            false
        else:
            var step = dv_get(checked, id)
            var parents = step.parents
            var p = 0
            rt_push(visited, id)
            steps = (steps + 1)
            uncertainty = (uncertainty + step.local_uncertainty)
            assumptions = (assumptions + step.assumptions)
            conflicts = (conflicts + step.conflicts)
            while (p < rt_count(parents)):
                rt_push(queue, parents[p])
                p = (p + 1)
        cursor = (cursor + 1)
    var cost = (((steps * policy.step) + (uncertainty * policy.evidence)) + ((assumptions * policy.assumption) + (conflicts * policy.conflict)))
    var components = {"steps": steps, "evidence_uncertainty": uncertainty, "assumptions": assumptions, "conflicts": conflicts}
    return dv_with_many({"valid": true, "cost": cost, "components": components, "reasonable": (not (policy.maximum < cost))}, {"reasonableness": (1 / (1 + (cost / policy.reference))), "confidence": root.confidence, "hypothetical": dv_or(root.hypothetical, (world.domain == "prediction")), "scope": {"world": world.id, "subject": world.subject, "revision": world.revision}, "basis": visited})

// --- merged from 80-inspection.dv ---

// Inspector reads committed checkpoints, not reconstructed or omniscient minds.

fn dv_checkpoint(world, time):
    return {"time": time, "revision": world.revision, "world": dv_clone(world)}

fn dv_session(worlds, time, time_unit):
    var catalog = []
    var history = []
    var subjects = []
    var i = 0
    dv_require((not (time < 0)), "Negative session time")
    while (i < rt_count(worlds)):
        var world = worlds[i]
        var id = world.id
        var domain = world.domain
        dv_require(dv_or((domain == "physical"), (domain == "mind")), "Predictions cannot be committed as worlds")
        dv_require((not dv_has_key(catalog, id)), "Duplicate world identity")
        if (domain == "mind"):
            dv_require((not dv_has(subjects, world.subject)), "Duplicate subject world")
            rt_push(subjects, world.subject)
        catalog = dv_with(catalog, id, world)
        rt_push(history, dv_checkpoint(world, time))
        i = (i + 1)
    return {"worlds": catalog, "history": history, "time": time, "time_unit": time_unit}

fn dv_session_commit(session, expected_revision, world, time):
    var catalog = session.worlds
    var id = world.id
    var old = dv_get(catalog, id)
    dv_require((old.revision == expected_revision), "Stale session commit")
    dv_require((expected_revision < world.revision), "Commit needs a newer world revision")
    dv_require(dv_and((old.domain == world.domain), (old.subject == world.subject)), "World identity changed")
    dv_require((not (time < session.time)), "Session time cannot move backwards")
    return dv_with_many(session, {"worlds": dv_with(catalog, id, world), "history": dv_append(session.history, dv_checkpoint(world, time)), "time": time})

fn dv_session_advance(session, time):
    dv_require((not (time < session.time)), "Session time cannot move backwards")
    return dv_with(session, "time", time)

fn dv_active_worldview(world):
    var adoptions = world.adoptions
    var result = []
    var i = 0
    var policies = dv_find(world, "policies", [])
    var accepted_policies = []
    while (i < rt_count(adoptions)):
        var entry = adoptions[i]
        if entry[1].active:
            rt_push(result, dv_clone(entry))
        i = (i + 1)
    i = 0
    while (i < rt_count(policies)):
        var entry = policies[i]
        if entry[1].active:
            rt_push(accepted_policies, dv_clone(entry))
        i = (i + 1)
    return {"laws": result, "value_policies": accepted_policies}

fn dv_inspect_content(world, command, object_id, facet):
    if (command == "worldview"):
        return dv_active_worldview(world)
    else:
        if (command == "state"):
            return dv_clone(world.objects)
        else:
            if (command == "slice"):
                var objects = world.objects
                var fields = []
                if dv_has_key(objects, object_id):
                    var facets = dv_get(objects, object_id).facets
                    var values = dv_find(facets, facet, [])
                    var i = 0
                    while (i < rt_count(values)):
                        rt_push(fields, values[i][0])
                        i = (i + 1)
                return dv_slice(world, object_id, facet, fields)
            else:
                return rt_fail("Inspector command must be worldview, state or slice")

fn dv_inspect_at(session, subject, time, command, object_id, facet):
    dv_require((not (session.time < time)), "Requested time has not been reached")
    var history = session.history
    var i = 0
    var found = false
    var chosen = false
    while (i < rt_count(history)):
        var checkpoint = history[i]
        var world = checkpoint.world
        if dv_and((world.domain == "mind"), dv_and((world.subject == subject), (not (time < checkpoint.time)))):
            found = true
            chosen = checkpoint
        i = (i + 1)
    if found:
        var world = chosen.world
        return dv_with_many({"status": "snapshot", "subject": subject, "requested_time": time, "checkpoint_time": chosen.time}, {"time_unit": session.time_unit, "revision": world.revision, "content": dv_inspect_content(world, command, object_id, facet)})
    else:
        return {"status": "no-checkpoint", "subject": subject, "requested_time": time}

fn dv_inspector_main():
    var argc = rt_arg_count()
    dv_require(dv_or((argc == 4), (argc == 6)), "Usage: Inspector session.json subject time worldview|state|slice [object facet]")
    var command = rt_arg(3)
    var local_1 = false
    if (command == "slice"):
        local_1 = (argc == 6)
    else:
        local_1 = (argc == 4)
    dv_require(local_1, "Wrong inspector argument count")
    var local_2 = false
    if (argc == 6):
        local_2 = rt_arg(4)
    else:
        local_2 = ""
    var local_3 = false
    if (argc == 6):
        local_3 = rt_arg(5)
    else:
        local_3 = ""
    return rt_print(rt_json_stringify(dv_inspect_at(rt_json_parse(rt_read(rt_arg(0))), rt_arg(1), rt_number(rt_arg(2)), command, local_2, local_3)))

// --- merged from 90-action-cost.dv ---

// Resource accounting is independent of preference/effort scores. All transitions return copies.

fn dv_action_cost_vector(time, computation, stamina):
    dv_require(dv_and((not (time < 0)), dv_and((not (computation < 0)), (not (stamina < 0)))), "Negative action cost")
    return {"time": time, "computation": computation, "stamina": stamina}

fn dv_action_cost_validate(v):
    return dv_action_cost_vector(v.time, v.computation, v.stamina)

fn dv_action_cost_le(a, b):
    return dv_and((not (b.time < a.time)), dv_and((not (b.computation < a.computation)), (not (b.stamina < a.stamina))))

fn dv_action_cost_add(a, b):
    return dv_action_cost_vector((a.time + b.time), (a.computation + b.computation), (a.stamina + b.stamina))

fn dv_action_cost_sub(a, b):
    return dv_action_cost_vector((a.time - b.time), (a.computation - b.computation), (a.stamina - b.stamina))

fn dv_action_cost_bounds(minimum, maximum):
    dv_action_cost_validate(minimum)
    dv_action_cost_validate(maximum)
    dv_require(dv_action_cost_le(minimum, maximum), "Action minimum exceeds maximum")
    return {"minimum": minimum, "maximum": maximum}

fn dv_action_cost_ledger(id, balances):
    dv_action_cost_validate(balances)
    return dv_with_many({"id": id, "revision": 0, "balances": balances, "reserved": dv_action_cost_vector(0, 0, 0)}, {"receipts": [], "events": [], "spent": dv_action_cost_vector(0, 0, 0)})

fn dv_action_cost_quote(ledger, world, action, event, bounds):
    dv_domain(world, "physical")
    dv_action_cost_bounds(bounds.minimum, bounds.maximum)
    dv_require((not dv_has(ledger.events, event)), "Repeated cost event")
    dv_require((not dv_has(world.seen, event)), "Repeated world event")
    return dv_with_many({"ledger": ledger.id, "revision": ledger.revision, "world": world.id, "world_revision": world.revision}, {"action": action, "event": event, "bounds": bounds})

fn dv_action_cost_admit(ledger, world, quote):
    var maximum = quote.bounds.maximum
    var event = quote.event
    dv_require(dv_and((ledger.id == quote.ledger), (ledger.revision == quote.revision)), "Stale cost quote")
    dv_require(dv_and((world.id == quote.world), (world.revision == quote.world_revision)), "Stale cost world")
    dv_action_cost_quote(ledger, world, quote.action, event, quote.bounds)
    dv_require(dv_action_cost_le(maximum, ledger.balances), "Insufficient action resources")
    var receipt = dv_with(quote, "state", "reserved")
    var next = dv_with(ledger, "revision", (ledger.revision + 1))
    next = dv_with(next, "balances", dv_action_cost_sub(ledger.balances, maximum))
    next = dv_with(next, "reserved", dv_action_cost_add(ledger.reserved, maximum))
    next = dv_with(next, "events", dv_append(ledger.events, event))
    next = dv_with(next, "receipts", dv_with(ledger.receipts, event, receipt))
    return {"ledger": next, "receipt": receipt}

fn dv_action_cost_actual(receipt, actual):
    dv_action_cost_validate(actual)
    dv_require(dv_and(dv_action_cost_le(receipt.bounds.minimum, actual), dv_action_cost_le(actual, receipt.bounds.maximum)), "Actual action cost outside bounds")
    return actual

fn dv_action_cost_settle(ledger, receipt, actual, outcome):
    var event = receipt.event
    var stored = dv_get(ledger.receipts, event)
    var maximum = receipt.bounds.maximum
    dv_require(dv_and((ledger.id == receipt.ledger), dv_same(stored, receipt)), "Receipt mismatch or already settled")
    dv_require((stored.state == "reserved"), "Receipt already settled")
    dv_require(dv_or((outcome == "applied"), (outcome == "rejected")), "Unknown settlement outcome")
    dv_action_cost_actual(receipt, actual)
    var next = dv_with(ledger, "revision", (ledger.revision + 1))
    var settled = dv_with_many(receipt, {"state": "settled", "actual": actual, "outcome": outcome})
    next = dv_with(next, "balances", dv_action_cost_add(ledger.balances, dv_action_cost_sub(maximum, actual)))
    next = dv_with(next, "reserved", dv_action_cost_sub(ledger.reserved, maximum))
    next = dv_with(next, "spent", dv_action_cost_add(ledger.spent, actual))
    return dv_with(next, "receipts", dv_with(ledger.receipts, event, settled))

// A queued action has already waited on the shared world clock.
// Its ledger still pays the full duration once; immediate callers retain elapsed-time settlement.
fn dv_action_cost_completion_time(physical, receipt, actual):
    let now = dv_find(physical, "time", 0)
    if dv_has_key(receipt, "scheduled_start"):
        let due = receipt.scheduled_start + actual.time
        dv_require(due <= now, "Scheduled action has not finished waiting")
        return now
    return now + actual.time

fn dv_action_cost_clock_commit(physical, receipt, actual, status):
    var event = receipt.event
    var time = dv_action_cost_completion_time(physical, receipt, actual)
    var history = dv_with_many({"id": event, "time": time, "kind": "action-cost", "status": status}, {"receipt": receipt, "actual": actual})
    return dv_with_many(physical, {"time": time, "revision": (physical.revision + 1), "seen": dv_append(physical.seen, event), "history": dv_append(physical.history, history)})

fn dv_action_cost_execution_metadata(execution, receipt, actual):
    return dv_with_many(execution, {"event": receipt.event, "time": execution.world.time, "actual_cost": actual})

fn dv_action_cost_execute(ledger, physical, quote, actual):
    var admitted = dv_action_cost_admit(ledger, physical, quote)
    var receipt = admitted.receipt
    dv_action_cost_actual(receipt, actual)
    var execution = dv_execute(physical, receipt.action, receipt.event, dv_action_cost_completion_time(physical, receipt, actual), receipt.world_revision)
    if (execution.status == "applied"):
        false
    else:
        execution = dv_with(execution, "world", dv_action_cost_clock_commit(physical, receipt, actual, execution.status))
    var local_1 = false
    if (execution.status == "applied"):
        local_1 = "applied"
    else:
        local_1 = "rejected"
    return {"ledger": dv_action_cost_settle(admitted.ledger, receipt, actual, local_1), "execution": dv_action_cost_execution_metadata(execution, receipt, actual), "receipt": receipt}

fn dv_action_cost_finish(ledger, physical, quote, actual, outcome):
    var admitted = dv_action_cost_admit(ledger, physical, quote)
    var receipt = admitted.receipt
    dv_action_cost_actual(receipt, actual)
    var next = dv_action_cost_clock_commit(physical, receipt, actual, outcome)
    return {"ledger": dv_action_cost_settle(admitted.ledger, receipt, actual, outcome), "execution": dv_action_cost_execution_metadata(dv_result(outcome, next, [], dv_single(receipt.event)), receipt, actual), "receipt": receipt}
// Explicit, defeasible acceptance of a paid explanation. This is not an observation adapter.

fn dv_explanation_model_complete(model, status, revision):
    return dv_and((dv_find(model, "status", "unknown") == status), dv_and(dv_or((dv_find(model, "source_revision", -1) == revision), dv_find(model, "validated_by_inputs", false)), dv_and(dv_find(model, "plan_complete", false), dv_and((not (dv_find(model, "remaining", -1) < 0)), dv_and((not (dv_find(model, "work_remaining", -1) < 0)), dv_and((rt_count(dv_find(model, "failures", [])) == 0), dv_and((0 < rt_count(dv_find(model, "predictions", []))), dv_and((rt_count(dv_find(model, "predictions", [])) == rt_count(dv_find(model, "comparisons", []))), dv_has_key(model, "event")))))))))

fn dv_explanation_observation_sources(mind, comparison, sources):
    var observed = comparison.observed_cells
    var i = 0
    var valid = true
    var ids = []
    var inputs = []
    if (rt_count(observed) == 0):
        valid = false
    while (i < rt_count(observed)):
        var item = observed[i]
        var ref = observed[i].ref
        var cell = dv_read(mind, observed[i].ref)
        var j = 0
        var found = false
        if dv_same(cell, item.cell):
            false
        else:
            valid = false
        while (j < rt_count(sources)):
            var source = sources[j]
            var observation = sources[j].observation
            if dv_and((observation.subject == mind.subject), dv_and(dv_same_local_ref(mind.subject, observation.ref, ref), dv_same(observation.value, cell.value))):
                if dv_has(dv_find(cell, "claims", []), observation):
                    found = true
                    if dv_has(ids, source.event_id):
                        false
                    else:
                        ids = dv_append(ids, source.event_id)
            j = (j + 1)
        if found:
            false
        else:
            valid = false
        rt_push(inputs, item)
        i = (i + 1)
    return {"valid": valid, "source_event_ids": ids, "inputs": inputs}

fn dv_explanation_trace_changes(step):
    if dv_has_key(step, "changes"):
        return step.changes
    else:
        if dv_has_key(step, "response"):
            var response = step.response
            if dv_has_key(response, "bridge"):
                return dv_find(response.bridge, "changes", [])
            else:
                return []
        else:
            return []

fn dv_explanation_slot(model, slot):
    var predictions = model.predictions
    var index = slot.feature_index
    var valid = false
    var value = false
    var confidence = 0
    var trace_step = -1
    var trace = model.trace
    var j = 0
    if dv_and((not (index < 0)), (index < rt_count(predictions))):
        var prediction = predictions[index]
        while (j < rt_count(trace)):
            var step = trace[j]
            var changes = dv_explanation_trace_changes(trace[j])
            var k = 0
            if (step.at == slot.trace_at):
                while (k < rt_count(changes)):
                    var change = changes[k]
                    if dv_and(dv_same(change.ref, slot.ref), dv_and(dv_uncontested(change.after), dv_and(prediction.covered, dv_find(slot, "value_from_prediction", false)))):
                        valid = true
                        value = change.after.value
                        confidence = dv_min(prediction.confidence, change.after.confidence)
                        trace_step = j
                    k = (k + 1)
            j = (j + 1)
    return dv_with({"valid": valid, "value": value, "confidence": confidence, "trace_step": trace_step}, "slot", slot)

fn dv_explanation_model_inputs(mind, model):
    var trace = dv_find(model, "trace", [])
    var result = []
    var i = 0
    while (i < rt_count(trace)):
        var refs = dv_find(trace[i], "inputs", [])
        var j = 0
        while (j < rt_count(refs)):
            var ref = refs[j].ref
            result = dv_explanation_merge(result, dv_single({"ref": ref, "cell": dv_read(mind, ref)}))
            j = (j + 1)
        i = (i + 1)
    return result

fn dv_explanation_model_current(mind, model):
    var inputs = dv_find(model, "validation_inputs", [])
    var valid = dv_same(dv_find(model, "source_adoptions", false), mind.adoptions)
    var i = 0
    while (i < rt_count(inputs)):
        var input = inputs[i]
        if dv_same(dv_without(input.cell, "time"), dv_without(dv_read(mind, input.ref), "time")):
            false
        else:
            valid = false
        i = (i + 1)
    return valid

fn dv_accept_explanation(mind, model, competitors, slots, sources, policy, budget, time, id):
    var valid = true
    var reason = "accepted-estimated"
    var comparisons = dv_find(model, "comparisons", [])
    var i = 0
    var source_ids = []
    var inputs = []
    var competitor_ids = []
    var claims = []
    var effects = []
    var remaining = budget
    var confidence = dv_find(policy, "confidence_cap", 0)
    dv_domain(mind, "mind")
    if dv_and(dv_find(policy, "active", false), dv_and((0 < confidence), dv_and((confidence < 1), (0 < rt_count(dv_find(policy, "basis", [])))))):
        false
    else:
        valid = false
        reason = "abduction-strategy-not-adopted"
    var local_1 = false
    if dv_find(model, "validated_by_inputs", false):
        local_1 = dv_explanation_model_current(mind, model)
    else:
        local_1 = true
    if dv_and(dv_explanation_model_complete(model, "explained", mind.revision), local_1):
        false
    else:
        valid = false
        reason = "model-incomplete-or-stale"
    while (i < rt_count(comparisons)):
        var comparison = comparisons[i]
        var observed = dv_explanation_observation_sources(mind, comparisons[i], sources)
        if dv_and((comparison.result == "match"), observed.valid):
            false
        else:
            valid = false
            reason = "unobserved-or-unmatched-feature"
        confidence = dv_min(confidence, comparison.confidence)
        source_ids = dv_explanation_merge(source_ids, observed.source_event_ids)
        inputs = dv_explanation_merge(inputs, observed.inputs)
        i = (i + 1)
    inputs = dv_explanation_merge(inputs, dv_explanation_model_inputs(mind, model))
    i = 0
    while (i < rt_count(competitors)):
        var other = competitors[i]
        var j = 0
        var other_comparisons = dv_find(competitors[i], "comparisons", [])
        var contradiction = false
        var local_2 = false
        if dv_find(other, "validated_by_inputs", false):
            local_2 = dv_explanation_model_current(mind, other)
        else:
            local_2 = true
        if dv_and(dv_explanation_model_complete(other, "inconsistent", mind.revision), local_2):
            false
        else:
            valid = false
            reason = "unresolved-competitor"
        while (j < rt_count(other_comparisons)):
            var comparison = other_comparisons[j]
            var observed = dv_explanation_observation_sources(mind, other_comparisons[j], sources)
            if dv_and((not (comparison.result == "unknown")), observed.valid):
                false
            else:
                valid = false
                reason = "competitor-feature-unresolved"
            if (comparison.result == "contradiction"):
                contradiction = true
            source_ids = dv_explanation_merge(source_ids, observed.source_event_ids)
            inputs = dv_explanation_merge(inputs, observed.inputs)
            j = (j + 1)
        inputs = dv_explanation_merge(inputs, dv_explanation_model_inputs(mind, other))
        if contradiction:
            false
        else:
            valid = false
            reason = "competitor-not-refuted"
        if dv_has_key(other, "event"):
            competitor_ids = dv_append(competitor_ids, other.event)
        i = (i + 1)
    if (rt_count(slots) == 0):
        valid = false
        reason = "no-public-claim-slots"
    i = 0
    while dv_and(valid, (i < rt_count(slots))):
        if (remaining < 1):
            valid = false
            reason = "argument-reason-budget"
        else:
            var slot = slots[i]
            var resolved = dv_explanation_slot(model, slots[i])
            remaining = (remaining - 1)
            if resolved.valid:
                var ref = slot.ref
                var existing = dv_read(mind, slot.ref)
                if dv_has_key(mind.objects, ref.object):
                    false
                else:
                    valid = false
                    reason = "unknown-local-claim-object"
                if dv_and(dv_uncontested(existing), (not dv_same(existing.value, resolved.value))):
                    valid = false
                    reason = "claim-conflicts-with-current-evidence"
                confidence = dv_min(confidence, resolved.confidence)
                rt_push(claims, dv_with({"slot_id": slot.slot_id, "ref": ref, "value": resolved.value, "trace_step": resolved.trace_step}, "feature_index", slot.feature_index))
                if dv_uncontested(existing):
                    false
                else:
                    rt_push(effects, dv_assign(ref, resolved.value))
            else:
                valid = false
                reason = "claim-not-covered-by-actual-predictive-trace"
            i = (i + 1)
    if (0 < confidence):
        false
    else:
        valid = false
        reason = "unsupported-zero-confidence"
    var basis = dv_explanation_merge(dv_find(policy, "basis", []), dv_explanation_merge(source_ids, dv_append(competitor_ids, dv_find(model, "event", ""))))
    var world = mind
    var changes = []
    if valid:
        var stage = dv_stage(mind, effects, time, dv_append(basis, id), confidence)
        var j = 0
        if (stage.status == "ready"):
            world = stage.world
            changes = stage.changes
            while (j < rt_count(changes)):
                var ref = changes[j].ref
                world = dv_store(world, ref, dv_with_many(dv_read(world, ref), {"source": "abduction", "estimated": true}))
                j = (j + 1)
            if (0 < rt_count(changes)):
                world = dv_with(world, "revision", (mind.revision + 1))
        else:
            valid = false
            reason = stage.status
    var argument = dv_with_many({"id": id, "estimated": true, "confidence": confidence, "claims": claims}, {"model_event": dv_find(model, "event", ""), "source_event_ids": source_ids, "competitor_events": competitor_ids, "source_revision": mind.revision, "mind_revision_after": world.revision, "inputs": inputs, "changes": changes, "basis": basis})
    if valid:
        world = dv_with(world, "history", dv_append(world.history, {"kind": "estimated-model-argument", "argument": argument, "time": time}))
    return dv_with_many({"accepted": valid, "reason": reason, "world": world, "argument": argument}, {"remaining": remaining, "expanded": (budget - remaining)})

fn dv_explanation_merge(a, b):
    var result = a
    var i = 0
    while (i < rt_count(b)):
        if dv_has(result, b[i]):
            false
        else:
            result = dv_append(result, b[i])
        i = (i + 1)
    return result

// --- merged from 98-debug.dv ---

// Read-only event projection. Filtering affects reports, never scheduling or knowledge.
fn dv_debug_event(event):
    let data = event.data
    let raw_action = dv_find(data, "action", [])
    var action = []
    var action_id = dv_find(data, "action_id", "")
    if dv_record_like(raw_action):
        action = raw_action
        action_id = dv_find(action, "id", action_id)
    else:
        if raw_action != false:
            if rt_is_list(raw_action):
                action_id = rt_json_stringify(raw_action)
            else:
                action_id = rt_show(raw_action)
    var detail = []
    let fields = ["due", "until", "waiting", "duration", "status", "reason", "score", "plan_expansions", "plan_cache_hit", "reused_plan_expansions", "stop", "root_best", "best_after_successor_layer", "completed_layers", "actual", "observations", "judgment", "accepted", "literal_truth", "epistemic_support", "source_event", "execution_id", "chapter", "movement", "process", "revision_before", "revision_after", "suspended", "dependency_expansions", "dependency_stop", "reason_reused", "cognition_reused", "reasons", "steps", "remaining", "mind_revision"]
    var i = 0
    while i < rt_count(fields):
        if dv_has_key(data, fields[i]):
            rt_push(detail, dv_pair(fields[i], dv_get(data, fields[i])))
        i = i + 1
    if event.type == "action_execution":
        detail = dv_with(detail, "status", data.receipt.execution.status)
    return rt_snapshot({"event_id": event.id, "type": event.type, "actor": event.actor, "game_time": event.time, "parents": event.parents, "action_id": action_id, "action_kind": dv_find(action, "kind", ""), "label": dv_find(action, "label", dv_find(action, "surface", "")), "purpose_sources": dv_find(action, "purpose_basis", []), "detail": detail})

fn dv_debug_events(events, start, config):
    dv_require(0 <= start and start <= rt_count(events), "Invalid debug event cursor")
    let actors = dv_find(config, "actors", [])
    let kinds = dv_find(config, "event_types", [])
    var result = []
    var i = start
    while i < rt_count(events):
        let event = events[i]
        if (rt_count(actors) == 0 or event.actor == "" or dv_has(actors, event.actor)) and (rt_count(kinds) == 0 or dv_has(kinds, event.type)):
            rt_push(result, dv_debug_event(event))
        i = i + 1
    return {"from": start, "next": rt_count(events), "events": result, "scope": "independent debug projection; full snapshots remain in live session; file completeness is reported separately"}
// The selector receives only one actor snapshot. No authority or oracle argument.

fn dvs_event(events, kind, actor, time, parents, data):
    var id = rt_cat("e", rt_show(rt_count(events)))
    rt_push(events, rt_snapshot({"id": id, "type": kind, "actor": actor, "time": time, "parents": parents, "data": data}))
    return id

fn dvs_find_event_by_id(events, id):
    if (rt_length(id) > 1 and rt_chr(id, 0) == "e"):
        let num_str = rt_slice(id, 1, rt_length(id) - 1)
        if rt_is_number(num_str):
            let idx = rt_number(num_str)
            if (0 <= idx and idx < rt_count(events)):
                let candidate = events[idx]
                if (candidate.id == id):
                    return candidate
    var i = rt_count(events) - 1
    while (i >= 0):
        let event = events[i]
        if (event.id == id):
            return event
        i = i - 1
    return false

fn dvs_cognitive_parents(actor, parents):
    var previous = dv_find(actor, "last_cognitive_event", "")
    if (previous == ""):
        return parents
    else:
        return dv_explanation_merge(parents, dv_single(previous))

fn dvs_reason_cell(cell):
    return dv_without(cell, "time")

fn dvs_reason_value(cell):
    return {"known": cell.known, "value": cell.value, "confidence": cell.confidence, "conflicted": cell.conflicted}

fn dvs_reason_premises(mind, proposition):
    var op = proposition.op
    if (op == "constant"):
        return proposition
    else:
        if (op == "not"):
            return dvs_reason_premises(mind, proposition.item)
        else:
            if (op == "all"):
                var items = proposition.items
                var result = []
                var i = 0
                while (i < rt_count(items)):
                    rt_push(result, dvs_reason_premises(mind, items[i]))
                    i = (i + 1)
                return result
            else:
                return {"proposition": proposition, "support": dvs_reason_cell(dv_read(mind, proposition.ref))}

fn dvs_reason_signature(mind, adoption):
    var law = adoption.law
    var effects = adoption.law.effects
    var outputs = []
    var i = 0
    while (i < rt_count(effects)):
        var cell = dv_read(mind, effects[i].ref)
        rt_push(outputs, {"known": cell.known, "value": cell.value, "confidence": cell.confidence, "conflicted": cell.conflicted})
        i = (i + 1)
    return dv_with({"law": law, "confidence": adoption.confidence, "basis": adoption.basis, "premises": dvs_reason_premises(mind, law.premise)}, "outputs", outputs)

fn dvs_reason_changes(changes):
    var i = 0
    var changed = false
    while (i < rt_count(changes)):
        var change = changes[i]
        if dv_same(dvs_reason_value(change.before), dvs_reason_value(change.after)):
            false
        else:
            changed = true
        i = (i + 1)
    return changed

fn dvs_reason_monotone_satisfied(mind, effects):
    var e = 0
    let n = rt_count(effects)
    while e < n:
        let eff = effects[e]
        if dv_find(eff, "op", "") != "assign":
            return false
        let cell = dv_read(mind, eff.ref)
        if not cell.known or cell.value != eff.value or cell.confidence < 1:
            return false
        e = e + 1
    return true

fn dvs_reason_run(actor, events, time, parent):
    var mind = actor.mind
    var policy = actor.policy
    var budget = dv_find(policy, "reason_budget", 0)
    var count = 0
    var changed = true
    var signatures = dv_find(actor, "inference_signatures", [])
    var derivations = dv_find(actor, "inference_derivations", [])
    while dv_and(changed, (count < budget)):
        var adoptions = mind.adoptions
        var i = 0
        changed = false
        while dv_and((i < rt_count(adoptions)), (count < budget)):
            var entry = adoptions[i]
            var law = entry[1].law
            if dv_and(entry[1].active, (entry[1].mode == "infer")):
                var skip = false
                if dv_find(signatures, entry[0], false) != false and dvs_reason_monotone_satisfied(mind, law.effects):
                    skip = true
                if not skip and (dv_truth(mind, law.premise) == "true"):
                    let sig = dvs_reason_signature(mind, entry[1])
                    if not dv_same(dv_find(signatures, entry[0], false), sig):
                        var stage = dv_stage(mind, law.effects, time, entry[1].basis, entry[1].confidence)
                        if dv_and((stage.status == "ready"), dvs_reason_changes(stage.changes)):
                            var before = mind
                            var result = dv_infer(mind, entry[0], rt_cat("infer", rt_show(rt_count(events))), time, mind.revision)
                            mind = result.world
                            changed = true
                            count = (count + 1)
                            signatures = dv_with(signatures, entry[0], sig)
                            var event = dvs_event(events, "inference", actor.id, time, dv_explanation_merge(dvs_cognitive_parents(actor, dv_single(parent)), dvs_support_parents(before, dvs_sim_refs(law.premise), events, actor)), {"mind_before": before, "mind_after": mind, "law": law, "receipt": result})
                            actor = dv_with(actor, "last_cognitive_event", event)
                            rt_push(derivations, dv_with({"event": event, "adoption": entry[1], "inputs": dvs_sim_inputs(before, law.premise), "changes": result.changes}, "valid", true))
                        else:
                            if (stage.status == "ready"):
                                count = (count + 1)
                                signatures = dv_with(signatures, entry[0], sig)
                                dvs_event(events, "inference_alternative_basis", actor.id, time, dvs_cognitive_parents(actor, dv_single(parent)), {"law": law, "basis": entry[1].basis, "premises": dvs_reason_premises(mind, law.premise), "mind_revision": mind.revision})
            i = (i + 1)
    var local_1 = false
    if (count < budget):
        local_1 = "no-new-effective-conclusion"
    else:
        local_1 = "budget-exhausted"
    let report = {"steps": count, "remaining": budget - count, "stop": local_1, "mind_revision": mind.revision}
    if count > 0 or not dv_same(report, dv_find(actor, "last_reason_report", false)):
        actor = dv_with_many(actor, {"last_cognitive_event": dvs_event(events, "reason_stop", actor.id, time, dvs_cognitive_parents(actor, dv_single(parent)), report), "last_reason_report": report})
    return dv_with_many(actor, {"mind": mind, "inference_derivations": derivations, "inference_signatures": signatures, "policy": dv_with(policy, "reason_budget", (budget - count))})

fn dvs_cached_model(actor, hypothesis):
    var model = dv_find(dv_find(actor, "simulations", []), hypothesis.id, {"fit": 0, "status": "not-simulated"})
    if dv_or((dv_find(model, "source_revision", -1) == actor.mind.revision), dv_and(dv_explanation_model_current(actor.mind, model), dv_same(dv_find(model, "source_response_models", false), dv_find(actor, "response_models", [])))):
        return dv_with(model, "validated_by_inputs", true)
    else:
        if dv_and(dvs_argument_valid(actor), dvs_argument_inputs_current(actor)):
            var argument = actor.argument
            if dv_and((dv_find(model, "source_revision", -1) == argument.source_revision), dv_or((dv_find(model, "event", "") == argument.model_event), dv_has(argument.competitor_events, dv_find(model, "event", "")))):
                return dv_with(model, "validated_by_argument", argument.id)
            else:
                return {"fit": 0, "status": "stale-or-unavailable", "source_revision": dv_find(model, "source_revision", -1)}
        else:
            return {"fit": 0, "status": "stale-or-unavailable", "source_revision": dv_find(model, "source_revision", -1)}

fn dvs_working_explanation(actor, hypothesis):
    if dvs_factor_candidate_rejected(actor, hypothesis):
        return false
    return dv_and(dvp_topic(actor, hypothesis), dv_and((0 < rt_count(dv_find(hypothesis, "features", []))), dv_and((0 < rt_count(dvs_sim_plan(hypothesis))), dv_and((0 < rt_count(dv_find(hypothesis, "basis", []))), dv_and((dv_truth(actor.mind, dv_find(hypothesis, "available_when", dv_true())) == "true"), (not (dv_truth(actor.mind, hypothesis.proposition) == "false")))))))

fn dvs_hypotheses(actor, events, time, parent):
    var mind = actor.mind
    var candidates = dv_find(actor.policy, "hypotheses", [])
    var i = 0
    var best = false
    var score = -1
    var working = false
    while (i < rt_count(candidates)):
        if dvs_working_explanation(actor, candidates[i]):
            working = true
        i = (i + 1)
    i = 0
    while (i < rt_count(candidates)):
        var h = candidates[i]
        if not dvs_factor_candidate_rejected(actor, h):
            var available = dv_find(h, "available_when", dv_true())
            var local_1 = false
            if working:
                local_1 = dvs_working_explanation(actor, h)
            else:
                local_1 = true
            if dv_and(local_1, dv_and(dvp_topic(actor, h), dv_and((0 < rt_count(dv_find(h, "basis", []))), (dv_truth(mind, available) == "true")))):
                var truth = dv_truth(mind, h.proposition)
                var local_2 = false
                if (truth == "false"):
                    local_2 = -1
                else:
                    if (truth == "true"):
                        local_2 = 1
                    else:
                        local_2 = dv_find(h, "prior", 0.5)
                var weight = local_2
                var model = dvs_cached_model(actor, h)
                weight = (weight + model.fit)
                if dv_or((truth == "false"), (dv_find(model, "status", "unknown") == "inconsistent")):
                    false
                else:
                    if (score < weight):
                        best = dv_with(h, "simulation", model)
                        score = weight
        i = (i + 1)
    var previous = dv_find(actor, "hypothesis", false)
    var event = dv_find(actor, "hypothesis_event", "")
    if dv_same(previous, best):
        false
    else:
        var local_3 = false
        if (previous == false):
            local_3 = "hypothesis_adopted"
        else:
            local_3 = "hypothesis_revised"
        event = dvs_event(events, local_3, actor.id, time, dvs_cognitive_parents(actor, dv_single(parent)), {"previous": previous, "current": best, "mind": mind, "preference": score})
    if (event == dv_find(actor, "hypothesis_event", "")):
        false
    else:
        actor = dv_with(actor, "last_cognitive_event", event)
    return dv_with_many(actor, {"hypothesis": best, "hypothesis_event": event})

fn dvs_choose(actor, bindings, costs):
    let key = ["dvp_plan", dvp_memo_input(actor, costs), bindings, costs]
    let cached = rt_memo_get(actor.mind, key)
    if cached[0]:
        return dvs_honor_planned_followup(actor, dv_with_many(cached[1], {"plan_expansions": 0, "dependency_expansions": 0, "plan_cache_hit": true, "reused_plan_expansions": cached[1].plan_expansions, "reused_dependency_expansions": dv_find(cached[1], "dependency_expansions", 0)}))
    return dvs_honor_planned_followup(actor, rt_memo_put(actor.mind, key, dvp_plan(actor, bindings, costs)))

// Keep the actor's own predicted next step after a successful move, provided
// the fresh plan still finds that action directly eligible and valuable.
fn dvs_honor_planned_followup(actor, choice):
    let followup = dv_find(actor, "planned_followup", "")
    if followup == "":
        return choice
    var i = 0
    while i < rt_count(choice.plans):
        let plan = choice.plans[i]
        if rt_count(plan.path) == 1 and plan.path[0] == followup and 0 < plan.score:
            let action = dvp_find_action(actor.actions, followup)
            if action != false:
                return dv_with_many(choice, {"action": action, "score": plan.score, "selected_path": plan.path, "planned_followup_honored": true, "superseded_path": choice.selected_path})
        i = i + 1
    return dv_with(choice, "planned_followup_honored", false)

fn dvs_ready(actor, events, time, parent):
    var hypothesis = dv_find(actor, "hypothesis", false)
    var ready = true
    var reasons = []
    var parents = dvs_cognitive_parents(actor, dv_single(parent))
    var local_1 = false
    if dv_has_key(actor, "question_ref"):
        local_1 = dv_read(actor.mind, actor.question_ref)
    else:
        local_1 = dv_unknown()
    var question = local_1
    if dv_uncontested(question):
        false
    else:
        ready = false
        rt_push(reasons, "current-public-question-unobserved")
    if (hypothesis == false):
        ready = false
        rt_push(reasons, "no-seriously-adopted-hypothesis")
    else:
        var simulation = dv_find(hypothesis, "simulation", [])
        var candidates = dv_find(actor.policy, "hypotheses", [])
        var i = 0
        var simulations = dv_find(actor, "simulations", [])
        var mind = actor.mind
        var local_2 = false
        if dv_has_key(simulation, "validated_by_argument"):
            local_2 = dv_and(dvs_argument_valid(actor), dvs_argument_inputs_current(actor))
        else:
            local_2 = false
        if dv_or((dv_find(simulation, "source_revision", -1) == mind.revision), dv_or(dv_find(simulation, "validated_by_inputs", false), local_2)):
            false
        else:
            ready = false
            rt_push(reasons, "simulation-evidence-version-stale")
        var local_3 = false
        if dv_has_key(simulation, "validated_by_argument"):
            local_3 = actor.argument.source_revision
        else:
            local_3 = mind.revision
        if dv_explanation_model_complete(simulation, "explained", local_3):
            false
        else:
            ready = false
            rt_push(reasons, "simulation-incomplete-or-unknown")
        if dv_has_key(simulation, "validated_by_argument"):
            rt_push(parents, simulation.validated_by_argument)
        if dv_has_key(simulation, "event"):
            rt_push(parents, simulation.event)
        else:
            ready = false
            rt_push(reasons, "missing-paid-simulation-event")
        while (i < rt_count(candidates)):
            var candidate = candidates[i]
            if dv_and((not (candidate.id == hypothesis.id)), dv_and(dvp_topic(actor, candidate), dv_and((dv_find(candidate, "group", "") == dv_find(hypothesis, "group", "")), (dv_truth(mind, dv_find(candidate, "available_when", dv_true())) == "true")))):
                var other = dvs_cached_model(actor, candidate)
                var local_4 = false
                if dv_and(dvs_argument_valid(actor), dvs_argument_inputs_current(actor)):
                    local_4 = dvs_factor_covered(candidate, dv_find(actor.argument, "factor_coverage", {"catalog": [], "certificates": []}).certificates)
                else:
                    local_4 = false
                if dv_or((dv_find(other, "status", "unknown") == "inconsistent"), local_4):
                    if dv_has_key(other, "event"):
                        rt_push(parents, other.event)
                    else:
                        if dv_and(dvs_argument_valid(actor), dvs_argument_inputs_current(actor)):
                            rt_push(parents, actor.argument.id)
                        else:
                            ready = false
                            rt_push(reasons, "missing-competitor-simulation-event")
                else:
                    ready = false
                    rt_push(reasons, rt_cat("unresolved-competitor:", candidate.id))
            i = (i + 1)
    if ready:
        if dv_same(dv_find(actor, "ready_hypothesis", false), hypothesis):
            return actor
        else:
            actor = dv_with(actor, "last_cognitive_event", dvs_event_prepared(events, "answer_ready", actor.id, time, parents, dv_with_many({"hypothesis": hypothesis, "mind_revision": actor.mind.revision, "question_id": dv_find(hypothesis, "question", question.value), "actor_id": actor.id}, {"argument": dv_find(actor, "argument", false), "argument_question": dv_find(hypothesis, "question", question.value)})))
            return dv_with(actor, "ready_hypothesis", hypothesis)
    else:
        let report = {"reasons": reasons, "hypothesis": hypothesis, "mind_revision": actor.mind.revision}
        let previous_report = dv_find(actor, "last_readiness_report", false)
        // Revision alone is not a new readiness explanation; retain the original
        // event's revision, and emit again if reasons or the supported model change.
        if previous_report == false or not dv_same(dv_without(report, "mind_revision"), dv_without(previous_report, "mind_revision")):
            dvs_event(events, "why_not_ready", actor.id, time, parents, report)
        return dv_with(actor, "last_readiness_report", report)

fn dvs_reason(actor, events, time, parent):
    var refreshed = dvs_refresh_derivations(actor, events, time, parent)
    if dv_find(refreshed, "cognition_blocked", false):
        return refreshed
    else:
        return dvs_reason_run(refreshed, events, time, parent)

// Fresh prepared data and borrowed data share the same immutable evidence boundary.
fn dvs_event_prepared(events, kind, actor, time, parents, data):
    return dvs_event(events, kind, actor, time, parents, data)

// Stage-local memo: only inference is reused; other cognition keeps its normal order.
fn dvs_reason_input(actor):
    let adoptions = actor.mind.adoptions
    let key = ["reason_input_refs"]
    let cached = rt_memo_get(adoptions, key)
    var refs = []
    if cached[0]:
        refs = cached[1]
    else:
        var i = 0
        while i < rt_count(adoptions):
            let adoption = adoptions[i][1]
            if adoption.mode == "infer":
                refs = dvp_merge_refs(refs, dvs_sim_refs(adoption.law.premise))
                var j = 0
                while j < rt_count(adoption.law.effects):
                    refs = dvp_add_ref(refs, adoption.law.effects[j].ref)
                    j = j + 1
            i = i + 1
        rt_memo_put(adoptions, key, refs)
    let derivations = dv_find(actor, "inference_derivations", [])
    var i = 0
    while i < rt_count(derivations):
        let inputs = derivations[i].inputs
        var j = 0
        while j < rt_count(inputs):
            refs = dvp_add_ref(refs, inputs[j].ref)
            j = j + 1
        i = i + 1
    var cells = []
    i = 0
    while i < rt_count(refs):
        rt_push(cells, {"ref": refs[i], "cell": dvs_reason_cell(dv_read(actor.mind, refs[i]))})
        i = i + 1
    return {"adoptions": adoptions, "inputs": cells, "derivations": derivations, "signatures": dv_find(actor, "inference_signatures", []), "budget": dv_find(actor.policy, "reason_budget", 0), "blocked": dv_find(actor, "cognition_blocked", false)}

fn dvs_prepare_cognition(actor, events, time, parent, chapter):
    let input = dvs_reason_input(actor)
    var reused = dv_same(input, dv_find(actor, "reason_fixed_input", false))
    if not reused:
        actor = dvs_reason(actor, events, time, parent)
        let completed = dvs_reason_input(actor)
        if dv_same(input, completed) and not dv_find(actor, "cognition_blocked", false):
            actor = dv_with(actor, "reason_fixed_input", rt_snapshot(completed))
        else:
            actor = dv_with(actor, "reason_fixed_input", false)
    actor = dvs_ready(dvs_hypotheses(dvs_pragmatics_reconsider(actor, events, time, parent), events, time, parent), events, time, parent)
    actor = dvs_update_support_events(actor, events)
    actor = dvs_capture_public_topics(actor, events, time, parent)
    actor = dvs_materialize_arguments(dvs_arguments(actor, events, time, parent))
    actor = dvs_prepare_speech_choices(actor, events, time, parent)
    return dv_with_many(actor, {"cognition_input": false, "cognition_reused": false, "reason_reused": reused})

// ---- Merged source module: 16-personal-choice.dv ----
fn dvp_choice_groups(actions):
    var groups = []
    var i = 0
    while i < rt_count(actions):
        let action = actions[i]
        if dv_has_key(action, "personal_choice"):
            let group = action.personal_choice.group
            groups = dv_with(groups, group, dv_append(dv_find(groups, group, []), action))
        i = i + 1
    return groups

// Ordinal personal values are owned by the subject, not by the proposed action.

fn dvp_personal_ready(mind, choice):
    return (0 < rt_count(dv_find(choice, "basis", [])) and dv_truth(mind, choice.requires) == "true" and dv_truth(mind, choice.prohibits) == "false")

fn dvp_personal_impact(choice, value):
    var impact = 0
    if dv_has(choice.promotes, value):
        impact = impact + 1
    if dv_has(choice.sacrifices, value):
        impact = impact - 1
    return impact

fn dvp_personal_better(order, left, right):
    var i = 0
    while (i < rt_count(order)):
        let a = dvp_personal_impact(left, order[i])
        let b = dvp_personal_impact(right, order[i])
        if (a != b):
            return b < a
        i = i + 1
    return false

fn dvp_received_speech_matches(receipts, requirement):
    dv_require(dv_record_like(requirement), "Received speech requirement must be a record")
    var i = 0
    while i < rt_count(receipts):
        let receipt = receipts[i]
        if receipt.speaker == requirement.speaker and receipt.action_id == requirement.action_id and receipt.parse_event != "" and receipt.source_event != "":
            return true
        i = i + 1
    return false

fn dvp_owner_requirements(actor, action, mind):
    if not dvs_actor_can_act(actor):
        return false
    let resonance = dv_find(action, "resonance", false)
    if resonance != false:
        dv_require(dv_record_like(resonance), "Resonance must be a record")
        if not dv_find(resonance, "passive", false):
            if not (0 < dvp_resonance_utility(actor, action, mind)):
                return false
    let night_call = dv_find(action, "night_call_requirement", false)
    if night_call != false:
        dv_require(dv_record_like(night_call), "Night call requirement must be a record")
        if not dv_find(actor, "night_call_eligible", false) or rt_count(dv_find(night_call, "basis", [])) == 0 or dv_truth(mind, night_call.night_when) != "true":
            return false
    let conflict = dv_find(action, "received_claim_conflict", false)
    if conflict != false:
        dv_require(dv_record_like(conflict), "Received claim conflict must be a record")
        let conflicts = dv_find(actor, "observed_claim_conflicts", [])
        var found_conflict = false
        var conflict_index = 0
        while conflict_index < rt_count(conflicts):
            let evidence = conflicts[conflict_index]
            dv_require(dv_record_like(evidence), "Observed claim conflict must be a record")
            if evidence.key == conflict.key and evidence.speaker == conflict.speaker:
                if dv_find(evidence, "source_event", "") != "" and dv_find(evidence, "previous_source", "") != "" and dv_find(evidence, "parse_event", "") != "" and 0 < rt_count(dv_find(evidence, "basis", [])):
                    found_conflict = true
            conflict_index = conflict_index + 1
        if not found_conflict:
            return false
    let opportunity = dv_find(action, "opportunity_requirement", false)
    if opportunity != false:
        dv_require(dv_record_like(opportunity), "Opportunity requirement must be a record")
        let own = dv_read(mind, actor.location_ref)
        if not dv_uncontested(own) or own.value != opportunity.location:
            return false
        let context = dv_find(actor, "visible_context", [])
        var present = 0
        var i = 0
        while i < rt_count(opportunity.participants):
            let id = opportunity.participants[i]
            let peer = dv_find(context, id, false)
            if id == actor.id:
                present = present + 1
            else:
                if peer != false:
                    if peer.location == opportunity.location:
                        present = present + 1
            i = i + 1
        if opportunity.mode == "all-present" and present != rt_count(opportunity.participants):
            return false
        if opportunity.mode == "at-least-one-present" and present == 0:
            return false
    let heard = dv_find(action, "received_speech_requirement", false)
    if heard != false:
        dv_require(dv_record_like(heard), "Received speech requirement must be a record")
        let receipts = dv_find(actor, "received_speeches", [])
        var found = false
        if dv_has_key(heard, "any_of"):
            dv_require(rt_is_list(heard.any_of), "Received speech any_of must be a list")
            var i = 0
            while i < rt_count(heard.any_of):
                if dvp_received_speech_matches(receipts, heard.any_of[i]):
                    found = true
                i = i + 1
        else:
            found = dvp_received_speech_matches(receipts, heard)
        if not found:
            return false
    if dv_find(action, "response_once", false) and dv_has(dv_find(actor, "completed_actions", []), action.id):
        return false
    let superseded = dv_find(action, "suppress_after_received_speech", false)
    if superseded != false:
        dv_require(dv_record_like(superseded), "Suppressing speech requirement must be a record")
        if dvp_received_speech_matches(dv_find(actor, "received_speeches", []), superseded):
            return false
    let completed = dv_find(action, "completed_action_requirement", false)
    if completed != false:
        dv_require(dv_record_like(completed), "Completed action requirement must be a record")
        if not dv_has(dv_find(actor, "completed_actions", []), completed.action_id):
            return false
    let desire = dv_find(action, "desire_requirement", false)
    if desire != false:
        dv_require(dv_record_like(desire), "Desire requirement must be a record")
        if desire.subject != actor.id:
            return false
        let desires = dv_find(actor.policy, "desires", [])
        var found = false
        var i = 0
        while i < rt_count(desires):
            if desires[i].id == desire.desire_id and 0 < rt_count(dv_find(desires[i], "basis", [])):
                found = true
            i = i + 1
        if not found:
            return false
    return true

fn dvp_eligible(actor, action, mind, relevant):
    if (not dvp_eligible_base(actor, action, mind, relevant)):
        return false
    return dvp_eligible_after_base(actor, action, mind, relevant)

fn dvp_eligible_after_base(actor, action, mind, relevant):
    if not dvp_owner_requirements(actor, action, mind):
        return false
    if not dvp_normative_ready(actor, action, mind):
        return false
    let attitude = dv_find(action, "owner_interpretation_requirement", false)
    if attitude != false:
        dv_require(dv_record_like(attitude), "Owner interpretation requirement must be a record")
        let interpretation = dv_find(dv_find(actor, "interpretations", []), attitude.interpretation_id, false)
        if interpretation == false:
            return false
        dv_require(dv_record_like(interpretation), "Owner interpretation must be a record")
        if attitude.subject != actor.id or interpretation.status != attitude.required_status or dv_find(interpretation, "source_event", "") == "":
            return false
    if (not dv_has_key(action, "personal_choice")):
        return true
    let choice = action.personal_choice
    if (not dvp_personal_ready(mind, choice)):
        return false
    let order = dv_find(actor.policy, "value_order", [])
    if (rt_count(order) == 0 or rt_count(dv_find(actor.policy, "value_basis", [])) == 0):
        return false
    if dv_find(choice, "require_positive", false):
        var value_index = 0
        var first = 0
        while value_index < rt_count(order) and first == 0:
            first = dvp_personal_impact(choice, order[value_index])
            value_index = value_index + 1
        if first <= 0:
            return false
    var alternatives = actor.actions
    if dv_has_key(actor, "planning_choice_groups"):
        alternatives = dv_find(actor.planning_choice_groups, choice.group, [])
    var i = 0
    while (i < rt_count(alternatives)):
        let other = alternatives[i]
        if (other.id != action.id and dv_has_key(other, "personal_choice")):
            if (other.personal_choice.group == choice.group and dvp_personal_ready(mind, other.personal_choice)):
                if (dvp_eligible_base(actor, other, mind, relevant) and dvp_owner_requirements(actor, other, mind) and dvp_normative_ready(actor, other, mind) and dvp_personal_better(order, other.personal_choice, choice)):
                    return false
        i = i + 1
    return true

// Norms affect this owner's choice; they never become physical prohibitions.
fn dvp_normative_ready(actor, action, mind):
    let decision = dv_find(action, "norm_decision", false)
    if decision != false:
        dv_require(dv_record_like(decision), "Norm decision must be a record")
        let proposal = dv_find(dv_find(actor, "norm_proposals", []), decision.id, false)
        if proposal == false:
            return false
        dv_require(dv_record_like(proposal), "Received norm proposal must be a record")
        if dv_find(proposal, "source_event", "") == "" or dv_find(proposal, "parse_event", "") == "" or not dv_same(proposal.norm, decision.norm):
            return false
    // An unsupervised act is valued by its owner, independently of a public pledge.
    let private = dv_find(action, "private_execution", false)
    if private != false:
        dv_require(dv_record_like(private), "Private execution must be a record")
        if rt_count(dv_find(private, "basis", [])) == 0 or dv_truth(mind, private.requires) != "true":
            return false
        if dvp_owned_quantity(actor, mind, private.benefit) <= dvp_owned_quantity(actor, mind, private.resource_cost):
            return false
    let method = dv_find(action, "normative_method", "")
    if method == "":
        return true
    let rules = dv_find(actor.policy, "norm_rules", [])
    let order = dv_find(actor.policy, "value_order", [])
    let choice = dv_find(action, "personal_choice", {"promotes": [], "sacrifices": []})
    var matched = false
    var applicable = []
    var i = 0
    while i < rt_count(rules):
        let rule = rules[i]
        if method != "" and rule.method == method and 0 < rt_count(rule.basis) and dv_truth(mind, rule.available_when) == "true":
            rt_push(applicable, rule)
            matched = true
        i = i + 1
    if not matched:
        return true
    i = 0
    while i < rt_count(order):
        var impact = dvp_personal_impact(choice, order[i])
        var j = 0
        while j < rt_count(applicable):
            let rule = applicable[j]
            let value = dvp_personal_impact({"promotes": dv_find(rule, "promotes", []), "sacrifices": dv_find(rule, "sacrifices", [])}, order[i])
            if rule.mode == "forbid":
                impact = impact - value
            else:
                impact = impact + value
            j = j + 1
        if impact != 0:
            return 0 < impact
        i = i + 1
    return true

// All numeric inputs are explicit owner declarations or uncontested owner knowledge.
fn dvp_owned_quantity(actor, mind, declaration):
    if rt_is_numeric_value(declaration):
        return declaration
    if declaration == false:
        return 0
    dv_require(dv_record_like(declaration), "Owned quantity must be a number or record")
    if dv_has_key(declaration, "policy_key"):
        let quantity = dv_find(actor.policy, declaration.policy_key, 0)
        dv_require(rt_is_numeric_value(quantity), "Owned policy quantity must be numeric")
        return quantity
    dv_require(dv_has_key(declaration, "ref"), "Owned quantity needs policy_key or ref")
    dv_require(dv_record_like(declaration.ref), "Owned quantity ref must be a record")
    let cell = dv_read(mind, declaration.ref)
    if dv_uncontested(cell) and rt_is_numeric_value(cell.value):
        return cell.value
    return 0

fn dvp_resonance_utility(actor, action, mind):
    let r = action.resonance
    dv_require(dv_record_like(r), "Resonance must be a record")
    if rt_count(dv_find(r, "basis", [])) == 0 or dv_truth(mind, dv_find(r, "requires", dv_true())) != "true":
        return 0
    let retrieved = dv_find(r, "retrieved_when", false)
    if retrieved != false and dv_truth(mind, retrieved) == "true":
        return 0
    let drive = dvp_owned_quantity(actor, mind, r.drive)
    let relevance = dvp_owned_quantity(actor, mind, r.relevance)
    let bonus = dvp_owned_quantity(actor, mind, r.truth_bonus)
    let caution = dvp_owned_quantity(actor, mind, r.caution)
    let risk = dvp_owned_quantity(actor, mind, r.perceived_risk)
    return drive * relevance + bonus - caution - risk

// Keep owner-only utility inputs in the planning dependency signature and slice.
fn dvp_owner_requirement_refs(action):
    var refs = []
    let r = dv_find(action, "resonance", false)
    if r != false:
        dv_require(dv_record_like(r), "Resonance must be a record")
        if not dv_find(r, "passive", false):
            refs = dvp_merge_refs(refs, dvs_sim_refs(dv_find(r, "requires", dv_true())))
            let retrieved = dv_find(r, "retrieved_when", false)
            if retrieved != false:
                refs = dvp_merge_refs(refs, dvs_sim_refs(retrieved))
            let quantities = [r.drive, r.relevance, r.truth_bonus, r.caution, r.perceived_risk]
            var i = 0
            while i < rt_count(quantities):
                let quantity = quantities[i]
                if quantity != false and not rt_is_numeric_value(quantity):
                    dv_require(dv_record_like(quantity), "Owned quantity must be a number or record")
                    if not dv_has_key(quantity, "policy_key"):
                        dv_require(dv_has_key(quantity, "ref"), "Owned quantity needs policy_key or ref")
                        dv_require(dv_record_like(quantity.ref), "Owned quantity ref must be a record")
                        refs = dvp_add_ref(refs, quantity.ref)
                i = i + 1
    let night = dv_find(action, "night_call_requirement", false)
    if night != false:
        dv_require(dv_record_like(night), "Night call requirement must be a record")
        refs = dvp_merge_refs(refs, dvs_sim_refs(night.night_when))
    return refs

fn dvs_actor_can_act(actor):
    let stage = dv_find(actor, "erosion_stage", "early")
    return stage != "terminal" and stage != "death"

// A reproducible integer stream; samples are selected only from declared options.
fn dvs_cognitive_seed_next(seed):
    let n = seed * 48271 + 1
    return n - rt_floor(n / 2147483647) * 2147483647

fn dvs_initialize_cognition(actor, seed, ordinal):
    dv_require(0 <= seed and rt_floor(seed) == seed, "Opening seed must be a nonnegative integer")
    let declaration = dv_find(actor, "cognitive_initialization", false)
    if declaration == false:
        if dv_has_key(actor, "erosion"):
            return dv_with(actor, "first_day_mind", actor.mind)
        return actor
    dv_require(rt_count(dv_find(declaration, "basis", [])) > 0, "Cognitive initialization needs declared provenance")
    var stream = dvs_cognitive_seed_next(seed + ordinal)
    var policy = actor.policy
    let samples = dv_find(declaration, "samples", [])
    var selected = []
    var i = 0
    while i < rt_count(samples):
        let sample = samples[i]
        dv_require(0 < rt_count(dv_find(sample, "basis", [])), "Cognitive sample needs provenance")
        let options = sample.options
        dv_require(0 < rt_count(options), "Empty cognitive sample domain")
        stream = dvs_cognitive_seed_next(stream)
        let index = stream - rt_floor(stream / rt_count(options)) * rt_count(options)
        policy = dv_with(policy, sample.key, options[index])
        selected = dv_with(selected, sample.key, options[index])
        i = i + 1
    policy = dv_with_many(policy, dv_find(declaration, "profile", []))
    return dv_with_many(actor, {"policy": policy, "cognitive_seed": seed, "cognitive_samples": selected, "first_day_mind": actor.mind})

// Erosion is content-defined exposure/threshold data, with an explicit first-day snapshot.
fn dvs_erosion_update(actor, physical, time):
    let erosion = dv_find(actor, "erosion", false)
    if erosion == false:
        return actor
    let exposure_cell = dv_read(physical, erosion.physical_ref)
    var exposure = 0
    if dv_uncontested(exposure_cell) and rt_is_numeric_value(exposure_cell.value):
        exposure = exposure_cell.value
    exposure = exposure * (1 + dv_find(actor, "resonance_coupling", 0) * dv_find(erosion, "coupling_factor", 0))
    let stages = ["early", "middle", "late", "terminal", "death"]
    var rank = dv_find(actor, "erosion_rank", 0)
    var i = 0
    while i < rt_count(erosion.thresholds):
        let threshold = erosion.thresholds[i]
        if threshold.at <= exposure and rank < threshold.rank:
            rank = threshold.rank
        i = i + 1
    dv_require(0 <= rank and rank < rt_count(stages), "Invalid erosion stage")
    var result = dv_with_many(actor, {"erosion_rank": rank, "erosion_stage": stages[rank]})
    let memory_period = dv_find(erosion, "memory_period", 1440)
    dv_require(0 < memory_period, "Erosion memory period must be positive")
    let memory_epoch = rt_floor(time / memory_period)
    if 2 <= rank and (not dv_find(actor, "erosion_memory_truncated", false) or dv_find(actor, "erosion_memory_epoch", -1) != memory_epoch):
        dv_require(dv_has_key(actor, "first_day_mind"), "Late erosion needs declared first-day memory snapshot")
        let old = actor.mind
        let memory = dv_with_many(actor.first_day_mind, {"time": time, "revision": old.revision + 1})
        result = dv_with_many(result, {"mind": memory, "erosion_memory_truncated": true, "erosion_memory_epoch": memory_epoch, "simulations": [], "interpretations": [], "response_models": [], "proposals": [], "received_speeches": [], "pending_heard": [], "observed_public_claims": [], "observed_claim_conflicts": [], "pending_player_influences": [], "dependency_cache": false})
    return result

// Only the actual audible reception path invokes this, never speaker forecasts.
fn dvs_receive_public_claim(listener, speech, speaker, source, parse_event):
    let claim = dv_find(speech, "public_claim", false)
    if claim == false:
        return listener
    dv_require(0 < rt_count(dv_find(claim, "basis", [])), "Public claim needs content provenance")
    let history = dv_find(listener, "observed_public_claims", [])
    var conflicts = dv_find(listener, "observed_claim_conflicts", [])
    var i = 0
    while i < rt_count(history):
        let prior = history[i]
        if prior.speaker == speaker and prior.key == claim.key and dv_has(dv_find(claim, "conflicts_with", []), prior.value):
            conflicts = dv_append(conflicts, {"speaker": speaker, "key": claim.key, "previous_source": prior.source_event, "source_event": source, "parse_event": parse_event, "basis": claim.basis})
        i = i + 1
    let received = {"speaker": speaker, "key": claim.key, "value": claim.value, "source_event": source, "parse_event": parse_event}
    return dv_with_many(listener, {"observed_public_claims": dv_append(history, received), "observed_claim_conflicts": conflicts})

// Called only by actual Complete. Passive flashbacks do not acquire paid coupling.
fn dvs_complete_cognitive_effects(actor, action, success, event, time):
    if not success:
        return actor
    var result = actor
    let r = dv_find(action, "resonance", false)
    if r != false:
        dv_require(dv_record_like(r), "Resonance must be a record")
    if r != false and not dv_find(r, "passive", false):
        let retrieved = dv_find(r, "retrieved_when", {"op": "constant", "value": "false"})
        if dv_truth(actor.mind, retrieved) == "true":
            let coupling = dv_find(actor, "resonance_coupling", 0) + dv_find(r, "coupling", 0)
            var policy = actor.policy
            var trust = dv_find(policy, "speaker_trust", [])
            let changes = dv_find(r, "trust_changes", [])
            var i = 0
            while i < rt_count(changes):
                let change = changes[i]
                trust = dv_with(trust, change.subject, dv_unit(dv_min(1, dv_max(0, dv_find(trust, change.subject, 0.5) + change.delta))))
                i = i + 1
            policy = dv_with(policy, "speaker_trust", trust)
            result = dv_with_many(result, {"resonance_coupling": coupling, "night_call_eligible": dv_find(actor, "night_call_eligible", false) or dv_find(r, "night_call", false), "policy": policy, "resonance_receipts": dv_append(dv_find(actor, "resonance_receipts", []), {"event": event, "time": time, "action": action.id, "coupling": coupling})})
    let influence = dv_find(action, "influence_consequence", false)
    if influence != false:
        if 0 < rt_count(dv_find(influence, "basis", [])) and dv_truth(actor.mind, influence.consequence_when) == "true":
            let heard = dv_find(actor, "received_speeches", [])
            var i = 0
            while i < rt_count(heard):
                let speech = heard[i]
                if speech.speaker == influence.speaker and speech.action_id == influence.action_id:
                    result = dv_with(result, "influence_consequences", dv_append(dv_find(result, "influence_consequences", []), {"speech_event": speech.source_event, "parse_event": speech.parse_event, "execution_event": event, "action": action.id, "time": time, "basis": influence.basis}))
                i = i + 1
    return result

// An explicit speech declaration records intent only after actual player emission
// and audible parsing. No forecast enters this provenance ledger.
fn dvs_receive_player_influence(listener, speech, speaker, source, parse_event):
    let manipulation = dv_find(speech, "manipulation", false)
    if manipulation == false or dv_find(speech, "actual_player_actor", "") != speaker or dv_find(speech, "actual_literal_truth", "unknown") != "true":
        return listener
    if not dv_has(dv_find(manipulation, "targets", []), listener.id) or rt_count(dv_find(manipulation, "basis", [])) == 0:
        return listener
    let receipt = {"player": speaker, "target": listener.id, "method": manipulation.method, "speech_event": source, "parse_event": parse_event, "declaration": manipulation}
    return dv_with(listener, "pending_player_influences", dv_append(dv_find(listener, "pending_player_influences", []), receipt))

// A declared behavioral effect must actually execute and its physical consequence
// must become true. Intent, interpretation and prediction do not count as outcome.
fn dvs_complete_player_influences(actor, action, before, after, success, event, time):
    if not success:
        return actor
    let pending = dv_find(actor, "pending_player_influences", [])
    if rt_count(pending) == 0:
        return actor
    var retained = []
    var history = dv_find(actor, "player_influence_history", [])
    var i = 0
    while i < rt_count(pending):
        let influence = pending[i]
        let declaration = influence.declaration
        var completed = false
        if dv_has(dv_find(declaration, "action_ids", []), action.id):
            let prior = dv_truth(before, declaration.consequence_when)
            let actual = dv_truth(after, declaration.consequence_when)
            if prior != "true" and actual == "true":
                history = dv_append(history, {"player": influence.player, "target": actor.id, "method": influence.method, "speech_event": influence.speech_event, "parse_event": influence.parse_event, "execution_event": event, "action": action.id, "time": time, "consequence": declaration.consequence_when, "before": prior, "after": actual, "basis": declaration.basis})
                completed = true
        if not completed:
            rt_push(retained, influence)
        i = i + 1
    return dv_with_many(actor, {"pending_player_influences": retained, "player_influence_history": history})

// ---- Merged source module: 18-requests.dv ----
// Requests are received speech; replies remain the other subject's paid action.

fn dvs_pending_request(actor, action):
    var topic = dv_find(action, "response_topic", "")
    var requests = dv_find(actor, "received_requests", [])
    var answered = dv_find(actor, "answered_requests", [])
    var result = []
    var i = 0
    while dv_and((rt_count(result) == 0), (i < rt_count(requests))):
        var request = requests[i]
        if dv_and((request.topic == topic), (not dv_has(answered, request.parse_event))):
            result = request
        i = (i + 1)
    return result

fn dvs_receive_request(actor, speech, parse_event, source, speaker):
    var request = dv_find(speech, "request", false)
    if (request == false):
        return actor
    else:
        if (request.target == actor.id):
            return dv_with(actor, "received_requests", dv_append(dv_find(actor, "received_requests", []), dv_with_many({"topic": request.topic, "parse_event": parse_event, "source_event": source}, {"requester": speaker, "request": request})))
        else:
            return actor

fn dvs_finish_reply(actor, action):
    var request = dvs_pending_request(actor, action)
    if (0 < rt_count(request)):
        return dv_with(actor, "answered_requests", dv_append(dv_find(actor, "answered_requests", []), request.parse_event))
    else:
        return actor

fn dvs_record_request(actor, action):
    var request = dv_find(dv_find(action, "speech", []), "request", false)
    if (request == false):
        return actor
    else:
        return dv_with(actor, "request_contexts", dv_with(dv_find(actor, "request_contexts", []), action.id, dvs_request_context(actor, action, request.target)))

fn dvs_request_inputs(mind, proposition):
    let refs = dvs_sim_refs(proposition)
    var inputs = []
    var i = 0
    while i < rt_count(refs):
        let cell = dv_read(mind, refs[i])
        rt_push(inputs, {"ref": refs[i], "known": dv_find(cell, "known", false), "value": dv_find(cell, "value", false), "conflicted": dv_find(cell, "conflicted", false)})
        i = i + 1
    return {"inputs": inputs, "truth": dv_truth(mind, proposition)}

fn dvs_request_context(actor, action, target):
    let topic = dv_find(dv_find(dv_find(action, "speech", []), "request", []), "topic", dv_find(action, "response_topic", ""))
    let visible = dv_find(dv_find(actor, "visible_context", []), target, false)
    if (visible != false):
        return {"target": target, "topic": topic, "location": visible.location, "inputs": dvs_request_inputs(actor.mind, action.precondition)}
    let transport = dv_find(action, "request_transport", false)
    if (transport == false):
        return false
    let channels = dv_find(actor, "request_channels", [])
    var i = 0
    while (i < rt_count(channels)):
        let channel = channels[i]
        if (channel.target == target and channel.channel == transport.channel and 0 < rt_count(channel.basis)):
            if (dv_truth(actor.mind, channel.available_when) == "true"):
                return {"target": target, "topic": topic, "channel": channel.channel, "basis": channel.basis, "inputs": dvs_request_inputs(actor.mind, action.precondition), "channel_inputs": dvs_request_inputs(actor.mind, channel.available_when)}
        i = i + 1
    return false

fn dvs_visible_context(actor, physical, actors):
    var result = []
    if dv_truth(physical, dv_find(actor.policy, "visual_identity_when", dv_true())) != "true":
        return result
    var own = dv_read(physical, actor.location_ref)
    var i = 0
    while (i < rt_count(actors)):
        var other = actors[i]
        var position = dv_read(physical, actors[i].location_ref)
        if (other.id != actor.id) and dv_uncontested(own) and dv_uncontested(position) and dv_same(own.value, position.value):
            if dv_truth(physical, dv_find(other, "observable_presence_when", dv_true())) == "true":
                result = dv_with(result, other.id, {"location": position.value})
        i = (i + 1)
    return result

fn dvs_notice_peers(actor, physical, actors, bindings, events, time, parent):
    if dv_find(actor.policy, "notice_co_presence", false):
        var context = dvs_visible_context(actor, physical, actors)
        var old = dv_find(actor, "visible_context", [])
        if dv_same(context, old):
            return actor
        else:
            var event = dvs_event(events, "co_presence", actor.id, time, dvs_cognitive_parents(actor, dv_single(parent)), {"context_before": old, "context_after": context, "location_ref": actor.location_ref})
            var grants = []
            var i = 0
            while i < rt_count(actors):
                let peer = actors[i]
                let now = dv_find(context, peer.id, false)
                let previous = dv_find(old, peer.id, false)
                if now != false and (previous == false or previous.location != now.location):
                    rt_push(grants, peer.location_ref)
                i = i + 1
            var mind = actor.mind
            if 0 < rt_count(grants):
                let observations = dv_perceive(physical, actor.mind, bindings, grants, event, time)
                if 0 < rt_count(observations):
                    let next = dv_update_mind(mind, observations, mind.revision, dvs_observation_profile(actor)).world
                    event = dvs_event_prepared(events, "observation", actor.id, time, dv_single(event), {"observations": observations, "revision_before": mind.revision, "revision_after": next.revision, "bindings": bindings, "grants": grants, "execution_id": event})
                    mind = next
            return dv_with_many(actor, {"visible_context": context, "mind": mind, "last_cognitive_event": event})
    else:
        return actor

fn dvs_visible_action_grants(actors, speaker_index, action, before, physical, bindings, events, time, parent, execution_id):
    var listeners = dv_find(action, "public_observers", [])
    var grants = dv_find(action, "public_grants", [])
    if rt_count(listeners) == 0 or rt_count(grants) == 0:
        return actors
    var speaker = actors[speaker_index]
    var result = actors
    var i = 0
    var own = dv_read(physical, actors[speaker_index].location_ref)
    var origin = dv_read(before, actors[speaker_index].location_ref)
    while (i < rt_count(actors)):
        var actor = result[i]
        if (i != speaker_index) and dv_has(listeners, actor.id):
            var position = dv_read(physical, actor.location_ref)
            var position_before = dv_read(before, actor.location_ref)
            var present_after = dv_and(dv_uncontested(own), dv_and(dv_uncontested(position), dv_same(own.value, position.value)))
            var present_at_departure = action.kind == "move" and dv_and(dv_uncontested(origin), dv_and(dv_uncontested(position_before), dv_same(origin.value, position_before.value)))
            if dv_or(present_after, present_at_departure) and (dv_truth(physical, dv_find(actor.policy, "visual_identity_when", dv_true())) == "true"):
                var mind = actor.mind
                var observations = dv_perceive(physical, actor.mind, bindings, grants, execution_id, time)
                if (0 < rt_count(observations)):
                    var next = dv_update_mind(mind, observations, mind.revision, dvs_observation_profile(actor)).world
                    var event = dvs_event_prepared(events, "observation", actor.id, time, dvs_cognitive_parents(actor, dv_single(parent)), dv_with_many({"observations": observations, "revision_before": mind.revision, "revision_after": next.revision, "action": action}, {"bindings": bindings, "grants": grants, "execution_id": execution_id}))
                    result = dvs_replace(result, i, dv_with_many(actor, {"mind": next, "last_cognitive_event": event}))
        i = (i + 1)
    return result
// Planning retains cognition and revision; append-only audit logs are not decision inputs.
fn dvp_memo_input(actor, costs):
    var policy = actor.policy
    if dv_has_key(policy, "remaining_game_time"):
        var maximum = 0
        var i = 0
        while i < rt_count(costs):
            maximum = dv_max(maximum, costs[i][1].maximum.time)
            i = i + 1
        let bound = dv_find(policy, "plan_depth", 2) * maximum
        if bound <= policy.remaining_game_time:
            policy = dv_with(policy, "remaining_game_time", bound)
    var result = []
    var i = 0
    while i < rt_count(actor):
        let entry = actor[i]
        let key = entry[0]
        if key != "reason_fixed_input" and key != "reason_reused" and key != "decision_time" and key != "decision_revision" and key != "planning_work_total" and key != "last_cognitive_event" and key != "dependency_work_total" and key != "cognition_input" and key != "last_cognition_revision" and key != "last_cognition_time" and key != "cognition_reused" and key != "cognition_cache_reuses" and key != "last_reason_report" and key != "last_readiness_report":
            if key == "policy":
                rt_push(result, dv_pair(key, policy))
            else:
                if key == "mind":
                    rt_push(result, dv_pair(key, dv_without(dv_without(entry[1], "history"), "seen")))
                else:
                    rt_push(result, entry)
        i = i + 1
    return result

// Subject-local goals, method scopes and bounded complete-layer comparison.
// Observing a scope has information value; its unknown result is never inserted into a forecast.
// Scoring reads this local view; persistent actor updates happen outside planning.
// Public transmission progress never predicts another subject's acceptance.

fn dvp_question(actor):
    if dv_has_key(actor, "question_ref"):
        var cell = dv_read(actor.mind, actor.question_ref)
        if dv_uncontested(cell):
            return cell.value
        else:
            return ""
    else:
        return ""

fn dvp_topic(actor, item):
    if dv_find(item, "scope", "") == "personal" and 0 < rt_count(dv_find(item, "basis", [])):
        return true
    var topic = dv_find(item, "question", dv_find(item, "topic", ""))
    var question = dvp_question(actor)
    var bindings = dv_find(actor.policy, "topic_bindings", [])
    var i = 0
    var active = false
    if dv_and((not (question == "")), (topic == question)):
        active = true
    while (i < rt_count(bindings)):
        var binding = bindings[i]
        if dv_and((binding.topic == topic), dv_and((0 < rt_count(dv_find(binding, "basis", []))), dv_and(dv_or(dvs_topic_was_heard(actor, topic), (dv_truth(actor.mind, binding.heard_when) == "true")), (not (dv_truth(actor.mind, binding.completed_when) == "true"))))):
            active = true
        i = (i + 1)
    return active

fn dvp_add_ref(refs, ref):
    if dv_has(refs, ref):
        return refs
    else:
        return dv_append(refs, ref)

fn dvp_merge_refs(refs, extra):
    var result = refs
    var i = 0
    while (i < rt_count(extra)):
        result = dvp_add_ref(result, extra[i])
        i = (i + 1)
    return result

fn dvp_unmet_refs(mind, proposition, include_known):
    var op = proposition.op
    if (op == "constant"):
        return []
    else:
        if (op == "not"):
            return dvp_unmet_refs(mind, proposition.item, include_known)
        else:
            if (op == "all"):
                var items = proposition.items
                var result = []
                var i = 0
                while (i < rt_count(items)):
                    result = dvp_merge_refs(result, dvp_unmet_refs(mind, items[i], include_known))
                    i = (i + 1)
                return result
            else:
                if dv_or(include_known, (not (dv_truth(mind, proposition) == "true"))):
                    return dv_single(proposition.ref)
                else:
                    return []

fn dvp_dependency_add(graph, ref, inputs):
    let key = rt_json_stringify(ref)
    return dv_with(graph, key, dvp_merge_refs(dv_find(graph, key, []), inputs))

fn dvp_dependency_topology(mind, methods):
    let key = ["dvp_dependency_topology", methods]
    let cached = rt_memo_get(mind.adoptions, key)
    if cached[0]:
        return cached[1]
    var graph = []
    var i = 0
    while i < rt_count(mind.adoptions):
        let adoption = mind.adoptions[i][1]
        if adoption.active and adoption.mode == "infer":
            let inputs = dvs_sim_refs(adoption.law.premise)
            var j = 0
            while j < rt_count(adoption.law.effects):
                graph = dvp_dependency_add(graph, adoption.law.effects[j].ref, inputs)
                j = j + 1
        i = i + 1
    i = 0
    while i < rt_count(methods):
        let method = methods[i]
        let inputs = dvp_merge_refs(dvs_sim_refs(method.premise), dv_find(method, "owner_refs", []))
        var j = 0
        while j < rt_count(method.scope):
            graph = dvp_dependency_add(graph, method.scope[j], inputs)
            j = j + 1
        i = i + 1
    return rt_memo_put(mind.adoptions, key, graph)

fn dvp_dependencies(mind, seeds, budget, methods):
    let graph = dvp_dependency_topology(mind, methods)
    var refs = dv_clone(seeds)
    var cursor = 0
    while cursor < rt_count(refs) and cursor < budget:
        let inputs = dv_find(graph, rt_json_stringify(refs[cursor]), [])
        var i = 0
        while i < rt_count(inputs):
            if not dv_has(refs, inputs[i]):
                rt_push(refs, inputs[i])
            i = i + 1
        cursor = cursor + 1
    var stop = "dependency-closure"
    if cursor < rt_count(refs):
        stop = "dependency-budget"
    return {"refs": refs, "expanded": cursor, "stop": stop}

fn dvp_goal_refs(actor):
    var goals = dv_find(actor.policy, "goals", [])
    var mind = actor.mind
    var refs = []
    var i = 0
    while (i < rt_count(goals)):
        var goal = goals[i]
        if dv_and(dvp_topic(actor, goal), (dv_truth(actor.mind, dv_find(goal, "available_when", dv_true())) == "true")):
            if dv_has_key(goal, "ref"):
                refs = dvp_add_ref(refs, goal.ref)
            else:
                if dv_has_key(goal, "proposition"):
                    refs = dvp_merge_refs(refs, dvp_unmet_refs(mind, goal.proposition, true))
        i = (i + 1)
    return refs

fn dvp_probe_refs(actor):
    var hypothesis = dv_find(actor, "hypothesis", false)
    var refs = []
    if (hypothesis == false):
        false
    else:
        if dvp_topic(actor, hypothesis):
            var features = dv_find(hypothesis, "features", [])
            var i = 0
            while (i < rt_count(features)):
                var feature = features[i]
                var local_1 = false
                if dv_has_key(feature, "proposition"):
                    local_1 = feature.proposition
                else:
                    local_1 = feature
                refs = dvp_merge_refs(refs, dvs_sim_refs(dv_find(feature, "observation", local_1)))
                i = (i + 1)
    return refs

fn dvp_scope(actor, action, bindings):
    var declared = dv_find(action, "purpose_refs", [])
    var grants = dv_find(action, "grants", [])
    var refs = declared
    var i = 0
    while (i < rt_count(grants)):
        var ref = grants[i]
        var local = dv_local(bindings, grants[i].object, actor.id)
        if (local == ""):
            false
        else:
            refs = dvp_add_ref(refs, dv_ref(local, ref.facet, ref.field))
        i = (i + 1)
    return refs

fn dvp_answer_reward(actor, action, mind):
    if dv_find(action, "answer_form", "complete-answer") == "supporting-statement":
        return 0
    if dv_has_key(action, "answer"):
        if (dv_truth(mind, action.answer) == "true"):
            return 1.0
        else:
            if dv_and(dv_has_key(actor, "argument"), (dv_find(dv_find(actor, "argument", []), "question", "") == dv_find(action, "argument_question", ""))):
                return 1.0
            else:
                var hypothesis = dv_find(actor, "hypothesis", false)
                if (hypothesis == false):
                    return 0
                else:
                    if dv_same(hypothesis.proposition, action.answer):
                        return dv_find(hypothesis, "prior", 0.5)
                    else:
                        return 0
    else:
        return 0

fn dvp_input_signature(actor, action, refs):
    var mind = actor.mind
    var inputs = []
    var i = 0
    var local_1 = false
    if dv_has_key(action, "answer"):
        local_1 = dvs_sim_refs(action.answer)
    else:
        local_1 = []
    var selected = dvp_merge_refs(refs, local_1)
    if dv_has_key(action, "support"):
        selected = dvp_merge_refs(selected, dvs_sim_refs(action.support))
    while (i < rt_count(selected)):
        rt_push(inputs, {"ref": selected[i], "cell": dvs_reason_cell(dv_read(mind, selected[i]))})
        i = (i + 1)
    return dv_with({"question": dvp_question(actor), "claim": dv_find(action, "answer", false), "inputs": inputs}, "reward", dvp_answer_reward(actor, action, mind))

fn dvp_answer_relevant(actor, action):
    if dv_has_key(action, "topic"):
        return dvp_topic(actor, action)
    else:
        var refs = dvs_sim_refs(action.answer)
        var goals = dvp_goal_refs(actor)
        var i = 0
        var found = false
        while (i < rt_count(refs)):
            if dv_has(goals, refs[i]):
                found = true
            i = (i + 1)
        return found

fn dvp_answer_attempt_allowed(prev_sig, cur_sig):
    if (prev_sig == false):
        return true
    else:
        if (not dv_same(prev_sig.inputs, cur_sig.inputs)):
            return true
        else:
            if (not dv_same(prev_sig.claim, cur_sig.claim)):
                return true
            else:
                if (not dv_same(prev_sig.question, cur_sig.question)):
                    return true
                else:
                    var r1 = dv_find(prev_sig, "reward", 0)
                    var r2 = dv_find(cur_sig, "reward", 0)
                    var local_1 = false
                    if (r1 < r2):
                        local_1 = (r2 - r1)
                    else:
                        local_1 = (r1 - r2)
                    var diff = local_1
                    return (not (diff < 0.2))

fn dvp_inspection_signature(actor, action, mind):
    let refs = dvp_merge_refs(dv_find(action, "grants", []), dvs_sim_refs(action.precondition))
    var inputs = []
    var i = 0
    while i < rt_count(refs):
        let cell = dv_read(mind, refs[i])
        rt_push(inputs, {"ref": refs[i], "known": cell.known, "value": cell.value, "conflicted": cell.conflicted})
        i = i + 1
    let evidence = dvp_inspection_freshness(actor, mind)
    var freshness = []
    i = 0
    while i < rt_count(refs):
        let entries = dv_find(evidence, rt_json_stringify(refs[i]), [])
        var j = 0
        while j < rt_count(entries):
            rt_push(freshness, entries[j])
            j = j + 1
        i = i + 1
    return {"inputs": inputs, "freshness": freshness}

// Only personally known execution inputs release a rejected attempt. Numeric
// thresholds retain their truth, so an advancing clock alone cannot retry them.
fn dvp_rejected_condition_signature(mind, proposition):
    if proposition.op == "all":
        var items = []
        var i = 0
        while i < rt_count(proposition.items):
            rt_push(items, dvp_rejected_condition_signature(mind, proposition.items[i]))
            i = i + 1
        return items
    if proposition.op == "not":
        return dvp_rejected_condition_signature(mind, proposition.item)
    if proposition.op == "equals":
        let cell = dv_read(mind, proposition.ref)
        return {"ref": proposition.ref, "known": cell.known, "value": cell.value, "conflicted": cell.conflicted}
    return {"condition": proposition, "truth": dv_truth(mind, proposition)}

fn dvp_rejected_signature(actor, action, mind):
    let adoption = dv_find(mind.adoptions, dv_find(action, "predict_law", ""), false)
    var prediction = false
    if adoption != false:
        prediction = {"active": adoption.active, "mode": adoption.mode, "law": adoption.law, "inputs": dvp_rejected_condition_signature(mind, adoption.law.premise)}
    var location = false
    if dv_has_key(actor, "location_ref"):
        let cell = dv_read(mind, actor.location_ref)
        location = {"known": cell.known, "value": cell.value, "conflicted": cell.conflicted}
    return {"precondition": dvp_rejected_condition_signature(mind, action.precondition), "prediction": prediction, "location": location}

fn dvp_eligible_base(actor, action, mind, relevant):
    var id = action.id
    var used = dv_find(actor, "used", [])
    let rejected = dv_find(dv_find(actor, "rejected_attempt_signatures", []), id, false)
    if rejected != false:
        if dv_same(rejected, dvp_rejected_signature(actor, action, mind)):
            return false
    if dv_and((not dv_find(actor, "cognition_blocked", false)), dv_and(dv_find(action, "argument_available", true), (dv_truth(mind, action.precondition) == "true"))):
        if action.kind == "inspect":
            let inspection_actor = dvp_actor_view(actor, mind)
            if dv_same(dv_find(dv_find(actor, "inspection_attempt_signatures", []), id, false), dvp_inspection_signature(inspection_actor, action, mind)):
                return false
        if dv_has_key(action, "answer"):
            var local_1 = false
            if dv_has_key(action, "argument"):
                local_1 = 2
            else:
                local_1 = 1
            if dv_and(dvp_answer_relevant(actor, action), (dv_find(dv_find(actor, "accepted_answers", []), dv_find(action, "topic", ""), 0) < local_1)):
                var speech_ready = true
                if dv_has_key(action, "speech"):
                    speech_ready = (dvs_speech_truth(actor.mind, action.speech) == "true")
                return dv_and(speech_ready, dv_and((not (dv_truth(actor.mind, action.answer) == "false")), dvp_answer_attempt_allowed(dv_find(dv_find(actor, "answer_attempt_signatures", []), id, false), dvp_input_signature(actor, action, relevant))))
            else:
                return false
        else:
            if dv_has_key(action, "speech"):
                var local_2 = false
                if dv_has_key(action, "response_topic"):
                    var request = dvs_pending_request(actor, action)
                    if (0 < rt_count(request)):
                        local_2 = (dvs_request_context(actor, action, request.requester) != false)
                    else:
                        local_2 = dv_and((not dv_has(used, id)), dv_or(dv_has_key(dv_find(actor, "visible_context", []), dv_find(action, "offer_to", "")), dv_find(action, "opportunity_requirement", false) != false and dvp_communication_progress(actor, action)))
                else:
                    if dv_has_key(action.speech, "request"):
                        var context = dvs_request_context(actor, action, action.speech.request.target)
                        local_2 = dv_and((not (context == false)), (not dv_same(context, dv_find(dv_find(actor, "request_contexts", []), id, false))))
                    else:
                        local_2 = (not dv_has(used, id))
                return dv_and((dvs_speech_truth(actor.mind, action.speech) == "true"), local_2)
            else:
                if (action.kind == "replay"):
                    return 0 < dv_find(actor.policy, "model_budget", 0) and (not dv_same(dv_find(dv_find(actor, "replay_attempt_signatures", []), id, false), dvp_input_signature(actor, action, relevant)))
                else:
                    if dv_find(action, "once", false):
                        return (not dv_has(used, id))
                    else:
                        if dv_find(action, "repeatable", false):
                            return true
                        else:
                            return (not dv_has(used, id))
    else:
        return false

fn dvp_source_supported(cell, source):
    return dvp_source_supported_since(cell, source, 0)

fn dvp_source_supported_since(cell, source, minimum_time):
    var claims = dv_find(cell, "claims", [])
    var i = 0
    var found = false
    while (i < rt_count(claims)):
        var claim = claims[i]
        if dv_and((claim.source == source), dv_same(claim.value, cell.value)) and minimum_time <= dv_find(claim, "time", 0):
            found = true
        i = (i + 1)
    return found

fn dvp_needs_evidence(actor, ref):
    var goals = dv_find(actor.policy, "goals", [])
    var i = 0
    var needed = false
    while (i < rt_count(goals)):
        var goal = goals[i]
        if dv_and(dvp_topic(actor, goal), (dv_truth(actor.mind, dv_find(goal, "available_when", dv_true())) == "true")):
            if (dv_find(goal, "kind", "know") == "evidence"):
                if dv_has_key(goal, "ref"):
                    if dv_same(goal.ref, ref):
                        var cell = dv_read(actor.mind, ref)
                        if dvp_source_supported_since(cell, dv_find(goal, "source", "perception"), dv_find(goal, "minimum_time", 0)):
                            false
                        else:
                            needed = true
        i = (i + 1)
    return needed

fn dvp_action_value(actor, action, bindings, relevant, probes):
    return dvp_action_value_context(actor, action, bindings, relevant, probes, dvp_value_context(actor))

fn dvp_value_context(actor):
    var evidence = []
    var achievements = []
    var communications = []
    let goals = dv_find(actor.policy, "goals", [])
    var i = 0
    while i < rt_count(goals):
        let goal = goals[i]
        let kind = dv_find(goal, "kind", "know")
        if kind == "evidence" and dv_has_key(goal, "ref"):
            if dvp_topic(actor, goal) and dv_truth(actor.mind, dv_find(goal, "available_when", dv_true())) == "true":
                if not dvp_source_supported_since(dv_read(actor.mind, goal.ref), dv_find(goal, "source", "perception"), dv_find(goal, "minimum_time", 0)):
                    rt_push(evidence, goal.ref)
        if kind == "achieve" and dvp_topic(actor, goal) and 0 < rt_count(dv_find(goal, "basis", [])):
            if not dv_has(dv_find(actor, "planning_achievements", []), i):
                if dv_truth(actor.mind, dv_find(goal, "available_when", dv_true())) == "true" and dv_truth(actor.mind, goal.proposition) != "true":
                    rt_push(achievements, dv_with(goal, "planning_refs", dvs_sim_refs(goal.proposition)))
        if kind == "communicate" and 0 < rt_count(dv_find(goal, "basis", [])) and dv_truth(actor.mind, dv_find(goal, "available_when", dv_true())) == "true":
            rt_push(communications, goal)
        i = i + 1
    return {"evidence": evidence, "achievements": achievements, "communications": communications, "speech_goals": dvs_speech_goals(actor)}

fn dvp_context_communication(action, goals):
    var i = 0
    var value = false
    while i < rt_count(goals):
        let goal = goals[i]
        if dv_find(goal, "method_id", "") == action.id:
            if not dv_find(goal, "requires_argument", false) or (dv_find(action, "speech_from_argument", false) and dv_find(action, "argument_available", false)):
                value = true
        i = i + 1
    return value

fn dvp_action_value_context(actor, action, bindings, relevant, probes, context):
    var mind = actor.mind
    var policy = actor.policy
    var scope = dvp_scope(actor, action, bindings)
    var i = 0
    var information = 0
    var verification = 0
    var progress = 0
    var hypothesis = dv_find(actor, "hypothesis", false)
    while (i < rt_count(scope)):
        var ref = scope[i]
        var cell = dv_read(mind, scope[i])
        if dv_or((not dv_uncontested(cell)), dv_has(context.evidence, ref)):
            if dv_has(relevant, ref):
                information = (information + 1)
            if dv_has(probes, ref):
                verification = (verification + 1)
        i = (i + 1)
    if dv_has_key(action, "answer"):
        progress = dvp_answer_reward(actor, action, mind)
    if dv_has_key(action, "speech") and not dv_has_key(action, "answer"):
        if (0 < rt_count(context.speech_goals)):
            var choice = dv_find(dv_find(actor, "speech_choice_values", []), action.id, [])
            if (dv_find(choice, "status", "") == "ready"):
                progress = choice.utility
        else:
            if dv_has_key(action.speech, "request"):
                false
            else:
                progress = 1
    if dv_has_key(action, "response_topic"):
        if (0 < rt_count(dvs_pending_request(actor, action))):
            information = (information + 1)
    if dvp_context_communication(action, context.communications):
        progress = 1
    if dv_has_key(action, "personal_choice"):
        progress = 1
    let resonance = dv_find(action, "resonance", false)
    if resonance != false:
        dv_require(dv_record_like(resonance), "Resonance must be a record")
        if not dv_find(resonance, "passive", false):
            progress = progress + dvp_resonance_utility(actor, action, mind)
    if (action.kind == "replay"):
        if (0 < dv_find(policy, "model_budget", 0)):
            if (hypothesis == false):
                false
            else:
                if dv_and(dvp_topic(actor, hypothesis), dv_and((0 < rt_count(dv_find(hypothesis, "features", []))), (0 < rt_count(dvs_sim_plan(hypothesis))))):
                    var features_known = true
                    var feats = dv_find(hypothesis, "features", [])
                    var fi = 0
                    while fi < rt_count(feats):
                        var f = feats[fi]
                        var obs = dv_find(f, "observation", dv_find(f, "proposition", false))
                        if obs != false:
                            var f_refs = dvs_sim_refs(obs)
                            var fri = 0
                            while fri < rt_count(f_refs):
                                if not dv_uncontested(dv_read(mind, f_refs[fri])):
                                    features_known = false
                                fri = fri + 1
                        fi = fi + 1
                    if features_known and (dv_find(dvs_cached_model(actor, hypothesis), "status", "unknown") == "stale-or-unavailable"):
                        verification = (verification + 1)
    let achievement = dvp_achievement_pending(actor, action, context.achievements)
    return {"information": information, "verification": verification, "progress": progress, "achievement": achievement, "value": (((information + verification) * dv_find(policy, "information_weight", 1)) + ((progress + achievement) * dv_find(policy, "progress_weight", 1)))}

// Access to an already owned communication goal is not its fulfillment.
// Predict only the subject's adopted effect; never supply a listener or an answer.
fn dvp_opportunities(actor, action):
    if action.kind != "move":
        return []
    let goals = dv_find(actor.policy, "goals", [])
    var pending = []
    var i = 0
    while i < rt_count(goals):
        let goal = goals[i]
        if dv_find(goal, "kind", "") == "communicate" and dv_find(goal, "scope", "") == "personal" and dv_find(goal, "owner", "") == actor.id:
            let method = dvp_find_action(actor.actions, dv_find(goal, "method_id", ""))
            if method != false and 0 < rt_count(dv_find(goal, "basis", [])) and not dv_has(dv_find(actor, "used", []), method.id):
                if not dv_has(dv_find(actor, "planning_opportunities", []), i):
                    if not dv_find(goal, "requires_argument", false) or (dv_find(method, "speech_from_argument", false) and dv_find(method, "argument_available", false)):
                        rt_push(pending, {"key": i, "goal": goal, "method": method})
        i = i + 1
    let adoption = dv_find(actor.mind.adoptions, dv_find(action, "predict_law", ""), false)
    if rt_count(pending) == 0 or adoption == false:
        return []
    if not adoption.active or adoption.mode != "predict":
        return []
    i = 0
    while i < rt_count(adoption.law.effects):
        if not dv_same_local_ref(actor.id, adoption.law.effects[i].ref, actor.location_ref):
            return []
        i = i + 1
    let prediction = dvp_forecast(actor.mind, action.predict_law)
    if prediction.status != "applied":
        return []
    var result = []
    let predicted_actor = dvp_actor_view(actor, prediction.world)
    let before = dv_read(actor.mind, actor.location_ref)
    let after = dv_read(prediction.world, actor.location_ref)
    if not dv_uncontested(before) or not dv_uncontested(after) or before.value == after.value:
        return []
    i = 0
    while i < rt_count(pending):
        let item = pending[i]
        if dv_truth(prediction.world, dv_find(item.goal, "available_when", dv_true())) == "true" and dv_truth(prediction.world, item.method.precondition) == "true":
            let method = dv_without(item.method, "opportunity_requirement")
            let spatial = dv_find(item.method, "opportunity_requirement", false)
            if spatial != false:
                if before.value != spatial.location and after.value == spatial.location and dvp_eligible_base(predicted_actor, item.method, prediction.world, dvp_goal_refs(predicted_actor)) and dvp_eligible_after_base(predicted_actor, method, prediction.world, dvp_goal_refs(predicted_actor)):
                    rt_push(result, {"key": item.key, "method_id": item.method.id, "weight": dv_find(item.goal, "weight", 1), "goal_basis": item.goal.basis, "prediction_basis": adoption.basis, "position_before": before, "position_after": after, "nonspatial_eligible": true, "availability_before": dv_truth(actor.mind, dv_find(item.goal, "available_when", dv_true())), "goal_available_after": "true", "access_only": true, "based_on": "subject_prediction", "method_eligible": dvp_eligible(predicted_actor, item.method, prediction.world, dvp_goal_refs(predicted_actor)), "participants_status": "not-predicted", "unresolved_spatial_requirement": spatial, "fulfillment": false})
        i = i + 1
    return result

fn dvp_initial_access(actor):
    let goals = dv_find(actor.policy, "goals", [])
    let position = dv_read(actor.mind, actor.location_ref)
    var result = []
    var i = 0
    while i < rt_count(goals):
        let goal = goals[i]
        if dv_find(goal, "kind", "") == "communicate" and dv_find(goal, "scope", "") == "personal" and dv_find(goal, "owner", "") == actor.id:
            let method = dvp_find_action(actor.actions, dv_find(goal, "method_id", ""))
            if method != false and dv_uncontested(position):
                let spatial = dv_find(method, "opportunity_requirement", false)
                if spatial != false:
                    if position.value == spatial.location:
                        rt_push(result, i)
        i = i + 1
    return result

fn dvp_join_items(list):
    var s = ""
    var i = 0
    let n = rt_count(list)
    while i < n:
        if i > 0:
            s = rt_cat(s, ",")
        s = rt_cat(s, rt_show(list[i]))
        i = i + 1
    return s

fn dvp_state_key(room, tasks):
    return rt_cat(room, rt_cat("|", dvp_join_items(tasks)))

fn dvp_extract_required_room(prop, loc_ref):
    if not dv_record_like(prop):
        return ""
    let op = dv_find(prop, "op", "")
    if op == "equals":
        let ref = dv_find(prop, "ref", false)
        if ref != false and dv_same(ref, loc_ref):
            let val = dv_find(prop, "value", "")
            if not dv_record_like(val):
                return val
    if op == "all":
        let items = dv_find(prop, "items", [])
        var i = 0
        let n = rt_count(items)
        while i < n:
            let r = dvp_extract_required_room(items[i], loc_ref)
            if r != "":
                return r
            i = i + 1
    return ""

fn dvp_node_key(node):
    return node.key

fn dvp_frontier_put(frontier, node):
    var key = dvp_node_key(node)
    var i = 0
    var result = []
    var dominated = false
    var node_score = node.score
    var node_elapsed = dv_find(node, "elapsed", 0)
    while (i < rt_count(frontier)):
        var existing = frontier[i]
        var ex_key = dvp_node_key(existing)
        var ex_score = existing.score
        var ex_elapsed = dv_find(existing, "elapsed", 0)
        if dv_same(key, ex_key):
            if dv_and((not (ex_score < node_score)), (not (node_elapsed < ex_elapsed))):
                dominated = true
                rt_push(result, existing)
            else:
                if dv_and((not (node_score < ex_score)), (not (ex_elapsed < node_elapsed))):
                    false
                else:
                    rt_push(result, existing)
        else:
            rt_push(result, existing)
        i = (i + 1)
    if dominated:
        false
    else:
        rt_push(result, node)
    return result

fn dvp_dependency_methods(actor):
    let key = ["dvp_dependency_methods"]
    let cached = rt_memo_get(actor.actions, key)
    if cached[0]:
        return cached[1]
    var actions = actor.actions
    var methods = []
    var i = 0
    while (i < rt_count(actions)):
        if not dv_find(actions[i], "known_opportunity_wait", false):
            rt_push(methods, {"scope": dv_find(actions[i], "purpose_refs", dv_find(actions[i], "grants", [])), "premise": actions[i].precondition, "owner_refs": dvp_owner_requirement_refs(actions[i])})
        i = (i + 1)
    return rt_memo_put(actor.actions, key, methods)

fn dvp_cached_dependencies(actor, seeds, budget):
    var methods = dvp_dependency_methods(actor)
    var signature = {"seeds": seeds, "budget": budget, "adoptions": actor.mind.adoptions, "methods": methods}
    var cache = dv_find(actor, "dependency_cache", false)
    if (cache == false):
        var result = dvp_dependencies(actor.mind, seeds, budget, methods)
        var local_1 = false
        if (result.stop == "dependency-closure"):
            local_1 = {"signature": signature, "result": result}
        else:
            local_1 = false
        return dv_with_many(result, {"cache_hit": false, "cache": local_1})
    else:
        if dv_same(cache.signature, signature):
            return dv_with_many(cache.result, {"expanded": 0, "cache_hit": true, "cache": cache})
        else:
            var result = dvp_dependencies(actor.mind, seeds, budget, methods)
            var local_2 = false
            if (result.stop == "dependency-closure"):
                local_2 = {"signature": signature, "result": result}
            else:
                local_2 = false
            return dv_with_many(result, {"cache_hit": false, "cache": local_2})

fn dvp_plan(actor, bindings, costs):
    let indexed = dvp_actor_view(actor, dv_with_many(actor.mind, {"history": [], "seen": []}))
    rt_push(indexed, dv_pair("planning_choice_groups", dvp_choice_groups(actor.actions)))
    actor = indexed
    // Refresh declared evidence goals for every chapter in the read-only planning view.
    let owned_goals = dv_find(actor.policy, "goals", [])
    var refresh = false
    var goal_index = 0
    while goal_index < rt_count(owned_goals):
        if dv_find(owned_goals[goal_index], "kind", "") == "evidence" and dv_has_key(owned_goals[goal_index], "refresh_until"):
            refresh = true
        goal_index = goal_index + 1
    if refresh:
        let view = dvp_actor_view(actor, actor.mind)
        let policy = dv_with(actor.policy, "goals", dvp_refresh_current_evidence(actor, owned_goals))
        rt_replace(view, rt_record_index(view, "policy"), dv_pair("policy", policy))
        actor = view
    var budget = dv_find(actor.policy, "plan_budget", 0)
    var depth_limit = dv_find(actor.policy, "plan_depth", 2)
    var goals = dvp_goal_refs(actor)
    var probes = dvp_probe_refs(actor)
    var dependencies = dvp_cached_dependencies(actor, dvp_merge_refs(goals, probes), dv_find(actor.policy, "dependency_budget", dv_find(actor, "planning_limit", budget)))
    var relevant = dependencies.refs
    var expanded = 0
    var best = false
    var best_score = -100000
    var best_path = []
    var current_action = false
    var current_score = 0
    var current_value = []
    var root_best = []
    var best_after_successor_layer = []
    let initial_achievements = dvp_satisfied_goals(actor, actor.mind, [])
    let initial_access = dvp_initial_access(actor)
    var root_room = ""
    if dv_has_key(actor, "location_ref"):
        let cur_loc = dv_read(actor.mind, actor.location_ref)
        if dv_uncontested(cur_loc):
            root_room = rt_show(cur_loc.value)
    let initial_seen = dvp_state_key(root_room, [])
    var init_key = rt_cat(initial_seen, rt_cat("#", rt_cat(dvp_join_items(initial_achievements), rt_cat("@", dvp_join_items(initial_access)))))
    var plans = []
    var frontier = dv_single({"mind": actor.mind, "path": [], "score": 0, "room": root_room, "tasks": [], "seen": dv_single(initial_seen), "key": init_key, "achievements": initial_achievements, "opportunities": initial_access})
    var depth = 0
    var time_blocked = 0
    var stop = "complete-depth"
    var actions = actor.actions
    var visited = []
    visited = dv_single({"key": init_key, "score": 0, "elapsed": 0})
    while dv_and((depth < depth_limit), (0 < rt_count(frontier))):
        if ((budget - expanded) < rt_count(frontier)):
            stop = "incomplete-layer-budget"
            frontier = []
        else:
            var next_frontier = []
            var n = 0
            while (n < rt_count(frontier)):
                var node = frontier[n]
                var i = 0
                var mind = frontier[n].mind
                var node_actor = dvp_actor_view(actor, mind)
                rt_push(node_actor, dv_pair("planning_achievements", node.achievements))
                rt_push(node_actor, dv_pair("planning_opportunities", node.opportunities))
                let node_actions = dvp_room_actions(actions, node.room, dv_find(actor, "location_ref", false))
                let value_context = dvp_value_context(node_actor)
                expanded = (expanded + 1)
                while (i < rt_count(node_actions)):
                    var action = node_actions[i]
                    var local_1 = false
                    var spatially_possible = true
                    if node.room != "":
                        if dv_has_key(action, "travel"):
                            if action.travel.from != node.room:
                                spatially_possible = false
                        else:
                            let req_room = dv_find(action, "required_room", "")
                            if req_room != "" and req_room != node.room:
                                spatially_possible = false
                    if spatially_possible and (depth == 0 or not dv_find(action, "known_opportunity_wait", false)) and dvp_eligible(actor, action, mind, relevant):
                        if dv_has_key(actor.policy, "remaining_game_time"):
                            if (actor.policy.remaining_game_time < (dv_find(node, "elapsed", 0) + dv_get(costs, action.kind).maximum.time)):
                                time_blocked = (time_blocked + 1)
                                local_1 = false
                            else:
                                local_1 = true
                        else:
                            local_1 = true
                    else:
                        local_1 = false
                    if local_1:
                        var value = dvp_action_value_context(node_actor, action, bindings, relevant, probes, value_context)
                        let opportunities = dvp_opportunities(node_actor, action)
                        var opportunity_keys = node.opportunities
                        var opportunity_value = 0
                        var k = 0
                        while k < rt_count(opportunities):
                            opportunity_keys = dv_append(opportunity_keys, opportunities[k].key)
                            opportunity_value = opportunity_value + opportunities[k].weight
                            k = k + 1
                        value = dv_with_many(value, {"opportunity": opportunity_value, "opportunity_evidence": opportunities, "value": value.value + opportunity_value * dv_find(actor.policy, "progress_weight", 1)})
                        var cost = dv_get(costs, action.kind).actual
                        var path = dv_append(node.path, action.id)
                        var score = 0
                        score = (node.score + (value.value - (cost.time * dv_find(actor.policy, "time_cost", 0.01))))
                        if depth == 0 and (action.kind != "move" or (dv_find(actor.policy, "positive_move_root_stop", false) and value.achievement > 0)) and not dv_find(action, "known_opportunity_wait", false) and current_score < score and 0 < value.information + value.verification + value.progress + value.achievement:
                            current_action = action
                            current_score = score
                            current_value = value
                        rt_push(plans, dv_with_many({"path": path, "score": score, "value": value, "relevant_refs": relevant}, {"probe_refs": probes, "mind_revision": actor.mind.revision, "prediction_basis": dv_find(node, "prediction_basis", [])}))
                        if (best_score < score):
                            best_score = score
                            best_path = path
                            best = dvp_find_action(actions, path[0])
                        if (depth + 1 < depth_limit) and not dv_find(action, "known_opportunity_wait", false) and not (depth == 1 and current_action != false) and dv_and((0 < rt_count(relevant)), dv_has_key(action, "predict_law")):
                            var name = action.predict_law
                            var adoptions = mind.adoptions
                            if dv_has_key(adoptions, name):
                                var adoption = dv_get(adoptions, name)
                                if dv_and(adoption.active, (adoption.mode == "predict")):
                                    var prediction = dvp_forecast(mind, name)
                                    if (prediction.status == "applied"):
                                        var predicted = prediction.world
                                        let achieved = dvp_satisfied_goals(actor, predicted, node.achievements)
                                        var is_transit = false
                                        var room = node.room
                                        if dv_has_key(action, "travel"):
                                            let tr = action.travel
                                            if tr.from != tr.to:
                                                is_transit = true
                                                room = tr.to
                                        var next_tasks = node.tasks
                                        if not is_transit:
                                            next_tasks = dv_append(node.tasks, action.id)
                                        let seen_key = dvp_state_key(room, next_tasks)
                                        var pred_key = rt_cat(seen_key, rt_cat("#", rt_cat(dvp_join_items(achieved), rt_cat("@", dvp_join_items(opportunity_keys)))))
                                        if dv_has(node.seen, seen_key) or (not is_transit and dv_has(node.tasks, action.id)):
                                            false
                                        else:
                                            var candidate_node = {"mind": predicted, "path": path, "score": score - opportunity_value * dv_find(actor.policy, "progress_weight", 1), "room": room, "tasks": next_tasks, "seen": dv_append(node.seen, seen_key), "key": pred_key, "prediction_basis": adoption.basis, "elapsed": dv_find(node, "elapsed", 0) + dv_get(costs, action.kind).maximum.time, "achievements": achieved, "opportunities": opportunity_keys}
                                            if dvp_dominated(visited, candidate_node):
                                                false
                                            else:
                                                visited = dvp_frontier_put(visited, {"key": pred_key, "score": candidate_node.score, "elapsed": candidate_node.elapsed})
                                                next_frontier = dvp_frontier_put(next_frontier, candidate_node)
                    i = (i + 1)
                n = (n + 1)
            if depth == 0:
                root_best = {"path": best_path, "net_score": best_score}
                if current_action != false:
                    best_after_successor_layer = root_best
                    next_frontier = []
                    stop = "current-affordance-root"
            frontier = next_frontier
            depth = (depth + 1)
    var local_2 = false
    if (0 < best_score):
        local_2 = best
    else:
        local_2 = false
    var local_3 = false
    if dv_and((not (0 < best_score)), (0 < time_blocked)):
        local_3 = "duration-budget"
    else:
        local_3 = stop
    return dv_with_many(dv_with_many({"action": local_2, "score": best_score, "plan_expansions": expanded, "plans": plans}, {"selected_path": best_path, "relevant_refs": relevant, "stop": local_3, "time_blocked": time_blocked, "dependency_expansions": dependencies.expanded, "dependency_stop": dependencies.stop, "dependency_cache": dependencies.cache, "dependency_cache_hit": dependencies.cache_hit, "current_affordance": {"action": current_action, "net_score": current_score, "value": current_value, "authority_acceptance": "not-predicted"}}), {"completed_layers": depth, "root_best": root_best, "best_after_successor_layer": best_after_successor_layer})

fn dvp_find_action(actions, id):
    var i = 0
    var result = false
    while (i < rt_count(actions)):
        if (actions[i].id == id):
            result = actions[i]
        i = (i + 1)
    return result

fn dvp_actor_view(actor, mind):
    var result = []
    var i = 0
    while (i < rt_count(actor)):
        var entry = actor[i]
        var local_1 = false
        if (entry[0] == "mind"):
            local_1 = dv_pair("mind", mind)
        else:
            local_1 = entry
        rt_push(result, local_1)
        i = (i + 1)
    return result

fn dvp_dominated(nodes, candidate):
    var i = 0
    var found = false
    while dv_and((not found), (i < rt_count(nodes))):
        var node = nodes[i]
        if dv_and(dv_same(dvp_node_key(node), dvp_node_key(candidate)), dv_and((not (node.score < candidate.score)), (not (dv_find(candidate, "elapsed", 0) < dv_find(node, "elapsed", 0))))):
            found = true
        i = (i + 1)
    return found

fn dvp_communication_progress(actor, action):
    var goals = dv_find(actor.policy, "goals", [])
    var i = 0
    var value = false
    while (i < rt_count(goals)):
        var goal = goals[i]
        if (dv_find(goal, "kind", "") == "communicate"):
            if dv_and((dv_find(goal, "method_id", "") == action.id), dv_and((0 < rt_count(dv_find(goal, "basis", []))), (dv_truth(actor.mind, dv_find(goal, "available_when", {"op": "constant", "value": "true"})) == "true"))):
                if dv_and(dv_find(goal, "requires_argument", false), dv_find(action, "speech_from_argument", false)):
                    if dv_find(action, "argument_available", false):
                        value = true
                if not dv_find(goal, "requires_argument", false):
                    value = true
        i = (i + 1)
    return value

fn dvp_satisfied_goals(actor, mind, previous):
    var result = []
    let goals = dv_find(actor.policy, "goals", [])
    var i = 0
    while i < rt_count(goals):
        let goal = goals[i]
        if dv_find(goal, "kind", "") == "achieve":
            if (dv_truth(mind, goal.proposition) == "true" or dv_has(previous, i)) and not dv_has(result, i):
                result = dv_append(result, i)
        i = i + 1
    return result

fn dvp_achievement_value(actor, action):
    let goals = dv_find(actor.policy, "goals", [])
    var pending = []
    var i = 0
    while i < rt_count(goals):
        let goal = goals[i]
        if dv_find(goal, "kind", "") == "achieve" and dvp_topic(actor, goal) and 0 < rt_count(dv_find(goal, "basis", [])):
            if not dv_has(dv_find(actor, "planning_achievements", []), i):
                if dv_truth(actor.mind, dv_find(goal, "available_when", dv_true())) == "true" and dv_truth(actor.mind, goal.proposition) != "true":
                    rt_push(pending, goal)
        i = i + 1
    return dvp_achievement_pending(actor, action, pending)

fn dvp_achievement_pending(actor, action, pending):
    var i = 0
    if rt_count(pending) == 0:
        return 0
    let name = dv_find(action, "predict_law", "")
    let adoption = dv_find(actor.mind.adoptions, name, false)
    if adoption == false:
        return 0
    if not adoption.active or adoption.mode != "predict":
        return 0
    var relevant = false
    i = 0
    while i < rt_count(pending) and not relevant:
        var refs = []
        if dv_has_key(pending[i], "planning_refs"):
            refs = pending[i].planning_refs
        else:
            refs = dvs_sim_refs(pending[i].proposition)
        var j = 0
        while j < rt_count(adoption.law.effects) and not relevant:
            var r = 0
            while r < rt_count(refs):
                if dv_same_local_ref(actor.id, adoption.law.effects[j].ref, refs[r]):
                    relevant = true
                r = r + 1
            j = j + 1
        i = i + 1
    if not relevant:
        return 0
    let prediction = dvp_forecast(actor.mind, name)
    if prediction.status != "applied":
        return 0
    var value = 0
    i = 0
    while i < rt_count(pending):
        if dv_truth(prediction.world, pending[i].proposition) == "true":
            value = value + dv_find(pending[i], "weight", 1)
        i = i + 1
    return value

// Only declared relevant received references can refresh an evidence requirement.
fn dvp_refresh_current_evidence(actor, goals):
    var result = []
    var i = 0
    while i < rt_count(goals):
        var goal = goals[i]
        if dv_find(goal, "kind", "") == "evidence" and dv_has_key(goal, "refresh_until"):
            if dv_truth(actor.mind, goal.refresh_until) != "true":
                if dv_has_key(goal, "refresh_refs"):
                    var relevant_time = dv_find(goal, "minimum_time", 0)
                    var r = 0
                    while r < rt_count(goal.refresh_refs):
                        let cell = dv_read(actor.mind, goal.refresh_refs[r])
                        if cell.known:
                            relevant_time = dv_max(relevant_time, dv_find(cell, "time", 0))
                        r = r + 1
                    goal = dv_with(goal, "minimum_time", relevant_time)
        rt_push(result, goal)
        i = i + 1
    return result

// Pure prediction only; this cache never writes actual action or evidence events.
fn dvp_forecast(mind, name):
    let key = ["dvp_forecast", name]
    let cached = rt_memo_get(mind, key)
    if cached[0]:
        return cached[1]
    let result = dv_predict(dv_with_many(mind, {"domain": "mind", "history": [], "seen": []}), name, rt_cat("planning-forecast-", rt_show(mind.revision)), dv_find(mind, "time", 0), mind.revision)
    return rt_memo_put(mind, key, result)

// Catalog-only filtering; dynamic eligibility is still checked on the node mind.
fn dvp_room_actions(actions, room, location_ref):
    if room == "" or location_ref == false:
        return actions
    let key = ["dvp_room_actions", room, location_ref]
    let cached = rt_memo_get(actions, key)
    if cached[0]:
        return cached[1]
    var result = []
    var i = 0
    while i < rt_count(actions):
        let action = actions[i]
        var required = dv_find(action, "required_room", "")
        if dv_has_key(action, "travel"):
            required = action.travel.from
        else:
            if required == "":
                required = dvp_extract_required_room(action.precondition, location_ref)
        if required == "" or required == room:
            rt_push(result, action)
        i = i + 1
    return rt_memo_put(actions, key, result)

// Every inspection in the same mind reuses the evidence refresh and availability reads.
fn dvp_inspection_freshness(actor, mind):
    let declared = dv_find(actor.policy, "goals", [])
    let key = ["dvp_inspection_freshness", declared]
    let cached = rt_memo_get(mind, key)
    if cached[0]:
        return cached[1]
    let goals = dvp_refresh_current_evidence(dvp_actor_view(actor, mind), declared)
    var index = []
    var i = 0
    while i < rt_count(goals):
        let goal = goals[i]
        if dv_find(goal, "kind", "") == "evidence" and dv_has_key(goal, "ref"):
            let name = rt_json_stringify(goal.ref)
            let entries = dv_append(dv_find(index, name, []), {"ref": goal.ref, "minimum_time": dv_find(goal, "minimum_time", 0), "available": dv_truth(mind, dv_find(goal, "available_when", dv_true()))})
            index = dv_with(index, name, entries)
        i = i + 1
    return rt_memo_put(mind, key, index)
// Structured speech: authority is checked by execution, cognition by each owner.
// Only positive equals atoms support testimony cells. Other ASTs remain speech records.
// A received estimated proposal is a public record before any personal adoption.
// Only an owner's declared policy can authorize its bounded testimony support.
// Speech exposes cue identity only. Conclusions and priors belong to local rules.
// Model reception is hypothetical testimony into a private copied prediction world.
// Neither the model nor its alternatives is sourced from another actor's real mind.
// A complete candidate layer is quoted before any prediction is evaluated.
// Work draws only from the existing total model budget, never replay-work allowance.
// Reassessment consumes personal reasoning and withdraws only a scoped interpretation.
// New personal evidence can defeat an earlier interpretation without new speech.
// This operation never writes observations or negates the interpreted proposition.

fn dvs_speech_cognitive_parents(parents, previous):
    if dv_or((previous == ""), dv_has(parents, previous)):
        return parents
    else:
        return dv_append(parents, previous)

fn dvs_speech_ast_nodes(ast):
    var op = ast.op
    var count = 1
    if (op == "not"):
        count = (count + dvs_speech_ast_nodes(ast.item))
    else:
        if (op == "all"):
            var items = ast.items
            var i = 0
            while (i < rt_count(items)):
                count = (count + dvs_speech_ast_nodes(items[i]))
                i = (i + 1)
    return count

fn dvs_speech_map(mind, proposition, bindings):
    var op = proposition.op
    if (op == "constant"):
        return proposition
    else:
        if (op == "all"):
            var mapped = []
            var i = 0
            var items = proposition.items
            while (i < rt_count(items)):
                rt_push(mapped, dvs_speech_map(mind, items[i], bindings))
                i = (i + 1)
            return dv_all(mapped)
        else:
            if (op == "not"):
                return dv_not(dvs_speech_map(mind, proposition.item, bindings))
            else:
                var ref = proposition.ref
                var local = dv_local(bindings, ref.object, mind.subject)
                if (local == ""):
                    if dv_has_key(mind.objects, ref.object):
                        return proposition
                    else:
                        return {"op": "constant", "value": "unknown"}
                else:
                    return dv_with(proposition, "ref", dv_ref(local, ref.facet, ref.field))

fn dvs_speech_truth(mind, speech):
    return dv_truth(mind, dvs_speech_map(mind, speech.literal_ast, dv_find(speech, "referents", [])))

fn dvs_speech_presuppositions(mind, speech):
    var items = dv_find(speech, "presuppositions", [])
    var bindings = dv_find(speech, "referents", [])
    var i = 0
    var result = []
    while (i < rt_count(items)):
        var proposition = dvs_speech_map(mind, items[i], bindings)
        rt_push(result, {"proposition": proposition, "truth": dv_truth(mind, proposition)})
        i = (i + 1)
    return result

fn dvs_emission_location(speaker, speech, physical):
    let ref = dv_find(speech, "emission_location_ref", speaker.location_ref)
    let cell = dv_read(physical, ref)
    if dv_uncontested(cell):
        return cell.value
    return ""

fn dvs_speech_hearing(speaker, listener, speech, physical):
    var source = speaker.id
    var channel = dv_find(speech, "channel", "")
    var source_location = dvs_emission_location(speaker, speech, physical)
    let target_cell = dv_read(physical, listener.location_ref)
    var target_location = ""
    if dv_uncontested(target_cell):
        target_location = target_cell.value
    var grants = dv_find(listener, "hearing_grants", [])
    if (source_location != "") and dv_same(source_location, target_location):
        return true
    var heard = false
    var i = 0
    while (i < rt_count(grants)):
        var grant = grants[i]
        if dv_and((grant.speaker == source), (grant.channel == channel)):
            let sender_locations = dv_find(grant, "sender_locations", [])
            let listener_locations = dv_find(grant, "listener_locations", [])
            var reception = target_location
            if dv_has_key(grant, "reception_location_ref"):
                let endpoint = dv_read(physical, grant.reception_location_ref)
                reception = ""
                if dv_uncontested(endpoint):
                    reception = endpoint.value
            if (dv_truth(listener.mind, dv_find(grant, "available_when", dv_true())) == "true") and dv_truth(physical, dv_find(grant, "authority_when", dv_true())) == "true":
                if source_location != "" and reception != "" and ((rt_count(sender_locations) == 0 or dv_has(sender_locations, source_location)) and (rt_count(listener_locations) == 0 or dv_has(listener_locations, reception))):
                    heard = true
        i = (i + 1)
    return heard

fn dvs_speech_observations(mind, proposition, source, origin, time, trust):
    var op = proposition.op
    var observations = []
    if (op == "all"):
        var items = proposition.items
        var i = 0
        while (i < rt_count(items)):
            var part = dvs_speech_observations(mind, items[i], source, origin, time, trust)
            var j = 0
            while (j < rt_count(part)):
                if dv_has(observations, part[j]):
                    false
                else:
                    rt_push(observations, part[j])
                j = (j + 1)
            i = (i + 1)
    else:
        if (op == "equals"):
            var ref = proposition.ref
            rt_push(observations, dv_observation(dv_list3(source, mind.subject, ref), mind.subject, ref, proposition.value, "testimony", origin, time, trust, dv_pair(origin, ref)))
    return observations

fn dvs_speaker_trust(policy, speaker):
    var trust = dv_find(dv_find(policy, "speaker_trust", []), speaker, 0.5)
    let biases = dv_find(policy, "class_bias", [])
    var i = 0
    while i < rt_count(biases):
        let bias = biases[i]
        if 0 < rt_count(dv_find(bias, "basis", [])) and dv_has(bias.speakers, speaker):
            trust = trust + bias.delta
        i = i + 1
    return dv_min(1, dv_max(0, trust))

fn dvs_speech_proposal_decision(mind, policy, speech, trust):
    var proposal = dv_find(speech, "proposal", false)
    var status = "ordinary"
    var reason = "ordinary-testimony"
    var confidence = trust
    var units = 0
    var acceptance = dv_find(policy, "proposal_acceptance", false)
    if (proposal == false):
        false
    else:
        var claims = dv_find(proposal, "claims", [])
        var local_1 = false
        if (acceptance == false):
            local_1 = []
        else:
            local_1 = dv_find(acceptance, "required_slots", [])
        var required = local_1
        var propositions = []
        var allowed = true
        var i = 0
        var available = "unknown"
        status = "retained"
        reason = "missing-personal-proposal-policy"
        units = 1
        confidence = dv_min(trust, dv_find(proposal, "confidence", 0))
        while (i < rt_count(claims)):
            var claim = claims[i]
            rt_push(propositions, dv_fact(claim.ref, claim.value))
            units = (units + 1)
            i = (i + 1)
        i = 0
        while (i < rt_count(required)):
            var j = 0
            var found = false
            while (j < rt_count(claims)):
                if (required[i] == claims[j].slot_id):
                    found = true
                units = (units + 1)
                j = (j + 1)
            if found:
                false
            else:
                allowed = false
            i = (i + 1)
        if (acceptance == false):
            false
        else:
            available = dv_truth(mind, dvs_speech_map(mind, dv_find(acceptance, "available_when", dv_true()), dv_find(speech, "referents", [])))
            units = (units + (2 * dvs_speech_ast_nodes(dv_find(acceptance, "available_when", dv_true()))))
            reason = "personal-proposal-policy-withheld"
            if dv_find(acceptance, "enabled", false):
                false
            else:
                allowed = false
            if (0 < rt_count(dv_find(acceptance, "basis", []))):
                false
            else:
                allowed = false
            if (available == "true"):
                false
            else:
                allowed = false
            if (0 < rt_count(required)):
                false
            else:
                allowed = false
            if (0 < rt_count(claims)):
                false
            else:
                allowed = false
            if dv_find(proposal, "estimated", false):
                false
            else:
                allowed = false
            if (dv_find(proposal, "argument_id", "") == ""):
                allowed = false
            if dv_and((0 < dv_find(proposal, "confidence", 0)), (dv_find(proposal, "confidence", 0) < 1)):
                false
            else:
                allowed = false
            if (0 < rt_count(dv_find(proposal, "source_event_ids", []))):
                false
            else:
                allowed = false
            if (dv_find(proposal, "model_event", "") == ""):
                allowed = false
            if dv_same(dv_all(propositions), speech.literal_ast):
                false
            else:
                allowed = false
            if (confidence < dv_find(acceptance, "confidence_threshold", 0.5)):
                allowed = false
            if allowed:
                status = "accepted"
                reason = "personal-bounded-proposal-adoption"
    var local_2 = false
    if (acceptance == false):
        local_2 = []
    else:
        local_2 = dv_find(acceptance, "basis", [])
    return dv_with_many({"status": status, "reason": reason, "confidence_cap": confidence, "proposal": proposal}, {"policy_basis": local_2, "calculation_units": units})

fn dvs_speech_received_observations(mind, parsed, source, speaker, time, decision):
    if (decision.status == "retained"):
        return []
    else:
        var items = dvs_speech_observations(mind, parsed, source, speaker, time, decision.confidence_cap)
        var i = 0
        var result = []
        while (i < rt_count(items)):
            var local_1 = false
            if (decision.status == "ordinary"):
                local_1 = items[i]
            else:
                local_1 = dv_with_many(items[i], {"estimated": true, "proposal_source": decision.proposal})
            rt_push(result, local_1)
            i = (i + 1)
        return result

fn dvs_speech_candidates(policy, speech):
    var cues = dv_find(speech, "implicature_candidates", [])
    var rules = dv_find(policy, "implicature_bridges", [])
    var result = []
    var ids = []
    var local_ids = []
    var i = 0
    while (i < rt_count(rules)):
        var rule = rules[i]
        var id = rules[i].id
        var required = dv_find(rules[i], "cue", "")
        var j = 0
        var matched = false
        rt_push(local_ids, id)
        if (required == ""):
            matched = true
        while (j < rt_count(cues)):
            if (cues[j].id == required):
                matched = true
            j = (j + 1)
        if matched:
            rt_push(result, {"id": id, "rule_source": dv_find(rule, "basis", []), "utterance_scope": dv_find(speech, "scope", "")})
            rt_push(ids, id)
        i = (i + 1)
    i = 0
    while (i < rt_count(cues)):
        var cue_id = cues[i].id
        if dv_or(dv_has(ids, cue_id), dv_has(local_ids, cue_id)):
            false
        else:
            rt_push(result, {"id": cue_id, "rule_source": [], "utterance_scope": dv_find(speech, "scope", "")})
            rt_push(ids, cue_id)
        i = (i + 1)
    return result

mapping dvs_listener_mapping(mind, policy, bindings):
    input Percept
    output InterpretationSet
    using dvs_speech_interpret(mind, policy, bindings)

fn dvs_speech_interpret(mind, policy, bindings, candidate):
    var bridges = dv_find(policy, "implicature_bridges", [])
    var i = 0
    var bridge = false
    var proposition = {"op": "constant", "value": "unknown"}
    var available = dv_true()
    var threshold = dv_max(dv_find(policy, "implicature_threshold", 0.5), dv_find(policy, "Implicature_Resistance", 0))
    var confidence = 0
    var adoption = {degree: 0, level: "held"}
    var basis = []
    var status = "rejected"
    var missing = "missing-bridge"
    var scope_check = []
    var work = 0
    while (i < rt_count(bridges)):
        var item = bridges[i]
        if (item.id == candidate.id):
            dv_require((bridge == false), "Ambiguous interpretation bridge")
            bridge = item
        i = (i + 1)
    if (bridge == false):
        false
    else:
        var premise = dvs_speech_map(mind, bridge.premise, bindings)
        var bridge_basis = dv_find(bridge, "basis", [])
        var withdrawal = dvs_speech_map(mind, dv_find(bridge, "withdraw_when", dv_not(dv_true())), bindings)
        var scope_ast = dvs_speech_map(mind, dv_find(bridge, "scope_bridge", {"op": "constant", "value": "unknown"}), bindings)
        proposition = dvs_speech_map(mind, bridge.proposition, bindings)
        available = dvs_speech_map(mind, dv_find(bridge, "available_when", dv_true()), bindings)
        confidence = dv_unit(dv_find(bridge, "prior", 0.5))
        basis = bridge_basis
        work = (1 + (2 * ((dvs_speech_ast_nodes(premise) + dvs_speech_ast_nodes(proposition)) + (dvs_speech_ast_nodes(available) + (dvs_speech_ast_nodes(withdrawal) + dvs_speech_ast_nodes(scope_ast))))))
        var literal_scope = dv_find(candidate, "utterance_scope", dv_find(bridge, "source_scope", ""))
        var interpreted_scope = dv_find(bridge, "target_scope", dv_find(bridge, "source_scope", ""))
        var scope_truth = dv_truth(mind, scope_ast)
        var withdraw_truth = dv_truth(mind, withdrawal)
        var available_truth = dv_truth(mind, available)
        var premise_truth = dv_truth(mind, premise)
        var proposition_truth = dv_truth(mind, proposition)
        scope_check = dv_with({"literal_scope": literal_scope, "interpretation_scope": interpreted_scope, "bridge_truth": scope_truth, "check_enabled": dv_find(policy, "scope_reference_check", false)}, "gap", dv_and((not (literal_scope == interpreted_scope)), (not (scope_truth == "true"))))
        if (withdraw_truth == "true"):
            status = "withdrawn"
            missing = "explicit-withdrawal-evidence"
        else:
            if (not (available_truth == "true")):
                missing = "availability-not-known"
            else:
                if (rt_count(bridge_basis) == 0):
                    missing = "bridge-without-source"
                else:
                    if (not (premise_truth == "true")):
                        missing = "bridge-premise-not-known"
                    else:
                        if (rt_count(basis) == 0):
                            missing = "candidate-without-source"
                        else:
                            if (proposition_truth == "false"):
                                missing = "contrary-evidence"
                            else:
                                adoption = dv_threshold_acceptance(confidence, threshold)
                                if adoption.level != "accepted":
                                    missing = "below-policy-threshold"
                                else:
                                    status = "accepted"
                                    missing = ""
        if dv_and((status == "accepted"), dv_and(scope_check.check_enabled, scope_check.gap)):
            status = "retained"
            adoption = dv_threshold_acceptance(0, threshold)
            missing = "scope-reference-bridge-not-supported"
        basis = dv_append(basis, {"bridge": bridge.id, "basis": bridge_basis})
    return dv_with_many({"id": candidate.id, "proposition": proposition, "status": status, "confidence": confidence}, {"basis": basis, "missing_bridge": missing, "scope_check": scope_check, "kind": "defeasible-interpretation", "calculation_units": work, "acceptance": adoption})

fn dvs_speech_model_interpretations(mind, policy, speech, bindings):
    var candidates = dvs_speech_candidates(policy, speech)
    var result = []
    var i = 0
    while (i < rt_count(candidates)):
        rt_push(result, (dvs_listener_mapping(mind, policy, bindings) × candidates[i]))
        i = (i + 1)
    return result

fn dvs_speech_model_prediction(model, speech, speaker, source, time):
    var before = dv_with_many(model.mind, {"history": [], "seen": []})
    var policy = model.policy
    var bindings = dv_find(speech, "referents", [])
    var parsed = dvs_speech_map(model.mind, speech.literal_ast, dv_find(speech, "referents", []))
    var decision = dvs_speech_proposal_decision(before, policy, speech, dvs_speaker_trust(policy, speaker))
    var observations = dvs_speech_received_observations(before, parsed, rt_cat("prediction-", source), speaker, time, decision)
    var profile = dv_observation_profile({"perception": 1, "testimony": 1, "recall": 1}, dv_find(policy, "observation_threshold", 0.5))
    var receipt = dv_update_mind(before, observations, before.revision, profile)
    var after = receipt.world
    var primary = dvs_speech_model_interpretations(after, policy, speech, bindings)
    var checked = dv_find(policy, "scope_reference_check", false)
    var local_1 = false
    if checked:
        local_1 = dvs_speech_model_interpretations(after, dv_with(policy, "scope_reference_check", false), speech, bindings)
    else:
        local_1 = primary
    var local_2 = false
    if checked:
        local_2 = primary
    else:
        local_2 = dvs_speech_model_interpretations(after, dv_with(policy, "scope_reference_check", true), speech, bindings)
    var local_3 = false
    if checked:
        local_3 = "scope_reference_check_true=primary"
    else:
        local_3 = "scope_reference_check_false=primary"
    return dv_with_many({"model_before": before, "model_after": after, "predicted_literal": parsed, "observations": observations}, {"observation_profile": profile, "prediction": primary, "conditional_prediction": {"scope_reference_check_false": local_1, "scope_reference_check_true": local_2}, "assumptions": dv_find(model, "assumptions", []), "conditional_reuse": local_3, "proposal_decision": decision})

fn dvs_speech_rule_units(rule):
    return (1 + (2 * ((dvs_speech_ast_nodes(rule.premise) + dvs_speech_ast_nodes(rule.proposition)) + (dvs_speech_ast_nodes(dv_find(rule, "available_when", dv_true())) + (dvs_speech_ast_nodes(dv_find(rule, "withdraw_when", dv_not(dv_true()))) + dvs_speech_ast_nodes(dv_find(rule, "scope_bridge", {"op": "constant", "value": "unknown"})))))))

fn dvs_speech_prediction_units(model, speech):
    var rules = dv_find(model.policy, "implicature_bridges", [])
    var candidates = dvs_speech_candidates(model.policy, speech)
    var work = (dvs_speech_proposal_decision(model.mind, model.policy, speech, 0.5).calculation_units + (1 + (2 * dvs_speech_ast_nodes(speech.literal_ast))))
    var i = 0
    while (i < rt_count(candidates)):
        var j = 0
        var id = candidates[i].id
        while (j < rt_count(rules)):
            if (rules[j].id == id):
                work = (work + (2 * dvs_speech_rule_units(rules[j])))
            j = (j + 1)
        i = (i + 1)
    return work

fn dvs_speech_goals(actor):
    var goals = dv_find(actor.policy, "communication_goals", [])
    var active = []
    var i = 0
    while (i < rt_count(goals)):
        var goal = goals[i]
        if dv_and((0 < rt_count(dv_find(goal, "basis", []))), (dv_truth(actor.mind, dv_find(goal, "available_when", dv_true())) == "true")):
            dv_require((not (goal.weight < 0)), "Negative communication weight")
            rt_push(active, goal)
        i = (i + 1)
    return active

fn dvs_speech_choice_signature(actor, action, goals, time):
    let listeners = dv_find(action, "listeners", [])
    let models = dv_find(actor.mind, "listener_models", [])
    var selected = []
    var i = 0
    while i < rt_count(listeners):
        let listener = listeners[i]
        let model = dv_find(models, listener, false)
        var gates = []
        if model != false:
            let parsed = dvs_speech_map(model.mind, action.speech.literal_ast, dv_find(action.speech, "referents", []))
            let refs = dvs_sim_refs(parsed)
            var j = 0
            while j < rt_count(refs):
                rt_push(gates, time < dv_read(model.mind, refs[j]).time)
                j = j + 1
        rt_push(selected, {"listener": listener, "model": model, "older_observation": gates})
        i = i + 1
    return {"speaker": actor.id, "literal_truth": dvs_speech_truth(actor.mind, action.speech), "speech": action.speech, "goals": goals, "models": selected}

fn dvs_speech_goal_value(goals, listener, prediction):
    var value = 0
    var i = 0
    var interpretations = prediction.prediction
    while (i < rt_count(goals)):
        var goal = goals[i]
        var targets = dv_find(goals[i], "listeners", [])
        var j = 0
        if dv_or((rt_count(targets) == 0), dv_has(targets, listener)):
            while (j < rt_count(interpretations)):
                var interpretation = interpretations[j]
                if dv_and((interpretation.id == goal.interpretation_id), (interpretation.status == goal.desired_status)):
                    value = (value + (goal.weight * interpretation.confidence))
                j = (j + 1)
        i = (i + 1)
    return value

fn dvs_prepare_speech_choices(actor, events, time, parent):
    var goals = dvs_speech_goals(actor)
    if rt_count(goals) == 0:
        return actor
    var actions = actor.actions
    var mind = actor.mind
    var models = dv_find(actor.mind, "listener_models", [])
    var cache = dv_find(actor, "speech_choice_values", [])
    var candidates = []
    var eligible = []
    var total = 0
    var i = 0
    var before = actor
    var remaining = dv_find(actor.policy, "model_budget", 0)
    var budget_parent = dv_find(actor, "model_previous_event", "")
    var choice_cognitive = dv_find(actor, "last_cognitive_event", "")
    if (rt_count(goals) == 0):
        false
    else:
        while (i < rt_count(actions)):
            var action = actions[i]
            var id = actions[i].id
            if dv_and(dv_has_key(action, "speech"), dv_find(action, "argument_available", true)):
                if dvp_eligible(actor, action, mind, []):
                    var truth = dvs_speech_truth(mind, action.speech)
                    var signature = dvs_speech_choice_signature(actor, action, goals, time)
                    if (not (truth == "true")):
                        cache = dv_with(cache, id, {"status": "illegal-literal", "utility": 0, "signature": signature})
                        dvs_event(events, "speech_choice_rejected", actor.id, time, dv_single(parent), {"action": action, "actor_before": before, "truth": truth, "charged_units": 0})
                    else:
                        rt_push(eligible, dv_pair(id, signature))
                        var local_1 = false
                        if dv_has_key(cache, id):
                            local_1 = dv_and((dv_get(cache, id).status == "ready"), dv_same(dv_get(cache, id).signature, signature))
                        else:
                            local_1 = false
                        if local_1:
                            false
                        else:
                            var listeners = dv_find(action, "listeners", [])
                            var j = 0
                            var units = 0
                            while (j < rt_count(listeners)):
                                var listener = listeners[j]
                                var local_2 = false
                                if dv_has_key(models, listener):
                                    local_2 = (0 < rt_count(dv_find(dv_get(models, listener), "basis", [])))
                                else:
                                    local_2 = false
                                if local_2:
                                    units = (units + dvs_speech_prediction_units(dv_get(models, listener), action.speech))
                                j = (j + 1)
                            rt_push(candidates, {"action": action, "signature": signature, "units": units})
                            total = (total + units)
            i = (i + 1)
    i = 0
    if (remaining < total):
        while (i < rt_count(eligible)):
            var entry = eligible[i]
            cache = dv_with(cache, entry[0], {"status": "unknown-incomplete-layer", "utility": 0, "signature": entry[1]})
            i = (i + 1)
        if (0 < rt_count(candidates)):
            dvs_event(events, "speech_choice_budget_stop", actor.id, time, dv_single(parent), {"actor_before": before, "required_units": total, "available_units": remaining, "charged_units": 0})
    else:
        while (i < rt_count(candidates)):
            var entry = candidates[i]
            var action = candidates[i].action
            var forecasts = []
            var event_ids = []
            var listeners = dv_find(candidates[i].action, "listeners", [])
            var j = 0
            var value = 0
            while (j < rt_count(listeners)):
                var listener = listeners[j]
                var data = false
                var units = 0
                var local_3 = false
                if dv_has_key(models, listener):
                    local_3 = (0 < rt_count(dv_find(dv_get(models, listener), "basis", [])))
                else:
                    local_3 = false
                if local_3:
                    units = dvs_speech_prediction_units(dv_get(models, listener), action.speech)
                    data = dvs_speech_model_prediction(dv_get(models, listener), action.speech, actor.id, rt_cat("preselect-", action.id), time)
                    data = dv_with_many(data, {"status": "model-based", "model": dv_get(models, listener)})
                    value = (value + dvs_speech_goal_value(goals, listener, data))
                else:
                    data = {"status": "unknown-no-model", "prediction": []}
                data = dv_with_many(data, {"listener": listener, "action": action, "actor_before": dv_with_many(actor, {"policy": dv_with(actor.policy, "model_budget", remaining), "model_previous_event": budget_parent, "last_cognitive_event": choice_cognitive}), "budget_before": remaining, "charged_units": units, "goals": goals})
                remaining = (remaining - units)
                data = dv_with(data, "budget_after", remaining)
                data = dv_with(data, "prediction_time", time)
                var local_4 = false
                if (0 < units):
                    local_4 = rt_cat("e", rt_show(rt_count(events)))
                else:
                    local_4 = budget_parent
                var local_5 = false
                if (0 < units):
                    local_5 = rt_cat("e", rt_show(rt_count(events)))
                else:
                    local_5 = choice_cognitive
                data = dv_with(data, "actor_after", dv_with_many(actor, {"policy": dv_with(actor.policy, "model_budget", remaining), "model_previous_event": local_4, "last_cognitive_event": local_5}))
                var local_6 = false
                if (budget_parent == ""):
                    local_6 = dv_single(parent)
                else:
                    local_6 = dv_pair(parent, budget_parent)
                let prediction_index = rt_count(events)
                var prediction_id = dvs_event(events, "speech_choice_prediction", actor.id, time, dvs_speech_cognitive_parents(local_6, choice_cognitive), data)
                rt_push(event_ids, prediction_id)
                if (0 < units):
                    budget_parent = prediction_id
                    choice_cognitive = prediction_id
                rt_push(forecasts, dv_pair(listener, prediction_index))
                j = (j + 1)
            cache = dv_with(cache, action.id, dv_with_many({"status": "ready", "utility": value, "signature": entry.signature, "forecasts": forecasts}, {"prediction_events": event_ids, "charged_units": entry.units}))
            i = (i + 1)
    return dv_with_many(actor, {"speech_choice_values": cache, "policy": dv_with(actor.policy, "model_budget", remaining), "model_previous_event": budget_parent, "last_cognitive_event": choice_cognitive})

fn dvs_proposal_reassess(actor, decision, events, time, parent):
    var rule = dv_find(actor.policy, "proposal_reassessment", false)
    var proposal = decision.proposal
    var interpretations = dv_find(actor, "interpretations", [])
    var remaining = dv_find(actor.policy, "reason_budget", 0)
    var last = dv_find(actor, "last_interpretation_event", "")
    var cognitive = dv_find(actor, "last_cognitive_event", "")
    var seen = dv_find(actor, "reassessed_proposals", [])
    var local_1 = false
    if (decision.proposal == false):
        local_1 = ""
    else:
        local_1 = dv_find(decision.proposal, "argument_id", "")
    var proposal_id = local_1
    if dv_and((decision.status == "accepted"), (not dv_has(seen, proposal_id))):
        if (rule == false):
            false
        else:
            if dv_and(dv_find(rule, "enabled", false), (0 < rt_count(dv_find(rule, "basis", [])))):
                var targets = dv_find(rule, "interpretation_ids", [])
                var required = dv_find(rule, "required_slots", [])
                var claims = dv_find(proposal, "claims", [])
                var complete = true
                var i = 0
                if (rt_count(required) == 0):
                    complete = false
                while (i < rt_count(required)):
                    var j = 0
                    var found = false
                    while (j < rt_count(claims)):
                        if (required[i] == claims[j].slot_id):
                            found = true
                        j = (j + 1)
                    if found:
                        false
                    else:
                        complete = false
                    i = (i + 1)
                i = 0
                while (i < rt_count(targets)):
                    var id = targets[i]
                    var old = dv_find(interpretations, targets[i], false)
                    var status = "insufficient-origin"
                    var charged = 0
                    var before = dv_with_many(actor, {"interpretations": interpretations, "policy": dv_with(actor.policy, "reason_budget", remaining), "last_interpretation_event": last, "last_cognitive_event": cognitive})
                    if (old == false):
                        status = "no-personal-interpretation"
                    else:
                        var scope = dv_find(old, "scope_check", [])
                        var source = dv_find(old, "source_event", "")
                        if (old.status == "accepted"):
                            false
                        else:
                            status = "no-prior-accepted-interpretation"
                        if dv_and(complete, dv_and((old.status == "accepted"), dv_and(dv_has(dv_find(proposal, "reassessment_sources", []), source), dv_and((dv_find(scope, "literal_scope", "") == dv_find(rule, "source_scope", "")), (dv_find(scope, "interpretation_scope", "") == dv_find(rule, "target_scope", "")))))):
                            if (remaining < 1):
                                status = "reason-budget-exhausted"
                            else:
                                remaining = (remaining - 1)
                                charged = 1
                                var candidate = {"id": id, "utterance_scope": dv_find(scope, "literal_scope", "")}
                                var revised = (dvs_listener_mapping(actor.mind, actor.policy, dv_find(old, "referents", [])) × {"id": id, "utterance_scope": dv_find(scope, "literal_scope", "")})
                                if (revised.scope_check.bridge_truth == "unknown"):
                                    status = "withdrawn"
                                    interpretations = dv_with(interpretations, id, dv_with_many(old, {"status": "withdrawn", "withdrawal_reason": "paid-scope-bridge-unsupported", "proposal_event": parent}))
                                else:
                                    status = "retained-supported-bridge"
                    var after = dv_with_many(actor, {"interpretations": interpretations, "policy": dv_with(actor.policy, "reason_budget", remaining), "last_interpretation_event": rt_cat("e", rt_show(rt_count(events))), "last_cognitive_event": rt_cat("e", rt_show(rt_count(events)))})
                    var local_2 = false
                    if (status == "withdrawn"):
                        local_2 = "implicature_withdrawn"
                    else:
                        local_2 = "proposal_scope_reassessment"
                    var local_3 = false
                    if (last == ""):
                        var local_4 = false
                        if (old == false):
                            local_4 = ""
                        else:
                            local_4 = dv_find(old, "source_event", "")
                        local_3 = dv_pair(parent, local_4)
                    else:
                        var local_5 = false
                        if (old == false):
                            local_5 = ""
                        else:
                            local_5 = dv_find(old, "source_event", "")
                        local_3 = dv_list3(parent, local_5, last)
                    var local_6 = false
                    if (old == false):
                        local_6 = ""
                    else:
                        local_6 = dv_find(old, "source_event", "")
                    last = dvs_event_prepared(events, local_2, actor.id, time, dvs_speech_cognitive_parents(local_3, cognitive), dv_with_many({"status": status, "actor_before": before, "actor_after": after, "charged_units": charged}, {"mind_before": actor.mind, "mind_after": actor.mind, "interpretations_before": dv_find(before, "interpretations", []), "interpretations_after": interpretations, "source_event": local_6, "proposal": proposal}))
                    cognitive = last
                    i = (i + 1)
                seen = dv_append(seen, proposal_id)
    return dv_with_many(actor, {"interpretations": interpretations, "policy": dv_with(actor.policy, "reason_budget", remaining), "last_interpretation_event": last, "reassessed_proposals": seen, "last_cognitive_event": cognitive})

// A norm receipt records understood content and provenance, never personal assent.
fn dvs_receive_norm(actor, norm, source, parse_event, events, time):
    let receipt = {"norm": norm, "source_event": source, "parse_event": parse_event, "received_time": time}
    let before = dv_find(actor, "norm_proposals", [])
    let after = dv_with(before, norm.id, receipt)
    let event = dvs_event_prepared(events, "norm_receipt", actor.id, time, dv_pair(source, parse_event), {"receipt": receipt, "proposals_before": before, "proposals_after": after})
    return dv_with_many(actor, {"norm_proposals": after, "last_cognitive_event": event})

// Only the actual owner's successfully completed decision changes personal rules.
fn dvs_complete_norm(actor, action, applied, events, time, execution_event, observation_event):
    if not applied:
        return actor
    let read_receipt = dv_find(action, "norm_receipt", false)
    if read_receipt != false:
        if observation_event != execution_event and dv_truth(actor.mind, read_receipt.content) == "true":
            actor = dvs_receive_norm(actor, read_receipt.norm, execution_event, observation_event, events, time)
    let decision = dv_find(action, "norm_decision", false)
    if decision == false:
        return actor
    let receipt = dv_find(dv_find(actor, "norm_proposals", []), decision.id, false)
    dv_require(receipt != false, "Norm decision needs an owner's actual content receipt")
    dv_require(dv_same(receipt.norm, decision.norm) and receipt.source_event != "" and receipt.parse_event != "", "Norm decision receipt must match understood content")
    let before = dv_find(actor.policy, "norm_rules", [])
    var rules = []
    var i = 0
    while i < rt_count(before):
        if before[i].id != decision.id:
            rt_push(rules, before[i])
        i = i + 1
    if decision.accepted:
        let norm = receipt.norm
        rt_push(rules, {"id": norm.id, "method": norm.method, "mode": norm.mode, "promotes": norm.promotes, "sacrifices": norm.sacrifices, "basis": [norm.source, receipt.source_event, receipt.parse_event, execution_event], "available_when": dv_true()})
    let stance = {"accepted": decision.accepted, "norm": receipt.norm, "source_event": receipt.source_event, "parse_event": receipt.parse_event, "execution_event": execution_event, "observation_event": observation_event}
    let stances = dv_with(dv_find(actor, "norm_stances", []), decision.id, stance)
    let event = dvs_event_prepared(events, "norm_decision", actor.id, time, [execution_event, observation_event, receipt.source_event, receipt.parse_event], {"decision": stance, "value_order": dv_find(actor.policy, "value_order", []), "personal_choice": dv_find(action, "personal_choice", []), "rules_before": before, "rules_after": rules})
    return dv_with_many(actor, {"policy": dv_with(actor.policy, "norm_rules", rules), "norm_stances": stances, "last_cognitive_event": event})

fn dvs_receive_scheduled_speech(listener, message, events, time):
    let speech = message.speech
    let literal = speech.literal_ast
    let bindings = dv_find(speech, "referents", [])
    let source = message.source
    let speaker_id = message.speaker
    let action_id = message.action_id
    let audibility = message.audibility
    var before = listener.mind
    var parsed = dvs_speech_map(before, literal, bindings)
    var policy = listener.policy
    var trust = dvs_speaker_trust(listener.policy, speaker_id)
    var decision = dvs_speech_proposal_decision(before, policy, speech, trust)
    var candidates_actual = dvs_speech_candidates(policy, speech)
    var after = before
    var profile = dv_observation_profile({"perception": 1, "testimony": 1, "recall": 1}, dv_find(listener.policy, "observation_threshold", 0.5))
    let observations = dvs_speech_received_observations(before, parsed, source, speaker_id, message.received_time, decision)
    if 0 < rt_count(observations):
        after = dv_update_mind(before, observations, before.revision, profile).world
    var interpretations = dv_find(listener, "interpretations", [])
    var last_interpretation = dv_find(listener, "last_interpretation_event", "")
    var n = 0
    var parse_event = false
    var proposal_event = false
    if (decision.status == "ordinary"):
        false
    else:
        proposal_event = dvs_event_prepared(events, "proposal_receipt", listener.id, time, dvs_speech_cognitive_parents(dv_single(source), dv_find(listener, "last_cognitive_event", "")), dv_with_many(decision, {"source_event": source, "mind_before": before, "mind_after": before}))
        proposal_event = dvs_event_prepared(events, "proposal_adoption", listener.id, time, dv_pair(source, proposal_event), dv_with_many(decision, {"source_event": source, "mind_before": before, "mind_after": after}))
    var local_2 = false
    if (proposal_event == false):
        local_2 = dv_single(source)
    else:
        local_2 = dv_pair(source, proposal_event)
    parse_event = dvs_event_prepared(events, "listener_parse", listener.id, time, dvs_speech_cognitive_parents(local_2, dv_find(listener, "last_cognitive_event", "")), dv_with_many({"mind_before": before, "mind_after": after, "literal": parsed, "observations": observations}, {"source_event": source, "speech": speech, "presuppositions": dvs_speech_presuppositions(before, speech), "audibility": audibility, "observation_profile": profile, "proposal_decision": decision}))
    listener = dvs_receive_request(listener, speech, parse_event, source, speaker_id)
    listener = dv_with(listener, "received_speeches", dv_append(dv_find(listener, "received_speeches", []), {"speaker": speaker_id, "action_id": action_id, "parse_event": parse_event, "source_event": source}))
    listener = dvs_receive_public_claim(listener, speech, speaker_id, source, parse_event)
    listener = dvs_receive_player_influence(listener, speech, speaker_id, source, parse_event)
    while (n < rt_count(candidates_actual)):
        var candidate = candidates_actual[n]
        var interpretation = (dvs_listener_mapping(after, policy, bindings) × candidates_actual[n])
        var interpretations_before = dv_clone(interpretations)
        interpretation = dv_with_many(interpretation, {"source_event": source, "referents": bindings})
        var local_3 = false
        if dv_has_key(interpretations, candidate.id):
            local_3 = (dv_get(interpretations, candidate.id).status == "accepted")
        else:
            local_3 = false
        if dv_and((interpretation.status == "withdrawn"), (not local_3)):
            interpretation = dv_with(interpretation, "status", "rejected")
        interpretations = dv_with(interpretations, candidate.id, interpretation)
        var local_4 = false
        if (interpretation.status == "withdrawn"):
            local_4 = "implicature_withdrawn"
        else:
            local_4 = "implicature"
        var local_5 = false
        if (last_interpretation == ""):
            local_5 = dv_pair(source, parse_event)
        else:
            local_5 = dv_list3(source, parse_event, last_interpretation)
        last_interpretation = dvs_event_prepared(events, local_4, listener.id, time, local_5, dv_with_many(interpretation, {"source_event": source, "mind_before": after, "mind_after": after, "interpretations_before": interpretations_before, "interpretations_after": interpretations}))
        n = (n + 1)
    var local_6 = false
    if (decision.status == "ordinary"):
        local_6 = dv_find(listener, "proposals", [])
    else:
        local_6 = dv_append(dv_find(listener, "proposals", []), dv_with(decision, "source_event", source))
    listener = dvs_proposal_reassess(dv_with_many(listener, {"mind": after, "interpretations": interpretations, "last_interpretation_event": last_interpretation, "proposals": local_6, "last_cognitive_event": parse_event}), decision, events, time, parse_event)
    let norm = dv_find(speech, "norm_proposal", false)
    if norm != false and dv_same(parsed, literal) and dv_truth(after, parsed) == "true":
        listener = dvs_receive_norm(listener, norm, source, parse_event, events, time)
    return listener

fn dvs_drain_received_speech(actor, events, time):
    let messages = dv_find(actor, "pending_heard", [])
    var current = actor
    if 0 < rt_count(messages):
        current = dv_with(actor, "pending_heard", [])
    var i = 0
    while i < rt_count(messages):
        current = dvs_receive_scheduled_speech(current, messages[i], events, time)
        i = i + 1
    return current

fn dvs_speech(actors, speaker_index, action, events, time, parent, physical):
    return dvs_speech_owned(dv_clone(actors), speaker_index, action, events, time, parent, physical)

// Linear session ownership: replace changed actors; snapshots were independently frozen.
fn dvs_speech_owned(actors, speaker_index, action, events, time, parent, physical):
    var speaker = actors[speaker_index]
    var speech = action.speech
    var speaker_mind = speaker.mind
    var bindings = dv_find(speech, "referents", [])
    var literal = speech.literal_ast
    var claim = dvs_speech_map(speaker_mind, literal, bindings)
    var listeners = dv_find(action, "listeners", [])
    var next = actors
    var i = 0
    var source = false
    var visited = []
    source = dvs_event_prepared(events, "speech_literal", speaker.id, time, dvs_speech_cognitive_parents(dv_single(parent), dv_find(speaker, "last_cognitive_event", "")), dv_with({"literal": literal, "claim": claim, "mind_before": speaker_mind, "speech": speech}, "speaker_truth", dv_truth(speaker_mind, claim)))
    if (not (dv_truth(speaker_mind, claim) == "true")):
        dvs_event(events, "speech_rejected", speaker.id, time, dv_single(source), {"reason": "speaker-truth-not-supported", "source_event": source})
    else:
        while (i < rt_count(listeners)):
            var listener_id = listeners[i]
            var j = 0
            var target_index = -1
            var prepared = dv_find(dv_find(speaker, "speech_choice_values", []), action.id, false)
            dv_require((not dv_has(visited, listener_id)), "Repeated speech listener")
            rt_push(visited, listener_id)
            while (j < rt_count(next)):
                if (next[j].id == listener_id):
                    target_index = j
                j = (j + 1)
            var local_1 = false
            if (prepared == false):
                local_1 = false
            else:
                local_1 = (prepared.status == "ready")
            if local_1:
                let prediction_index = dv_get(prepared.forecasts, listener_id)
                var predicted = events[prediction_index].data
                dvs_event_prepared(events, "speaker_prediction", speaker.id, time, dv_append(prepared.prediction_events, source), dv_with_many(predicted, {"source_event": source, "paid_prediction_events": prepared.prediction_events, "paid_forecast": predicted, "charged_units": 0, "execution_charged_units": 0, "speaker_after": speaker, "preselection_source_revision": predicted.actor_before.mind.revision}))
            else:
                dvs_event(events, "speaker_prediction", speaker.id, time, dv_single(source), {"listener": listener_id, "status": "unknown-no-paid-preselection", "source_event": source})
            if (target_index < 0):
                dvs_event(events, "speech_unheard", listener_id, time, dv_single(source), {"reason": "unknown-listener", "source_event": source})
            else:
                var listener = next[target_index]
                if (not dvs_speech_hearing(speaker, listener, speech, physical)):
                    dvs_event(events, "speech_unheard", listener_id, time, dv_single(source), {"reason": "no-audibility-grant", "source_event": source})
                else:
                    let message = {"speech": speech, "source": source, "speaker": speaker.id, "action_id": action.id, "received_time": time, "audibility": {"speaker_location": dvs_emission_location(speaker, speech, physical), "listener_location": dv_find(listener, "location", ""), "hearing_grants": dv_find(listener, "hearing_grants", [])}}
                    if dv_find(listener, "scheduled_action", false) != false:
                        next = dvs_replace(next, target_index, dv_with(listener, "pending_heard", dv_append(dv_find(listener, "pending_heard", []), message)))
                        dvs_event(events, "speech_received_pending", listener.id, time, [source], {"source_event": source, "audibility": message.audibility})
                    else:
                        next = dvs_replace(next, target_index, dvs_receive_scheduled_speech(listener, message, events, time))
            i = (i + 1)
    return next

fn dvs_pragmatics_reconsider(actor, events, time, parent):
    let mind = actor.mind
    let policy = actor.policy
    var interpretations = dv_find(actor, "interpretations", [])
    let entries = interpretations
    var i = 0
    var last = dv_find(actor, "last_interpretation_event", "")
    var cognitive = dv_find(actor, "last_cognitive_event", "")
    while i < rt_count(entries):
        let entry = entries[i]
        let old = entry[1]
        let candidate = {id: entry[0], utterance_scope: dv_find(dv_find(old, "scope_check", []), "literal_scope", "")}
        let bindings = dv_find(old, "referents", [])
        var revised = dvs_listener_mapping(mind, policy, bindings) × candidate
        if revised.status == "withdrawn" and old.status != "accepted" and old.status != "withdrawn":
            revised = dv_with(revised, "status", "rejected")
        let before_interpretations = interpretations
        let source = dv_find(old, "source_event", "")
        let previous = dv_find(old, "acceptance", {degree: 0, level: "held"})
        let transition = dv_acceptance_transition(previous, revised.acceptance, parent)
        if revised.status != old.status or not dv_same(previous, revised.acceptance):
            revised = dv_with_many(revised, [["source_event", source], ["referents", bindings], ["acceptance_transition", transition]])
            interpretations = dv_with(interpretations, entry[0], revised)
            var kind = "acceptance_changed"
            if transition.transition == "withdrawn" or revised.status == "withdrawn":
                kind = "implicature_withdrawn"
            var parents = dv_pair(parent, source)
            if last != "":
                parents = dv_list3(parent, source, last)
            let detail = dv_with_many(revised, [["mind_before", mind], ["mind_after", mind], ["interpretations_before", before_interpretations], ["interpretations_after", interpretations]])
            last = dvs_event(events, kind, actor.id, time, dvs_speech_cognitive_parents(parents, cognitive), detail)
            cognitive = last
        i = i + 1
    return dv_with_many(actor, [["interpretations", interpretations], ["last_interpretation_event", last], ["last_cognitive_event", cognitive]])
// Subject-local counterfactual temporal models. No authority or other actor lookup.
// An undecidable conditional reaction invalidates its possible outputs, not merely its score.
// Withhold predicted output fields before replay. Repeating old observations is not prediction.
// A fresh observation may refute an old paid prediction without replaying its hypothetical effects.
// Paid, evidence-relative symbolic exclusions. No domain is removed or hypothesis accepted.
// Pure validation replays an existing paid certificate; it does not issue an exclusion.

fn dvs_sim_refs(proposition):
    var op = proposition.op
    if dv_or((op == "equals"), (op == "at_least")):
        return dv_single(proposition.ref)
    else:
        if (op == "not"):
            return dvs_sim_refs(proposition.item)
        else:
            if (op == "all"):
                var items = proposition.items
                var refs = []
                var i = 0
                while (i < rt_count(items)):
                    var nested = dvs_sim_refs(items[i])
                    var j = 0
                    while (j < rt_count(nested)):
                        if dv_has(refs, nested[j]):
                            false
                        else:
                            rt_push(refs, nested[j])
                        j = (j + 1)
                    i = (i + 1)
                return refs
            else:
                return []

fn dvs_sim_plan(hypothesis):
    let key = ["compiled-model-plan", dv_has_key(hypothesis, "timeline"), dv_find(hypothesis, "predict_laws", [])]
    let timeline = dv_find(hypothesis, "timeline", [])
    let cached = rt_memo_get(timeline, key)
    if cached[0]:
        return cached[1]
    return rt_memo_put(timeline, key, dvs_sim_plan_build(hypothesis))

fn dvs_sim_plan_build(hypothesis):
    var timeline = dv_find(hypothesis, "timeline", [])
    var plan = []
    var i = 0
    if dv_has_key(hypothesis, "timeline"):
        while (i < rt_count(timeline)):
            var stage = timeline[i]
            var j = 0
            if dv_has_key(stage, "dispatch"):
                rt_push(plan, {"law": "", "at": stage.at, "optional": true, "stage": i, "dispatch": stage.dispatch})
            else:
                if dv_has_key(stage, "response"):
                    rt_push(plan, dv_with_many({"law": "", "at": stage.at, "optional": dv_find(stage, "optional", false), "stage": i}, {"response": stage.response, "available_when": dv_find(stage, "available_when", dv_true())}))
                else:
                    var local_1 = false
                    if dv_has_key(stage, "laws"):
                        local_1 = stage.laws
                    else:
                        local_1 = dv_single(stage.law)
                    var laws = local_1
                    dv_require((0 < rt_count(laws)), "Empty model event stage")
                    while (j < rt_count(laws)):
                        rt_push(plan, {"law": laws[j], "at": stage.at, "optional": dv_find(stage, "optional", false), "stage": i})
                        j = (j + 1)
            i = (i + 1)
    else:
        var laws = dv_find(hypothesis, "predict_laws", [])
        while (i < rt_count(laws)):
            rt_push(plan, {"law": laws[i], "at": 0, "optional": false, "stage": i})
            i = (i + 1)
    return plan

fn dvs_sim_withhold(world, effects):
    var copy = world
    var refs = []
    var i = 0
    while (i < rt_count(effects)):
        var ref = effects[i].ref
        if dv_has_key(copy.objects, ref.object):
            copy = dv_store(copy, ref, dv_unknown())
            rt_push(refs, ref)
        i = (i + 1)
    return {"world": copy, "refs": refs}

fn dvs_sim_feature(feature):
    if dv_has_key(feature, "proposition"):
        return feature.proposition
    else:
        return feature

fn dvs_sim_mask_plan(plan):
    var result = []
    var i = 0
    while (i < rt_count(plan)):
        let step = plan[i]
        if dv_has_key(step, "dispatch"):
            var j = 0
            while (j < rt_count(step.dispatch.laws)):
                rt_push(result, {"law": step.dispatch.laws[j]})
                j = j + 1
        else:
            rt_push(result, step)
        i = i + 1
    return result

fn dvs_sim_mask(mind, source_plan, start):
    let plan = dvs_sim_mask_plan(source_plan)
    var copy = dv_with_many(mind, {"time": start, "seen": [], "history": []})
    var i = 0
    while (i < rt_count(plan)):
        var name = plan[i].law
        var adoptions = mind.adoptions
        if dv_has_key(adoptions, name):
            var adoption = dv_get(adoptions, name)
            var j = 0
            var effects = dv_get(adoptions, name).law.effects
            if dv_and(adoption.active, (adoption.mode == "predict")):
                while (j < rt_count(effects)):
                    var ref = effects[j].ref
                    if dv_has_key(copy.objects, ref.object):
                        copy = dv_store(copy, ref, dv_unknown())
                    j = (j + 1)
        i = (i + 1)
    return copy

fn dvs_sim_inputs(world, proposition):
    var refs = dvs_sim_refs(proposition)
    var i = 0
    var inputs = []
    while (i < rt_count(refs)):
        rt_push(inputs, {"ref": refs[i], "cell": dv_read(world, refs[i])})
        i = (i + 1)
    return inputs

fn dvs_sim_snapshot(snapshots, final, covered, feature):
    if dv_has_key(feature, "at"):
        var i = 0
        var selected = {"world": final, "coverage": [], "step": -1}
        var found = false
        var at = feature.at
        dv_require((not (at < 0)), "Negative model feature time")
        while (i < rt_count(snapshots)):
            var snapshot = snapshots[i]
            if (at == snapshot.at):
                selected = snapshot
                found = true
            i = (i + 1)
        if found:
            return selected
        else:
            return {"world": final, "coverage": [], "step": -1}
    else:
        return {"world": final, "coverage": covered, "step": (rt_count(snapshots) - 1)}

fn dvs_sim_prediction(feature, snapshot, start):
    var proposition = dvs_sim_feature(feature)
    var refs = dvs_sim_refs(dvs_sim_feature(feature))
    var world = snapshot.world
    var coverage = snapshot.coverage
    var i = 0
    var cells = []
    var valid = true
    var confidence = 1
    if (rt_count(refs) == 0):
        valid = false
    while (i < rt_count(refs)):
        var ref = refs[i]
        var cell = dv_read(world, refs[i])
        rt_push(cells, {"ref": ref, "cell": cell})
        if dv_and(dv_has(coverage, ref), dv_uncontested(cell)):
            confidence = dv_min(confidence, cell.confidence)
        else:
            valid = false
        i = (i + 1)
    var local_1 = false
    if valid:
        local_1 = dv_truth(world, proposition)
    else:
        local_1 = "unknown"
    var local_2 = false
    if valid:
        local_2 = confidence
    else:
        local_2 = 0
    return dv_with_many({"feature": feature, "proposition": proposition, "prediction": local_1, "cells": cells}, {"covered": valid, "confidence": local_2, "source_step": dv_find(snapshot, "step", -1)})

fn dvs_sim_compare(mind, prediction):
    var feature = prediction.feature
    var proposition = prediction.proposition
    var refs = dvs_sim_refs(dv_find(prediction.feature, "observation", prediction.proposition))
    var observation = dv_truth(mind, dv_find(prediction.feature, "observation", prediction.proposition))
    var certainty = prediction.confidence
    var available = true
    var temporal_mismatch = false
    var i = 0
    var observed = []
    while (i < rt_count(refs)):
        var cell = dv_read(mind, refs[i])
        rt_push(observed, {"ref": refs[i], "cell": cell})
        if dv_uncontested(cell):
            certainty = dv_min(certainty, cell.confidence)
        else:
            available = false
        i = (i + 1)
    if dv_has_key(feature, "occurrence_ref"):
        var occurrence = dv_read(mind, feature.occurrence_ref)
        rt_push(observed, {"ref": feature.occurrence_ref, "cell": occurrence})
        if dv_uncontested(occurrence):
            certainty = dv_min(certainty, occurrence.confidence)
            if dv_same(occurrence.value, feature.occurrence_time):
                false
            else:
                temporal_mismatch = true
        else:
            available = false
    var resolved = dv_and(available, dv_and(prediction.covered, dv_and((0 < certainty), dv_and((not (observation == "unknown")), (not (prediction.prediction == "unknown"))))))
    var local_1 = false
    if available:
        local_1 = observation
    else:
        local_1 = "unknown"
    var local_2 = false
    if resolved:
        local_2 = certainty
    else:
        local_2 = 0
    var local_3 = false
    if resolved:
        if dv_and((not temporal_mismatch), (observation == prediction.prediction)):
            local_3 = "match"
        else:
            local_3 = "contradiction"
    else:
        local_3 = "unknown"
    return dv_with_many({"feature": feature, "prediction": prediction.prediction, "observation": local_1, "covered": prediction.covered}, {"confidence": local_2, "observed_cells": observed, "result": local_3})

fn dvs_sim_comparisons(mind, predictions, budget):
    var remaining = budget
    var expanded = 0
    var i = 0
    var fit = 0
    var comparisons = []
    var contradictions = []
    var complete = true
    var probes = []
    dv_require((not (budget < 0)), "Negative simulation comparison budget")
    while dv_and((i < rt_count(predictions)), (not (remaining < 1))):
        var prediction = predictions[i]
        var comparison = dvs_sim_compare(mind, predictions[i])
        var j = 0
        var refs = dvs_sim_refs(predictions[i].proposition)
        remaining = (remaining - 1)
        expanded = (expanded + 1)
        rt_push(comparisons, comparison)
        if (comparison.result == "match"):
            fit = (fit + comparison.confidence)
        else:
            if (comparison.result == "contradiction"):
                rt_push(contradictions, comparison)
            else:
                complete = false
                while (j < rt_count(refs)):
                    if dv_has(probes, refs[j]):
                        false
                    else:
                        rt_push(probes, refs[j])
                    j = (j + 1)
        i = (i + 1)
    if dv_or((rt_count(predictions) == 0), (i < rt_count(predictions))):
        complete = false
    var local_1 = false
    if (0 < rt_count(contradictions)):
        local_1 = -1000000
    else:
        local_1 = fit
    var local_2 = false
    if (0 < rt_count(contradictions)):
        local_2 = "inconsistent"
    else:
        if complete:
            local_2 = "explained"
        else:
            local_2 = "unknown"
    return dv_with_many({"fit": local_1, "comparisons": comparisons, "contradictions": contradictions, "remaining": remaining}, {"expanded": expanded, "probe_refs": probes, "status": local_2})

fn dvs_sim_work_budget(actor):
    var policy = actor.policy
    var total = dv_find(actor.policy, "model_budget", 0)
    var work = dv_find(actor.policy, "model_work_remaining", dv_find(actor.policy, "model_work_limit", dv_find(actor.policy, "model_budget", 0)))
    dv_require((not (work < 0)), "Negative method work limit")
    dv_require((not (total < 0)), "Negative total model budget")
    return dv_min(total, work)

fn dvs_model_execute(actor, hypothesis, events, time, parent):
    var mind = actor.mind
    var plan = dvs_sim_plan(hypothesis)
    var start = dv_find(hypothesis, "start_time", time)
    var predicted = false
    var assumptions = dv_find(hypothesis, "assumptions", [])
    var features = dv_find(hypothesis, "features", [])
    var remaining = dvs_sim_work_budget(actor)
    var total_budget = dv_find(actor.policy, "model_budget", 0)
    var expanded = 0
    var failures = []
    var covered = []
    var trace = []
    var snapshots = []
    var predictions = []
    var assumption_records = []
    var confidence = dv_unit(dv_find(hypothesis, "prior", 0.5))
    var i = 0
    var complete = true
    // Replay depth bounds ordered causal stages, independently of action-plan depth.
    let replay_limit = dv_find(actor.policy, "Replay_Depth", rt_count(plan))
    dv_require(0 <= replay_limit and rt_floor(replay_limit) == replay_limit, "Replay depth must be a nonnegative integer")
    var replay_stages = 0
    var replay_stage = -1
    var replay_limited = false
    var last_at = 0
    dv_domain(mind, "mind")
    dv_require((not (remaining < 0)), "Negative simulation budget")
    dv_require((not (start < 0)), "Negative model origin time")
    let mask_plan = dv_find(hypothesis, "mask_plan", plan)
    predicted = dvs_sim_mask_response(actor, dvs_sim_mask(mind, mask_plan, start), mask_plan)
    if (0 < rt_count(assumptions)):
        dv_require((confidence < 1), "Hypothetical assumption cannot have certainty")
    while dv_and((i < rt_count(assumptions)), (not (remaining < 1))):
        var assumption = assumptions[i]
        remaining = (remaining - 1)
        expanded = (expanded + 1)
        if (assumption.op == "equals"):
            var ref = assumption.ref
            if dv_has_key(predicted.objects, ref.object):
                predicted = dv_store(predicted, ref, dv_cell(assumption.value, confidence, start, hypothesis.basis))
                rt_push(assumption_records, {"proposition": assumption, "confidence": confidence, "role": "hypothetical-only"})
            else:
                complete = false
                rt_push(failures, {"assumption": assumption, "reason": "unknown-subject-local-object"})
        else:
            complete = false
            rt_push(failures, {"assumption": assumption, "reason": "unsupported-assumption"})
        i = (i + 1)
    if (i < rt_count(assumptions)):
        complete = false
    i = 0
    while i < rt_count(plan) and 0 < remaining and (plan[i].stage == replay_stage or replay_stages < replay_limit):
        var step = plan[i]
        if step.stage != replay_stage:
            replay_stage = step.stage
            replay_stages = replay_stages + 1
        var name = plan[i].law
        var at = plan[i].at
        var adoptions = mind.adoptions
        dv_require((not (at < last_at)), "Model time cannot move backwards")
        remaining = (remaining - 1)
        expanded = (expanded + 1)
        last_at = at
        if dv_has_key(step, "response"):
            var response = dvs_sim_gated_response(actor, dv_with(predicted, "domain", "mind"), step, (start + at), remaining, confidence)
            var detail = response.detail
            predicted = response.world
            remaining = response.remaining
            expanded = (expanded + detail.expanded)
            detail = dv_with(detail, "choice_record_changes", response.changes)
            if (detail.status == "selected"):
                var bridge = dvs_sim_response_bridge(actor, predicted, detail, (start + at), remaining, confidence)
                predicted = bridge.world
                remaining = bridge.remaining
                expanded = (expanded + bridge.expanded)
                detail = dv_with(detail, "bridge", bridge)
                if (bridge.status == "applied"):
                    var changes = bridge.changes
                    var j = 0
                    while (j < rt_count(changes)):
                        if dv_has(covered, changes[j].ref):
                            false
                        else:
                            rt_push(covered, changes[j].ref)
                        j = (j + 1)
                else:
                    complete = false
                    rt_push(failures, {"response": step.response, "reason": bridge.status})
            else:
                if dv_and((detail.status == "not-applicable"), step.optional):
                    false
                else:
                    complete = false
                    rt_push(failures, {"response": step.response, "reason": detail.reason})
            rt_push(trace, {"step": i, "at": at, "stage": step.stage, "response": detail})
        else:
            var selected_steps = [step]
            if dv_has_key(step, "dispatch"):
                let dispatch = dvs_sim_dispatch(mind, predicted, step)
                selected_steps = dispatch.steps
                rt_push(trace, {"step": i, "at": at, "stage": step.stage, "status": "indexed-dispatch", "indexed": dispatch.indexed, "inputs": dispatch.inputs, "excluded": dispatch.excluded, "changes": []})
            var selected_index = 0
            while (selected_index < rt_count(selected_steps) and (not dv_has_key(step, "dispatch") or 0 < remaining)):
                if dv_has_key(step, "dispatch"):
                    remaining = remaining - 1
                    expanded = expanded + 1
                let execution = dvs_sim_rule(predicted, covered, selected_steps[selected_index], mind, confidence, start, i, rt_count(events), selected_index)
                predicted = execution.world
                covered = execution.coverage
                complete = complete and execution.complete
                var entry_index = 0
                while (entry_index < rt_count(execution.trace)):
                    rt_push(trace, execution.trace[entry_index])
                    entry_index = entry_index + 1
                entry_index = 0
                while (entry_index < rt_count(execution.failures)):
                    rt_push(failures, execution.failures[entry_index])
                    entry_index = entry_index + 1
                selected_index = selected_index + 1
            if (selected_index < rt_count(selected_steps)):
                complete = false
        rt_push(snapshots, {"world": predicted, "coverage": dv_clone(covered), "step": i, "at": at})
        i = (i + 1)
    if i < rt_count(plan):
        replay_limited = plan[i].stage != replay_stage and replay_limit <= replay_stages
    if dv_or((rt_count(plan) == 0), (i < rt_count(plan))):
        complete = false
    i = 0
    while (i < rt_count(features)):
        rt_push(predictions, dvs_sim_prediction(features[i], dvs_sim_snapshot(snapshots, predicted, covered, features[i]), start))
        i = (i + 1)
    var comparison = dvs_sim_comparisons(mind, predictions, remaining)
    var result = dv_with_many(comparison, {"expanded": (expanded + comparison.expanded), "failures": failures, "coverage": covered, "assumptions": assumption_records, "predictions": predictions, "trace": trace})
    result = dv_with(result, "predicted", predicted)
    if dv_and((not complete), (result.status == "explained")):
        result = dv_with(result, "status", "unknown")
    result = dv_with_many(result, {"plan_complete": complete, "source_revision": mind.revision, "original_revision": mind.revision, "role": "internal-enumeration", "start_time": start})
    var local_2 = false
    if (result.remaining < 1):
        local_2 = "budget-exhausted"
    else:
        local_2 = "declared-plan-complete"
    result = dv_with_many(result, {"calculation_unit": "one-assumption-predict-rule-indexed-dispatch-context-binding-option-prediction-option-evaluation-response-dispatch-or-feature-comparison", "stop_reason": local_2})
    if replay_limited:
        result = dv_with(result, "stop_reason", "replay-depth-exhausted")
    result = dv_with_many(result, {"replay_depth_limit": replay_limit, "replay_stages_expanded": replay_stages, "replay_depth_exhausted": replay_limited})
    result = dv_with_many(result, {"work_remaining": result.remaining, "remaining": (total_budget - result.expanded)})
    result = dv_with_many(result, {"original_expanded": result.expanded, "total_expanded": result.expanded})
    var parents = dvs_cognitive_parents(actor, dv_single(parent))
    var paid = dv_find(actor, "model_paid_event", "")
    var previous = dv_find(actor, "model_previous_event", "")
    if dv_and((not (paid == "")), (not dv_has(parents, paid))):
        rt_push(parents, paid)
    if dv_and((not (previous == "")), (not dv_has(parents, previous))):
        rt_push(parents, previous)
    dvs_event(events, "mind_simulation", actor.id, time, parents, {"mind_revision": mind.revision, "hypothesis": hypothesis, "result": result, "actor_before": actor, "actor_id": actor.id})
    return result

fn dvs_model_recheck(actor, model):
    var mind = actor.mind
    var comparison = dvs_sim_comparisons(actor.mind, model.predictions, dvs_sim_work_budget(actor))
    var result = dv_clone(model)
    var keys = dv_list3("fit", "comparisons", "contradictions")
    var i = 0
    rt_push(keys, "remaining")
    rt_push(keys, "expanded")
    rt_push(keys, "probe_refs")
    rt_push(keys, "status")
    while (i < rt_count(keys)):
        result = dv_with(result, keys[i], dv_get(comparison, keys[i]))
        i = (i + 1)
    if dv_and((not model.plan_complete), (result.status == "explained")):
        result = dv_with(result, "status", "unknown")
    result = dv_with_many(result, {"work_remaining": comparison.remaining, "remaining": (dv_find(actor.policy, "model_budget", 0) - comparison.expanded)})
    var local_1 = false
    if (comparison.remaining < 1):
        local_1 = "budget-exhausted"
    else:
        local_1 = "observations-compared"
    result = dv_with_many(result, {"total_expanded": (dv_find(model, "total_expanded", model.expanded) + comparison.expanded), "stop_reason": local_1})
    if dv_find(model, "replay_depth_exhausted", false):
        result = dv_with(result, "stop_reason", "replay-depth-exhausted")
    return dv_with_many(result, {"source_revision": mind.revision, "paid_model_event": dv_find(model, "paid_model_event", dv_find(model, "event", "")), "role": "new-observation-recheck"})

fn dvs_sim_response_unknown(world, remaining, reason):
    return {"world": world, "changes": [], "remaining": remaining, "detail": {"status": "unknown", "reason": reason, "expanded": 0, "committed": false}}

fn dvs_sim_response(actor, world, stage, time, remaining, confidence):
    var models = dv_find(actor, "response_models", [])
    var model_id = stage.model
    if (not dv_has_key(models, model_id)):
        return dvs_sim_response_unknown(world, remaining, "no-subject-local-response-model")
    else:
        var model = dv_with(dv_get(models, model_id), "confidence", dv_min(confidence, dv_find(dv_get(models, model_id), "confidence", 0)))
        if (not dv_and((dv_find(model, "owner", "") == actor.id), dv_and((0 < rt_count(dv_find(model, "basis", []))), (0 < dv_unit(dv_find(model, "confidence", 0)))))):
            return dvs_sim_response_unknown(world, remaining, "unavailable-response-model-basis")
        else:
            var local = dv_clone(model.world)
            var bindings = dv_find(model, "context", [])
            var option_ids = stage.options
            var catalog = model.options
            var policy_id = model.policy_id
            var request_id = stage.request
            var requests = model.requests
            var required = (rt_count(bindings) + (2 * rt_count(option_ids)))
            dv_domain(local, "mind")
            if (remaining < required):
                return dvs_sim_response_unknown(world, remaining, "method-work-limit-before-response")
            else:
                if (not dv_has_key(requests, request_id)):
                    return dvs_sim_response_unknown(world, remaining, "unknown-modeled-request")
                else:
                    if (not dv_has_key(dv_find(local, "policies", []), policy_id)):
                        return dvs_sim_response_unknown(world, remaining, "unknown-modeled-value-policy")
                    else:
                        var accepted = dv_get(local.policies, policy_id)
                        if (not dv_and(accepted.active, (0 < rt_count(accepted.basis)))):
                            return dvs_sim_response_unknown(world, remaining, "unadopted-modeled-value-policy")
                        else:
                            var request = dv_get(requests, request_id)
                            var options = []
                            var inputs = []
                            var option_traces = []
                            var i = 0
                            var complete = true
                            var expanded = 0
                            var chosen = false
                            var prediction = false
                            var response = false
                            var next = world
                            var changes = []
                            var reason = "unknown-response-basis"
                            var response_confidence = model.confidence
                            local = dv_with_many(local, {"time": time, "seen": []})
                            while (i < rt_count(bindings)):
                                var binding = bindings[i]
                                var cell = dv_read(world, bindings[i].from)
                                expanded = (expanded + 1)
                                remaining = (remaining - 1)
                                rt_push(inputs, {"from": binding.from, "to": binding.to, "cell": cell})
                                if dv_and(dv_uncontested(cell), (0 < cell.confidence)):
                                    response_confidence = dv_min(response_confidence, cell.confidence)
                                else:
                                    complete = false
                                    reason = "unknown-required-response-context"
                                if dv_has_key(local.objects, binding.to.object):
                                    var local_1 = false
                                    if dv_uncontested(cell):
                                        local_1 = dv_with(cell, "confidence", dv_min(cell.confidence, model.confidence))
                                    else:
                                        local_1 = dv_unknown()
                                    local = dv_store(local, binding.to, local_1)
                                else:
                                    complete = false
                                i = (i + 1)
                            i = 0
                            while (i < rt_count(option_ids)):
                                var option_id = option_ids[i]
                                expanded = (expanded + 2)
                                remaining = (remaining - 2)
                                if dv_has_key(catalog, option_id):
                                    var descriptor = dv_get(catalog, option_id)
                                    var name = dv_find(dv_get(catalog, option_id), "predict_law", "")
                                    var result = false
                                    var legal = dv_truth(local, dv_get(catalog, option_id).feasible)
                                    prediction = dv_no_change_prediction(local)
                                    if (legal == "unknown"):
                                        complete = false
                                    if (name == ""):
                                        false
                                    else:
                                        if dv_has_key(local.adoptions, name):
                                            var adoption = dv_get(local.adoptions, name)
                                            if dv_and(adoption.active, (adoption.mode == "predict")):
                                                result = dv_predict(local, name, rt_cat("response-option-", rt_show(i)), time, local.revision)
                                                if (result.status == "applied"):
                                                    prediction = result.world
                                                else:
                                                    if (legal == "false"):
                                                        false
                                                    else:
                                                        complete = false
                                            else:
                                                if (legal == "false"):
                                                    false
                                                else:
                                                    complete = false
                                        else:
                                            if (legal == "false"):
                                                false
                                            else:
                                                complete = false
                                    rt_push(options, dv_response_option(option_id, descriptor.intent, descriptor.feasible, prediction, descriptor.effort, descriptor.feature_weights))
                                    rt_push(option_traces, {"id": option_id, "legal": legal, "prediction_receipt": result, "model_prediction": prediction})
                                else:
                                    complete = false
                                    rt_push(option_traces, {"id": option_id, "legal": "unknown-option"})
                                i = (i + 1)
                            response = dv_respond_adopted(local, request, options, policy_id)
                            var evaluated = response.evaluated
                            var j = 0
                            var ties = 0
                            var best = 0
                            var found_best = false
                            while (j < rt_count(evaluated)):
                                var evaluation = evaluated[j][1]
                                var score = evaluated[j][1].score
                                if dv_and(evaluation.value.complete, (rt_count(evaluation.relationship_and_state.unknown) == 0)):
                                    false
                                else:
                                    complete = false
                                var local_2 = false
                                if found_best:
                                    local_2 = (best < score)
                                else:
                                    local_2 = true
                                if local_2:
                                    best = score
                                    ties = 1
                                    found_best = true
                                else:
                                    if (best == score):
                                        ties = (ties + 1)
                                j = (j + 1)
                            if (1 < ties):
                                if complete:
                                    reason = "modeled-response-tie"
                                complete = false
                            if dv_and(complete, (response.status == "selected")):
                                var id = response.choice.id
                                var choice_ref = model.choice_ref
                                chosen = id
                                reason = "selected-by-shared-response"
                                if dv_has_key(next.objects, choice_ref.object):
                                    var before = dv_read(next, choice_ref)
                                    var after = dv_cell(id, response_confidence, time, model.basis)
                                    next = dv_store(next, choice_ref, after)
                                    rt_push(changes, {"ref": choice_ref, "before": before, "after": after})
                                else:
                                    complete = false
                                    reason = "unknown-local-choice-record"
                            var local_3 = false
                            if complete:
                                local_3 = response.status
                            else:
                                local_3 = "unknown"
                            var local_4 = false
                            if (chosen == false):
                                local_4 = ""
                            else:
                                local_4 = dv_find(dv_get(catalog, chosen), "bridge_law", "")
                            return {"world": next, "changes": changes, "remaining": remaining, "detail": dv_with_many({"status": local_3, "reason": reason, "expanded": expanded, "committed": false}, {"model": model_id, "model_basis": model.basis, "context_inputs": inputs, "option_predictions": option_traces, "response": response, "selected": chosen, "bridge_law": local_4})}

fn dvs_sim_mask_response_option(world, model, option_id):
    var option = dv_find(model.options, option_id, [])
    if dv_has_key(option, "bridge_law"):
        var name = option.bridge_law
        if dv_has_key(world.adoptions, name):
            return dvs_sim_withhold(world, dv_get(world.adoptions, name).law.effects).world
        else:
            return world
    else:
        return world

fn dvs_sim_mask_response_stage(actor, world, stage):
    var models = dv_find(actor, "response_models", [])
    var id = stage.model
    if dv_has_key(models, id):
        var model = dv_get(models, id)
        var options = stage.options
        var i = 0
        var copy = world
        if dv_has_key(model, "choice_ref"):
            if dv_has_key(copy.objects, model.choice_ref.object):
                copy = dv_store(copy, model.choice_ref, dv_unknown())
        while (i < rt_count(options)):
            copy = dvs_sim_mask_response_option(copy, model, options[i])
            i = (i + 1)
        return copy
    else:
        return world

fn dvs_sim_mask_response(actor, world, plan):
    var copy = world
    var i = 0
    while (i < rt_count(plan)):
        var step = plan[i]
        if dv_has_key(step, "response"):
            copy = dvs_sim_mask_response_stage(actor, copy, step.response)
        i = (i + 1)
    return copy

fn dvs_sim_response_bridge(actor, world, detail, time, remaining, confidence):
    var name = detail.bridge_law
    var adoptions = actor.mind.adoptions
    if dv_or((name == ""), (not dv_has_key(adoptions, name))):
        return dv_with({"world": world, "changes": [], "remaining": remaining, "status": "unknown-response-bridge"}, "expanded", 0)
    else:
        var adoption = dv_get(adoptions, name)
        var effects = dv_get(adoptions, name).law.effects
        if dv_or((remaining < 1), (not dv_and(adoption.active, (adoption.mode == "predict")))):
            return dv_with({"world": dvs_sim_withhold(world, effects).world, "changes": [], "remaining": remaining, "status": "unavailable-response-bridge"}, "expanded", 0)
        else:
            var local = dv_with_many(world, {"domain": "mind", "adoptions": dv_with(world.adoptions, name, dv_with(adoption, "confidence", dv_min(confidence, dv_min(adoption.confidence, dv_premise_confidence(world, adoption.law.premise)))))})
            var result = false
            result = dv_predict(local, name, rt_cat("response-bridge-", rt_show(world.revision)), time, world.revision)
            var local_1 = false
            if (result.status == "applied"):
                local_1 = result.world
            else:
                local_1 = dvs_sim_withhold(world, effects).world
            return dv_with_many(result, {"world": local_1, "remaining": (remaining - 1), "expanded": 1})

fn dvs_sim_gated_response(actor, world, step, time, remaining, confidence):
    var gate = dv_find(step, "available_when", dv_true())
    var truth = dv_truth(world, dv_find(step, "available_when", dv_true()))
    var result = false
    var local_1 = false
    if (truth == "true"):
        local_1 = dvs_sim_response(actor, world, step.response, time, remaining, confidence)
    else:
        if (truth == "false"):
            local_1 = {"world": world, "changes": [], "remaining": remaining, "detail": {"status": "not-applicable", "reason": "request-gate-false", "expanded": 0, "committed": false}}
        else:
            local_1 = dvs_sim_response_unknown(dvs_sim_mask_response_stage(actor, world, step.response), remaining, "request-gate-unknown")
    result = local_1
    return dv_with(result, "detail", dv_with_many(result.detail, {"gate": gate, "gate_truth": truth, "gate_inputs": dvs_sim_inputs(world, gate)}))

fn dvs_factor_proof_result(valid, remaining, confidence, steps, roots):
    return dv_with({"valid": valid, "remaining": remaining, "confidence": confidence, "steps": steps}, "source_events", roots)

fn dvs_factor_merge(left, right):
    var steps = dv_clone(left.steps)
    var roots = dv_clone(left.source_events)
    var i = 0
    while (i < rt_count(right.steps)):
        rt_push(steps, right.steps[i])
        i = (i + 1)
    i = 0
    while (i < rt_count(right.source_events)):
        if dv_has(roots, right.source_events[i]):
            false
        else:
            rt_push(roots, right.source_events[i])
        i = (i + 1)
    return dvs_factor_proof_result(dv_and(left.valid, right.valid), right.remaining, dv_min(left.confidence, right.confidence), steps, roots)

fn dvs_factor_law_allowed(allowed, law):
    var i = 0
    var found = false
    while (i < rt_count(allowed)):
        if dv_and((allowed[i].id == law.name), (allowed[i].version == law.version)):
            found = true
        i = (i + 1)
    return found

fn dvs_factor_roots(actor, mind, ref, events, cutoff, remaining, allowed):
    var cell = dv_read(mind, ref)
    var result = dvs_factor_proof_result(false, remaining, 0, [], [])
    var i = 0
    if (not (remaining < 1)):
        result = dvs_factor_proof_result(false, (remaining - 1), 0, [], [])
        if dv_and(dv_uncontested(cell), dv_and((0 < cell.confidence), dv_and((not dv_find(cell, "estimated", false)), (not (dv_find(cell, "source", "") == "abduction"))))):
            while dv_and((i < cutoff), (not result.valid)):
                var event = events[i]
                if (event.actor == actor.id):
                    var kind = event.type
                    var data = event.data
                    if dv_or((kind == "observation"), (kind == "listener_parse")):
                        if dv_has_key(data, "mind_after"):
                            if dv_same(dv_read(data.mind_after, ref), cell):
                                var observations = dv_find(data, "observations", [])
                                var j = 0
                                var claims = dv_find(cell, "claims", [])
                                var valid = true
                                var confidence = cell.confidence
                                var roots = []
                                var steps = []
                                if (rt_count(claims) == 0):
                                    valid = false
                                while (j < rt_count(claims)):
                                    var claim = claims[j]
                                    var source = claims[j].source
                                    if dv_and(dv_has(observations, claim), dv_and((claim.subject == actor.id), dv_and(dv_same_local_ref(actor.id, claim.ref, ref), dv_and(dv_has(data.mind_after.seen, claim.id), dv_or((source == "perception"), dv_or((source == "recall"), (source == "testimony"))))))):
                                        confidence = dv_min(confidence, claim.trust)
                                    else:
                                        valid = false
                                    j = (j + 1)
                                if dv_and(valid, (0 < confidence)):
                                    rt_push(roots, event.id)
                                    rt_push(steps, dv_with({"kind": "observation", "event": event.id, "ref": ref, "cell": cell}, "observations", claims))
                                    result = dvs_factor_proof_result(true, result.remaining, confidence, steps, roots)
                    if (kind == "inference"):
                        result = dvs_factor_inference(actor, mind, ref, cell, events, i, data, event, result.remaining, allowed)
                i = (i + 1)
    return result

fn dvs_factor_refs_proof(actor, mind, refs, events, cutoff, remaining, allowed):
    var result = dvs_factor_proof_result(true, remaining, 1, [], [])
    var i = 0
    while dv_and(result.valid, (i < rt_count(refs))):
        result = dvs_factor_merge(result, dvs_factor_roots(actor, mind, refs[i], events, cutoff, result.remaining, allowed))
        i = (i + 1)
    return result

fn dvs_factor_inference(actor, mind, ref, cell, events, index, data, event, remaining, allowed):
    var law = data.law
    var before = data.mind_before
    var receipt = data.receipt
    var current = actor.mind.adoptions
    var name = data.law.name
    var result = dvs_factor_proof_result(false, remaining, 0, [], [])
    var changes = dv_find(data.receipt, "changes", [])
    var i = 0
    var found = false
    while (i < rt_count(changes)):
