        var units = certificate.paid_units
        if dv_and((mind.revision == certificate.current_revision), dv_and(certificate.estimated, dv_and(dv_same(domains, certificate.domains), dv_and(dv_has(dv_find(policy, "factor_constraints", []), constraint), dv_and((0 < cap), dv_and((cap < 1), dv_and((0 < units), dv_and(dvs_factor_certificate_bound(actor, certificate, events), dvs_factor_paid(dv_with(actor, "model_paid_event", certificate.paid_model_event), events))))))))):
            var schema = dvs_factor_schema(domains, constraint)
