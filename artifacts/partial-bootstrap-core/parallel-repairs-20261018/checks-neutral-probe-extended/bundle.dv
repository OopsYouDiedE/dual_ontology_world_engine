    else:
        return dv_and(dv_same(dv_find(argument, "adoptions", []), actor.mind.adoptions), dv_has_key(dv_find(actor, "heard_topics", []), argument.question_id))

fn v_argument_inputs_current(actor):
    var argument = dv_find(actor, "argument", false)
    var valid = true
    var i = 0
    if (argument == false):
        return false
    else:
        var inputs = argument.inputs
        while (i < rt_count(inputs)):
            var input = inputs[i]
            if dv_same(input.cell, dv_read(actor.mind, input.ref)):
                false
            else:
                var changes = argument.changes
                var j = 0
                var own_transaction = false
                var current = dv_read(actor.mind, input.ref)
                while (j < rt_count(changes)):
                    var change = changes[j]
                    if dv_and(dv_same(change.ref, input.ref), dv_and((dv_find(current, "source", "") == "abduction"), dv_and(dv_has(dv_find(current, "basis", []), argument.id), dv_same(current.value, change.after.value)))):
                        own_transaction = true
                    j = (j + 1)
                if own_transaction:
                    false
                else:
                    valid = false
            i = (i + 1)
        return valid

fn v_public_question(actor):
    if dv_has_key(actor, "question_ref"):
        var cell = dv_read(actor.mind, actor.question_ref)
        if dv_uncontested(cell):
            return cell.value
        else:
