            else:
                allowed = false
            i = (i + 1)
        if (acceptance == false):
            false
        else:
            available = dv_truth(mind, v_paid_speech_map(mind, dv_find(acceptance, "available_when", dv_true()), dv_find(speech, "referents", [])))
            units = (units + (2 * v_paid_speech_ast_nodes(dv_find(acceptance, "available_when", dv_true()))))
            reason = "personal-proposal-policy-withheld"
