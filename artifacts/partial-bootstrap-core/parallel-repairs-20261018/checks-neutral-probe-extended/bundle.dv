fn v_ready_deadline(manifest, trace, oracle):
    var events = v_events(trace)
    var actor = dv_find(oracle, "actor", "")
    var first_id = dv_find(oracle, "first_question_id", "")
    var target_id = dv_find(oracle, "target_question_id", "")
    var t0 = []
    var ready = []
    var i = 0
    var status = "not_observed"
    var reason = "指定首题接受或目标题独立就绪事件尚未发生"
    if dv_or(dv_or((not dv_has_key(dv_find(oracle, "limit", []), "maximum_game_minutes")), (not (dv_find(dv_find(oracle, "limit", []), "origin", "") == "run_start"))), dv_or((actor == ""), dv_or((first_id == ""), (target_id == "")))):
        status = "insufficient_evidence"
        reason = "验收配置须绑定本人、首题与目标题，并声明从正式运行起点计时"
    else:
        while (i < rt_count(events)):
            var e = events[i]
            if (e.actor == actor):
                if dv_and((rt_count(t0) == 0), (e.type == "answer_accepted")):
                    var submit = v_parent_submission(events, e)
                    if dv_and((0 < rt_count(submit)), (v_question(submit) == first_id)):
                        if (v_answer_validation(manifest, trace, e).status == "supported"):
                            t0 = e
                if dv_and((rt_count(ready) == 0), (e.type == "answer_ready")):
                    if (v_question(e) == target_id):
                        ready = e
            i = (i + 1)
        if dv_and((0 < rt_count(t0)), (0 < rt_count(ready))):
            var data = v_ready_context(trace, ready).data
            var axes = v_axis_bundle(manifest, trace, dv_with(v_ready_context(trace, ready), "type", "answer_submitted"), oracle)
            var elapsed = (ready.time - trace.initial.physical.time)
            status = "insufficient_evidence"
            reason = "就绪需要独立来源及当前题目的真值、本人证据与完整因果链；局部模型解释不能替代全题"
            if dv_and(dv_and(dv_has_key(data, "basis_event_ids"), (0 < rt_count(dv_find(data, "basis_event_ids", [])))), dv_and(v_submitted_argument_valid(manifest, trace, v_ready_context(trace, ready)), dv_and(v_axis_supported(axes, "literal_truth"), dv_and(v_axis_supported(axes, "epistemic_support"), v_axis_supported(axes, "causal_completeness"))))):
                var basis = data.basis_event_ids
                var j = 0
                var valid = v_ancestor(events, ready.id, t0.id)
                while (j < rt_count(basis)):
                    valid = dv_and(valid, v_ancestor(events, ready.id, basis[j]))
                    j = (j + 1)
                if dv_and(valid, (dv_find(trace, "game_time_unit", "") == "minute")):
                    var local_1 = false
                    if dv_and((not (elapsed < 0)), (not (dv_find(dv_find(oracle, "limit", []), "maximum_game_minutes", 0) < elapsed))):
                        local_1 = "supported"
                    else:
                        local_1 = "violated"
                    status = local_1
                    reason = "本题完整来源就绪时刻按不可变的正式运行起点及冻结游戏分钟预算核验"
    return dv_with(dv_with(v_finding("ready_deadline", status, reason, dv_pair(dv_find(t0, "id", false), dv_find(ready, "id", false))), "first_acceptance_game_time", dv_find(t0, "time", false)), "ready_game_time", dv_find(ready, "time", false))

fn v_run_stage_times(manifest, trace, oracle):
    var events = v_events(trace)
    var actor = dv_find(oracle, "actor", "")
    var target = dv_find(oracle, "target_question_id", "")
    var start = trace.initial.physical.time
    var maximum = dv_find(dv_find(oracle, "limit", []), "maximum_game_minutes", 0)
    var kinds = dv_list3("answer_submitted", "answer_accepted", "speech_literal")
    var result = []
    var k = 0
    var accepted = []
    while (k < rt_count(kinds)):
        var kind = kinds[k]
        var chosen = []
        var i = 0
        while dv_and((rt_count(chosen) == 0), (i < rt_count(events))):
            var event = events[i]
            if dv_and((event.actor == actor), (event.type == kind)):
                if (kind == "speech_literal"):
                    if (0 < rt_count(accepted)):
                        if v_ancestor(events, event.id, accepted.id):
                            chosen = event
                else:
                    var local_1 = false
                    if (kind == "answer_accepted"):
                        local_1 = v_parent_submission(events, event)
                    else:
                        local_1 = event
                    if (v_question(local_1) == target):
                        chosen = event
            i = (i + 1)
        if (kind == "answer_accepted"):
            accepted = chosen
        var local_2 = false
        if (rt_count(chosen) == 0):
            local_2 = false
        else:
            local_2 = (chosen.time - start)
        var elapsed = local_2
        var local_3 = false
        if dv_or((not dv_has_key(dv_find(oracle, "limit", []), "maximum_game_minutes")), (not (dv_find(dv_find(oracle, "limit", []), "origin", "") == "run_start"))):
            local_3 = "invalid_run"
        else:
            if (rt_count(chosen) == 0):
                local_3 = "not_observed"
            else:
                if dv_and((not (elapsed < 0)), (not (maximum < elapsed))):
                    local_3 = "supported"
                else:
                    local_3 = "violated"
        rt_push(result, dv_with(dv_with(v_finding(rt_cat("run_start_time_", kind), local_3, "从真实运行起点记录本题实际提交、接受或后续分享时刻；这是时限记录，合法性与完整论证由独立轴核验", dv_single(dv_find(chosen, "id", false))), "run_start_game_time", start), "elapsed_game_minutes", elapsed))
        k = (k + 1)
    return result

// ---- Merged source module: 13-model-replay.dv ----
// Judge-side pure temporal/response-model replay; copies never advance the actual trace.
// Subject-local counterfactual temporal models. No authority or other actor lookup.
// An undecidable conditional reaction invalidates its possible outputs, not merely its score.
// Withhold predicted output fields before replay. Repeating old observations is not prediction.
// A fresh observation may refute an old paid prediction without replaying its hypothetical effects.

fn v_model_sim_refs(proposition):
    var op = proposition.op
    if dv_or((op == "equals"), (op == "at_least")):
        return dv_single(proposition.ref)
    else:
        if (op == "not"):
            return v_model_sim_refs(proposition.item)
        else:
            if (op == "all"):
                var items = proposition.items
                var refs = []
                var i = 0
                while (i < rt_count(items)):
                    var nested = v_model_sim_refs(items[i])
                    var j = 0
                    while (j < rt_count(nested)):
                        if dv_has(refs, nested[j]):
                            false
                        else:
                            rt_push(refs, nested[j])
                        j = (j + 1)
                    i = (i + 1)
                return refs
            else:
                return []

fn v_model_sim_plan(hypothesis):
    var timeline = dv_find(hypothesis, "timeline", [])
    var plan = []
    var i = 0
    if dv_has_key(hypothesis, "timeline"):
        while (i < rt_count(timeline)):
            var stage = timeline[i]
            var j = 0
            if dv_has_key(stage, "dispatch"):
                rt_push(plan, {"law": "", "at": stage.at, "optional": true, "stage": i, "dispatch": stage.dispatch})
            else:
                if dv_has_key(stage, "response"):
                    rt_push(plan, dv_with_many({"law": "", "at": stage.at, "optional": dv_find(stage, "optional", false), "stage": i}, {"response": stage.response, "available_when": dv_find(stage, "available_when", dv_true())}))
                else:
                    var local_1 = false
                    if dv_has_key(stage, "laws"):
                        local_1 = stage.laws
                    else:
                        local_1 = dv_single(stage.law)
                    var laws = local_1
                    dv_require((0 < rt_count(laws)), "Empty model event stage")
                    while (j < rt_count(laws)):
                        rt_push(plan, {"law": laws[j], "at": stage.at, "optional": dv_find(stage, "optional", false), "stage": i})
                        j = (j + 1)
            i = (i + 1)
    else:
        var laws = dv_find(hypothesis, "predict_laws", [])
        while (i < rt_count(laws)):
            rt_push(plan, {"law": laws[i], "at": 0, "optional": false, "stage": i})
            i = (i + 1)
    return plan

fn v_model_sim_withhold(world, effects):
    var copy = world
    var refs = []
    var i = 0
    while (i < rt_count(effects)):
        var ref = effects[i].ref
        if dv_has_key(copy.objects, ref.object):
            copy = dv_store(copy, ref, dv_unknown())
            rt_push(refs, ref)
        i = (i + 1)
    return {"world": copy, "refs": refs}

fn v_model_sim_feature(feature):
    if dv_has_key(feature, "proposition"):
        return feature.proposition
    else:
        return feature

fn v_model_sim_mask_plan(plan):
    var result = []
    var i = 0
    while (i < rt_count(plan)):
        let step = plan[i]
        if dv_has_key(step, "dispatch"):
            var j = 0
            while (j < rt_count(step.dispatch.laws)):
                rt_push(result, {"law": step.dispatch.laws[j]})
                j = j + 1
        else:
            rt_push(result, step)
        i = i + 1
    return result

fn v_model_sim_mask(mind, source_plan, start):
    let plan = v_model_sim_mask_plan(source_plan)
    var copy = dv_with_many(mind, {"time": start, "seen": [], "history": []})
    var i = 0
    while (i < rt_count(plan)):
        var name = plan[i].law
        var adoptions = mind.adoptions
        if dv_has_key(adoptions, name):
            var adoption = dv_get(adoptions, name)
            var j = 0
            var effects = dv_get(adoptions, name).law.effects
            if dv_and(adoption.active, (adoption.mode == "predict")):
                while (j < rt_count(effects)):
                    var ref = effects[j].ref
                    if dv_has_key(copy.objects, ref.object):
                        copy = dv_store(copy, ref, dv_unknown())
                    j = (j + 1)
        i = (i + 1)
    return copy

fn v_model_sim_inputs(world, proposition):
    var refs = v_model_sim_refs(proposition)
    var i = 0
    var inputs = []
    while (i < rt_count(refs)):
        rt_push(inputs, {"ref": refs[i], "cell": dv_read(world, refs[i])})
        i = (i + 1)
    return inputs

fn v_model_sim_snapshot(snapshots, final, covered, feature):
    if dv_has_key(feature, "at"):
        var i = 0
        var selected = {"world": final, "coverage": [], "step": -1}
        var found = false
        var at = feature.at
        dv_require((not (at < 0)), "Negative model feature time")
        while (i < rt_count(snapshots)):
            var snapshot = snapshots[i]
            if (at == snapshot.at):
                selected = snapshot
                found = true
            i = (i + 1)
        if found:
            return selected
        else:
            return {"world": final, "coverage": [], "step": -1}
    else:
        return {"world": final, "coverage": covered, "step": (rt_count(snapshots) - 1)}

fn v_model_sim_prediction(feature, snapshot, start):
    var proposition = v_model_sim_feature(feature)
    var refs = v_model_sim_refs(v_model_sim_feature(feature))
    var world = snapshot.world
    var coverage = snapshot.coverage
    var i = 0
    var cells = []
    var valid = true
    var confidence = 1
    if (rt_count(refs) == 0):
        valid = false
    while (i < rt_count(refs)):
        var ref = refs[i]
        var cell = dv_read(world, refs[i])
        rt_push(cells, {"ref": ref, "cell": cell})
        if dv_and(dv_has(coverage, ref), dv_uncontested(cell)):
            confidence = dv_min(confidence, cell.confidence)
        else:
            valid = false
        i = (i + 1)
    var local_1 = false
    if valid:
        local_1 = dv_truth(world, proposition)
    else:
        local_1 = "unknown"
    var local_2 = false
    if valid:
        local_2 = confidence
    else:
        local_2 = 0
    return dv_with(dv_with(dv_with({"feature": feature, "proposition": proposition, "prediction": local_1, "cells": cells}, "covered", valid), "confidence", local_2), "source_step", dv_find(snapshot, "step", -1))

fn v_model_sim_compare(mind, prediction):
    var feature = prediction.feature
    var proposition = prediction.proposition
    var refs = v_model_sim_refs(dv_find(prediction.feature, "observation", prediction.proposition))
    var observation = dv_truth(mind, dv_find(prediction.feature, "observation", prediction.proposition))
    var certainty = prediction.confidence
    var available = true
    var temporal_mismatch = false
    var i = 0
    var observed = []
    while (i < rt_count(refs)):
        var cell = dv_read(mind, refs[i])
        rt_push(observed, {"ref": refs[i], "cell": cell})
        if dv_uncontested(cell):
            certainty = dv_min(certainty, cell.confidence)
        else:
            available = false
        i = (i + 1)
    if dv_has_key(feature, "occurrence_ref"):
        var occurrence = dv_read(mind, feature.occurrence_ref)
        rt_push(observed, {"ref": feature.occurrence_ref, "cell": occurrence})
        if dv_uncontested(occurrence):
            certainty = dv_min(certainty, occurrence.confidence)
            if dv_same(occurrence.value, feature.occurrence_time):
                false
            else:
                temporal_mismatch = true
        else:
            available = false
    var resolved = dv_and(available, dv_and(prediction.covered, dv_and((0 < certainty), dv_and((not (observation == "unknown")), (not (prediction.prediction == "unknown"))))))
    var local_1 = false
    if available:
        local_1 = observation
    else:
        local_1 = "unknown"
    var local_2 = false
    if resolved:
        local_2 = certainty
    else:
        local_2 = 0
    var local_3 = false
    if resolved:
        if dv_and((not temporal_mismatch), (observation == prediction.prediction)):
            local_3 = "match"
        else:
            local_3 = "contradiction"
    else:
        local_3 = "unknown"
    return dv_with(dv_with(dv_with({"feature": feature, "prediction": prediction.prediction, "observation": local_1, "covered": prediction.covered}, "confidence", local_2), "observed_cells", observed), "result", local_3)

fn v_model_sim_comparisons(mind, predictions, budget):
    var remaining = budget
    var expanded = 0
    var i = 0
    var fit = 0
    var comparisons = []
    var contradictions = []
    var complete = true
    var probes = []
    dv_require((not (budget < 0)), "Negative simulation comparison budget")
    while dv_and((i < rt_count(predictions)), (not (remaining < 1))):
        var prediction = predictions[i]
        var comparison = v_model_sim_compare(mind, predictions[i])
        var j = 0
        var refs = v_model_sim_refs(predictions[i].proposition)
        remaining = (remaining - 1)
        expanded = (expanded + 1)
        rt_push(comparisons, comparison)
        if (comparison.result == "match"):
            fit = (fit + comparison.confidence)
        else:
            if (comparison.result == "contradiction"):
                rt_push(contradictions, comparison)
            else:
                complete = false
                while (j < rt_count(refs)):
                    if dv_has(probes, refs[j]):
                        false
                    else:
                        rt_push(probes, refs[j])
                    j = (j + 1)
        i = (i + 1)
    if dv_or((rt_count(predictions) == 0), (i < rt_count(predictions))):
        complete = false
    var local_1 = false
    if (0 < rt_count(contradictions)):
        local_1 = -1000000
    else:
        local_1 = fit
    var local_2 = false
    if (0 < rt_count(contradictions)):
        local_2 = "inconsistent"
    else:
        if complete:
            local_2 = "explained"
        else:
            local_2 = "unknown"
    return dv_with(dv_with(dv_with({"fit": local_1, "comparisons": comparisons, "contradictions": contradictions, "remaining": remaining}, "expanded", expanded), "probe_refs", probes), "status", local_2)

fn v_model_sim_work_budget(actor):
    var policy = actor.policy
    var total = dv_find(actor.policy, "model_budget", 0)
    var work = dv_find(actor.policy, "model_work_remaining", dv_find(actor.policy, "model_work_limit", dv_find(actor.policy, "model_budget", 0)))
    dv_require((not (work < 0)), "Negative method work limit")
    dv_require((not (total < 0)), "Negative total model budget")
    return dv_min(total, work)

fn v_model_model(actor, hypothesis, events, time, parent):
    var mind = actor.mind
    var plan = v_model_sim_plan(hypothesis)
    var start = dv_find(hypothesis, "start_time", time)
    var predicted = false
    var assumptions = dv_find(hypothesis, "assumptions", [])
    var features = dv_find(hypothesis, "features", [])
    var remaining = v_model_sim_work_budget(actor)
    var total_budget = dv_find(actor.policy, "model_budget", 0)
    var expanded = 0
    var failures = []
    var covered = []
    var trace = []
    var snapshots = []
    var predictions = []
    var assumption_records = []
    var confidence = dv_unit(dv_find(hypothesis, "prior", 0.5))
    var i = 0
    var complete = true
    // Replay depth bounds ordered causal stages, independently of action-plan depth.
    let replay_limit = dv_find(actor.policy, "Replay_Depth", rt_count(plan))
    dv_require(0 <= replay_limit and rt_floor(replay_limit) == replay_limit, "Replay depth must be a nonnegative integer")
    var replay_stages = 0
    var replay_stage = -1
    var replay_limited = false
    var last_at = 0
    dv_domain(mind, "mind")
    dv_require((not (remaining < 0)), "Negative simulation budget")
    dv_require((not (start < 0)), "Negative model origin time")
    let mask_plan = dv_find(hypothesis, "mask_plan", plan)
    predicted = v_model_sim_mask_response(actor, v_model_sim_mask(mind, mask_plan, start), mask_plan)
    if (0 < rt_count(assumptions)):
        dv_require((confidence < 1), "Hypothetical assumption cannot have certainty")
    while dv_and((i < rt_count(assumptions)), (not (remaining < 1))):
        var assumption = assumptions[i]
        remaining = (remaining - 1)
        expanded = (expanded + 1)
        if (assumption.op == "equals"):
            var ref = assumption.ref
            if dv_has_key(predicted.objects, ref.object):
                predicted = dv_store(predicted, ref, dv_cell(assumption.value, confidence, start, hypothesis.basis))
                rt_push(assumption_records, {"proposition": assumption, "confidence": confidence, "role": "hypothetical-only"})
            else:
                complete = false
                rt_push(failures, {"assumption": assumption, "reason": "unknown-subject-local-object"})
        else:
            complete = false
            rt_push(failures, {"assumption": assumption, "reason": "unsupported-assumption"})
        i = (i + 1)
    if (i < rt_count(assumptions)):
        complete = false
    i = 0
    while i < rt_count(plan) and 0 < remaining and (plan[i].stage == replay_stage or replay_stages < replay_limit):
        var step = plan[i]
        if step.stage != replay_stage:
            replay_stage = step.stage
            replay_stages = replay_stages + 1
        var name = plan[i].law
        var at = plan[i].at
        var adoptions = mind.adoptions
        dv_require((not (at < last_at)), "Model time cannot move backwards")
        remaining = (remaining - 1)
        expanded = (expanded + 1)
        last_at = at
        if dv_has_key(step, "response"):
            var response = v_model_sim_gated_response(actor, dv_with(predicted, "domain", "mind"), step, (start + at), remaining, confidence)
            var detail = response.detail
            predicted = response.world
            remaining = response.remaining
            expanded = (expanded + detail.expanded)
            detail = dv_with(detail, "choice_record_changes", response.changes)
            if (detail.status == "selected"):
                var bridge = v_model_sim_response_bridge(actor, predicted, detail, (start + at), remaining, confidence)
                predicted = bridge.world
                remaining = bridge.remaining
                expanded = (expanded + bridge.expanded)
                detail = dv_with(detail, "bridge", bridge)
                if (bridge.status == "applied"):
                    var changes = bridge.changes
                    var j = 0
                    while (j < rt_count(changes)):
                        if dv_has(covered, changes[j].ref):
                            false
                        else:
                            rt_push(covered, changes[j].ref)
                        j = (j + 1)
                else:
                    complete = false
                    rt_push(failures, {"response": step.response, "reason": bridge.status})
            else:
                if dv_and((detail.status == "not-applicable"), step.optional):
                    false
                else:
                    complete = false
                    rt_push(failures, {"response": step.response, "reason": detail.reason})
            rt_push(trace, {"step": i, "at": at, "stage": step.stage, "response": detail})
        else:
            var selected_steps = [step]
            if dv_has_key(step, "dispatch"):
                let dispatch = v_model_sim_dispatch(mind, predicted, step)
                selected_steps = dispatch.steps
                rt_push(trace, {"step": i, "at": at, "stage": step.stage, "status": "indexed-dispatch", "indexed": dispatch.indexed, "inputs": dispatch.inputs, "excluded": dispatch.excluded, "changes": []})
            var selected_index = 0
            while (selected_index < rt_count(selected_steps) and (not dv_has_key(step, "dispatch") or 0 < remaining)):
                if dv_has_key(step, "dispatch"):
                    remaining = remaining - 1
                    expanded = expanded + 1
                let execution = v_model_sim_rule(predicted, covered, selected_steps[selected_index], mind, confidence, start, i, events, selected_index)
                predicted = execution.world
                covered = execution.coverage
                complete = complete and execution.complete
                var entry_index = 0
                while (entry_index < rt_count(execution.trace)):
                    rt_push(trace, execution.trace[entry_index])
                    entry_index = entry_index + 1
                entry_index = 0
                while (entry_index < rt_count(execution.failures)):
                    rt_push(failures, execution.failures[entry_index])
                    entry_index = entry_index + 1
                selected_index = selected_index + 1
            if (selected_index < rt_count(selected_steps)):
                complete = false
        rt_push(snapshots, {"world": predicted, "coverage": dv_clone(covered), "step": i, "at": at})
        i = (i + 1)
    if i < rt_count(plan):
        replay_limited = plan[i].stage != replay_stage and replay_limit <= replay_stages
    if dv_or((rt_count(plan) == 0), (i < rt_count(plan))):
        complete = false
    i = 0
    while (i < rt_count(features)):
        rt_push(predictions, v_model_sim_prediction(features[i], v_model_sim_snapshot(snapshots, predicted, covered, features[i]), start))
        i = (i + 1)
    var comparison = v_model_sim_comparisons(mind, predictions, remaining)
    var result = dv_with_many(comparison, {"expanded": (expanded + comparison.expanded), "failures": failures, "coverage": covered, "assumptions": assumption_records, "predictions": predictions, "trace": trace})
    result = dv_with(result, "predicted", predicted)
    if dv_and((not complete), (result.status == "explained")):
        result = dv_with(result, "status", "unknown")
    result = dv_with_many(result, {"plan_complete": complete, "source_revision": mind.revision, "original_revision": mind.revision, "role": "internal-enumeration", "start_time": start})
    var local_2 = false
    if (result.remaining < 1):
        local_2 = "budget-exhausted"
    else:
        local_2 = "declared-plan-complete"
    result = dv_with_many(result, {"calculation_unit": "one-assumption-predict-rule-indexed-dispatch-context-binding-option-prediction-option-evaluation-response-dispatch-or-feature-comparison", "stop_reason": local_2})
    if replay_limited:
        result = dv_with(result, "stop_reason", "replay-depth-exhausted")
    result = dv_with_many(result, {"replay_depth_limit": replay_limit, "replay_stages_expanded": replay_stages, "replay_depth_exhausted": replay_limited})
    result = dv_with_many(result, {"work_remaining": result.remaining, "remaining": (total_budget - result.expanded)})
    result = dv_with_many(result, {"original_expanded": result.expanded, "total_expanded": result.expanded})
    return result

fn v_model_model_recheck(actor, model):
    var mind = actor.mind
    var comparison = v_model_sim_comparisons(actor.mind, model.predictions, v_model_sim_work_budget(actor))
    var result = dv_clone(model)
    var keys = dv_list3("fit", "comparisons", "contradictions")
    var i = 0
    rt_push(keys, "remaining")
    rt_push(keys, "expanded")
    rt_push(keys, "probe_refs")
    rt_push(keys, "status")
    while (i < rt_count(keys)):
        result = dv_with(result, keys[i], dv_get(comparison, keys[i]))
        i = (i + 1)
    if dv_and((not model.plan_complete), (result.status == "explained")):
        result = dv_with(result, "status", "unknown")
    result = dv_with_many(result, {"work_remaining": comparison.remaining, "remaining": (dv_find(actor.policy, "model_budget", 0) - comparison.expanded)})
    var local_1 = false
    if (comparison.remaining < 1):
        local_1 = "budget-exhausted"
    else:
        local_1 = "observations-compared"
    result = dv_with_many(result, {"total_expanded": (dv_find(model, "total_expanded", model.expanded) + comparison.expanded), "stop_reason": local_1})
    if dv_find(model, "replay_depth_exhausted", false):
        result = dv_with(result, "stop_reason", "replay-depth-exhausted")
    return dv_with_many(result, {"source_revision": mind.revision, "paid_model_event": dv_find(model, "paid_model_event", dv_find(model, "event", "")), "role": "new-observation-recheck"})

fn v_model_sim_response_unknown(world, remaining, reason):
    return {"world": world, "changes": [], "remaining": remaining, "detail": {"status": "unknown", "reason": reason, "expanded": 0, "committed": false}}

fn v_model_sim_response(actor, world, stage, time, remaining, confidence):
    var models = dv_find(actor, "response_models", [])
    var model_id = stage.model
    if (not dv_has_key(models, model_id)):
        return v_model_sim_response_unknown(world, remaining, "no-subject-local-response-model")
    else:
        var model = dv_with(dv_get(models, model_id), "confidence", dv_min(confidence, dv_find(dv_get(models, model_id), "confidence", 0)))
        if (not dv_and((dv_find(model, "owner", "") == actor.id), dv_and((0 < rt_count(dv_find(model, "basis", []))), (0 < dv_unit(dv_find(model, "confidence", 0)))))):
            return v_model_sim_response_unknown(world, remaining, "unavailable-response-model-basis")
        else:
            var local = dv_clone(model.world)
            var bindings = dv_find(model, "context", [])
            var option_ids = stage.options
            var catalog = model.options
            var policy_id = model.policy_id
            var request_id = stage.request
            var requests = model.requests
            var required = (rt_count(bindings) + (2 * rt_count(option_ids)))
            dv_domain(local, "mind")
            if (remaining < required):
                return v_model_sim_response_unknown(world, remaining, "method-work-limit-before-response")
            else:
                if (not dv_has_key(requests, request_id)):
                    return v_model_sim_response_unknown(world, remaining, "unknown-modeled-request")
                else:
                    if (not dv_has_key(dv_find(local, "policies", []), policy_id)):
                        return v_model_sim_response_unknown(world, remaining, "unknown-modeled-value-policy")
                    else:
                        var accepted = dv_get(local.policies, policy_id)
                        if (not dv_and(accepted.active, (0 < rt_count(accepted.basis)))):
                            return v_model_sim_response_unknown(world, remaining, "unadopted-modeled-value-policy")
                        else:
                            var request = dv_get(requests, request_id)
                            var options = []
                            var inputs = []
                            var option_traces = []
                            var i = 0
                            var complete = true
                            var expanded = 0
                            var chosen = false
                            var prediction = false
                            var response = false
                            var next = world
                            var changes = []
                            var reason = "unknown-response-basis"
                            var response_confidence = model.confidence
                            local = dv_with(dv_with(local, "time", time), "seen", [])
                            while (i < rt_count(bindings)):
                                var binding = bindings[i]
                                var cell = dv_read(world, bindings[i].from)
                                expanded = (expanded + 1)
                                remaining = (remaining - 1)
                                rt_push(inputs, {"from": binding.from, "to": binding.to, "cell": cell})
                                if dv_and(dv_uncontested(cell), (0 < cell.confidence)):
                                    response_confidence = dv_min(response_confidence, cell.confidence)
                                else:
                                    complete = false
                                    reason = "unknown-required-response-context"
                                if dv_has_key(local.objects, binding.to.object):
                                    var local_1 = false
                                    if dv_uncontested(cell):
                                        local_1 = dv_with(cell, "confidence", dv_min(cell.confidence, model.confidence))
                                    else:
                                        local_1 = dv_unknown()
                                    local = dv_store(local, binding.to, local_1)
                                else:
                                    complete = false
                                i = (i + 1)
                            i = 0
                            while (i < rt_count(option_ids)):
                                var option_id = option_ids[i]
                                expanded = (expanded + 2)
                                remaining = (remaining - 2)
                                if dv_has_key(catalog, option_id):
                                    var descriptor = dv_get(catalog, option_id)
                                    var name = dv_find(dv_get(catalog, option_id), "predict_law", "")
                                    var result = false
                                    var legal = dv_truth(local, dv_get(catalog, option_id).feasible)
                                    prediction = dv_no_change_prediction(local)
                                    if (legal == "unknown"):
                                        complete = false
                                    if (name == ""):
                                        false
                                    else:
                                        if dv_has_key(local.adoptions, name):
                                            var adoption = dv_get(local.adoptions, name)
                                            if dv_and(adoption.active, (adoption.mode == "predict")):
                                                result = dv_predict(local, name, rt_cat("response-option-", rt_show(i)), time, local.revision)
                                                if (result.status == "applied"):
                                                    prediction = result.world
                                                else:
                                                    if (legal == "false"):
                                                        false
                                                    else:
                                                        complete = false
                                            else:
                                                if (legal == "false"):
                                                    false
                                                else:
                                                    complete = false
                                        else:
                                            if (legal == "false"):
                                                false
                                            else:
                                                complete = false
                                    rt_push(options, dv_response_option(option_id, descriptor.intent, descriptor.feasible, prediction, descriptor.effort, descriptor.feature_weights))
                                    rt_push(option_traces, {"id": option_id, "legal": legal, "prediction_receipt": result, "model_prediction": prediction})
                                else:
                                    complete = false
                                    rt_push(option_traces, {"id": option_id, "legal": "unknown-option"})
                                i = (i + 1)
                            response = dv_respond_adopted(local, request, options, policy_id)
                            var evaluated = response.evaluated
                            var j = 0
                            var ties = 0
                            var best = 0
                            var found_best = false
                            while (j < rt_count(evaluated)):
                                var evaluation = evaluated[j][1]
                                var score = evaluated[j][1].score
                                if dv_and(evaluation.value.complete, (rt_count(evaluation.relationship_and_state.unknown) == 0)):
                                    false
                                else:
                                    complete = false
                                var local_2 = false
                                if found_best:
                                    local_2 = (best < score)
                                else:
                                    local_2 = true
                                if local_2:
                                    best = score
                                    ties = 1
                                    found_best = true
                                else:
                                    if (best == score):
                                        ties = (ties + 1)
                                j = (j + 1)
                            if (1 < ties):
                                if complete:
                                    reason = "modeled-response-tie"
                                complete = false
                            if dv_and(complete, (response.status == "selected")):
                                var id = response.choice.id
                                var choice_ref = model.choice_ref
                                chosen = id
                                reason = "selected-by-shared-response"
                                if dv_has_key(next.objects, choice_ref.object):
                                    var before = dv_read(next, choice_ref)
                                    var after = dv_cell(id, response_confidence, time, model.basis)
                                    next = dv_store(next, choice_ref, after)
                                    rt_push(changes, {"ref": choice_ref, "before": before, "after": after})
                                else:
                                    complete = false
                                    reason = "unknown-local-choice-record"
                            var local_3 = false
                            if complete:
                                local_3 = response.status
                            else:
                                local_3 = "unknown"
                            var local_4 = false
                            if (chosen == false):
                                local_4 = ""
                            else:
                                local_4 = dv_find(dv_get(catalog, chosen), "bridge_law", "")
                            return {"world": next, "changes": changes, "remaining": remaining, "detail": dv_with(dv_with(dv_with(dv_with(dv_with(dv_with(dv_with({"status": local_3, "reason": reason, "expanded": expanded, "committed": false}, "model", model_id), "model_basis", model.basis), "context_inputs", inputs), "option_predictions", option_traces), "response", response), "selected", chosen), "bridge_law", local_4)}

fn v_model_sim_mask_response_option(world, model, option_id):
    var option = dv_find(model.options, option_id, [])
    if dv_has_key(option, "bridge_law"):
        var name = option.bridge_law
        if dv_has_key(world.adoptions, name):
            return v_model_sim_withhold(world, dv_get(world.adoptions, name).law.effects).world
        else:
            return world
    else:
        return world

fn v_model_sim_mask_response_stage(actor, world, stage):
    var models = dv_find(actor, "response_models", [])
    var id = stage.model
    if dv_has_key(models, id):
        var model = dv_get(models, id)
        var options = stage.options
        var i = 0
        var copy = world
        if dv_has_key(model, "choice_ref"):
            if dv_has_key(copy.objects, model.choice_ref.object):
                copy = dv_store(copy, model.choice_ref, dv_unknown())
        while (i < rt_count(options)):
            copy = v_model_sim_mask_response_option(copy, model, options[i])
            i = (i + 1)
        return copy
    else:
        return world

fn v_model_sim_mask_response(actor, world, plan):
    var copy = world
    var i = 0
    while (i < rt_count(plan)):
        var step = plan[i]
        if dv_has_key(step, "response"):
            copy = v_model_sim_mask_response_stage(actor, copy, step.response)
        i = (i + 1)
    return copy

fn v_model_sim_response_bridge(actor, world, detail, time, remaining, confidence):
    var name = detail.bridge_law
    var adoptions = actor.mind.adoptions
    if dv_or((name == ""), (not dv_has_key(adoptions, name))):
        return dv_with({"world": world, "changes": [], "remaining": remaining, "status": "unknown-response-bridge"}, "expanded", 0)
    else:
        var adoption = dv_get(adoptions, name)
        var effects = dv_get(adoptions, name).law.effects
