            found = true
        i = (i + 1)
    if dv_and(found, dv_and((receipt.status == "applied"), dv_and(dvs_factor_law_allowed(allowed, law), dv_and(dv_has_key(current, name), dv_has_key(before.adoptions, name))))):
        var adoption = dv_get(current, name)
        if dv_and(dv_same(adoption, dv_get(before.adoptions, name)), dv_and(adoption.active, dv_and((adoption.mode == "infer"), dv_and(dv_same(law, adoption.law), (dv_truth(before, law.premise) == "true"))))):
            if (remaining < 1):
                false
            else:
                var replayed = dv_infer(before, name, receipt.event, receipt.time, before.revision)
                result = dvs_factor_proof_result(false, (remaining - 1), 0, [], [])
                if dv_and(dv_same(replayed, receipt), dv_same(data.mind_after, receipt.world)):
                    var sources = dvs_factor_refs_proof(actor, before, dvs_sim_refs(law.premise), events, index, result.remaining, allowed)
                    result = sources
                    if dv_and(sources.valid, (0 < rt_count(sources.source_events))):
                        result = dv_with_many(sources, {"source_events": dv_append(sources.source_events, event.id), "confidence": dv_min(cell.confidence, dv_min(adoption.confidence, sources.confidence)), "steps": dv_append(sources.steps, dv_with({"kind": "infer", "event": event.id, "ref": ref, "cell": cell}, "adoption", adoption))})
                    else:
                        result = dv_with(sources, "valid", false)
    return result

fn dvs_factor_domain(domains, id):
