    else:
        local_1 = false
    updated = dv_with_many(actor, {"mind": world, "argument": local_1, "ready_hypothesis": false, "inference_derivations": derivations, "cognition_blocked": blocked, "policy": dv_with(actor.policy, "reason_budget", remaining)})
    updated = dv_with(updated, "last_cognitive_event", rt_cat("e", rt_show(rt_count(events))))
