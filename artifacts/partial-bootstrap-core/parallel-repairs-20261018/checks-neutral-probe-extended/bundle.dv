fn v_judge(manifest, raw_trace, oracle):
    if dv_record_like(raw_trace):
        var initial = dv_find(raw_trace, "initial", [])
        var integrity = v_integrity(manifest, raw_trace)
        if (not (integrity.status == "supported")):
            return {"mode": "read_only", "findings": dv_single(integrity), "limitations": "损坏的来源或事件基线不进入领域重演"}
        else:
            var local_1 = false
            if dv_record_like(initial):
                local_1 = dv_and(dv_has_key(initial, "physical"), dv_has_key(initial, "actors"))
            else:
                local_1 = false
            if local_1:
                return v_judge_full(manifest, raw_trace, oracle)
            else:
                return {"mode": "read_only", "findings": dv_single(v_finding("run_intake", "insufficient_evidence", "缺少完整冻结初始物理与人物快照，不能重演来源或给出全局成立结论", [])), "limitations": "未进入领域重演"}
    else:
        return {"mode": "read_only", "findings": dv_single(v_finding("run_intake", "invalid_run", "轨迹交换数据不是合法只读记录", [])), "limitations": "未进入领域重演"}

