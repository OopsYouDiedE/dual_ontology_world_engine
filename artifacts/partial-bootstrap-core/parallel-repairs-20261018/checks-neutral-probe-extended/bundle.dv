        local_2 = []
    else:
        local_2 = dv_find(acceptance, "basis", [])
    return dv_with(dv_with({"status": status, "reason": reason, "confidence_cap": confidence, "proposal": proposal}, "policy_basis", local_2), "calculation_units", units)

fn v_paid_speech_received_observations(mind, parsed, source, speaker, time, decision):
