fn c1_investigation_actions(actor):
    var actions = c1_move_actions(actor)
    var inspect = [c1_inspect_E1(actor), c1_inspect_E2(actor), c1_inspect_E3(actor), c1_inspect_E4(actor), c1_inspect_E5(actor), c1_inspect_E6(actor), c1_inspect_E7(actor), c1_inspect_E8(actor), c1_inspect_E9(actor), c1_inspect_E10(actor), c1_inspect_E11(actor), c1_inspect_E12(actor)]
    var dialogue = [c1_talk_slate_code(actor), c1_talk_slate_person(actor), c1_talk_frame_hollow(actor), c1_talk_cups_known(actor), c1_talk_starter_kept(actor), c1_talk_recalled_copper(actor), c1_talk_recalled_names(actor)]
    var i = 0
    while (i < rt_count(inspect)):
        rt_push(actions, inspect[i])
        i = (i + 1)
    i = 0
    while (i < rt_count(dialogue)):
        rt_push(actions, dialogue[i])
        i = (i + 1)
    if (actor == "detective"):
        i = 0
        while (i < rt_count(c1_answer_actions(actor))):
            rt_push(actions, c1_answer_actions(actor)[i])
            i = (i + 1)
    if (actor == "detective"):
        false
    else:
        var replies = c1_professional_replies(actor)
        i = 0
        while (i < rt_count(replies)):
            rt_push(actions, replies[i])
            i = (i + 1)
    rt_push(actions, c1_sound_action(actor))
    rt_push(actions, c1_loss_testimony(actor))
    if (actor == "detective"):
        rt_push(actions, c1_replay_action(actor))
    if (actor == "detective"):
        rt_push(actions, c1_sole_test(actor))
        rt_push(actions, c1_latch_contact_action())
    rt_push(actions, c1_identify_own_lens(actor))
    rt_push(actions, c1_reask_question(actor))
    rt_push(actions, c1_compare_wedge_action(actor))
    rt_push(actions, c1_compare_palms_action(actor))
    if actor == "detective":
        let rooms = ["hall", "pantry", "foyer", "corridor", "R05", "R06", "R07", "R08"]
        var invitation_room = 0
        while invitation_room < rt_count(rooms):
            rt_push(actions, c1_palm_invitation_action(rooms[invitation_room]))
            invitation_room = invitation_room + 1
    if actor != "detective":
        rt_push(actions, c1_deep_resonance_action(actor))
        let keys = ["voice-source", "original-words", "familiarity"]
        var key_index = 0
        while key_index < rt_count(keys):
            rt_push(actions, c1_answer_conflict_response(actor, keys[key_index]))
            key_index = key_index + 1
    return c1_public_methods(actions)

