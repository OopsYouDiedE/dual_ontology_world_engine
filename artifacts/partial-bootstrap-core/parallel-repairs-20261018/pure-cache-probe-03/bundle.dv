    else:
        local_1 = false
    updated = dv_with_many(actor, {"mind": world, "argument": local_1, "ready_hypothesis": false, "inference_derivations": derivations, "cognition_blocked": blocked, "policy": dv_with(actor.policy, "reason_budget", remaining)})
    updated = dv_with(updated, "last_cognitive_event", rt_cat("e", rt_show(rt_count(events))))
    var local_2 = false
    if blocked:
        local_2 = "model_argument_revocation_pending"
    else:
        local_2 = "model_argument_revoked"
    dvs_event_prepared(events, local_2, actor.id, time, dvs_cognitive_parents(actor, dv_explanation_merge(dv_pair(parent, argument.id), descendants)), dv_with_many({"argument": argument, "mind_revision_before": actor.mind.revision, "mind_revision_after": world.revision, "restored": restored}, {"checked": checked, "remaining": remaining, "actor_id": actor.id, "actor_before": actor, "actor_after": updated, "mind_before": actor.mind, "mind_after": world}))
    return updated

fn dvs_factor_coverage(actor, hypothesis, events):
