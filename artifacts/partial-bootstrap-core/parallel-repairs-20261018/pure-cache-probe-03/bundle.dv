fn c1_hist_variable_specs():
    return [["V1", "R08", "su_room", true, 1], ["V1", "hall", "su_hall", true, 1], ["V1", "pantry", "su_pantry", true, 1], ["V2", "hall", "huo_copper", true, 11], ["V2", "R06", "huo_room", true, 11], ["V2", "foyer", "huo_foyer", true, 11], ["V3", "Tube", "remote_voice", true, 21], ["V3", "OutsideDoor", "remote_voice", false, 21], ["V4", "BoltKeepShut", "words_bolt", true, 30], ["V4", "OpenSaveMe", "words_bolt", false, 30], ["V5", "huo", "heed_huo", true, 39], ["V5", "su", "heed_su", true, 39], ["V5", "self", "heed_neither", true, 39], ["V6", false, "familiar", false, 49], ["V6", true, "familiar", true, 50]]

fn c1_hist_domain(id, values):
    return {"id": id, "version": 1, "ref": dv_ref("history", "actual", id), "values": values}

fn c1_hist_domains():
    return [c1_hist_domain("V1", dv_list3("R08", "hall", "pantry")), c1_hist_domain("V2", dv_list3("hall", "R06", "foyer")), c1_hist_domain("V3", dv_pair("Tube", "OutsideDoor")), c1_hist_domain("V4", dv_pair("BoltKeepShut", "OpenSaveMe")), c1_hist_domain("V5", dv_list3("huo", "su", "self")), c1_hist_domain("V6", dv_pair(false, true))]

fn c1_hist_coordinate_name(index):
    return rt_cat("history.coordinate.", rt_show(index))

fn c1_hist_constraints():
    var specs = c1_hist_variable_specs()
    var result = []
    var index = 0
    while (index < rt_count(specs)):
        var spec = specs[index]
        var variable = specs[index][0]
        var value = specs[index][1]
        rt_push(result, dv_with(dv_with(dv_with(dv_with({"id": rt_cat("history.exclude.", rt_show(index)), "domain_versions": dv_single(dv_pair(variable, 1)), "scope": dv_single(variable), "assignments": dv_single({"variable": variable, "value": value})}, "condition", dv_fact(dv_ref("history", "actual", variable), value)), "support", dv_not(dv_fact(dv_ref("history", "actual", variable), value))), "infer_laws", c1_hist_coordinate_versions(variable)), "basis", dv_single(c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/推演变量与陈述.story", spec[4], variable))))
        index = (index + 1)
    return result

fn c1_hist_coordinate_versions(variable):
    var specs = c1_hist_variable_specs()
    var result = []
    var index = 0
    while (index < rt_count(specs)):
        if (specs[index][0] == variable):
            rt_push(result, {"id": c1_hist_coordinate_name(index), "version": 1})
        index = (index + 1)
    // Coordinate claims may depend on the person's ordinary learned inferences.
    // Declaring these laws grants no fact: the certificate still replays each
    // actual inference and traces its premises back to the person's receipts.
    let inferences = c1_infer_rules()
    index = 0
    while (index < rt_count(inferences)):
        rt_push(result, {"id": inferences[index].name, "version": inferences[index].version})
        index = index + 1
    return result

fn c1_hist_add_coordinates(mind):
    var specs = c1_hist_variable_specs()
    var result = mind
    var index = 0
    while (index < rt_count(specs)):
        var spec = specs[index]
        result = dv_adopt(result, c1_method(c1_hist_coordinate_name(index), c1_hist_coordinate("cognition", "history", spec[2], spec[3], spec[0], spec[1])), "infer", 0.85, dv_single(c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/推演变量与陈述.story", spec[4], spec[0])))
        index = (index + 1)
    return result

fn c1_hist_assignments(su_room, huo_room, source, words, preference, familiar):
    return [{"variable": "V1", "value": su_room}, {"variable": "V2", "value": huo_room}, {"variable": "V3", "value": source}, {"variable": "V4", "value": words}, {"variable": "V5", "value": preference}, {"variable": "V6", "value": familiar}]

fn c1_hist_assumptions(su_room, huo_room, source, words, preference, familiar):
    return [dv_fact(dv_ref("history", "inputs", "su_origin"), su_room), dv_fact(dv_ref("history", "inputs", "huo_origin"), huo_room), dv_fact(dv_ref("history", "inputs", "source"), source), dv_fact(dv_ref("history", "inputs", "words"), words), dv_fact(dv_ref("history", "inputs", "trust_choice"), preference), dv_fact(dv_ref("history", "inputs", "familiar"), familiar)]

fn c1_hist_claim_slots():
    return dv_list3(dv_with({"slot_id": "actual_heard", "ref": c1_hist_claim_ref("actual_heard"), "trace_at": 160, "feature_index": 0}, "value_from_prediction", true), dv_with({"slot_id": "voice_source", "ref": c1_hist_claim_ref("voice_source"), "trace_at": 160, "feature_index": 4}, "value_from_prediction", true), dv_with({"slot_id": "transmission_loss", "ref": c1_hist_claim_ref("transmission_loss"), "trace_at": 160, "feature_index": 6}, "value_from_prediction", true))

fn c1_hist_feature(predicted, observed):
    return {"proposition": dv_fact(c1_knowledge(predicted), true), "observation": dv_fact(c1_knowledge(observed), true), "at": 160}

fn c1_hist_features():
    return [c1_hist_feature("predicted_bolt", "bolt_down"), c1_hist_feature("predicted_wedge_soot", "ash_wedge"), c1_hist_feature("predicted_boots_bolt", "boots_toward_bolt"), c1_hist_feature("predicted_cloth_over_heel", "cloth_after_boots"), c1_hist_feature("predicted_slate_first", "slate_marks"), c1_hist_feature("predicted_slate_second", "slate_person"), c1_hist_feature("predicted_score_tail", "score_partial")]

fn c1_hist_response_world(preference):
    var mind = dv_world(rt_cat("history-response-", preference), "mind", "modeled.detective")
    var basis = dv_pair(c1_source("docs/design-standard.md", 713, "V5-trust-plus-one-not-action"), c1_source("docs/design-standard.md", 723, "competing-reports-and-SocialSystem"))
    mind = c1_add_objects(mind, [c1_local_object("modeled.detective"), c1_local_object("modeled.huo"), c1_local_object("modeled.su"), c1_local_object("joint.request"), c1_local_object("response.outcome")])
    mind = dv_store(mind, dv_ref("response.outcome", "state", "value"), dv_with(dv_field(0), "basis", basis))
    var local_1 = false
    if (preference == "huo"):
        local_1 = 4
    else:
        local_1 = 3
    var local_2 = false
    if (preference == "huo"):
        local_2 = 4
    else:
        local_2 = 3
    mind = dv_adopt(mind, c1_method("huo.value", c1_hist_social_preview("modeled.huo", local_1, local_2)), "predict", 0.85, basis)
    var local_3 = false
    if (preference == "su"):
        local_3 = 4
    else:
        local_3 = 3
    var local_4 = false
    if (preference == "su"):
        local_4 = 4
    else:
        local_4 = 3
    mind = dv_adopt(mind, c1_method("su.value", c1_hist_social_preview("modeled.su", local_3, local_4)), "predict", 0.85, basis)
    var local_5 = false
    if (preference == "self"):
        local_5 = 3
    else:
        local_5 = 2
    mind = dv_adopt(mind, c1_method("inspect.value", c1_hist_inspection_preview(local_5)), "predict", 0.85, dv_pair(c1_source("docs/design-standard.md", 713, "own-inspection-strengthens-evidence-preference"), c1_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/01_侦探.story", 29, "existing-caution-two")))
