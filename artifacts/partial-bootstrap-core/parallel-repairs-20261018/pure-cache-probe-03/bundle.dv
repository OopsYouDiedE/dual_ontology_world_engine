    rt_push(goals, c1_public_goal("words", "score_partial", "know"))
    rt_push(goals, c1_public_question_receipt_goal("voice_source", 16, "answer_q2.001"))
    rt_push(goals, c1_public_question_receipt_goal("words", 30, "answer_q3.001"))
    rt_push(goals, c1_public_question_receipt_goal("trust", 39, "answer_q4.001"))
