        if dv_or((rt_count(values) == 0), (not (0 < domain.version))):
            valid = false
        while (j < rt_count(values)):
            if dv_has(seen, values[j]):
                valid = false
            rt_push(seen, values[j])
            j = (j + 1)
        product = (product * rt_count(values))
        i = (i + 1)
    if (product == rt_count(hypotheses)):
        false
    else:
        valid = false
    i = 0
    while (i < rt_count(hypotheses)):
        var assignments = dv_find(hypotheses[i], "variable_assignments", [])
        var key = dvs_factor_assignment_key(domains, dv_find(hypotheses[i], "variable_assignments", []))
        if dvs_factor_assignment_complete(domains, assignments):
            false
        else:
            valid = false
        if dv_has(keys, key):
            valid = false
        rt_push(keys, key)
        i = (i + 1)
    return valid

fn dvs_sim_rule(predicted, covered, step, mind, confidence, start, i, event_count, selected_index):
    var name = step.law
    var at = step.at
    var adoptions = mind.adoptions
    var complete = true
    var failures = []
    var trace = []
    if dv_has_key(adoptions, name):
        var adoption = dv_get(adoptions, name)
        if dv_and(adoption.active, (adoption.mode == "predict")):
            var law = adoption.law
            var premise = dv_truth(predicted, adoption.law.premise)
            var inputs = dvs_sim_inputs(predicted, adoption.law.premise)
            var local_confidence = dv_min(adoption.confidence, dv_min(confidence, dv_premise_confidence(predicted, adoption.law.premise)))
            var result = false
            var withheld = []
            predicted = dv_with(predicted, "adoptions", dv_with(adoptions, name, dv_with(adoption, "confidence", local_confidence)))
            let event_id = rt_cat(rt_cat(rt_cat("hypothetical-", rt_show(event_count)), rt_cat("-", rt_show(i))), rt_cat("-", rt_show(selected_index)))
            result = dv_predict(dv_with(predicted, "domain", "mind"), name, event_id, (start + at), predicted.revision)
            if (premise == "unknown"):
                var uncertain = dvs_sim_withhold(predicted, law.effects)
                predicted = uncertain.world
                withheld = uncertain.refs
            var local_1 = false
            if (premise == "false"):
                if step.optional:
                    local_1 = "condition-false-not-applicable"
                else:
                    local_1 = "required-premise-false"
            else:
                if (premise == "unknown"):
                    local_1 = "conditional-output-unknown"
                else:
                    local_1 = result.status
            rt_push(trace, dv_with_many({"step": i, "at": at, "law": name, "premise": premise}, {"inputs": inputs, "status": result.status, "changes": result.changes, "basis": adoption.basis, "stage": step.stage, "optional": step.optional, "withheld": withheld, "reason": local_1}))
            if (result.status == "applied"):
                var changes = result.changes
                var j = 0
                predicted = result.world
                while (j < rt_count(changes)):
                    if dv_has(covered, changes[j].ref):
                        false
                    else:
                        rt_push(covered, changes[j].ref)
                    j = (j + 1)
            else:
                if dv_and((premise == "false"), step.optional):
                    false
                else:
                    complete = false
                    rt_push(failures, {"law": name, "reason": result.status, "premise": premise})
        else:
            complete = false
            rt_push(failures, {"law": name, "reason": "not-adopted-predict"})
    else:
        complete = false
        rt_push(failures, {"law": name, "reason": "unknown-law"})
    return {"world": predicted, "coverage": covered, "complete": complete, "failures": failures, "trace": trace}

fn dvs_sim_equal_guard(proposition, ref):
    if (proposition.op == "equals"):
        if dv_same(proposition.ref, ref):
            return {"found": true, "value": proposition.value}
    if (proposition.op == "all"):
        var i = 0
        while (i < rt_count(proposition.items)):
            let result = dvs_sim_equal_guard(proposition.items[i], ref)
            if result.found:
                return result
            i = i + 1
    return {"found": false, "value": false}

fn dvs_sim_dispatch(mind, predicted, step):
    let table = step.dispatch
    let selector = dv_read(predicted, table.selector)
    var indexed = dv_uncontested(selector)
    var entries = []
    var i = 0
    while (i < rt_count(table.laws)):
        let name = table.laws[i]
        let adoption = dv_find(mind.adoptions, name, false)
        var guard = {"found": false, "value": false}
        if (adoption == false):
            indexed = false
        else:
            if (not adoption.active or adoption.mode != "predict"):
                indexed = false
            guard = dvs_sim_equal_guard(adoption.law.premise, table.selector)
            if (not guard.found):
                indexed = false
            var j = 0
            while (j < rt_count(adoption.law.effects)):
                if dv_same(adoption.law.effects[j].ref, table.selector):
                    indexed = false
                j = j + 1
        rt_push(entries, {"law": name, "guard": guard})
        i = i + 1
    var selected = []
    var excluded = []
    i = 0
    while (i < rt_count(entries)):
        let entry = entries[i]
        if (indexed and not dv_same(entry.guard.value, selector.value)):
            rt_push(excluded, entry)
        else:
            rt_push(selected, {"law": entry.law, "at": step.at, "stage": step.stage, "optional": step.optional})
        i = i + 1
    return {"steps": selected, "indexed": indexed, "excluded": excluded, "inputs": [{"ref": table.selector, "cell": selector}]}

// ---- Merged source module: 26-model-slicing.dv ----
// Backward causal slicing changes the work evaluated, never the observations.
// A matching slice is not a complete explanation; only a contradiction ends search.

fn dvs_slice_intersects(left, right):
    var i = 0
    while (i < rt_count(left)):
        if dv_has(right, left[i]):
            return true
        i = i + 1
    return false

fn dvs_slice_law_io(mind, name):
    let adoption = dv_find(mind.adoptions, name, false)
    if (adoption == false):
        return {"known": false, "reads": [], "writes": []}
    let law = adoption.law
    var reads = dvs_sim_refs(law.premise)
    var writes = []
    var i = 0
    while (i < rt_count(law.effects)):
        let effect = law.effects[i]
        writes = dv_explanation_merge(writes, [effect.ref])
        if (effect.op == "increment"):
            reads = dv_explanation_merge(reads, [effect.ref])
        i = i + 1
    return {"known": adoption.active and adoption.mode == "predict", "reads": reads, "writes": writes}

fn dvs_slice_step_io(actor, step):
    if dv_has_key(step, "response"):
        let model = dv_find(dv_find(actor, "response_models", []), step.response.model, false)
        if (model == false):
            return {"known": false, "reads": [], "writes": []}
        var response_reads = dvs_sim_refs(dv_find(step, "available_when", dv_true()))
        var response_writes = []
        let context = dv_find(model, "context", [])
        var k = 0
        while (k < rt_count(context)):
            response_reads = dv_explanation_merge(response_reads, [context[k].from])
            k = k + 1
        if dv_has_key(model, "choice_ref"):
            response_writes = [model.choice_ref]
        k = 0
        var response_known = true
        while (k < rt_count(step.response.options)):
            let option = dv_find(model.options, step.response.options[k], [])
            let bridge = dvs_slice_law_io(actor.mind, dv_find(option, "bridge_law", ""))
            response_known = response_known and bridge.known
            response_reads = dv_explanation_merge(response_reads, bridge.reads)
            response_writes = dv_explanation_merge(response_writes, bridge.writes)
            k = k + 1
        return {"known": response_known, "reads": response_reads, "writes": response_writes}
    var names = [step.law]
    var reads = []
    var writes = []
    var known = true
    if dv_has_key(step, "dispatch"):
        names = step.dispatch.laws
        reads = [step.dispatch.selector]
    var i = 0
    while (i < rt_count(names)):
        let io = dvs_slice_law_io(actor.mind, names[i])
        known = known and io.known
        reads = dv_explanation_merge(reads, io.reads)
        writes = dv_explanation_merge(writes, io.writes)
        i = i + 1
    return {"known": known, "reads": reads, "writes": writes}

fn dvs_slice_feature(hypothesis, feature, plan, plan_io):
    var needed = dvs_sim_refs(dvs_sim_feature(feature))
    var selected = []
    var keep_prefix = false
    var i = rt_count(plan) - 1
    while (0 <= i):
        let step = plan[i]
        if (not dv_has_key(feature, "at") or step.at <= feature.at):
            let io = plan_io[i]
            if (keep_prefix or not io.known or dvs_slice_intersects(io.writes, needed)):
                selected = dv_explanation_merge(selected, [i])
                needed = dv_explanation_merge(needed, io.reads)
                if (not io.known):
                    keep_prefix = true
        i = i - 1
    var timeline = []
    i = 0
    while (i < rt_count(plan)):
        if dv_has(selected, i):
            rt_push(timeline, plan[i])
        i = i + 1
    var assumptions = []
    let original = dv_find(hypothesis, "assumptions", [])
    i = 0
    while (i < rt_count(original)):
        if (keep_prefix or dvs_slice_intersects(dvs_sim_refs(original[i]), needed)):
            rt_push(assumptions, original[i])
        i = i + 1
    return {"timeline": timeline, "assumptions": assumptions, "feature": dv_without(feature, "at"), "original_feature": feature, "size": rt_count(timeline) + rt_count(assumptions), "mask_plan": plan}

fn dvs_model(actor, hypothesis, events, time, parent):
    let features = dv_find(hypothesis, "features", [])
    let plan = dvs_sim_plan(hypothesis)
    var plan_io = []
    var p = 0
    while (p < rt_count(plan)):
        rt_push(plan_io, dvs_slice_step_io(actor, plan[p]))
        p = p + 1
    var smallest = false
    var i = 0
    while (i < rt_count(features)):
        let feature = features[i]
        let observed = dv_find(feature, "observation", dvs_sim_feature(feature))
        if (dv_truth(actor.mind, observed) != "unknown"):
            let slice = dvs_slice_feature(hypothesis, feature, plan, plan_io)
            if (smallest == false):
                smallest = slice
            else:
                if (slice.size < smallest.size):
                    smallest = slice
        i = i + 1
    let full_size = rt_count(plan) + rt_count(dv_find(hypothesis, "assumptions", []))
    if (smallest == false):
        return dvs_model_execute(actor, hypothesis, events, time, parent)
    if (not (smallest.size * 2 < full_size)):
        return dvs_model_execute(actor, hypothesis, events, time, parent)
    let trial = dv_with_many(hypothesis, {"timeline": smallest.timeline, "assumptions": smallest.assumptions, "features": [smallest.feature], "mask_plan": smallest.mask_plan, "evaluation_scope": {"kind": "causal-refutation", "feature": smallest.original_feature}})
    let probe = dvs_model_execute(actor, trial, events, time, parent)
    if (probe.status == "inconsistent"):
        return dv_with(probe, "evaluation_scope", trial.evaluation_scope)
    let next = dv_with_many(actor, {"model_previous_event": events[rt_count(events) - 1].id, "policy": dv_with_many(actor.policy, {"model_budget": probe.remaining, "model_work_remaining": probe.work_remaining})})
    let result = dvs_model_execute(next, hypothesis, events, time, parent)
    return dv_with_many(result, {"probe_expanded": probe.expanded, "expanded": probe.expanded + result.expanded, "total_expanded": probe.expanded + result.total_expanded})

// ---- Merged source module: 35-model-argument.dv ----
// Glue between paid prediction evidence, explicit abduction and real submissions.
// Only actual personal reception may bind a later proposal to an old utterance.

fn dvs_argument_sources(events, actor):
    actor = dvs_update_support_events(actor, events)
    let subject = actor.id
    events = actor.support_events
    var result = []
    var i = 0
    while (i < rt_count(events)):
        var event = events[i]
        if dv_and((event.actor == subject), dv_or((event.type == "observation"), (event.type == "listener_parse"))):
            var observations = event.data.observations
            var j = 0
            while (j < rt_count(observations)):
                rt_push(result, {"event_id": event.id, "observation": observations[j]})
                j = (j + 1)
        i = (i + 1)
    return result

fn dvs_capture_public_topics(actor, events, time, parent):
    var bindings = dv_find(actor.policy, "topic_bindings", [])
    var heard = dv_find(actor, "heard_topics", [])
    var i = 0
    while (i < rt_count(bindings)):
        var binding = bindings[i]
        var topic = bindings[i].topic
        if dv_and((not dv_has_key(heard, topic)), (dv_truth(actor.mind, binding.heard_when) == "true")):
            var sources = dvs_support_parents(actor.mind, dvs_sim_refs(binding.heard_when), events, actor)
