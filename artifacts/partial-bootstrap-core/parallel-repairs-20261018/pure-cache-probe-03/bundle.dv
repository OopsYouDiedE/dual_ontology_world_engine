    let surface = "我在R-05书架的灰上看见半枚手印。请一起到书架旁，逐一比过我们四人的掌宽。"
    var action = c1_once(c1_action(name, "talk", dv_all([c1_at("detective", room), c1_statement("shelf_old")]), c1_at("detective", room), name, [c1_palm_invitation_ref()], c1_source("user", 0, "E11亲见后正式邀请与实际收闻同行机会")))
