fn c1_move_name(actor, origin, target):
    return rt_cat(rt_cat(rt_cat(actor, ".move."), origin), rt_cat(".", target))

fn c1_move_action(actor, origin, target):
    var name = c1_move_name(actor, origin, target)
    return dv_with_many(c1_action(name, "move", c1_at(actor, origin), c1_at(actor, origin), name, dv_single(dv_ref(actor, "state", "location")), c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/实体登记.story", 19, "重演通路")), {"predict_law": name, "travel": {"from": origin, "to": target}, "surface": "沿通路走到相连的房间。"})

fn c1_add_move_methods(world, actor, mode):
    var edges = c1_edges()
    var result = world
    var i = 0
    while (i < rt_count(edges)):
        var edge = edges[i]
        var a = edges[i][0]
        var b = edges[i][1]
        result = dv_adopt(result, c1_method(c1_move_name(actor, a, b), c1_move(actor, a, b)), mode, 1, dv_single(c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/实体登记.story", 19, "重演通路")))
        result = dv_adopt(result, c1_method(c1_move_name(actor, b, a), c1_move(actor, b, a)), mode, 1, dv_single(c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/实体登记.story", 19, "重演通路")))
        i = (i + 1)
    return result

fn c1_move_actions(actor):
    var edges = c1_edges()
    var result = []
    var i = 0
    while (i < rt_count(edges)):
        var a = edges[i][0]
        var b = edges[i][1]
        rt_push(result, c1_move_action(actor, a, b))
        rt_push(result, c1_move_action(actor, b, a))
        i = (i + 1)
    return result

