fn c1_latch_contact_method(world, actor, mode):
    if actor != "detective":
        return world
    return dv_adopt(world, c1_method("detective.touch_latch", c1_latch_contact_law()), mode, 1, dv_single(c1_latch_contact_source()))

fn c1_latch_contact_action():
    let known = dv_all([c1_at("detective", "foyer"), c1_statement("bolt_down"), dv_fact(c1_latch_contact_ref(), false)])
    let physical = dv_all(dv_pair(c1_at("detective", "foyer"), dv_fact(c1_latch_contact_ref(), false)))
    let grants = [c1_latch_contact_ref(), c1_knowledge("recalled_bolt"), c1_knowledge("recalled_trust")]
    var action = c1_observe_as(c1_action("detective.touch_latch", "move", known, physical, "detective.touch_latch", grants, c1_latch_contact_source()), "recall", "detective", 0.85)
    action = dv_with_many(action, {"resonance": {"passive": true, "basis": [c1_latch_contact_source()]}, "travel": {"from": "foyer", "to": "foyer", "station": "site:E1"}, "predict_law": "detective.touch_latch", "grant_observation_sources": [{"ref": c1_latch_contact_ref(), "source": "perception", "origin": "own-executed-contact", "trust": 1}], "presentation": {"actor": "detective", "voice": "bodily-flash", "publish_after": "actual-applied-execution", "knowledge_effect": "none", "lines": [{"template": "指腹压上铁闩的一瞬，有什么东西从很远的地方晃了一下。", "bindings": []}, {"template": "霍铎说闩。我就闩了。……我信他。", "bindings": []}, {"template": "一句转述，我就去闩了门。我凭的是什么？", "bindings": []}]}})
    return action

