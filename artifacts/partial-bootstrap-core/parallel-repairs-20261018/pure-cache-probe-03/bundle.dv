fn dvs_support_event_index(events, subject):
    let key = ["support-event-index", subject]
    let cached = rt_memo_get(events, key)
    if cached[0]:
        return cached[1]
    var index = []
    var accepted = []
    var i = 0
    while i < rt_count(events):
        let event = events[i]
        var refs = []
        if event.type == "observation" or event.type == "listener_parse":
            let observations = event.data.observations
            var j = 0
            while j < rt_count(observations):
                rt_push(refs, observations[j].ref)
                j = j + 1
        if event.type == "inference":
            let changes = event.data.receipt.changes
            var j = 0
            while j < rt_count(changes):
                rt_push(refs, changes[j].ref)
                j = j + 1
        if event.type == "model_argument_accepted":
            rt_push(accepted, i)
        var j = 0
        while j < rt_count(refs):
            let ref_key = dvs_support_ref_key(subject, refs[j])
            var positions = dv_find(index, ref_key, [])
            if not dv_has(positions, i):
                rt_push(positions, i)
                let slot = rt_record_index(index, ref_key)
                if slot < 0:
                    rt_push(index, dv_pair(ref_key, positions))
                else:
                    rt_replace(index, slot, dv_pair(ref_key, positions))
            j = j + 1
        i = i + 1
    return rt_memo_put(events, key, {"refs": index, "accepted": accepted})

fn dvs_support_ref_events(events, index, subject, ref):
    let positions = dv_find(index.refs, dvs_support_ref_key(subject, ref), [])
    var result = []
    var i = 0
    var j = 0
    while i < rt_count(positions) or j < rt_count(index.accepted):
        if j >= rt_count(index.accepted):
            rt_push(result, events[positions[i]])
            i = i + 1
        else:
            if i < rt_count(positions) and positions[i] < index.accepted[j]:
                rt_push(result, events[positions[i]])
                i = i + 1
            else:
                rt_push(result, events[index.accepted[j]])
                j = j + 1
    return result

fn dvs_support_parents(mind, refs, events, subject_or_actor):
    var subject = subject_or_actor
    var cand_events = []
    if dv_record_like(subject_or_actor):
        subject = subject_or_actor.id
        cand_events = dv_find(subject_or_actor, "support_events", [])
        if rt_count(cand_events) == 0:
            cand_events = dvs_subject_support_events(events, subject)
    else:
        cand_events = dvs_subject_support_events(events, subject)
    let support_index = dvs_support_event_index(cand_events, subject)
    var parents = []
    var i = 0
    while (i < rt_count(refs)):
        var ref = refs[i]
        var cell = dv_read(mind, ref)
        let claims = dv_find(cell, "claims", [])
        let basis = dv_find(cell, "basis", [])
        let ref_events = dvs_support_ref_events(cand_events, support_index, subject, ref)
        var j = 0
        while (j < rt_count(ref_events)):
            var event = ref_events[j]
            var data = event.data
            var k = 0
            if dv_or((event.type == "observation"), (event.type == "listener_parse")):
                var observations = data.observations
                while (k < rt_count(observations)):
                    var observation = observations[k]
                    if dv_and(dv_same_local_ref(subject, observation.ref, ref), dv_has(claims, observation)):
                        parents = dv_explanation_merge(parents, dv_single(event.id))
                    k = (k + 1)
            else:
                if (event.type == "inference"):
                    var changes = data.receipt.changes
                    var n = 0
                    while (n < rt_count(changes)):
                        var change = changes[n]
                        if dv_and(dv_same(change.ref, ref), dv_same(change.after, cell)):
                            parents = dv_explanation_merge(parents, dv_single(event.id))
                        n = (n + 1)
                else:
                    if (event.type == "model_argument_accepted"):
                        if dv_has(basis, event.id):
                            parents = dv_explanation_merge(parents, dv_single(event.id))
            j = (j + 1)
        i = (i + 1)
    return parents

fn dvs_selection_parents(actor, action, choice, events, parent):
    var refs = choice.relevant_refs
    var parents = dvs_cognitive_parents(actor, dv_single(parent))
    refs = dvp_merge_refs(refs, dvs_sim_refs(action.precondition))
    if dv_has_key(action, "answer"):
        refs = dvp_merge_refs(refs, dvs_sim_refs(action.answer))
    if dv_has_key(actor, "question_ref"):
        refs = dvp_add_ref(refs, actor.question_ref)
    parents = dv_explanation_merge(parents, dvs_support_parents(actor.mind, refs, events, actor))
    if (dv_find(actor, "hypothesis_event", "") == ""):
        false
    else:
        parents = dv_explanation_merge(parents, dv_single(actor.hypothesis_event))
    if dv_has_key(action, "speech"):
        var prediction = dv_find(dv_find(actor, "speech_choice_values", []), action.id, [])
        parents = dv_explanation_merge(parents, dv_find(prediction, "prediction_events", []))
    if dv_has_key(action, "argument"):
        parents = dv_explanation_merge(parents, dv_single(action.argument.id))
    return parents

fn dvs_model_parent_ids(actor, parent, prior):
    var result = dvs_cognitive_parents(actor, dv_single(parent))
    if (dv_find(actor, "model_paid_event", "") == ""):
        false
    else:
        result = dv_explanation_merge(result, dv_single(actor.model_paid_event))
    if (dv_find(actor, "model_previous_event", "") == ""):
        false
    else:
        result = dv_explanation_merge(result, dv_single(actor.model_previous_event))
    if (prior == ""):
        false
    else:
        result = dv_explanation_merge(result, dv_single(prior))
    return result

fn dvs_public_grant_parents(events, parent, subject):
    var result = dv_single(parent)
    var literal = ""
    var i = rt_count(events) - 1
    while (i >= 0 and literal == ""):
        var event = events[i]
        if (event.type == "speech_literal"):
            if dv_has(event.parents, parent):
                literal = event.id
        i = i - 1
    if (literal == ""):
        false
    else:
        result = dv_explanation_merge(result, dv_single(literal))
        i = rt_count(events) - 1
        var found_parse = false
        while (i >= 0 and not found_parse):
            var event = events[i]
            if dv_and((event.type == "listener_parse"), (event.actor == subject)):
                if (dv_find(event.data, "source_event", "") == literal):
                    result = dv_explanation_merge(result, dv_single(event.id))
                    found_parse = true
            i = i - 1
    return result

fn dvs_physical_proposition(proposition, bindings, subject):
    var op = proposition.op
    if (op == "constant"):
        return proposition
    else:
        if (op == "not"):
            return dv_not(dvs_physical_proposition(proposition.item, bindings, subject))
        else:
            if (op == "all"):
                var items = proposition.items
                var i = 0
                var mapped = []
                while (i < rt_count(items)):
                    rt_push(mapped, dvs_physical_proposition(items[i], bindings, subject))
                    i = (i + 1)
                return dv_all(mapped)
            else:
                var ref = proposition.ref
                var i = 0
                var physical = ""
                while (i < rt_count(bindings)):
                    var binding = bindings[i]
                    if dv_and((binding.subject == subject), (binding.local == ref.object)):
                        physical = binding.physical
                    i = (i + 1)
                if (physical == ""):
                    return {"op": "constant", "value": "unknown"}
                else:
                    return dv_with(proposition, "ref", dv_ref(physical, ref.facet, ref.field))

fn dvs_refresh_derivations(actor, events, time, parent):
    var derivations = dv_find(actor, "inference_derivations", [])
    var world = actor.mind
    var i = (rt_count(dv_find(actor, "inference_derivations", [])) - 1)
    var contaminated = []
    var restored = []
    var parents = dvs_cognitive_parents(actor, dv_single(parent))
    var remaining = dv_find(actor.policy, "reason_budget", 0)
    var checked = 0
    var blocked = false
    var updated = false
    while dv_and((not (i < 0)), (not blocked)):
        var derivation = derivations[i]
        var inputs = derivations[i].inputs
        var stale = false
        var j = 0
        if dv_find(derivation, "valid", true):
            if dv_same(derivation.adoption, dv_find(world.adoptions, derivation.adoption.law.name, false)):
                false
            else:
                stale = true
            while (j < rt_count(inputs)):
                var input = inputs[j]
                if dv_or(dv_has(contaminated, input.ref), (not dv_same(dvs_reason_cell(input.cell), dvs_reason_cell(dv_read(world, input.ref))))):
                    stale = true
                j = (j + 1)
            if stale:
                if (remaining < 1):
                    blocked = true
                else:
                    var changes = derivation.changes
                    var k = 0
                    remaining = (remaining - 1)
                    checked = (checked + 1)
                    parents = dv_explanation_merge(parents, dvs_support_parents(actor.mind, dvs_sim_refs(derivation.adoption.law.premise), events, actor))
                    while (k < rt_count(changes)):
                        var change = changes[k]
                        if dv_same(dv_read(world, change.ref), change.after):
                            world = dv_store(world, change.ref, change.before)
                            contaminated = dvp_add_ref(contaminated, change.ref)
                            rt_push(restored, change)
                        k = (k + 1)
                    parents = dv_explanation_merge(parents, dv_single(derivation.event))
                    derivations = dvs_replace(derivations, i, dv_with(derivation, "valid", false))
        i = (i - 1)
    if (0 < rt_count(restored)):
        world = dv_with(world, "revision", (world.revision + 1))
    updated = dv_with_many(actor, {"mind": world, "inference_derivations": derivations, "cognition_blocked": blocked, "policy": dv_with(actor.policy, "reason_budget", remaining)})
    if dv_or(blocked, (0 < checked)):
        updated = dv_with(updated, "last_cognitive_event", rt_cat("e", rt_show(rt_count(events))))
    if dv_or(blocked, (0 < checked)):
        parent = dvs_event_prepared(events, "inference_dependencies_invalidated", actor.id, time, parents, dv_with_many({"mind_revision_before": actor.mind.revision, "mind_revision_after": world.revision, "restored": restored, "checked": checked}, {"budget_blocked": blocked, "remaining": remaining, "actor_id": actor.id, "actor_before": actor, "actor_after": updated, "mind_before": actor.mind, "mind_after": world}))
    if dv_and((not blocked), (0 < checked)):
        return dvs_refresh_derivations(updated, events, time, parent)
    else:
        return updated

fn dvs_model_observed_inputs(model):
    var comparisons = dv_find(model, "comparisons", [])
    var result = []
    var i = 0
    while (i < rt_count(comparisons)):
        result = dv_explanation_merge(result, dv_find(comparisons[i], "observed_cells", []))
        i = (i + 1)
    return result

fn dvs_public_model_paid(events, id, subject):
    let event = dvs_find_event_by_id(events, id)
    if (event != false and event.actor == subject and dv_or((event.type == "mind_simulation"), (event.type == "model_recheck"))):
        let parents = event.parents
        let result = event.data.result
        var j = 0
        while (j < rt_count(parents)):
            let paid = dvs_find_event_by_id(events, parents[j])
            if (paid != false and paid.actor == subject and paid.type == "action_execution"):
                let data = paid.data
                if dv_and((dv_find(dv_find(data, "action", []), "kind", "") == "replay"), dv_and((data.receipt.execution.status == "applied"), dv_and((dv_find(result, "status", "") == "explained"), dv_find(result, "plan_complete", false)))):
                    return true
            j = j + 1
    return false

fn dvs_public_argument_valid(action, rule, events, subject):
    var argument = dv_find(action, "argument", false)
    if (argument == false):
        return false
    if (not dv_has_key(argument, "id")):
        return false
    let event = dvs_find_event_by_id(events, argument.id)
    if (event == false or event.actor != subject or event.type != "model_argument_accepted"):
        return false
    var original = event.data.result.argument
    var public = dv_without(dv_without(dv_without(argument, "question_id"), "hypothesis_id"), "adoptions")
    if (not dv_same(original, public)):
        return false
    if (not dvs_public_model_paid(events, argument.model_event, subject)):
        return false
    var required = dv_find(rule, "required_argument_slots", dv_find(action, "argument_slots", []))
    var claims = argument.claims
    var j = 0
    var propositions = []
    if (not dv_and((0 < rt_count(required)), dv_and(argument.estimated, dv_and((0 < argument.confidence), dv_and((argument.confidence < 1), dv_and((not (argument.model_event == "")), (0 < rt_count(argument.source_event_ids)))))))):
        return false
    while (j < rt_count(required)):
        var slot = required[j]
        var k = 0
        var found = false
        while (k < rt_count(claims)):
            var claim = claims[k]
            if (claim.slot_id == slot):
                found = true
                rt_push(propositions, dv_fact(claim.ref, claim.value))
            k = (k + 1)
        if (not found):
            return false
        j = (j + 1)
    return dv_same(dv_all(propositions), action.answer)

fn dvs_factor_candidate_rejected(actor, candidate):
    var rejections = dv_find(actor, "factor_rejections", {"source_revision": -1, "ids": []})
    return dv_and((rejections.source_revision == actor.mind.revision), dv_has(rejections.ids, candidate.id))

fn dvs_capture_heard_utterances(actor, events):
    var heard = dv_find(actor, "heard_utterances", [])
    var i = dv_find(actor, "heard_utterances_cursor", 0)
    let total = rt_count(events)
    while (i < total):
        var event = events[i]
        if dv_and((event.actor == actor.id), (event.type == "listener_parse")):
            var data = event.data
            var source = data.source_event
            var existing = dv_find(heard, source, false)
            if existing == false or existing.parse_event != event.id:
                let literal = dvs_find_event_by_id(events, source)
                if literal != false and dv_has(event.parents, source) and literal.actor != actor.id:
                    heard = dv_with(heard, source, dv_with({"source_event": source, "parse_event": event.id, "speaker": literal.actor, "scope": dv_find(data.speech, "scope", "")}, "refs", dvs_sim_refs(data.literal)))
        i = (i + 1)
    return dv_with_many(actor, {"heard_utterances": heard, "heard_utterances_cursor": total})

fn dvs_topic_origin_speakers(events, sources):
    var pending = dv_clone(sources)
    var visited = []
    var result = []
    var i = 0
    while (i < rt_count(pending)):
        var id = pending[i]
        if dv_has(visited, id):
            false
        else:
            rt_push(visited, id)
            let event = dvs_find_event_by_id(events, id)
            if (event != false):
                if dv_or((event.type == "observation"), (event.type == "listener_parse")):
                    var source = dv_find(event.data, "source_event", "")
                    if dv_and((not (source == "")), dv_has(event.parents, source)):
                        pending = dv_explanation_merge(pending, dv_single(source))
                else:
                    if (event.type == "public_topic_heard"):
                        pending = dv_explanation_merge(pending, dv_find(event.data, "source_event_ids", []))
                if (event.type == "speech_literal"):
                    result = dv_explanation_merge(result, dv_single(event.actor))
        i = (i + 1)
    return result

fn dvs_argument_reassessment_sources(actor, action, argument):
    var heard = dv_find(actor, "heard_utterances", [])
    var scope = dv_find(action, "reassessment_source_scope", "")
    var topic = dv_find(dv_find(actor, "heard_topics", []), argument.question_id, [])
    var result = []
    var i = 0
    while (i < rt_count(heard)):
        var record = heard[i][1]
        if dv_and((not (scope == "")), dv_and((scope == record.scope), dv_has(dv_find(topic, "origin_speakers", []), record.speaker))):
            result = dv_explanation_merge(result, dv_single(record.source_event))
        i = (i + 1)
    return result

fn dvs_public_literal_source(events, parent, subject):
    var literal = ""
    var i = rt_count(events) - 1
    while (i >= 0 and literal == ""):
        var event = events[i]
        if (event.type == "speech_literal"):
            if dv_has(event.parents, parent):
                literal = event.id
        i = i - 1
    if (literal == ""):
        return ""
    var result = ""
    i = rt_count(events) - 1
    while (i >= 0 and result == ""):
        var event = events[i]
        if dv_and((event.type == "listener_parse"), (event.actor == subject)):
            if dv_and((dv_find(event.data, "source_event", "") == literal), dv_has(event.parents, literal)):
                result = literal
        i = i - 1
    return result

// Autonomous formal model session. Host geometry and input are outside this model.

fn dvs_authority_speech_allowed(action, physical, subject):
    var contracts = dv_find(physical, "speech_contracts", [])
    var i = 0
    var registered = false
    var allowed = true
    while (i < rt_count(contracts)):
        var contract = contracts[i]
        if (contract.subject == subject):
            registered = true
            var adoption = dv_find(physical.adoptions, contract.law_id, false)
            if (adoption == false):
                allowed = false
            else:
                if dv_and(adoption.active, dv_and((adoption.mode == "enforce"), dv_and((adoption.law.version == contract.version), dv_and(contract.require_literal_truth, (0 < rt_count(contract.basis)))))):
                    false
                else:
                    allowed = false
            if dv_has_key(action, "authority_truth_gate"):
                var gate = action.authority_truth_gate
                if dv_and(dv_find(gate, "required", false), (dv_find(gate, "contract_id", "") == contract.id)):
                    false
                else:
                    allowed = false
            if dv_has_key(action, "speech"):
                if (dv_truth(physical, action.speech.literal_ast) == "true"):
                    false
                else:
                    allowed = false
            else:
                allowed = false
        i = (i + 1)
    if dv_and((not registered), dv_has_key(action, "authority_truth_gate")):
        if dv_find(action.authority_truth_gate, "required", false):
            allowed = false
    return allowed

fn dvs_acceptance_law_ready(physical, name):
    if dv_has_key(physical.adoptions, name):
        var adoption = dv_get(physical.adoptions, name)
        var law = dv_get(physical.adoptions, name).law
        if dv_and(adoption.active, dv_and((adoption.mode == "enforce"), (dv_truth(physical, law.premise) == "true"))):
            return (dv_stage(physical, law.effects, dv_find(physical, "time", 0), adoption.basis, adoption.confidence).status == "ready")
        else:
            return false
    else:
        return false

fn dvs_answer(rules, action, physical, mind, bindings, events):
    var i = 0
    var found = false
    var literal = "unknown"
    var support = "unknown"
    var topic = "unknown"
    var complete = "unknown"
    var transition = ""
    var grants = []
    var recipients = []
    var require_arg = false
    var target_stage = ""
    var progress_ref = false
    var completion_ref = false
    while (i < rt_count(rules)):
        var rule = rules[i]
        if (rule.id == dv_find(action, "answer_id", "")):
            found = true
            var local_1 = false
            if dv_find(rule, "condition_from_answer", false):
                local_1 = dvs_physical_proposition(action.answer, bindings, mind.subject)
            else:
                local_1 = rule.condition
            literal = dv_truth(physical, local_1)
            support = dv_truth(mind, rule.required_support)
            transition = dv_find(rule, "accepted_law", "")
            topic = dv_truth(physical, dv_find(rule, "question_match", {"op": "constant", "value": "unknown"}))
            complete = dv_truth(mind, dv_find(rule, "answer_complete", {"op": "constant", "value": "unknown"}))
            require_arg = dv_find(rule, "require_argument", false)
            target_stage = dv_find(rule, "stage", dv_find(action, "topic", "auxiliary"))
            progress_ref = dv_find(rule, "progress_ref", false)
            completion_ref = dv_find(rule, "completion_ref", false)
            if require_arg:
                if dvs_public_argument_valid(action, rule, events, mind.subject):
                    false
                else:
                    complete = "unknown"
            grants = dv_find(rule, "accepted_public_grants", [])
            recipients = dv_find(rule, "accepted_listeners", [])
        i = (i + 1)
    var law_ready = dvs_acceptance_law_ready(physical, transition)
    var accepted = false
    var reason = "accepted"
    var truth_level = 0
    var local_3 = false
    if (not found):
        local_3 = "undeclared-answer"
    else:
        if (not (topic == "true")):
            local_3 = "unasked-topic"
        else:
            if (not (literal == "true")):
                local_3 = "literal-not-established"
            else:
                if (not (support == "true")):
                    local_3 = "insufficient-source"
                else:
                    if (not (complete == "true")):
                        local_3 = "incomplete-answer"
                    else:
                        if (not law_ready):
                            local_3 = "protocol-transition-not-ready"
                        else:
                            local_3 = "accepted"
    reason = local_3
    accepted = (reason == "accepted")
    var local_4 = false
    if accepted:
        if dv_has_key(action, "argument"):
            local_4 = 2
        else:
            if require_arg:
                local_4 = 2
            else:
                local_4 = 1
    else:
        local_4 = 0
    truth_level = local_4
    var judgment = dv_with_many({"accepted": accepted, "literal_truth": literal, "epistemic_support": support, "accepted_law": transition}, {"accepted_public_grants": grants, "accepted_listeners": recipients, "question_match": topic, "answer_complete": complete, "law_ready": law_ready, "reason": reason, "truth_level": truth_level, "stage": target_stage})
    return dv_with_many(judgment, {"progress_ref": progress_ref, "completion_ref": completion_ref})

fn dvs_run(story, capability):
    var state = dvs_session_open(story, capability)
    while dvs_session_active(state):
        state = dvs_session_prepare(state)
        let pending = dv_find(state, "pending", false)
        if pending != false:
            state = dvs_session_complete(state, {"action_event": pending.action_event, "outcome": "applied", "actual": pending.model.actual, "executor": "formal-model"})
    return dvs_session_close(state)

fn dvs_session_open(story, capability):
    dv_require((story.format == "dv-session-v1"), "Unsupported story data dialect")
    var physical = dv_clone(story.physical)
    var actors = dv_clone(story.actors)
    var events = []
    var bindings = story.bindings
    var costs = story.cost_model
    var run_start = dv_find(story.physical, "time", 0)
    var duration_budget = dv_find(story, "game_duration_budget", 0)
    var horizon = 0
    var duration_blocked = false
    var limit = story.max_actions
    var cursor = 0
    var executed = 0
    var idle = 0
    var status = "action-window-exhausted"
    var initial = []
    horizon = (run_start + duration_budget)
    dv_require((not (duration_budget < 0)), "Negative game duration budget")
    initial = {"physical": physical, "actors": actors}
    var i = 0
    while (i < rt_count(actors)):
        var actor = dvs_initialize_cognition(actors[i], dv_find(story, "opening_seed", 0), i)
        if dv_and((capability == "disabled"), (actor.id == dv_find(story, "capability_actor", ""))):
            actor = dv_with(actor, "policy", dv_with(actor.policy, "model_budget", 0))
        actors = dvs_replace(actors, i, dv_with_many(actor, {"ledger": dv_action_cost_ledger(actor.id, actor.balance), "planning_limit": dv_find(actor.policy, "plan_budget", 0)}))
        i = (i + 1)
    initial = {"physical": physical, "actors": actors}
    dvs_event_prepared(events, "session_start", "", dv_find(physical, "time", 0), [], dv_with({"initial": initial, "capability": capability, "source_refs": dv_find(story, "source_refs", [])}, "time_origin", {"run_start": run_start, "duration_budget": duration_budget, "horizon": horizon, "unit": "minute"}))
    return {"story": story, "physical": physical, "actors": actors, "events": events, "bindings": bindings, "costs": costs, "run_start": run_start, "duration_budget": duration_budget, "horizon": horizon, "duration_blocked": duration_blocked, "limit": limit, "cursor": cursor, "executed": executed, "idle": idle, "status": status, "initial": initial}

fn dvs_session_active(state):
    return dv_and((not (state.horizon < dv_find(state.physical, "time", 0))), dv_and((state.executed < state.limit), (state.idle < rt_count(state.actors) or 0 < dvs_scheduled_count(state.actors))))

// Each owner keeps one chosen action while its declared duration elapses.
fn dvs_scheduled_count(actors):
    var count = 0
    var i = 0
    while i < rt_count(actors):
        if dv_find(actors[i], "scheduled_action", false) != false:
            count = count + 1
        i = i + 1
    return count

fn dvs_dispatch_due(state, index):
    let updated_actor = dvs_erosion_update(state.actors[index], state.physical, state.physical.time)
    state = dvs_owned_state_update(state, {"actors": dvs_replace(state.actors, index, updated_actor)})
    if not dvs_actor_can_act(updated_actor):
        let cancelled = dv_with(updated_actor, "scheduled_action", false)
        return dvs_schedule(dvs_owned_state_update(state, {"actors": dvs_replace(state.actors, index, cancelled)}))
    let queued = state.actors[index].scheduled_action
    let time = state.physical.time
    let actor = dvs_drain_received_speech(dv_with(state.actors[index], "scheduled_action", false), state.events, time)
    let action = queued.action
    let bounds = dv_action_cost_bounds(queued.model.minimum, queued.model.maximum)
    let event = rt_cat("action", rt_show(state.executed))
    let quote = dv_with(dv_action_cost_quote(actor.ledger, state.physical, dv_find(action, "law", action.id), event, bounds), "scheduled_start", queued.start)
    var events = state.events
    let parent = dvs_event(events, "cost_quote", actor.id, time, [queued.parent], quote)
    let pending = {"index": index, "actor": actor, "parent": parent, "time": time, "action": action, "id": actor.id, "mind": actor.mind, "model": queued.model, "action_event": event, "ledger": actor.ledger, "quote": quote, "choice": queued.choice}
    return dvs_owned_state_update(state, {"actors": dvs_replace(state.actors, index, actor), "events": events, "pending": pending, "idle": 0})

// Scan eligibility without running cognition. Ties preserve cyclic actor order.
fn dvs_schedule(state):
    var updated = state.actors
    var erosion_index = 0
    var any_eroded = false
    while erosion_index < rt_count(updated):
        let original = updated[erosion_index]
        let eroded = dvs_erosion_update(original, state.physical, state.physical.time)
        if not dv_same(eroded, original):
            updated = dvs_replace(updated, erosion_index, eroded)
            any_eroded = true
        erosion_index = erosion_index + 1
    if any_eroded:
        state = dvs_owned_state_update(state, {"actors": updated})
    var current = state
    var due_index = -1
    var due_time = state.horizon + 1
    var ready_index = -1
    var offset = 0
    var index = state.cursor
    while offset < rt_count(state.actors):
        let actor = state.actors[index]
        let queued = dv_find(actor, "scheduled_action", false)
        if not dvs_actor_can_act(actor):
            if queued != false:
                updated = dvs_replace(updated, index, dv_with(actor, "scheduled_action", false))
                state = dvs_owned_state_update(state, {"actors": updated})
        else:
            if queued != false:
                if queued.due < due_time:
                    due_time = queued.due
                    due_index = index
            else:
                let stopped = dv_find(state, "player_actor", "") != actor.id and dv_find(actor, "last_decision_stopped", false) == true and actor.mind.revision == dv_find(actor, "decision_revision", -1) and actor.mind.time == dv_find(actor, "decision_mind_time", -1) and dv_find(actor, "decision_chapter", 0) == dv_find(state.story, "chapter", 1) and rt_count(dv_find(actor, "pending_heard", [])) == 0
                if ready_index < 0 and 0 < dv_find(actor.policy, "budget", 0) and not stopped and (dv_find(actor, "decision_time", -1) != state.physical.time or dv_find(actor, "decision_revision", -1) != actor.mind.revision or 0 < rt_count(dv_find(actor, "pending_heard", []))):
                    ready_index = index
        index = index + 1
        if index == rt_count(state.actors):
            index = 0
        offset = offset + 1
    if due_index >= 0 and due_time <= state.physical.time:
        return dvs_dispatch_due(state, due_index)
    if ready_index >= 0:
        return dvs_owned_state_update(state, {"cursor": ready_index})
    if due_index >= 0:
        var physical = state.physical
        var events = state.events
        let parent = dvs_event(events, "action_wait", "", physical.time, [], {"until": due_time, "waiting": dvs_scheduled_count(state.actors)})
        // Visit authored clock boundaries and any unsettled process cascade.
        while physical.time < due_time:
            var next_time = dvs_environment_next_time(physical, state.story, due_time)
            if due_time < next_time:
                next_time = due_time
            physical = dvs_environment(dv_with(physical, "time", next_time), state.story, events, parent)
        current = dvs_owned_state_update(state, {"physical": physical, "events": events, "idle": 0})
        return dvs_dispatch_due(current, due_index)
    return dvs_owned_state_update(state, {"idle": rt_count(state.actors)})

fn dvs_debug_phase(story, actor, time, phase):
    if dv_find(story, "debug_phase_progress", false):
        rt_print(rt_json_stringify({"type": "engine_phase", "actor": actor, "game_time": time, "phase": phase}))
    return true

fn dvs_session_prepare(state):
    if dv_has_key(state, "pending"):
        return state
    if dv_find(state, "awaiting_player", false) and dv_find(state, "player_selection", "") == "":
        return state
    if dv_find(state, "player_selection", "") == "":
        state = dvs_schedule(state)
    if dv_has_key(state, "pending") or not dvs_session_active(state):
        return state
    return dvs_prepare_actor(state)

// The caller has selected the actor; content may refresh its own declarations first.
// This remains the same prepare phase, not a second dispatch or execution path.
fn dvs_prepare_actor(state):
    let story = state.story
    var physical = state.physical
    var actors = state.actors
    var events = state.events
    var bindings = state.bindings
    var costs = state.costs
    var run_start = state.run_start
    var duration_budget = state.duration_budget
    var horizon = state.horizon
    var duration_blocked = state.duration_blocked
    var limit = state.limit
    var cursor = state.cursor
    var executed = state.executed
    var idle = state.idle
    var status = state.status
    var initial = state.initial
    var index = cursor
    var actor = dv_with(actors[cursor], "decision_time", physical.time)
    var parent = events[(rt_count(events) - 1)].id
    var time = dv_find(physical, "time", 0)
    var local_1 = false
    if ((cursor + 1) < rt_count(actors)):
        local_1 = (cursor + 1)
    else:
        local_1 = 0
    cursor = local_1
    if (not dvs_actor_can_act(actor) or not (0 < dv_find(actor.policy, "budget", 0))):
        idle = (idle + 1)
    else:
        if dv_find(state, "player_selection", "") == "":
            actor = dv_with(actor, "policy", dv_with_many(actor.policy, {"remaining_game_time": horizon - time, "plan_budget": dv_find(actor, "planning_limit", dv_find(actor.policy, "plan_budget", 0))}))
            actor = dvs_update_support_events(actor, events)
            dvs_debug_phase(story, actor.id, time, "cognition-start")
            actor = dvs_drain_received_speech(actor, events, time)
            actor = dvs_notice_peers(actor, physical, actors, bindings, events, time, parent)
            if dv_find(state, "player_actor", "") != actor.id and dv_find(actor, "last_decision_stopped", false) == true and actor.mind.revision == dv_find(actor, "decision_revision", -1) and actor.mind.time == dv_find(actor, "decision_mind_time", -1) and dv_find(actor, "decision_chapter", 0) == dv_find(story, "chapter", 1):
                idle = idle + 1
                actors = dvs_replace(actors, index, actor)
                return dvs_owned_state_update(state, {"actors": actors, "cursor": cursor, "idle": idle})
            actor = dvs_prepare_cognition(actor, events, time, parent, dv_find(story, "chapter", 1))
            dvs_debug_phase(story, actor.id, time, "cognition-end")
        var choice = false
        if dv_find(state, "player_actor", "") == actor.id:
            let selection = dv_find(state, "player_selection", "")
            if selection == "" and 0 < rt_count(dvs_player_options(actor)):
                actors = dvs_replace(actors, index, actor)
                return dvs_control_state(state, actors, events, index, dv_find(state, "player_actor", ""), "", true)
            if selection == "":
                choice = {"action": false, "score": 0, "plan_expansions": 0, "plans": [], "dependency_cache": dv_find(actor, "dependency_cache", false)}
            else:
                choice = dvs_player_choice(actor, selection)
        else:
            dvs_debug_phase(story, actor.id, time, "choice-start")
            choice = dvs_choose(actor, bindings, costs)
            dvs_debug_phase(story, actor.id, time, "choice-end")
        choice = dv_with_many(choice, {"cognition_reused": dv_find(actor, "cognition_reused", false), "reason_reused": dv_find(actor, "reason_reused", false)})
        actor = dv_with(actor, "dependency_work_total", dv_find(actor, "dependency_work_total", 0) + dv_find(choice, "dependency_expansions", 0))
        actor = dv_with(actor, "decision_revision", actor.mind.revision)
        var action = choice.action
        actor = dv_with_many(actor, {"decision_mind_time": actor.mind.time, "decision_chapter": dv_find(story, "chapter", 1), "last_decision_stopped": action == false})
        actor = dv_with(actor, "dependency_cache", choice.dependency_cache)
        actor = dv_with(actor, "planned_followup", "")
        actor = dv_with_many(actor, {"planning_work_total": dv_find(actor, "planning_work_total", 0) + choice.plan_expansions, "policy": dv_with(actor.policy, "plan_budget", dv_find(actor.policy, "plan_budget", 0) - choice.plan_expansions)})
        if (action == false):
            if (0 < dv_find(choice, "time_blocked", 0)):
                duration_blocked = true
            idle = (idle + 1)
            actors = dvs_replace(actors, index, actor)
            dvs_event(events, "planning_stop", actor.id, time, dv_single(parent), dv_without(choice, "dependency_cache"))
        else:
            var id = actor.id
            var mind = actor.mind
            var model = dv_get(costs, action.kind)
            var action_event = rt_cat("action", rt_show(executed))
            var ledger = actor.ledger
            parent = dvs_event_prepared(events, "action_selected", id, time, dvs_selection_parents(actor, action, choice, events, parent), dv_with_many({"action": action, "revision_before": mind.revision, "score": choice.score, "hypothesis": dv_find(actor, "hypothesis", false)}, {"plan_expansions": choice.plan_expansions, "plans": choice.plans}))
            parent = dvs_event(events, "planning_choice", id, time, dv_single(parent), dv_without(choice, "dependency_cache"))
            var bounds = dv_action_cost_bounds(model.minimum, model.maximum)
            if dv_or((horizon < (time + bounds.maximum.time)), (horizon < (time + model.actual.time))):
                duration_blocked = true
                idle = (idle + 1)
                dvs_event(events, "duration_budget_rejected", id, time, dv_single(parent), {"action": action, "bounds": bounds, "actual": model.actual, "time_origin": {"run_start": run_start, "duration_budget": duration_budget, "horizon": horizon, "unit": "minute"}})
            else:
                if (not dv_action_cost_le(bounds.maximum, ledger.balances)):
                    dvs_event(events, "resource_rejected", id, time, dv_single(parent), {"action": action, "ledger": ledger})
                    idle = (idle + 1)
                else:
                    let queued = {"action": action, "choice": {"relevant_refs": choice.relevant_refs, "selected_path": dv_find(choice, "selected_path", [])}, "model": model, "start": time, "due": time + model.actual.time, "parent": parent}
                    actor = dv_with(actor, "scheduled_action", queued)
                    dvs_event(events, "action_scheduled", id, time, [parent], {"action_id": action.id, "due": queued.due, "duration": model.actual.time})
                    idle = 0

    actors = dvs_replace(actors, index, actor)
    return {"player_actor": dv_find(state, "player_actor", ""), "story": story, "physical": physical, "actors": actors, "events": events, "bindings": bindings, "costs": costs, "run_start": run_start, "duration_budget": duration_budget, "horizon": horizon, "duration_blocked": duration_blocked, "limit": limit, "cursor": cursor, "executed": executed, "idle": idle, "status": status, "initial": initial, "awaiting_player": false, "player_selection": ""}

fn dvs_session_complete(state, receipt):
    let story = state.story
    var physical = state.physical
    var actors = state.actors
    var events = state.events
    var bindings = state.bindings
    var costs = state.costs
    var run_start = state.run_start
    var duration_budget = state.duration_budget
    var horizon = state.horizon
    var duration_blocked = state.duration_blocked
    var limit = state.limit
    var cursor = state.cursor
    var executed = state.executed
    var idle = state.idle
    var status = state.status
    var initial = state.initial
    let pending = state.pending
    var index = pending.index
    var actor = pending.actor
    var parent = pending.parent
    var time = pending.time
    var action = pending.action
    var id = pending.id
    var mind = pending.mind
    var model = pending.model
    var action_event = pending.action_event
    var ledger = pending.ledger
    var quote = pending.quote
    let choice = pending.choice
    dv_require(receipt.action_event == action_event, "Completion belongs to another action")
    var before = physical
    var result = false
    dv_require(receipt.actual.time == pending.model.actual.time, "Scheduled receipt duration differs from declared duration")
    model = dv_with(model, "actual", receipt.actual)
    parent = dvs_event(events, "host_completion", id, time, dv_single(parent), receipt)
    var local_2 = false
    var local_3 = false
    if dv_has_key(action, "speech"):
        local_3 = dv_and(dvs_authority_speech_allowed(action, physical, id), (dvs_speech_truth(actor.mind, action.speech) == "true"))
    else:
        local_3 = true
    if dv_or((not (receipt.outcome == "applied")), (not dv_and((dv_truth(physical, dv_find(action, "authority_precondition", action.precondition)) == "true"), local_3))):
        local_2 = dv_action_cost_finish(ledger, physical, quote, model.actual, "rejected")
    else:
        if (dv_find(action, "law", "") == ""):
            local_2 = dv_action_cost_finish(ledger, physical, quote, model.actual, "applied")
        else:
            local_2 = dv_action_cost_execute(ledger, physical, quote, model.actual)
    result = local_2
    physical = result.execution.world
    time = dv_find(physical, "time", time)
    actor = dv_with(actor, "ledger", result.ledger)
    parent = dvs_event_prepared(events, "action_execution", id, time, dv_single(parent), dv_with_many({"revision_before": before.revision, "revision_after": physical.revision, "physical_before": before, "physical_after": physical, "receipt": result, "action": action}, {"ledger_before": ledger, "ledger_after": result.ledger, "quote": quote, "actual": model.actual}))
    let execution_event = parent
    physical = dvs_environment(physical, story, events, parent)
    if (result.execution.status == "applied"):
        actor = dvs_record_request(dvs_finish_reply(dv_with(actor, "last_action_event", parent), action), action)
        if action.kind == "move":
            let selected_path = dv_find(choice, "selected_path", [])
            if 1 < rt_count(selected_path):
                let followup = dvp_find_action(actor.actions, selected_path[1])
                if followup != false and followup.kind != "move":
                    actor = dv_with(actor, "planned_followup", followup.id)
    rt_print(rt_json_stringify(dv_with({"event_id": parent, "actor": id, "action_id": action.id, "game_time": time}, "status", result.execution.status)))
    var local_4 = false
    var observation_grants = []
    if (result.execution.status == "applied"):
        observation_grants = dv_find(action, "grants", [])
    else:
        // Only the formal adapter's logical position establishes this site.
        // Native geometry may already have reached the destination while the
        // rejected DV transition retains its origin; that origin proves no contact.
        if dv_find(receipt, "executor", "") == "formal-model" and receipt.outcome == "applied" and dv_truth(physical, dv_find(action, "failure_observe_when", dv_not(dv_true()))) == "true":
            observation_grants = dv_find(action, "failure_grants", [])
    local_4 = dvs_observation_source(dv_perceive(physical, mind, bindings, observation_grants, action_event, time), action)
    var observations = local_4
    var profile = dvs_observation_profile(actor)
    actor = dv_with(actor, "mind", dv_update_mind(mind, observations, mind.revision, profile).world)
    if (0 < rt_count(observations)):
        parent = dvs_event_prepared(events, "observation", id, time, dvs_cognitive_parents(actor, dv_single(parent)), dv_with_many({"observations": observations, "revision_before": mind.revision, "revision_after": actor.mind.revision, "mind_before": mind, "mind_after": actor.mind, "action": action}, {"bindings": bindings, "grants": observation_grants, "execution_id": action_event}))
    if (0 < rt_count(observations)):
        actor = dv_with(actor, "last_cognitive_event", parent)
    actor = dvs_complete_cognitive_effects(actor, action, result.execution.status == "applied", execution_event, time)
    actor = dvs_complete_norm(actor, action, result.execution.status == "applied", events, time, execution_event, parent)
    actor = dvs_complete_player_influences(actor, action, before, physical, result.execution.status == "applied", execution_event, time)
    if dv_and(dv_has_key(action, "answer"), (result.execution.status == "applied")):
        var judgment = dvs_answer(dv_find(story, "formal_answers", []), action, physical, actor.mind, bindings, events)
        var stage = ""
        var new_level = 0
        var current_level_cell = false
        var current_level = 0
        var is_higher = false
        parent = dvs_event(events, "answer_submitted", id, time, dv_single(parent), {"action": action, "mind_revision": actor.mind.revision, "physical_revision": physical.revision, "mind": actor.mind, "physical": physical, "personal_accepted_answers": dv_find(actor, "accepted_answers", [])})
        stage = judgment.stage
        new_level = judgment.truth_level
        current_level_cell = dv_unknown()
        if (not (judgment.progress_ref == false)):
            current_level_cell = dv_read(physical, judgment.progress_ref)
        var local_5 = false
        if current_level_cell.known:
            local_5 = current_level_cell.value
        else:
            local_5 = 0
        current_level = local_5
        is_higher = (dv_find(dv_find(actor, "accepted_answers", []), stage, 0) < new_level)
        if dv_and(judgment.accepted, (not is_higher)):
            judgment = dv_with_many(judgment, {"accepted": false, "reason": "already-accepted-personal-answer"})
        else:
            judgment = dv_with(judgment, "accepted", dv_and(judgment.accepted, is_higher))
        var local_6 = false
        if judgment.accepted:
            local_6 = "answer_accepted"
        else:
            local_6 = "answer_rejected"
        parent = dvs_event(events, local_6, id, time, dv_single(parent), judgment)
        if dv_and(judgment.accepted, (not (judgment.accepted_law == ""))):
            var transition = dv_execute(physical, judgment.accepted_law, rt_cat(action_event, "-accepted"), time, physical.revision)
            if (transition.status == "applied"):
                physical = transition.world
                var local_7 = false
                if (current_level < new_level):
                    local_7 = new_level
                else:
                    local_7 = current_level
                physical = dv_store(physical, judgment.progress_ref, dv_field(local_7))
                physical = dv_store(physical, judgment.completion_ref, dv_field(true))
                actor = dv_with(actor, "accepted_answers", dv_with(dv_find(actor, "accepted_answers", []), stage, new_level))
                parent = dvs_event(events, "question_transition", id, time, dv_single(parent), transition)
                actors = dvs_replace(actors, index, actor)
                actors = dvs_public_grants(actors, index, dv_with_many(action, {"speech": {"channel": "formal-receipt", "literal_ast": dv_true()}, "listeners": judgment.accepted_listeners, "public_grants": judgment.accepted_public_grants}), physical, bindings, events, time, parent, rt_cat(action_event, "-accepted"))
                actor = actors[index]
    if dv_and((action.kind == "replay"), (result.execution.status == "applied")):
        var candidates = dv_find(actor.policy, "hypotheses", [])
        var k = 0
        var simulations = dv_find(actor, "simulations", [])
        var coverages = []
        var factor_rejections = []
        actor = dv_with_many(actor, {"model_paid_event": parent, "policy": dv_with(actor.policy, "model_work_remaining", dv_find(model, "work_limit", 0))})
        if (0 < rt_count(dv_find(actor.policy, "factor_constraints", []))):
            var prune = dvs_factor_prune(actor, events, time, parent)
            var certificates = []
            var c = 0
            while (c < rt_count(prune.certificates)):
                rt_push(certificates, dv_with(prune.certificates[c], "event", prune.event))
                c = (c + 1)
            actor = dv_with_many(actor, {"factor_certificates": certificates, "model_previous_event": prune.event, "last_cognitive_event": prune.event, "policy": dv_with_many(actor.policy, {"model_budget": prune.remaining, "model_work_remaining": prune.work_remaining})})
        while (k < rt_count(candidates)):
            var candidate = candidates[k]
            var coverage_key = rt_cat(dv_find(candidates[k], "question", dv_find(candidates[k], "topic", "")), dv_find(candidates[k], "group", ""))
            if dv_has_key(coverages, coverage_key):
                false
            else:
                coverages = dv_with(coverages, coverage_key, dvs_factor_coverage(actor, candidate, events))
            if dv_and(dvp_topic(actor, candidate), dv_and((0 < rt_count(dv_find(candidate, "basis", []))), (dv_truth(actor.mind, dv_find(candidate, "available_when", dv_true())) == "true"))):
                if dvs_factor_covered(candidate, dv_get(coverages, coverage_key).certificates):
                    rt_push(factor_rejections, candidate.id)
                else:
                    if (dvs_sim_work_budget(actor) < 1):
                        k = rt_count(candidates)
                    else:
                        var cached = dv_find(simulations, candidate.id, false)
                        var simulation = false
                        var local_8 = false
                        if (cached == false):
                            local_8 = dvs_model(actor, candidate, events, time, parent)
                        else:
                            var recheck = dvs_model_recheck(actor, cached)
                            dvs_event(events, "model_recheck", id, time, dvs_model_parent_ids(actor, parent, dv_find(cached, "event", "")), {"actor_before": actor, "actor_id": actor.id, "actor_revision": actor.mind.revision, "model_before": cached, "hypothesis": candidate, "result": recheck})
                            local_8 = recheck
                        simulation = local_8
                        simulation = dv_with_many(simulation, {"validation_inputs": dv_explanation_merge(dv_explanation_model_inputs(actor.mind, simulation), dvs_model_observed_inputs(simulation)), "source_adoptions": actor.mind.adoptions, "source_response_models": dv_find(actor, "response_models", [])})
                        simulations = dv_with(simulations, candidate.id, dv_with_many(simulation, {"event": events[(rt_count(events) - 1)].id, "source_revision": actor.mind.revision}))
                        actor = dv_with_many(actor, {"model_previous_event": events[(rt_count(events) - 1)].id, "last_cognitive_event": events[(rt_count(events) - 1)].id, "policy": dv_with_many(actor.policy, {"model_budget": simulation.remaining, "model_work_remaining": simulation.work_remaining})})
            k = (k + 1)
        actor = dv_with_many(actor, {"simulations": simulations, "factor_rejections": {"source_revision": actor.mind.revision, "ids": factor_rejections}})
    if dv_has_key(actor, "location_ref"):
        var cell = dv_read(physical, actor.location_ref)
        if cell.known:
            actor = dv_with(actor, "location", cell.value)
    if dv_has_key(action, "answer"):
        actor = dv_with(actor, "answer_attempt_signatures", dv_with(dv_find(actor, "answer_attempt_signatures", []), action.id, dvp_input_signature(actor, action, choice.relevant_refs)))
    if (action.kind == "replay"):
        actor = dv_with(actor, "replay_attempt_signatures", dv_with(dv_find(actor, "replay_attempt_signatures", []), action.id, dvp_input_signature(actor, action, choice.relevant_refs)))
    if action.kind == "inspect" and result.execution.status == "applied":
        actor = dv_with(actor, "inspection_attempt_signatures", dv_with(dv_find(actor, "inspection_attempt_signatures", []), action.id, dvp_inspection_signature(actor, action, actor.mind)))
    if result.execution.status != "applied":
        actor = dv_with(actor, "rejected_attempt_signatures", dv_with(dv_find(actor, "rejected_attempt_signatures", []), action.id, dvp_rejected_signature(actor, action, actor.mind)))
    else:
        actor = dv_with(actor, "rejected_attempt_signatures", dv_with(dv_find(actor, "rejected_attempt_signatures", []), action.id, false))
    actor = dv_with(actor, "attempts", dv_with(dv_find(actor, "attempts", []), action.id, actor.mind.revision))
    if result.execution.status == "applied":
        actor = dv_with(actor, "completed_actions", dv_append(dv_find(actor, "completed_actions", []), action.id))
    actor = dv_with_many(actor, {"used": dv_append(dv_find(actor, "used", []), action.id), "policy": dv_with(actor.policy, "budget", (actor.policy.budget - 1))})
    actors = dvs_replace(actors, index, actor)
    if dv_and(dv_has_key(action, "public_observers"), (result.execution.status == "applied")):
        actors = dvs_visible_action_grants(actors, index, action, before, physical, bindings, events, time, parent, action_event)
    if dv_and(dv_has_key(action, "speech"), (result.execution.status == "applied")):
        // This actual execution boundary supplies player identity, never a forecast.
        var actual_player = ""
        if id == dv_find(state, "player_actor", ""):
            actual_player = id
        action = dv_with(action, "speech", dv_with_many(action.speech, {"actual_player_actor": actual_player, "actual_literal_truth": dv_truth(physical, action.speech.literal_ast)}))
        actors = dvs_speech_owned(actors, index, action, events, time, parent, physical)
        actors = dvs_public_grants(actors, index, action, physical, bindings, events, time, parent, action_event)
    actor = actors[index]
    executed = (executed + 1)
    idle = 0
    actors = dvs_replace(actors, index, actor)
    return {"player_actor": dv_find(state, "player_actor", ""), "story": story, "physical": physical, "actors": actors, "events": events, "bindings": bindings, "costs": costs, "run_start": run_start, "duration_budget": duration_budget, "horizon": horizon, "duration_blocked": duration_blocked, "limit": limit, "cursor": cursor, "executed": executed, "idle": idle, "status": status, "initial": initial, "awaiting_player": false, "player_selection": ""}

fn dvs_session_close(state):
    let story = state.story
    var physical = state.physical
    var actors = state.actors
    var events = state.events
    var bindings = state.bindings
    var costs = state.costs
    var run_start = state.run_start
    var duration_budget = state.duration_budget
    var horizon = state.horizon
    var duration_blocked = state.duration_blocked
    var limit = state.limit
    var cursor = state.cursor
    var executed = state.executed
    var idle = state.idle
    var status = state.status
    var initial = state.initial
    if (not (idle < rt_count(actors))):
        var local_9 = false
        if duration_blocked:
            local_9 = "budget-exhausted"
        else:
            local_9 = "no-admissible-action-or-budget"
        status = local_9
    if (not (dv_find(physical, "time", 0) < horizon)):
        status = "budget-exhausted"
    if dvs_session_active(state):
        status = "host-closed-during-active-session"
    dvs_event(events, "session_stopped", "", dv_find(physical, "time", 0), dv_single(events[(rt_count(events) - 1)].id), {"reason": status, "actions_executed": executed})
    rt_print(rt_json_stringify({"type": "session_stopped", "status": status, "game_time": dv_find(physical, "time", 0)}))
    return {"events": events, "initial": initial, "final": {"physical": physical, "actors": actors}, "status": status, "time": dv_find(physical, "time", 0), "game_time_unit": "minute", "configuration": {"cost_model": costs, "formal_answers": dv_find(story, "formal_answers", []), "source_refs": dv_find(story, "source_refs", []), "time_origin": {"run_start": run_start, "duration_budget": duration_budget, "horizon": horizon, "unit": "minute"}, "report_labels": dv_find(story, "report_labels", []), "bindings": bindings}, "scope": dv_find(story, "execution_scope", "DV formal model; no Godot host input or geometry")}

fn dvs_replace(items, index, value):
    var result = []
    var i = 0
    while (i < rt_count(items)):
        var local_1 = false
        if (i == index):
            local_1 = value
        else:
            local_1 = items[i]
        rt_push(result, local_1)
        i = (i + 1)
    return result

fn dvs_main():
    var story = rt_json_parse(rt_read(rt_arg(0)))
    var local_1 = false
    if (2 < rt_arg_count()):
        local_1 = rt_arg(2)
    else:
        local_1 = "enabled"
    var capability = local_1
    return rt_write(rt_arg(1), rt_json_stringify(dvs_run(story, capability)))

fn dvs_public_grants(actors, speaker_index, action, physical, bindings, events, time, parent, execution_id):
    var result = actors
    var speaker = actors[speaker_index]
    var listeners = dv_find(action, "listeners", [])
    var grants = dv_find(action, "public_grants", [])
    if rt_count(listeners) == 0 or rt_count(grants) == 0:
        return actors
    let projection = dvs_public_projection_inputs(events, execution_id)
    dv_require(not projection.repeated, "Repeated public grant projection")
    dvs_event(events, "public_grants_projection", speaker.id, time, dv_single(parent), {"execution_id": execution_id, "action_id": action.id, "already_projected": projection.sources})
    var i = 0
    while (i < rt_count(actors)):
        var actor = result[i]
        var mind = result[i].mind
        if dv_and(dv_has(listeners, actor.id), dvs_speech_hearing(speaker, actor, action.speech, physical)):
            var grants = dv_find(action, "public_grants", [])
            var projected = dv_perceive(physical, mind, bindings, dv_find(action, "public_grants", []), execution_id, time)
            var observations = dvs_public_filter_projected(projected, dv_find(projection.by_subject, actor.id, []))
            if (0 < rt_count(observations)):
                var actual_grants = []
                var g = 0
                while g < rt_count(grants):
                    let local_ref = dv_scoped_ref(actor.id, dv_local(bindings, grants[g].object, actor.id), grants[g].facet, grants[g].field)
                    var o = 0
                    var included = false
                    while o < rt_count(observations):
                        if dv_same(local_ref, observations[o].ref):
                            included = true
                        o = o + 1
                    if included:
                        rt_push(actual_grants, grants[g])
                    g = g + 1
                var next = dv_update_mind(mind, observations, mind.revision, dvs_observation_profile(actor)).world
                var observation_event = ""
                observation_event = dvs_event_prepared(events, "observation", actor.id, time, dvs_cognitive_parents(actor, dvs_public_grant_parents(events, parent, actor.id)), dv_with_many({"observations": observations, "revision_before": mind.revision, "revision_after": next.revision, "mind_before": mind, "mind_after": next, "action": action}, {"bindings": bindings, "grants": actual_grants, "declared_grants": grants, "execution_id": execution_id, "source_event": dvs_public_literal_source(events, parent, actor.id)}))
                result = dvs_replace(result, i, dv_with_many(actor, {"mind": next, "last_cognitive_event": observation_event}))
        i = (i + 1)
    return result

// Union authorizations within one real execution, using published observations
// as evidence of contact. Never filter the mind's generic seen list: unrelated
// or repeated invocations must still fail their normal duplicate checks.
fn dvs_public_projection_inputs(events, execution_id):
    var by_subject = []
    var sources = []
    var repeated = false
    var i = rt_count(events) - 1
    var scanning = true
    while i >= 0 and scanning:
        let event = events[i]
        if event.type == "public_grants_projection":
            if dv_same(event.data.execution_id, execution_id):
                repeated = true
        if event.type == "observation" and dv_same(dv_find(event.data, "execution_id", false), execution_id):
            let observations = dv_find(event.data, "observations", [])
            var j = 0
            var existing = dv_find(by_subject, event.actor, [])
            while j < rt_count(observations):
                rt_push(existing, observations[j].id)
                rt_push(sources, {"event": event.id, "subject": event.actor, "ref": observations[j].ref, "observation_id": observations[j].id})
                j = j + 1
            by_subject = dv_with(by_subject, event.actor, existing)
        if event.type == "action_execution":
            scanning = false
        i = i - 1
    return {"by_subject": by_subject, "sources": sources, "repeated": repeated}

fn dvs_public_filter_projected(projected, existing):
    var result = []
    var i = 0
    while i < rt_count(projected):
        if not dv_has(existing, projected[i].id):
            rt_push(result, projected[i])
        i = i + 1
    return result

fn dvs_observation_source(observations, action):
    var result = []
    var i = 0
    var source = dv_find(action, "observation_source", "perception")
    var origin = dv_find(action, "observation_origin", "direct")
    var trust = dv_find(action, "observation_trust", 1)
    dv_require(dv_has(dv_list3("perception", "testimony", "recall"), source), "Unknown observation source")
    dv_unit(trust)
    while (i < rt_count(observations)):
        let observation = observations[i]
        var mapped = dv_with_many(observation, {"source": source, "origin": origin, "trust": trust})
        let overrides = dv_find(action, "grant_observation_sources", [])
        var j = 0
        while (j < rt_count(overrides)):
            let entry = overrides[j]
            if dv_same_local_ref(observation.subject, entry.ref, observation.ref):
                mapped = dv_with_many(mapped, {"source": entry.source, "origin": entry.origin, "trust": entry.trust})
            j = j + 1
        rt_push(result, mapped)
        i = (i + 1)
    return result

fn dvs_observation_profile(actor):
    return dv_observation_profile(dv_find(actor.policy, "observation_weights", {"perception": 1, "testimony": 1, "recall": 1}), dv_find(actor.policy, "observation_threshold", 0.5))

// Linear host-state transfer only. The caller relinquishes the previous state.
// Keep persistent world/mind/prediction updates on their independent-copy APIs.
fn dvs_owned_state_update(state, updates):
    var result = []
    var keys = []
    var i = 0
    while i < rt_count(state):
        let key = state[i][0]
        rt_push(result, dv_pair(key, dv_find(updates, key, state[i][1])))
        rt_push(keys, key)
        i = i + 1
    i = 0
    while i < rt_count(updates):
        let key = updates[i][0]
        if not dv_has(keys, key):
            rt_push(result, dv_pair(key, updates[i][1]))
            rt_push(keys, key)
        i = i + 1
    return result

// ---- Merged source module: 32-environment.dv ----
// Physical processes read physical conditions. They never publish private knowledge.
fn dvs_environment(physical, story, events, parent):
    var world = physical
    let time = dv_find(world, "time", 0)
    let clock = dv_find(story, "clock_ref", false)
    if clock != false:
        world = dv_store(world, clock, dv_cell(time, 1, time, [parent]))
    let processes = dv_find(story, "world_processes", [])
    var i = 0
    while i < rt_count(processes):
        let process = processes[i]
        let adoption = dv_get(world.adoptions, process.law)
        if adoption.active and adoption.mode == "enforce" and dv_truth(world, adoption.law.premise) == "true":
            let staged = dv_stage(world, adoption.law.effects, time, adoption.basis, adoption.confidence)
            var changed = false
            var j = 0
            while j < rt_count(staged.changes):
                let change = staged.changes[j]
                if not dv_same(dvs_reason_value(change.before), dvs_reason_value(change.after)):
                    changed = true
                j = j + 1
            if staged.status == "ready" and changed:
                let id = rt_cat("environment-", rt_show(rt_count(events)))
                let before = world
                let execution = dv_execute(world, process.law, id, time, world.revision)
                world = execution.world
                if execution.status == "applied" and dv_find(process, "once", false):
                    world = dv_suspend(world, process.law)
                parent = dvs_event(events, "physical_process", "", time, [parent], {"process": process, "revision_before": before.revision, "revision_after": world.revision, "suspended": not dv_get(world.adoptions, process.law).active, "execution": dv_without(execution, "world")})
        i = i + 1
    return world

// Match the old minute lattice, including a fractional action completion.
fn dvs_environment_boundary(condition, clock, now, due):
    let op = condition.op
    if op == "constant":
        return due
    if op == "not":
        return dvs_environment_boundary(condition.item, clock, now, due)
    if op == "all":
        var next = due
        var i = 0
        while i < rt_count(condition.items):
            next = dv_min(next, dvs_environment_boundary(condition.items[i], clock, now, due))
            i = i + 1
        return next
    if not dv_same(condition.ref, clock):
        return due
    if op != "at_least" or not rt_is_numeric_value(condition.value):
        return dv_min(due, now + 1)
    // A distant bound cannot be crossed in this wait: do not count toward it.
    if due < condition.value:
        return due
    if now < condition.value:
        let delta = condition.value - now
        var steps = 1
        while steps < delta:
            steps = steps + 1
        return dv_min(due, now + steps)
    return due

// A process that can still change the world requires another ordinary minute.
// This retains repeated increments, conflicting writes and ordered cascades.
fn dvs_environment_next_time(world, story, due):
    let clock = dv_find(story, "clock_ref", false)
    let now = world.time
    var next = due
    let processes = dv_find(story, "world_processes", [])
    var i = 0
    while i < rt_count(processes):
        let adoption = dv_get(world.adoptions, processes[i].law)
        if adoption.active and adoption.mode == "enforce":
            next = dv_min(next, dvs_environment_boundary(adoption.law.premise, clock, now, due))
            if dv_truth(world, adoption.law.premise) == "true":
                let staged = dv_stage(world, adoption.law.effects, now, adoption.basis, adoption.confidence)
                var j = 0
                while j < rt_count(staged.changes):
                    let change = staged.changes[j]
                    if dv_same(change.ref, clock) or not dv_same(dvs_reason_value(change.before), dvs_reason_value(change.after)):
                        return dv_min(due, now + 1)
                    j = j + 1
        i = i + 1
    return next

// ---- Merged source module: 40-host.dv ----
// Host commands contain an action and its execution contract, never a mind or oracle.
fn dvs_present_replace(text, token, value):
    var result = ""
    var i = 0
    while i < rt_length(text):
        if i + rt_length(token) <= rt_length(text) and rt_slice(text, i, rt_length(token)) == token:
            result = rt_cat(result, value)
            i = i + rt_length(token)
        else:
            result = rt_cat(result, rt_chr(text, i))
            i = i + 1
    return result

fn dvs_present_lines(state, viewer, presentation):
    if rt_count(dv_find(presentation, "lines", [])) == 0:
        return []
    var mind = false
    var i = 0
    while i < rt_count(state.actors):
        if state.actors[i].id == viewer:
            mind = state.actors[i].mind
        i = i + 1
    var result = []
    if mind == false:
        return result
    let lines = dv_find(presentation, "lines", [])
    i = 0
    while i < rt_count(lines):
        let line = lines[i]
        var visible = dv_truth(mind, dv_find(line, "when", dv_true())) == "true"
        var text = line.template
        let bindings = dv_find(line, "bindings", [])
        var j = 0
        while visible and j < rt_count(bindings):
            let binding = bindings[j]
            let cell = dv_read(mind, binding.ref)
            if dv_uncontested(cell):
                let value = rt_show(cell.value)
                let display = dv_find(dv_find(binding, "labels", []), value, value)
                text = dvs_present_replace(text, rt_cat("{", rt_cat(binding.name, "}")), display)
            else:
                visible = false
            j = j + 1
        if visible:
            rt_push(result, text)
        i = i + 1
    return result

fn dvs_session_intent(state):
    let pending = dv_find(state, "pending", false)
    if pending == false:
        if dv_find(state, "awaiting_player", false):
            return {"status": "awaiting_input", "active": true, "game_time": state.physical.time, "options": dvs_player_options(state.actors[state.cursor])}
        return {"status": "idle", "active": dvs_session_active(state), "game_time": state.physical.time}
    return {"status": "prepared", "actor": pending.id, "action_event": pending.action_event, "action": pending.action, "bounds": pending.quote.bounds, "execution_cost": pending.model.actual, "game_time": pending.time}

fn dvs_session_presentation(state, viewer):
    var i = rt_count(state.events) - 1
    var perceived = false
    var heard = false
    var judgment = false
    while 0 <= i:
        let event = state.events[i]
        if event.actor == viewer and (event.type == "answer_accepted" or event.type == "answer_rejected"):
            judgment = {"status": event.type, "event_id": event.id, "game_time": event.time}
        if event.actor == viewer and (event.type == "listener_parse" or event.type == "observation"):
            perceived = true
        if event.actor == viewer and (event.type == "listener_parse" or event.type == "speech_received_pending"):
            heard = true
        if event.type == "action_execution":
            let action = event.data.action
            let applied = event.data.receipt.execution.status == "applied"
            let visible = event.actor == viewer or (heard or (perceived and not dv_has_key(action, "speech")))
            var surface = ""
            var presentation = []
            if applied and visible:
                surface = dv_find(action, "surface", dv_find(dv_find(action, "speech", []), "surface", ""))
                presentation = dv_find(action, "presentation", [])
            var voice = "narration"
            if dv_has_key(action, "speech"):
                voice = "dialogue"
            let surface_voice = voice
            voice = dv_find(presentation, "voice", voice)
            return {"status": event.data.receipt.execution.status, "actor": event.actor, "action_id": action.id, "action_kind": action.kind, "execution_event": event.id, "voice": voice, "surface_voice": surface_voice, "game_time": event.time, "visible": applied and visible, "surface": surface, "lines": dvs_present_lines(state, viewer, presentation), "judgment": judgment}
        i = i - 1
    return {"status": "idle", "game_time": state.physical.time}

// Human choice uses the same subject-local admission and the same prepared receipt.
fn dvs_set_player(state, actor):
    dv_require(not dv_has_key(state, "pending"), "Cannot change controller during execution")
    return dvs_control_state(state, state.actors, state.events, state.cursor, actor, "", false)

fn dvs_control_state(state, actors, events, cursor, player, selection, waiting):
    return {"story": state.story, "physical": state.physical, "actors": actors, "events": events, "bindings": state.bindings, "costs": state.costs, "run_start": state.run_start, "duration_budget": state.duration_budget, "horizon": state.horizon, "duration_blocked": state.duration_blocked, "limit": state.limit, "cursor": cursor, "executed": state.executed, "idle": state.idle, "status": state.status, "initial": state.initial, "player_actor": player, "player_selection": selection, "awaiting_player": waiting}

fn dvs_player_options(actor):
    var result = []
    let refs = dvp_goal_refs(actor)
    var i = 0
    while i < rt_count(actor.actions):
        let action = actor.actions[i]
        if dvp_eligible(actor, action, actor.mind, refs):
            let label = dv_find(action, "label", dv_find(action, "surface", dv_find(dv_find(action, "speech", []), "surface", "")))
            if label != "":
                rt_push(result, {"id": action.id, "label": label, "available": true})
        i = i + 1
    return result

fn dvs_select_player(state, id):
    dv_require(dv_find(state, "awaiting_player", false), "Player input is not currently requested")
    let actor = state.actors[state.cursor]
    let action = dvp_find_action(actor.actions, id)
    dv_require(action != false, "Unknown player action")
    dv_require(dvp_eligible(actor, action, actor.mind, dvp_goal_refs(actor)), "Player action is no longer available")
    return dvs_control_state(state, state.actors, state.events, state.cursor, dv_find(state, "player_actor", ""), id, false)

fn dvs_player_choice(actor, id):
    let action = dvp_find_action(actor.actions, id)
    dv_require(action != false and dvp_eligible(actor, action, actor.mind, dvp_goal_refs(actor)), "Player action failed subject admission")
    return {"action": action, "score": 0, "plan_expansions": 0, "plans": [], "relevant_refs": dvp_goal_refs(actor), "dependency_cache": dv_find(actor, "dependency_cache", false), "controller": "player"}

// Native chapter authorship: named worlds, characters, actions and structured speech.
// Old .story files are read-only provenance. This module never parses their serialized format.
// These authority conclusions are frozen authored history, never grants or mind initial facts.
// In particular familiar is a source scenario truth; the person's inference remains evidence-weighted.
// Truth, personally supported claim, topic relevance and actual shown evidence are independent axes.
// In particular a true location or a bare trust/familiarity claim does not answer the current question.
// Preserve both original lawful showings: E8 plus executed trial, or the E5 hollow-frame evidence.
// E2 or E9/E10 may show the motive; the full reason remains personally supported.
// Speech candidates share the one actual opening transition. Every fragment uses original words.

fn c1_source(path, line, id):
    return {"path": path, "line": line, "id": id}

fn c1_knowledge(atom):
    return dv_ref("cognition", "state", atom)

fn c1_at(actor, room):
    return dv_fact(dv_ref(actor, "state", "location"), room)

fn c1_local_object(id):
    return dv_object(id, "perceived", {"state": [], "identity": []})

fn c1_state_object(id, fields):
    return dv_object(id, "physical", {"state": fields, "identity": []})

fn c1_action(id, kind, known, physical, law, grants, source):
    return dv_with(dv_with(dv_with({"id": id, "kind": kind, "precondition": known, "authority_precondition": physical}, "law", law), "grants", grants), "source_refs", dv_single(source))

fn c1_public_methods(actions):
    var result = []
    var n = 0
    while (n < rt_count(actions)):
        rt_push(result, c1_public_method(actions[n]))
        n = (n + 1)
    return result

fn c1_public_method(action):
    var method = dv_with(dv_with(action, "purpose_refs", dv_find(action, "purpose_refs", action.grants)), "purpose_basis", action.source_refs)
    var kind = action.kind
    if (kind == "answer"):
        return c1_public_answer_speech(dv_with(method, "topic", dv_find(action, "topic", c1_answer_topic(action.answer_id))))
    else:
        if dv_or((kind == "move"), (kind == "replay")):
            if (not dv_find(action, "once", false)):
                return dv_with(method, "repeatable", true)
            return method
        else:
            return method

fn c1_answer_topic(id):
    if (id == "me"):
        return "identity"
    else:
        if dv_or((id == "V3_0"), (id == "V3_1")):
            return "voice_source"
        else:
            if dv_or((id == "V4_0"), (id == "V4_1")):
                return "words"
            else:
                if (id == "trust"):
                    return "trust"
                else:
                    return "auxiliary"

fn c1_once(action):
    return dv_with(action, "once", true)

fn c1_observe_as(action, source, origin, trust):
    var result = dv_with(dv_with(dv_with(action, "observation_source", source), "observation_origin", origin), "observation_trust", trust)
    if dv_and((source == "testimony"), (not (origin == "demon"))):
        return c1_personal_request(result, origin)
    else:
        return result

fn c1_query_basis(atom):
    if dv_or((atom == "slate_code"), dv_or((atom == "slate_person"), (atom == "recalled_copper"))):
        return c1_statement("slate_marks")
    else:
        if (atom == "frame_hollow"):
            return c1_statement("fork_dent")
        else:
            if (atom == "cups_known"):
                return c1_statement("cups_preferences")
            else:
                if dv_or((atom == "starter_kept"), (atom == "recalled_names")):
                    return c1_statement("starter_layers")
                else:
                    if (atom == "heads_lost"):
                        return dv_fact(dv_ref("ritual", "state", "sound_trial_done"), true)
                    else:
                        return dv_true()

