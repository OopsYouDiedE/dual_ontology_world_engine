                dvs_event(events, "public_topic_heard", actor.id, time, dv_explanation_merge(dv_single(parent), sources), record)
                heard = dv_with(heard, topic, record)
        i = (i + 1)
    return dvs_capture_heard_utterances(dv_with(actor, "heard_topics", heard), events)

fn dvs_topic_was_heard(actor, topic):
