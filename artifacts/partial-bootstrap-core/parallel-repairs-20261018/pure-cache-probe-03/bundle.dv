        {"id": "ward_night", "owner": "ward", "board": "central_hall", "surface": "夜间取用公物先登记，次日共同核对记录。", "promotes": ["restriction", "ward_authority"], "sacrifices": ["not_targeted", "movement_freedom"], "mode": "forbid", "method": "unrecorded_take", "source": c2_approved("第五部分：WardNight当前公约提案")},
        {"id": "mora_night", "owner": "mora", "board": "logistics", "surface": "病者伤者优先。夜间照护或饥饿急需可取一份，次日告知。", "promotes": ["patient_priority", "night_exception"], "sacrifices": ["no_exception"], "mode": "permit", "method": "unrecorded_take", "source": c2_approved("第五部分：MoraNight当前公约提案")},
        {"id": "ruan_ledger", "owner": "ruan", "board": "logistics", "surface": "每日按人头分配，日末清点。", "promotes": ["per_person", "records"], "sacrifices": [], "mode": "prefer", "method": "collect_and_count", "source": c2_source("03_规矩与结局.story", 59, "RuanLedger")},
        {"id": "shen_kitchen", "owner": "shen", "board": "hall", "surface": "粮仓钥匙交给做饭的人，统一煮粥，先喂饿着的人。", "promotes": ["central_cooking", "patient_priority", "records"], "sacrifices": [], "mode": "prefer", "method": "cook_and_feed", "source": c2_source("03_规矩与结局.story", 113, "ShenKitchen")},
        {"id": "veronica_evidence", "owner": "veronica", "board": "lecture", "surface": "指控须有实物为证；取用须有记录。", "promotes": ["evidence", "records"], "sacrifices": [], "mode": "forbid", "method": "unsupported_accusation", "source": c2_source("03_规矩与结局.story", 127, "VeronicaEvidence")},
        {"id": "lucian_no_brand", "owner": "lucian", "board": "lecture", "surface": "未经查验，不得以“私取”之名限制任何人行走。", "promotes": ["evidence", "not_targeted", "movement_freedom", "night_exception"], "sacrifices": ["restriction"], "mode": "forbid", "method": "unverified_restriction", "source": c2_source("03_规矩与结局.story", 141, "LucianNoBrand")},
        {"id": "open_plan", "owner": "huo", "board": "central_hall", "surface": "外出前核对源质计与风向，按安全读数安排劳作，约定返程与停行条件。", "promotes": ["measured_work"], "sacrifices": ["cautious_travel", "committee"], "mode": "permit", "method": "measured_outing", "source": c2_approved("第五部分：OpenPlan当前公约提案")},
        {"id": "seal_plan", "owner": "gu", "board": "central_hall", "surface": "读数不明、风止或地震之后，先留在安全处，复测后再定行程。", "promotes": ["cautious_travel", "tradition"], "sacrifices": ["measured_work"], "mode": "forbid", "method": "outdoor_travel", "source": c2_approved("第五部分：SealPlan当前公约提案")},
        {"id": "committee_plan", "owner": "ward", "board": "central_hall", "surface": "公用粮水药逐项登记，列明取用、补记和结余，供众人核对。", "promotes": ["committee", "ward_authority", "records"], "sacrifices": ["measured_work"], "mode": "require", "method": "collect_and_count", "source": c2_approved("第五部分：CommitteePlan当前公约提案")}]

fn c2_norm_object(id):
    return rt_cat("c2.norm.", id)

fn c2_alive(actor):
    if actor == "demon":
        return dv_true()
    return dv_fact(c2_own(actor, "alive"), true)

fn c2_object(id, room, fields):
    return dv_with(c1_state_object(id, fields), "location", room)

fn c2_initial_body(actor):
    var fields = {"alive": dv_field(true), "rations": dv_field(0), "consumed": dv_field(0), "hungry": dv_field(false), "owe_notes": dv_field(0), "pending_notes": dv_field(0), "busy_care": dv_field(false), "station": dv_field(""), "guard_commitment": dv_field(false), "guard_response_ready": dv_unknown(), "repair_requested": dv_field(false), "watched": dv_field(false), "night_taken": dv_field(false), "exposure_terminal": dv_unknown(), "reason_committed": dv_field(false), "norm_conflict_driven": dv_field(false), "fever": dv_unknown(), "day_sketch_exposed": dv_field(false), "evening_sketch_exposed": dv_field(false), "erosion_exposure": dv_field(0)}
    if actor == "moran":
        fields = dv_with(fields, "fever", dv_field(false))
    let norms = c2_norms()
    var i = 0
    while i < rt_count(norms):
        fields = dv_with(fields, rt_cat("read.", norms[i].id), dv_field(false))
        fields = dv_with(fields, rt_cat("accepted.", norms[i].id), dv_field(false))
        fields = dv_with(fields, rt_cat("decided.", norms[i].id), dv_field(false))
        i = i + 1
    var day = 2
    while day < 5:
        fields = dv_with(fields, rt_cat("collected.", rt_cat(rt_show(day), ".noon")), dv_field(false))
        fields = dv_with(fields, rt_cat("collected.", rt_cat(rt_show(day), ".evening")), dv_field(false))
        fields = dv_with(fields, rt_cat("eaten.", rt_cat(rt_show(day), ".noon")), dv_field(false))
        fields = dv_with(fields, rt_cat("eaten.", rt_cat(rt_show(day), ".evening")), dv_field(false))
        fields = dv_with(fields, rt_cat("hunger_checked.", rt_cat(rt_show(day), ".noon")), dv_field(false))
        fields = dv_with(fields, rt_cat("hunger_checked.", rt_cat(rt_show(day), ".evening")), dv_field(false))
        day = day + 1
    let roles = c2_profile(actor).station_roles
    fields = dv_with(fields, "can_structure", dv_field(actor == "margaret"))
    fields = dv_with(fields, "can_weight", dv_field(dv_has(roles, "weight")))
    fields = dv_with(fields, "can_lock", dv_field(dv_has(roles, "lock")))
    fields = dv_with(fields, "can_relay", dv_field(dv_has(roles, "relay")))
    return c2_object(c2_body(actor), "", fields)

fn c2_initial_body_from(actor, world):
    var body = c2_initial_body(actor)
    let fields = body.facets.state
    var i = 0
    while i < rt_count(fields):
        let field = fields[i][0]
        var prior = dv_read(world, dv_ref(actor, "body", field))
        if not dv_uncontested(prior):
            prior = dv_read(world, dv_ref(actor, "state", field))
        if dv_uncontested(prior):
            body = dv_with(body, "facets", dv_with(body.facets, "state", dv_with(body.facets.state, field, prior)))
        i = i + 1
    return body

fn c2_add_new(world, object):
    if dv_has_key(world.objects, object.id):
        return world
    return dv_add_object(world, object)

fn c2_world_objects(world):
    var result = world
    result = c2_add_new(result, c1_state_object("campaign.clock", {"minute": dv_field(dv_find(world, "time", 0))}))
    result = c2_add_new(result, c1_state_object("campaign.access", {"living": dv_field(true), "contract": dv_field(false), "astral": dv_field(false), "logistics": dv_field(false), "north": dv_field(false), "east": dv_field(false)}))
    if not dv_read(result, c2_access("living")).known:
        result = dv_store(result, c2_access("living"), dv_field(true))
    result = c2_add_new(result, c2_object("c2.corridor.north", "living_hall", {"air_safe": dv_field(false), "intake_safe": dv_field(false), "seal_intact": dv_field(true), "ventilated": dv_field(false)}))
    result = c2_add_new(result, c2_object("c2.corridor.east", "central_hall", {"air_safe": dv_field(false), "intake_safe": dv_field(false), "seal_intact": dv_field(true), "ventilated": dv_field(false)}))
    let corridor_gates = ["north", "east"]
    var gate_index = 0
    while gate_index < rt_count(corridor_gates):
        if not dv_read(result, c2_access(corridor_gates[gate_index])).known:
            result = dv_store(result, c2_access(corridor_gates[gate_index]), dv_field(false))
        gate_index = gate_index + 1
    result = c2_add_new(result, c2_object("c2.granary", "logistics", {"remaining": dv_unknown(), "locked": dv_field(true), "total_store_locked": dv_field(true), "latch_loose": dv_field(true), "structure_checked": dv_field(false), "wedge_set": dv_field(false), "lift_mm": dv_field(0), "double_bolts": dv_field(true), "reserve_added": dv_field(false), "tool_marks": dv_field(false), "key_owner": dv_unknown()}))
    result = c2_add_new(result, c2_object("c2.counter", "logistics", {"open": dv_field(false), "remaining": dv_field(99)}))
    result = c2_add_new(result, c2_object("c2.ledger", "logistics", {"removed": dv_field(0), "day_recorded": dv_field(0), "night_recorded": dv_field(0), "counted": dv_field(0), "reserve_received": dv_field(0), "supplement_column": dv_field(false), "pending_registered": dv_field(0)}))
    result = c2_add_new(result, c2_object("c2.bowl", "clinic", {"portions": dv_field(0), "residue": dv_field(false)}))
    result = c2_add_new(result, c2_object("c2.kitchen", "logistics", {"cooked": dv_field(false), "water": dv_unknown()}))
    result = c2_add_new(result, c2_object("c2.weather", "", {"phase": dv_field("falling_ash"), "ash_falling": dv_field(true), "wind": dv_unknown(), "daylight": dv_unknown(), "daylight_phase": dv_field("unclassified"), "earthquake_recent": dv_field(false), "severe_air": dv_field(true)}))
    if not dv_has_key(dv_get(result.objects, "c2.weather").facets.state, "daylight_phase"):
        result = dv_store(result, c2_ref("c2.weather", "daylight_phase"), dv_field("unclassified"))
    var i = 0
    let norms = c2_norms()
    while i < rt_count(norms):
        let norm = norms[i]
        result = c2_add_new(result, c2_object(c2_norm_object(norm.id), norm.board, {"owner": dv_field(norm.owner), "text": dv_field(norm.surface), "proposed": dv_field(false), "posted": dv_field(false)}))
        i = i + 1
    let people = c2_people()
    i = 0
    while i < rt_count(people):
        result = c2_add_new(result, c2_initial_body_from(people[i], world))
        result = c2_add_new(result, c2_object(rt_cat("c2.litter.", c2_profile(people[i]).group), rt_cat("dorm.", c2_profile(people[i]).group), {"crumbs": dv_field(0)}))
        i = i + 1
    result = c2i_world_objects(result)
    let changes = c2_weather_changes()
    i = 0
    while i < rt_count(changes):
        let ref = c2_ref("c2.weather", rt_cat("occurred.", changes[i].id))
        if not dv_read(result, ref).known:
            result = dv_store(result, ref, dv_field(false))
        i = i + 1
    return result

fn c2_action(id, kind, known, physical, law, grants, text, source):
    return dv_with(c1_action(id, kind, known, physical, law, grants, source), "surface", text)

axiom c2_move_law(actor, origin, target, gate):
    var conditions = [c2_at(actor, origin), dv_fact(c2_access(gate), true)]
    if actor != "demon":
        rt_push(conditions, dv_fact(c2_own(actor, "station"), ""))
        rt_push(conditions, dv_fact(c2_own(actor, "busy_care"), false))
        rt_push(conditions, c2_alive(actor))
    let groups = ["contract", "astral", "logistics"]
    var i = 0
    while i < rt_count(groups):
        let dorm = rt_cat("dorm.", groups[i])
        let threshold = rt_cat("threshold.", groups[i])
        if (origin == dorm and target == threshold) or (origin == threshold and target == dorm):
            rt_push(conditions, dv_fact(c2_ref(rt_cat("case.", groups[i]), "outer_latch_released"), true))
        i = i + 1
    return dv_axiom("c2_move_law", 1, dv_all(conditions), dv_single(dv_assign(c2_position_ref(actor), target)))

fn c2_place_label(place):
    let names = {"living_hall": "起居厅", "central_hall": "中央厅", "lecture": "讲堂", "logistics": "后勤院", "clinic": "诊疗室", "greenhouse": "温室", "document_workshop": "文献工房", "resonance_hall": "共鸣厅", "quiet_room": "沉静室", "white_tower_safe": "白塔安全端", "washroom": "盥洗室", "oath_court": "誓约庭", "outdoor_meter": "户外仪器阵", "outdoor_high": "户外高地", "outdoor_alley": "户外小径", "dorm.contract": "甲区寝室", "dorm.astral": "丙区寝室", "dorm.logistics": "丁区寝室", "threshold.contract": "甲区门外", "threshold.astral": "丙区门外", "threshold.logistics": "丁区门外", "hall": "乙区大厅", "foyer": "乙区门厅", "corridor": "乙区走廊", "pantry": "备餐间"}
    return dv_find(names, place, place)

fn c2_move_action(actor, origin, target, gate):
    let id = rt_cat(actor, rt_cat(".c2.move.", rt_cat(origin, rt_cat(".", target))))
    let premise = c2_move_law(actor, origin, target, gate).premise
    var method = "travel"
    if dv_has(["oath_court", "greenhouse", "outdoor_meter", "outdoor_high", "outdoor_alley"], target):
        method = "outdoor_travel"
    return dv_with_many(c2_action(id, "move", premise, premise, id, dv_single(c2_position_ref(actor)), rt_cat("从", rt_cat(c2_place_label(origin), rt_cat("穿过廊门，来到", rt_cat(c2_place_label(target), "。")))), c2_source("00_通行.story", 9, "routes-and-boundaries")), {"repeatable": true, "normative_method": method, "travel": {"from": origin, "to": target, "gate": gate}, "predict_law": id, "failure_grants": [c2_access(gate)], "failure_observe_when": c2_at(actor, origin)})

fn c2_norm_condition(norm, actor):
    let night = c2_any_night()
    if norm.id == "ward_night":
        return night
    if norm.id == "seal_plan":
        return c1_any(dv_fact(c2_ref("c2.weather", "wind"), false), dv_fact(c2_ref("c2.weather", "earthquake_recent"), true))
    if norm.id == "mora_night":
        return dv_all(dv_pair(night, c1_any(dv_fact(c2_own(actor, "hungry"), true), dv_fact(c2_own("moran", "fever"), true))))
    return dv_at_least(c2_clock(), 2250)

fn c2_personal_norms(actor):
    let norms = c2_norms()
    var result = []
    var i = 0
    while i < rt_count(norms):
        let norm = norms[i]
        rt_push(result, {"id": norm.id, "mode": norm.mode, "method": norm.method, "available_when": dv_all(dv_pair(dv_fact(c2_own(actor, rt_cat("accepted.", norm.id)), true), c2_norm_condition(norm, actor))), "promotes": norm.promotes, "sacrifices": norm.sacrifices, "basis": [norm.source], "scope": "subject-local-accepted-norm"})
        i = i + 1
    if actor == "mora":
        rt_push(result, {"id": "mora_patient_boundary", "mode": "forbid", "method": "refuse_patient", "available_when": dv_true(), "promotes": ["patient_priority"], "sacrifices": [], "basis": [c2_approved("mora-personal-bottom-line-does-not-refuse-patients")], "scope": "personal-bottom-line"})
    return result

fn c2_inspect_action(actor, object, room, fields, text, source):
    var grants = []
    var i = 0
    while i < rt_count(fields):
        rt_push(grants, c2_ref(object, fields[i]))
        i = i + 1
    return dv_with_many(c2_action(rt_cat(actor, rt_cat(".c2.inspect.", object)), "inspect", c2_at(actor, room), c2_at(actor, room), "", grants, text, source), {"repeatable": true, "presentation": c2_inspection_presentation(actor, object, fields), "required_room": room})

fn c2_visible_line(when, template, bindings, source):
    return {"when": when, "template": template, "bindings": bindings, "source": source}

fn c2_visible_binding(name, ref, labels):
    return {"name": name, "ref": ref, "labels": labels}

fn c2_inspection_has(fields, field):
    var i = 0
    while i < rt_count(fields):
        if fields[i] == field:
            return true
        i = i + 1
    return false

fn c2_inspection_presentation(actor, object, fields):
    var lines = []
    let description = c2_source("09_表达.story", 653, "存粮与门闩")
    if object == "c2.granary":
        rt_push(lines, c2_visible_line(dv_fact(c2_ref(object, "latch_loose"), true), "门闩变形松动，重锁另须处理。", [], c2_source("09_表达.story", 654, "闩松")))
        rt_push(lines, c2_visible_line(dv_fact(c2_ref(object, "tool_marks"), true), "门闩有新的工具痕，已经紧固。", [], c2_source("09_表达.story", 655, "闩修")))
        rt_push(lines, c2_visible_line(dv_all([dv_fact(c2_ref(object, "latch_loose"), false), dv_fact(c2_ref(object, "tool_marks"), false)]), "门闩完好。", [], c2_source("09_表达.story", 656, "闩好")))
        rt_push(lines, c2_visible_line(dv_true(), "粮仓门{状态}。", [c2_visible_binding("状态", c2_ref(object, "locked"), {"true": "锁着", "false": "未锁"})], description))
        rt_push(lines, c2_visible_line(dv_true(), "总库门{状态}。", [c2_visible_binding("状态", c2_ref(object, "total_store_locked"), {"true": "关着", "false": "开着"})], description))
    if object == "c2.counter":
        rt_push(lines, c2_visible_line(dv_true(), "配给台{状态}。", [c2_visible_binding("状态", c2_ref(object, "open"), {"true": "正在发粮", "false": "还没开粮"})], c2_source("00_时间与文案.story", 98, "配给台关闭")))
        rt_push(lines, c2_visible_line(dv_true(), "配给台还剩{数}份口粮。", [c2_visible_binding("数", c2_ref(object, "remaining"), {})], description))
    if object == "c2.ledger":
        rt_push(lines, c2_visible_line(dv_at_least(c2_ref(object, "counted"), 1), "起始清点记录为{数}份。", [c2_visible_binding("数", c2_ref(object, "counted"), {})], c2_approved("实际清点的新台账")))
        rt_push(lines, c2_visible_line(dv_true(), "白天领取记了{白天}份，夜间补记了{夜间}份。", [c2_visible_binding("白天", c2_ref(object, "day_recorded"), {}), c2_visible_binding("夜间", c2_ref(object, "night_recorded"), {})], c2_source("04_案件.story", 88, "台账上的领取与补记")))
    if object == "c2.bowl":
        rt_push(lines, c2_visible_line(dv_fact(c2_ref(object, "residue"), true), "莫兰床边一只碗，碗底有进食留下的残渣。", [], c2_source("09_表达.story", 642, "describe.bowl_residue")))
        rt_push(lines, c2_visible_line(dv_all([dv_fact(c2_ref(object, "residue"), false), dv_fact(c2_ref(object, "portions"), 0)]), "碗是干净的。", [], c2_source("09_表达.story", 643, "describe.bowl_clean")))
    if object == "c2.litter.living" or object == "c2.litter.contract" or object == "c2.litter.astral" or object == "c2.litter.logistics":
        rt_push(lines, c2_visible_line(dv_at_least(c2_ref(object, "crumbs"), 1), "废纸篓里有饼屑。", [], c2_source("09_表达.story", 662, "废纸粮：仅呈现已知饼屑")))
        rt_push(lines, c2_visible_line(dv_fact(c2_ref(object, "crumbs"), 0), "没见饼屑。", [], c2_source("09_表达.story", 664, "废纸：未见饼屑")))
    if object == c2_body("moran"):
        rt_push(lines, c2_visible_line(dv_fact(c2_own("moran", "fever"), true), "莫兰额头很烫。", [], c2_source("09_表达.story", 658, "病床：仅呈现已知体温")))
    if object == "c2.weather":
        rt_push(lines, c2_visible_line(dv_fact(c2_ref(object, "ash_falling"), true), "主楼的灰还在落。", [], c2_source("00_时间与文案.story", 52, "开场白")))
        rt_push(lines, c2_visible_line(dv_fact(c2_ref(object, "ash_falling"), false), "落灰停了。", [], c2_approved("second-day-morning-wind")))
        rt_push(lines, c2_visible_line(dv_fact(c2_ref(object, "wind"), true), "廊外起风了。", [], c2_approved("second-day-morning-wind")))
    if object == "c2.daily" and dv_has(fields, "council_closed"):
        let closing_source = c2_approved("user:2026-10-18章末授权")
        rt_push(lines, c2_visible_line(dv_all([dv_fact(c2_ref(object, "council_closed"), true), dv_fact(c2_ref(object, "council_ended"), true)]), "议事已经收束。公约的签名齐备，各人的赞成提案与保留意见仍按原记录保存。", [], closing_source))
        rt_push(lines, c2_visible_line(dv_all([dv_fact(c2_ref(object, "council_closed"), true), dv_fact(c2_ref(object, "council_ended"), false)]), "议事时段已经结束，公约签名尚未齐备。未签名、未投票与未决事项仍按实际记录保留。", [], closing_source))
        rt_push(lines, c2_visible_line(dv_fact(c2_ref(object, "underground_tremor"), true), "铜口底噪里夹着极轻的共鸣，脚下仍能觉出余震。来由尚待查明。", [], closing_source))
    if object == "case.contract" or object == "case.astral" or object == "case.logistics":
        let names = {"lock_no_pry": "锁具检查", "emergency_inventory_majority": "大半张清册的查找", "ward_half_paper": "另一半清册的出示", "joined_inventory": "清册拼合", "ladder_lowered": "备用梯放下", "copper_filings": "铜屑勘查", "seven_step_scuffs": "步位擦痕勘查", "palm_print": "掌印勘查", "vent_pressure_formula": "通风压差算式核对", "moran_reassured": "画夹持有人的安抚", "complete_draft": "完整底稿出示", "r07_skin_test": "R-07皮试记录查找", "three_old_scars": "旧疤核对", "medicine_key_given": "药柜钥匙交接"}
        var i = 0
        while i < rt_count(fields):
            let label = dv_find(names, fields[i], "现场操作")
            rt_push(lines, c2_visible_line(dv_fact(c2_ref(object, fields[i]), true), rt_cat(label, "：现场记录为已完成。"), [], c2_approved("actual-local-case-inspection")))
            rt_push(lines, c2_visible_line(dv_fact(c2_ref(object, fields[i]), false), rt_cat(label, "：现场记录为尚未完成。"), [], c2_approved("actual-local-case-inspection")))
            i = i + 1
    return {"actor": actor, "voice": "visible-inspection", "lines": lines}

fn c2_route_inspections(actor):
    let rows = c2_edges()
    var result = []
    var i = 0
    while i < rt_count(rows):
        let row = rows[i]
        if (row.from == "living_hall" and row.to == "central_hall") or (row.from == "central_hall" and row.to == "logistics"):
            let source = c2_source("00_通行.story", 9, "visible-local-route")
            let id = rt_cat(actor, rt_cat(".c2.inspect.route.", rt_cat(row.from, rt_cat(".", row.to))))
            var grants = dv_single(c2_access(row.gate))
            if dv_has(["contract", "astral", "logistics"], row.gate):
                rt_push(grants, c2_ref(rt_cat("case.", row.gate), "outer_latch_released"))
            rt_push(result, dv_with(c2_action(id, "inspect", c2_at(actor, row.from), c2_at(actor, row.from), "", grants, "查看廊门和外闩。", source), "repeatable", true))
            let back = rt_cat(actor, rt_cat(".c2.inspect.route.", rt_cat(row.to, rt_cat(".", row.from))))
            rt_push(result, dv_with(c2_action(back, "inspect", c2_at(actor, row.to), c2_at(actor, row.to), "", grants, "从这侧查看廊门。", source), "repeatable", true))
        i = i + 1
    return result

axiom c2_collect_law(actor, day, meal, start, end):
    let flag = rt_cat("collected.", rt_cat(rt_show(day), rt_cat(".", meal)))
    return dv_axiom("c2_collect_law", 1, dv_all([c2_at(actor, "logistics"), c2_window(day, start, end), dv_fact(c2_ref("c2.counter", "open"), true), dv_at_least(c2_ref("c2.counter", "remaining"), 1), dv_fact(c2_own(actor, flag), false), c2_alive(actor)]), [dv_increment(c2_ref("c2.counter", "remaining"), -1), dv_increment(c2_ref("c2.ledger", "removed"), 1), dv_increment(c2_ref("c2.ledger", "day_recorded"), 1), dv_increment(c2_own(actor, "rations"), 1), dv_assign(c2_own(actor, flag), true)])

axiom c2_eat_law(actor, day, meal):
    var start = 720
    var end = 840
    if meal == "evening":
        start = 1080
        end = 1260
    let flag = rt_cat("eaten.", rt_cat(rt_show(day), rt_cat(".", meal)))
    return dv_axiom("c2_eat_law", 1, dv_all([c2_window(day, start, end), dv_at_least(c2_own(actor, "rations"), 1), dv_fact(c2_own(actor, flag), false), c2_alive(actor)]), [dv_increment(c2_own(actor, "rations"), -1), dv_increment(c2_own(actor, "consumed"), 1), dv_assign(c2_own(actor, "hungry"), false), dv_assign(c2_own(actor, flag), true)])

axiom c2_open_granary_law(actor):
    let access = c1_any(dv_fact(c2_ref("c2.granary", "key_owner"), actor), dv_fact(c2_own(actor, "can_lock"), true))
    return dv_axiom("c2_open_granary_law", 1, dv_all([c2_at(actor, "logistics"), c2_alive(actor), access]), dv_single(dv_assign(c2_ref("c2.granary", "locked"), false)))

axiom c2_initial_count_law(actor):
    return dv_axiom("c2_initial_count_law", 1, dv_all([c2_at(actor, "logistics"), c2_alive(actor), dv_fact(c2_ref("c2.counter", "remaining"), 99), dv_fact(c2_ref("c2.ledger", "counted"), 0)]), [dv_assign(c2_ref("c2.ledger", "counted"), 99)])

axiom c2_distribute_law(actor):
    return dv_axiom("c2_distribute_law", 1, dv_all([c2_at(actor, "logistics"), c2_alive(actor), dv_fact(c2_ref("c2.ledger", "counted"), 99), dv_fact(c2_ref("c2.counter", "open"), false)]), dv_single(dv_assign(c2_ref("c2.counter", "open"), true)))

axiom c2_total_store_open_law(actor):
    return dv_axiom("c2_total_store_open_law", 1, dv_all([c2i_granary_team(), c2_window(3, 720, 840), c2_at(actor, "logistics"), dv_fact(c2_ref("c2.granary", "double_bolts"), false), dv_fact(c2_ref("c2.granary", "total_store_locked"), true), dv_fact(c2_ref("c2.granary", "reserve_added"), false), c2_alive(actor)]), [dv_assign(c2_ref("c2.granary", "total_store_locked"), false), dv_assign(c2_ref("c2.granary", "reserve_added"), true), dv_increment(c2_ref("c2.counter", "remaining"), 672), dv_increment(c2_ref("c2.ledger", "reserve_received"), 672)])

axiom c2_give_key_law(actor, target):
    return dv_axiom("c2_give_key_law", 1, dv_all([c2_at(actor, "logistics"), c1_at(target, "logistics"), dv_fact(c2_ref("c2.granary", "key_owner"), actor), c2_alive(actor), c2_alive(target)]), dv_single(dv_assign(c2_ref("c2.granary", "key_owner"), target)))

axiom c2_night_take_variant_law(actor, patient, registered):
    var need = dv_fact(c2_own(actor, "hungry"), true)
    if patient:
        need = dv_all([dv_fact(c2_own("moran", "fever"), true), dv_fact(c2_own("moran", "hungry"), true), c2_alive("moran"), dv_fact(c2_ref("c2.bowl", "portions"), 0)])
    var record_condition = dv_fact(c2_own(actor, "accepted.records_supplement"), false)
    var effects = [dv_increment(c2_ref("c2.counter", "remaining"), -1), dv_increment(c2_ref("c2.ledger", "removed"), 1), dv_increment(c2_own(actor, "rations"), 1), dv_increment(c2_own(actor, "owe_notes"), 1), dv_assign(c2_own(actor, "night_taken"), true)]
    if registered:
        record_condition = dv_all([dv_fact(c2_own(actor, "accepted.records_supplement"), true), dv_fact(c2_ref("c2.ledger", "supplement_column"), true)])
        rt_push(effects, dv_increment(c2_ref("c2.ledger", "pending_registered"), 1))
        rt_push(effects, dv_increment(c2_own(actor, "pending_notes"), 1))
    return dv_axiom("c2_night_take_variant_law", 1, dv_all([record_condition, c2_at(actor, "logistics"), c2_any_night(), dv_fact(c2_own(actor, "rations"), 0), dv_fact(c2_ref("c2.counter", "open"), true), dv_at_least(c2_ref("c2.counter", "remaining"), 1), c2_alive(actor), need]), effects)

axiom c2_night_take_law(actor, patient):
    return c2_night_take_variant_law(actor, patient, false)


axiom c2_report_law(actor):
    return dv_axiom("c2_report_law", 1, dv_all([c2_at(actor, "logistics"), dv_at_least(c2_own(actor, "owe_notes"), 1), dv_fact(c2_own(actor, "pending_notes"), 0), dv_fact(c2_own(actor, "busy_care"), false), c2_alive(actor)]), [dv_increment(c2_own(actor, "owe_notes"), -1), dv_increment(c2_ref("c2.ledger", "night_recorded"), 1)])

axiom c2_night_eat_law(actor):
    var room = rt_cat("dorm.", c2_profile(actor).group)
    if c2_profile(actor).group == "living":
        room = "hall"
    return dv_axiom("c2_night_eat_law", 1, dv_all([c2_at(actor, room), c2_any_night(), dv_fact(c2_own(actor, "hungry"), true), dv_at_least(c2_own(actor, "rations"), 1), c2_alive(actor)]), [dv_increment(c2_own(actor, "rations"), -1), dv_increment(c2_own(actor, "consumed"), 1), dv_assign(c2_own(actor, "hungry"), false), dv_increment(c2_ref(rt_cat("c2.litter.", c2_profile(actor).group), "crumbs"), 1)])

axiom c2_deliver_patient_law(actor):
