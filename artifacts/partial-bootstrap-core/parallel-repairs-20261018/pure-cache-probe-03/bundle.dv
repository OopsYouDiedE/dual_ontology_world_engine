    return [
        {"id": "records_supplement", "owner": "ruan", "board": "central_hall", "surface": "急需可取，预留补记栏；次日将取用、用途和结余一同核清。", "promotes": ["records", "night_exception", "patient_priority"], "sacrifices": ["no_exception"], "mode": "permit", "method": "unrecorded_take", "source": c2_approved("third-night-supplement-proposal")},
