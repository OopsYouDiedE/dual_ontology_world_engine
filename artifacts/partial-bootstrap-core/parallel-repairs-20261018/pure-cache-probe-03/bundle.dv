fn c1_inspect_E1(actor):
    return c1_once(c1_action(rt_cat(actor, ".inspect.E1"), "inspect", c1_at(actor, "foyer"), c1_at(actor, "foyer"), "", dv_single(c1_knowledge("bolt_down")), c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/可习得命题.story", 69, "E1")))

fn c1_visible_E1():
    return "门内侧的插闩落在闩槽里。\n门外侧另有一道横闩，从这一侧拉不动。\n门上的猫眼，玻璃外侧糊满烟灰，看出去一片黑。\n门内侧压着一张泛黄的旧纸，题头是铅印的《事故隔离规程》，没有署名和落款日期。\n旧纸写着：泄漏后，各寝区的隔离门从外侧落闩。查明本区事故经过，由当值者向铜口陈述前，不得开启。\n末行另写：急病者可经铜口呼叫转移。"

fn c1_inspect_E2(actor):
