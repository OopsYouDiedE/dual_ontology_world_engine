// Shared defeasible rule. The caller adopts it openly into each person's policy.
// Provenance: design §4.2/§4.7 and the user's explicit 2026-10-12 pragmatic choice.
// Each speaker/listener's opening .003 supplies their own empty school recall.
// Initial school-memory absence is not a physical duration fact.
// The speaker's own memory-object handling and audible-channel knowledge are basis.
// No constructor argument is a real listener mind or a real listener policy.
// Scope-check capability is an uncertain estimate, never asserted as listener fact.

fn c1_short_stay_rule(knowledge, question, memory, basis):
    return dv_with(dv_with(dv_with(dv_with(dv_with(dv_with(dv_with({"id": "short_stay", "cue": "short_stay", "premise": dv_all(dv_pair(dv_fact(dv_ref(question, "state", "awake_scope"), true), dv_fact(dv_ref(memory, "state", "empty_school_recall"), true))), "proposition": dv_fact(dv_ref(knowledge, "state", "short_stay"), true)}, "prior", 0.6), "basis", basis), "source_scope", "awake_self"), "target_scope", "body_history"), "scope_bridge", {"op": "constant", "value": "unknown"}), "available_when", dv_true()), "withdraw_when", dv_not(dv_all(dv_list3(dv_not(dv_fact(dv_ref(knowledge, "state", "familiar"), true)), dv_not(dv_fact(dv_ref(knowledge, "state", "long_residence_traces"), true)), dv_not(dv_fact(dv_ref(knowledge, "state", "replay_reason_complete"), true))))))

fn c1_opening_listener_model(listener, scope_check_estimate, basis):
    var mind = dv_world(rt_cat("opening-listener-model-", listener), "mind", listener)
    var assumption = {"kind": "provisional-model-assumption", "scope_reference_check": scope_check_estimate, "basis": basis}
    dv_require((0 < rt_count(basis)), "Listener model needs speaker-owned handling/channel basis")
    mind = dv_add_object(mind, dv_object("question", "perceived", dv_single(dv_pair("state", []))))
    mind = dv_add_object(mind, dv_object("cognition", "perceived", dv_single(dv_pair("state", []))))
    mind = dv_add_object(mind, dv_object("memory", "perceived", dv_single(dv_pair("state", dv_single(dv_pair("empty_school_recall", dv_cell(true, 0.6, 0, dv_single({"model_source": "speaker-owned-memory-handling", "basis": basis}))))))))
    return dv_with(dv_with(dv_with({"mind": mind, "policy": {"scope_reference_check": scope_check_estimate, "implicature_threshold": 0.5, "implicature_bridges": dv_single(c1_short_stay_rule("cognition", "question", "memory", basis))}, "basis": basis, "model_status": "provisional"}, "assumptions", dv_single(assumption)), "uncertainty_cost", 1), "domain", "speaker-owned-prediction-model")

// Historical physical rules. Source references are provenance, not runtime imports.
// Replaying these bodies does not assert that their premises occurred.
// 声路与真相.story:125 smoke procedure.
// 声路与真相.story:126 footprint procedure. Each sole and direction is a candidate input.
// 声路与真相.story:127 cloth procedure. Placing the cloth is a separate conditional response.
// 声路与真相.story:87-99. Intelligibility and received meaning are distinct.
// No historical response, timing, exact-day evidence or accepted answer is manufactured here.
// Outside caller alternatives remain separate from copper-transmitted speech.
// 声路与真相.story:89 outside full / door-interior muffled / loose-junction propagation.
// The input variables are assumptions, not endpoint conclusions.
// Origin setup defines episode occurrence registers, not the physical presence of old traces.
// Fixed external input. Smoke remains due after its source time; it is not retroactively cancelled.
// Content conditions from design §4.2. Nobody receives the original full words after only a tail.
// Fork marks require the pianist's own actual fork action, not any actor opening a door.
// No request is created before the requester actually has a full instruction and is present.
// A branch validates the shared response choice. Trust does not directly trigger a world effect.
// Encoding existing six-variable propositions as scalar coordinates adds no new conclusion.
// No strangers->zero rule. Missing historical relationship stays unknown.
// A joint request model compares the two actually received reports with inspection.
// Empty weighted appraisal terms are deliberate: trust enters the modeled outcome,
// not a second source-specific bonus. Unknown relationships never become zero.
// Source event 0 is the alarm, not a generic all-bells wake axiom.
// This named episodic model is usable only with the actor's independently obtained anchor.
// Stable event ordering retains all same-time rules. Times below are model coordinates,
// not claimed measurements of an individual's forgotten reaction latency.
// Author sequence 6: smoke reaches the pantry. This is an event-order rule;
// no number of minutes, concentration threshold or response delay is asserted.
// These are local modeling assumptions, not observations or factor evidence.
// An existing V3 statement may be offered toward the standing original question.
// Its literal source claim is not a complete causal account of what the latch actor heard.
// The sharing goal concerns an actual transmission, never a predicted listener acceptance.

axiom c1_hist_smoke(history, knowledge):
