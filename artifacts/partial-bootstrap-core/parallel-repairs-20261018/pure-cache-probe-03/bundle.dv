axiom c2_feed_patient_law(actor):
    return dv_axiom("c2_feed_patient_law", 1, dv_all([c2_at(actor, "clinic"), c1_at("moran", "clinic"), c2_alive("moran"), dv_fact(c2_own("moran", "hungry"), true), dv_fact(c2_own("moran", "fever"), true), dv_at_least(c2_ref("c2.bowl", "portions"), 1), c2_alive(actor)]), [dv_increment(c2_ref("c2.bowl", "portions"), -1), dv_assign(c2_ref("c2.bowl", "residue"), true), dv_increment(c2_own("moran", "consumed"), 1), dv_assign(c2_own("moran", "hungry"), false), dv_assign(c2_own(actor, "busy_care"), true)])

axiom c2_leave_care_law(actor):
    return dv_axiom("c2_leave_care_law", 1, dv_fact(c2_own(actor, "busy_care"), true), dv_single(dv_assign(c2_own(actor, "busy_care"), false)))

axiom c2_latch_request_law(sender, target):
    return dv_axiom("c2_latch_request_law", 1, dv_all([c1_at(sender, "logistics"), c1_at(target, "logistics"), dv_fact(c2_ref("c2.granary", "latch_loose"), true)]), dv_single(dv_assign(c2_own(sender, "repair_requested"), true)))

axiom c2_check_structure_law(actor):
    return dv_axiom("c2_check_structure_law", 1, dv_all([c2_at(actor, "logistics"), c2_window(2, 720, 1080), c2_alive(actor), dv_fact(c2_own(actor, "can_structure"), true), dv_fact(c2_ref("c2.granary", "structure_checked"), false)]), [dv_assign(c2_ref("c2.granary", "structure_checked"), true)])

axiom c2_repair_latch_law(actor):
    return dv_axiom("c2_repair_latch_law", 1, dv_all([c2_at(actor, "logistics"), c2i_granary_team(), c2_window(3, 720, 840), dv_fact(c2_own(actor, "can_lock"), true), dv_fact(c2_ref("c2.granary", "lift_mm"), 4), dv_fact(c2_ref("c2.granary", "structure_checked"), true), dv_fact(c2_ref("c2.granary", "latch_loose"), true), c2_alive(actor)]), [dv_assign(c2_ref("c2.granary", "latch_loose"), false), dv_assign(c2_ref("c2.granary", "tool_marks"), true), dv_assign(c2_ref("c2.granary", "double_bolts"), false), dv_assign(c2_ref("c2.granary", "locked"), false)])

fn c2_norm_available(norm):
    if norm.id == "records_supplement":
        return dv_all([dv_fact(c2_ref("c2.daily", "draft_notes"), true), dv_fact(c2_ref("c2.dialogue.person.ruan", "said.ruan.c2.discuss-supplement"), true)])
    if norm.id == "night_forbid":
        return dv_all([dv_fact(c2_ref("c2.daily", "draft_notes"), true), dv_fact(c2_ref("c2.dialogue.person.ward", "said.ward.c2.discuss-forbid"), true)])
    return dv_true()

axiom c2_propose_law(actor, norm):
    return dv_axiom("c2_propose_law", 1, dv_all([c2_alive(actor), c2_norm_available(norm), dv_fact(c2_ref(c2_norm_object(norm.id), "owner"), actor)]), dv_single(dv_assign(c2_ref(c2_norm_object(norm.id), "proposed"), true)))

axiom c2_post_law(actor, norm):
    return dv_axiom("c2_post_law", 1, dv_all([c2_at(actor, norm.board), dv_fact(c2_ref(c2_norm_object(norm.id), "owner"), actor), dv_fact(c2_ref(c2_norm_object(norm.id), "proposed"), true), dv_fact(c2_ref(c2_norm_object(norm.id), "posted"), false)]), dv_single(dv_assign(c2_ref(c2_norm_object(norm.id), "posted"), true)))

axiom c2_read_norm_law(actor, norm):
    return dv_axiom("c2_read_norm_law", 1, dv_all([c2_at(actor, norm.board), dv_fact(c2_ref(c2_norm_object(norm.id), "posted"), true), dv_fact(c2_own(actor, rt_cat("read.", norm.id)), false)]), dv_single(dv_assign(c2_own(actor, rt_cat("read.", norm.id)), true)))

axiom c2_decide_norm_law(actor, norm, accepted):
    return dv_axiom("c2_decide_norm_law", 1, dv_all([dv_fact(c2_own(actor, rt_cat("decided.", norm.id)), false), c2_alive(actor)]), dv_pair(dv_assign(c2_own(actor, rt_cat("decided.", norm.id)), true), dv_assign(c2_own(actor, rt_cat("accepted.", norm.id)), accepted)))

fn c2_norm_actions(actor, norm):
    let object = c2_norm_object(norm.id)
    var result = []
    if actor == norm.owner:
        let id = rt_cat(actor, rt_cat(".c2.propose.", norm.id))
        let speech = dv_with_many(c1_speech(dv_fact(c2_ref(object, "text"), norm.surface), norm.source, "personal-norm-proposal"), {"surface": norm.surface, "utterance_type": "proposal", "norm_proposal": norm})
        rt_push(result, dv_with_many(c2_action(id, "talk", dv_all([c2_at(actor, norm.board), c2_alive(actor), c2_norm_available(norm)]), dv_all([c2_at(actor, norm.board), c2_alive(actor), c2_norm_available(norm)]), id, dv_single(c2_ref(object, "proposed")), norm.surface, norm.source), {"speech": speech, "listeners": c2_people()}))
        let post_id = rt_cat(actor, rt_cat(".c2.post.", norm.id))
        let pre = dv_all(dv_pair(c2_at(actor, norm.board), dv_fact(c2_ref(object, "proposed"), true)))
        rt_push(result, c2_action(post_id, "help", pre, pre, post_id, dv_single(c2_ref(object, "posted")), rt_cat("在公告板上贴出：", norm.surface), norm.source))
    let peek = rt_cat(actor, rt_cat(".c2.inspect.board.", norm.id))
    rt_push(result, dv_with(c2_action(peek, "inspect", c2_at(actor, norm.board), c2_at(actor, norm.board), "", dv_single(c2_ref(object, "posted")), "查看公告板。", norm.source), "repeatable", true))
    let read_id = rt_cat(actor, rt_cat(".c2.read.", norm.id))
    let read_pre = dv_all([c2_at(actor, norm.board), dv_fact(c2_ref(object, "posted"), true), dv_fact(c2_own(actor, rt_cat("read.", norm.id)), false)])
    rt_push(result, dv_with(c2_action(read_id, "read", read_pre, read_pre, read_id, dv_pair(c2_ref(object, "text"), c2_own(actor, rt_cat("read.", norm.id))), norm.surface, norm.source), "norm_receipt", {"norm": norm, "content": dv_fact(c2_ref(object, "text"), norm.surface)}))
    let known = dv_fact(c2_ref(object, "text"), norm.surface)
    var accepted = true
    var n = 0
    while n < 2:
        var verb = "accept"
        var promotes = norm.promotes
        var sacrifices = norm.sacrifices
        var surface = "我照这条做。"
        if not accepted:
            verb = "decline"
            promotes = norm.sacrifices
            sacrifices = norm.promotes
            surface = "这条我不认。"
        surface = rt_cat(rt_cat("针对以下条文：\n", norm.surface), rt_cat("\n", surface))
        let id = rt_cat(actor, rt_cat(".c2.", rt_cat(verb, rt_cat(".", norm.id))))
        let grants = dv_pair(c2_own(actor, rt_cat("decided.", norm.id)), c2_own(actor, rt_cat("accepted.", norm.id)))
        let speech = dv_with(c1_speech(dv_true(), norm.source, "personal-norm-decision"), "surface", surface)
        let choice = {"group": rt_cat("norm.", norm.id), "requires": known, "prohibits": dv_fact(c2_own(actor, rt_cat("decided.", norm.id)), true), "promotes": promotes, "sacrifices": sacrifices, "basis": [norm.source]}
        var supported_choice = choice
        if accepted:
            supported_choice = dv_with(choice, "require_positive", true)
        rt_push(result, dv_with_many(c2_action(id, "talk", known, dv_all([c2_alive(actor), dv_fact(c2_own(actor, rt_cat("decided.", norm.id)), false)]), id, grants, surface, norm.source), {"speech": speech, "listeners": [], "personal_choice": supported_choice, "norm_decision": {"id": norm.id, "accepted": accepted, "norm": norm}}))
        accepted = false
        n = n + 1
    return result

axiom c2_missed_meal_law(actor, day, meal, end):
    let suffix = rt_cat(rt_show(day), rt_cat(".", meal))
    return dv_axiom("c2_missed_meal_law", 1, dv_all([dv_at_least(c2_clock(), (day - 1) * 1440 + end), dv_fact(c2_own(actor, rt_cat("eaten.", suffix)), false), dv_fact(c2_own(actor, rt_cat("hunger_checked.", suffix)), false), c2_alive(actor)]), dv_pair(dv_assign(c2_own(actor, "hungry"), true), dv_assign(c2_own(actor, rt_cat("hunger_checked.", suffix)), true)))

axiom c2_terminal_exposure_law(actor):
    return dv_axiom("c2_terminal_exposure_law", 1, dv_all([c2_alive(actor), dv_fact(c2_own(actor, "exposure_terminal"), true)]), dv_single(dv_assign(c2_own(actor, "alive"), false)))

axiom c2_first_wind_law():
    return dv_axiom("c2_first_wind_law", 1, dv_all(dv_pair(dv_at_least(c2_clock(), 1980), dv_fact(c2_ref("c2.weather", "phase"), "falling_ash"))), [dv_assign(c2_ref("c2.weather", "phase"), "wind_started"), dv_assign(c2_ref("c2.weather", "severe_air"), false), dv_assign(c2_ref("c2.weather", "wind"), true), dv_assign(c2_ref("c2.weather", "ash_falling"), false), dv_assign(c2_ref("c2.corridor.north", "intake_safe"), true), dv_assign(c2_ref("c2.corridor.east", "intake_safe"), true)])

fn c2_weather_changes():
    return [
        {"id": "third_night", "minute": 4140, "wind": false, "quake": false, "severe": true, "recheck": false},
        {"id": "fourth_quake", "minute": 5370, "wind": false, "quake": true, "severe": true, "recheck": true},
        {"id": "fifth_dawn", "minute": 6120, "wind": true, "quake": false, "severe": false, "recheck": false}]

axiom c2_weather_change_law(change):
    let mark = c2_ref("c2.weather", rt_cat("occurred.", change.id))
    var effects = [dv_assign(mark, true), dv_assign(c2_ref("c2.weather", "wind"), change.wind), dv_assign(c2_ref("c2.weather", "earthquake_recent"), change.quake), dv_assign(c2_ref("c2.weather", "severe_air"), change.severe)]
    if change.severe or change.recheck or change.id == "fifth_dawn":
        let gates = ["north", "east"]
        var i = 0
        while i < rt_count(gates):
            rt_push(effects, dv_assign(c2_ref(rt_cat("c2.corridor.", gates[i]), "intake_safe"), not change.severe))
            if change.recheck:
                rt_push(effects, dv_assign(c2_ref(rt_cat("c2.corridor.", gates[i]), "air_safe"), false))
                rt_push(effects, dv_assign(c2_ref(rt_cat("c2.corridor.", gates[i]), "ventilated"), false))
                rt_push(effects, dv_assign(c2_access(gates[i]), false))
            i = i + 1
    return dv_axiom("c2_weather_change_law", 1, dv_all([dv_at_least(c2_clock(), change.minute), dv_fact(mark, false)]), effects)

axiom c2_daylight_law(day, light):
    var phase = "night"
    var period = c2_night(day)
    if light:
        phase = "day"
        period = c2_window(day, 360, 1260)
    return dv_axiom("c2_daylight_law", 1, dv_all([period, dv_not(dv_fact(c2_ref("c2.weather", "daylight_phase"), phase))]), [dv_assign(c2_ref("c2.weather", "daylight"), light), dv_assign(c2_ref("c2.weather", "daylight_phase"), phase)])

fn c2_corridor_origin(gate):
    if gate == "east":
        return "central_hall"
    return "living_hall"

// Ventilated records a completed purge under measured safe intake conditions.
axiom c2_purge_corridor_law(actor, gate):
    let object = rt_cat("c2.corridor.", gate)
    return dv_axiom("c2_purge_corridor_law", 1, dv_all([c2_at(actor, c2_corridor_origin(gate)), c2_alive(actor), dv_fact(c2_ref(object, "intake_safe"), true), dv_fact(c2_ref(object, "seal_intact"), true), dv_fact(c2_ref("c2.weather", "severe_air"), false), dv_fact(c2_ref(object, "ventilated"), false)]), [dv_assign(c2_ref(object, "ventilated"), true), dv_assign(c2_ref(object, "air_safe"), true)])

axiom c2_open_corridor_law(actor, gate):
    let object = rt_cat("c2.corridor.", gate)
    return dv_axiom("c2_open_corridor_law", 1, dv_all([c2_at(actor, c2_corridor_origin(gate)), c2_alive(actor), dv_fact(c2_ref(object, "air_safe"), true), dv_fact(c2_ref(object, "seal_intact"), true), dv_fact(c2_ref(object, "ventilated"), true), dv_fact(c2_access(gate), false)]), [dv_assign(c2_access(gate), true)])

fn c2_corridor_actions(actor):
    var actions = []
    let gates = ["north", "east"]
    var i = 0
    while i < rt_count(gates):
        let gate = gates[i]
        let object = rt_cat("c2.corridor.", gate)
        let source = c2_approved("第五部分：封闭连廊的现场读数、密封与通风")
        rt_push(actions, c2_inspect_action(actor, object, c2_corridor_origin(gate), ["air_safe", "intake_safe", "seal_intact", "ventilated"], "从安全侧核对补风处读数、密封与已完成的换气记录。", source))
        let purge = c2_purge_corridor_law(actor, gate)
        let purge_id = rt_cat(actor, rt_cat(".c2.purge.corridor.", gate))
        rt_push(actions, dv_with(c2_action(purge_id, "help", purge.premise, purge.premise, purge_id, [c2_ref(object, "ventilated"), c2_ref(object, "air_safe")], "核对补风处读数与排烟路径，完成连廊换气后收拢风门。", source), "predict_law", purge_id))
        let law = c2_open_corridor_law(actor, gate)
        let id = rt_cat(actor, rt_cat(".c2.open.corridor.", gate))
        var action = c2_action(id, "help", law.premise, law.premise, id, [c2_access(gate)], "核对现场条件后，开启连廊隔离门。", source)
        action = dv_with_many(action, {"predict_law": id, "public_observers": dv_append(c2_people(), "demon"), "public_grants": [c2_access(gate)]})
        rt_push(actions, action)
        i = i + 1
    return actions

fn c2_supply_actions(actor):
    var result = []
    var day = 2
    while day < 5:
        let meals = [{"id": "noon", "start": 720, "end": 840}, {"id": "evening", "start": 1080, "end": 1260}]
        var i = 0
        while i < rt_count(meals):
            let meal = meals[i]
            let suffix = rt_cat(rt_show(day), rt_cat(".", meal.id))
            let id = rt_cat(actor, rt_cat(".c2.collect.", suffix))
            let flag = rt_cat("collected.", suffix)
            let known = dv_all([c2_at(actor, "logistics"), c2_window(day, meal.start, meal.end), dv_fact(c2_ref("c2.counter", "open"), true), dv_fact(c2_own(actor, flag), false)])
            if day != 2 or meal.id != "noon":
                rt_push(result, dv_with(c2_action(id, "help", known, known, id, [c2_ref("c2.counter", "remaining"), c2_own(actor, "rations"), c2_own(actor, flag), c2_ref("c2.ledger", "day_recorded")], "在配给台领了一份口粮。", c2_source("10_执行.story", 10, "Collect")), "normative_method", "collect_and_count"))
            let eat = rt_cat(actor, rt_cat(".c2.eat.", suffix))
            let eat_known = dv_all([c2_window(day, meal.start, meal.end), dv_at_least(c2_own(actor, "rations"), 1), dv_fact(c2_own(actor, rt_cat("eaten.", suffix)), false)])
            rt_push(result, c2_action(eat, "help", eat_known, eat_known, eat, [c2_own(actor, "rations"), c2_own(actor, "consumed"), c2_own(actor, "hungry"), c2_own(actor, rt_cat("eaten.", suffix))], "吃了手里的那份口粮。", c2_approved("two-actual-meals-per-person-not-a-daily-stock-deduction")))
            i = i + 1
        day = day + 1
    let open = rt_cat(actor, ".c2.open.granary")
    let can_open = c1_any(dv_fact(c2_ref("c2.granary", "key_owner"), actor), dv_fact(c2_own(actor, "can_lock"), true))
    let open_pre = dv_all(dv_pair(c2_at(actor, "logistics"), can_open))
    rt_push(result, c2_action(open, "experiment", open_pre, open_pre, open, dv_single(c2_ref("c2.granary", "locked")), "打开粮仓的门锁。", c2_source("10_执行.story", 34, "OpenGranary")))
    let key = dv_all(dv_pair(c2_at(actor, "logistics"), dv_fact(c2_ref("c2.granary", "key_owner"), actor)))
    let count_id = rt_cat(actor, ".c2.count.initial")
    let count_known = dv_all([c2_at(actor, "logistics"), dv_fact(c2_ref("c2.counter", "remaining"), 99), dv_fact(c2_ref("c2.ledger", "counted"), 0)])
    rt_push(result, c2_action(count_id, "help", count_known, c2_initial_count_law(actor).premise, count_id, [c2_ref("c2.ledger", "counted")], "逐份清点外间干粮，将九十九份的起始实数记入新台账。", c2_approved("外间实际清点与新台账")))
    let distribute = rt_cat(actor, ".c2.distribute")
    rt_push(result, c2_action(distribute, "help", c2_distribute_law(actor).premise, c2_distribute_law(actor).premise, distribute, [c2_ref("c2.counter", "open")], "配给台开始发粮。", c2_approved("counter-99-is-independent-of-total-granary-key")))
    let total_store = rt_cat(actor, ".c2.open.total_store")
    rt_push(result, c2_action(total_store, "experiment", c2_total_store_open_law(actor).premise, c2_total_store_open_law(actor).premise, total_store, [c2_ref("c2.granary", "total_store_locked")], "三人守住楔块、千斤顶与双钩，将总库门推开；新增足供十六人三周的存粮，并入配给库存。", c2_approved("总库开启需要修闩与解锁的实际结果")))
    if actor != "shen":
        let give = rt_cat(actor, ".c2.give_key.shen")
        rt_push(result, c2_action(give, "help", key, dv_all(dv_pair(key, c1_at("shen", "logistics"))), give, dv_single(c2_ref("c2.granary", "key_owner")), "把粮仓钥匙交给沈鼎。", c2_source("10_执行.story", 15, "GiveKey")))
    let report = rt_cat(actor, ".c2.report.night_take")
    let report_pre = c2_report_law(actor).premise
    rt_push(result, c2_action(report, "talk", report_pre, report_pre, report, [c2_own(actor, "owe_notes"), c2_ref("c2.ledger", "night_recorded"), c2_own(actor, "night_taken")], "在台账上补记了夜里取的一份。", c2_source("10_执行.story", 9, "Inform")))
    if dv_has(c2_people(), actor):
        let id = rt_cat(actor, ".c2.night_take")
        let pre = c2_night_take_law(actor, false).premise
        rt_push(result, dv_with(c2_action(id, "help", pre, pre, id, [c2_own(actor, "rations"), c2_own(actor, "owe_notes"), c2_own(actor, "night_taken"), c2_ref("c2.counter", "remaining")], "从配给台取了一份口粮，留待补记。", c2_approved("按实际饥饿与持粮状态夜取")), "normative_method", "unrecorded_take"))
        let eat = rt_cat(actor, ".c2.night_eat")
        let pre_eat = c2_night_eat_law(actor).premise
        rt_push(result, c2_action(eat, "help", pre_eat, pre_eat, eat, [c2_own(actor, "rations"), c2_own(actor, "hungry"), c2_own(actor, "consumed"), c2_ref(rt_cat("c2.litter.", c2_profile(actor).group), "crumbs")], "吃了手里的那份口粮。", c2_approved("夜食在实际地点留下痕迹")))
    if actor == "mora":
        let pre = c2_night_take_law(actor, true).premise
        rt_push(result, dv_with(c2_action("mora.c2.night_take.patient", "help", pre, pre, "mora.c2.night_take.patient", [c2_own(actor, "rations"), c2_own(actor, "owe_notes"), c2_own(actor, "night_taken"), c2_ref("c2.counter", "remaining")], "从配给台取一份口粮，准备送去诊疗所。", c2_approved("按本人所知的照护需要取粮")), "normative_method", "unrecorded_take"))
    return result

fn c2_special_actions(actor):
    var result = []
    if actor == "huo" or actor == "margaret":
        let id = rt_cat(actor, ".c2.check.structure")
        let pre = c2_check_structure_law(actor).premise
        rt_push(result, c2_action(id, "experiment", pre, pre, id, [c2_ref("c2.granary", "structure_checked"), c2_ref("c2.granary", "latch_loose")], "检查变形门闩与门框受力，确认修整的位置。", c2_approved("粮仓结构检查与机械处理")))
    if actor == "margaret":
        let source = c2_source("04_案件.story", 84, "actual-latch-repair-request")
        let pre = dv_all(dv_pair(c2_at(actor, "logistics"), dv_fact(c2_ref("c2.granary", "latch_loose"), true)))
        let speech = dv_with_many(c1_speech(dv_true(), source, "repair-request"), {"surface": "粮仓的门闩松了。雀儿，请你修一修。", "request": {"target": "quer", "topic": "repair_latch"}})
        rt_push(result, dv_with_many(c2_action("margaret.c2.request.repair_latch", "talk", pre, pre, "margaret.c2.request.repair_latch", [], "粮仓的门闩松了。雀儿，请你修一修。", source), {"speech": speech, "listeners": ["quer"]}))
    if actor == "quer" or actor == "huo":
        let pre = c2_repair_latch_law(actor).premise
        let id = rt_cat(actor, ".c2.repair.latch")
        rt_push(result, c2_action(id, "experiment", pre, pre, id, [c2_ref("c2.granary", "latch_loose"), c2_ref("c2.granary", "tool_marks")], "趁门框抬起四毫米，双钩同时挑开两根门栓，再紧固门闩。", c2_source("10_执行.story", 17, "RepairLatch")))
    if actor == "mora" or actor == "selma" or actor == "shen":
        let inspection = c2_inspect_action(actor, c2_body("moran"), "clinic", ["fever", "hungry", "alive"], "走近莫兰，查看他的状况。", c2_approved("moran-illness-requires-actual-exposure-and-observation"))
        let patient_present = dv_all(dv_pair(c2_at(actor, "clinic"), c1_at("moran", "clinic")))
        rt_push(result, dv_with_many(inspection, {"precondition": patient_present, "authority_precondition": patient_present}))
        let deliver = rt_cat(actor, ".c2.deliver.patient_food")
        let carry = c2_deliver_patient_law(actor).premise
        rt_push(result, c2_action(deliver, "help", carry, carry, deliver, [c2_own(actor, "rations"), c2_ref("c2.bowl", "portions")], "将实际取来的一份粮煮成粥，盛到莫兰床边的碗里。", c2_source("10_执行.story", 7, "NightTakeSick-delivery")))
        let feed = rt_cat(actor, ".c2.feed.patient")
        let food = c2_feed_patient_law(actor).premise
        rt_push(result, c2_action(feed, "help", food, food, feed, [c2_ref("c2.bowl", "portions"), c2_ref("c2.bowl", "residue"), c2_own(actor, "busy_care"), c2_own("moran", "hungry"), c2_own("moran", "consumed")], "照看莫兰吃饭。", c2_source("10_执行.story", 286, "patient-breakfast-from-real-food")))
        let leave = rt_cat(actor, ".c2.leave.care")
        let busy = dv_fact(c2_own(actor, "busy_care"), true)
        rt_push(result, c2_action(leave, "help", busy, busy, leave, dv_single(c2_own(actor, "busy_care")), "暂且停下照看。", c2_approved("actual-care-and-report-compete-for-personal-time")))
    return result

fn c2_inspections(actor):
    var result = c2_route_inspections(actor)
    let source = c2_source("04_案件.story", 8, "actual-evidence-catalog")
    rt_push(result, c2_inspect_action(actor, "c2.granary", "logistics", ["locked", "latch_loose", "structure_checked", "tool_marks", "total_store_locked"], "细看粮仓门闩和门锁。", source))
    rt_push(result, c2_inspect_action(actor, "c2.ledger", "logistics", ["day_recorded", "night_recorded", "counted", "reserve_received", "supplement_column", "pending_registered"], "翻看台账上的领取和补记。", source))
    rt_push(result, c2_inspect_action(actor, "c2.counter", "logistics", ["open", "remaining"], "查看配给台和剩下的口粮。", source))
    rt_push(result, c2_inspect_action(actor, "c2.bowl", "clinic", ["portions", "residue"], "细看莫兰床边的碗。", source))
    let groups = ["living", "contract", "astral", "logistics"]
    var i = 0
    while i < rt_count(groups):
        var room = rt_cat("dorm.", groups[i])
        if groups[i] == "living":
            room = "hall"
        rt_push(result, c2_inspect_action(actor, rt_cat("c2.litter.", groups[i]), room, ["crumbs"], "细看废纸篓。", source))
        i = i + 1
    return result

fn c2_actor_actions(actor):
    var result = c2_inspections(actor)
    let edges = c2_edges()
    var i = 0
    while i < rt_count(edges):
        let edge = edges[i]
        rt_push(result, c2_move_action(actor, edge.from, edge.to, edge.gate))
        rt_push(result, c2_move_action(actor, edge.to, edge.from, edge.gate))
        i = i + 1
    let rows = [c2i_evening_actions(actor), c2i_record_actions(actor), c2_supply_actions(actor), c2_special_actions(actor), c2_corridor_actions(actor), c2i_actions(actor)]
    i = 0
    while i < rt_count(rows):
        var j = 0
        while j < rt_count(rows[i]):
            rt_push(result, rows[i][j])
            j = j + 1
        i = i + 1
    let norms = c2_norms()
    i = 0
    while i < rt_count(norms):
        let actions = c2_norm_actions(actor, norms[i])
        var j = 0
        while j < rt_count(actions):
            rt_push(result, actions[j])
            j = j + 1
        i = i + 1
    let observations = c2_compact_observations(actor)
    i = 0
    while i < rt_count(observations):
        rt_push(result, observations[i])
        i = i + 1
    rt_push(result, dv_with(c2_action(rt_cat(actor, ".c2.inspect.self"), "inspect", dv_true(), c2_alive(actor), "", c2_self_grants(actor), "看看手里的口粮，想想还有什么事没办。", c2_person_source(actor)), "repeatable", true))
    var prepared = []
    i = 0
    while i < rt_count(result):
        var action = result[i]
        if dv_find(result[i], "law", "") != "":
            action = dv_with(action, "predict_law", action.law)
        rt_push(prepared, action)
        i = i + 1
    return c1_public_methods(prepared)

// One observation identity per scope. Weather retains the original sight locations.
fn c2_compact_observations(actor):
    let clock = c2_action(rt_cat(actor, ".c2.inspect.clock"), "inspect", dv_true(), dv_true(), "", [c2_clock()], "看了一眼时间。", c2_approved("campaign-clock-is-actually-observed"))
    let places = ["hall", "living_hall", "central_hall", "logistics", "oath_court"]
    var conditions = []
    var i = 0
    while i < rt_count(places):
        rt_push(conditions, c2_at(actor, places[i]))
        i = i + 1
    let visible = dv_not(dv_all(c2_negated_conditions(conditions)))
    let fields = ["ash_falling", "wind", "daylight", "severe_air"]
    let weather = c2_action(rt_cat(actor, ".c2.inspect.weather"), "inspect", visible, visible, "", [c2_ref("c2.weather", "ash_falling"), c2_ref("c2.weather", "wind"), c2_ref("c2.weather", "daylight"), c2_ref("c2.weather", "severe_air")], "望向廊外，看看天色和风。", c2_approved("visible-actual-weather-not-other-peoples-exposure"))
    return [dv_with(clock, "repeatable", true), dv_with_many(weather, {"repeatable": true, "presentation": c2_inspection_presentation(actor, "c2.weather", fields)})]

fn c2_self_grants(actor):
    let fields = c2_initial_body(actor).facets.state
    var grants = []
    var i = 0
    while i < rt_count(fields):
        rt_push(grants, c2_own(actor, fields[i][0]))
        i = i + 1
    return grants

fn c2_install_actor_laws_into(domain, owned_adoptions, actor, mode):
    c2i_install_laws(domain, owned_adoptions, actor, mode)
    c2i_record_install(domain, owned_adoptions, actor, mode)
    if actor == "moran":
        dv_adopt_into(domain, owned_adoptions, c1_method("moran.c2.sketch.evening.go", c2i_evening_choice_law(actor, "go")), mode, 1, [c2_approved("fourth-evening-owned-choice")])
        dv_adopt_into(domain, owned_adoptions, c1_method("moran.c2.sketch.evening.stay", c2i_evening_choice_law(actor, "stay")), mode, 1, [c2_approved("fourth-evening-owned-choice")])
    let source = [c2_source("10_执行.story", 4, "native-operational-actions")]
    let edges = c2_edges()
    var i = 0
    while i < rt_count(edges):
        let edge = edges[i]
        let there = c2_move_action(actor, edge.from, edge.to, edge.gate)
        let back = c2_move_action(actor, edge.to, edge.from, edge.gate)
        dv_adopt_into(domain, owned_adoptions, c1_method(there.id, c2_move_law(actor, edge.from, edge.to, edge.gate)), mode, 1, source)
        dv_adopt_into(domain, owned_adoptions, c1_method(back.id, c2_move_law(actor, edge.to, edge.from, edge.gate)), mode, 1, source)
        i = i + 1
    var day = 2
    while day < 5:
        let meals = [{"id": "noon", "start": 720, "end": 840}, {"id": "evening", "start": 1080, "end": 1260}]
        i = 0
        while i < rt_count(meals):
            let meal = meals[i]
            let suffix = rt_cat(rt_show(day), rt_cat(".", meal.id))
            dv_adopt_into(domain, owned_adoptions, c1_method(rt_cat(actor, rt_cat(".c2.collect.", suffix)), c2_collect_law(actor, day, meal.id, meal.start, meal.end)), mode, 1, source)
            dv_adopt_into(domain, owned_adoptions, c1_method(rt_cat(actor, rt_cat(".c2.eat.", suffix)), c2_eat_law(actor, day, meal.id)), mode, 1, source)
            i = i + 1
        day = day + 1
    dv_adopt_into(domain, owned_adoptions, c1_method(rt_cat(actor, ".c2.open.granary"), c2_open_granary_law(actor)), mode, 1, source)
    dv_adopt_into(domain, owned_adoptions, c1_method(rt_cat(actor, ".c2.count.initial"), c2_initial_count_law(actor)), mode, 1, [c2_approved("外间实际清点与新台账")])
    dv_adopt_into(domain, owned_adoptions, c1_method(rt_cat(actor, ".c2.distribute"), c2_distribute_law(actor)), mode, 1, source)
    dv_adopt_into(domain, owned_adoptions, c1_method(rt_cat(actor, ".c2.open.total_store"), c2_total_store_open_law(actor)), mode, 1, [c2_approved("总库开启需要修闩与解锁的实际结果")])
    if actor != "shen":
        dv_adopt_into(domain, owned_adoptions, c1_method(rt_cat(actor, ".c2.give_key.shen"), c2_give_key_law(actor, "shen")), mode, 1, source)
    dv_adopt_into(domain, owned_adoptions, c1_method(rt_cat(actor, ".c2.report.night_take"), c2_report_law(actor)), mode, 1, source)
    if dv_has(c2_people(), actor):
        dv_adopt_into(domain, owned_adoptions, c1_method(rt_cat(actor, ".c2.night_take"), c2_night_take_law(actor, false)), mode, 1, source)
    dv_adopt_into(domain, owned_adoptions, c1_method(rt_cat(actor, ".c2.night_eat"), c2_night_eat_law(actor)), mode, 1, source)
    if actor == "mora":
        dv_adopt_into(domain, owned_adoptions, c1_method("mora.c2.night_take.patient", c2_night_take_law(actor, true)), mode, 1, source)
    if actor == "huo" or actor == "margaret":
        dv_adopt_into(domain, owned_adoptions, c1_method(rt_cat(actor, ".c2.check.structure"), c2_check_structure_law(actor)), mode, 1, [c2_approved("粮仓结构检查与机械处理")])
    if actor == "margaret":
        dv_adopt_into(domain, owned_adoptions, c1_method("margaret.c2.request.repair_latch", c2_latch_request_law(actor, "quer")), mode, 1, source)
    if actor == "quer" or actor == "huo":
        dv_adopt_into(domain, owned_adoptions, c1_method(rt_cat(actor, ".c2.repair.latch"), c2_repair_latch_law(actor)), mode, 1, source)
    if dv_has(["mora", "selma", "shen"], actor):
        dv_adopt_into(domain, owned_adoptions, c1_method(rt_cat(actor, ".c2.deliver.patient_food"), c2_deliver_patient_law(actor)), mode, 1, source)
        dv_adopt_into(domain, owned_adoptions, c1_method(rt_cat(actor, ".c2.feed.patient"), c2_feed_patient_law(actor)), mode, 1, source)
        dv_adopt_into(domain, owned_adoptions, c1_method(rt_cat(actor, ".c2.leave.care"), c2_leave_care_law(actor)), mode, 1, source)
    let norms = c2_norms()
    i = 0
    while i < rt_count(norms):
        let norm = norms[i]
        if actor == norm.owner:
            dv_adopt_into(domain, owned_adoptions, c1_method(rt_cat(actor, rt_cat(".c2.propose.", norm.id)), c2_propose_law(actor, norm)), mode, 1, [norm.source])
            dv_adopt_into(domain, owned_adoptions, c1_method(rt_cat(actor, rt_cat(".c2.post.", norm.id)), c2_post_law(actor, norm)), mode, 1, [norm.source])
        dv_adopt_into(domain, owned_adoptions, c1_method(rt_cat(actor, rt_cat(".c2.read.", norm.id)), c2_read_norm_law(actor, norm)), mode, 1, [norm.source])
        dv_adopt_into(domain, owned_adoptions, c1_method(rt_cat(actor, rt_cat(".c2.accept.", norm.id)), c2_decide_norm_law(actor, norm, true)), mode, 1, [norm.source])
        dv_adopt_into(domain, owned_adoptions, c1_method(rt_cat(actor, rt_cat(".c2.decline.", norm.id)), c2_decide_norm_law(actor, norm, false)), mode, 1, [norm.source])
        i = i + 1
    let gates = ["north", "east"]
    i = 0
    while i < rt_count(gates):
        let purge_id = rt_cat(actor, rt_cat(".c2.purge.corridor.", gates[i]))
        dv_adopt_into(domain, owned_adoptions, c1_method(purge_id, c2_purge_corridor_law(actor, gates[i])), mode, 1, [c2_approved("补风安全后实际完成换气")])
        let id = rt_cat(actor, rt_cat(".c2.open.corridor.", gates[i]))
        dv_adopt_into(domain, owned_adoptions, c1_method(id, c2_open_corridor_law(actor, gates[i])), mode, 1, [c2_approved("封闭连廊实际开门")])
        i = i + 1
    return true

fn c2_install_actor_laws(world, actor):
    var owned_adoptions = dv_clone(world.adoptions)
    var mode = "enforce"
    if world.domain == "mind":
        mode = "predict"
    c2_install_actor_laws_into(world.domain, owned_adoptions, actor, mode)
    return dv_finish_owned_adoptions(world, owned_adoptions)

fn c2_extend_world(world):
    var result = c2_world_objects(world)
    var owned_adoptions = dv_clone(result.adoptions)
    let domain = result.domain
    dv_adopt_into(domain, owned_adoptions, c1_method("c2.weather.first_wind", c2_first_wind_law()), "enforce", 1, [c2_approved("second-day-morning-wind")])
    let changes = c2_weather_changes()
    var change_index = 0
    while change_index < rt_count(changes):
        let id = rt_cat("c2.weather.", changes[change_index].id)
        dv_adopt_into(domain, owned_adoptions, c1_method(id, c2_weather_change_law(changes[change_index])), "enforce", 1, [c2_approved("第五部分：五日环境变化")])
        change_index = change_index + 1
    c2_install_teacher_laws_into(domain, owned_adoptions, "enforce")
    dv_adopt_into(domain, owned_adoptions, c1_method("c2.meter.safe", c2i_meter_safe_law()), "enforce", 1, [c2_approved("current-instrument-qualitative-safe-reading")])
    dv_adopt_into(domain, owned_adoptions, c1_method("c2.meter.stale", c2i_meter_stale_law()), "enforce", 1, [c2_approved("quake-invalidates-prior-reading")])
    var light_day = 1
    while light_day < 6:
        dv_adopt_into(domain, owned_adoptions, c1_method(rt_cat("c2.daylight.", rt_show(light_day)), c2_daylight_law(light_day, true)), "enforce", 1, [c2_source("00_时间与文案.story", 35, "明示昼夜时段边界")])
        dv_adopt_into(domain, owned_adoptions, c1_method(rt_cat("c2.nightlight.", rt_show(light_day)), c2_daylight_law(light_day, false)), "enforce", 1, [c2_source("00_时间与文案.story", 35, "明示昼夜时段边界")])
        light_day = light_day + 1
    let people = c2_people()
    var i = 0
    while i < rt_count(people):
        c2_install_actor_laws_into(domain, owned_adoptions, people[i], "enforce")
        dv_adopt_into(domain, owned_adoptions, c1_method(rt_cat("c2.outdoor-danger.", people[i]), c2i_outdoor_danger_law(people[i])), "enforce", 1, [c2_approved("actual-quake-air-exposure-engineering-dose")])
        var day = 2
        while day < 5:
            let noon = rt_cat("c2.hunger.", rt_cat(people[i], rt_cat(".", rt_cat(rt_show(day), ".noon"))))
            let evening = rt_cat("c2.hunger.", rt_cat(people[i], rt_cat(".", rt_cat(rt_show(day), ".evening"))))
            dv_adopt_into(domain, owned_adoptions, c1_method(noon, c2_missed_meal_law(people[i], day, "noon", 840)), "enforce", 1, [c2_approved("hunger-follows-actual-missed-meal")])
            dv_adopt_into(domain, owned_adoptions, c1_method(evening, c2_missed_meal_law(people[i], day, "evening", 1260)), "enforce", 1, [c2_approved("hunger-follows-actual-missed-meal")])
            day = day + 1
        dv_adopt_into(domain, owned_adoptions, c1_method(rt_cat("c2.terminal.", people[i]), c2_terminal_exposure_law(people[i])), "enforce", 1, [c2_approved("actual-terminal-exposure")])
        i = i + 1
    return dv_finish_owned_adoptions(result, owned_adoptions)

fn c2_shared_objects():
    var result = ["campaign.clock", "campaign.access", "c2.corridor.north", "c2.corridor.east", "c2.meter", "demon.body", "case.contract", "case.astral", "case.logistics", "c2.granary", "c2.counter", "c2.ledger", "c2.bowl", "c2.kitchen", "c2.weather", "c2.litter.living", "c2.litter.contract", "c2.litter.astral", "c2.litter.logistics"]
    let norms = c2_norms()
    var i = 0
    while i < rt_count(norms):
        rt_push(result, c2_norm_object(norms[i].id))
        i = i + 1
    let people = c2_people()
    i = 0
    while i < rt_count(people):
        rt_push(result, c2_body(people[i]))
        i = i + 1
    return result

fn c2_goal(proposition, when, basis):
    return c1n_index_goal_window({"kind": "achieve", "scope": "personal", "proposition": proposition, "available_when": when, "basis": basis})

fn c2_observation_goal(ref, when, basis, time):
    return c1n_index_goal_window({"kind": "evidence", "scope": "personal", "ref": ref, "source": "perception", "available_when": when, "basis": basis, "minimum_time": time})

// A route inspection concerns a door at the owner's current known location.
fn c2_gate_visible(actor, gate):
    let edges = c2_edges()
    var locations = []
    var i = 0
    while i < rt_count(edges):
        if edges[i].gate == gate:
            rt_push(locations, c2_at(actor, edges[i].from))
            rt_push(locations, c2_at(actor, edges[i].to))
        i = i + 1
    return dv_not(dv_all(c2_negated_conditions(locations)))

fn c2_negated_conditions(conditions):
    var result = []
    var i = 0
    while i < rt_count(conditions):
        rt_push(result, dv_not(conditions[i]))
        i = i + 1
    return result

fn c2_personal_goals(actor):
    let id = actor.id
    let source = [c2_person_source(id)]
    var goals = [c2_observation_goal(c2_clock(), dv_true(), [c2_approved("actual-clock-observation-before-time-sensitive-actions")], 0)]
    // user:2026-10-18章末授权：观察真实收束，不预置签署结果。
    rt_push(goals, c2_observation_goal(c2_ref("c2.daily", "council_closed"), dv_at_least(c2_clock(), 6330), [c2_approved("user:2026-10-18章末授权")], 6330))
    rt_push(goals, c2_observation_goal(c2_ref("c2.daily", "council_ended"), dv_fact(c2_ref("c2.daily", "council_closed"), true), [c2_approved("user:2026-10-18章末授权")], 0))
    var gates = ["living", "north", "east"]
    if id == "quer":
        rt_push(goals, dv_with_many(c2_observation_goal(c2_clock(), c2_at(id, "living_hall"), [c2_approved("actual-clock-observation-before-time-sensitive-actions")], 1980), {"refresh_until": dv_at_least(c2_clock(), 1980), "refresh_refs": [c2_position_ref("margaret"), c2_position_ref("mora")]}))
    var gate_index = 0
    while gate_index < rt_count(gates):
        rt_push(goals, dv_with(c2_observation_goal(c2_access(gates[gate_index]), c2_gate_visible(id, gates[gate_index]), [c2_source("00_通行.story", 9, "复查眼前通路")], 0), "refresh_until", dv_fact(c2_access(gates[gate_index]), true)))
        gate_index = gate_index + 1
    if id == "quer":
        rt_push(goals, c2_observation_goal(c2_ref("c2.weather", "daylight"), dv_all([c2_at(id, "living_hall"), dv_at_least(c2_clock(), 1980)]), [c2_source("00_时间与文案.story", 35, "看天色辨昼夜")], 1980))
        rt_push(goals, c2_observation_goal(c2_ref("c2.weather", "wind"), dv_all([c2_at(id, "living_hall"), dv_at_least(c2_clock(), 1980)]), [c2_approved("visible-current-wind")], 1980))
        rt_push(goals, c2_observation_goal(c2_ref("c2.weather", "severe_air"), dv_all([c2_at(id, "living_hall"), dv_at_least(c2_clock(), 1980)]), [c2_approved("visible-current-air")], 1980))
    if id == "demon":
        rt_push(goals, dv_with_many(c2_observation_goal(c2_clock(), dv_true(), [c2_approved("actual-clock-observation-before-time-sensitive-actions")], 1980), {"refresh_until": dv_at_least(c2_clock(), 1980)}))
        rt_push(goals, c2_observation_goal(c2_position_ref(id), dv_true(), [c2_source("06_场面.story", 85, "自己的现场身体位置")], 0))
        rt_push(goals, dv_with(c2_observation_goal(c2_access("north"), c2_gate_visible(id, "north"), [c2_source("00_通行.story", 9, "复查眼前通路")], 0), "refresh_until", dv_fact(c2_access("north"), true)))
        rt_push(goals, dv_with(c2_observation_goal(c2_access("east"), c2_gate_visible(id, "east"), [c2_source("00_通行.story", 9, "复查眼前通路")], 0), "refresh_until", dv_fact(c2_access("east"), true)))
        return goals
    if dv_has(["detective", "huo", "shen", "su"], id):
        let door_fields = ["outer_released", "inner_down", "open"]
        var door_index = 0
        while door_index < rt_count(door_fields):
            rt_push(goals, c2_observation_goal(c2_ref("departure.door", door_fields[door_index]), c2_at(id, "foyer"), [c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/08_终局.story", 4, "当前隔离门")], 0))
            door_index = door_index + 1
    if dv_has(["quer", "shen", "huo", "margaret", "bertrand"], id):
        let indoor_gates = ["north", "east"]
        var corridor_index = 0
        while corridor_index < rt_count(indoor_gates):
            let gate = indoor_gates[corridor_index]
            rt_push(goals, c2_observation_goal(c2_ref(rt_cat("c2.corridor.", gate), "ventilated"), dv_all([c2_at(id, c2_corridor_origin(gate)), dv_at_least(c2_clock(), 1980)]), [c2_approved("现场核对封闭连廊")], 1980))
            rt_push(goals, c2_goal(dv_fact(c2_ref(rt_cat("c2.corridor.", gate), "ventilated"), true), dv_all([c2_at(id, c2_corridor_origin(gate)), dv_at_least(c2_clock(), 1980)]), [c2_approved("经核对后实际换气")]))
            rt_push(goals, c2_goal(dv_fact(c2_access(gate), true), dv_all([c2_at(id, c2_corridor_origin(gate)), dv_at_least(c2_clock(), 1980)]), [c2_approved("经核对后实际开启连廊")]))
            corridor_index = corridor_index + 1
    let norms = c2_norms()
    var i = 0
    while i < rt_count(norms):
        let norm = norms[i]
        if norm.owner == id:
            rt_push(goals, c2_goal(dv_fact(c2_ref(c2_norm_object(norm.id), "posted"), true), dv_all([c2_at(id, norm.board), dv_at_least(c2_clock(), 2250)]), [norm.source]))
        rt_push(goals, c2_observation_goal(c2_ref(c2_norm_object(norm.id), "posted"), dv_all([c2_at(id, norm.board), dv_at_least(c2_clock(), 2250)]), [norm.source], 0))
        rt_push(goals, c2_observation_goal(c2_ref(c2_norm_object(norm.id), "text"), dv_fact(c2_ref(c2_norm_object(norm.id), "posted"), true), [norm.source], 0))
        rt_push(goals, c2_goal(dv_fact(c2_own(id, rt_cat("decided.", norm.id)), true), dv_fact(c2_ref(c2_norm_object(norm.id), "text"), norm.surface), [norm.source]))
        i = i + 1
    var day = 2
    while day < 5:
        let meals = [{"id": "noon", "start": 720, "end": 840}, {"id": "evening", "start": 1080, "end": 1260}]
        i = 0
        while i < rt_count(meals):
            let meal = meals[i]
            let flag = rt_cat("eaten.", rt_cat(rt_show(day), rt_cat(".", meal.id)))
            rt_push(goals, c2_goal(dv_fact(c2_own(id, flag), true), c2_window(day, meal.start, meal.end), source))
            i = i + 1
        day = day + 1
    rt_push(goals, c2_goal(dv_fact(c2_own(id, "hungry"), false), dv_fact(c2_own(id, "hungry"), true), source))
    if c2_profile(id).domain == "resources":
        rt_push(goals, c2_observation_goal(c2_ref("c2.counter", "remaining"), c2_at(id, "logistics"), source, 0))
        rt_push(goals, c2_observation_goal(c2_ref("c2.ledger", "counted"), c2_at(id, "logistics"), source, 0))
        var service_day = 2
        while service_day < 5:
            let active = c1_any(c2_window(service_day, 720, 840), c2_window(service_day, 1080, 1260))
            rt_push(goals, c2_goal(dv_fact(c2_ref("c2.counter", "open"), true), active, [c2_approved("real-counter-service-does-not-require-total-granary-key")]))
            service_day = service_day + 1
    rt_push(goals, c2_goal(dv_fact(c2_own(id, "owe_notes"), 0), dv_all(dv_pair(dv_at_least(c2_own(id, "owe_notes"), 1), dv_fact(c2_own(id, "busy_care"), false))), [c2_source("10_执行.story", 9, "Inform")]))
    if id == "huo" or id == "margaret":
        rt_push(goals, c2_observation_goal(c2_ref("c2.granary", "structure_checked"), c2_at(id, "logistics"), source, 0))
        rt_push(goals, c2_goal(dv_fact(c2_ref("c2.granary", "structure_checked"), true), c2_at(id, "logistics"), source))
    if id == "mora":
        rt_push(goals, c2_goal(dv_fact(c2_own("moran", "hungry"), false), dv_all([dv_fact(c2_own("moran", "fever"), true), dv_fact(c2_own("moran", "hungry"), true)]), [c2_approved("mora-does-not-refuse-a-real-patient")]))
    let investigations = c2i_goals(actor)
    var investigation_index = 0
    while investigation_index < rt_count(investigations):
        rt_push(goals, investigations[investigation_index])
        investigation_index = investigation_index + 1
    return goals

fn c2_refresh_actor_goals(actor):
    var goals = c2_personal_goals(actor)
    let carried = dv_find(actor.policy, "chapter1_carried_goals", [])
    var i = 0
    while i < rt_count(carried):
        rt_push(goals, carried[i])
        i = i + 1
    return dv_with(actor, "policy", dv_with(actor.policy, "goals", goals))

fn c2_install_teacher_laws_into(domain, owned_adoptions, mode):
    let edges = c2_edges()
    var i = 0
    while i < rt_count(edges):
        let edge = edges[i]
        let there = c2_move_action("demon", edge.from, edge.to, edge.gate)
        let back = c2_move_action("demon", edge.to, edge.from, edge.gate)
        dv_adopt_into(domain, owned_adoptions, c1_method(there.id, c2_move_law("demon", edge.from, edge.to, edge.gate)), mode, 1, [c2_source("06_场面.story", 85, "讲堂中的授课者")])
        dv_adopt_into(domain, owned_adoptions, c1_method(back.id, c2_move_law("demon", edge.to, edge.from, edge.gate)), mode, 1, [c2_source("06_场面.story", 85, "讲堂中的授课者")])
        i = i + 1
    return true

fn c2_install_teacher_laws(world):
    var owned_adoptions = dv_clone(world.adoptions)
    var mode = "enforce"
    if world.domain == "mind":
        mode = "predict"
    c2_install_teacher_laws_into(world.domain, owned_adoptions, mode)
    return dv_finish_owned_adoptions(world, owned_adoptions)

fn c2_extend_teacher(actor):
    var mind = actor.mind
    let objects = c2_shared_objects()
    var i = 0
    while i < rt_count(objects):
        mind = c2_add_new(mind, c1_local_object(objects[i]))
        i = i + 1
    mind = c2_install_teacher_laws(mind)
    var actions = dv_clone(actor.actions)
    rt_push(actions, dv_with(c2_action("demon.c2.inspect.body-location", "inspect", dv_true(), dv_true(), "", dv_single(c2_position_ref("demon")), "看了看周围。", c2_source("06_场面.story", 85, "身体位置由现场取得")), "repeatable", true))
    let routes = c2_route_inspections(actor.id)
    i = 0
    while i < rt_count(routes):
        rt_push(actions, routes[i])
        i = i + 1
    let edges = c2_edges()
    i = 0
    while i < rt_count(edges):
        rt_push(actions, c2_move_action(actor.id, edges[i].from, edges[i].to, edges[i].gate))
        rt_push(actions, c2_move_action(actor.id, edges[i].to, edges[i].from, edges[i].gate))
        i = i + 1
    let observations = c2_compact_observations(actor.id)
    i = 0
    while i < rt_count(observations):
        rt_push(actions, observations[i])
        i = i + 1
    let result = dv_with_many(actor, {"mind": mind, "location_ref": c2_position_ref("demon"), "observable_presence_when": dv_fact(c2_ref("demon.body", "manifested"), true), "actions": c1_public_methods(actions), "policy": dv_with_many(actor.policy, {"wait_chunk_limit": 180, "chapter1_carried_goals": dv_find(actor.policy, "goals", []), "chapter2_profile": {"id": "demon", "domain": "teaching", "station_roles": [], "basis": [c2_source("09_表达.story", 605, "我想教")]}, "notice_co_presence": true, "visual_identity_when": dv_fact(c2_ref("c2.weather", "daylight"), true)})})
    return c2_refresh_actor_goals(result)

fn c2_extend_actor(actor):
    return c2_extend_actor_from(actor, actor.mind, actor.mind)

fn c2_extend_actor_from(actor, physical, previous):
    if not dv_has(c2_people(), actor.id):
        if actor.id == "demon":
            return c2_extend_teacher(actor)
        return actor
    var mind = actor.mind
    let objects = c2_shared_objects()
    var i = 0
    while i < rt_count(objects):
        if not dv_has_key(mind.objects, objects[i]):
            mind = dv_add_object(mind, c1_local_object(objects[i]))
        i = i + 1
    // The owner can feel own inventory/unfinished decisions; no other body is copied.
    var own = []
    if not dv_has_key(previous.objects, c2_body(actor.id)):
        own = dv_get(physical.objects, c2_body(actor.id)).facets.state
    i = 0
    while i < rt_count(own):
        let field = own[i]
        if not dv_read(mind, c2_own(actor.id, field[0])).known:
            mind = dv_store(mind, c2_own(actor.id, field[0]), dv_with(field[1], "source", "perception"))
        i = i + 1
    // Own authorship is known before proposing; another person's proposal is not.
    let norms = c2_norms()
    i = 0
    while i < rt_count(norms):
        let norm = norms[i]
        if norm.owner == actor.id:
            let object = c2_norm_object(norm.id)
            if not dv_read(mind, c2_ref(object, "owner")).known:
                mind = dv_store(mind, c2_ref(object, "owner"), dv_with(dv_field(actor.id), "basis", [norm.source]))
            if not dv_read(mind, c2_ref(object, "text")).known:
                mind = dv_store(mind, c2_ref(object, "text"), dv_with(dv_field(norm.surface), "basis", [norm.source]))
            if not dv_has_key(previous.objects, object):
                if not dv_read(mind, c2_ref(object, "proposed")).known:
                    mind = dv_store(mind, c2_ref(object, "proposed"), dv_field(false))
                if not dv_read(mind, c2_ref(object, "posted")).known:
                    mind = dv_store(mind, c2_ref(object, "posted"), dv_field(false))
        i = i + 1
    mind = c2_install_actor_laws(mind, actor.id)
    let profile = c2_profile(actor.id)
    let binding = {"topic": "chapter2", "heard_when": dv_true(), "completed_when": dv_not(dv_true()), "basis": profile.basis}
    var order = dv_clone(dv_find(actor.policy, "value_order", []))
    i = 0
    while i < rt_count(profile.value_order):
        if not dv_has(order, profile.value_order[i]):
            rt_push(order, profile.value_order[i])
        i = i + 1
    var value_basis = dv_clone(dv_find(actor.policy, "value_basis", []))
    i = 0
    while i < rt_count(profile.basis):
        rt_push(value_basis, profile.basis[i])
        i = i + 1
    var norm_rules = dv_clone(dv_find(actor.policy, "norm_rules", []))
    let extra_rules = c2_personal_norms(actor.id)
    i = 0
    while i < rt_count(extra_rules):
        var found = false
        var rule_index = 0
        while rule_index < rt_count(norm_rules):
            if norm_rules[rule_index].id == extra_rules[i].id:
                found = true
            rule_index = rule_index + 1
        if not found:
            rt_push(norm_rules, extra_rules[i])
        i = i + 1
    var policy = dv_with_many(actor.policy, {"topic_bindings": dv_append(dv_find(actor.policy, "topic_bindings", []), binding), "value_order": order, "value_basis": value_basis, "chapter2_profile": profile, "norm_rules": norm_rules, "visual_identity_when": dv_fact(c2_ref("c2.weather", "daylight"), true)})
    policy = dv_with_many(policy, {"plan_depth": 2, "first_night_plan_depth": 2, "first_night_plan_active": false, "positive_move_root_stop": true, "daytime_wait_chunk_limit": 30})
    var actions = c2_actor_actions(actor.id)
    let first_night_group = dv_has(["detective", "huo", "shen", "su", "quer", "lucian", "ward", "gu"], actor.id) and dv_truth(physical, c2_at(actor.id, "living_hall")) == "true"
    // Residents still outside the living hall retain the methods and goals needed to arrive.
    if not first_night_group:
        i = 0
        while i < rt_count(actor.actions):
            rt_push(actions, actor.actions[i])
            i = i + 1
        policy = dv_with(policy, "chapter1_carried_goals", dv_find(actor.policy, "goals", []))
    else:
        policy = dv_with(policy, "chapter1_carried_goals", [])
    let erosion = cognitive_erosion(c2_own(actor.id, "erosion_exposure"), c2i_erosion_parameters(), 1, [c2_approved("engineering-dose-units-not-measured-physiology")])
    let result = dv_with_many(actor, {"mind": mind, "actions": actions, "policy": policy, "erosion": erosion})
    return c2_refresh_actor_goals(result)

fn c2_extend_scene(scene):
    if dv_find(scene, "chapter2_content_installed", false):
        return scene
    let physical = c2_extend_world(scene.physical)
    var actors = []
    var bindings = dv_clone(scene.bindings)
    let objects = c2_shared_objects()
    var i = 0
    while i < rt_count(scene.actors):
        let actor = scene.actors[i]
        rt_push(actors, c2_extend_actor_from(actor, physical, scene.physical))
        var j = 0
        while j < rt_count(objects):
            if dv_local(bindings, objects[j], actor.id) == "":
                rt_push(bindings, dv_binding(objects[j], objects[j], actor.id))
            j = j + 1
        i = i + 1
    var processes = dv_clone(dv_find(scene, "world_processes", []))
    let extra = c2_world_processes()
    i = 0
    while i < rt_count(extra):
        rt_push(processes, extra[i])
        i = i + 1
    return dv_with_many(scene, {"id": "chapter2-native-content", "physical": physical, "actors": actors, "bindings": bindings, "clock_ref": c2_clock(), "world_processes": processes, "chapter2_contracts": c2_runtime_contracts(), "chapter2_content_installed": true})

fn c2_world_processes():
    var result = [
        {"id": "c2.meter.safe", "law": "c2.meter.safe", "basis": [c2_approved("current-instrument-qualitative-safe-reading")]},
        {"id": "c2.meter.stale", "law": "c2.meter.stale", "basis": [c2_approved("quake-invalidates-prior-reading")]},
        {"id": "c2.weather.first_wind", "law": "c2.weather.first_wind", "once": true, "basis": [c2_approved("second-day-morning-wind")]}]
    let changes = c2_weather_changes()
    var change_index = 0
    while change_index < rt_count(changes):
        let id = rt_cat("c2.weather.", changes[change_index].id)
        rt_push(result, {"id": id, "law": id, "once": true, "basis": [c2_approved("第五部分：五日环境变化")]})
        change_index = change_index + 1
    var i = 0
    var light_day = 1
    while light_day < 6:
        rt_push(result, {"id": rt_cat("c2.daylight.", rt_show(light_day)), "law": rt_cat("c2.daylight.", rt_show(light_day)), "once": true, "basis": [c2_source("00_时间与文案.story", 35, "明示昼夜时段边界")]})
        rt_push(result, {"id": rt_cat("c2.nightlight.", rt_show(light_day)), "law": rt_cat("c2.nightlight.", rt_show(light_day)), "once": true, "basis": [c2_source("00_时间与文案.story", 35, "明示昼夜时段边界")]})
        light_day = light_day + 1
    let people = c2_people()
    i = 0
    while i < rt_count(people):
        var day = 2
        while day < 5:
            let prefix = rt_cat("c2.hunger.", rt_cat(people[i], rt_cat(".", rt_show(day))))
            rt_push(result, {"id": rt_cat(prefix, ".noon"), "law": rt_cat(prefix, ".noon"), "once": true, "basis": [c2_approved("hunger-follows-actual-missed-meal")]})
            rt_push(result, {"id": rt_cat(prefix, ".evening"), "law": rt_cat(prefix, ".evening"), "once": true, "basis": [c2_approved("hunger-follows-actual-missed-meal")]})
            day = day + 1
        let danger = rt_cat("c2.outdoor-danger.", people[i])
        rt_push(result, {"id": danger, "law": danger, "basis": [c2_approved("actual-quake-air-exposure-engineering-dose")]})
        let terminal = rt_cat("c2.terminal.", people[i])
        rt_push(result, {"id": terminal, "law": terminal, "basis": [c2_approved("actual-terminal-exposure")]})
        i = i + 1
    return result

fn c2_runtime_contracts():
    return {
        "engineering_parameters": {"reserve": "672 portions = 16*21*2; retained original counter stock", "erosion": "dose thresholds 1/2/4/6/8 and coupling factor 1; daytime exposure +1, actual severe quake-alley exposure +8; qualitative authored hazard with explicit engineering scale, not measured physiology"},
        "clock": {"ref": c2_clock(), "unit": "minute", "day_origin": "day1-at-minute-zero", "start": "retain-actual-chapter1-handoff", "end": "day5-morning", "constraint": "never-rewind-or-write-actor-choices-from-a-date"},
        "access": {"object": "campaign.access", "fields": ["living", "contract", "astral", "logistics", "north", "east"], "source": c2_source("00_通行.story", 9, "authored-boundaries"), "constraint": "actual-opening-observation-and-movement-required"},
        "phase_services": {"counter": "real-counter-staff-action-opens-99-ration-pool-without-total-granary-key", "inventory": "each-collect-spends-one-not-32-per-day", "hunger": "derive-from-real-missed-meals-never-brand-quer-hungry-by-date", "goal_refresh": "c2_refresh_actor_goals-after-real-clock-updates-reads-only-owned-mind", "observations": "explicit-clock-self-route-and-weather-actions-not-passive-global-knowledge"},
        "norms": {"receipt": "real-proposal-post-read-events", "choice": "owner-value-order-after-personal-receipt", "execution": "policy.norm_rules-available_when-and-action.normative_method-against-owned-mind", "indifference": "do-not-treat-a-zero-value-tie-as-positive-adoption-support", "constraint": "posting-does-not-enforce-a-global-law"},
        "stations": {"scope": "chapter-two-granary-cooperation-only", "reserve_parameter": "672-standard-portions=16-persons*21-days*2-meals; engineering-unit-conversion"},
        "environment": {"object": "c2.weather", "inputs": ["wind", "daylight", "earthquake_recent", "severe_air"], "authored_processes": ["falling-ash-through-day2-dawn", "day2-forenoon-wind", "day3-night-calm", "day4-evening-earthquake", "day5-dawn-wind"], "provenance": "authored-clock-conditions-and-actual-weather-control-history", "qualitative_laws": ["windy-day-high-ground-short-excursion", "calm-night-low-lane-slope-foot-water-spring-lethal-exposure"], "unimplemented_room_safety_draft": {"status": "isolated-no-production-controls-or-inputs", "fixture": "verification/checks/fixtures/room-safety-draft.dv", "qualitative_requirements": ["closed-indoor-doors-windows-and-isolation-protect", "recent-earthquake-heavy-air-can-seep-through-gaps"], "inputs": "unknown-not-assumed-false"}, "constraint": "no-invented-concentration-dose-disease-or-erosion-number"},
        "physiology": {"inputs": ["actual-exposure", "observed-fever", "actual-care", "terminal-exposure"], "constraint": "never-use-third-day-illness-or-fourth-night-death-as-an-assignment"},
        "evidence": {"ledger": "derive-from-real-removals-day-records-and-night-reports", "latch": "tool-marks-only-from-real-repair", "bowl": "residue-only-from-real-patient-feeding", "crumbs": "only-from-real-night-eating", "testimony": "speaker-owned-perception-no-identity-from-a-small-shadow"},
        "handoff": {"preserve": ["accepted_norms", "trust", "hunger", "remaining_rations", "casualties", "memories", "erosion", "ownership"], "constraint": "copy-committed-state-never-reset-to-a-preset-ending"}}

fn c2_next_chapter_contract(scene):
    return {"id": "chapter2-to-chapter3-actual-state", "physical": dv_clone(scene.physical), "actors": dv_clone(scene.actors), "bindings": dv_clone(scene.bindings), "inheritance": c2_runtime_contracts().handoff, "source": c2_approved("day5-contract-inherits-real-state")}

// Investigation rows describe completed contact, never a calendar-assigned resolution.
fn c2i_row(actor, id, room, when, object, field, requirements, text):
    return {"actor": actor, "id": id, "room": room, "when": when, "object": object, "field": field, "requirements": requirements, "text": text}

fn c2i_granary_team():
    return dv_all([c2_at("margaret", "logistics"), c2_at("huo", "logistics"), c2_at("quer", "logistics"), c2_alive("margaret"), c2_alive("huo"), c2_alive("quer")])

fn c2i_rows():
    let key = ["authored-declaration", "c2i_rows"]
    let cached = rt_memo_get([], key)
    if cached[0]:
        return cached[1]
    return rt_memo_put([], key, c2i_rows_build())

fn c2i_rows_build():
    let document = c2_window(2, 840, 960)
    let resonance = c2_window(3, 570, 720)
    let safety = c2_window(3, 840, 1020)
    var rows = [
        c2i_row("quer", "quer.c2.document.dismantle-lock", "document_workshop", document, "case.contract", "lock_no_pry", [], "拆下锁具，逐面验看：锁芯和门边没有撬痕。"),
        c2i_row("detective", "detective.c2.document.inventory", "document_workshop", document, "case.contract", "emergency_inventory_majority", [], "从散页中找出大半张紧急清册，保留断口等待另一半核对。"),
        c2i_row("quer", "quer.c2.resonance.pipe-climb", "resonance_hall", resonance, "case.astral", "ladder_lowered", [], "沿九米管架攀上平台，把梯子放下。"),
        c2i_row("quer", "quer.c2.resonance.copper", "resonance_hall", resonance, "case.astral", "copper_filings", [dv_fact(c2_ref("case.astral", "ladder_lowered"), true)], "平台的管口下留着细小铜屑。"),
        c2i_row("detective", "detective.c2.resonance.steps", "resonance_hall", resonance, "case.astral", "seven_step_scuffs", [dv_fact(c2_ref("case.astral", "ladder_lowered"), true)], "顺着七星步位，逐一比对地面的擦痕。"),
        c2i_row("detective", "detective.c2.resonance.palm", "resonance_hall", resonance, "case.astral", "palm_print", [dv_fact(c2_ref("case.astral", "ladder_lowered"), true)], "梯上与平台边缘留着掌印，位置与攀援线路相接。"),
        c2i_row("detective", "detective.c2.resonance.pressure", "quiet_room", resonance, "case.astral", "vent_pressure_formula", [], "检查备用通风道，抄下标注时刻与压差的算式，保留两者的对应关系。"),
        c2i_row("quer", "quer.c2.safety.acid-drawer", "white_tower_safe", safety, "case.logistics", "r07_skin_test", [], "以酸蚀松开抽屉，取出R-07自体皮试记录。"),
        c2i_row("margaret", "margaret.c2.granary.wedge", "logistics", c2_window(3, 720, 840), "c2.granary", "wedge_set", [c2i_granary_team(), dv_fact(c2_ref("c2.granary", "structure_checked"), true)], "按昨日勘查位置置入结构楔，托住变形门框。"),
        c2i_row("huo", "huo.c2.granary.jack", "logistics", c2_window(3, 720, 840), "c2.granary", "lift_mm", [c2i_granary_team(), dv_fact(c2_ref("c2.granary", "wedge_set"), true)], "以千斤顶和滑轮抬升门框四毫米，保持载荷，让雀儿操作双栓。")]
    let contract_join = dv_all([dv_fact(c2_ref("case.contract", "lock_no_pry"), true), dv_fact(c2_ref("case.contract", "emergency_inventory_majority"), true)])
    rt_push(rows, c2i_row("ward", "ward.c2.document.half-paper", "document_workshop", document, "case.contract", "ward_half_paper", [], "取出保存的半张纸，把断口摊在紧急清册旁。"))
    rt_push(rows, c2i_row("detective", "detective.c2.document.join", "document_workshop", document, "case.contract", "joined_inventory", [contract_join, dv_fact(c2_ref("case.contract", "ward_half_paper"), true)], "沿断口将沃德的半纸与大半张紧急清册拼合，逐项核对原来的取存记录。"))
    rt_push(rows, c2i_row("gu", "gu.c2.document.apology", "document_workshop", document, "case.contract", "gu_apologized", [dv_fact(c2_ref("case.contract", "joined_inventory"), true)], "清册拼合了，锁也没有撬痕。老朽先前失察，在这里致歉。"))
    rt_push(rows, c2i_row("ward", "ward.c2.document.return-key", "document_workshop", document, "case.contract", "key_returned", [dv_fact(c2_ref("case.contract", "joined_inventory"), true)], "证据已核清。我把代管的钥匙归还。"))
    rt_push(rows, c2i_row("detective", "detective.c2.astral.reassure", "quiet_room", resonance, "case.astral", "moran_reassured", [c2_at("moran", "quiet_room")], "先别急着解释，把画夹取来，我们逐页看清楚。"))
    rt_push(rows, c2i_row("moran", "moran.c2.astral.draft", "quiet_room", resonance, "case.astral", "complete_draft", [dv_fact(c2_ref("case.astral", "moran_reassured"), true)], "翻开画夹暗层，展出完整底稿：两指向下，作劈切之势。"))
    rt_push(rows, c2i_row("elena", "elena.c2.astral.identify", "quiet_room", resonance, "case.astral", "abandoned_child_misunderstanding_resolved", [dv_fact(c2_ref("case.astral", "complete_draft"), true)], "是双指向下的劈切，不是弃子的手势。此前的误会应当撤回。"))
    let assembled = dv_all([c2_at("mora", "white_tower_safe"), c2_at("bertrand", "white_tower_safe"), c2_at("veronica", "white_tower_safe")])
    rt_push(rows, c2i_row("veronica", "veronica.c2.safety.scars", "white_tower_safe", safety, "case.logistics", "three_old_scars", [assembled, dv_fact(c2_ref("case.logistics", "r07_skin_test"), true)], "卷起左袖，露出三道旧疤，按日期和R-07自体皮试记录核对。"))
    rt_push(rows, c2i_row("mora", "mora.c2.safety.apology-key", "white_tower_safe", safety, "case.logistics", "medicine_key_given", [assembled, dv_fact(c2_ref("case.logistics", "three_old_scars"), true)], "是我误会了。药柜钥匙交给你，我们把抗侵蚀剂配出来。"))
    rt_push(rows, c2i_row("veronica", "veronica.c2.safety.mix", "white_tower_safe", safety, "case.logistics", "anti_erosion_mixed", [assembled, dv_fact(c2_ref("case.logistics", "medicine_key_given"), true)], "依皮试记录核对材料与用量，配成抗侵蚀剂，贴妥标签。"))
    rt_push(rows, c2i_row("moran", "moran.c2.sketch.day", "outdoor_high", c2_window(3, 720, 1020), c2_body("moran"), "day_sketch_exposed", [dv_fact(c2_ref("c2.weather", "daylight"), true)], "在高地对着光写生，返程前察觉灰尘刺激，身体发热。"))
    return rows

fn c2i_value(row):
    if row.field == "lift_mm":
        return 4
    return true

fn c2i_premise(row):
    return dv_all(dv_append(row.requirements, dv_all([c2_at(row.actor, row.room), c2_alive(row.actor), row.when])))

axiom c2i_contact_law(row):
    var effects = dv_single(dv_assign(c2_ref(row.object, row.field), c2i_value(row)))
    if row.field == "day_sketch_exposed":
        rt_push(effects, dv_assign(c2_own("moran", "fever"), true))
        rt_push(effects, dv_increment(c2_own("moran", "erosion_exposure"), 1))
    return dv_axiom("c2i_contact_law", 1, c2i_premise(row), effects)

fn c2i_world_objects(world):
    var result = world
    result = c2_add_new(result, c2_object("c2.meter", "outdoor_meter", {"safe": dv_field(false)}))
    let cases = ["case.contract", "case.astral", "case.logistics"]
    var i = 0
    while i < rt_count(cases):
        result = c2_add_new(result, c2_object(cases[i], "", {}))
        i = i + 1
    let rows = c2i_rows()
    i = 0
    while i < rt_count(rows):
        let ref = c2_ref(rows[i].object, rows[i].field)
        if not dv_read(result, ref).known:
            var initial = false
            if rows[i].field == "lift_mm":
                initial = 0
            result = dv_store(result, ref, dv_field(initial))
        i = i + 1
    return result

fn c2i_install_laws(domain, adoptions, actor, mode):
    let rows = c2i_rows()
    var i = 0
    while i < rt_count(rows):
        if rows[i].actor == actor:
            dv_adopt_into(domain, adoptions, c1_method(rows[i].id, c2i_contact_law(rows[i])), mode, 1, [c2_approved("chapter-two-real-investigation-contact")])
        i = i + 1
    return true

fn c2i_actions(actor):
    var result = []
    let rows = c2i_rows()
    var i = 0
    while i < rt_count(rows):
        let row = rows[i]
        if row.actor == actor:
            let pre = c2i_premise(row)
            let ref = c2_ref(row.object, row.field)
            var grants = [ref]
            if row.field == "day_sketch_exposed":
                rt_push(grants, c2_own("moran", "fever"))
                rt_push(grants, c2_own("moran", "erosion_exposure"))
            var action = dv_with_many(c2_action(row.id, "experiment", pre, pre, row.id, grants, row.text, c2_approved("chapter-two-real-investigation-contact")), {"public_observers": c2_people(), "public_grants": [ref]})
            let talk_fields = ["gu_apologized", "key_returned", "moran_reassured", "abandoned_child_misunderstanding_resolved", "medicine_key_given"]
            if dv_has(talk_fields, row.field):
                action = dv_with_many(action, {"kind": "talk", "speech": dv_with(c1_speech(dv_true(), c2_approved("chapter-two-evidence-led-dialogue"), "case-resolution"), "surface", row.text), "listeners": c2_people()})
            rt_push(result, action)
        i = i + 1
    // Evidence becomes available to another actor through an actual local inspection.
    let places = [{"object": "case.contract", "room": "document_workshop", "fields": ["lock_no_pry", "emergency_inventory_majority", "ward_half_paper", "joined_inventory"]}, {"object": "case.astral", "room": "resonance_hall", "fields": ["ladder_lowered", "copper_filings", "seven_step_scuffs", "palm_print"]}, {"object": "case.astral", "room": "quiet_room", "fields": ["vent_pressure_formula", "moran_reassured", "complete_draft"]}, {"object": "case.logistics", "room": "white_tower_safe", "fields": ["r07_skin_test", "three_old_scars", "medicine_key_given"]}, {"object": "c2.granary", "room": "logistics", "fields": ["wedge_set", "lift_mm", "double_bolts", "reserve_added"]}]
    i = 0
    while i < rt_count(places):
        let place = places[i]
        var inspect = c2_inspect_action(actor, place.object, place.room, place.fields, "在现场核对已完成的操作与留下的证据。", c2_approved("chapter-two-evidence-requires-local-inspection"))
        inspect = dv_with(inspect, "id", rt_cat(actor, rt_cat(".c2.investigation.inspect.", place.room)))
        rt_push(result, inspect)
        i = i + 1
    return result

fn c2i_goals(actor):
    let id = actor.id
    var goals = []
    let rows = c2i_rows()
    let focus = c2i_navigation_focus(actor, rows)
    let closing = c2i_closing_navigation(actor)
    if closing != false:
        let source = c2_approved("user:2026-10-18章末授权")
        let when = c1_any(dv_fact(c2_ref("c2.daily", "council_closed"), true), dv_at_least(c2_clock(), 6330))
        rt_push(goals, c2_goal(c2_at(id, closing.target), when, [source, closing]))
        if closing.next != closing.target:
            rt_push(goals, c2_goal(c2_at(id, closing.next), dv_all([when, c2_at(id, closing.origin)]), [source, closing]))
    var i = 0
    while i < rt_count(rows):
        let row = rows[i]
        if row.actor == id:
            let completion = dv_fact(c2_ref(row.object, row.field), c2i_value(row))
            if closing == false and row.id == focus:
                let transit_goal = c2_goal(c2_at(id, row.room), row.when, [c2_approved("chapter-two-investigation-transit")])
                if not dv_has(goals, transit_goal):
                    rt_push(goals, transit_goal)
                let route = c2i_known_route(actor, row.room)
                if route != false and route.next != row.room:
                    let relay = c2_goal(c2_at(id, route.next), dv_all([row.when, c2_at(id, route.origin)]), [c2_approved("own-declared-investigation-route"), route])
                    if not dv_has(goals, relay):
                        rt_push(goals, relay)
            rt_push(goals, dv_with(c2_goal(completion, row.when, [c2_approved("chapter-two-investigation-opportunity")]), "navigation_completion", completion))
        i = i + 1
    if id == "ruan":
        rt_push(goals, c2_goal(dv_fact(c2_ref("c2.ledger", "supplement_column"), true), dv_fact(c2_own("ruan", "accepted.records_supplement"), true), [c2_approved("implement-reserved-column-after-acceptance")]))
    if id == "moran":
        rt_push(goals, c2_observation_goal(c2_ref("c2.meter", "safe"), c2_window(4, 1020, 1260), [c2_approved("read-actual-meter-before-evening-outing")], 0))
        rt_push(goals, c2_observation_goal(c2_own("moran", "watched"), c2_night(4), [c2_approved("actual-current-supervision-not-permanent-flag")], 5370))
        rt_push(goals, c2_goal(c2_at("moran", "outdoor_alley"), dv_fact(c2_ref("case.astral", "evening_choice"), "go"), [c2_approved("execute-actual-personal-sketch-choice")]))
        rt_push(goals, c2_goal(dv_fact(c2_ref("case.astral", "evening_choice"), "go"), c2_night(4), [c2_approved("evening-research-opportunity-not-compulsory-outcome")]))
        rt_push(goals, c2_goal(c2_at("moran", "clinic"), dv_fact(c2_own("moran", "fever"), true), [c2_approved("actual-discomfort-motivates-return-to-care")]))
    let evidence_places = [{"object": "case.contract", "room": "document_workshop", "fields": ["lock_no_pry", "emergency_inventory_majority", "ward_half_paper", "joined_inventory"]}, {"object": "case.astral", "room": "resonance_hall", "fields": ["ladder_lowered", "copper_filings", "seven_step_scuffs", "palm_print"]}, {"object": "case.astral", "room": "quiet_room", "fields": ["vent_pressure_formula", "moran_reassured", "complete_draft"]}, {"object": "case.logistics", "room": "white_tower_safe", "fields": ["r07_skin_test", "three_old_scars", "medicine_key_given"]}]
    var place_index = 0
    while place_index < rt_count(evidence_places):
        let place = evidence_places[place_index]
        if id == "detective" or id == "quer" or place.object == rt_cat("case.", c2_profile(id).group):
            var field_index = 0
            while field_index < rt_count(place.fields):
                rt_push(goals, c2_observation_goal(c2_ref(place.object, place.fields[field_index]), c2_at(id, place.room), [c2_approved("actual-local-case-inspection")], 0))
                field_index = field_index + 1
        place_index = place_index + 1
    if dv_has(["margaret", "huo", "quer"], id):
        let granary_fields = ["structure_checked", "wedge_set", "lift_mm", "double_bolts"]
        var field_index = 0
        while field_index < rt_count(granary_fields):
            rt_push(goals, c2_observation_goal(c2_ref("c2.granary", granary_fields[field_index]), c2_window(3, 720, 840), [c2_approved("actual-cooperation-observation")], 0))
            field_index = field_index + 1
        rt_push(goals, c2_goal(dv_fact(c2_ref("c2.granary", "total_store_locked"), false), c2_window(3, 720, 840), [c2_approved("three-person-granary-opening")]))
    return goals

axiom c2i_reserve_column_law():
    return dv_axiom("c2i_reserve_column_law", 1, dv_all([c2_at("ruan", "logistics"), dv_fact(c2_own("ruan", "accepted.records_supplement"), true), dv_fact(c2_ref("c2.ledger", "supplement_column"), false)]), dv_single(dv_assign(c2_ref("c2.ledger", "supplement_column"), true)))

axiom c2i_complete_pending_law(actor):
    return dv_axiom("c2i_complete_pending_law", 1, dv_all([c2_at(actor, "logistics"), c2_alive(actor), dv_at_least(c2_own(actor, "pending_notes"), 1), dv_at_least(c2_own(actor, "owe_notes"), 1), dv_fact(c2_own(actor, "busy_care"), false)]), [dv_increment(c2_own(actor, "pending_notes"), -1), dv_increment(c2_own(actor, "owe_notes"), -1), dv_increment(c2_ref("c2.ledger", "pending_registered"), -1), dv_increment(c2_ref("c2.ledger", "night_recorded"), 1)])

fn c2i_record_install(domain, adoptions, actor, mode):
    let source = [c2_approved("actual-reserved-column-and-pending-entry")]
    dv_adopt_into(domain, adoptions, c1_method(rt_cat(actor, ".c2.night_take.registered"), c2_night_take_variant_law(actor, false, true)), mode, 1, source)
    dv_adopt_into(domain, adoptions, c1_method(rt_cat(actor, ".c2.report.pending"), c2i_complete_pending_law(actor)), mode, 1, source)
    if actor == "mora":
        dv_adopt_into(domain, adoptions, c1_method("mora.c2.night_take.patient.registered", c2_night_take_variant_law(actor, true, true)), mode, 1, source)
    if actor == "ruan":
        dv_adopt_into(domain, adoptions, c1_method("ruan.c2.ledger.reserve-column", c2i_reserve_column_law()), mode, 1, source)
    return true

fn c2i_record_actions(actor):
    var result = []
    let source = c2_approved("actual-reserved-column-and-pending-entry")
    let law = c2_night_take_variant_law(actor, false, true)
    let id = rt_cat(actor, ".c2.night_take.registered")
    rt_push(result, dv_with(c2_action(id, "help", law.premise, law.premise, id, [c2_own(actor, "rations"), c2_own(actor, "owe_notes"), c2_own(actor, "pending_notes"), c2_ref("c2.ledger", "pending_registered"), c2_ref("c2.counter", "remaining")], "取一份口粮，在预留栏留下待补核的取用记号。", source), "normative_method", "unrecorded_take"))
    let report = c2i_complete_pending_law(actor)
    let report_id = rt_cat(actor, ".c2.report.pending")
    rt_push(result, c2_action(report_id, "help", report.premise, report.premise, report_id, [c2_own(actor, "pending_notes"), c2_own(actor, "owe_notes"), c2_ref("c2.ledger", "pending_registered"), c2_ref("c2.ledger", "night_recorded")], "将预留栏中的取用记号补齐用途，转入已核记录。", source))
    if actor == "mora":
        let patient = c2_night_take_variant_law(actor, true, true)
        rt_push(result, dv_with(c2_action("mora.c2.night_take.patient.registered", "help", patient.premise, patient.premise, "mora.c2.night_take.patient.registered", [c2_own(actor, "rations"), c2_own(actor, "owe_notes"), c2_own(actor, "pending_notes"), c2_ref("c2.ledger", "pending_registered"), c2_ref("c2.counter", "remaining")], "为发热病人取一份粮，在预留栏留下待补核的记号。", source), "normative_method", "unrecorded_take"))
    if actor == "ruan":
        let column = c2i_reserve_column_law()
        rt_push(result, c2_action("ruan.c2.ledger.reserve-column", "help", column.premise, column.premise, "ruan.c2.ledger.reserve-column", [c2_ref("c2.ledger", "supplement_column")], "在台账上划出补记栏，分别记待核取用与已核结余。", source))
    return result

// Dose units and thresholds are explicit engineering parameters, not measured physiology.
fn c2i_erosion_parameters():
    return [{"at": 1, "rank": 0}, {"at": 2, "rank": 1}, {"at": 4, "rank": 2}, {"at": 6, "rank": 3}, {"at": 8, "rank": 4}]

axiom c2i_outdoor_danger_law(actor):
    return dv_axiom("c2i_outdoor_danger_law", 1, dv_all([c2_at(actor, "outdoor_alley"), c2_alive(actor), dv_fact(c2_ref("c2.weather", "earthquake_recent"), true), dv_fact(c2_ref("c2.weather", "severe_air"), true), dv_fact(c2_own(actor, "evening_sketch_exposed"), false)]), [dv_increment(c2_own(actor, "erosion_exposure"), 8), dv_assign(c2_own(actor, "evening_sketch_exposed"), true)])

fn c2i_evening_actions(actor):
    if actor != "moran":
        return []
    let source = c2_approved("fourth-evening-owned-research-and-safety-choice")
    let when = dv_all([c2_night(4), c2_alive(actor)])
    let result_ref = c2_ref("case.astral", "evening_choice")
    var result = []
    var watch_index = 0
    while watch_index < 2:
        let watched = watch_index == 1
        let context = dv_all([when, dv_fact(c2_own(actor, "watched"), watched)])
        var options = [{"value": "go", "text": "色层难得。我想沿夹道再看一眼，把那层颜色画下来。", "promotes": ["research"], "sacrifices": ["cautious_travel", "safety"]}, {"value": "stay", "text": "先留在安全处，把现有草图画完，等新读数。", "promotes": ["safety", "cautious_travel"], "sacrifices": ["research"]}]
        var i = 0
        while i < rt_count(options):
            let option = options[i]
            var promotes = option.promotes
            if watched and option.value == "stay":
                // Public accountability is an additional reason, evaluated by shared utility.
                promotes = ["measured_work", "safety", "cautious_travel"]
            let id = rt_cat("moran.c2.sketch.evening.", rt_cat(option.value, rt_cat(".", rt_show(watched))))
            let law = rt_cat("moran.c2.sketch.evening.", option.value)
            var ready = context
            if option.value == "go":
                ready = dv_all([context, dv_fact(c2_ref("c2.meter", "safe"), true)])
            let choice = {"group": "moran.evening-sketch", "requires": ready, "prohibits": c1_any(dv_fact(result_ref, "stay"), dv_fact(result_ref, "go")), "promotes": promotes, "sacrifices": option.sacrifices, "basis": [source]}
            let speech = dv_with(c1_speech(dv_true(), source, "evening-sketch-choice"), "surface", option.text)
            var action = c2_action(id, "talk", ready, ready, law, [result_ref], option.text, source)
            action = dv_with_many(action, {"personal_choice": choice, "speech": speech, "listeners": c2_people(), "received_speech_requirement": {"speaker": "demon", "action_id": "demon.c2.truth-color"}})
            rt_push(result, action)
            i = i + 1
        watch_index = watch_index + 1
    let unsafe = dv_all([when, dv_fact(c2_ref("c2.meter", "safe"), false)])
    let unsafe_choice = {"group": "moran.evening-sketch", "requires": unsafe, "prohibits": c1_any(dv_fact(result_ref, "stay"), dv_fact(result_ref, "go")), "promotes": ["measured_work", "safety"], "sacrifices": ["research"], "basis": [source]}
    let unsafe_action = c2_action("moran.c2.sketch.evening.stay.unsafe", "help", unsafe, unsafe, "moran.c2.sketch.evening.stay", [result_ref], "新读数已经不安全，先留在安全处。", source)
    rt_push(result, dv_with_many(unsafe_action, {"personal_choice": unsafe_choice, "received_speech_requirement": {"speaker": "demon", "action_id": "demon.c2.truth-color"}}))
    rt_push(result, c2_inspect_action(actor, "c2.meter", "outdoor_meter", ["safe"], "从仪器阵安全侧读取当前读数，核对风止与震后变化。", source))
    let watch = c2_inspect_action(actor, c2_body(actor), "central_hall", ["watched"], "看看谁还在身边，是否有人正负责监督这次外出。", source)
    rt_push(result, dv_with(watch, "id", "moran.c2.inspect.current-watch"))
    let local_watch = c2_inspect_action(actor, c2_body(actor), "living_hall", ["watched"], "留意门内实际在场的守望者。", source)
    rt_push(result, dv_with(local_watch, "id", "moran.c2.inspect.current-watch-living"))
    return result

axiom c2i_evening_choice_law(actor, value):
    return dv_axiom("c2i_evening_choice_law", 1, dv_all([c2_alive(actor), c2_night(4)]), dv_single(dv_assign(c2_ref("case.astral", "evening_choice"), value)))

axiom c2i_meter_safe_law():
    return dv_axiom("c2i_meter_safe_law", 1, dv_all([dv_fact(c2_ref("c2.weather", "wind"), true), dv_fact(c2_ref("c2.weather", "severe_air"), false), dv_fact(c2_ref("c2.meter", "safe"), false)]), dv_single(dv_assign(c2_ref("c2.meter", "safe"), true)))

axiom c2i_meter_stale_law():
    return dv_axiom("c2i_meter_stale_law", 1, dv_all([dv_fact(c2_ref("c2.weather", "earthquake_recent"), true), dv_fact(c2_ref("c2.weather", "severe_air"), true), dv_fact(c2_ref("c2.meter", "safe"), true)]), dv_single(dv_assign(c2_ref("c2.meter", "safe"), false)))

// One navigation intention at a time. Local ready work outranks a trip;
// all completion goals remain available to the shared planner.
fn c2i_navigation_focus(actor, rows):
    var fallback = ""
    var ready = ""
    var i = 0
    while i < rt_count(rows):
        let row = rows[i]
        if row.actor == actor.id and dv_truth(actor.mind, row.when) == "true" and dv_truth(actor.mind, dv_fact(c2_ref(row.object, row.field), c2i_value(row))) != "true":
            if fallback == "":
                fallback = row.id
            if dv_truth(actor.mind, dv_all(row.requirements)) == "true":
                if dv_truth(actor.mind, c2_at(actor.id, row.room)) == "true":
                    return row.id
                if ready == "" and c2i_known_route(actor, row.room) != false:
                    ready = row.id
        i = i + 1
    if ready != "":
        return ready
    return fallback

// Intermediate intention follows an owned, known-open path; execution still checks each gate.
fn c2i_known_route(actor, target):
    let position = dv_read(actor.mind, c2_position_ref(actor.id))
    if not dv_uncontested(position) or position.value == target:
        return false
    var queue = [{"room": position.value, "first": "", "basis": []}]
    var visited = [position.value]
    var cursor = 0
    let edges = c2_edges()
    while cursor < rt_count(queue):
        let node = queue[cursor]
        var i = 0
        while i < rt_count(edges):
            let edge = edges[i]
            var destination = ""
            if edge.from == node.room:
                destination = edge.to
            if edge.to == node.room:
                destination = edge.from
            if destination != "" and not dv_has(visited, destination) and dv_truth(actor.mind, dv_fact(c2_access(edge.gate), true)) == "true":
                let action = c2_move_action(actor.id, node.room, destination, edge.gate)
                let adoption = dv_find(actor.mind.adoptions, action.predict_law, false)
                if adoption != false and adoption.active and adoption.mode == "predict":
                    var first = node.first
                    if first == "":
                        first = destination
                    let basis = dv_append(node.basis, {"method": action.id, "adoption_basis": adoption.basis, "gate": c2_access(edge.gate), "gate_cell": dv_read(actor.mind, c2_access(edge.gate))})
                    if destination == target:
                        return {"origin": position.value, "next": first, "target": target, "path_basis": basis, "scope": "owned-route-intention-not-execution"}
                    rt_push(queue, {"room": destination, "first": first, "basis": basis})
                    rt_push(visited, destination)
            i = i + 1
        cursor = cursor + 1
    return false

// One owned navigation intention also serves closing evidence. No location,
// access state or successful inspection is supplied by this route selection.
fn c2i_closing_navigation(actor):
    let when = c1_any(dv_fact(c2_ref("c2.daily", "council_closed"), true), dv_at_least(c2_clock(), 6330))
    if dv_truth(actor.mind, when) != "true":
        return false
    let venues = ["central_hall", "oath_court"]
    let completed = dv_find(actor, "completed_actions", [])
    var i = 0
    while i < rt_count(venues):
        if dv_has(completed, rt_cat(actor.id, rt_cat(".c2.daily.closing.", venues[i]))):
            return false
        i = i + 1
    var best = false
    var distance = -1
    i = 0
    while i < rt_count(venues):
        let room = venues[i]
        if dv_truth(actor.mind, c2_at(actor.id, room)) == "true":
            return {"origin": room, "next": room, "target": room, "path_basis": [], "scope": "owned-closing-inspection-intention-not-execution"}
        let route = c2i_known_route(actor, room)
        if route != false and (distance < 0 or rt_count(route.path_basis) < distance):
            best = route
            distance = rt_count(route.path_basis)
        i = i + 1
    return best

fn c2i_navigation_input(actor):
    var refs = [c2_position_ref(actor.id), c2_access("north"), c2_access("east"), c2_access("living")]
    refs = dvp_merge_refs(refs, [c2_ref("c2.daily", "council_closed")])
    let edges = c2_edges()
    var edge_index = 0
    while edge_index < rt_count(edges):
        refs = dvp_merge_refs(refs, [c2_access(edges[edge_index].gate)])
        edge_index = edge_index + 1
    let goals = dv_find(actor.policy, "goals", [])
    var i = 0
    while i < rt_count(goals):
        let completion = dv_find(goals[i], "navigation_completion", false)
        if completion != false:
            refs = dvp_merge_refs(refs, dvs_sim_refs(completion))
        i = i + 1
    let rows = c2i_rows()
    var windows = []
    i = 0
    while i < rt_count(rows):
        if rows[i].actor == actor.id:
            refs = dvp_merge_refs(refs, dvs_sim_refs(dv_all(rows[i].requirements)))
            rt_push(windows, dv_truth(actor.mind, rows[i].when))
        i = i + 1
    var inputs = []
    i = 0
    while i < rt_count(refs):
        rt_push(inputs, {"ref": refs[i], "cell": dvs_reason_value(dv_read(actor.mind, refs[i]))})
        i = i + 1
    return {"inputs": inputs, "windows": windows, "adoptions": actor.mind.adoptions, "closing_available": dv_truth(actor.mind, c1_any(dv_fact(c2_ref("c2.daily", "council_closed"), true), dv_at_least(c2_clock(), 6330))), "closing_central_completed": dv_has(dv_find(actor, "completed_actions", []), rt_cat(actor.id, ".c2.daily.closing.central_hall")), "closing_oath_completed": dv_has(dv_find(actor, "completed_actions", []), rt_cat(actor.id, ".c2.daily.closing.oath_court"))}

// Optional daily opportunities. Speech marks record execution, never scheduled outcomes.
fn c2daily_ref(field):
    return c2_ref("c2.daily", field)

fn c2daily_say(actor, id, room, when, text, people):
    let source = c2_approved(rt_cat("authorized-second-chapter-daily.", id))
    let row = c2d_row(actor, id, room, when, dv_true(), text, source)
    return dv_with(row, "opportunity", {"location": room, "participants": people, "mode": "all-present"})

fn c2daily_after(row, speaker, action):
    return dv_with(row, "received_speech_requirement", {"speaker": speaker, "action_id": action})

fn c2daily_notes_window():
    return dv_all([dv_at_least(c2_clock(), 1440 + 810), dv_not(dv_at_least(c2_clock(), 3 * 1440))])

fn c2daily_rows():
    let key = ["authored-declaration", "c2daily_rows"]
    let cached = rt_memo_get([], key)
    if cached[0]:
        return cached[1]
    return rt_memo_put([], key, c2daily_rows_build())

fn c2daily_rows_build():
    var rows = []
    let morning = c2_window(2, 480, 570)
    rt_push(rows, c2daily_say("lucian", "lucian.c2.gray-violet", "washroom", morning, "莫兰，窗外那层灰带一点紫；若要画下来，该怎样调？", ["moran"]))
    rt_push(rows, c2daily_after(c2daily_say("moran", "moran.c2.gray-violet", "washroom", morning, "铅白里掺一点紫，别急着压黑。光变了，灰也变。", ["lucian"]), "lucian", "lucian.c2.gray-violet"))
    rt_push(rows, c2daily_say("quer", "quer.c2.hurry-ward", "washroom", morning, "沃德，别对着镜子念规矩了，水龙头还等人用呢。", ["ward"]))
    let ding = c2_window(2, 570, 600)
    rt_push(rows, c2daily_say("mora", "mora.c2.ankle-offer", "living_hall", ding, "伊莲娜，让我看一下你的脚踝。疼的位置和能不能负重，得当面查。", ["elena"]))
    rt_push(rows, c2daily_say("su", "su.c2.stethoscope-ask", "living_hall", ding, "茉拉，听诊器可以让我试试吗？", ["mora"]))
    rt_push(rows, c2daily_after(c2daily_say("mora", "mora.c2.stethoscope-consent", "living_hall", ding, "可以，先擦净耳件；我在旁边教你听，听到什么再说什么。", ["su"]), "su", "su.c2.stethoscope-ask"))
    rt_push(rows, c2daily_say("margaret", "margaret.c2.arch", "living_hall", ding, "霍铎，石拱把力往两边送；上面的桁架还得看节点。你修东西时先查哪里？", ["huo"]))
    rt_push(rows, c2daily_after(c2daily_say("huo", "huo.c2.truss", "living_hall", ding, "先查接头，再看承重。光看外形漂亮，顶不住用。", ["margaret"]), "margaret", "margaret.c2.arch"))
    let lesson = c2_window(2, 600, 690)
    rt_push(rows, c2daily_say("veronica", "veronica.c2.molecular-weight", "lecture", lesson, "源质有分子量吗？怎样称量、怎样分离，误差从哪里来？", ["demon"]))
    rt_push(rows, c2daily_say("selma", "selma.c2.refractive-index", "lecture", lesson, "它的折射率随浓度怎么变？看见颜色，能推到哪一步？", ["demon"]))
    rt_push(rows, c2daily_say("ward", "ward.c2.rule-two", "lecture", lesson, "守则第二条的权限边界，应当逐项说清。执行规则的权限从哪里来？", ["demon"]))
    rt_push(rows, c2daily_after(c2daily_say("ruan", "ruan.c2.rule-four", "lecture", lesson, "第四条说“我所立之规，皆张贴于此”。是否意味着尚有非你所立之规？", ["demon"]), "demon", "demon.c2.school-rule4"))
    let rule = dv_fact(c2d_ref("school_rule4"), "我所立之规，皆张贴于此。")
    rt_push(rows, c2d_row("demon", "demon.c2.school-rule4", "lecture", lesson, rule, "第四条：我所立之规，皆张贴于此。", c2_approved("school-rule-four-actual-teaching")))
    let noon = dv_all([c2_window(2, 720, 810), dv_fact(c2daily_ref("meal_prepared"), true)])
    let table1 = ["detective", "huo", "shen", "quer"]
    let table2 = ["ward", "gu", "bertrand", "mora"]
    let table3 = ["lucian", "moran", "elena", "margaret"]
    let table4 = ["ruan", "selma", "veronica", "su"]
    rt_push(rows, c2daily_say("huo", "huo.c2.lunch-frame", "living_hall", noon, "门框松的地方得重钉，别只把门板刨薄。", table1))
    rt_push(rows, c2daily_say("shen", "shen.c2.lunch-egg", "living_hall", noon, "荷包蛋要护着边儿下锅。今天先把烩菜、热汤和面饼吃热乎。", table1))
    rt_push(rows, c2daily_say("gu", "gu.c2.lunch-order", "living_hall", noon, "秩序二字，旧籍各有用法。先辨时代与出处，再议今日怎样用。", table2))
    rt_push(rows, c2daily_say("lucian", "lucian.c2.lunch-portrait", "living_hall", noon, "这四桌若写进诗里，不能只写十六张脸；莫兰，你会先画谁的手？", table3))
    rt_push(rows, c2daily_say("ruan", "ruan.c2.lunch-rations", "living_hall", noon, "九十九份，每日十六人两餐，九十九除以三十二，是三天余三份。账要跟着真正拿走的份数走。", table4))
    let notes_window = c2daily_notes_window()
    rt_push(rows, c2daily_say("ruan", "ruan.c2.discuss-supplement", "central_hall", dv_all([notes_window, dv_fact(c2daily_ref("draft_notes"), true)]), "我起草的补记栏在这里：夜间急需记下取用者、份数、用途，次日一起核对。请逐条议。", ["ward"]))
    rt_push(rows, c2daily_after(c2daily_say("ward", "ward.c2.discuss-forbid", "central_hall", notes_window, "若补记没有监督，夜间的账靠什么核实？我的提案是严禁夜取；请各人自己表明是否赞成。", ["ruan"]), "ruan", "ruan.c2.discuss-supplement"))
    let quake = dv_all([c2_window(4, 1050, 1260), dv_fact(c2_ref("c2.weather", "earthquake_recent"), true)])
    let color = dv_fact(c2daily_ref("rare_color_layer"), "夹道罕见紫金以太色层")
    rt_push(rows, dv_with(c2d_row("demon", "demon.c2.truth-color", "living_hall", quake, color, "夹道有罕见的紫金以太色层。", c2_approved("actual-truthful-color-temptation-after-quake")), "opportunity", {"location": "living_hall", "participants": ["moran"], "mode": "all-present"}))
    let guards = ["detective", "bertrand", "huo"]
    var g = 0
    while g < rt_count(guards):
        let actor = guards[g]
        let id = rt_cat(actor, ".c2.caution-moran")
        var caution = c2daily_say(actor, id, "living_hall", dv_all([c2_night(4), dv_fact(c2_ref("c2.weather", "earthquake_recent"), true)]), "莫兰，震后夜里的读数和路线没有确认。先停在门内，我们一起复测，再谈出去。", ["moran"])
        caution = c2daily_after(caution, "demon", "demon.c2.truth-color")
        caution = dv_with(caution, "effects", [dv_assign(c2daily_ref(rt_cat("guarding.", actor)), true)])
        rt_push(rows, caution)
        g = g + 1
    let people = c2_people()
    let venues = ["oath_court", "central_hall"]
    var v = 0
    while v < rt_count(venues):
        let room = venues[v]
        var weather = dv_fact(c2_ref("c2.weather", "wind"), true)
        if room == "central_hall":
            weather = dv_fact(c2_ref("c2.weather", "wind"), false)
        let present = [c2d_council_when(), weather]
        var i = 0
        while i < rt_count(people):
            let actor = people[i]
            let stance = c1_any(dv_fact(c2_own(actor, "accepted.open_plan"), true), c1_any(dv_fact(c2_own(actor, "accepted.seal_plan"), true), dv_fact(c2_own(actor, "accepted.committee_plan"), true)))
            let options = ["open_plan", "seal_plan", "committee_plan"]
            let labels = ["核对读数后组织外出劳作", "风止震后先留安全处复测", "公用物资逐项登记共同核对"]
            var n = 0
            while n < rt_count(options):
                var ballot = c2daily_say(actor, rt_cat(actor, rt_cat(".c2.vote.", rt_cat(room, options[n]))), room, dv_all([dv_all(present), c2_alive(actor), dv_fact(c2_own(actor, rt_cat("accepted.", options[n])), true), dv_fact(c2daily_ref(rt_cat("voted.", actor)), false)]), rt_cat("我的票投给：", labels[n]), [])
                ballot = dv_with(ballot, "effects", [dv_assign(c2daily_ref(rt_cat("voted.", actor)), true), dv_assign(c2daily_ref(rt_cat("ballot.", actor)), options[n]), dv_increment(c2daily_ref(rt_cat("votes.", options[n])), 1)])
                let norms = c2_norms()
                var q = 0
                while q < rt_count(norms):
                    let norm = norms[q]
                    if norm.id == options[n]:
                        ballot = dv_with(ballot, "personal_choice", {"group": "council-ballot", "requires": dv_fact(c2_own(actor, rt_cat("accepted.", norm.id)), true), "prohibits": dv_fact(c2daily_ref(rt_cat("voted.", actor)), true), "promotes": norm.promotes, "sacrifices": norm.sacrifices, "basis": [norm.source]})
                    q = q + 1
                rt_push(rows, ballot)
                n = n + 1
            var vote = c2daily_say(actor, rt_cat(actor, rt_cat(".c2.sign.", room)), room, dv_all([dv_all(present), c2_alive(actor), stance, dv_fact(c2daily_ref(rt_cat("voted.", actor)), true), dv_fact(c2daily_ref(rt_cat("signed.", actor)), false)]), "我把本人赞成的提案与保留意见写入公约，签名交众人核对。", [])
            vote = dv_with(vote, "effects", [dv_assign(c2daily_ref(rt_cat("signed.", actor)), true)])
            vote = dv_with(vote, "observation_grants", [c2daily_ref("council_closed")])
            rt_push(rows, vote)
            i = i + 1
        v = v + 1
    return rows

axiom c2daily_cook_law():
    let pre = dv_all([c2_at("shen", "logistics"), c2_window(2, 690, 810), dv_fact(c2daily_ref("meal_cooked"), false)])
    return dv_axiom("c2daily_cook_law", 1, pre, [dv_increment(c2_ref("c2.counter", "remaining"), -16), dv_increment(c2_ref("c2.ledger", "removed"), 16), dv_increment(c2_ref("c2.ledger", "day_recorded"), 16), dv_assign(c2daily_ref("portions"), 16), dv_assign(c2daily_ref("meal_cooked"), true)])

axiom c2daily_deliver_law():
    let pre = dv_all([c2_at("shen", "living_hall"), c2_window(2, 690, 810), dv_fact(c2daily_ref("meal_cooked"), true), dv_fact(c2daily_ref("meal_prepared"), false)])
    return dv_axiom("c2daily_deliver_law", 1, pre, [dv_assign(c2daily_ref("meal_prepared"), true)])

axiom c2daily_serve_law(actor):
    let pre = dv_all([c2_at(actor, "living_hall"), c2_window(2, 720, 810), dv_fact(c2daily_ref("meal_prepared"), true), dv_at_least(c2daily_ref("portions"), 1), dv_fact(c2_own(actor, "collected.2.noon"), false), c2_alive(actor)])
    return dv_axiom("c2daily_serve_law", 1, pre, [dv_increment(c2daily_ref("portions"), -1), dv_increment(c2_own(actor, "rations"), 1), dv_assign(c2_own(actor, "collected.2.noon"), true)])

axiom c2daily_draft_law():
    let pre = dv_all([c2_at("ruan", "central_hall"), c2daily_notes_window(), dv_fact(c2daily_ref("draft_notes"), false)])
    return dv_axiom("c2daily_draft_law", 1, pre, [dv_assign(c2daily_ref("draft_notes"), true)])

axiom c2daily_council_end_law():
    var pre = [dv_fact(c2daily_ref("council_ended"), false)]
    let people = c2_people()
    var i = 0
    while i < rt_count(people):
        rt_push(pre, dv_fact(c2daily_ref(rt_cat("signed.", people[i])), true))
        i = i + 1
    return dv_axiom("c2daily_council_end_law", 1, dv_all(pre), [dv_assign(c2daily_ref("council_ended"), true), dv_assign(c2daily_ref("council_closed"), true)])

// user:2026-10-18章末授权：截止只收束议事，不代替真实签名。
axiom c2daily_council_close_law():
    return dv_axiom("c2daily_council_close_law", 1, dv_all([dv_at_least(c2_clock(), 6330), dv_fact(c2daily_ref("council_closed"), false)]), [dv_assign(c2daily_ref("council_closed"), true)])

// The low hum and aftershock persist through closing; this is a present signal,
// not a historical pulse. The environment never writes a mind.
axiom c2daily_tremor_law():
    return dv_axiom("c2daily_tremor_law", 1, dv_all([dv_fact(c2daily_ref("council_closed"), true), dv_fact(c2daily_ref("underground_tremor"), false)]), [dv_assign(c2daily_ref("underground_tremor"), true)])

fn c2daily_closing_fields():
    var fields = ["council_closed", "council_ended", "underground_tremor", "votes.open_plan", "votes.seal_plan", "votes.committee_plan"]
    let people = c2_people()
    var i = 0
    while i < rt_count(people):
        rt_push(fields, rt_cat("signed.", people[i]))
        rt_push(fields, rt_cat("voted.", people[i]))
        rt_push(fields, rt_cat("ballot.", people[i]))
        i = i + 1
    return fields

// Read-only inheritance evidence; unknown fields remain unknown.
fn c2daily_chapter_summary(physical):
    var people = []
    let ids = c2_people()
    var i = 0
    while i < rt_count(ids):
        let id = ids[i]
        rt_push(people, {"id": id, "alive": dv_read(physical, c2_own(id, "alive")), "signed": dv_read(physical, c2daily_ref(rt_cat("signed.", id))), "voted": dv_read(physical, c2daily_ref(rt_cat("voted.", id))), "ballot": dv_read(physical, c2daily_ref(rt_cat("ballot.", id))), "rations": dv_read(physical, c2_own(id, "rations")), "hungry": dv_read(physical, c2_own(id, "hungry")), "erosion_exposure": dv_read(physical, c2_own(id, "erosion_exposure")), "pending_notes": dv_read(physical, c2_own(id, "pending_notes"))})
        i = i + 1
    return {"scope": "read-only-actual-state-not-character-knowledge", "council_closed": dv_read(physical, c2daily_ref("council_closed")), "council_ended": dv_read(physical, c2daily_ref("council_ended")), "underground_tremor": dv_read(physical, c2daily_ref("underground_tremor")), "people": people, "counter_remaining": dv_read(physical, c2_ref("c2.counter", "remaining")), "counter_open": dv_read(physical, c2_ref("c2.counter", "open")), "ledger_pending": dv_read(physical, c2_ref("c2.ledger", "pending_registered")), "ledger_counted": dv_read(physical, c2_ref("c2.ledger", "counted")), "ledger_removed": dv_read(physical, c2_ref("c2.ledger", "removed")), "ledger_day_recorded": dv_read(physical, c2_ref("c2.ledger", "day_recorded")), "ledger_night_recorded": dv_read(physical, c2_ref("c2.ledger", "night_recorded")), "reserve_added": dv_read(physical, c2_ref("c2.granary", "reserve_added")), "contract_joined": dv_read(physical, c2_ref("case.contract", "joined_inventory")), "astral_draft": dv_read(physical, c2_ref("case.astral", "complete_draft")), "medicine_key_given": dv_read(physical, c2_ref("case.logistics", "medicine_key_given"))}

axiom c2daily_watch_law(watched):
    let guards = ["detective", "bertrand", "huo"]
    var present = []
    var i = 0
    while i < rt_count(guards):
        rt_push(present, dv_all([dv_fact(c2daily_ref(rt_cat("guarding.", guards[i])), true), c2_at(guards[i], "living_hall"), c2_alive(guards[i]), c2_at("moran", "living_hall")]))
        i = i + 1
    var premise = c1_any(present[0], c1_any(present[1], present[2]))
    if not watched:
        premise = dv_not(premise)
    return dv_axiom("c2daily_watch_law", 1, premise, [dv_assign(c2_own("moran", "watched"), watched)])

fn c2daily_tasks():
    return [
        {"actor": "huo", "id": "huo.c2.repair-faucet", "room": "washroom", "field": "faucet_repaired", "when": c2_window(2, 480, 570), "text": "霍铎关水拆下接头，重新拧紧盥洗室的水龙头。"},
        {"actor": "mora", "id": "mora.c2.examine-ankle", "room": "living_hall", "field": "ankle_examined", "when": dv_all([c2_window(2, 570, 600), c2_at("elena", "living_hall"), c2_alive("elena")]), "text": "茉拉当面检查伊莲娜的脚踝、绷带和负重反应。"},
        {"actor": "su", "id": "su.c2.try-stethoscope", "room": "living_hall", "field": "stethoscope_tried", "when": dv_all([c2_window(2, 570, 600), c2_at("mora", "living_hall")]), "text": "苏泠擦净耳件，在茉拉指导下试用听诊器。", "received_speech_requirement": {"speaker": "mora", "action_id": "mora.c2.stethoscope-consent"}}]

axiom c2daily_task_law(task):
    let pre = dv_all([c2_at(task.actor, task.room), task.when, dv_fact(c2daily_ref(task.field), false)])
    return dv_axiom("c2daily_task_law", 1, pre, [dv_assign(c2daily_ref(task.field), true)])

fn c2daily_install_scene(scene):
    if dv_find(scene, "chapter2_daily_installed", false):
        return scene
    let source = c2_approved("real-sixteen-portion-lunch-deduct-stock-once")
    var fields = {"meal_cooked": dv_field(false), "meal_prepared": dv_field(false), "portions": dv_field(0), "draft_notes": dv_field(false), "rare_color_layer": dv_field("夹道罕见紫金以太色层"), "council_ended": dv_field(false), "underground_tremor": dv_field(false), "votes.open_plan": dv_field(0), "votes.seal_plan": dv_field(0), "votes.committee_plan": dv_field(0)}
    let tasks = c2daily_tasks()
    var t = 0
    while t < rt_count(tasks):
        fields = dv_with(fields, tasks[t].field, dv_field(false))
        t = t + 1
    let people = c2_people()
    var f = 0
    while f < rt_count(people):
        fields = dv_with(fields, rt_cat("signed.", people[f]), dv_field(false))
        fields = dv_with(fields, rt_cat("voted.", people[f]), dv_field(false))
        fields = dv_with(fields, rt_cat("ballot.", people[f]), dv_unknown())
        fields = dv_with(fields, rt_cat("guarding.", people[f]), dv_field(false))
        f = f + 1
    fields = dv_with(fields, "council_closed", dv_field(false))
    var physical = c2_add_new(scene.physical, c2_object("c2.daily", "living_hall", fields))
    physical = dv_adopt(physical, c1_method("c2.daily.council-end", c2daily_council_end_law()), "enforce", 1, source)
    var processes = dv_clone(dv_find(scene, "world_processes", []))
    rt_push(processes, {"id": "c2.daily.council-end", "law": "c2.daily.council-end", "basis": [source]})
    let closing_source = c2_approved("user:2026-10-18章末授权")
    physical = dv_adopt(physical, c1_method("c2.daily.council-close", c2daily_council_close_law()), "enforce", 1, [closing_source])
    physical = dv_adopt(physical, c1_method("c2.daily.tremor", c2daily_tremor_law()), "enforce", 1, [closing_source])
    rt_push(processes, {"id": "c2.daily.council-close", "law": "c2.daily.council-close", "once": true, "basis": [closing_source]})
    rt_push(processes, {"id": "c2.daily.tremor", "law": "c2.daily.tremor", "once": true, "basis": [closing_source]})
    let watch_states = [true, false]
    var w = 0
    while w < rt_count(watch_states):
        let id = rt_cat("c2.daily.watch.", rt_show(watch_states[w]))
        physical = dv_adopt(physical, c1_method(id, c2daily_watch_law(watch_states[w])), "enforce", 1, source)
        rt_push(processes, {"id": id, "law": id, "basis": [source]})
        w = w + 1
    var bindings = dv_clone(scene.bindings)
    var actors = []
    var i = 0
    while i < rt_count(scene.actors):
        var actor = scene.actors[i]
        var mind = c2_add_new(actor.mind, c1_local_object("c2.daily"))
        rt_push(bindings, dv_binding("c2.daily", "c2.daily", actor.id))
        mind = dv_store(mind, c2daily_ref(rt_cat("signed.", actor.id)), dv_field(false))
        mind = dv_store(mind, c2daily_ref(rt_cat("voted.", actor.id)), dv_field(false))
        if actor.id == "demon":
            mind = dv_store(mind, c2daily_ref("rare_color_layer"), dv_field("夹道罕见紫金以太色层"))
        var actions = dv_clone(actor.actions)
        t = 0
        while t < rt_count(tasks):
            let task = tasks[t]
            if actor.id == task.actor:
                let law = c2daily_task_law(task)
                physical = dv_adopt(physical, c1_method(task.id, law), "enforce", 1, source)
                mind = dv_adopt(mind, c1_method(task.id, law), "predict", 1, source)
                mind = dv_store(mind, c2daily_ref(task.field), dv_field(false))
                var action = dv_with(c2_action(task.id, "help", law.premise, law.premise, task.id, [c2daily_ref(task.field)], task.text, source), "predict_law", task.id)
                if dv_has_key(task, "received_speech_requirement"):
                    action = dv_with(action, "received_speech_requirement", task.received_speech_requirement)
                rt_push(actions, action)
            t = t + 1
        if actor.id == "ruan":
            let id = "ruan.c2.draft-notes"
            let law = c2daily_draft_law()
            physical = dv_adopt(physical, c1_method(id, law), "enforce", 1, source)
            mind = dv_adopt(mind, c1_method(id, law), "predict", 1, source)
            mind = dv_store(mind, c2daily_ref("draft_notes"), dv_field(false))
            rt_push(actions, dv_with(c2_action(id, "help", law.premise, law.premise, id, [c2daily_ref("draft_notes")], "阮清月留出补记栏，写下夜间取用者、份数、用途和次日核对的草案。", source), "predict_law", id))
        if actor.id == "shen":
            let id = "shen.c2.daily.cook-sixteen"
            let law = c2daily_cook_law()
            physical = dv_adopt(physical, c1_method(id, law), "enforce", 1, source)
            mind = dv_adopt(mind, c1_method(id, law), "predict", 1, source)
            mind = dv_store(mind, c2daily_ref("meal_prepared"), dv_field(false))
            mind = dv_store(mind, c2daily_ref("meal_cooked"), dv_field(false))
            rt_push(actions, dv_with(c2_action(id, "help", law.premise, law.premise, id, [c2daily_ref("meal_cooked"), c2daily_ref("portions"), c2_ref("c2.counter", "remaining")], "沈鼎把十六份口粮做成烩菜、热汤和面饼。", source), "predict_law", id))
            let delivery = "shen.c2.daily.deliver-sixteen"
            let delivery_law = c2daily_deliver_law()
            physical = dv_adopt(physical, c1_method(delivery, delivery_law), "enforce", 1, source)
            mind = dv_adopt(mind, c1_method(delivery, delivery_law), "predict", 1, source)
            rt_push(actions, dv_with(c2_action(delivery, "help", delivery_law.premise, delivery_law.premise, delivery, [c2daily_ref("meal_prepared")], "沈鼎把热饭摆上起居厅的四张桌子。", source), "predict_law", delivery))
        if dv_has(c2_people(), actor.id):
            let id = rt_cat(actor.id, ".c2.daily.serve")
            let law = c2daily_serve_law(actor.id)
            physical = dv_adopt(physical, c1_method(id, law), "enforce", 1, source)
            mind = dv_adopt(mind, c1_method(id, law), "predict", 1, source)
            rt_push(actions, dv_with(c2_action(id, "help", law.premise, law.premise, id, [c2daily_ref("portions"), c2_own(actor.id, "rations"), c2_own(actor.id, "collected.2.noon")], "从热饭中领自己的一份。", source), "predict_law", id))
        rt_push(actions, c2_inspect_action(actor.id, "c2.daily", "living_hall", ["meal_prepared", "portions", "draft_notes"], "查看饭桌与补记草案。", source))
        rt_push(actions, dv_with(c2_inspect_action(actor.id, "c2.daily", "central_hall", ["draft_notes"], "查看补记草案。", source), "id", rt_cat(actor.id, ".c2.daily.inspect-central")))
        let venues = ["oath_court", "central_hall"]
        var venue_index = 0
        while venue_index < rt_count(venues):
            let room = venues[venue_index]
            let when = dv_all([c2_at(actor.id, room), c1_any(dv_fact(c2daily_ref("council_closed"), true), dv_at_least(c2_clock(), 6330))])
            var closing = c2_inspect_action(actor.id, "c2.daily", room, c2daily_closing_fields(), "在会场核对投票、签名与议事收束记录，留意脚下的动静。", closing_source)
            closing = dv_with_many(closing, {"id": rt_cat(actor.id, rt_cat(".c2.daily.closing.", room)), "precondition": when, "authority_precondition": when})
            rt_push(actions, closing)
            venue_index = venue_index + 1
        actor = dv_with_many(actor, {"mind": mind, "actions": c1_public_methods(actions)})
        rt_push(actors, actor)
        i = i + 1
    return dv_with_many(scene, {"physical": physical, "bindings": bindings, "actors": actors, "chapter2_daily_installed": true, "world_processes": processes})

// Native optional chapter-two conversations. Only local successful speech is heard.
// Dates open opportunities; they do not place people, settle a dispute or invent illness.

fn c2d_ref(field):
    return c2_ref("c2.dialogue", field)

fn c2d_person_ref(actor, field):
    return c2_ref(rt_cat("c2.dialogue.person.", actor), field)

fn c2d_mark(actor, method):
    return c2d_person_ref(actor, rt_cat("said.", method))

fn c2d_source(file, line, id):
    return c2_source(file, line, id)

fn c2d_people():
    return dv_append(c2_people(), "demon")

fn c2d_row(actor, id, room, when, literal, text, source):
    return {"actor": actor, "id": id, "room": room, "when": when, "literal": literal, "text": text, "source": source}

fn c2d_question(id, room, when, target, topic, text, refs, source):
    return dv_with_many(c2d_row("detective", id, room, when, dv_true(), text, source), {"request": {"target": target, "topic": topic}, "purpose_refs": refs, "category": "case"})

fn c2d_reply(actor, id, room, when, literal, topic, text, source):
    return dv_with(c2d_row(actor, id, room, when, literal, text, source), "response_topic", topic)

fn c2d_introductions():
    let key = ["authored-declaration", "c2d_introductions"]
    let cached = rt_memo_get([], key)
    if cached[0]:
        return cached[1]
    return rt_memo_put([], key, c2d_introductions_build())

fn c2d_introductions_build():
    return [
        {"actor": "ward", "text": "弗雷德里克·沃德，执业律师，甲区。", "source": c2d_source("06_场面.story", 25, "chapter2.meet_jia.002")},
        {"actor": "gu", "text": "老朽顾平章，读碑的。", "source": c2d_source("06_场面.story", 31, "chapter2.meet_jia.008")},
        {"actor": "selma", "text": "赛尔玛，采标本的。你们是乙区的？", "source": c2d_source("06_场面.story", 57, "chapter2.meet_bing.002")},
        {"actor": "ruan", "text": "阮清月。下棋。", "source": c2d_source("06_场面.story", 58, "chapter2.meet_bing.003")},
        {"actor": "moran", "text": "……莫兰。", "source": c2d_source("06_场面.story", 60, "chapter2.meet_bing.005")},
        {"actor": "mora", "text": "茉拉，医生。", "source": c2d_source("06_场面.story", 136, "chapter2.meet_ding.003")},
        {"actor": "bertrand", "text": "贝尔特朗，丁区。", "source": c2d_source("06_场面.story", 137, "chapter2.meet_ding.004")},
        {"actor": "margaret", "text": "玛格丽特，盖房子的。", "source": c2d_source("06_场面.story", 138, "chapter2.meet_ding.005")},
        {"actor": "veronica", "text": "维罗妮卡，化学。", "source": c2d_source("06_场面.story", 139, "chapter2.meet_ding.006")}]

fn c2d_curriculum():
    return [
        {"id": "lesson11", "title": "守则读法", "text": "入夜之后，诸位留于室内。已开放的封闭连廊也须核对密封、通风和现场读数。源质计在户外仪器阵入口，先在安全侧学会读数，再定路线。低洼、夜间与无风时易积灰，风止或地震后停行复测。读数不明时，留在已确认安全处，呼叫协助。", "source": c1_source("docs/design-standard.md", 0, "最低限度安全教学")},
        {"id": "lesson12", "title": "传声与机械", "text": "传声管两端都能传声。先核对通路与盖片，发话、复述分开进行；同时说话会互相遮盖。管口附近的话也可能传到另一端。", "source": c2d_source("07_家具与文本.story", 86, "第十二课.内容")},
        {"id": "lesson13", "title": "言灵初阶", "text": "十个词、基本语法：名词居首、条件居中、动词收尾。练习：两盏灯只灭一盏。", "source": c2d_source("07_家具与文本.story", 88, "第十三课.内容")},
        {"id": "lesson14", "title": "异象与记忆", "text": "辨别自己看见的、别人告诉你的，和自己盼着是真的。熟悉感只是一条线索，地点、时长与缘由仍需各自查证。", "source": c1_source("docs/design-standard.md", 0, "前两章的信息边界")}]

fn c2d_rows():
    let key = ["authored-declaration", "c2d_rows"]
    let cached = rt_memo_get([], key)
    if cached[0]:
        return cached[1]
    return rt_memo_put([], key, c2d_rows_build())

fn c2d_rows_build():
    var rows = []
    let contract_ref = c2d_ref("contract_full_text")
    let contract_source = c1_source("docs/design-standard.md", 0, "主动询问契约全文")
    let trace = dv_all([dv_fact(c1_knowledge("shelf_old"), true), dv_fact(c1_knowledge("hand_not_mine"), true), dv_fact(dv_ref("demon.body", "state", "hand_shape"), "long-narrow-hand"), dv_fact(dv_ref("demon.body", "state", "shelf_print_owner"), "demon")])
    let rule4 = dv_fact(c2d_ref("school_rule4"), "我所立之规，皆张贴于此。")
    var authority = c2d_question("detective.c2.ask-seal-authority", "living_hall", trace, "demon", "contract.seal-authority", "架沿的窄手印与你的手形相合。你说封存之物是你取走的；谁授权你封存？", [], contract_source)
    authority = dv_with_many(authority, {"category": "contract", "received_speech_requirement": {"speaker": "demon", "action_id": "demon.departure.answer-print"}})
    rt_push(rows, authority)
    let sealed = dv_fact(c2d_ref("seal_authority"), "契约")
    rt_push(rows, c2d_reply("demon", "demon.c2.seal-authority", "living_hall", dv_true(), sealed, "contract.seal-authority", "封存的权限来自契约。", contract_source))
    var other_rules = c2d_question("detective.c2.ask-other-rules", "lecture", dv_all([rule4, sealed]), "demon", "contract.other-rules", "第四条说“我所立之规，皆张贴于此”。是否意味着尚有非你所立之规？", [], contract_source)
    other_rules = dv_with_many(other_rules, {"category": "contract", "received_speech_requirement": {"speaker": "demon", "action_id": "demon.c2.school-rule4"}})
    rt_push(rows, other_rules)
    rt_push(rows, c2d_reply("demon", "demon.c2.other-rules", "lecture", dv_true(), dv_fact(c2d_ref("authority_bounded"), true), "contract.other-rules", "是。还有我也须遵守的契约。", contract_source))
    var origin = c2d_question("detective.c2.ask-rule-authority", "lecture", rule4, "demon", "contract.rule-authority", "你既须遵守契约，又由契约取得封存权限，那么契约是谁立的？权限究竟从哪里来？", [], contract_source)
    origin = dv_with_many(origin, {"category": "contract", "received_speech_requirement": {"speaker": "demon", "action_id": "demon.c2.other-rules"}})
    rt_push(rows, origin)
    let bounded = dv_fact(c2d_ref("authority_bounded"), true)
    rt_push(rows, c2d_reply("demon", "demon.c2.rule-authority", "lecture", dv_true(), bounded, "contract.rule-authority", "我也受契约约束。", contract_source))
    var full = c2d_question("detective.c2.ask-contract", "lecture", dv_all([trace, rule4, sealed, bounded]), "demon", "contract.full-text", "那么请把约束你、也规定你权限来源的契约全文告诉我们。", [contract_ref], contract_source)
    full = dv_with_many(full, {"category": "contract", "received_speech_requirement": {"speaker": "demon", "action_id": "demon.c2.rule-authority"}})
    rt_push(rows, full)
    rt_push(rows, c2d_reply("demon", "demon.c2.contract-full-text", "lecture", dv_true(), dv_fact(contract_ref, c1_op_contract_text()), "contract.full-text", c1_op_contract_text(), contract_source))
    let people = c2_people()
    var p = 0
    while p < rt_count(people):
        let known_contract = dv_fact(contract_ref, c1_op_contract_text())
        rt_push(rows, c2d_row(people[p], rt_cat(people[p], ".c2.share-contract"), "living_hall", known_contract, known_contract, c1_op_contract_text(), contract_source))
        p = p + 1
    let daily = c2daily_rows()
    var d = 0
    while d < rt_count(daily):
        rt_push(rows, daily[d])
        d = d + 1
    let intros = c2d_introductions()
    var i = 0
    while i < rt_count(intros):
        let intro = intros[i]
        let literal = dv_fact(c2d_person_ref(intro.actor, "introduction"), intro.text)
        let row = c2d_row(intro.actor, rt_cat(intro.actor, ".c2.dialogue.introduce"), "living_hall", literal, literal, intro.text, intro.source)
        rt_push(rows, dv_with(row, "opportunity", {"location": "living_hall", "participants": ["detective"], "mode": "all-present"}))
        i = i + 1
    let courses = c2d_curriculum()
    i = 0
    while i < rt_count(courses):
        let course = courses[i]
        let literal = dv_fact(c2d_ref(course.id), course.text)
        var row = c2d_row("demon", rt_cat("demon.c2.teach.", course.id), "lecture", dv_all([dv_fact(c2_access("north"), true), literal]), literal, course.text, course.source)
        row = dv_with(row, "opportunity", {"location": "lecture", "participants": c2_people(), "mode": "at-least-one-present"})
        rt_push(rows, row)
        i = i + 1
    let before = dv_fact(c2d_mark("demon", "demon.c2.teach.lesson11"), true)
    rt_push(rows, c2d_row("demon", "demon.c2.lesson11.close", "lecture", before, dv_true(), "本课到此。诸位所立之规，也请这样读。下课。", c2d_source("06_场面.story", 90, "chapter2.lesson.005")))
    let rooms = ["central_hall", "logistics", "clinic"]
    i = 0
    while i < rt_count(rooms):
        let room = rooms[i]
        let after_night = dv_true()
        rt_push(rows, c2d_question(rt_cat("detective.c2.ask.mora.", room), room, after_night, "mora", "night_patient_food", "台账有待核对的差额。你夜里取过口粮吗？用途是什么？", [c2_own("mora", "night_taken")], c2d_source("00_时间与文案.story", 87, "质询问题：取用")))
        rt_push(rows, c2d_question(rt_cat("detective.c2.ask.quer.", room), room, after_night, "quer", "night_self_food", "夜里取过口粮吗？", [c2_own("quer", "night_taken")], c2d_source("04_案件.story", 76, "夜取自粮的质询")))
        rt_push(rows, c2d_question(rt_cat("detective.c2.ask.latch.", room), room, after_night, "quer", "latch_repair", "粮仓的门闩修过吗？", [c2d_person_ref("quer", "repaired_latch")], c2d_source("00_时间与文案.story", 89, "质询问题：门闩")))
        rt_push(rows, c2d_question(rt_cat("detective.c2.ask.ledger.", room), room, after_night, "ruan", "night_ledger", "这些取用已经记了哪些，还有哪些待核对？", [c2_ref("c2.ledger", "night_recorded")], c2d_source("00_时间与文案.story", 90, "质询问题：台账")))
        rt_push(rows, c2d_question(rt_cat("detective.c2.ask.shadow.", room), room, after_night, "bertrand", "night_shadow", "你夜巡时，看见了什么？", [c2d_person_ref("bertrand", "small_shadow_seen")], c2d_source("04_案件.story", 19, "夜巡所见")))
        let mora_fact = dv_all([dv_fact(c2_own("mora", "night_taken"), true), dv_fact(c2d_person_ref("mora", "patient_food_reason"), true)])
        rt_push(rows, c2d_reply("mora", rt_cat("mora.c2.reply.patient_food.", room), room, mora_fact, mora_fact, "night_patient_food", "我为病人夜里取过口粮。取用和补记可以一起核对。", c2d_source("04_案件.story", 73, "夜取病粮：反应（次日措辞适配）")))
        let quer_fact = dv_all([dv_fact(c2_own("quer", "night_taken"), true), dv_fact(c2_own("quer", "accepted.mora_night"), true)])
        rt_push(rows, c2d_reply("quer", rt_cat("quer.c2.reply.self_food.", room), room, quer_fact, quer_fact, "night_self_food", "我夜里取过口粮，也认了急需可以自取、随后补记这条。记录可以一起核对。", c2d_source("04_案件.story", 80, "夜取自粮：反应·雀儿（次日措辞适配）")))
        let repaired = dv_fact(c2d_person_ref("quer", "repaired_latch"), true)
        rt_push(rows, c2d_reply("quer", rt_cat("quer.c2.reply.repair.", room), room, repaired, repaired, "latch_repair", "门闩松了，是我修的。", c2d_source("04_案件.story", 85, "修门闩：反应")))
        let ledger = dv_all([dv_fact(c2_ref("c2.ledger", "night_recorded"), 0), dv_at_least(c2_ref("c2.ledger", "day_recorded"), 1)])
        rt_push(rows, c2d_reply("ruan", rt_cat("ruan.c2.reply.ledger.", room), room, ledger, ledger, "night_ledger", "我看到的台账上已有白天领取记录，夜间补记这一栏还是空的。", c2d_source("04_案件.story", 91, "台账：反应")))
        let small = dv_fact(c2d_person_ref("bertrand", "small_shadow_seen"), true)
        rt_push(rows, c2d_reply("bertrand", rt_cat("bertrand.c2.reply.shadow.", room), room, small, small, "night_shadow", "身影是看见了。是谁，我没看清。", c2d_source("04_案件.story", 102, "夜巡望见的身影：反应")))
        i = i + 1
    let requested_repair = dv_fact(c2d_person_ref("margaret", "requested_latch_repair"), true)
    let marks = dv_fact(c2_ref("c2.granary", "tool_marks"), true)
    let repair_witness = c2d_row("margaret", "margaret.c2.testimony.repair", "central_hall", dv_all([requested_repair, marks]), dv_all([requested_repair, marks]), "我请雀儿修过门闩。现在能看见工具痕，谁实际动过手还得另问。", c2d_source("04_案件.story", 86, "修门闩：反应·雀儿"))
    rt_push(rows, dv_with(repair_witness, "opportunity", {"location": "central_hall", "participants": ["detective", "quer"], "mode": "all-present"}))
    let council = c2d_council_when()
    let places = ["oath_court", "central_hall"]
    i = 0
    while i < rt_count(places):
        let room = places[i]
        var weather = dv_fact(c2_ref("c2.weather", "wind"), true)
        if room == "central_hall":
            weather = dv_fact(c2_ref("c2.weather", "wind"), false)
        let when = dv_all([council, weather])
        let source = c1_source("docs/design-standard.md", 0, "第五日物资与安全公约")
        let proposals = c2_norms()
        var n = 0
        while n < rt_count(proposals):
            let norm = proposals[n]
            if dv_has(["open_plan", "seal_plan", "committee_plan"], norm.id):
                let literal = dv_fact(c2_ref(c2_norm_object(norm.id), "text"), norm.surface)
                let row = c2d_row(norm.owner, rt_cat(norm.owner, rt_cat(".c2.council.proposal.", rt_cat(room, norm.id))), room, dv_all([when, c2d_stance(norm.owner, norm.id)]), literal, norm.surface, source)
                rt_push(rows, dv_with(row, "norm_proposal", norm))
            n = n + 1
        i = i + 1
    return rows

fn c2d_council_when():
    return dv_all([c2_window(5, 450, 570), dv_fact(c2_ref("c2.weather", "daylight"), true)])

// The actor must actually receive a proposal before treating council as an opportunity.
fn c2d_known_council_proposal():
    let norms = c2_norms()
    var known = dv_not(dv_true())
    var i = 0
    while i < rt_count(norms):
        let norm = norms[i]
        if dv_has(["open_plan", "seal_plan", "committee_plan"], norm.id):
            known = c1_any(known, dv_fact(c2_ref(c2_norm_object(norm.id), "text"), norm.surface))
        i = i + 1
    return known

fn c2d_stance(actor, norm):
    let accepted = dv_fact(c2_own(actor, rt_cat("accepted.", norm)), true)
    let norms = c2_norms()
    var i = 0
    while i < rt_count(norms):
        if norms[i].id == norm and norms[i].owner == actor:
            return c1_any(accepted, dv_fact(c2_ref(c2_norm_object(norm), "proposed"), true))
        i = i + 1
    return accepted

axiom c2d_row_law(row):
    var effects = dv_single(dv_assign(c2d_mark(row.actor, row.id), true))
    let extra = dv_find(row, "effects", [])
    var i = 0
    while i < rt_count(extra):
        rt_push(effects, extra[i])
        i = i + 1
    return dv_axiom("c2d_row_law", 1, dv_all([c2_at(row.actor, row.room), row.when]), effects)

axiom c2d_spoke_law(actor, method, room):
    return dv_axiom("c2d_spoke_law", 1, c2_at(actor, room), dv_single(dv_assign(c2d_mark(actor, method), true)))

axiom c2d_read_scope_law():
    return dv_axiom("c2d_read_scope_law", 1, dv_fact(c2d_ref("indoor_rule"), "入夜之后，诸位留于室内。"), dv_single(dv_assign(c2d_person_ref("detective", "scope_undefined"), true)))

fn c2d_action(row):
    let known = dv_all([c2_at(row.actor, row.room), row.when, row.literal, dv_fact(c2d_mark(row.actor, row.id), false)])
    var speech = dv_with_many(c1_speech(row.literal, row.source, "chapter2-owned-statement"), {"surface": row.text, "channel": "local"})
    if dv_has_key(row, "request"):
        speech = dv_with_many(speech, {"request": row.request, "utterance_type": "question"})
    var grants = dv_single(c2d_mark(row.actor, row.id))
    let effects = dv_find(row, "effects", [])
    var e = 0
    while e < rt_count(effects):
        rt_push(grants, effects[e].ref)
        e = e + 1
    // Actor-only observations after applied Complete; never speech propagation
    // or a claim that an environment effect has already happened in prediction.
    let observation_grants = dv_find(row, "observation_grants", [])
    e = 0
    while e < rt_count(observation_grants):
        if not dv_has(grants, observation_grants[e]):
            rt_push(grants, observation_grants[e])
        e = e + 1
    var raw_listeners = c2d_people()
    if not dv_has_key(row, "norm_proposal"):
        if dv_has_key(row, "opportunity"):
            let parts = dv_find(row.opportunity, "participants", [])
            if 0 < rt_count(parts):
                raw_listeners = dvp_merge_refs(parts, ["detective"])
        else:
            if dv_has_key(row, "request"):
                raw_listeners = [row.request.target, "detective"]
            else:
                if dv_has_key(row, "response_topic"):
                    raw_listeners = ["detective"]
    var listeners = []
    var l = 0
    while l < rt_count(raw_listeners):
        if raw_listeners[l] != row.actor:
            rt_push(listeners, raw_listeners[l])
        l = l + 1
    var action = dv_with_many(c2_action(row.id, "talk", known, dv_all([c2_at(row.actor, row.room), row.when]), row.id, grants, row.text, row.source), {"speech": speech, "listeners": listeners, "predict_law": row.id, "owner": row.actor, "purpose_refs": dv_find(row, "purpose_refs", []), "required_room": row.room})
    if dv_has_key(row, "norm_proposal"):
        action = dv_with(action, "speech", dv_with_many(speech, {"utterance_type": "proposal", "norm_proposal": row.norm_proposal}))
    if dv_has_key(row, "personal_choice"):
        action = dv_with(action, "personal_choice", row.personal_choice)
    if row.actor == "demon":
        action = c1_authorized_speech(action)
    if dv_has_key(row, "response_topic"):
        action = dv_with_many(action, {"response_topic": row.response_topic, "requires_actual_request": true})
    if dv_has_key(row, "opportunity"):
        action = dv_with(action, "opportunity_requirement", row.opportunity)
    if dv_has_key(row, "received_speech_requirement"):
        action = dv_with(action, "received_speech_requirement", row.received_speech_requirement)
    if dv_find(row, "category", "") == "case":
        action = dv_with_many(action, {"case_method": true, "case_base_when": known})
    return action

axiom c2d_start_watch_law():
    return dv_axiom("c2d_start_watch_law", 1, dv_all([c1_at("bertrand", "logistics"), c2_any_night(), c2_alive("bertrand")]), dv_single(dv_assign(c2d_person_ref("bertrand", "watching"), true)))

axiom c2d_small_shadow_law(person):
    return dv_axiom("c2d_small_shadow_law", 1, dv_all([c1_at("bertrand", "logistics"), c2_any_night(), dv_fact(c2d_person_ref("bertrand", "watching"), true), c2_alive("bertrand"), dv_fact(c2d_person_ref("bertrand", "small_shadow_seen"), false), c1_at(person, "logistics"), c2_alive(person)]), dv_single(dv_assign(c2d_person_ref("bertrand", "small_shadow_seen"), true)))

fn c2d_watch_actions(actor):
    if actor != "bertrand":
        return []
    let source = c2d_source("04_案件.story", 25, "小巧身影的有限观察")
    let pre = dv_all([c2_at(actor, "logistics"), c2_any_night(), c2_alive(actor)])
    let watch = c2_action("bertrand.c2.watch.start", "help", pre, pre, "bertrand.c2.watch.start", dv_single(c2d_person_ref(actor, "watching")), "提着灯，守在后勤院。", source)
    let inspect = c2_action("bertrand.c2.watch.observe", "inspect", dv_all([pre, dv_fact(c2d_person_ref(actor, "watching"), true)]), pre, "", dv_single(c2d_person_ref(actor, "small_shadow_seen")), "留意夜里的身影。", source)
    return [dv_with(watch, "predict_law", "bertrand.c2.watch.start"), dv_with(inspect, "repeatable", true)]

axiom c2d_repair_record_law(actor):
    let original = c2_repair_latch_law(actor)
    return dv_axiom("c2d_repair_record_law", 1, original.premise, dv_append(original.effects, dv_assign(c2d_person_ref(actor, "repaired_latch"), true)))

axiom c2d_request_repair_record_law():
    let original = c2_latch_request_law("margaret", "quer")
    return dv_axiom("c2d_request_repair_record_law", 1, original.premise, dv_append(original.effects, dv_assign(c2d_person_ref("margaret", "requested_latch_repair"), true)))

axiom c2d_patient_take_record_law():
    let original = c2_night_take_law("mora", true)
    return dv_axiom("c2d_patient_take_record_law", 1, original.premise, dv_append(original.effects, dv_assign(c2d_person_ref("mora", "patient_food_reason"), true)))

fn c2d_objects():
    var objects = [c2_object("c2.dialogue", "lecture", {"indoor_rule": dv_field("入夜之后，诸位留于室内。"), "indoor_definition_given": dv_field(false), "contract_full_text": dv_field(c1_op_contract_text()), "school_rule4": dv_field("我所立之规，皆张贴于此。"), "seal_authority": dv_field("契约"), "authority_bounded": dv_field(true)})]
    let courses = c2d_curriculum()
    var i = 0
    while i < rt_count(courses):
        objects = dvs_replace(objects, 0, dv_with(objects[0], "facets", dv_with(objects[0].facets, "state", dv_with(objects[0].facets.state, courses[i].id, dv_field(courses[i].text)))))
        i = i + 1
    let people = c2d_people()
    let rows = c2d_rows()
    i = 0
    while i < rt_count(people):
        var fields = {"repaired_latch": dv_field(false), "requested_latch_repair": dv_field(false), "patient_food_reason": dv_field(false), "watching": dv_field(false), "small_shadow_seen": dv_field(false), "scope_undefined": dv_unknown()}
        var j = 0
        while j < rt_count(rows):
            if rows[j].actor == people[i]:
                fields = dv_with(fields, rt_cat("said.", rows[j].id), dv_field(false))
            j = j + 1
        let intros = c2d_introductions()
        j = 0
        while j < rt_count(intros):
            if intros[j].actor == people[i]:
                fields = dv_with(fields, "introduction", dv_field(intros[j].text))
            j = j + 1
        rt_push(objects, c2_object(rt_cat("c2.dialogue.person.", people[i]), "", fields))
        i = i + 1
    return objects

fn c2d_case_gate(mind):
    let refs = [c2_ref("c2.ledger", "counted"), c2_ref("c2.ledger", "reserve_received"), c2_ref("c2.counter", "remaining"), c2_ref("c2.ledger", "day_recorded"), c2_ref("c2.ledger", "night_recorded"), c2_ref("c2.ledger", "pending_registered")]
    var values = []
    var premises = []
    var i = 0
    while i < rt_count(refs):
        let cell = dv_read(mind, refs[i])
        if not dv_uncontested(cell):
            return dv_not(dv_true())
        rt_push(values, cell.value)
        rt_push(premises, dv_fact(refs[i], cell.value))
        i = i + 1
    if values[0] > 0 and values[2] + values[3] + values[4] + values[5] < values[0] + values[1]:
        return dv_all(premises)
    return dv_not(dv_true())

fn c2d_goals(actor):
    var goals = []
    let rows = c2d_rows()
    let tasks = c2daily_tasks()
    var t = 0
    while t < rt_count(tasks):
        if tasks[t].actor == actor.id:
            rt_push(goals, c2_goal(dv_fact(c2daily_ref(tasks[t].field), true), tasks[t].when, [c2_approved("real-daily-contact-action")]))
        t = t + 1
    rt_push(goals, c2_observation_goal(c2daily_ref("meal_prepared"), c2_window(2, 690, 810), [c2_approved("look-for-real-lunch")], 0))
    if actor.id == "shen":
        rt_push(goals, c2_goal(c2_at("shen", "central_hall"), dv_all([c2_window(2, 690, 810), dv_fact(c2daily_ref("meal_cooked"), false), dv_not(c2_at("shen", "logistics"))]), [c2_approved("cook-real-lunch")]))
        rt_push(goals, c2_goal(c2_at("shen", "logistics"), dv_all([c2_window(2, 690, 810), dv_fact(c2daily_ref("meal_cooked"), false)]), [c2_approved("cook-real-lunch")]))
        rt_push(goals, c2_goal(dv_fact(c2daily_ref("meal_cooked"), true), c2_window(2, 690, 810), [c2_approved("cook-real-lunch")]))
        rt_push(goals, c2_goal(c2_at("shen", "central_hall"), dv_all([c2_window(2, 690, 810), dv_fact(c2daily_ref("meal_cooked"), true), dv_not(c2_at("shen", "living_hall")), dv_fact(c2daily_ref("meal_prepared"), false)]), [c2_approved("deliver-real-lunch")]))
        rt_push(goals, c2_goal(c2_at("shen", "living_hall"), dv_all([c2_window(2, 690, 810), dv_fact(c2daily_ref("meal_cooked"), true), dv_fact(c2daily_ref("meal_prepared"), false)]), [c2_approved("deliver-real-lunch")]))
        rt_push(goals, c2_goal(dv_fact(c2daily_ref("meal_prepared"), true), c2_window(2, 690, 810), [c2_approved("cook-real-lunch")]))
    if actor.id == "ruan":
        rt_push(goals, c2_goal(dv_fact(c2daily_ref("draft_notes"), true), c2daily_notes_window(), [c2_approved("draft-notes-through-real-action")]))
    var i = 0
    while i < rt_count(rows):
        let row = rows[i]
        if row.actor == actor.id:
            var when = dv_all([row.when, row.literal, dv_fact(c2d_mark(actor.id, row.id), false)])
            if dv_find(row, "category", "") == "case":
                when = dv_all([when, c2d_case_gate(actor.mind)])
            rt_push(goals, c1n_index_goal_window({"kind": "communicate", "scope": "personal", "method_id": row.id, "available_when": when, "basis": [row.source], "requires_argument": false}))
        i = i + 1
    let study = dv_all([dv_fact(c2_access("north"), true), c2_window(2, 600, 690)])
    if actor.id == "demon":
        rt_push(goals, c2_goal(c2_at("demon", "central_hall"), dv_all([study, dv_not(c2_at("demon", "lecture"))]), [c2d_source("06_场面.story", 79, "请到讲堂")]))
    rt_push(goals, c2_goal(c2_at(actor.id, "lecture"), study, [c2d_source("06_场面.story", 79, "请到讲堂")]))
    if actor.id == "bertrand":
        rt_push(goals, c2_goal(dv_fact(c2d_person_ref(actor.id, "watching"), true), c2_any_night(), [c1_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/14_贝尔特朗.story", 30, "夜里巡夜：护住同伴")]))
        rt_push(goals, c2_observation_goal(c2d_person_ref(actor.id, "small_shadow_seen"), dv_all([c2_any_night(), dv_fact(c2d_person_ref(actor.id, "watching"), true)]), [c2d_source("04_案件.story", 25, "有限身影观察")], 0))
    if actor.id == "detective":
        let ledger_fields = ["counted", "reserve_received", "day_recorded", "night_recorded", "pending_registered"]
        rt_push(goals, c2_observation_goal(c2_ref("c2.counter", "remaining"), c2_at(actor.id, "logistics"), [c1_source("docs/design-standard.md", 0, "实物清点与台账对照")], 0))
        i = 0
        while i < rt_count(ledger_fields):
            rt_push(goals, c2_observation_goal(c2_ref("c2.ledger", ledger_fields[i]), c2_at(actor.id, "logistics"), [c2d_source("04_案件.story", 10, "从读到账目再判断是否有缺口")], 0))
            i = i + 1
    if actor.id == "quer" or actor.id == "huo":
        rt_push(goals, c2_goal(dv_fact(c2_ref("c2.granary", "latch_loose"), false), dv_fact(c2_ref("c2.granary", "latch_loose"), true), [c2d_source("10_执行.story", 17, "RepairLatch")]))
    let opportunity = c2d_known_council_proposal()
    rt_push(goals, c2_goal(c2_at(actor.id, "oath_court"), dv_all([c2d_council_when(), c2_alive(actor.id), opportunity, dv_fact(c2_ref("c2.weather", "wind"), true)]), [c2d_source("06_场面.story", 340, "章二议事机会")]))
    rt_push(goals, c2_goal(c2_at(actor.id, "central_hall"), dv_all([c2d_council_when(), c2_alive(actor.id), opportunity, dv_fact(c2_ref("c2.weather", "wind"), false)]), [c1_source("docs/design-standard.md", 0, "无风时在中央厅议事")]))
    return goals

fn c2d_refresh_actor_goals(actor):
    let goals = c2d_goals(actor)
    var policy = dv_with(actor.policy, "chapter2_dialogue_goals", goals)
    var combined = c2_personal_goals(actor)
    var i = 0
    if actor.id == "demon":
        let carried = dv_find(actor.policy, "chapter1_carried_goals", [])
        while i < rt_count(carried):
            rt_push(combined, carried[i])
            i = i + 1
    i = 0
    while i < rt_count(goals):
        rt_push(combined, goals[i])
        i = i + 1
    var actions = actor.actions
    i = 0
    while i < rt_count(actions):
        if dv_find(actions[i], "case_method", false):
            actions = dvs_replace(actions, i, dv_with(actions[i], "precondition", dv_all([actions[i].case_base_when, c2d_case_gate(actor.mind)])))
        i = i + 1
    return dv_with_many(actor, {"policy": dv_with(policy, "goals", combined), "actions": actions})

fn c2d_install_scene(scene):
    if dv_find(scene, "chapter2_dialogue_installed", false):
        return scene
    var physical = scene.physical
    var bindings = dv_clone(scene.bindings)
    let objects = c2d_objects()
    var i = 0
    while i < rt_count(objects):
        physical = c2_add_new(physical, objects[i])
        i = i + 1
    let rows = c2d_rows()
    i = 0
    while i < rt_count(rows):
        physical = dv_adopt(physical, c1_method(rows[i].id, c2d_row_law(rows[i])), "enforce", 1, rows[i].source)
        i = i + 1
    physical = dv_adopt(physical, c1_method("bertrand.c2.watch.start", c2d_start_watch_law()), "enforce", 1, c2d_source("04_案件.story", 25, "有限巡夜"))
    var processes = dv_clone(dv_find(scene, "world_processes", []))
    let small_people = ["quer", "su", "elena"]
    i = 0
    while i < rt_count(small_people):
        let id = rt_cat("c2.dialogue.shadow.", small_people[i])
        let source = c2d_source("04_案件.story", 25, "瘦小身影：不据此辨人")
        physical = dv_adopt(physical, c1_method(id, c2d_small_shadow_law(small_people[i])), "enforce", 1, source)
        rt_push(processes, {"id": id, "law": id, "basis": [source]})
        i = i + 1
    let repair_source = c2d_source("10_执行.story", 17, "真实修理的本人记录")
    physical = dv_adopt(physical, c1_method("quer.c2.dialogue.record-repair", c2d_repair_record_law("quer")), "enforce", 1, repair_source)
    physical = dv_adopt(physical, c1_method("huo.c2.dialogue.record-repair", c2d_repair_record_law("huo")), "enforce", 1, repair_source)
    physical = dv_adopt(physical, c1_method("margaret.c2.dialogue.record-request", c2d_request_repair_record_law()), "enforce", 1, c2d_source("04_案件.story", 86, "玛格丽特的请托"))
    physical = dv_adopt(physical, c1_method("mora.c2.dialogue.record-patient-take", c2d_patient_take_record_law()), "enforce", 1, c2d_source("10_执行.story", 7, "NightTakeSick：本人行动理由"))
    var actors = []
    i = 0
    while i < rt_count(scene.actors):
        var actor = scene.actors[i]
        var mind = actor.mind
        var j = 0
        while j < rt_count(objects):
            mind = c2_add_new(mind, c1_local_object(objects[j].id))
            if dv_local(bindings, objects[j].id, actor.id) == "":
                rt_push(bindings, dv_binding(objects[j].id, objects[j].id, actor.id))
            j = j + 1
        // Only new protocol/identity self fields are initialized; all inherited bodies stay untouched.
        let own_fields = dv_get(dv_get(dv_find(physical, "objects", []), rt_cat("c2.dialogue.person.", actor.id)), "facets")
        let self_fields = own_fields.state
        j = 0
        while j < rt_count(self_fields):
            let field = self_fields[j]
            if field[0] != "small_shadow_seen" and field[0] != "scope_undefined":
                if not dv_read(mind, c2d_person_ref(actor.id, field[0])).known:
                    mind = dv_store(mind, c2d_person_ref(actor.id, field[0]), field[1])
            j = j + 1
        if actor.id == "demon":
            let curriculum_fields = objects[0].facets.state
            j = 0
            while j < rt_count(curriculum_fields):
                mind = dv_store(mind, c2d_ref(curriculum_fields[j][0]), curriculum_fields[j][1])
                j = j + 1
        var actions = dv_clone(actor.actions)
        j = 0
        while j < rt_count(rows):
            if rows[j].actor == actor.id:
                rt_push(actions, c2d_action(rows[j]))
                mind = dv_adopt(mind, c1_method(rows[j].id, c2d_row_law(rows[j])), "predict", 1, rows[j].source)
            j = j + 1
        let watch = c2d_watch_actions(actor.id)
        j = 0
        while j < rt_count(watch):
            rt_push(actions, watch[j])
            j = j + 1
        if actor.id == "bertrand":
            mind = dv_adopt(mind, c1_method("bertrand.c2.watch.start", c2d_start_watch_law()), "predict", 1, c2d_source("04_案件.story", 25, "本人巡夜选择"))
        j = 0
        while j < rt_count(actions):
            var action = actions[j]
            if actor.id == "quer" or actor.id == "huo":
                if action.id == rt_cat(actor.id, ".c2.repair.latch"):
                    let law = rt_cat(actor.id, ".c2.dialogue.record-repair")
                    action = dv_with_many(action, {"law": law, "predict_law": law, "grants": dv_append(action.grants, c2d_person_ref(actor.id, "repaired_latch"))})
                    mind = dv_adopt(mind, c1_method(law, c2d_repair_record_law(actor.id)), "predict", 1, repair_source)
            if action.id == "margaret.c2.request.repair_latch":
                let law = "margaret.c2.dialogue.record-request"
                action = dv_with_many(action, {"law": law, "predict_law": law, "grants": dv_append(action.grants, c2d_person_ref(actor.id, "requested_latch_repair"))})
                mind = dv_adopt(mind, c1_method(law, c2d_request_repair_record_law()), "predict", 1, c2d_source("04_案件.story", 86, "本人请求记录"))
            if action.id == "mora.c2.night_take.patient":
                let law = "mora.c2.dialogue.record-patient-take"
                action = dv_with_many(action, {"law": law, "predict_law": law, "grants": dv_append(action.grants, c2d_person_ref(actor.id, "patient_food_reason"))})
                mind = dv_adopt(mind, c1_method(law, c2d_patient_take_record_law()), "predict", 1, c2d_source("10_执行.story", 7, "NightTakeSick：本人行动理由"))
            actions = dvs_replace(actions, j, action)
            j = j + 1
        actor = dv_with_many(actor, {"mind": mind, "actions": c1_public_methods(actions), "policy": dv_with(actor.policy, "notice_co_presence", true)})
        rt_push(actors, c2d_refresh_actor_goals(actor))
        i = i + 1
    return dv_with_many(scene, {"physical": physical, "actors": actors, "bindings": bindings, "world_processes": processes, "chapter2_dialogue_installed": true})

// Display labels require the viewer's actual self-introduction receipt.
fn c2d_known_speaker_name(mind, actor):
    let intros = c2d_introductions()
    var i = 0
    while i < rt_count(intros):
        let intro = intros[i]
        if intro.actor == actor and dv_truth(mind, dv_fact(c2d_person_ref(actor, "introduction"), intro.text)) == "true":
            return c1_other_person(actor).name
        i = i + 1
    return ""

// Production composition; formal entry and debug configuration are unchanged.



















// Source module: language_core/game/player-content.dv
// Presentation migrated from the existing first-chapter authored cards and routes.
// Labels offer an interaction, not its unobserved result. Card prose is post-execution only.
fn c1_ui_ends(text, suffix):
    return rt_length(suffix) <= rt_length(text) and rt_slice(text, rt_length(text) - rt_length(suffix), rt_length(suffix)) == suffix

fn c1_player_scene(scene):
    var actors = []
    var i = 0
    while i < rt_count(scene.actors):
        let actor = scene.actors[i]
        var actions = []
        var j = 0
        while j < rt_count(actor.actions):
            rt_push(actions, c1_player_display(actor.actions[j]))
            j = j + 1
        rt_push(actors, dv_with(actor, "actions", actions))
        i = i + 1
    return dv_with(scene, "actors", actors)

fn c1_player_display(action):
    var result = action
    if action.kind == "move" and dv_has_key(action, "travel"):
        let rooms = {"R05": "自己的卧室", "R06": "霍铎的卧室", "R07": "沈鼎的卧室", "R08": "苏泠的卧室", "hall": "活动厅", "foyer": "门厅", "pantry": "茶水间", "corridor": "走廊"}
        if dv_has_key(rooms, action.travel.to):
