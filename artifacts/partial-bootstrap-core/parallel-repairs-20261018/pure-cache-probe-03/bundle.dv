fn dvs_factor_schema(domains, constraint):
    var assignments = constraint.assignments
    var scope = constraint.scope
    var versions = constraint.domain_versions
    var ids = []
    var facts = []
    var free = []
    var valid = true
    var i = 0
    var allids = []
    var refs = []
    if dv_or((rt_count(assignments) == 0), (rt_count(dv_find(constraint, "basis", [])) == 0)):
        valid = false
    while (i < rt_count(domains)):
        var domain = domains[i]
        var values = domains[i].values
        var j = 0
        var seen = []
        if dv_or(dv_has(allids, domain.id), dv_has(refs, domain.ref)):
            valid = false
        rt_push(allids, domain.id)
        rt_push(refs, domain.ref)
        if dv_or((rt_count(values) == 0), (not (0 < domain.version))):
            valid = false
        while (j < rt_count(values)):
            if dv_has(seen, values[j]):
                valid = false
            rt_push(seen, values[j])
            j = (j + 1)
        i = (i + 1)
    i = 0
    while (i < rt_count(assignments)):
        var assignment = assignments[i]
        var id = assignments[i].variable
        var domain = dvs_factor_domain(domains, assignments[i].variable)
        if dv_has(ids, id):
            valid = false
        rt_push(ids, id)
        if (domain == false):
            valid = false
        else:
            if dv_and(dv_has(domain.values, assignment.value), (dv_find(versions, id, -1) == domain.version)):
                false
            else:
                valid = false
            rt_push(facts, dv_fact(domain.ref, assignment.value))
        i = (i + 1)
    if (rt_count(scope) == rt_count(ids)):
        false
    else:
        valid = false
    i = 0
    while (i < rt_count(ids)):
        if dv_has(scope, ids[i]):
            false
        else:
            valid = false
        i = (i + 1)
    i = 0
    while (i < rt_count(scope)):
        if dv_has(ids, scope[i]):
            false
        else:
            valid = false
        i = (i + 1)
    if (rt_count(facts) == 1):
        if dv_same(constraint.condition, facts[0]):
            false
        else:
            valid = false
    else:
        if dv_same(constraint.condition, dv_all(facts)):
            false
        else:
            valid = false
    i = 0
    while (i < rt_count(domains)):
        if dv_has(ids, domains[i].id):
            false
        else:
            rt_push(free, domains[i])
        i = (i + 1)
    return {"valid": valid, "fixed": assignments, "free_domains": free}

