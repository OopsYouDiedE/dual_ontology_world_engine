// A transition receipt names the new stage, but only a heard question or an
// actual recheck establishes the current public opening in the person's mind.
fn c1_public_question_receipt_goal(stage, line, source_id):
    let opening = dv_ref("question", "state", rt_cat("open_", stage))
    let stage_ref = dv_ref("question", "state", "stage")
    return {"kind": "evidence", "scope": "personal", "owner": "detective", "ref": opening, "source": "perception", "minimum_time": 0, "refresh_until": dv_fact(opening, true), "refresh_refs": [stage_ref], "available_when": dv_fact(stage_ref, stage), "basis": [c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/07_答辩.story", line, source_id)]}

fn c1_public_goals():
