axiom c1_question_accept(question, stage):
    var effects = [dv_assign(dv_ref(question, "state", rt_cat("solved_", stage)), true), dv_assign(dv_ref(question, "state", rt_cat("open_", stage)), false), dv_assign(dv_ref(question, "state", "last_accepted"), stage)]
    var next = "complete"
    if stage == "identity":
        next = "voice_source"
    if stage == "voice_source":
        next = "words"
    if stage == "words":
        next = "trust"
    if next != "complete":
        rt_push(effects, dv_assign(dv_ref(question, "state", rt_cat("open_", next)), true))
    else:
        rt_push(effects, dv_assign(dv_ref(question, "state", "outstanding_complete"), false))
    rt_push(effects, dv_assign(dv_ref(question, "state", "current"), next))
    rt_push(effects, dv_assign(dv_ref(question, "state", "stage"), next))
    return dv_axiom("c1_question_accept", 1, dv_fact(dv_ref(question, "state", rt_cat("open_", stage)), true), effects)

