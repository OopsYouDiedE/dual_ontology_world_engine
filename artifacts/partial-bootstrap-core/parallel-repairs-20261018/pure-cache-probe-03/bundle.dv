    return result

fn c1_other_ref(group, field):
    return dv_ref(rt_cat("case.", group), "state", field)

fn c1_other_claim(group, field):
    return dv_fact(c1_other_ref(group, field), true)

fn c1_other_identity(group, actor):
    return c1_other_claim(group, rt_cat("answer.", actor))

// These old-source trace/actor associations are defeasible personal hypotheses.
// No inference law writes an exclusion or an answer merely from ink, a drawing,
// a seal, smell, or equal lamp consumption. Contrary personal evidence revises
// them through the shared hypothesis selector.
fn c1_other_exclusion_hypotheses(id):
    let person = c1_other_person(id)
    let spec = c1_other_case(person.group)
    let traces = c1_other_traces(person.group)
    var result = []
    var i = 0
    while i < rt_count(traces):
        let trace = traces[i]
        let observed = c1_other_claim(person.group, rt_cat("trace.", trace.id))
        let proposition = dv_not(c1_other_identity(person.group, trace.excluded_actor))
        var available = dv_all(dv_pair(c1_other_claim(person.group, "open"), observed))
        if trace.needs_actual_witness:
            available = dv_all(dv_pair(available, c1_other_claim(person.group, "mutual_witness_received")))
        rt_push(result, {"id": rt_cat(rt_cat(id, ".exclusion."), trace.id), "question": rt_cat(person.group, ".identity"), "group": rt_cat(person.group, ".identity"), "proposition": proposition, "prior": 0.5, "available_when": available, "basis": [trace.source], "kind": "fallible-trace-heuristic", "observed_premise": observed, "scope": "present-material-to-past-activity", "missing_support": "independent-event-time-or-personal-witness", "established": false})
        i = i + 1
    return result

axiom c1_other_question_open(group):
    var effects = dv_pair(dv_assign(c1_other_ref(group, "open"), true), dv_assign(c1_other_ref(group, "current"), rt_cat(group, ".identity")))
    var people = c1_other_people()
    var i = 0
    while (i < rt_count(people)):
        if (people[i].group == group):
            rt_push(effects, dv_assign(dv_ref(rt_cat("personal.", people[i].id), "state", "current"), rt_cat(group, ".identity")))
        i = (i + 1)
    return dv_axiom(rt_cat("c1_other_question_open.", group), 1, dv_fact(c1_other_ref(group, "open"), false), effects)

axiom c1_other_accept(group, actor):
    return dv_axiom(rt_cat(rt_cat("c1_other_accept.", group), rt_cat(".", actor)), 1, c1_other_claim(group, "open"), dv_list3(dv_assign(c1_other_ref(group, rt_cat("receipt.", actor)), true), dv_assign(c1_other_ref(group, rt_cat("level.", actor)), 1), dv_assign(dv_ref(rt_cat("personal.", actor), "state", "current"), rt_cat(group, ".reason"))))

// A valid duty report permits a real release action at the shared living hall.
axiom c1_other_release(group, clock_ref):
    var people = c1_other_people()
    var reported = dv_not(dv_true())
    var i = 0
    while (i < rt_count(people)):
        if (people[i].group == group):
            reported = c1_any(reported, c1_other_claim(group, rt_cat("receipt.", people[i].id)))
        i = (i + 1)
    var safe_time = 840
    var safety = c1_other_claim(group, "evidence_complete")
    if group == "astral":
        safe_time = 1890
        safety = dv_all([c1_other_claim(group, "care_given"), c1_other_claim(group, "west_passage_checked")])
    if group == "logistics":
        safe_time = 2010
        safety = dv_all([c1_other_claim(group, "care_given"), c1_other_claim(group, "observation_complete")])
    return dv_axiom(rt_cat("c1_other_release.", group), 1, dv_all([reported, safety, dv_at_least(clock_ref, safe_time), c2_at("demon", "living_hall"), dv_fact(dv_ref("demon.body", "state", "manifested"), true), dv_fact(c1_other_ref(group, "formal_release"), false)]), [dv_assign(c1_other_ref(group, "outer_latch_released"), true), dv_assign(c1_other_ref(group, "formal_release"), true), dv_assign(c1_other_access_ref(group), true), dv_assign(dv_ref("demon.body", "state", "manifested"), false), dv_assign(dv_ref("demon.body", "state", "latch_hand_trace"), "long-narrow-hand")])

fn c1_other_open_action(group, speaker):
    var spec = c1_other_case(group)
    var action = c1_once(c1_action(rt_cat("other.question.", group), "question", c1_at(speaker, "living_hall"), dv_all(dv_pair(c1_at(speaker, "living_hall"), dv_fact(c1_other_ref(group, "open"), false))), rt_cat("other.open.", group), [], spec.source))
    var speech = dv_with_many(c1_speech(dv_true(), spec.source, "group-question-not-an-asserted-answer"), {"surface": rt_cat("铜口里传来声音：", spec.prompt), "utterance_type": "question", "channel": rt_cat("copper.", group)})
    var listeners = []
    var grants = dv_pair(c1_other_ref(group, "open"), c1_other_ref(group, "current"))
    var people = c1_other_people()
    var i = 0
    while (i < rt_count(people)):
        if (people[i].group == group):
            rt_push(listeners, people[i].id)
            rt_push(grants, dv_ref(rt_cat("personal.", people[i].id), "state", "current"))
        i = (i + 1)
    return dv_with(dv_with(dv_with(dv_with(action, "speech", speech), "listeners", listeners), "public_grants", grants), "purpose_refs", dv_single(c1_other_ref(group, "open")))

fn c1_other_inspections(id):
    var person = c1_other_person(id)
    var spec = c1_other_case(person.group)
    var rows = c1_other_traces(person.group)
    var result = []
    var i = 0
    while (i < rt_count(rows)):
        var row = rows[i]
        var ref = c1_other_ref(person.group, rt_cat("trace.", row.id))
        var action = c1_once(c1_action(rt_cat(rt_cat(id, ".inspect."), row.id), "inspect", c1_at(id, spec.room), c1_at(id, spec.room), "", dv_single(ref), row.source))
        rt_push(result, dv_with(action, "surface", row.surface))
        i = (i + 1)
    if id == "lucian":
        let departed = c1_any(c1_at("quer", "threshold.contract"), c1_at("quer", "living_hall"))
        rt_push(result, dv_with(c1_action("lucian.inspect.quer-departure", "inspect", dv_all([c1_at(id, spec.room), departed]), dv_all([c1_at(id, spec.room), departed]), "", [dv_ref("quer", "state", "location")], spec.source), "surface", "卢西安从门边确认雀儿已经走出甲区。"))
    var own_ref = dv_ref(rt_cat("personal.", id), "state", "material_detail")
    rt_push(result, dv_with(c1_once(c1_action(rt_cat(id, ".inspect.own-material"), "inspect", c1_at(id, spec.room), c1_at(id, spec.room), "", dv_single(own_ref), person.material_source)), "surface", person.material_surface))
    return result

fn c1_other_answer_actions(id):
    var person = c1_other_person(id)
    var spec = c1_other_case(person.group)
    var result = []
    var i = 0
    while (i < rt_count(spec.options)):
        var option = spec.options[i]
        var answer = c1_other_submission(person.group, option)
        var action_id = rt_cat(rt_cat(rt_cat(id, ".answer."), person.group), rt_cat(".", option))
        var known = dv_all([c1_at(id, spec.room), c1_other_claim(person.group, "open"), answer, dv_at_least(c1_other_clock_ref(), c1_other_report_time(person.group))])
        var action = c1_action(action_id, "answer", known, known, "", [], spec.source)
        var speech = dv_with(c1_speech(answer, spec.source, "literal-actor-only-not-motive"), "surface", rt_cat(c1_other_person(option).name, c1_other_report_surface(person.group)))
        rt_push(result, dv_with_many(action, {"answer": answer, "answer_id": action_id, "topic": rt_cat(person.group, ".identity"), "speech": dv_with(speech, "channel", rt_cat("copper.", person.group)), "listeners": dv_single("demon"), "authority_precondition": dv_all([c1_at(id, spec.room), c1_other_claim(person.group, "open"), c1_at("demon", "living_hall"), dv_at_least(c1_other_clock_ref(), c1_other_report_time(person.group))]), "purpose_refs": dv_single(c1_other_ref(person.group, rt_cat("receipt.", id)))}))
        i = (i + 1)
    return result

fn c1_other_formal_answers():
    var people = c1_other_people()
    var result = []
    var i = 0
    while (i < rt_count(people)):
        var person = people[i]
        var spec = c1_other_case(person.group)
        var j = 0
        while (j < rt_count(spec.options)):
            var option = spec.options[j]
            var literal = c1_other_submission(person.group, option)
            var id = rt_cat(rt_cat(rt_cat(person.id, ".answer."), person.group), rt_cat(".", option))
            rt_push(result, {"id": id, "stage": rt_cat(person.group, ".identity"), "condition": literal, "required_support": literal, "question_match": c1_other_claim(person.group, "open"), "answer_complete": literal, "require_argument": false, "accepted_law": rt_cat(rt_cat("other.accept.", person.group), rt_cat(".", person.id)), "progress_ref": c1_other_ref(person.group, rt_cat("level.", person.id)), "completion_ref": c1_other_ref(person.group, rt_cat("receipt.", person.id)), "accepted_listeners": [person.id, "demon"], "accepted_public_grants": [c1_other_ref(person.group, rt_cat("receipt.", person.id)), c1_other_ref(person.group, rt_cat("level.", person.id)), dv_ref(rt_cat("personal.", person.id), "state", "current"), c1_other_clock_ref()], "source_refs": dv_single(spec.source)})
            j = (j + 1)
        i = (i + 1)
    return result

fn c1_other_preconception(id):
    if (id == "ward"):
        return {"preferred": "theft", "source_strength": 3, "basis": dv_single(c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 22, "ward.preconception")), "kind": "authored-preconception-not-evidence"}
    if (id == "gu"):
        return {"preferred": "theft", "source_strength": 1, "basis": dv_single(c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 23, "gu.preconception")), "kind": "authored-preconception-not-evidence"}
    if (id == "lucian"):
        return {"preferred": "authorized_transfer", "source_strength": 1, "basis": dv_single(c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 24, "lucian.preconception")), "kind": "authored-preconception-not-evidence"}
    if (id == "elena"):
        return {"preferred": "self_preservation", "source_strength": 3, "basis": dv_single(c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 40, "elena.preconception")), "kind": "authored-preconception-not-evidence"}
    if (id == "selma"):
        return {"preferred": "self_preservation", "source_strength": 1, "basis": dv_single(c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 41, "selma.preconception")), "kind": "authored-preconception-not-evidence"}
    if (id == "mora"):
        return {"preferred": "experiment", "source_strength": 3, "basis": dv_single(c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 58, "mora.preconception")), "kind": "authored-preconception-not-evidence"}
    if (id == "bertrand"):
        return {"preferred": "experiment", "source_strength": 1, "basis": dv_single(c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 59, "bertrand.preconception")), "kind": "authored-preconception-not-evidence"}
    return false

fn c1_other_reason_hypotheses(id):
    var person = c1_other_person(id)
    var spec = c1_other_case(person.group)
    var bias = c1_other_preconception(id)
    var options = spec.reason_options
    var ordered = []
    var i = 0
    if (not (bias == false)):
        rt_push(ordered, bias.preferred)
    while (i < rt_count(options)):
        if (not dv_has(ordered, options[i])):
            rt_push(ordered, options[i])
        i = (i + 1)
    var result = []
    i = 0
    while (i < rt_count(ordered)):
        var option = ordered[i]
        var basis = dv_single(spec.source)
        if (not (bias == false)):
            if (bias.preferred == option):
                basis = bias.basis
        var proposition = c1_other_claim(person.group, rt_cat("reason.", option))
        rt_push(result, {"id": rt_cat(rt_cat(person.group, ".reason."), option), "question": rt_cat(person.group, ".reason"), "group": rt_cat(person.group, ".reason"), "proposition": proposition, "assumptions": dv_single(proposition), "prior": 0.5, "available_when": c1_other_claim(person.group, rt_cat("receipt.", id)), "basis": basis, "interpretation_scope": "motive-separate-from-accepted-literal-actor", "source_preconception": bias})
        i = (i + 1)
    return result

fn c1_other_mind(id):
    var person = c1_other_person(id)
    var spec = c1_other_case(person.group)
    var mind = dv_with(dv_world(rt_cat("mind.", id), "mind", id), "time", 480)
    mind = dv_add_object(mind, c1_position(id, spec.room))
    mind = dv_add_object(mind, c1_local_object(rt_cat("case.", person.group)))
    var people = c1_other_people()
    var peer_index = 0
    while (peer_index < rt_count(people)):
        if (people[peer_index].group == person.group):
            mind = dv_add_object(mind, c1_local_object(rt_cat("personal.", people[peer_index].id)))
            if people[peer_index].id != id:
                mind = dv_add_object(mind, c1_local_object(people[peer_index].id))
        peer_index = (peer_index + 1)
    mind = dv_add_object(mind, c1_state_object("memory", dv_single(dv_pair("empty_school_recall", dv_with(dv_field(true), "basis", dv_single(person.memory_source))))))
    mind = dv_store(mind, dv_ref(rt_cat("personal.", id), "state", "initial_surface"), dv_with(dv_field(person.initial_surface), "basis", dv_single(person.initial_source)))
    return mind

fn c1_other_policy(id):
    var person = c1_other_person(id)
    var spec = c1_other_case(person.group)
    var goals = []
    var i = 0
    while (i < rt_count(spec.options)):
        rt_push(goals, {"kind": "know", "question": rt_cat(person.group, ".identity"), "ref": c1_other_ref(person.group, rt_cat("answer.", spec.options[i])), "available_when": c1_other_claim(person.group, "open"), "basis": dv_single(spec.source)})
        i = (i + 1)
    rt_push(goals, {"kind": "know", "question": rt_cat(person.group, ".identity"), "ref": c1_other_ref(person.group, rt_cat("receipt.", id)), "available_when": dv_all([c1_other_claim(person.group, "open"), dv_at_least(c1_other_clock_ref(), c1_other_report_time(person.group))]), "basis": dv_single(spec.source)})
    rt_push(goals, {"kind": "know", "question": "own_material", "ref": dv_ref(rt_cat("personal.", id), "state", "material_detail"), "basis": dv_pair(person.material_source, person.desire_source)})
    if id == "lucian":
        rt_push(goals, c2_observation_goal(dv_ref("quer", "state", "location"), c1_other_claim("contract", "outer_latch_released"), [spec.source], 0))
    var hypotheses = c1_other_exclusion_hypotheses(id)
    var reasons = c1_other_reason_hypotheses(id)
    i = 0
    while (i < rt_count(reasons)):
        rt_push(hypotheses, reasons[i])
        i = (i + 1)
    return dv_with_many(c1_player_policy(), {"hypotheses": hypotheses, "goals": goals, "desire": {"surface": person.desire, "basis": dv_single(person.desire_source), "fulfillment": "not-asserted"}, "notice_co_presence": true, "topic_bindings": dv_pair({"topic": "own_material", "heard_when": dv_true(), "completed_when": dv_not(dv_true()), "basis": dv_single(person.material_source)}, {"topic": rt_cat(person.group, ".reason"), "heard_when": c1_other_claim(person.group, rt_cat("receipt.", id)), "completed_when": dv_not(dv_true()), "basis": dv_single(spec.source)})})

fn c1_other_character(id):
    var person = c1_other_person(id)
    var actions = c1_other_inspections(id)
    var answers = c1_other_answer_actions(id)
    var i = 0
    while (i < rt_count(answers)):
        rt_push(actions, answers[i])
        i = (i + 1)
    var replies = c1_other_personal_replies(id)
    i = 0
    while (i < rt_count(replies)):
        rt_push(actions, replies[i])
        i = (i + 1)
    return {"id": id, "mind": c1_other_mind(id), "actions": actions, "policy": c1_other_policy(id), "balance": {"time": 100000, "computation": 100000, "stamina": 100000}, "location_ref": dv_ref(id, "state", "location"), "location": c1_other_case(person.group).room, "question_ref": dv_ref(rt_cat("personal.", id), "state", "current"), "dossier": person}

fn c1_other_groups_actors():
    var result = []
    var people = c1_other_people()
    var i = 0
    while (i < rt_count(people)):
        rt_push(result, c1_other_character(people[i].id))
        i = (i + 1)
    return result

// Real physical authored traces and literal history; invisible answer fields are never grants.
fn c1_other_group_extend(world, group):
    var spec = c1_other_case(group)
    var fields = {"open": dv_field(false), "current": dv_field(""), "outer_latch_released": dv_field(false), "formal_release": dv_field(false)}
    var i = 0
    while (i < rt_count(spec.options)):
        fields = dv_with(fields, rt_cat("answer.", spec.options[i]), dv_field((spec.options[i] == spec.authority_actor)))
        i = (i + 1)
    i = 0
    while (i < rt_count(spec.reason_options)):
        fields = dv_with(fields, rt_cat("reason.", spec.reason_options[i]), dv_field((spec.reason_options[i] == spec.authority_reason)))
        i = (i + 1)
    var traces = c1_other_traces(group)
    i = 0
    while (i < rt_count(traces)):
        fields = dv_with(fields, rt_cat("trace.", traces[i].id), dv_field(true))
        i = (i + 1)
    var people = c1_other_people()
    i = 0
    var result = world
    while (i < rt_count(people)):
        var person = people[i]
        if (person.group == group):
            fields = dv_with(fields, rt_cat("receipt.", person.id), dv_field(false))
            fields = dv_with(fields, rt_cat("level.", person.id), dv_field(0))
            result = dv_add_object(result, c1_position(person.id, spec.room))
            result = dv_add_object(result, c1_state_object(rt_cat("personal.", person.id), {"material_detail": dv_field(person.material_surface), "current": dv_field("")}))
            result = dv_adopt(result, c1_method(rt_cat(rt_cat("other.accept.", group), rt_cat(".", person.id)), c1_other_accept(group, person.id)), "enforce", 1, dv_single(spec.source))
        i = (i + 1)
    result = dv_add_object(result, c1_state_object(rt_cat("case.", group), fields))
    result = dv_adopt(result, c1_method(rt_cat("other.open.", group), c1_other_question_open(group)), "enforce", 1, dv_single(spec.source))
    return c1_other_activity_physical(result, group)

fn c1_other_groups_physical(world):
    return c1_other_group_extend(c1_other_group_extend(c1_other_group_extend(world, "contract"), "astral"), "logistics")

fn c1_other_groups_bindings():
    var people = c1_other_people()
    var result = []
    var i = 0
    while (i < rt_count(people)):
        var person = people[i]
        rt_push(result, dv_binding(person.id, person.id, person.id))
        rt_push(result, dv_binding(rt_cat("case.", person.group), rt_cat("case.", person.group), person.id))
        var j = 0
        while (j < rt_count(people)):
            if (people[j].group == person.group):
                rt_push(result, dv_binding(rt_cat("personal.", people[j].id), rt_cat("personal.", people[j].id), person.id))
                if people[j].id != person.id:
                    rt_push(result, dv_binding(people[j].id, people[j].id, person.id))
            j = (j + 1)
        i = (i + 1)
    return result

fn c1_other_groups_question_actions(speaker):
    return dv_list3(c1_other_open_action("contract", speaker), c1_other_open_action("astral", speaker), c1_other_open_action("logistics", speaker))

fn c1_other_groups_release_laws(clock_ref):
    return dv_list3(c1_other_release("contract", clock_ref), c1_other_release("astral", clock_ref), c1_other_release("logistics", clock_ref))

// Personal reports quote the actor's own inspected material. They do not turn a
// handwritten page, lamp oil or familiar knot into a recovered night's memory.
fn c1_other_personal_replies(id):
    var person = c1_other_person(id)
    var ref = dv_ref(rt_cat("personal.", id), "state", "material_detail")
    var known = dv_fact(ref, person.material_surface)
    var people = c1_other_people()
    var result = []
    var i = 0
    while (i < rt_count(people)):
        var other = people[i]
        if dv_and((other.group == person.group), (not (other.id == id))):
            var action = c1_action(rt_cat(rt_cat(id, ".reply.own-material."), other.id), "talk", known, c1_at(id, c1_other_case(person.group).room), "", [], person.material_source)
            var speech = dv_with(c1_speech(known, person.material_source, "personally-inspected-material-not-night-witness"), "surface", person.material_surface)
            rt_push(result, dv_with_many(action, {"speech": speech, "listeners": dv_single(other.id), "offer_to": other.id, "response_topic": rt_cat("own_material.", id)}))
        i = (i + 1)
    return result

fn c1_other_release_action(group, speaker, clock_ref):
    var law = c1_other_release(group, clock_ref)
    var surface = "从起居厅一侧抬起寝区外闩，正式宣告放行。"
    if group == "contract":
        surface = "代管者复核已被挑开的甲区门闩，正式宣告沃德等人可以离开。"
    let action = c1_action(rt_cat("other.release.", group), "help", law.premise, law.premise, rt_cat("other.release.", group), [c1_other_ref(group, "outer_latch_released"), c1_other_ref(group, "formal_release"), c1_other_access_ref(group), dv_ref("demon.body", "state", "manifested")], c1_other_case(group).source)
    return dv_with_many(action, {"surface": surface, "predict_law": rt_cat("other.release.", group), "speech": dv_with_many(c1_speech(dv_true(), c1_other_case(group).source, "actual-formal-release"), {"surface": surface, "channel": rt_cat("copper.", group)}), "listeners": c1_other_group_listeners(group, ""), "public_grants": [c1_other_ref(group, "outer_latch_released"), c1_other_ref(group, "formal_release"), c1_other_access_ref(group), c1_other_clock_ref()]})

fn c1_other_departure_source(id):
    if (id == "lucian"):
        return {"target": "Living", "surface": "在起居厅听见乙区门里有人说话，靠在对面墙上等着", "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 8, "lucian.departure"), "source_duration": 12}
    if (id == "gu"):
        return {"target": "Living", "surface": "在起居厅北台的书架前，把认得的书脊一行行抄下来", "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 11, "gu.departure"), "source_duration": 12}
    if (id == "quer"):
        return {"target": "Living", "surface": "蹲在乙区门外看那道外闩，只看不碰", "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 14, "quer.departure"), "source_duration": 12}
    if (id == "ward"):
        return {"target": "Living", "surface": "在起居厅公告板张贴《私取者戒》，把未经公开授权的私藏定为窃取", "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 17, "ward.departure"), "source_duration": 12}
    if (id == "selma"):
        return {"target": "Greenhouse", "surface": "离开丙区到温室查看标本，把寝区观察与新环境分开记", "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 20, "selma.departure"), "source_duration": 12}
    if (id == "ruan"):
        return {"target": "Hall", "surface": "到中央厅收起棋子，核对自己能确认的物品数目", "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 23, "ruan.departure"), "source_duration": 12}
    if (id == "elena"):
        return {"target": "Hall", "surface": "离开丙区后在中央厅坐下，避开伤脚久站", "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 26, "elena.departure"), "source_duration": 12}
    if (id == "moran"):
        return {"target": "Hall", "surface": "到中央厅观察窗光，翻看刚才画出的色层", "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 29, "moran.departure"), "source_duration": 12}
    if (id == "veronica"):
        return {"target": "Logistics", "surface": "离开丁区到后勤院查看公用器具，暂不取用未知试剂", "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 32, "veronica.departure"), "source_duration": 12}
    if (id == "bertrand"):
        return {"target": "Hall", "surface": "从丁区出来巡看中央厅的通路，给后来的人留出门口", "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 35, "bertrand.departure"), "source_duration": 12}
    if (id == "margaret"):
        return {"target": "Hall", "surface": "走到中央厅把真正看见的门外尺寸补进草图", "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 38, "margaret.departure"), "source_duration": 12}
    if (id == "mora"):
        return {"target": "Clinic", "surface": "离开丁区到诊疗所清点可用敷料，预备有人求助", "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 41, "mora.departure"), "source_duration": 12}
    dv_require(false, "Unknown chapter-one departure actor")
    return false

// Source-directed departure remains optional and requires actual opened-latch observation.
// The caller installs this law in physical/enforce and this person's mind/predict.
axiom c1_other_depart(id):
    var person = c1_other_person(id)
    var source = c1_other_departure_source(id)
    var premise = dv_all(dv_list3(c1_at(id, c1_other_case(person.group).room), c1_other_claim(person.group, "outer_latch_released"), dv_fact(c1_other_access_ref(person.group), true)))
    if id == "ward" or id == "gu":
        premise = dv_all([premise, c1_other_claim("contract", rt_cat("receipt.", id)), c1_other_claim("contract", "formal_release"), dv_at_least(c1_other_clock_ref(), 840)])
    if id != "quer" and id != "lucian" and id != "ward" and id != "gu":
        premise = dv_all([premise, c1_other_claim(person.group, "formal_release")])
    if id == "lucian":
        premise = dv_all([premise, c1_any(c1_at("quer", "threshold.contract"), c1_at("quer", "living_hall"))])
    return dv_axiom(rt_cat("c1_other_depart.", id), 1, premise, dv_single(dv_assign(dv_ref(id, "state", "location"), c1_other_threshold(person.group))))

fn c1_other_departure_actions(id):
    var person = c1_other_person(id)
    var room = c1_other_case(person.group).room
    var source = c1_other_departure_source(id)
    var ref = c1_other_ref(person.group, "outer_latch_released")
    var inspect = dv_with(c1_action(rt_cat(id, ".inspect.outer-latch"), "inspect", c1_at(id, room), c1_at(id, room), "", dv_pair(ref, c1_other_access_ref(person.group)), source.source), "repeatable", true)
    var premise = c1_other_depart(id).premise
    var depart = dv_with_many(c1_action(rt_cat(id, ".leave-dormitory"), "move", premise, premise, rt_cat("other.depart.", id), dv_single(dv_ref(id, "state", "location")), source.source), {"predict_law": rt_cat("other.depart.", id), "surface": rt_cat(c1_other_person(id).name, "离开寝区。"), "next_observation_surface": "跨过门槛，来到本寝区的门外。", "later_intention_surface": source.surface, "travel": {"from": room, "to": c1_other_threshold(person.group), "gate": person.group}})
    if id == "quer":
        depart = dv_with_many(depart, {"public_observers": ["lucian", "ward", "gu"], "public_grants": [dv_ref("quer", "state", "location")]})
    depart = dv_with(depart, "personal_choice", {"group": "leave-open-dormitory", "requires": premise, "prohibits": dv_not(dv_true()), "promotes": ["leave_confinement"], "sacrifices": [], "basis": dv_single(person.initial_source)})
    return dv_pair(inspect, depart)

fn c1_other_groups_costs():
    var costs = c1_costs()
    rt_push(costs, dv_pair("other_departure", c1_cost(12, c1_other_departure_source("quer").source)))
    return costs

fn c1_other_group_listeners(group, except):
    var result = []
    var people = c1_other_people()
    var i = 0
    while i < rt_count(people):
        let person = people[i]
        if dv_and(person.group == group, person.id != except):
            rt_push(result, person.id)
        i = i + 1
    return result

fn c1_other_wake_action(id):
    let person = c1_other_person(id)
    let room = c1_other_case(person.group).room
    let literal = dv_fact(dv_ref(rt_cat("personal.", id), "state", "initial_surface"), person.initial_surface)
    let action = c1_once(c1_action(rt_cat(id, ".wake-and-introduce"), "talk", dv_all(dv_pair(c1_at(id, room), literal)), c1_at(id, room), "", [], person.initial_source))
    let text = rt_cat(person.initial_surface, rt_cat("\n", c1_other_introduction(id)))
    return dv_with_many(action, {"speech": dv_with(c1_speech(literal, person.initial_source, "own-current-perception"), "surface", text), "listeners": c1_other_group_listeners(person.group, id), "surface": text})

fn c1_other_trace_conversations(id):
    let person = c1_other_person(id)
    let spec = c1_other_case(person.group)
    let peers = c1_other_group_listeners(person.group, id)
    let traces = c1_other_traces(person.group)
    var result = []
    var i = 0
    while i < rt_count(peers):
        let peer = peers[i]
        var j = 0
        while j < rt_count(traces):
            let trace = traces[j]
            let topic = rt_cat(rt_cat(person.group, ".trace."), trace.id)
            let ref = c1_other_ref(person.group, rt_cat("trace.", trace.id))
            let literal = dv_fact(ref, true)
            let prefix = rt_cat(rt_cat(id, ".material."), rt_cat(peer, rt_cat(".", trace.id)))
            let request = dv_with_many(c1_speech(dv_true(), trace.source, "request-personal-observation"), {"surface": rt_cat(c1_other_person(peer).name, "，这件东西你查看过吗？把你看到的告诉我。"), "utterance_type": "question", "request": {"target": peer, "topic": topic}})
            rt_push(result, dv_with_many(c1_action(rt_cat(prefix, ".ask"), "talk", c1_at(id, spec.room), c1_at(id, spec.room), "", [], trace.source), {"speech": request, "listeners": dv_single(peer), "purpose_refs": dv_single(ref)}))
            let report = dv_with(c1_speech(literal, trace.source, "personally-observed-trace-not-night-witness"), "surface", trace.surface)
            rt_push(result, dv_with_many(c1_action(rt_cat(prefix, ".report"), "talk", dv_all(dv_pair(c1_at(id, spec.room), literal)), c1_at(id, spec.room), "", [], trace.source), {"speech": report, "listeners": dv_single(peer), "offer_to": peer, "response_topic": topic, "purpose_refs": dv_single(ref)}))
            j = j + 1
        i = i + 1
    return result

fn c1_other_desire_action(id):
    let person = c1_other_person(id)
    let room = c1_other_case(person.group).room
    let ref = dv_ref(rt_cat("personal.", id), "state", "material_detail")
    let action = c1_once(c1_action(rt_cat(id, ".follow-own-interest"), "inspect", c1_at(id, room), c1_at(id, room), "", dv_single(ref), person.material_source))
    return dv_with_many(action, {"surface": rt_cat(person.intention_surface, rt_cat("\n", person.material_surface)), "purpose_refs": dv_single(ref), "motive_basis": dv_single(person.desire_source)})

// Install the actual residents, their private rules and objects, copper channels,
// scoped formal questions, and answer transitions. Release/departure needs the
// campaign's real clock and access graph; this constructor never advances either.
fn c1_other_groups_install_scene(scene):
    var world = c1_other_groups_physical(scene.physical)
    let release_laws = c1_other_groups_release_laws(c1_other_clock_ref())
    var release_index = 0
    while release_index < rt_count(release_laws):
        let group = ["contract", "astral", "logistics"][release_index]
        world = dv_adopt(world, c1_method(rt_cat("other.release.", group), release_laws[release_index]), "enforce", 1, dv_single(c1_other_case(group).source))
        release_index = release_index + 1
    var actors = dv_clone(scene.actors)
    var bindings = dv_clone(scene.bindings)
    var answers = dv_clone(scene.formal_answers)
    let people = c1_other_people()
    var i = 0
    while i < rt_count(people):
        let person = people[i]
        let object = rt_cat("personal.", person.id)
        world = dv_store(world, dv_ref(object, "state", "initial_surface"), dv_field(person.initial_surface))
        var actor = c1_other_activity_actor(c1_other_character(person.id), person.group)
        let depart_method = c1_method(rt_cat("other.depart.", person.id), c1_other_depart(person.id))
        world = dv_adopt(world, depart_method, "enforce", 1, dv_single(person.initial_source))
        var own_mind = dv_add_object(actor.mind, c1_local_object("campaign.access"))
        own_mind = dv_adopt(own_mind, depart_method, "predict", 1, dv_single(person.initial_source))
        actor = dv_with_many(actor, {"mind": own_mind, "policy": dv_with_many(actor.policy, {"value_order": ["leave_confinement", "pursue_desire"], "value_basis": dv_single(person.initial_source)})})
        rt_push(bindings, dv_binding("campaign.access", "campaign.access", person.id))
        rt_push(bindings, dv_binding("campaign.clock", "campaign.clock", person.id))
        var actions = []
        rt_push(actions, c1_other_wake_action(person.id))
        rt_push(actions, c1_other_desire_action(person.id))
        var j = 0
        while j < rt_count(actor.actions):
            if actor.actions[j].id != rt_cat(person.id, ".inspect.own-material"):
                rt_push(actions, actor.actions[j])
            j = j + 1
        let departure_actions = c1_other_departure_actions(person.id)
        j = 0
        while j < rt_count(departure_actions):
            rt_push(actions, departure_actions[j])
            j = j + 1
        rt_push(actions, c1_other_handoff_action(person.id))
        let conversations = c1_other_trace_conversations(person.id)
        j = 0
        while j < rt_count(conversations):
            rt_push(actions, conversations[j])
            j = j + 1
        let channel = rt_cat("copper.", person.group)
        let ready = c1_at(person.id, c1_other_case(person.group).room)
        actor = dv_with_many(actor, {"actions": actions, "hearing_grants": [{"speaker": "demon", "channel": channel, "available_when": ready, "sender_locations": ["living_hall"], "listener_locations": [c1_other_case(person.group).room], "basis": [c1_other_case(person.group).source]}], "request_channels": [{"target": "demon", "channel": channel, "available_when": ready, "basis": [c1_other_case(person.group).source]}]})
        rt_push(actors, actor)
        i = i + 1
    let local_bindings = c1_other_groups_bindings()
    i = 0
    while i < rt_count(local_bindings):
        rt_push(bindings, local_bindings[i])
        i = i + 1
    let formal = c1_other_formal_answers()
    i = 0
    while i < rt_count(formal):
        rt_push(answers, formal[i])
        i = i + 1
    var installed_actors = []
    i = 0
    while i < rt_count(actors):
        if actors[i].id == "demon":
            var demon = actors[i]
            var mind = demon.mind
            var actions = dv_clone(demon.actions)
            var hearing = dv_clone(dv_find(demon, "hearing_grants", []))
            var g = 0
            let groups = ["contract", "astral", "logistics"]
            while g < rt_count(groups):
                let group = groups[g]
                let spec = c1_other_case(group)
                mind = dv_add_object(mind, c1_state_object(rt_cat("case.", group), {"open": dv_field(false)}))
                mind = dv_adopt(mind, c1_method(rt_cat("other.open.", group), c1_other_question_open(group)), "predict", 1, dv_single(spec.source))
                rt_push(bindings, dv_binding(rt_cat("case.", group), rt_cat("case.", group), "demon"))
                let listeners = c1_other_group_listeners(group, "")
                var k = 0
                while k < rt_count(listeners):
                    rt_push(hearing, {"speaker": listeners[k], "channel": rt_cat("copper.", group), "available_when": c1_at("demon", "living_hall"), "sender_locations": [spec.room], "listener_locations": ["living_hall"], "basis": [spec.source]})
                    rt_push(hearing, {"speaker": listeners[k], "channel": "formal-receipt", "available_when": c1_at("demon", "living_hall"), "sender_locations": [spec.room], "listener_locations": ["living_hall"], "basis": [spec.source]})
                    mind = dv_add_object(mind, c1_local_object(rt_cat("personal.", listeners[k])))
                    k = k + 1
                rt_push(actions, c1_other_open_action(group, "demon"))
                g = g + 1
            rt_push(installed_actors, dv_with_many(demon, {"mind": mind, "actions": actions, "hearing_grants": hearing}))
        else:
            rt_push(installed_actors, actors[i])
        i = i + 1
    return dv_with_many(scene, {"physical": world, "actors": installed_actors, "bindings": bindings, "formal_answers": answers, "cost_model": dv_append(scene.cost_model, dv_pair("other_departure", c1_cost(2, c1_source("godot_csharp/scenes/Awakening/Script/story/剧情时长.story", 37, "走动：2"))))})

fn c1_other_introduction(id):
    if id == "quer":
        return "叫我雀儿就行。别站门前——让我看一眼那道闩。"
    if id == "lucian":
        return "卢西安。名字还记得，半句诗也还记得；偏偏缺了我们怎么到这儿来的那一段。"
    if id == "ward":
        return "沃德。先说姓名，再说各自记得的最后一件事。不要混在一起。"
    if id == "gu":
        return "顾平章。容老朽擦擦眼镜。纸上的东西还在，人却想不起来，真是怪事。"
    if id == "ruan":
        return "阮清月。那盘棋先别碰。我们还不知道谁摆的，也不知道轮到谁。"
    if id == "elena":
        return "伊莲娜。别拉我起来……脚踝疼。你们谁知道这里是什么地方？"
    if id == "selma":
        return "赛尔玛。请别动窗台上的苗。我得先弄清楚本子上哪些是我记的。"
    if id == "moran":
        return "莫兰。等一等，那层绿马上要散了。你们说，我听着。"
    if id == "mora":
        return "茉拉。刚才谁在咳嗽？先让我看看，再说别的。"
    if id == "bertrand":
        return "贝尔特朗。门外有动静。先别挤过去，给彼此留条退路。"
    if id == "veronica":
        return "维罗妮卡。谁动过这排器具？不知道也直说，别替别人猜。"
    return "玛格丽特。先别都靠那面墙。这根梁的搭法，我得再看一遍。"

fn c1_other_clock_ref():
    return dv_ref("campaign.clock", "state", "minute")

fn c1_other_access_ref(group):
    return dv_ref("campaign.access", "state", group)

fn c1_other_threshold(group):
    return rt_cat("threshold.", group)

fn c1_other_handoff_text(id):
    if id == "ward":
        return "开锁的人已经核对了。出去以后，那把钥匙的来路还得写清楚。"
    if id == "quer":
        return "我答了。你还要把我堵在这儿？门开了，让开一点。"
    if id == "lucian":
        return "名字答对了，缘由还空着呢。沃德，留一行空白总比填错强。"
    if id == "gu":
        return "门开了。先莫争，外面若有文书，读过再说。"
    if id == "elena":
        return "我慢一点。阮清月……出去以后，你也别先走。"
    if id == "ruan":
        return "我在这儿。你先扶住门框，等站稳了再迈那一步。"
    if id == "selma":
        return "我的本子带上了。门内查到的，跟出去以后查到的，分开记。"
    if id == "moran":
        return "外面的光不一样。等我站到门边再画，别挡着伊莲娜。"
    if id == "mora":
        return "人先出去。试剂的事还没说清；有谁不舒服，别瞒着。"
    if id == "veronica":
        return "取走一瓶东西和拿它做了什么，是两件事。先把原瓶找到。"
    if id == "bertrand":
        return "我站门边。一个一个过去，先看落脚的地方。"
    return "门框没歪。慢慢过，别拿身体去撞那道闩。"

fn c1_other_handoff_action(id):
    let person = c1_other_person(id)
    let receipt = c1_other_claim(person.group, rt_cat("receipt.", id))
    let ready = dv_all(dv_pair(c1_at(id, c1_other_threshold(person.group)), receipt))
    let text = c1_other_handoff_text(id)
    return dv_with_many(c1_once(c1_action(rt_cat(id, ".doorway-handoff"), "talk", ready, c1_at(id, c1_other_threshold(person.group)), "", [], person.initial_source)), {"speech": dv_with(c1_speech(receipt, person.initial_source, "own-answer-receipt-and-next-intention"), "surface", text), "listeners": c1_other_group_listeners(person.group, id), "surface": text})


// Each flag below is produced by a real Complete, then observed by the actor.
fn c1_other_report_time(group):
    if group == "contract":
        return 840
    if group == "astral":
        return 1065
    return 1100

fn c1_other_report_surface(group):
    if group == "contract":
        return "；藏处是壁炉砖槽；未经公开授权，背着同行私藏。我将此定为窃取。"
    if group == "astral":
        return "；她单方面止损，为保住多数而拉闸封门。"
    return "；她未经医嘱，进行了激进的酸试验。"

fn c1_other_submission(group, option):
    return dv_all([c1_other_identity(group, option), c1_other_claim(group, "evidence_complete"), c1_other_claim(group, "report_basis")])

fn c1_other_activity_rows(group):
    if group == "contract":
        return [
            {"id": "keys_found", "actor": "ward", "after": "", "time": 480, "text": "沃德搜出一把钥匙和半角红墨残纸：‘……交由 J.C. 开启内柜，取走……切勿令外人知晓’。缺失的上下文还不能说明有无授权。"},
            {"id": "wax_ash_seen", "actor": "ward", "after": "keys_found", "time": 480, "text": "柜锁旁有火漆屑，地上煤灰足印朝向壁炉。沃德把钥匙与纸片摆在桌上，要求雀儿解释。"},
            {"id": "quer_insulted", "actor": "ward", "after": "wax_ash_seen", "time": 480, "text": "沃德称雀儿未经公开授权，背着同行私藏。雀儿攥紧袖口：‘搜也搜了，还要我认什么？’卢西安走到她身旁。"},
            {"id": "evidence_complete", "actor": "gu", "after": "wax_ash_seen", "time": 480, "text": "顾平章沿煤灰足印摸到壁炉砖槽，取出蜡布筒。筒中物件与残纸指向同一内柜；这能确认雀儿取出并私藏，不能证明她没有私下授权。"},
            {"id": "report_basis", "actor": "ward", "after": "evidence_complete", "time": 480, "text": "沃德逐项核对：雀儿、壁炉砖槽、未经公开授权而背着同行私藏。人、处、行为齐备；‘窃取’仍是他的定性。"}
        ]
    if group == "astral":
        return [
            {"id": "care_given", "actor": "selma", "after": "", "time": 480, "text": "伊莲娜左踝肿痛，无法负重。赛尔玛重新固定绷带，让她躺稳，端来水。"},
            {"id": "ruan_admitted", "actor": "ruan", "after": "care_given", "time": 480, "text": "阮清月承认：‘闸是我拉的。再迟一刻，外面的人也会被卷进去。’这说明她拉闸，不等于她已说明门内人的意思。"},
            {"id": "evidence_complete", "actor": "selma", "after": "ruan_admitted", "time": 480, "text": "赛尔玛安抚莫兰，等他呼吸平稳后接过半截伸手草图。纸上只有门内伸出的手，手腕以下的动作被截断。"},
            {"id": "report_basis", "actor": "selma", "after": "evidence_complete", "time": 480, "text": "赛尔玛把阮清月的拉闸自认与半截草图并置：现有材料支持‘单方面止损保多数’的表层解释，尚未说明完整手势。"},
            {"id": "west_passage_checked", "actor": "selma", "after": "report_basis", "time": 1890, "text": "赛尔玛从门边检查西夹道：昨夜积气已经散尽，伊莲娜的伤踝也已固定，可以有人搀扶着慢行。现在才具备安全开门条件。"}
        ]
    return [
        {"id": "care_given", "actor": "mora", "after": "", "time": 480, "text": "贝尔特朗高烧，额头烫手。茉拉给他补水、降温，守在床边记录呼吸与体温。"},
        {"id": "evidence_complete", "actor": "veronica", "after": "care_given", "time": 780, "text": "午后，试剂杯边泛起酸泡。茉拉拦住维罗妮卡：‘没有医嘱，不准再试。’维罗妮卡承认取走白塔柜试剂，却没有在争执中说明旧伤用途。"},
        {"id": "report_basis", "actor": "mora", "after": "evidence_complete", "time": 780, "text": "茉拉按亲见的酸泡、试剂取用和争执记录‘未经医嘱的激进酸试验’。这份定性尚未核对维罗妮卡左臂旧疤。"},
        {"id": "observation_complete", "actor": "mora", "after": "report_basis", "time": 2010, "text": "茉拉完成隔夜留观：贝尔特朗退热后情况稳定，可以转移。她收起记录，确认此刻才适合开门。"}
    ]

axiom c1_other_activity_law(group, row):
    var pre = [c1_at(row.actor, c1_other_case(group).room), dv_at_least(c1_other_clock_ref(), row.time), dv_fact(c1_other_ref(group, row.id), false)]
    if row.after != "":
        rt_push(pre, c1_other_claim(group, row.after))
    return dv_axiom(rt_cat("other.activity.", row.id), 1, dv_all(pre), [dv_assign(c1_other_ref(group, row.id), true)])

fn c1_other_activity_physical(world, group):
    var result = world
    let rows = c1_other_activity_rows(group)
    var i = 0
    while i < rt_count(rows):
        result = dv_store(result, c1_other_ref(group, rows[i].id), dv_field(false))
        result = dv_adopt(result, c1_method(rt_cat(rt_cat("other.activity.", group), rt_cat(".", rows[i].id)), c1_other_activity_law(group, rows[i])), "enforce", 1, [c1_other_case(group).source])
        i = i + 1
    return result

fn c1_other_activity_actor(actor, group):
    var result = actor
    var mind = c2_add_new(result.mind, c1_local_object("campaign.clock"))
    var initial_index = 0
    let initial_rows = c1_other_activity_rows(group)
    while initial_index < rt_count(initial_rows):
        mind = dv_store(mind, c1_other_ref(group, initial_rows[initial_index].id), dv_with(dv_field(false), "basis", [c1_other_case(group).source]))
        initial_index = initial_index + 1
    var actions = dv_clone(result.actions)
    var goals = dv_clone(result.policy.goals)
    let source = c1_other_case(group).source
    rt_push(actions, dv_with(c2_action(rt_cat(actor.id, ".other.inspect-clock"), "inspect", dv_true(), dv_true(), "", [c1_other_clock_ref()], "查看寝区钟面。", source), "repeatable", true))
    rt_push(goals, dv_with(c2_observation_goal(c1_other_clock_ref(), dv_true(), [source], 0), "refresh_refs", [c1_other_clock_ref()]))
    let rows = c1_other_activity_rows(group)
    var witnesses = []
    let people = c1_other_people()
    var witness_index = 0
    while witness_index < rt_count(people):
        if people[witness_index].group == group:
            rt_push(witnesses, people[witness_index].id)
        witness_index = witness_index + 1
    var i = 0
    while i < rt_count(rows):
        let row = rows[i]
        let ref = c1_other_ref(group, row.id)
        let pre = c1_at(actor.id, c1_other_case(group).room)
        rt_push(goals, c2_observation_goal(ref, pre, [source], 0))
        if row.actor == actor.id:
            let method = rt_cat(rt_cat("other.activity.", group), rt_cat(".", row.id))
            let law = c1_other_activity_law(group, row)
            mind = dv_adopt(mind, c1_method(method, law), "predict", 1, [source])
            var activity = dv_with_many(c2_action(rt_cat(actor.id, rt_cat(".activity.", row.id)), "help", law.premise, law.premise, method, [ref], row.text, source), {"predict_law": method, "public_observers": witnesses, "public_grants": [ref]})
            if row.id == "west_passage_checked" or row.id == "observation_complete":
                activity = dv_with_many(activity, {"speech": dv_with_many(c1_speech(dv_true(), source, "actual-safety-report"), {"surface": row.text, "channel": rt_cat("copper.", group)}), "listeners": ["demon"], "public_grants": [c1_other_ref(group, "care_given"), ref, c1_other_clock_ref()]})
            rt_push(actions, activity)
            rt_push(goals, c2_goal(dv_fact(ref, true), law.premise, [source]))
        i = i + 1
    let inferred = dv_axiom(rt_cat("other.material-identity.", group), 1, dv_all([c1_other_claim(group, "evidence_complete"), c1_other_claim(group, "report_basis")]), [dv_assign(c1_other_ref(group, rt_cat("answer.", c1_other_case(group).authority_actor)), true)])
    mind = dv_adopt(mind, c1_method(rt_cat("other.material-identity.", group), inferred), "infer", 1, [source])
    return dv_with_many(result, {"mind": mind, "actions": actions, "policy": dv_with(result.policy, "goals", goals)})


// Debug placement changes only the starting room. No answer or recollection is seeded.
fn c1_other_place_detective(scene, zone):
    var group = zone
    if zone == "zone_jia" or zone == "甲":
        group = "contract"
    if zone == "zone_bing" or zone == "丙":
        group = "astral"
    if zone == "zone_ding" or zone == "丁":
        group = "logistics"
    dv_require(dv_has(["contract", "astral", "logistics"], group), "Unsupported detective dormitory placement")
    var world = dv_store(scene.physical, dv_ref("detective", "state", "location"), dv_field(c1_other_case(group).room))
    var actors = []
    var bindings = dv_clone(scene.bindings)
    var answers = dv_clone(scene.formal_answers)
    world = dv_store(world, c1_other_ref(group, "receipt.detective"), dv_field(false))
    world = dv_store(world, c1_other_ref(group, "level.detective"), dv_field(0))
    world = dv_adopt(world, c1_method(rt_cat("other.accept.", rt_cat(group, ".detective")), c1_other_accept(group, "detective")), "enforce", 1, [c1_other_case(group).source])
    var i = 0
    while i < rt_count(scene.actors):
        var actor = scene.actors[i]
        // The remaining residents may greet one another and actually serve tea.
        // Moving the detective does not fabricate a fourth participant or a reply.
        if dv_has(["huo", "shen", "su"], actor.id):
            var opening_actions = []
            var opening_index = 0
            while opening_index < rt_count(actor.actions):
                var opening_action = actor.actions[opening_index]
                if dv_has(["shen.opening.welcome", "shen.opening.introduce", "huo.opening.introduce", "su.opening.introduce", "shen.opening.memory-report"], opening_action.id):
                    opening_action = dv_without(opening_action, "offer_to")
                    opening_action = dv_with(opening_action, "opportunity_requirement", {"location": "hall", "participants": ["huo", "shen", "su"], "mode": "all-present"})
                if opening_action.id == "shen.opening.serve-tea":
                    opening_action = dv_with_many(opening_action, {"authority_precondition": dv_all([c1_at("shen", "hall"), c1_op_property("opening.tea", "prepared", true), c1_at("huo", "hall"), c1_at("su", "hall")]), "opportunity_requirement": {"location": "hall", "participants": ["huo", "shen", "su"], "mode": "all-present"}})
                rt_push(opening_actions, opening_action)
                opening_index = opening_index + 1
            actor = dv_with(actor, "actions", opening_actions)
        if actor.id == "detective":
            var mind = dv_store(actor.mind, dv_ref("detective", "state", "location"), dv_with(dv_field(c1_other_case(group).room), "basis", [c1_other_case(group).source]))
            mind = c2_add_new(mind, c1_local_object(rt_cat("case.", group)))
            actor = dv_with_many(actor, {"mind": mind, "location": c1_other_case(group).room, "actions": actor.actions, "policy": actor.policy})
            actor = c1_other_activity_actor(actor, group)
            let peers = c1_other_people()
            var peer_index = 0
            while peer_index < rt_count(peers):
                let peer = peers[peer_index]
                if peer.group == group:
                    mind = c2_add_new(actor.mind, c1_local_object(peer.id))
                    rt_push(bindings, dv_binding(peer.id, peer.id, "detective"))
                    let ready = c1_at("detective", c1_other_case(group).room)
                    let seen = c2_action(rt_cat("detective.other.see.", peer.id), "inspect", ready, dv_all([ready, c1_at(peer.id, c1_other_case(group).room)]), "", [dv_ref(peer.id, "state", "location")], rt_cat("看到同在寝区的", peer.name), c1_other_case(group).source)
                    actor = dv_with_many(actor, {"mind": mind, "actions": dv_append(actor.actions, seen), "policy": dv_with(actor.policy, "goals", dv_append(actor.policy.goals, c2_observation_goal(dv_ref(peer.id, "state", "location"), ready, [c1_other_case(group).source], 0)))})
                peer_index = peer_index + 1
            let source = c1_other_case(group).source
            let literal = c1_other_submission(group, c1_other_case(group).authority_actor)
            let answer_id = rt_cat("detective.answer.", group)
            let answer_ready = dv_all([c1_at("detective", c1_other_case(group).room), literal, dv_at_least(c1_other_clock_ref(), c1_other_report_time(group))])
            let answer_action = dv_with_many(c2_action(answer_id, "answer", answer_ready, answer_ready, "", [], rt_cat(c1_other_person(c1_other_case(group).authority_actor).name, c1_other_report_surface(group)), source), {"answer": literal, "answer_id": answer_id, "topic": rt_cat(group, ".identity"), "speech": dv_with_many(c1_speech(literal, source, "locally-supported-three-part-report"), {"surface": rt_cat(c1_other_person(c1_other_case(group).authority_actor).name, c1_other_report_surface(group)), "channel": rt_cat("copper.", group)}), "listeners": ["demon"]})
            actor = dv_with(actor, "actions", dv_append(actor.actions, answer_action))
            rt_push(answers, {"id": answer_id, "stage": rt_cat(group, ".identity"), "condition": literal, "required_support": literal, "question_match": c1_other_claim(group, "open"), "answer_complete": literal, "require_argument": false, "accepted_law": rt_cat("other.accept.", rt_cat(group, ".detective")), "progress_ref": c1_other_ref(group, "level.detective"), "completion_ref": c1_other_ref(group, "receipt.detective"), "accepted_listeners": ["detective"], "accepted_public_grants": [c1_other_ref(group, "receipt.detective"), c1_other_ref(group, "level.detective")], "source_refs": [source]})
            let origins = [c1_other_case(group).room, c1_other_threshold(group)]
            let targets = [c1_other_threshold(group), "living_hall"]
            var move_index = 0
            while move_index < rt_count(origins):
                let move_id = rt_cat("detective.other.exit.", rt_cat(group, rt_cat(".", origins[move_index])))
                let pre = dv_all([c1_at("detective", origins[move_index]), c1_other_claim(group, "outer_latch_released"), dv_fact(c1_other_access_ref(group), true)])
                let law = dv_axiom(move_id, 1, pre, [dv_assign(dv_ref("detective", "state", "location"), targets[move_index])])
                world = dv_adopt(world, c1_method(move_id, law), "enforce", 1, [source])
                mind = dv_adopt(actor.mind, c1_method(move_id, law), "predict", 1, [source])
                let action = dv_with_many(c2_action(move_id, "move", pre, pre, move_id, [dv_ref("detective", "state", "location")], "确认外闩已经打开后，跨过门槛。", source), {"predict_law": move_id, "travel": {"from": origins[move_index], "to": targets[move_index], "gate": group}})
                actor = dv_with_many(actor, {"mind": mind, "actions": dv_append(actor.actions, action)})
                move_index = move_index + 1
            let truth = c1_other_truth_rows(group)
            var j = 0
            while j < rt_count(truth):
                let row = truth[j]
                world = dv_store(world, c1_other_ref(group, row.id), dv_field(false))
                let method = rt_cat("detective.truth.", row.id)
                let law = c1_other_truth_law(group, row)
                world = dv_adopt(world, c1_method(method, law), "enforce", 1, [c1_other_case(group).source])
                mind = actor.mind
                mind = dv_store(mind, c1_other_ref(group, row.id), dv_with(dv_field(false), "basis", [c1_other_case(group).source]))
                mind = dv_adopt(mind, c1_method(method, law), "predict", 1, [c1_other_case(group).source])
                var action = dv_with(c2_action(method, row.kind, law.premise, law.premise, method, [c1_other_ref(group, row.id)], row.text, c1_other_case(group).source), "predict_law", method)
                if row.kind == "talk":
                    let after = c1_other_claim(group, row.after)
                    action = dv_with_many(c2_action(rt_cat("detective.truth.ask.", row.id), "talk", dv_all([c1_at("detective", c1_other_case(group).room), after]), dv_all([c1_at("detective", c1_other_case(group).room), c1_at(row.partner, c1_other_case(group).room)]), "", [], "请看这份已核对的材料。你能说明自己记得的经过吗？", c1_other_case(group).source), {"speech": dv_with_many(c1_speech(after, c1_other_case(group).source, "actual-evidence-question"), {"surface": "请看这份已核对的材料。你能说明自己记得的经过吗？", "request": {"target": row.partner, "topic": rt_cat("truth.", row.id)}}), "listeners": [row.partner], "purpose_refs": [c1_other_ref(group, row.id)]})
                let actions = dv_append(actor.actions, action)
                var goals = dv_append(actor.policy.goals, c2_goal(c1_other_claim(group, row.id), c1_at("detective", c1_other_case(group).room), [c1_other_case(group).source]))
                if row.kind == "talk":
                    rt_push(goals, {"kind": "communicate", "scope": "personal", "method_id": action.id, "available_when": action.precondition, "requires_argument": false, "basis": [c1_other_case(group).source]})
                actor = dv_with_many(actor, {"mind": mind, "actions": actions, "policy": dv_with(actor.policy, "goals", goals)})
                j = j + 1
            let last = truth[rt_count(truth) - 1]
            let reason = c1_other_ref(group, rt_cat("reason.", c1_other_case(group).authority_reason))
            let inference = dv_axiom(rt_cat("detective.truth.reason.", group), 1, c1_other_claim(group, last.id), [dv_assign(reason, true)])
            actor = dv_with(actor, "mind", dv_adopt(actor.mind, c1_method(rt_cat("detective.truth.reason.", group), inference), "infer", 1, [c1_other_case(group).source]))
            rt_push(bindings, dv_binding(rt_cat("case.", group), rt_cat("case.", group), "detective"))
        rt_push(actors, actor)
        i = i + 1
    var respondents = []
    let truth = c1_other_truth_rows(group)
    i = 0
    while i < rt_count(actors):
        var actor = actors[i]
        var j = 0
        while j < rt_count(truth):
            let row = truth[j]
            if row.kind == "talk" and actor.id == row.partner:
                let source = c1_other_case(group).source
                let ref = c1_other_ref(group, row.id)
                let method = rt_cat("detective.truth.", row.id)
                let law = c1_other_truth_law(group, row)
                var mind = dv_store(actor.mind, ref, dv_with(dv_field(false), "basis", [source]))
                mind = dv_adopt(mind, c1_method(method, law), "predict", 1, [source])
                let recall = dv_with_many(c2_action(rt_cat(actor.id, rt_cat(".truth.recall.", row.id)), "help", law.premise, law.premise, method, [ref], "他重新看向来问者递出的材料，试着把自己的记忆接起来。", source), {"predict_law": method, "received_speech_requirement": {"speaker": "detective", "action_id": rt_cat("detective.truth.ask.", row.id)}})
                let claim = dv_fact(ref, true)
                let reply = dv_with_many(c2_action(rt_cat(actor.id, rt_cat(".truth.reply.", row.id)), "talk", dv_all([claim, c1_at(actor.id, c1_other_case(group).room)]), c1_at(actor.id, c1_other_case(group).room), "", [], row.text, source), {"speech": dv_with(c1_speech(claim, source, "own-recollection-after-request"), "surface", row.text), "listeners": ["detective"], "response_topic": rt_cat("truth.", row.id), "requires_actual_request": true})
                let actions = dv_append(dv_append(actor.actions, recall), reply)
                let goals = dv_append(actor.policy.goals, c2_goal(claim, c1_other_claim(group, row.after), [source]))
                rt_push(goals, {"kind": "communicate", "scope": "personal", "method_id": reply.id, "available_when": claim, "requires_argument": false, "basis": [source]})
                actor = dv_with_many(actor, {"mind": mind, "actions": actions, "policy": dv_with(actor.policy, "goals", goals)})
            j = j + 1
        rt_push(respondents, actor)
        i = i + 1
    return dv_with_many(scene, {"physical": world, "actors": respondents, "bindings": bindings, "detective_start_group": group, "formal_answers": answers})

fn c1_other_truth_rows(group):
    if group == "contract":
        return [
            {"id": "seal_examined", "actor": "detective", "after": "evidence_complete", "time": 480, "kind": "inspect", "partner": "", "text": "侦探对照火漆指模、封口和纸片毛边：封缄曾由同一只手压合，红墨残纸是从完整文书新撕下的。它说明有人交接，不能独自补出授权者。"},
            {"id": "quer_recalled", "actor": "detective", "after": "seal_examined", "time": 480, "kind": "talk", "partner": "quer", "text": "侦探把封口与毛边递给雀儿。她盯着火漆，想起有人将钥匙和文书交到她掌中，叮嘱她取出内柜物件并藏妥。她承认藏入壁炉砖槽；这不是她自行决定的偷窃。"}
        ]
    if group == "astral":
        return [
            {"id": "moran_calmed", "actor": "detective", "after": "evidence_complete", "time": 480, "kind": "talk", "partner": "moran", "text": "侦探没有催问，陪莫兰把呼吸放缓。他终于同意打开画夹暗层，取出未被截去的完整草图。"},
            {"id": "gesture_examined", "actor": "detective", "after": "moran_calmed", "time": 480, "kind": "inspect", "partner": "", "text": "完整草图中，伊莲娜伸出的手接着做了明确的劈切手势。半截画面遮住的，正是这个后续动作。"},
            {"id": "elena_identified", "actor": "detective", "after": "gesture_examined", "time": 480, "kind": "talk", "partner": "elena", "text": "伊莲娜辨认完整草图：‘是我的手。我让她关。’阮清月确实拉闸，却不是单方面把她抛下。"}
        ]
    return [
        {"id": "old_scar_examined", "actor": "detective", "after": "evidence_complete", "time": 480, "kind": "inspect", "partner": "veronica", "text": "维罗妮卡同意卷起左袖。侦探查看的是左臂旧疤，边缘已愈合，与贝尔特朗今天的高烧分属不同病史。"},
        {"id": "veronica_explained", "actor": "detective", "after": "old_scar_examined", "time": 480, "kind": "talk", "partner": "veronica", "text": "维罗妮卡说明：左臂三道旧疤来自R-07强酸络合剂的自体耐受标定。她依据此前在自己身上做的标定救治贝尔特朗；今天的酸泡争执不能抹去旧疤与救治用途。"}
    ]

axiom c1_other_truth_law(group, row):
    var subject = "detective"
    if row.kind == "talk":
        subject = row.partner
    var pre = [c1_at(subject, c1_other_case(group).room), c1_other_claim(group, row.after), dv_fact(c1_other_ref(group, row.id), false)]
    if row.partner != "":
        rt_push(pre, c1_at(row.partner, c1_other_case(group).room))
    return dv_axiom(rt_cat("detective.truth.", row.id), 1, dv_all(pre), [dv_assign(c1_other_ref(group, row.id), true)])

// Present doors, bodies and heard voices are distinct from frozen accident evidence.
// Initial placement creates a physical body; it never opens a latch or marks a crossing.

fn c1dep_source(file, line, id):
    return c1_source(rt_cat("godot_csharp/scenes/Awakening/Script/story/第一章/场面/", file), line, id)

fn c1dep_ref(field):
    return dv_ref("departure.door", "state", field)

fn c1dep_cross_ref(actor):
    return dv_ref(rt_cat("departure.person.", actor), "state", "crossed")

fn c1dep_complete():
    return dv_all([dv_fact(dv_ref("question", "state", "solved_identity"), true), dv_fact(dv_ref("question", "state", "solved_voice_source"), true), dv_fact(dv_ref("question", "state", "solved_words"), true), dv_fact(dv_ref("question", "state", "solved_trust"), true)])

fn c1dep_can_cross():
    return dv_all([dv_fact(c1dep_ref("outer_released"), true), dv_fact(c1dep_ref("inner_down"), false), dv_fact(c1dep_ref("open"), true)])

fn c1dep_entered(world, actor):
    return dv_truth(world, dv_fact(c1dep_cross_ref(actor), true)) == "true"

axiom c1dep_outer_law():
    return dv_axiom("c1dep_outer_law", 1, dv_all([c1dep_complete(), c2_at("demon", "living_hall"), dv_fact(dv_ref("demon.body", "state", "manifested"), true), dv_fact(c1dep_ref("outer_released"), false)]), [dv_assign(c1dep_ref("outer_released"), true), dv_assign(c2_access("living_exit"), true), dv_assign(dv_ref("demon.body", "state", "manifested"), false), dv_assign(dv_ref("demon.body", "state", "latch_hand_trace"), "long-narrow-hand")])

axiom c1dep_pick_law():
    return dv_axiom("c1dep_pick_law", 1, dv_all([c1_at("quer", "living_hall"), dv_at_least(c1_other_clock_ref(), 780), dv_fact(c1dep_ref("outer_released"), false), dv_fact(c1dep_ref("quer_has_wire"), true)]), [dv_assign(c1dep_ref("outer_released"), true), dv_assign(c1dep_ref("picked_by_quer"), true), dv_assign(c2_access("living_exit"), true)])

axiom c1dep_pick_contract_law():
    return dv_axiom("c1dep_pick_contract_law", 1, dv_all([c1_at("quer", "dorm.contract"), dv_at_least(c1_other_clock_ref(), 630), c1_other_claim("contract", "quer_insulted"), dv_fact(c1dep_ref("quer_has_wire"), true), dv_fact(c1_other_ref("contract", "outer_latch_released"), false)]), [dv_assign(c1_other_ref("contract", "outer_latch_released"), true), dv_assign(c1_other_access_ref("contract"), true), dv_assign(c1dep_ref("contract_picked_by_quer"), true)])

axiom c1dep_inner_law(actor):
    return dv_axiom("c1dep_inner_law", 1, dv_all([c1_at(actor, "foyer"), dv_fact(c1dep_ref("outer_released"), true), dv_fact(c1dep_ref("inner_down"), true)]), dv_single(dv_assign(c1dep_ref("inner_down"), false)))

axiom c1dep_open_law(actor):
    return dv_axiom("c1dep_open_law", 1, dv_all([c1_at(actor, "foyer"), dv_fact(c1dep_ref("outer_released"), true), dv_fact(c1dep_ref("inner_down"), false), dv_fact(c1dep_ref("open"), false)]), dv_single(dv_assign(c1dep_ref("open"), true)))

axiom c1dep_cross_law(actor, outward):
    var origin = "living_hall"
    var target = "foyer"
    if outward:
        origin = "foyer"
        target = "living_hall"
    var effects = dv_single(dv_assign(dv_ref(actor, "state", "location"), target))
    if outward:
        rt_push(effects, dv_assign(c1dep_cross_ref(actor), true))
    return dv_axiom("c1dep_cross_law", 1, dv_all([c1_at(actor, origin), c1dep_can_cross()]), effects)

axiom c1dep_join_law(actor, group):
    var pre = dv_all([c1_at(actor, rt_cat("threshold.", group)), dv_fact(c2_ref(rt_cat("case.", group), "outer_latch_released"), true), dv_fact(c2_access(group), true)])
    if actor == "quer" or actor == "lucian":
        pre = dv_all([pre, dv_at_least(c1_other_clock_ref(), 690)])
    return dv_axiom("c1dep_join_law", 1, pre, dv_single(dv_assign(dv_ref(actor, "state", "location"), "living_hall")))

fn c1dep_speech(actor, id, room, when, literal, text, source):
    return dv_with_many(c2_action(id, "talk", dv_all([c1_at(actor, room), when, literal]), c1_at(actor, room), "", [], text, source), {"speech": dv_with_many(c1_speech(literal, source, "current-doorway-dialogue"), {"surface": text, "channel": "door.living"}), "listeners": dv_append(c2_people(), "demon")})

fn c1dep_actions(actor):
    var actions = []
    let source = c1dep_source("08_终局.story", 4, "s10_steps.003")
    let four = ["detective", "huo", "shen", "su"]
    if dv_has(four, actor):
        let fields = [c1dep_ref("outer_released"), c1dep_ref("inner_down"), c1dep_ref("open"), c2_access("living_exit")]
        let question_opened = dv_not(dv_all([dv_not(dv_fact(dv_ref("question", "state", "open_identity"), true)), dv_not(dv_fact(dv_ref("question", "state", "solved_identity"), true))]))
        let investigating = dv_all([c1_at(actor, "foyer"), question_opened])
        rt_push(actions, dv_with(c2_action(rt_cat(actor, ".departure.inspect-door"), "inspect", investigating, c1_at(actor, "foyer"), "", fields, "查看门内的插闩和门外的横闩。", c1dep_source("11_门外的人.story", 8, "door_voices.005")), "repeatable", true))
        if actor == "detective":
            let inner = dv_all([c1_at(actor, "foyer"), dv_fact(c1dep_ref("outer_released"), true), dv_fact(c1dep_ref("inner_down"), true)])
            rt_push(actions, dv_with_many(c2_action(rt_cat(actor, ".departure.draw-inner"), "help", inner, inner, rt_cat(actor, ".departure.draw-inner"), dv_single(c1dep_ref("inner_down")), "拔出门内的插闩。", source), {"predict_law": rt_cat(actor, ".departure.draw-inner"), "public_observers": four, "public_grants": [c1dep_ref("inner_down")]}))
            let open = dv_all([c1_at(actor, "foyer"), dv_fact(c1dep_ref("outer_released"), true), dv_fact(c1dep_ref("inner_down"), false)])
            rt_push(actions, dv_with_many(c2_action(rt_cat(actor, ".departure.open-door"), "help", open, open, rt_cat(actor, ".departure.open-door"), dv_single(c1dep_ref("open")), "拉开隔离门。", c1dep_source("08_终局.story", 8, "s10_open")), {"predict_law": rt_cat(actor, ".departure.open-door"), "speech": dv_with_many(c1_speech(dv_true(), c1dep_source("08_终局.story", 8, "s10_open"), "actual-door-open"), {"surface": "拉开隔离门。", "channel": "door.living"}), "listeners": ["huo", "shen", "su"], "public_grants": [c1dep_ref("outer_released"), c1dep_ref("inner_down"), c1dep_ref("open"), c2_access("living_exit")]}))
        let out = dv_all([c1_at(actor, "foyer"), c1dep_can_cross()])
        let back = dv_all([c1_at(actor, "living_hall"), c1dep_can_cross()])
        let out_id = rt_cat(actor, ".departure.cross-out")
        let in_id = rt_cat(actor, ".departure.cross-in")
        rt_push(actions, dv_with_many(c2_action(out_id, "move", out, out, out_id, [dv_ref(actor, "state", "location"), c1dep_cross_ref(actor), c1_other_clock_ref()], "跨过门槛，走进起居厅。", c1dep_source("08_终局.story", 24, "s10_open.003：是否迈出由本人选择")), {"predict_law": out_id, "repeatable": true, "travel": {"from": "foyer", "to": "living_hall", "gate": "living_exit"}}))
        rt_push(actions, dv_with_many(c2_action(in_id, "move", back, back, in_id, dv_single(dv_ref(actor, "state", "location")), "穿过隔离门，回到门厅。", source), {"predict_law": in_id, "repeatable": true, "travel": {"from": "living_hall", "to": "foyer", "gate": "living_exit"}}))
    if actor != "demon" and c2_profile(actor).group != "living":
        let group = c2_profile(actor).group
        let pre = c1dep_join_law(actor, group).premise
        let id = rt_cat(actor, ".departure.join-living")
        rt_push(actions, dv_with_many(c2_action(id, "move", pre, pre, id, dv_single(dv_ref(actor, "state", "location")), "从寝区门外走进起居厅。", c1_other_departure_source(actor).source), {"predict_law": id, "repeatable": true, "travel": {"from": rt_cat("threshold.", group), "to": "living_hall", "gate": "living"}}))
    if actor == "quer":
        rt_push(actions, dv_with(c2_action("quer.departure.inspect-yi-outer", "inspect", c1_at(actor, "living_hall"), c1_at(actor, "living_hall"), "", [c1dep_ref("outer_released")], "查看乙区门外的横闩。", source), "repeatable", true))
        let own_pre = c1dep_pick_contract_law().premise
        rt_push(actions, dv_with_many(c2_action("quer.departure.pick-contract", "experiment", own_pre, own_pre, "quer.departure.pick-contract", [c1_other_ref("contract", "outer_latch_released"), c1_other_access_ref("contract"), c1dep_ref("contract_picked_by_quer")], "雀儿受够了盘问，从袖口拉出精钢丝，探过门缝挑起甲区外闩。卢西安收起手稿，跟上她。", c1_source("docs/design-standard.md", 0, "甲区开锁机会")), {"predict_law": "quer.departure.pick-contract", "public_observers": ["lucian", "ward", "gu"], "public_grants": [c1_other_ref("contract", "outer_latch_released"), c1_other_access_ref("contract")]}))
        let pre = c1dep_pick_law().premise
        rt_push(actions, dv_with(c2_action("quer.departure.pick-outer", "experiment", pre, pre, "quer.departure.pick-outer", [c1dep_ref("outer_released"), c1dep_ref("picked_by_quer"), c2_access("living_exit")], "细铁丝拨了四下，外侧的横闩抬了起来。", c1dep_source("12_雀儿撬门.story", 7, "quer_opens.001-002")), "predict_law", "quer.departure.pick-outer"))
        let receipt = dv_at_least(c1_other_clock_ref(), 690)
        let call = c1dep_speech(actor, "quer.departure.call-inside", "living_hall", receipt, dv_true(), "里头有人？", c1dep_source("11_门外的人.story", 5, "door_voices.002：询问部分"))
        rt_push(actions, dv_with(call, "speech", dv_with(call.speech, "utterance_type", "question")))
        let self = dv_fact(c1dep_ref("contract_picked_by_quer"), true)
        let reply = c1dep_speech(actor, "quer.departure.answer-door", "living_hall", self, self, "甲区的，叫我雀儿。那边的门让我挑开了。你们这扇，我也可以看看。", c1dep_source("11_门外的人.story", 8, "door_voices.005"))
        rt_push(actions, dv_with(reply, "response_topic", "door_identity"))
    if actor == "lucian":
        let receipt = dv_at_least(c1_other_clock_ref(), 690)
        rt_push(actions, dv_with(c1dep_speech(actor, "lucian.departure.rebuke-quer", "living_hall", receipt, dv_true(), "雀儿，贴着门板喊，里头听得见，礼数可就丢了。", c1dep_source("11_门外的人.story", 6, "door_voices.003")), "received_speech_requirement", {"speaker": "quer", "action_id": "quer.departure.call-inside"}))
    if actor == "detective":
        var ask = c1dep_speech(actor, "detective.departure.ask-door", "foyer", dv_true(), dv_true(), "门外是谁？", c1dep_source("11_门外的人.story", 7, "door_voices.004"))
        ask = dv_with_many(ask, {"speech": dv_with(ask.speech, "request", {"target": "quer", "topic": "door_identity"}), "request_transport": {"channel": "door.living"}, "received_speech_requirement": {"speaker": "quer", "action_id": "quer.departure.call-inside"}})
        rt_push(actions, ask)
    if actor == "demon":
        let manifestation = c1dep_manifest_law()
        rt_push(actions, dv_with_many(c2_action("demon.departure.manifest", "help", manifestation.premise, manifestation.premise, "demon.departure.manifest", [dv_ref("demon.body", "state", "manifested")], "虚影在门闩前凝实，修长窄薄的手掌获得了可以碰触物体的重量。", source), {"predict_law": "demon.departure.manifest", "repeatable": true}))
        let groups = ["contract", "astral", "logistics"]
        var g = 0
        while g < rt_count(groups):
            let group = groups[g]
            var refs = [c1_other_ref(group, "outer_latch_released"), c1_other_ref(group, "formal_release"), c1_other_ref(group, "evidence_complete"), c1_other_ref(group, "care_given"), c1_other_ref(group, "west_passage_checked"), c1_other_ref(group, "observation_complete"), c1_other_clock_ref()]
            let people = c1_other_people()
            var p = 0
            while p < rt_count(people):
                if people[p].group == group:
                    rt_push(refs, c1_other_ref(group, rt_cat("receipt.", people[p].id)))
                p = p + 1
            rt_push(actions, dv_with(c2_action(rt_cat("demon.departure.inspect.", group), "inspect", c2_at(actor, "living_hall"), c2_at(actor, "living_hall"), "", refs, "核对铜口答复记录与寝区外闩。", c1_other_case(group).source), "repeatable", true))
            rt_push(actions, c1_other_release_action(group, actor, c1_other_clock_ref()))
            g = g + 1
        let solved_refs = [dv_ref("question", "state", "solved_identity"), dv_ref("question", "state", "solved_voice_source"), dv_ref("question", "state", "solved_words"), dv_ref("question", "state", "solved_trust")]
        rt_push(actions, dv_with(c2_action("demon.departure.inspect-accepted", "inspect", c2_at(actor, "living_hall"), c2_at(actor, "living_hall"), "", solved_refs, "查看已认定的答复。", source), "repeatable", true))
        rt_push(actions, dv_with(c2_action("demon.departure.inspect-body", "inspect", dv_true(), dv_true(), "", dv_single(c2_position_ref(actor)), "看了看周围。", source), "repeatable", true))
        rt_push(actions, dv_with(c2_action("demon.departure.inspect-outer", "inspect", c2_at(actor, "living_hall"), c2_at(actor, "living_hall"), "", dv_single(c1dep_ref("outer_released")), "查看隔离门外侧的横闩。", source), "repeatable", true))
        let after_answer = dv_all([c2_at(actor, "living_hall"), c1dep_complete()])
        rt_push(actions, dv_with(c2_action("demon.departure.inspect-clock", "inspect", after_answer, after_answer, "", [c1_other_clock_ref()], "查看起居厅钟面。", source), "repeatable", true))
        let pre = c1dep_outer_law().premise
        let lifted = c2_action("demon.departure.release-outer", "help", pre, pre, "demon.departure.release-outer", [c1dep_ref("outer_released"), c2_access("living_exit"), dv_ref("demon.body", "state", "manifested")], "外侧的横闩，被一只手抬了起来。", source)
        rt_push(actions, dv_with_many(lifted, {"predict_law": "demon.departure.release-outer", "speech": dv_with_many(c1_speech(dv_true(), source, "actual-latch-sound"), {"surface": "门外传来横闩抬起的金属响声。", "channel": "door.living"}), "listeners": four, "public_grants": [c1dep_ref("outer_released"), c2_access("living_exit")]}))
    let hand_ref = dv_ref("demon.body", "state", "hand_shape")
    let owner_ref = dv_ref("demon.body", "state", "shelf_print_owner")
    let hand_source = c1_source("docs/design-standard.md", 0, "架沿手印的观察与询问")
    if dv_has(four, actor):
        let present = dv_all([c1_at(actor, "living_hall"), c2_at("demon", "living_hall"), dv_fact(dv_ref("demon.body", "state", "manifested"), true)])
        rt_push(actions, c2_action(rt_cat(actor, ".departure.inspect-hand"), "inspect", c1_at(actor, "living_hall"), present, "", [hand_ref], "他手形修长，掌面窄薄。仅凭外形，还不能断定架沿的半枚手印属于他。", hand_source))
        let seen_print = dv_fact(c1_knowledge("hand_not_mine"), true)
        var ask = c1dep_speech(actor, rt_cat(actor, ".departure.ask-print"), "living_hall", seen_print, dv_true(), "架上的手印，是你的吗？", hand_source)
        ask = dv_with_many(ask, {"speech": dv_with_many(ask.speech, {"channel": "local", "request": {"target": "demon", "topic": "shelf.print-owner"}}), "purpose_refs": [owner_ref]})
        rt_push(actions, ask)
    if actor == "demon":
        let claim = dv_fact(owner_ref, "demon")
        var reply = c1dep_speech(actor, "demon.departure.answer-print", "living_hall", claim, claim, "是。诸位封存之物，是我取走的。", hand_source)
        reply = dv_with_many(reply, {"precondition": dv_all([c2_at(actor, "living_hall"), claim]), "authority_precondition": c2_at(actor, "living_hall"), "speech": dv_with(reply.speech, "channel", "local"), "response_topic": "shelf.print-owner", "requires_actual_request": true})
        rt_push(actions, c1_authorized_speech(reply))
    return c1_public_methods(actions)

fn c1dep_laws(world, actor):
    var mode = "enforce"
    if world.domain == "mind":
        mode = "predict"
    var result = world
    let source = c1dep_source("08_终局.story", 4, "s10_steps.003")
    if actor == "detective":
        result = dv_adopt(result, c1_method(rt_cat(actor, ".departure.draw-inner"), c1dep_inner_law(actor)), mode, 1, [source])
        result = dv_adopt(result, c1_method(rt_cat(actor, ".departure.open-door"), c1dep_open_law(actor)), mode, 1, [source])
    if dv_has(["detective", "huo", "shen", "su"], actor):
        result = dv_adopt(result, c1_method(rt_cat(actor, ".departure.cross-out"), c1dep_cross_law(actor, true)), mode, 1, [source])
        result = dv_adopt(result, c1_method(rt_cat(actor, ".departure.cross-in"), c1dep_cross_law(actor, false)), mode, 1, [source])
    if actor != "demon" and c2_profile(actor).group != "living":
        result = dv_adopt(result, c1_method(rt_cat(actor, ".departure.join-living"), c1dep_join_law(actor, c2_profile(actor).group)), mode, 1, [c1_other_departure_source(actor).source])
    if actor == "quer":
        result = dv_adopt(result, c1_method("quer.departure.pick-contract", c1dep_pick_contract_law()), mode, 1, [c1_source("docs/design-standard.md", 0, "甲区开锁机会")])
        result = dv_adopt(result, c1_method("quer.departure.pick-outer", c1dep_pick_law()), mode, 1, [c1dep_source("12_雀儿撬门.story", 7, "quer_opens.001-002")])
    if actor == "demon":
        result = dv_adopt(result, c1_method("demon.departure.manifest", c1dep_manifest_law()), mode, 1, [source])
        if mode == "predict":
            let groups = ["contract", "astral", "logistics"]
            var g = 0
            while g < rt_count(groups):
                result = dv_adopt(result, c1_method(rt_cat("other.release.", groups[g]), c1_other_release(groups[g], c1_other_clock_ref())), mode, 1, [c1_other_case(groups[g]).source])
                g = g + 1
        result = dv_adopt(result, c1_method("demon.departure.release-outer", c1dep_outer_law()), mode, 1, [source])
    return result

fn c1dep_goals(actor):
    var goals = []
    let source = [c1dep_source("08_终局.story", 24, "s10_open.003：未迈出由本人选择")]
    if dv_has(["detective", "huo", "shen", "su"], actor.id):
        let after_trust = dv_fact(dv_ref("question", "state", "solved_trust"), true)
        rt_push(goals, dv_with(c2_observation_goal(c1dep_ref("outer_released"), after_trust, source, 0), "refresh_until", dv_fact(c1dep_ref("outer_released"), true)))
        rt_push(goals, c2_observation_goal(c1dep_ref("inner_down"), after_trust, source, 0))
        rt_push(goals, c2_observation_goal(c1dep_ref("open"), after_trust, source, 0))
        rt_push(goals, c2_goal(dv_fact(c1dep_ref("inner_down"), false), dv_fact(c1dep_ref("outer_released"), true), source))
        rt_push(goals, c2_goal(dv_fact(c1dep_ref("open"), true), dv_fact(c1dep_ref("outer_released"), true), source))
        rt_push(goals, c2_goal(c1_at(actor.id, "living_hall"), dv_fact(c1dep_ref("outer_released"), true), source))
    if actor.id != "demon" and c2_profile(actor.id).group != "living":
        let leave = c1_other_depart(actor.id)
        rt_push(goals, c2_goal(c1_at(actor.id, rt_cat("threshold.", c2_profile(actor.id).group)), leave.premise, [c1_other_departure_source(actor.id).source]))
        var join_available = c1_at(actor.id, rt_cat("threshold.", c2_profile(actor.id).group))
        if actor.id == "quer" or actor.id == "lucian":
            join_available = c1dep_join_law(actor.id, c2_profile(actor.id).group).premise
        rt_push(goals, c2_goal(c1_at(actor.id, "living_hall"), join_available, [c1_other_departure_source(actor.id).source]))
    if actor.id == "quer":
        rt_push(goals, c2_goal(c1_other_claim("contract", "outer_latch_released"), c1dep_pick_contract_law().premise, source))
        rt_push(goals, dv_with(c2_observation_goal(c1dep_ref("outer_released"), c1_at(actor.id, "living_hall"), source, 0), "refresh_until", dv_fact(c1dep_ref("outer_released"), true)))
        rt_push(goals, c2_goal(dv_fact(c1dep_ref("outer_released"), true), c1_at(actor.id, "living_hall"), [c1dep_source("12_雀儿撬门.story", 10, "quer_opens.004")]))
    let actions = c1dep_actions(actor.id)
    var i = 0
    while i < rt_count(actions):
        if dv_has_key(actions[i], "speech"):
            rt_push(goals, {"kind": "communicate", "scope": "personal", "method_id": actions[i].id, "available_when": actions[i].precondition, "requires_argument": false, "basis": actions[i].source_refs})
        i = i + 1
    if actor.id == "demon":
        rt_push(goals, c2_observation_goal(c1_other_clock_ref(), dv_all([c2_at(actor.id, "living_hall"), c1dep_complete()]), source, 0))
        let people = c1_other_people()
        i = 0
        while i < rt_count(people):
            let ref = c1_other_ref(people[i].group, rt_cat("receipt.", people[i].id))
            rt_push(goals, c2_observation_goal(ref, c2_at(actor.id, "living_hall"), source, 0))
            i = i + 1
        let groups = ["contract", "astral", "logistics"]
        i = 0
        while i < rt_count(groups):
            let ref = c1_other_ref(groups[i], "formal_release")
            var receipt_refs = []
            var receipt_index = 0
            while receipt_index < rt_count(people):
                if people[receipt_index].group == groups[i]:
                    rt_push(receipt_refs, c1_other_ref(groups[i], rt_cat("receipt.", people[receipt_index].id)))
                receipt_index = receipt_index + 1
            let evidence_ref = c1_other_ref(groups[i], "evidence_complete")
            rt_push(goals, dv_with_many(c2_observation_goal(evidence_ref, c2_at(actor.id, "living_hall"), source, 0), {"refresh_until": dv_fact(evidence_ref, true), "refresh_refs": receipt_refs}))
            var reported = dv_not(dv_true())
            var safe_time = 840
            var safety = c1_other_claim(groups[i], "evidence_complete")
            if groups[i] == "astral":
                safe_time = 1890
                safety = dv_all([c1_other_claim(groups[i], "care_given"), c1_other_claim(groups[i], "west_passage_checked")])
            if groups[i] == "logistics":
                safe_time = 2010
                safety = dv_all([c1_other_claim(groups[i], "care_given"), c1_other_claim(groups[i], "observation_complete")])
            var person_index = 0
            while person_index < rt_count(people):
                if people[person_index].group == groups[i]:
                    reported = c1_any(reported, c1_other_claim(groups[i], rt_cat("receipt.", people[person_index].id)))
                person_index = person_index + 1
            let manifest_ready = dv_all([reported, safety, dv_at_least(c1_other_clock_ref(), safe_time), c2_at(actor.id, "living_hall"), dv_fact(dv_ref("demon.body", "state", "manifested"), false)])
            rt_push(goals, c2_goal(dv_fact(dv_ref("demon.body", "state", "manifested"), true), manifest_ready, source))
            rt_push(goals, c2_observation_goal(ref, c2_at(actor.id, "living_hall"), source, 0))
            rt_push(goals, c2_goal(dv_fact(ref, true), c1_other_release(groups[i], c1_other_clock_ref()).premise, source))
            i = i + 1
        rt_push(goals, c2_goal(dv_fact(dv_ref("demon.body", "state", "manifested"), true), c1dep_manifest_law().premise, source))
        rt_push(goals, c2_observation_goal(c2_position_ref(actor.id), dv_true(), source, 0))
        rt_push(goals, c2_observation_goal(c1dep_ref("outer_released"), c2_at(actor.id, "living_hall"), source, 0))
        rt_push(goals, c2_goal(dv_fact(c1dep_ref("outer_released"), true), c1dep_complete(), source))
    var refreshed = []
    var g = 0
    while g < rt_count(goals):
        var goal = goals[g]
        if dv_has_key(goal, "refresh_until") and not dv_has_key(goal, "refresh_refs"):
            var triggers = []
            if dv_has(["detective", "huo", "shen", "su"], actor.id):
                rt_push(triggers, dv_ref("question", "state", "solved_trust"))
            goal = dv_with(goal, "refresh_refs", triggers)
        rt_push(refreshed, goal)
        g = g + 1
    goals = refreshed

    return goals

fn c1dep_install_scene(scene):
    if dv_find(scene, "departure_installed", false):
        return scene
    var physical = dv_store(scene.physical, dv_ref("demon", "state", "location"), dv_field("living_hall"))
    physical = c2_add_new(physical, c1_state_object("departure.door", {"outer_released": dv_field(false), "inner_down": dv_field(true), "open": dv_field(false), "quer_has_wire": dv_field(true), "picked_by_quer": dv_field(false), "contract_picked_by_quer": dv_field(false)}))
    physical = c2_add_new(physical, c1_state_object("demon.body", {"manifested": dv_field(false), "latch_hand_trace": dv_field("")}))
    physical = dv_store(physical, dv_ref("demon.body", "state", "hand_shape"), dv_field("long-narrow-hand"))
    physical = dv_store(physical, dv_ref("demon.body", "state", "shelf_print_owner"), dv_field("demon"))
    if not dv_read(physical, c2_access("living_exit")).known:
        physical = dv_store(physical, c2_access("living_exit"), dv_field(false))
    var objects = ["departure.door", "demon.body", "campaign.access", "campaign.clock", "case.contract", "case.astral", "case.logistics"]
    let four = ["detective", "huo", "shen", "su"]
    var i = 0
    while i < rt_count(four):
        let id = rt_cat("departure.person.", four[i])
        physical = c2_add_new(physical, c1_state_object(id, {"crossed": dv_field(false)}))
        rt_push(objects, id)
        i = i + 1
    var actors = []
    var bindings = dv_clone(scene.bindings)
    i = 0
    while i < rt_count(scene.actors):
        var actor = scene.actors[i]
        physical = c1dep_laws(physical, actor.id)
        var mind = actor.mind
        if actor.id == "demon":
            mind = dv_store(mind, dv_ref("demon", "state", "location"), dv_with(dv_field("living_hall"), "basis", [c1dep_source("08_终局.story", 1, "自身所在铜管外端")] ))
        var j = 0
        while j < rt_count(objects):
            mind = c2_add_new(mind, c1_local_object(objects[j]))
            if dv_local(bindings, objects[j], actor.id) == "":
                rt_push(bindings, dv_binding(objects[j], objects[j], actor.id))
            j = j + 1
        mind = c1dep_laws(mind, actor.id)
        if dv_has(four, actor.id):
            mind = dv_store(mind, c1dep_ref("outer_released"), dv_with(dv_field(false), "basis", [c1dep_source("08_终局.story", 4, "s10_steps.003")]))
        if actor.id == "demon":
            mind = dv_store(mind, dv_ref("demon.body", "state", "manifested"), dv_with(dv_field(false), "basis", [c1dep_source("08_终局.story", 4, "自身虚实体状态")]))
            mind = dv_store(mind, dv_ref("demon.body", "state", "shelf_print_owner"), dv_with(dv_field("demon"), "basis", [c1_source("docs/design-standard.md", 0, "本人移物行动")]))
        if actor.id == "quer" and not dv_read(mind, c1dep_ref("quer_has_wire")).known:
            mind = dv_store(mind, c1dep_ref("quer_has_wire"), dv_with(dv_field(true), "basis", [c1dep_source("12_雀儿撬门.story", 9, "quer_opens.003：手里的铁丝")]))
        var actions = c1dep_unify_demon_position(actor.actions)
        var hearing = c1dep_unify_demon_position(dv_find(actor, "hearing_grants", []))
        var transport_index = 0
        while transport_index < rt_count(hearing):
            var grant = hearing[transport_index]
            if grant.speaker == "demon":
                grant = dv_with(grant, "sender_locations", ["living_hall"])
            if actor.id == "demon":
                grant = dv_with(grant, "listener_locations", ["living_hall"])
            hearing = dvs_replace(hearing, transport_index, grant)
            transport_index = transport_index + 1
        var channels = dv_clone(dv_find(actor, "request_channels", []))
        if actor.id == "demon":
            j = 0
            while j < rt_count(actions):
                if dv_has_key(actions[j], "speech"):
                    var action = dv_with(actions[j], "speech", dv_with(actions[j].speech, "emission_location_ref", dv_ref("demon", "state", "location")))
                    action = dv_without(action, "opportunity_requirement")
                    if action.id == "demon.opening":
                        action = dv_with(action, "received_speech_requirement", {"speaker": "shen", "action_id": "shen.opening.body-habit", "receipt_kind": "actual-listener-parse"})
                    if dv_has_key(action, "response_topic"):
                        action = dv_with(action, "request_transport", {"channel": "copper.living"})
                    actions = dvs_replace(actions, j, action)
                j = j + 1
            j = 0
            while j < rt_count(hearing):
                hearing = dvs_replace(hearing, j, dv_with(hearing[j], "reception_location_ref", dv_ref("demon", "state", "location")))
                j = j + 1
            j = 0
            while j < rt_count(four):
                rt_push(hearing, {"speaker": four[j], "channel": "", "available_when": c1_at("demon", "living_hall"), "sender_locations": ["hall"], "listener_locations": ["living_hall"], "reception_location_ref": dv_ref("demon", "state", "location"), "basis": [c1dep_source("08_终局.story", 1, "铜口听取已认定的答复")]})
                rt_push(hearing, {"speaker": four[j], "channel": "copper.living", "available_when": c1_at("demon", "living_hall"), "sender_locations": ["hall"], "listener_locations": ["living_hall"], "reception_location_ref": dv_ref("demon", "state", "location"), "basis": [c1dep_source("08_终局.story", 1, "铜口接收实际询问")]})
                rt_push(hearing, {"speaker": four[j], "channel": "formal-receipt", "available_when": c1_at("demon", "living_hall"), "sender_locations": ["hall"], "listener_locations": ["living_hall"], "reception_location_ref": dv_ref("demon", "state", "location"), "basis": [c1dep_source("08_终局.story", 1, "铜口接收实际答辩回执")]})
                rt_push(channels, {"target": four[j], "channel": "copper.living", "available_when": c1_at("demon", "living_hall"), "basis": [c1dep_source("08_终局.story", 1, "应已经听到的询问向端口回答")]})
                j = j + 1
            actor = dv_with_many(actor, {"location_ref": c2_position_ref("demon"), "observable_presence_when": dv_fact(dv_ref("demon.body", "state", "manifested"), true)})
        if dv_has(four, actor.id):
            j = 0
            while j < rt_count(four):
                if four[j] != actor.id:
                    rt_push(hearing, {"speaker": four[j], "channel": "formal-receipt", "available_when": dv_true(), "sender_locations": ["hall"], "listener_locations": ["hall", "foyer", "pantry", "corridor"], "basis": [c1dep_source("08_终局.story", 1, "乙区实际公开答辩回执") ]})
                j = j + 1
            rt_push(hearing, {"speaker": "demon", "channel": "", "available_when": c1_at(actor.id, "hall"), "sender_locations": ["living_hall"], "listener_locations": ["hall"], "basis": [c1dep_source("08_终局.story", 1, "铜管实际传声")]})
            rt_push(hearing, {"speaker": "demon", "channel": "copper.living", "available_when": c1_at(actor.id, "hall"), "sender_locations": ["living_hall"], "listener_locations": ["hall"], "basis": [c1dep_source("08_终局.story", 1, "铜管实际回复")]})
            rt_push(hearing, {"speaker": "demon", "channel": "door.living", "available_when": c1_any(c1_at(actor.id, "foyer"), c1_at(actor.id, "hall")), "sender_locations": ["living_hall"], "listener_locations": ["foyer", "hall"], "basis": [c1dep_source("08_终局.story", 4, "门外抬闩的实际声响")]})
            if actor.id != "detective":
                rt_push(hearing, {"speaker": "detective", "channel": "door.living", "available_when": c1_any(c1_at(actor.id, "foyer"), c1_at(actor.id, "hall")), "sender_locations": ["foyer"], "listener_locations": ["foyer", "hall"], "basis": [c1dep_source("08_终局.story", 8, "s10_open")]})
            rt_push(channels, {"target": "demon", "channel": "copper.living", "available_when": c1_at(actor.id, "hall"), "basis": [c1dep_source("08_终局.story", 46, "对着铜口询问")]})
            j = 0
            while j < rt_count(actions):
                if dv_has_key(actions[j], "speech"):
                    let listeners = dv_find(actions[j], "listeners", [])
                    if not dv_has(listeners, "demon"):
                        actions = dvs_replace(actions, j, dv_with(actions[j], "listeners", dv_append(listeners, "demon")))
                let request = dv_find(dv_find(actions[j], "speech", []), "request", false)
                if request != false:
                    if request.target == "demon":
                        actions = dvs_replace(actions, j, dv_with_many(actions[j], {"request_transport": {"channel": "copper.living"}, "speech": dv_with(actions[j].speech, "channel", "copper.living"), "opportunity_requirement": {"location": "hall", "participants": [actor.id], "mode": "all-present"}}))
                j = j + 1
            let outsiders = ["quer", "lucian"]
            j = 0
            while j < rt_count(outsiders):
                rt_push(hearing, {"speaker": outsiders[j], "channel": "door.living", "available_when": c1_at(actor.id, "foyer"), "sender_locations": ["living_hall"], "listener_locations": ["foyer"], "basis": [c1dep_source("11_门外的人.story", 5, "隔门只闻其声")]})
                j = j + 1
            rt_push(channels, {"target": "quer", "channel": "door.living", "available_when": c1_at(actor.id, "foyer"), "basis": [c1dep_source("11_门外的人.story", 7, "隔门询问")]})
        if actor.id == "quer" or actor.id == "lucian":
            j = 0
            while j < rt_count(four):
                rt_push(hearing, {"speaker": four[j], "channel": "door.living", "available_when": c1_at(actor.id, "living_hall"), "sender_locations": ["foyer"], "listener_locations": ["living_hall"], "basis": [c1dep_source("11_门外的人.story", 7, "隔门问答")]})
                rt_push(channels, {"target": four[j], "channel": "door.living", "available_when": c1_at(actor.id, "living_hall"), "basis": [c1dep_source("11_门外的人.story", 8, "隔门回答")]})
                j = j + 1
        let extra = c1dep_actions(actor.id)
        j = 0
        while j < rt_count(extra):
            rt_push(actions, extra[j])
            j = j + 1
        actor = dv_with_many(actor, {"mind": c1dep_unify_demon_position(mind), "policy": c1dep_unify_demon_position(actor.policy), "actions": c1_public_methods(actions), "hearing_grants": hearing, "request_channels": channels})
        if actor.id == "demon":
            actor = dv_with(actor, "policy", dv_with_many(actor.policy, {"wait_chunk_limit": 60, "plan_depth": 1}))
        let goals = c1dep_goals(actor)
        var combined = dv_clone(dv_find(actor.policy, "goals", []))
        j = 0
        while j < rt_count(goals):
            rt_push(combined, goals[j])
            j = j + 1
        actor = dv_with(actor, "policy", dv_with_many(actor.policy, {"goals": combined, "departure_goals": goals}))
        rt_push(actors, actor)
        i = i + 1
    return dv_with_many(scene, {"physical": c1dep_unify_demon_position(physical), "actors": actors, "bindings": bindings, "departure_installed": true, "departure_input_contract": {"demon_body_ref": c2_position_ref("demon"), "body_origin": "living-hall-outside-isolation-door", "normal_release_requires": c1dep_outer_law().premise, "entered_ref": c1dep_cross_ref("detective")}})


axiom c1dep_manifest_law():
    var ready = dv_all([c1dep_complete(), dv_fact(c1dep_ref("outer_released"), false)])
    let groups = ["contract", "astral", "logistics"]
    var i = 0
    while i < rt_count(groups):
        let group = groups[i]
        let people = c1_other_people()
        var j = 0
        while j < rt_count(people):
            if people[j].group == group:
                var safe_time = 840
                var safety = c1_other_claim(group, "evidence_complete")
                if group == "astral":
                    safe_time = 1890
                    safety = dv_all([c1_other_claim(group, "care_given"), c1_other_claim(group, "west_passage_checked")])
                if group == "logistics":
                    safe_time = 2010
                    safety = dv_all([c1_other_claim(group, "care_given"), c1_other_claim(group, "observation_complete")])
                ready = c1_any(ready, dv_all([c1_other_claim(group, rt_cat("receipt.", people[j].id)), dv_fact(c1_other_ref(group, "formal_release"), false), safety, dv_at_least(c1_other_clock_ref(), safe_time)]))
            j = j + 1
        i = i + 1
    return dv_axiom("c1dep_manifest_law", 1, dv_all([c1_at("demon", "living_hall"), ready, dv_fact(dv_ref("demon.body", "state", "manifested"), false)]), [dv_assign(dv_ref("demon.body", "state", "manifested"), true)])


// Only legacy predicates naming the demon's former hall position are translated.
// Copper hearing still names both real endpoints and never creates another body.
fn c1dep_unify_demon_position(value):
    if not rt_is_list(value):
        return value
    if dv_record_like(value):
        if dv_find(value, "op", "") == "equals" and dv_has_key(value, "ref") and dv_has_key(value, "value"):
            let ref = value.ref
            if dv_record_like(ref):
                if dv_find(ref, "object", "") == "demon" and dv_find(ref, "facet", "") == "state" and dv_find(ref, "field", "") == "location" and value.value == "hall":
                    return dv_with(value, "value", "living_hall")
        var fields = []
        var field_index = 0
        while field_index < rt_count(value):
            rt_push(fields, [value[field_index][0], c1dep_unify_demon_position(value[field_index][1])])
            field_index = field_index + 1
        return fields
    var result = []
    var i = 0
    while i < rt_count(value):
        rt_push(result, c1dep_unify_demon_position(value[i]))
        i = i + 1
    return result

// Executable native opening content. Old .story is provenance, never a runtime input.
// Installation authors the starting scene. It does not execute it, publish observations,
// deliver speech, choose a candidate, adopt short_stay or manufacture an acceptance.
// All candidates use the same real action/law/cost/observation/speech pipeline as play.
// File/catalog order is not a route, a command queue or a choice priority.
// Narrative and private monologue are presentation after an applied action, not testimony.

fn c1_op_source(line, id):
    return c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/01_开场.story", line, id)

fn c1_op_people():
    return ["detective", "huo", "shen", "su"]

fn c1_op_wake_room(id):
    if id == "detective":
        return "R05"
    if id == "huo":
        return "R06"
    if id == "shen":
        return "R07"
    return "R08"

fn c1_op_name(id, detective_name):
    if id == "detective":
        return detective_name
    if id == "huo":
        return "霍铎"
    if id == "shen":
        return "沈鼎"
    return "苏泠"

fn c1_op_profession(id):
    if id == "detective":
        return "侦探"
    if id == "huo":
        return "钳工"
    if id == "shen":
        return "烧菜"
    return "弹琴"

fn c1_op_person_ref(id, field):
    return dv_ref(rt_cat("opening.personal.", id), "state", field)

fn c1_op_known_speaker_label(mind, id):
    if id == "demon" and dv_truth(mind, c1_op_property("opening.roles", "custodian", "demon")) == "true":
        return "铜口代管者"
    return ""

fn c1_op_property(object, field, value):
    return dv_fact(dv_ref(object, "state", field), value)

fn c1_op_wake_lines(id):
    if id == "detective":
        return ["我记得的最后一件事，是上船。", "衣架上挂着一件风衣。右手袖口磨得发亮——我写字时总拿那儿蹭桌沿。是我的。", "先出去，看看这是什么地方。"]
    if id == "huo":
        return ["……", "手先去摸床沿。床板是榫接的，没用一颗钉子。", "上船以后的事，没了。", "挂钩上缠着机油布。顺时针，三圈半。我缠的。", "起来。"]
    if id == "shen":
        return ["……", "哎哟，这胳膊。酸得跟揉了半宿面似的。", "昨儿……昨儿干啥了？就记得上了条船。", "桌上那块磨刀石，中间都磨出槽了。谁这么舍得用。", "先找口水喝。"]
    return ["……", "墙里有一个很低的音，一直没断。", "最后记得的，是船上的汽笛。", "手指在被面上敲。四四拍。不知道敲了多久。", "……那个音还在。"]

fn c1_op_person_object(id, detective_name):
    var recall = "boarding"
    if id == "su":
        recall = "ship-whistle"
    var fields = {"name": dv_field(c1_op_name(id, detective_name)), "profession": dv_field(c1_op_profession(id)), "last_recall": dv_field(recall)}
    if id == "su":
        fields = dv_with(fields, "prefers_unsweetened", dv_field(true))
    return c1_state_object(rt_cat("opening.personal.", id), fields)

fn c1_op_objects(detective_name):
    var result = [c1_state_object("opening.roles", {"custodian": dv_field("demon"), "teacher": dv_field("demon")}), c1_state_object("opening.facilities", {"grain_store": dv_field(true), "water_supply": dv_field(true), "fire": dv_field(true), "drawing_exists": dv_field(true), "unheard_sounds_available": dv_field(true)}), c1_state_object("opening.contracts", {"detective_party_not_custodian": dv_field(true), "full_text": dv_field(c1_op_contract_text())}), c1_state_object("opening.cabinet", {"location": dv_field("hall"), "position_description": dv_field("铜口下方"), "labels": dv_field([detective_name, "霍铎", "沈鼎", "苏泠"])}), c1_state_object("opening.slot.detective", {"label": dv_field(detective_name), "door_open": dv_field(true), "contents": dv_field("empty")}), c1_state_object("opening.slot.huo", {"label": dv_field("霍铎"), "contents": dv_field("test-piece")}), c1_state_object("opening.slot.shen", {"label": dv_field("沈鼎"), "contents": dv_field("silver")}), c1_state_object("opening.slot.su", {"label": dv_field("苏泠"), "contents": dv_field("audition-access")}), c1_state_object("opening.silver", {"location": dv_field("opening.cabinet"), "authenticity": dv_field("genuine")}), c1_state_object("opening.testpiece", {"location": dv_field("opening.cabinet")}), c1_state_object("opening.audition", {"location": dv_field("opening.cabinet")}), c1_state_object("opening.tea", {"location": dv_field("hall"), "prepared": dv_field(false)}), c1_state_object("opening.public_history", {"alarm_last_night": dv_field(true), "main_building_call": dv_field(true), "door_latched_this_side": dv_field(true), "caller_not_returned": dv_field(true)})]
    var people = c1_op_people()
    var i = 0
    while i < rt_count(people):
        var id = people[i]
        rt_push(result, c1_op_person_object(id, detective_name))
        rt_push(result, c1_state_object(rt_cat("opening.cup.", id), {"recipient": dv_field(id), "contents": dv_field("empty")}))
        i = i + 1
    rt_push(result, c1_state_object("opening.wake.huo", {"bed_join": dv_field("mortise-without-nails"), "oilcloth_wrap": dv_field("clockwise-three-and-a-half"), "own_wrap_recognized": dv_field(true)}))
    rt_push(result, c1_state_object("opening.wake.shen", {"arms_aching": dv_field(true), "whetstone_grooved": dv_field(true)}))
    rt_push(result, c1_state_object("opening.wake.su", {"low_wall_tone": dv_field(true), "finger_meter": dv_field("4/4")}))
    return result

axiom c1_op_wake(id):
    return dv_axiom(rt_cat("c1_op_wake.", id), 1, c1_at(id, c1_op_wake_room(id)), dv_single(dv_assign(dv_ref(id, "body", "awake"), true)))

axiom c1_op_wear_coat():
    return dv_axiom("c1_op_wear_coat", 1, dv_all(dv_pair(c1_at("detective", "R05"), dv_fact(dv_ref("coat", "identity", "owner"), "detective"))), dv_single(dv_assign(dv_ref("coat", "state", "worn_by"), "detective")))

axiom c1_op_prepare_tea():
    return dv_axiom("c1_op_prepare_tea", 1, c1_at("shen", "hall"), dv_pair(dv_assign(dv_ref("opening.tea", "state", "prepared"), true), dv_assign(dv_ref("opening.tea", "state", "prepared_by"), "shen")))

axiom c1_op_serve_tea():
    var effects = []
    var people = c1_op_people()
    var i = 0
    while i < rt_count(people):
        rt_push(effects, dv_assign(dv_ref(rt_cat("opening.cup.", people[i]), "state", "contents"), "tea"))
        rt_push(effects, dv_assign(dv_ref(rt_cat("opening.cup.", people[i]), "state", "served_by"), "shen"))
        i = i + 1
    rt_push(effects, dv_assign(dv_ref("opening.cup.su", "state", "sugar_added"), false))
    return dv_axiom("c1_op_serve_tea", 1, dv_all(dv_pair(c1_at("shen", "hall"), c1_op_property("opening.tea", "prepared", true))), effects)

axiom c1_op_bite_silver():
    return dv_axiom("c1_op_bite_silver", 1, dv_all(dv_pair(c1_at("shen", "hall"), c1_op_property("opening.silver", "location", "opening.cabinet"))), dv_pair(dv_assign(dv_ref("opening.silver", "state", "last_bite_by"), "shen"), dv_assign(dv_ref("opening.silver", "state", "last_test"), "bite")))

axiom c1_op_scrape_testpiece():
    return dv_axiom("c1_op_scrape_testpiece", 1, dv_all(dv_pair(c1_at("huo", "hall"), c1_op_property("opening.testpiece", "location", "opening.cabinet"))), dv_single(dv_assign(dv_ref("opening.testpiece", "state", "last_scraped_by"), "huo")))

axiom c1_op_play_audition():
    return dv_axiom("c1_op_play_audition", 1, dv_all(dv_pair(c1_at("su", "hall"), c1_op_property("opening.audition", "location", "opening.cabinet"))), dv_pair(dv_assign(dv_ref("opening.audition", "state", "last_operator"), "su"), dv_assign(dv_ref("opening.audition", "state", "last_output"), "audible")))

fn c1_op_rules():
    var result = []
    var people = c1_op_people()
    var i = 0
    while i < rt_count(people):
        rt_push(result, {"name": rt_cat("opening.wake.", people[i]), "law": c1_op_wake(people[i]), "source": c1_memory_source(people[i])})
        i = i + 1
    rt_push(result, {"name": "opening.wear-coat", "law": c1_op_wear_coat(), "source": c1_op_source(6, "s1_wake.006; s2_meet.008")})
    rt_push(result, {"name": "opening.prepare-tea", "law": c1_op_prepare_tea(), "source": c1_op_source(11, "s2_meet.009")})
    rt_push(result, {"name": "opening.serve-tea", "law": c1_op_serve_tea(), "source": c1_op_source(21, "s2_tea.011")})
    rt_push(result, {"name": "opening.bite-silver", "law": c1_op_bite_silver(), "source": c1_op_source(30, "s3_broadcast.020")})
    rt_push(result, {"name": "opening.scrape-testpiece", "law": c1_op_scrape_testpiece(), "source": c1_op_source(30, "s3_broadcast.020")})
    rt_push(result, {"name": "opening.play-audition", "law": c1_op_play_audition(), "source": c1_op_source(30, "s3_broadcast.020")})
    return result

fn c1_op_presentation(id, voice, lines):
    var rendered = []
    var i = 0
    while i < rt_count(lines):
        rt_push(rendered, {"template": lines[i], "bindings": []})
        i = i + 1
    return {"actor": id, "voice": voice, "lines": rendered, "publish_after": "actual-applied-execution", "knowledge_effect": "none"}

fn c1_op_wake_action(id):
    var known = c1_at(id, c1_op_wake_room(id))
    var grants = [dv_ref(id, "body", "awake"), c1_op_person_ref(id, "name"), c1_op_person_ref(id, "profession"), c1_op_person_ref(id, "last_recall")]
    if id == "detective":
        rt_push(grants, dv_ref("coat", "identity", "owner"))
    if id == "huo":
        rt_push(grants, dv_ref("opening.wake.huo", "state", "bed_join"))
        rt_push(grants, dv_ref("opening.wake.huo", "state", "oilcloth_wrap"))
        rt_push(grants, dv_ref("opening.wake.huo", "state", "own_wrap_recognized"))
    if id == "shen":
        rt_push(grants, dv_ref("opening.wake.shen", "state", "arms_aching"))
        rt_push(grants, dv_ref("opening.wake.shen", "state", "whetstone_grooved"))
    if id == "su":
        rt_push(grants, dv_ref("opening.wake.su", "state", "low_wall_tone"))
        rt_push(grants, dv_ref("opening.wake.su", "state", "finger_meter"))
    var kind = "inspect"
    return dv_with(dv_with(c1_once(c1_action(rt_cat(id, ".opening.wake"), kind, known, known, rt_cat("opening.wake.", id), grants, c1_memory_source(id))), "owner", id), "presentation", c1_op_presentation(id, "private-monologue", c1_op_wake_lines(id)))

fn c1_op_physical_action(id, name, law, grants, source, surface):
    return dv_with(dv_with(c1_once(c1_action(name, "inspect", c1_at(id, "hall"), c1_at(id, "hall"), law, grants, source)), "owner", id), "presentation", c1_op_presentation(id, "visible-action", dv_single(surface)))

fn c1_op_reward_actions():
    return [dv_with(c1_op_physical_action("shen", "shen.opening.bite-silver", "opening.bite-silver", [dv_ref("opening.silver", "state", "authenticity"), dv_ref("opening.silver", "state", "last_bite_by")], c1_op_source(30, "s3_broadcast.020"), "沈鼎走到柜前，咬了一枚银元。"), "sensory_mode", "tactile-inspection"), c1_op_physical_action("huo", "huo.opening.scrape-testpiece", "opening.scrape-testpiece", [dv_ref("opening.testpiece", "state", "last_scraped_by")], c1_op_source(30, "s3_broadcast.020"), "霍铎把试件举到灯下，刮配合面。"), dv_with(c1_op_physical_action("su", "su.opening.play-audition", "opening.play-audition", [dv_ref("opening.audition", "state", "last_operator"), dv_ref("opening.audition", "state", "last_output")], c1_op_source(30, "s3_broadcast.020"), "苏泠摇响了柜旁的试听机。"), "sensory_mode", "auditory-playback")]

fn c1_op_dialogue(id, name, literal, surface, source, listeners):
    var known = dv_all(dv_pair(c1_at(id, "hall"), literal))
    var speech = dv_with(c1_speech(literal, source, "present-opening-scene"), "surface", surface)
    var result = c1_once(dv_with_many(c1_action(name, "talk", known, known, "", [], source), {"speech": speech, "listeners": listeners, "owner": id}))
    if id == "demon":
        return c1_authorized_speech(result)
    return result

fn c1_op_question(id, name, surface, source, listeners):
    var action = c1_op_dialogue(id, name, dv_true(), surface, source, listeners)
    return dv_with(action, "speech", dv_with(action.speech, "utterance_type", "question"))

fn c1_op_reward_refs(id):
    if id == "shen":
        return [dv_ref("opening.silver", "state", "authenticity"), dv_ref("opening.silver", "state", "last_bite_by")]
    if id == "huo":
        return [dv_ref("opening.testpiece", "state", "last_scraped_by")]
    return [dv_ref("opening.audition", "state", "last_operator"), dv_ref("opening.audition", "state", "last_output")]

fn c1_op_reward_requirement(id):
    if id == "shen":
        return dv_all(dv_pair(c1_op_property("opening.silver", "authenticity", "genuine"), c1_op_property("opening.silver", "last_bite_by", "shen")))
    if id == "huo":
        return c1_op_property("opening.testpiece", "last_scraped_by", "huo")
    return dv_all(dv_pair(c1_op_property("opening.audition", "last_operator", "su"), c1_op_property("opening.audition", "last_output", "audible")))

// Uses the existing person's rule, confidence and withdrawal; only a concrete personal
// material premise is added. No reward property implies bodily residence in the world.
fn c1_op_pragmatic_policy(id, policy):
    if id == "detective":
        return policy
    var bridges = dv_find(policy, "implicature_bridges", [])
    var result = []
    var i = 0
    while i < rt_count(bridges):
        var bridge = bridges[i]
        if bridge.id == "short_stay":
            bridge = dv_with_many(bridge, {"premise": dv_all(dv_pair(bridge.premise, c1_op_reward_requirement(id))), "basis": dv_append(bridge.basis, c1_op_source(30, "s3_broadcast.020")), "material_scope": "reward-corroboration", "duration_support": "none", "actual_material_refs": c1_op_reward_refs(id)})
        rt_push(result, bridge)
        i = i + 1
    return dv_with(policy, "implicature_bridges", result)

fn c1_op_morning_candidates():
    var result = []
    var people = c1_op_people()
    var i = 0
    while i < rt_count(people):
        rt_push(result, dv_with(c1_op_wake_action(people[i]), "personal_purpose", {"subject": people[i], "id": "current-self-observation", "basis": dv_single(c1_memory_source(people[i]))}))
        i = i + 1
    var wear = c1_once(c1_action("detective.opening.wear-coat", "inspect", dv_all(dv_pair(c1_at("detective", "R05"), dv_fact(dv_ref("coat", "identity", "owner"), "detective"))), c1_at("detective", "R05"), "opening.wear-coat", [dv_ref("coat", "state", "worn_by")], c1_op_source(6, "s1_wake.006; s2_meet.008")))
    rt_push(result, dv_with(wear, "owner", "detective"))
    rt_push(result, c1_op_physical_action("shen", "shen.opening.prepare-tea", "opening.prepare-tea", [dv_ref("opening.tea", "state", "prepared"), dv_ref("opening.tea", "state", "prepared_by")], c1_op_source(11, "s2_meet.009"), "沈鼎把茶泡上。"))
    return result

fn c1_op_meet_candidates():
    var listeners = c1_op_people()
    var welcome = c1_op_dialogue("shen", "shen.opening.welcome", c1_op_property("opening.tea", "prepared", true), "哟，又醒一个。进来坐，茶刚泡上。", c1_op_source(11, "s2_meet.009"), listeners)
    var shen_name = c1_op_dialogue("shen", "shen.opening.introduce", dv_all(dv_pair(dv_fact(c1_op_person_ref("shen", "name"), "沈鼎"), dv_fact(c1_op_person_ref("shen", "profession"), "烧菜"))), "我姓沈，沈鼎，烧菜的。", c1_op_source(12, "s2_meet.010"), listeners)
    var huo_name = c1_op_dialogue("huo", "huo.opening.introduce", dv_all(dv_pair(dv_fact(c1_op_person_ref("huo", "name"), "霍铎"), dv_fact(c1_op_person_ref("huo", "profession"), "钳工"))), "……霍铎。钳工。", c1_op_source(13, "s2_meet.011"), listeners)
    var su_name = c1_op_dialogue("su", "su.opening.introduce", dv_all(dv_pair(dv_fact(c1_op_person_ref("su", "name"), "苏泠"), dv_fact(c1_op_person_ref("su", "profession"), "弹琴"))), "苏泠。弹琴的。", c1_op_source(14, "s2_meet.006"), listeners)
    var ask_name = c1_op_question("shen", "shen.opening.ask-name", "你呢？穿这么一身风衣，不像跑船的。", c1_op_source(15, "s2_meet.008"), dv_single("detective"))
    return [welcome, shen_name, huo_name, su_name, ask_name]

fn c1_op_tea_candidates(detective_name):
    var listeners = c1_op_people()
    var introduce = c1_op_dialogue("detective", "detective.opening.introduce", dv_all(dv_pair(dv_fact(c1_op_person_ref("detective", "name"), detective_name), dv_fact(c1_op_person_ref("detective", "profession"), "侦探"))), rt_cat(detective_name, "。……做侦探的。"), c1_op_source(19, "s2_tea.001"), listeners)
    var memory = c1_op_dialogue("shen", "shen.opening.memory-report", dv_fact(c1_op_person_ref("shen", "last_recall"), "boarding"), "都还记得啥？我就记得上船。下了跳板往后，脑子里白茫茫一片。", c1_op_source(20, "s2_tea.016"), listeners)
    var serve = c1_op_physical_action("shen", "shen.opening.serve-tea", "opening.serve-tea", [dv_ref("opening.cup.su", "state", "contents"), dv_ref("opening.cup.su", "state", "sugar_added"), dv_ref("opening.cup.su", "state", "served_by")], c1_op_source(21, "s2_tea.011"), "他把茶一杯一杯推过来。推到苏泠面前的那杯，他没有放糖。")
    serve = dv_with_many(serve, {"public_observers": listeners, "public_grants": [dv_ref("opening.cup.su", "state", "contents"), dv_ref("opening.cup.su", "state", "sugar_added"), dv_ref("opening.cup.su", "state", "served_by")]})
    var su_ask = c1_op_question("su", "su.opening.ask-sugar", "……你怎么知道我喝茶不放糖？", c1_op_source(22, "s2_tea.012"), listeners)
    su_ask = dv_with_many(su_ask, {"precondition": dv_all(dv_pair(c1_at("su", "hall"), c1_op_property("opening.cup.su", "sugar_added", false))), "authority_precondition": dv_all(dv_pair(c1_at("su", "hall"), c1_op_property("opening.cup.su", "sugar_added", false)))})
    var shen_reply = c1_op_dialogue("shen", "shen.opening.body-habit", c1_op_property("opening.cup.su", "served_by", "shen"), "嗯？……顺手吧。", c1_op_source(23, "s2_tea.013"), listeners)
    shen_reply = dv_with(shen_reply, "speech", dv_with(shen_reply.speech, "scope", "own-bodily-action-appraisal-not-recovered-familiarity"))
    return [introduce, memory, serve, su_ask, shen_reply]

fn c1_op_broadcast_candidates():
    var action = c1_opening_action()
    var roles = dv_all(dv_pair(c1_op_property("opening.roles", "custodian", "demon"), c1_op_property("opening.roles", "teacher", "demon")))
    action = dv_with(action, "speech", dv_with_many(action.speech, {"literal_ast": dv_all(dv_pair(roles, action.speech.literal_ast)), "surface": "诸位晨安。我是此地的代管者，也是诸位的教师。诸位初涉斯地，记忆有缺，并非伤病，请勿惊惶。诸位所需之知，我会教。我所立之规，已贴在活动厅的公告框里。"}))
    action = dv_with_many(action, {"presentation": c1_op_presentation("demon", "visible-action", ["墙上的铜口里咳了一声。"]), "source_narration": "墙上的铜口里咳了一声。屋里四个人一齐扭过头去。", "source_narration_limit": "peer-head-turns-require-real-peer-reaction; never-publish-unperformed-reactions"})
    return [dv_with(action, "owner", "demon")]

fn c1_op_reward_candidates(detective_name):
    var cabinet_claim = dv_all(dv_pair(c1_op_property("opening.cabinet", "position_description", "铜口下方"), c1_op_property("opening.cabinet", "labels", [detective_name, "霍铎", "沈鼎", "苏泠"])))
    var invitation = c1_op_dialogue("demon", "demon.opening.reward-invitation", cabinet_claim, "诸位的报偿，就在铜口下方的领取柜里，各有名签。请亲手核验。", c1_op_source(29, "s4_rewards.004"), c1_op_people())
    invitation = dv_with(invitation, "speech", dv_with(invitation.speech, "shown_material_refs", [dv_ref("opening.cabinet", "state", "position_description"), dv_ref("opening.cabinet", "state", "labels")]))
    var candidates = [invitation]
    var rewards = c1_op_reward_actions()
    var ids = ["shen", "huo", "su"]
    var i = 0
    while i < rt_count(rewards):
        rt_push(candidates, rewards[i])
        i = i + 1
    return candidates

fn c1_op_desire_candidates(detective_name):
    var material_claim = dv_all([c1_op_property("opening.silver", "location", "opening.cabinet"), c1_op_property("opening.facilities", "grain_store", true), c1_op_property("opening.facilities", "water_supply", true), c1_op_property("opening.facilities", "fire", true), c1_op_property("opening.facilities", "drawing_exists", true), c1_op_property("opening.facilities", "unheard_sounds_available", true)])
    var offer = c1_op_dialogue("demon", "demon.opening.desire-offer", material_claim, "银元在柜里，沈师傅。粮仓、水窖、灶火，岛上也都有。那张减少不可逆损失的闭式热机图纸，此地有人画过，霍先生。此地还有诸位从未听过的声音，苏小姐。", c1_op_source(31, "s3_broadcast.021"), c1_op_people())
    offer = dv_with(offer, "speech", dv_with(offer.speech, "shown_material_refs", [dv_ref("opening.silver", "state", "location"), dv_ref("opening.testpiece", "state", "location"), dv_ref("opening.audition", "state", "location")]))
    var empty_slot = c1_once(c1_action("detective.opening.empty-slot", "inspect", c1_at("detective", "hall"), c1_at("detective", "hall"), "", [dv_ref("opening.slot.detective", "state", "label"), dv_ref("opening.slot.detective", "state", "door_open"), dv_ref("opening.slot.detective", "state", "contents")], c1_op_source(35, "s4_rewards.020")))
    empty_slot = dv_with(dv_with(empty_slot, "owner", "detective"), "presentation", c1_op_presentation("detective", "private-monologue", ["柜上有一格贴着我的名字。小门开着，里面什么也没有。"]))
    var ask_reward = c1_op_question("detective", "detective.opening.ask-reward", "那我的呢？", c1_op_source(36, "s4_rewards.016"), dv_single("demon"))
    ask_reward = dv_with(ask_reward, "precondition", dv_all(dv_pair(c1_at("detective", "hall"), c1_op_property("opening.slot.detective", "contents", "empty"))))
    var contract = c1_op_dialogue("demon", "demon.opening.other-contract", c1_op_property("opening.contracts", "detective_party_not_custodian", true), "与你立约的，不是我。", c1_op_source(37, "s4_rewards.017"), c1_op_people())
    var shen_keep = c1_op_dialogue("shen", "shen.opening.accept-work", c1_op_reward_requirement("shen"), "……钱是真的。这活我接着干。", c1_op_source(39, "s3_broadcast.022"), c1_op_people())
    shen_keep = dv_with(shen_keep, "speech", dv_with(shen_keep.speech, "intention_report", {"subject": "shen", "purpose": "keep-working", "basis": c1_op_reward_refs("shen"), "automatic_world_effect": "none"}))
    var huo_stay = c1_op_dialogue("huo", "huo.opening.seek-drawing", c1_op_reward_requirement("huo"), "我留下。那张图，我得找。", c1_op_source(40, "s4_rewards.023"), c1_op_people())
    huo_stay = dv_with(huo_stay, "speech", dv_with(huo_stay.speech, "intention_report", {"subject": "huo", "purpose": "seek-offered-drawing", "basis": c1_op_reward_refs("huo"), "automatic_world_effect": "none"}))
    return [offer, empty_slot, ask_reward, contract, shen_keep, huo_stay]

fn c1_op_investigation_candidates():
    var first = c1_op_dialogue("demon", "demon.opening.public-alarm", dv_all(dv_pair(c1_op_property("opening.public_history", "alarm_last_night", true), c1_op_property("opening.public_history", "main_building_call", true))), "昨夜警铃骤起。主楼曾有人向诸位呼喊。", c1_op_source(44, "s5_question.002"), c1_op_people())
    var second = c1_op_dialogue("demon", "demon.opening.public-latch", dv_all(dv_pair(c1_op_property("opening.public_history", "door_latched_this_side", true), c1_op_property("opening.public_history", "caller_not_returned", true))), "通往主楼之门，在诸位这一侧闩上了。那人再没有回来。", c1_op_source(45, "s5_question.003"), c1_op_people())
    var question = c1_question_action("prompt", c1_op_source(46, "s5_question.004"), true)
    question = dv_with(question, "speech", dv_with(question.speech, "surface", "此为始业之问：门是谁闩上的？闩门之时，此人可曾听见门外的呼喊？"))
    var invitation = c1_op_dialogue("demon", "demon.opening.investigate-invitation", dv_true(), "记不得，并不妨碍作答。痕迹还在。答案备好了，到铜口来。", c1_op_source(47, "s5_question.017"), c1_op_people())
    invitation = dv_with(invitation, "speech", dv_with(invitation.speech, "utterance_type", "invitation"))
    return [first, second, dv_with(question, "owner", "demon"), invitation]

// Conditional stance reports require the existing owner interpretations receipt.
// They remain ordinary optional candidates and must not be projected as facts
// about bodily residence. Generic eligibility checks the actual owner receipt.
fn c1_op_maintenance_actions():
    var ids = ["huo", "shen", "su"]
    var surfaces = ["试件，我刮过。初涉……我先按刚来这里办。", "钱是真的，我咬过。茶么，是顺手。……我还是按咱们才刚来想。", "……试听机里的声音，我听见了。初涉，我先按刚到这里听着。"]
    var result = []
    var i = 0
    while i < rt_count(ids):
        var id = ids[i]
        var action = c1_op_dialogue(id, rt_cat(id, ".opening.maintain-interpretation"), c1_op_reward_requirement(id), surfaces[i], c1_op_source(30, "s3_broadcast.020; authoring-attitude-report"), c1_op_people())
        var attitude = {"subject": id, "interpretation_id": "short_stay", "required_status": "accepted", "basis": c1_op_reward_refs(id), "source_event_requirement": "owner-existing-interpretation-receipt"}
        action = dv_with_many(action, {"owner_interpretation_requirement": attitude, "speech": dv_with_many(action.speech, {"utterance_type": "attitude-report", "attitude_report": attitude, "asserted_body_duration": "none"})})
        rt_push(result, action)
        i = i + 1
    return result

fn c1_op_scene(detective_name):
    return {"id": "chapter1-opening", "selection": "flat-owner-candidates", "input_slot": {"key": "detective_name", "value": detective_name, "source": c1_op_source(19, "s2_tea.001")}, "source_refs": [c1_op_source(4, "s1_wake"), c1_op_source(10, "s2_meet"), c1_op_source(18, "s2_tea"), c1_op_source(26, "s3_broadcast"), c1_op_source(43, "s5_question")], "candidate_contract": {"choice": "owner-policy-desires-purpose-and-actual-knowledge", "execution": "same-real-law-observation-speech-path-as-other-actions", "opportunity_requirement": "check-actual-owner-visible-context; never-place-a-peer", "received_speech_requirement": "check-owner-existing-hearing-parse-receipts", "desire_requirement": "check-owner-declared-desire-and-source", "request": "questions-create-requests-only-by-actual-hearing; replies-use-response_topic", "attitude_requirement": "check-owner-existing-interpretation-receipt", "presentation": "publish-only-after-applied-action; no-extra-knowledge", "not_happened": "leave-unselected-unheard-unperformed-interactions-unhappened", "time": "retain-initial-480-and-caller-360-minute-budget", "initial_state": "already-awake-at-current-origin; self-observations-occur-now"}}

fn c1_op_install_world(world, detective_name):
    var result = c1_add_objects(world, c1_op_objects(detective_name))
    var people = c1_op_people()
    var i = 0
    while i < rt_count(people):
        result = dv_store(result, dv_ref(people[i], "state", "location"), dv_field(c1_op_wake_room(people[i])))
        result = dv_store(result, dv_ref(people[i], "body", "awake"), dv_with(dv_field(true), "basis", dv_single(c1_memory_source(people[i]))))
        i = i + 1
    var rules = c1_op_rules()
    i = 0
    while i < rt_count(rules):
        result = dv_adopt(result, c1_method(rules[i].name, rules[i].law), "enforce", 1, dv_single(rules[i].source))
        i = i + 1
    return result

fn c1_op_install_actor(actor, detective_name):
    var id = actor.id
    var mind = actor.mind
    var objects = c1_op_objects(detective_name)
    var i = 0
    while i < rt_count(objects):
        mind = dv_add_object(mind, c1_local_object(objects[i].id))
        i = i + 1
    if dv_has(c1_op_people(), id):
        mind = dv_store(mind, dv_ref(id, "state", "location"), dv_field(c1_op_wake_room(id)))
        actor = dv_with(actor, "location", c1_op_wake_room(id))
        var own = c1_op_person_object(id, detective_name)
        var fields = own.facets.state
        var self_source = c1_op_source(19, "s2_tea.001;self-name-and-profession")
        if id == "huo":
            self_source = c1_op_source(13, "s2_meet.011")
        if id == "shen":
            self_source = c1_op_source(12, "s2_meet.010")
        if id == "su":
            self_source = c1_op_source(14, "s2_meet.006")
        var k = 0
        while k < rt_count(fields):
            var basis = dv_single(self_source)
            if fields[k][0] == "last_recall":
                basis = dv_single(c1_memory_source(id))
            if fields[k][0] == "prefers_unsweetened":
                basis = [c1_op_source(22, "s2_tea.012; own-taste")]
            mind = dv_store(mind, c1_op_person_ref(id, fields[k][0]), dv_with(fields[k][1], "basis", basis))
            k = k + 1
        if id == "detective":
            mind = dv_store(mind, dv_ref("coat", "identity", "owner"), dv_unknown())
        actor = dv_with(actor, "policy", c1_op_pragmatic_policy(id, actor.policy))
    if id == "demon":
        var whitelist = ["opening.roles", "opening.facilities", "opening.contracts", "opening.cabinet", "opening.silver", "opening.testpiece", "opening.audition", "opening.public_history"]
        i = 0
        while i < rt_count(objects):
            if dv_has(whitelist, objects[i].id):
                var fields = objects[i].facets.state
                var j = 0
                while j < rt_count(fields):
                    var ref = dv_ref(objects[i].id, "state", fields[j][0])
                    mind = dv_store(mind, ref, dv_with(fields[j][1], "basis", [c1_op_source(28, "s3_broadcast.019"), c1_op_source(31, "s3_broadcast.021;custodian-owned-inventory")]))
                    j = j + 1
            i = i + 1
    var rules = c1_op_rules()
    i = 0
    while i < rt_count(rules):
        if c1_op_rule_owner(rules[i].name) == id:
            mind = dv_adopt(mind, c1_method(rules[i].name, rules[i].law), "predict", 1, dv_single(rules[i].source))
        i = i + 1
    if dv_has(c1_op_people(), id):
        mind = dv_store(mind, dv_ref(id, "body", "awake"), dv_with(dv_field(true), "basis", dv_single(c1_memory_source(id))))
    var pool = c1_op_flat_candidates(detective_name)
    var replacements = []
    i = 0
    while i < rt_count(pool):
        if pool[i].owner == id:
            rt_push(replacements, pool[i])
        i = i + 1
    var actions = []
    i = 0
    while i < rt_count(actor.actions):
        var old = actor.actions[i]
        var replace = dv_has(["demon.opening.memory-only", "demon.opening.contrary"], old.id)
        var j = 0
        while j < rt_count(replacements):
            if old.id == replacements[j].id:
                replace = true
            j = j + 1
        if not replace:
            rt_push(actions, old)
        i = i + 1
    i = 0
    while i < rt_count(replacements):
        rt_push(actions, replacements[i])
        i = i + 1
    actor = dv_with_many(actor, {"mind": mind, "actions": actions})
    return c1_op_install_purposes(actor)

fn c1_op_bindings(detective_name):
    var result = []
    var people = ["detective", "huo", "shen", "su", "demon"]
    var objects = c1_op_objects(detective_name)
    var i = 0
    while i < rt_count(people):
        var j = 0
        while j < rt_count(objects):
            rt_push(result, dv_binding(objects[j].id, objects[j].id, people[i]))
            j = j + 1
        i = i + 1
    return result

fn c1_opening_install_scene(scenario, detective_name):
    dv_require(not (detective_name == ""), "Opening requires an actual detective name")
    var result = dv_with(scenario, "physical", c1_op_install_world(scenario.physical, detective_name))
    var actors = []
    var i = 0
    while i < rt_count(scenario.actors):
        rt_push(actors, c1_op_install_actor(scenario.actors[i], detective_name))
        i = i + 1
    var bindings = scenario.bindings
    var new_bindings = c1_op_bindings(detective_name)
    i = 0
    while i < rt_count(new_bindings):
        rt_push(bindings, new_bindings[i])
        i = i + 1
    return dv_with_many(result, {"actors": actors, "bindings": bindings, "opening_scene": c1_op_scene(detective_name)})

// Declarations below describe each person's reasons, never the author's next step.
fn c1_op_desire(id):
    if id == "detective":
        return {"id": "understand-own-presence", "surface": "弄清自己为何在此", "basis": [c1_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/01_侦探.story", 11, "detective.desire")]}
    if id == "huo":
        return {"id": "seek-power-drawing", "surface": "减少不可逆损失的闭式热机图纸", "basis": [c1_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/02_霍铎.story", 10, "huo.desire")]}
    if id == "shen":
        return {"id": "protect-companions", "surface": "安稳，护住身边的人", "basis": [c1_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/03_沈鼎.story", 10, "shen.desire")]}
    return {"id": "seek-unheard-sounds", "surface": "从未听过的声音", "basis": [c1_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/04_苏泠.story", 10, "su.desire")]}

fn c1_op_rule_owner(name):
    if name == "opening.wake.detective" or name == "opening.wear-coat":
        return "detective"
    if name == "opening.wake.huo" or name == "opening.scrape-testpiece":
        return "huo"
    if name == "opening.wake.shen" or name == "opening.prepare-tea" or name == "opening.serve-tea" or name == "opening.bite-silver":
        return "shen"
    return "su"

fn c1_op_reward_object(id):
    if id == "shen":
        return "opening.silver"
    if id == "huo":
        return "opening.testpiece"
    return "opening.audition"

fn c1_op_invitation_requirement():
    return {"speaker": "demon", "action_id": "demon.opening.reward-invitation", "receipt_kind": "actual-listener-parse"}

fn c1_op_slot_inspections():
    var ids = ["huo", "shen", "su", "detective"]
    var result = []
    var i = 0
    while i < rt_count(ids):
        var id = ids[i]
        var known = dv_all(dv_pair(c1_at(id, "hall"), c1_op_property("opening.cabinet", "position_description", "铜口下方")))
        var slot = rt_cat("opening.slot.", id)
        var refs = [dv_ref(slot, "state", "label"), dv_ref(slot, "state", "contents")]
        if id != "detective":
            rt_push(refs, dv_ref(c1_op_reward_object(id), "state", "location"))
        var action = c1_once(c1_action(rt_cat(id, ".opening.inspect-reward-slot"), "inspect", known, c1_at(id, "hall"), "", refs, c1_op_source(29, "s4_rewards.004")))
        rt_push(result, dv_with_many(action, {"owner": id, "received_speech_requirement": c1_op_invitation_requirement(), "personal_purpose": {"subject": id, "id": "verify-personally-addressed-offer", "basis": [c1_op_source(29, "s4_rewards.004")]}}))
        i = i + 1
    var look = c1_once(c1_action("shen.opening.look-arrival", "inspect", c1_at("shen", "hall"), dv_all(dv_pair(c1_at("shen", "hall"), c1_at("detective", "hall"))), "", [dv_ref("coat", "state", "worn_by")], c1_op_source(15, "s2_meet.008")))
    rt_push(result, dv_with_many(look, {"owner": "shen", "opportunity_requirement": {"location": "hall", "participants": ["detective"], "mode": "all-present"}}))
    return result

fn c1_op_request(action, target, topic):
    return dv_with(action, "speech", dv_with(action.speech, "request", {"target": target, "topic": topic}))

fn c1_op_appropriate_candidate(action):
    var id = action.owner
    var name = action.id
    if action.law != "":
        action = dv_with(action, "predict_law", action.law)
    if dv_has_key(action, "speech"):
        var targets = []
        var listeners = dv_find(action, "listeners", [])
        var i = 0
        while i < rt_count(listeners):
            if listeners[i] != id:
                rt_push(targets, listeners[i])
            i = i + 1
        action = dv_with(action, "opportunity_requirement", {"location": "hall", "participants": targets, "mode": "at-least-one-present"})
    if name == "shen.opening.welcome" or name == "shen.opening.introduce" or name == "huo.opening.introduce" or name == "su.opening.introduce" or name == "shen.opening.memory-report":
        action = dv_with_many(action, {"response_topic": "opening.meeting", "offer_to": "detective", "opportunity_requirement": {"location": "hall", "participants": ["detective"], "mode": "all-present"}})
    if name == "shen.opening.introduce":
        action = dv_with(action, "completed_action_requirement", {"action_id": "shen.opening.welcome"})
    if name == "shen.opening.serve-tea":
        action = dv_with(action, "completed_action_requirement", {"action_id": "shen.opening.introduce"})
    if name == "shen.opening.ask-name":
        action = dv_with(action, "precondition", dv_all(dv_pair(action.precondition, dv_fact(dv_ref("coat", "state", "worn_by"), "detective"))))
        action = dv_with(action, "speech", dv_with(action.speech, "presuppositions", [dv_fact(dv_ref("coat", "state", "worn_by"), "detective")]))
        action = c1_op_request(action, "detective", "opening.self-introduction")
        action = dv_with(action, "opportunity_requirement", {"location": "hall", "participants": ["detective"], "mode": "all-present"})
        action = dv_with_many(action, {"completed_action_requirement": {"action_id": "shen.opening.introduce"}, "suppress_after_received_speech": {"speaker": "detective", "action_id": "detective.opening.introduce"}})
    if name == "detective.opening.introduce":
        // An actually completed self-introduction also answers a later-arriving name request.
        action = dv_with_many(action, {"response_topic": "opening.self-introduction", "response_once": true, "received_speech_requirement": {"any_of": [{"speaker": "shen", "action_id": "shen.opening.welcome"}, {"speaker": "shen", "action_id": "shen.opening.introduce"}, {"speaker": "shen", "action_id": "shen.opening.ask-name"}]}})
    if name == "su.opening.ask-sugar":
        action = dv_with(action, "precondition", dv_all(dv_pair(action.precondition, dv_fact(c1_op_person_ref("su", "prefers_unsweetened"), true))))
        action = dv_with(action, "speech", dv_with(action.speech, "presuppositions", [dv_fact(c1_op_person_ref("su", "prefers_unsweetened"), true), c1_op_property("opening.cup.su", "sugar_added", false)]))
        action = c1_op_request(action, "shen", "opening.sugar-habit")
    if name == "shen.opening.body-habit":
        action = dv_with(action, "response_topic", "opening.sugar-habit")
    if name == "detective.opening.ask-reward":
        action = c1_op_request(action, "demon", "opening.detective-reward")
    if name == "demon.opening.other-contract":
        action = dv_with(action, "response_topic", "opening.detective-reward")
    if name == "shen.opening.serve-tea":
        action = dv_with_many(action, {"precondition": dv_all(dv_pair(action.precondition, c1_op_property("opening.tea", "prepared", true))), "authority_precondition": dv_all([action.authority_precondition, c1_at("detective", "hall"), c1_at("huo", "hall"), c1_at("su", "hall")]), "opportunity_requirement": {"location": "hall", "participants": ["detective", "huo", "su"], "mode": "all-present"}})
    if name == "demon.opening" or name == "demon.question.prompt":
        action = dv_with(action, "opportunity_requirement", {"location": "hall", "participants": c1_op_people(), "mode": "all-present"})
    let broadcasts = ["demon.opening", "demon.opening.reward-invitation", "demon.opening.desire-offer", "demon.opening.public-alarm", "demon.opening.public-latch", "demon.question.prompt", "demon.opening.investigate-invitation"]
    var broadcast_index = 1
    while broadcast_index < rt_count(broadcasts):
        if name == broadcasts[broadcast_index]:
            action = dv_with(action, "completed_action_requirement", {"action_id": broadcasts[broadcast_index - 1]})
        broadcast_index = broadcast_index + 1
    if name == "shen.opening.bite-silver" or name == "huo.opening.scrape-testpiece" or name == "su.opening.play-audition":
        action = dv_with_many(action, {"precondition": dv_all([action.precondition, c1_op_property("opening.cabinet", "position_description", "铜口下方"), c1_op_property(c1_op_reward_object(id), "location", "opening.cabinet")]), "received_speech_requirement": c1_op_invitation_requirement(), "desire_requirement": {"subject": id, "desire_id": c1_op_desire(id).id, "basis": c1_op_desire(id).basis}, "personal_purpose": {"subject": id, "id": "inspect-relevant-offered-material", "basis": c1_op_desire(id).basis}})
    if name == "shen.opening.accept-work" or name == "huo.opening.seek-drawing":
        action = dv_with(action, "desire_requirement", {"subject": id, "desire_id": c1_op_desire(id).id, "basis": c1_op_desire(id).basis})
    if name == "huo.opening.seek-drawing":
        action = dv_with(action, "precondition", dv_all(dv_pair(action.precondition, c1_op_property("opening.facilities", "drawing_exists", true))))
    if name == "shen.opening.maintain-interpretation":
        action = dv_with(action, "precondition", dv_all(dv_pair(action.precondition, c1_op_property("opening.cup.su", "served_by", "shen"))))
    return action

fn c1_op_flat_candidates(detective_name):
    var catalogs = [c1_op_morning_candidates(), c1_op_meet_candidates(), c1_op_tea_candidates(detective_name), c1_op_broadcast_candidates(), c1_op_reward_candidates(detective_name), c1_op_desire_candidates(detective_name), c1_op_investigation_candidates(), c1_op_slot_inspections(), c1_op_maintenance_actions(), c1_op_contract_candidates()]
    var result = []
    var i = 0
    while i < rt_count(catalogs):
        var rows = catalogs[i]
        var j = 0
        while j < rt_count(rows):
            rt_push(result, c1_op_appropriate_candidate(rows[j]))
            j = j + 1
        i = i + 1
    rt_push(result, dv_with(dv_with(c1_inspect_E11("detective"), "owner", "detective"), "presentation", c1_op_presentation("detective", "visible-inspection", dv_single(c1_visible_E11()))))
    rt_push(result, dv_with(dv_with(c1_inspect_E12("detective"), "owner", "detective"), "presentation", c1_op_presentation("detective", "visible-inspection", dv_single(c1_visible_E12()))))
    return result

fn c1_op_know_goal(id, ref, basis, available):
    return {"kind": "know", "scope": "personal", "question": "opening_own", "ref": ref, "available_when": available, "basis": basis, "owner": id}

fn c1_op_achieve_goal(id, proposition, basis, available):
    return {"kind": "achieve", "scope": "personal", "question": "opening_own", "proposition": proposition, "available_when": available, "basis": basis, "owner": id}

fn c1_op_communicate_goal(id, method, basis, available):
    return {"kind": "communicate", "scope": "personal", "method_id": method, "available_when": available, "basis": basis, "requires_argument": false, "owner": id}

fn c1_op_owned_goals(id):
    var result = []
    if dv_has(c1_op_people(), id):
        var awake = dv_fact(dv_ref(id, "body", "awake"), true)
        var basis = dv_single(c1_memory_source(id))
        rt_push(result, c1_op_achieve_goal(id, dv_not(c1_at(id, c1_op_wake_room(id))), basis, awake))
        rt_push(result, c1_op_achieve_goal(id, c1_at(id, "hall"), basis, dv_all([dv_not(c1_at(id, c1_op_wake_room(id))), dv_fact(dv_ref("departure.door", "state", "outer_released"), false)])))
        if id == "detective":
            rt_push(result, c1_op_know_goal(id, dv_ref("coat", "identity", "owner"), [c1_op_source(6, "s1_wake.006")], c1_at(id, "R05")))
            rt_push(result, c1_op_achieve_goal(id, dv_fact(dv_ref("coat", "state", "worn_by"), "detective"), [c1_op_source(6, "s1_wake.006; s2_meet.008")], c1_at(id, "R05")))
            rt_push(result, c1_op_know_goal(id, dv_ref("opening.slot.detective", "state", "contents"), [c1_op_source(35, "s4_rewards.020")], c1_op_property("opening.cabinet", "position_description", "铜口下方")))
            rt_push(result, c1_op_communicate_goal(id, "detective.opening.introduce", [c1_op_source(19, "s2_tea.001")], c1_at(id, "hall")))
            rt_push(result, c1_op_communicate_goal(id, "detective.opening.ask-reward", [c1_op_source(36, "s4_rewards.016")], c1_op_property("opening.slot.detective", "contents", "empty")))
        if id == "huo":
            rt_push(result, c1_op_know_goal(id, dv_ref("opening.wake.huo", "state", "oilcloth_wrap"), basis, c1_at(id, "R06")))
            rt_push(result, c1_op_communicate_goal(id, "huo.opening.seek-drawing", c1_op_desire(id).basis, c1_op_reward_requirement(id)))
        if id == "shen":
            rt_push(result, c1_op_know_goal(id, dv_ref("opening.wake.shen", "state", "whetstone_grooved"), basis, c1_at(id, "R07")))
            rt_push(result, c1_op_achieve_goal(id, c1_op_property("opening.tea", "prepared", true), [c1_op_source(11, "s2_meet.009")], c1_at(id, "hall")))
            rt_push(result, c1_op_achieve_goal(id, c1_op_property("opening.cup.su", "contents", "tea"), [c1_op_source(21, "s2_tea.011")], c1_op_property("opening.tea", "prepared", true)))
            rt_push(result, c1_op_communicate_goal(id, "shen.opening.welcome", [c1_op_source(11, "s2_meet.009")], c1_op_property("opening.tea", "prepared", true)))
            rt_push(result, c1_op_know_goal(id, dv_ref("coat", "state", "worn_by"), [c1_op_source(15, "s2_meet.008")], c1_at(id, "hall")))
            rt_push(result, c1_op_communicate_goal(id, "shen.opening.ask-name", [c1_op_source(15, "s2_meet.008")], c1_at(id, "hall")))
            rt_push(result, c1_op_communicate_goal(id, "shen.opening.memory-report", [c1_op_source(20, "s2_tea.016")], c1_at(id, "hall")))
            rt_push(result, c1_op_communicate_goal(id, "shen.opening.accept-work", c1_op_desire(id).basis, c1_op_reward_requirement(id)))
            rt_push(result, c1_op_communicate_goal(id, "shen.opening.body-habit", [c1_op_source(23, "s2_tea.013")], c1_op_property("opening.cup.su", "served_by", "shen")))
        if id == "su":
            rt_push(result, c1_op_know_goal(id, dv_ref("opening.wake.su", "state", "low_wall_tone"), basis, c1_at(id, "R08")))
            rt_push(result, c1_op_communicate_goal(id, "su.opening.ask-sugar", [c1_op_source(22, "s2_tea.012")], c1_op_property("opening.cup.su", "sugar_added", false)))
        if id != "detective":
            var invitation_known = c1_op_property("opening.cabinet", "position_description", "铜口下方")
            var desire = c1_op_desire(id)
            var introduction_source = c1_op_source(12, "s2_meet.010")
            if id == "huo":
                introduction_source = c1_op_source(13, "s2_meet.011")
            if id == "su":
                introduction_source = c1_op_source(14, "s2_meet.006")
            rt_push(result, c1_op_communicate_goal(id, rt_cat(id, ".opening.introduce"), [introduction_source], c1_at(id, "hall")))
            rt_push(result, c1_op_know_goal(id, dv_ref(rt_cat("opening.slot.", id), "state", "contents"), desire.basis, invitation_known))
            var refs = c1_op_reward_refs(id)
            var i = 0
            while i < rt_count(refs):
                rt_push(result, c1_op_know_goal(id, refs[i], desire.basis, invitation_known))
                i = i + 1
            rt_push(result, c1_op_communicate_goal(id, rt_cat(id, ".opening.maintain-interpretation"), desire.basis, c1_op_reward_requirement(id)))
    if id == "demon":
        var methods = ["demon.opening", "demon.opening.reward-invitation", "demon.opening.desire-offer", "demon.opening.public-alarm", "demon.opening.public-latch", "demon.question.prompt", "demon.opening.investigate-invitation", "demon.opening.other-contract"]
        var i = 0
        while i < rt_count(methods):
            rt_push(result, c1_op_communicate_goal(id, methods[i], [c1_op_source(28, "s3_broadcast.019"), c1_op_source(46, "s5_question.004")], c1_at(id, "hall")))
            i = i + 1
    return result

fn c1_op_install_purposes(actor):
    var policy = dv_with(actor.policy, "notice_co_presence", true)
    var goals = []
    var existing = dv_find(policy, "goals", [])
    var n = 0
    while n < rt_count(existing):
        var goal = existing[n]
        if dv_has(c1_op_people(), actor.id) and actor.id != "detective" and dv_find(goal, "question", "") == "own_material":
            // The public opening receipt establishes the own-material motive across
            // later question stages; its activation does not expire with a stage name.
            goal = dv_with(goal, "available_when", dv_all(dv_pair(dv_find(goal, "available_when", dv_true()), dv_fact(dv_ref("question", "state", "awake_scope"), true))))
        rt_push(goals, goal)
        n = n + 1
    var added = c1_op_owned_goals(actor.id)
    var i = 0
    while i < rt_count(added):
        rt_push(goals, added[i])
        i = i + 1
    policy = dv_with(policy, "goals", goals)
    if dv_has(c1_op_people(), actor.id):
        policy = dv_with(policy, "desires", dv_append(dv_find(policy, "desires", []), c1_op_desire(actor.id)))
    return dv_with(actor, "policy", policy)

fn c1_op_contract_text():
    return "1. 恶魔常驻岛内，不得离岛。\n2. 经学员本人授权，恶魔封存其在校记忆（在校经历、师生与同学关系、事故全貌）；姓名、生平与入学前技艺不在封存之列。\n3. 恶魔维持学园基础生存设施的运转（水、炉火、照明的设施本身；不负责分配物资，不创造物资）。\n4. 恶魔所受约束，唯有学员出于自主的行动方可解除；恶魔不得代为或强迫学员完成解除。\n5. 恶魔须公开它自己所立之规；规则许诺的路径必须真实可行。\n6. 恶魔须传授学员理解处境与继续学习所需之知；学员自负其选择的后果。\n7. 恶魔不得伤害学员身心，不得拘禁学员，不得令学员因无知而死。\n8. 恶魔不得以言辞欺骗学员；学员问及本人封存之物或契约条文，须如实作答。\n9. 恶魔不得向学员提及封存之物的所在与取回之法，不得促其取回；学员自行问及者，依前条作答。\n10. 封存的记忆可凭对应之物恢复；恢复者自负其果。\n11. 经其余在岛存活学员一致同意，学员可择定“尽忘归乡”，于下一次入睡时遗忘此地一切、在家乡醒来。\n12. （终局）担保耗尽时，恶魔须将醒着且未深属此岛的学员遣返家乡，并抹去其与此地有关的一切记忆。"

fn c1_op_contract_candidates():
    // Full-contract questions belong to the second-day permission dialogue.
    return []

// First evening opportunities: time opens actions, never performs them.
// Numeric provisions are engineering serving units; no earlier stock history is asserted.
fn c1n_ref(field):
    return dv_ref("night.first", "state", field)

fn c1n_source(id):
    return c1_source("language_core/verification/scenarios/chapter1-night.dv", 0, rt_cat("authorized-first-night-20261016.", id))

fn c1n_mark(id):
    return c1n_ref(rt_cat("done.", id))

fn c1n_row(actor, id, start, end, when, text):
    return {"actor": actor, "id": rt_cat("night.", id), "start": start, "end": end, "when": when, "text": text, "kind": "talk", "effects": [], "grants": [], "literal": dv_true()}

fn c1n_rows():
    let key = ["authored-declaration", "c1n_rows"]
    let cached = rt_memo_get([], key)
    if cached[0]:
        return cached[1]
    return rt_memo_put([], key, c1n_rows_build())

fn c1n_rows_build():
    var rows = []
    let meet = dv_all([c1_at("detective", "living_hall"), c1_at("huo", "living_hall"), c1_at("shen", "living_hall")])
    rt_push(rows, c1n_row("quer", "greeting", 750, 810, meet, "老霍！沈叔！……咦，我怎么张嘴就这么叫了？"))
    let apron = c1n_row("shen", "apron", 750, 810, c1_at("quer", "living_hall"), "沈鼎摸了摸围裙口袋，摸出一点零嘴，递向雀儿。")
    rt_push(rows, dv_with_many(apron, {"kind": "help", "public_observers": c2_people(), "public_grants": [c1n_mark(apron.id)]}))
    var show = c1n_row("ward", "show-evidence", 840, 930, dv_all([dv_fact(c1_other_ref("contract", "evidence_complete"), true), dv_fact(c1_other_ref("contract", "keys_found"), true), dv_fact(c1_other_ref("contract", "wax_ash_seen"), true)]), "沃德摊开半角红纸，又放下管网图的蜡布筒：先限制雀儿的自由，待事情查明。")
    show = dv_with_many(show, {"kind": "help", "effects": [dv_assign(dv_ref("night.evidence", "state", "displayed"), true)], "grants": [dv_ref("night.evidence", "state", "displayed")], "public_observers": c2_people(), "public_grants": [dv_ref("night.evidence", "state", "displayed")]})
    rt_push(rows, show)
    let inspected = dv_all([dv_fact(dv_ref("night.evidence", "state", "wax_seal_intact"), true), dv_fact(dv_ref("night.evidence", "state", "fresh_torn_edge"), true)])
    rt_push(rows, c1n_row("detective", "defer-judgment", 840, 930, inspected, "蜡布筒的火漆封口完好，红纸毛边却是新撕的。另一半多半仍在文献工房；明日到现场勘验，再作判断。"))
    var defer = c1n_row("gu", "corroborate", 840, 930, dv_true(), "孤证不立。待明日去文献工房，把另一半找来核对。")
    defer = dv_with(defer, "received", {"speaker": "detective", "action_id": "night.defer-judgment"})
    rt_push(rows, defer)
    rt_push(rows, c1n_row("detective", "ask-closed-doors", 960, 1101, dv_true(), "丙区、丁区里的人怎么样了？伤者还好吗？"))
    var count = c1n_row("shen", "count-provisions", 1110, 1230, dv_true(), "实际清点甲乙两区带来的余粮，按八份备餐用量记账。")
    count = dv_with_many(count, {"kind": "inspect", "effects": [dv_assign(dv_ref("night.provisions", "state", "counted"), true)], "grants": [dv_ref("night.provisions", "state", "counted"), dv_ref("night.provisions", "state", "bread"), dv_ref("night.provisions", "state", "onion"), dv_ref("night.provisions", "state", "meat")]})
    rt_push(rows, count)
    var cook = c1n_row("shen", "cook", 1110, 1230, dv_all([dv_fact(dv_ref("night.provisions", "state", "counted"), true), dv_at_least(dv_ref("night.provisions", "state", "bread"), 8), dv_at_least(dv_ref("night.provisions", "state", "onion"), 8), dv_at_least(dv_ref("night.provisions", "state", "meat"), 8)]), "沈鼎用甲乙两区清点出的余粮，烤面包，煮洋葱碎肉汤，备出八人份。")
    cook = dv_with_many(cook, {"kind": "help", "effects": [dv_increment(dv_ref("night.provisions", "state", "bread"), -8), dv_increment(dv_ref("night.provisions", "state", "onion"), -8), dv_increment(dv_ref("night.provisions", "state", "meat"), -8), dv_assign(dv_ref("night.provisions", "state", "evening_servings"), 8)], "grants": [dv_ref("night.provisions", "state", "bread"), dv_ref("night.provisions", "state", "onion"), dv_ref("night.provisions", "state", "meat"), dv_ref("night.provisions", "state", "evening_servings"), dv_ref("night.provisions", "state", "consumed")], "public_observers": c2_people(), "public_grants": [dv_ref("night.provisions", "state", "evening_servings"), dv_ref("night.provisions", "state", "consumed")]})
    rt_push(rows, cook)
    rt_push(rows, c1n_row("quer", "cold-hand", 1260, 1440, c1_at("detective", "living_hall"), "壁炉边，雀儿压低声音：递钥匙的那只手，很凉。那人说，‘别让它落进下面那东西手里。’我只知道自己听到了这句话。"))
    var partner = c1n_row("quer", "partner", 1260, 1440, c1_at("detective", "living_hall"), "明日一起去文献工房。我替你开学园里的锁，咱们搭档，怎么样？")
    partner = dv_with_many(partner, {"effects": [dv_assign(c1n_ref("partner_offered"), true)], "grants": [c1n_ref("partner_offered")]})
    rt_push(rows, partner)
    var accept = c1n_row("detective", "accept-partner", 1260, 1440, c1_at("quer", "living_hall"), "好。明日先去文献工房，到了现场再核对。")
    accept = dv_with_many(accept, {"received": {"speaker": "quer", "action_id": "night.partner"}, "effects": [dv_assign(c1n_ref("partner_promised"), true)], "grants": [c1n_ref("partner_promised")]})
    rt_push(rows, accept)
    rt_push(rows, c1n_row("huo", "watch-offer", 1260, 1440, c1_at("detective", "living_hall"), "夜里总得有人醒着。我跟你分班，先把这一夜守过去。"))
    var watch = c1n_row("detective", "watch-agree", 1260, 1440, c1_at("huo", "living_hall"), "我们分班守夜。交班时把听见、看见的事情说清楚。")
    watch = dv_with_many(watch, {"received": {"speaker": "huo", "action_id": "night.watch-offer"}, "effects": [dv_assign(c1n_ref("watch_agreed"), true)], "grants": [c1n_ref("watch_agreed")], "public_grants": [c1n_ref("watch_agreed")]})
    rt_push(rows, watch)
    let diners = ["detective", "huo", "shen", "su", "quer", "ward", "gu", "lucian"]
    var diner_index = 0
    while diner_index < rt_count(diners):
        let diner = diners[diner_index]
        var meal = c1n_row(diner, rt_cat("eat.", diner), 1110, 1260, dv_at_least(dv_ref("night.provisions", "state", "evening_servings"), 1), "取一份烤面包和洋葱碎肉汤，用过晚餐。")
        meal = dv_with_many(meal, {"kind": "help", "effects": [dv_increment(dv_ref("night.provisions", "state", "evening_servings"), -1), dv_increment(dv_ref("night.provisions", "state", "consumed"), 1)], "grants": [dv_ref("night.provisions", "state", "evening_servings"), dv_ref("night.provisions", "state", "consumed")], "public_observers": c2_people(), "public_grants": [c1n_mark(meal.id)]})
        rt_push(rows, meal)
        diner_index = diner_index + 1
    var first_watch = c1n_row("huo", "first-watch", 1320, 1440, dv_fact(c1n_ref("watch_agreed"), true), "霍铎留在壁炉旁守前半夜，留意门口和走廊里的实际动静。")
    first_watch = dv_with(first_watch, "kind", "help")
    rt_push(rows, first_watch)
    var second_watch = c1n_row("detective", "second-watch", 1440, 1800, dv_fact(c1n_ref("watch_agreed"), true), "侦探接过后半夜的守候，核对门口和走廊里的动静。")
    second_watch = dv_with(second_watch, "kind", "help")
    rt_push(rows, second_watch)
    return rows

fn c1n_pre(row):
    return dv_all([c1_at(row.actor, "living_hall"), c2_window(1, row.start, row.end), row.when, dv_fact(c1n_mark(row.id), false)])

axiom c1n_law(row):
    return dv_axiom("c1n_law", 1, c1n_pre(row), dv_append(row.effects, dv_assign(c1n_mark(row.id), true)))

fn c1n_action(row):
    var action = c2_action(row.id, row.kind, c1n_pre(row), c1n_pre(row), row.id, dv_append(row.grants, c1n_mark(row.id)), row.text, c1n_source(row.id))
    action = dv_with(action, "predict_law", row.id)
    if row.kind == "talk":
        var listeners = []
        let people = c2_people()
        var listener_index = 0
        while listener_index < rt_count(people):
            if people[listener_index] != row.actor:
                rt_push(listeners, people[listener_index])
            listener_index = listener_index + 1
        action = dv_with_many(action, {"speech": dv_with_many(c1_speech(row.literal, c1n_source(row.id), "personally-owned-evening-statement"), {"surface": row.text, "channel": "local"}), "listeners": listeners})
    if dv_has_key(row, "public_grants"):
        action = dv_with(action, "public_grants", row.public_grants)
    if dv_has_key(row, "public_observers"):
        action = dv_with(action, "public_observers", row.public_observers)
    if dv_has_key(row, "received"):
        action = dv_with(action, "received_speech_requirement", row.received)
    return action

fn c1n_inspections(actor):
    if actor == "demon":
        return []
    let here = c1_at(actor, "living_hall")
    var actions = []
    rt_push(actions, dv_with(c2_action(rt_cat("night.inspect-room.", actor), "inspect", here, here, "", [c1n_ref("watch_agreed"), dv_ref("night.provisions", "state", "evening_servings")], "查看公共备餐和守夜交班的实际情况。", c1n_source("room-status")), "repeatable", true))
    if actor == "detective":
        let pre = dv_all([here, dv_fact(dv_ref("night.evidence", "state", "displayed"), true)])
        rt_push(actions, c2_action("night.inspect-evidence", "inspect", pre, pre, "", [dv_ref("night.evidence", "state", "displayed"), dv_ref("night.evidence", "state", "wax_seal_intact"), dv_ref("night.evidence", "state", "fresh_torn_edge")], "近看蜡布筒的火漆封口与红纸的新撕毛边。", c1n_source("inspect-evidence")))
    if actor == "detective":
        rt_push(actions, c2_action("night.inspect-displayed", "inspect", here, here, "", [dv_ref("night.evidence", "state", "displayed")], "查看沃德是否已把证物摆在面前。", c1n_source("displayed")))
    let call_source = c1n_source("personally-heard-midnight-copper-call")
    let night_when = dv_all([c2_window(1, 1440, 1800), dv_fact(c1n_night_seen_ref(actor), true)])
    let notice_id = rt_cat(actor, ".night.notice-time")
    let notice_when = dv_all([c1_at(actor, "living_hall"), c2_window(1, 1440, 1800)])
    rt_push(actions, dv_with(c2_action(notice_id, "inspect", notice_when, notice_when, notice_id, [c1_other_clock_ref(), c1n_night_seen_ref(actor)], "留意起居厅里此刻的光线与时钟，确认已经入夜。", c1n_source("own-observed-midnight-time")), "predict_law", notice_id))
    let call_ref = c1n_call_ref(actor)
    let call_id = rt_cat(actor, ".night.hear-private-call")
    let call_when = dv_all([c1_at(actor, "living_hall"), night_when, dv_fact(call_ref, false)])
    var call = c2_action(call_id, "inspect", call_when, call_when, call_id, [call_ref], "铜口深处有个声音，低低唤着你。那种熟悉感只落进你自己的耳中。", call_source)
    call = dv_with_many(call, {"predict_law": call_id, "night_call_requirement": {"basis": [call_source], "night_when": night_when}, "sensory_mode": "private-night-copper-call", "grant_observation_sources": [{"ref": call_ref, "source": "perception", "origin": "personally-heard-midnight-copper-call", "trust": 1}], "purpose_refs": [call_ref]})
    rt_push(actions, call)
    return actions

fn c1n_goals(actor):
    if actor.id == "demon":
        return []
    var goals = []
    let rows = c1n_rows()
    var i = 0
    while i < rt_count(rows):
        let row = rows[i]
        if row.actor == actor.id:
            if row.kind == "talk":
                rt_push(goals, {"kind": "communicate", "scope": "personal", "method_id": row.id, "available_when": c1n_pre(row), "requires_argument": false, "basis": [c1n_source(row.id)]})
            else:
                rt_push(goals, c2_goal(dv_fact(c1n_mark(row.id), true), c1n_pre(row), [c1n_source(row.id)]))
        i = i + 1
    let inspections = c1n_inspections(actor.id)
    i = 0
    while i < rt_count(inspections):
        let action = inspections[i]
        var j = 0
        while j < rt_count(action.grants):
            var goal = c2_observation_goal(action.grants[j], action.precondition, action.source_refs, 0)
            if action.id == rt_cat("night.inspect-room.", actor.id):
                // Recheck only after related received activity, never after the
                // inspection's own timestamp or an unrelated observation.
                let triggers = [c1n_mark("night.watch-agree"), c1n_mark("night.cook")]
                goal = dv_with_many(goal, {"refresh_until": dv_not(dv_true()), "refresh_refs": triggers})
            rt_push(goals, goal)
            j = j + 1
        i = i + 1
    return goals

fn c1n_refresh_actor_goals(actor):
    if not dv_has_key(actor.policy, "first_night_goals"):
        var combined = dv_clone(dv_find(actor.policy, "first_night_base_goals", actor.policy.goals))
        let goals = c1n_goals(actor)
        var i = 0
        while i < rt_count(goals):
            rt_push(combined, goals[i])
            i = i + 1
        actor = dv_with(actor, "policy", dv_with_many(actor.policy, {"goals": combined, "first_night_goals": goals}))
    return c1n_known_future_wait_actor(actor)

fn c1n_morning_ready(world):
    return world.time >= 1800

fn c1n_install_scene(scene):
    if dv_find(scene, "first_night_installed", false):
        return scene
    let rows = c1n_rows()
    var fields = {"partner_offered": dv_field(false), "partner_promised": dv_field(false), "watch_agreed": dv_field(false)}
    var i = 0
    while i < rt_count(rows):
        fields = dv_with(fields, rt_cat("done.", rows[i].id), dv_field(false))
        i = i + 1
    let objects = [c1_state_object("night.first", fields), c1_state_object("night.evidence", {"displayed": dv_field(false), "wax_seal_intact": dv_field(true), "fresh_torn_edge": dv_field(true)}), c1_state_object("night.provisions", {"counted": dv_field(false), "bread": dv_field(8), "onion": dv_field(8), "meat": dv_field(8), "evening_servings": dv_field(0), "consumed": dv_field(0)})]
    var physical = scene.physical
    var bindings = dv_clone(scene.bindings)
    i = 0
    while i < rt_count(objects):
        physical = c2_add_new(physical, objects[i])
        i = i + 1
    i = 0
    while i < rt_count(rows):
        physical = dv_adopt(physical, c1_method(rows[i].id, c1n_law(rows[i])), "enforce", 1, [c1n_source(rows[i].id)])
        i = i + 1
    var costs = dv_clone(scene.cost_model)
    let durations = c1n_wait_durations()
    var duration_index = 0
    while duration_index < rt_count(durations):
        let minutes = durations[duration_index]
        costs = dv_with(costs, c1n_wait_kind(minutes), c1_cost(minutes, c1n_source("bounded-wait-engineering-duration")))
        duration_index = duration_index + 1
    var actors = []
    i = 0
    while i < rt_count(scene.actors):
        var actor = scene.actors[i]
        var mind = actor.mind
        var j = 0
        while j < rt_count(objects):
            mind = c2_add_new(mind, c1_local_object(objects[j].id))
            if dv_local(bindings, objects[j].id, actor.id) == "":
                rt_push(bindings, dv_binding(objects[j].id, objects[j].id, actor.id))
            j = j + 1
        let call_object = rt_cat("night.call.", actor.id)
        physical = c2_add_new(physical, c1_state_object(call_object, {"heard": dv_field(false), "night_observed": dv_field(false)}))
        mind = c2_add_new(mind, c1_local_object(call_object))
        mind = dv_store(mind, c1n_call_ref(actor.id), dv_with(dv_field(false), "basis", [c1n_source("own-night-call-not-yet-heard")]))
        if dv_local(bindings, call_object, actor.id) == "":
            rt_push(bindings, dv_binding(call_object, call_object, actor.id))
        let notice_id = rt_cat(actor.id, ".night.notice-time")
        physical = dv_adopt(physical, c1_method(notice_id, c1n_night_seen_law(actor.id)), "enforce", 1, [c1n_source("own-observed-midnight-time")])
        mind = dv_adopt(mind, c1_method(notice_id, c1n_night_seen_law(actor.id)), "predict", 1, [c1n_source("own-observed-midnight-time")])
        let call_id = rt_cat(actor.id, ".night.hear-private-call")
        physical = dv_adopt(physical, c1_method(call_id, c1n_call_law(actor.id)), "enforce", 1, [c1n_source("personally-heard-midnight-copper-call")])
        mind = dv_adopt(mind, c1_method(call_id, c1n_call_law(actor.id)), "predict", 1, [c1n_source("personally-heard-midnight-copper-call")])
        let wait_id = rt_cat("night.wait.", actor.id)
        physical = c2_add_new(physical, c1_state_object(wait_id, {"elapsed": dv_field(0)}))
        mind = c2_add_new(mind, c1_local_object(wait_id))
        mind = dv_store(mind, c1n_wait_ref(actor.id), dv_with(dv_field(0), "basis", [c1n_source("own-wait-account-initial")]))
        if dv_local(bindings, wait_id, actor.id) == "":
            rt_push(bindings, dv_binding(wait_id, wait_id, actor.id))
        duration_index = 0
        while duration_index < rt_count(durations):
            let minutes = durations[duration_index]
            let wait_method = c1n_wait_id(actor.id, minutes)
            physical = dv_adopt(physical, c1_method(wait_method, c1n_wait_law(actor.id, minutes)), "enforce", 1, [c1n_source("own-bounded-wait")])
            mind = dv_adopt(mind, c1_method(wait_method, c1n_wait_law(actor.id, minutes)), "predict", 1, [c1n_source("own-bounded-wait")])
            duration_index = duration_index + 1
        var actions = dv_clone(actor.actions)
        var hearing = dv_clone(dv_find(actor, "hearing_grants", []))
        let people = c2_people()
        j = 0
        while j < rt_count(people):
            if people[j] != actor.id:
                mind = c2_add_new(mind, c1_local_object(people[j]))
                if dv_local(bindings, people[j], actor.id) == "":
                    rt_push(bindings, dv_binding(people[j], people[j], actor.id))
                rt_push(hearing, {"speaker": people[j], "channel": "local", "available_when": c1_at(actor.id, "living_hall"), "sender_locations": ["living_hall"], "listener_locations": ["living_hall"], "basis": [c1n_source("actual-co-present-evening-speech")]})
            j = j + 1
        j = 0
        while j < rt_count(rows):
            let row = rows[j]
            if row.actor == actor.id:
                mind = dv_store(mind, c1n_mark(row.id), dv_field(false))
                mind = dv_adopt(mind, c1_method(row.id, c1n_law(row)), "predict", 1, [c1n_source(row.id)])
                rt_push(actions, c1n_action(row))
            j = j + 1
        let inspect = c1n_inspections(actor.id)
        j = 0
        while j < rt_count(inspect):
            rt_push(actions, inspect[j])
            j = j + 1
        actor = dv_with_many(actor, {"mind": mind, "actions": c1_public_methods(actions), "hearing_grants": hearing, "policy": dv_with(actor.policy, "first_night_base_goals", actor.policy.goals)})
        rt_push(actors, c1n_refresh_actor_goals(actor))
        i = i + 1
    return dv_with_many(scene, {"physical": physical, "actors": actors, "bindings": bindings, "cost_model": costs, "first_night_installed": true})

// These are finite costed action lengths, not speed multipliers or world-clock writes.
fn c1n_wait_durations():
    return [180, 120, 60, 30, 15, 5, 1]

fn c1n_wait_kind(minutes):
    return rt_cat("wait.first_night.", rt_show(minutes))

fn c1n_wait_id(actor, minutes):
    return rt_cat(rt_cat(actor, "."), c1n_wait_kind(minutes))

fn c1n_wait_ref(actor):
    return dv_ref(rt_cat("night.wait.", actor), "state", "elapsed")

axiom c1n_wait_law(actor, minutes):
    return dv_axiom("c1n_wait_law", 1, dv_true(), [dv_increment(c1n_wait_ref(actor), minutes)])

// Callers must supply a future opportunity from this actor's own authored intention
// or actual received information, never another mind or a physical future fact.
// The ordinary decision comparison remains responsible for choosing this action.
fn c1n_known_wait_actor(actor, target, basis):
    var actions = []
    var i = 0
    while i < rt_count(actor.actions):
        if not dv_find(actor.actions[i], "known_opportunity_wait", false):
            rt_push(actions, actor.actions[i])
        i = i + 1
    var goals = []
    let existing = dv_find(actor.policy, "goals", [])
    i = 0
    while i < rt_count(existing):
        if not dv_find(existing[i], "known_opportunity_wait", false):
            rt_push(goals, existing[i])
        i = i + 1
    let elapsed = dv_read(actor.mind, c1n_wait_ref(actor.id))
    let progress_weight = dv_find(actor.policy, "progress_weight", 1)
    let time_cost = dv_find(actor.policy, "time_cost", 0.01)
    var current_night_action = false
    let rows = c1n_rows()
    i = 0
    while i < rt_count(rows):
        if rows[i].actor == actor.id and dv_truth(actor.mind, c1n_pre(rows[i])) == "true":
            current_night_action = true
        i = i + 1
    if elapsed.known and actor.mind.time < target and 0 < rt_count(basis) and 0 < progress_weight and not current_night_action:
        let durations = c1n_wait_durations()
        var minutes = 0
        i = 0
        var wait_chunk_limit = dv_find(actor.policy, "wait_chunk_limit", 180)
        if dv_has_key(actor.policy, "chapter2_profile"):
            let daytime_wait_limit = dv_find(actor.policy, "daytime_wait_chunk_limit", wait_chunk_limit)
            var day_minute = actor.mind.time
            while day_minute >= 1440:
                day_minute = day_minute - 1440
            if day_minute >= 480 and day_minute < 1260:
                wait_chunk_limit = dv_min(wait_chunk_limit, daytime_wait_limit)
            if dv_has_key(actor.policy, "daytime_wait_chunk_limit") and day_minute < 480:
                wait_chunk_limit = dv_min(wait_chunk_limit, 480 - day_minute)
        if actor.mind.time < 900 and dv_has(["detective", "huo", "shen", "su", "quer", "ward", "gu", "lucian"], actor.id) and dv_truth(actor.mind, c1_at(actor.id, "living_hall")) == "true":
            wait_chunk_limit = 60
            if actor.mind.time >= 810 and actor.mind.time < 900:
                wait_chunk_limit = 30
        while i < rt_count(durations):
            if minutes == 0 and durations[i] >= 1 and durations[i] <= wait_chunk_limit and actor.mind.time + durations[i] <= target:
                minutes = durations[i]
            i = i + 1
        // Use only existing costed lengths and stop at the next owned boundary.
        // In particular, a nearby window must not be crossed by a fifteen-minute floor.
        if 0 < minutes:
            let id = c1n_wait_id(actor.id, minutes)
            let known = dv_true()
            let result = dv_at_least(c1n_wait_ref(actor.id), elapsed.value + minutes)
            let text = rt_cat(rt_cat("留在原处，等候本人已知的下一次作息机会（", rt_show(minutes)), "分钟）。")
            let action = c2_action(id, c1n_wait_kind(minutes), known, dv_true(), id, [c1n_wait_ref(actor.id), c1_other_clock_ref()], text, c1n_source("own-bounded-wait"))
            rt_push(actions, c1_public_method(dv_with_many(action, {"predict_law": id, "repeatable": true, "known_opportunity_wait": true, "wait_until": target, "wait_basis": basis})))
            // Engineering preference: knowingly spend this time for the next
            // personally declared opportunity. Reimburse its ordinary time score
            // and retain only .01 net utility; other actions compete unchanged.
            let net_utility = 0.01
            let wait_value = (minutes * time_cost + net_utility) / progress_weight
            rt_push(goals, dv_with_many(c2_goal(result, known, basis), {"weight": wait_value, "known_opportunity_wait": true, "wait_valuation": {"role": "engineering-personal-willingness-to-wait", "time_opportunity_cost": minutes * time_cost, "net_utility": net_utility, "progress_weight": progress_weight, "future_outcome": "unknown"}}))
    var policy = dv_with(actor.policy, "goals", goals)
    if actor.mind.time < 1440 and dv_has(["detective", "huo", "shen", "su", "quer", "ward", "gu", "lucian"], actor.id) and dv_truth(actor.mind, c1_at(actor.id, "living_hall")) == "true":
        if not dv_has_key(policy, "first_night_plan_depth"):
            policy = dv_with(policy, "first_night_plan_depth", dv_find(policy, "plan_depth", 2))
        policy = dv_with_many(policy, {"plan_depth": 1, "first_night_plan_active": true})
    else:
        if dv_find(policy, "first_night_plan_active", false):
            policy = dv_with_many(policy, {"plan_depth": policy.first_night_plan_depth, "first_night_plan_active": false})
    return dv_with_many(actor, {"actions": actions, "policy": policy})

// Only positive lower bounds in the actor's declared goal conditions qualify.
// A negated bound denotes an upper limit, so its subtree is deliberately opaque.
fn c1n_positive_clock_bounds(condition):
    var result = []
    let op = dv_find(condition, "op", "")
    if op == "at_least":
        if dv_same(condition.ref, c1_other_clock_ref()):
            rt_push(result, condition.value)
    if op == "all":
        let items = dv_find(condition, "items", [])
        var i = 0
        while i < rt_count(items):
            let nested = c1n_positive_clock_bounds(items[i])
            var j = 0
            while j < rt_count(nested):
                rt_push(result, nested[j])
                j = j + 1
            i = i + 1
    return result

// Both opening and closing thresholds bound a wait. This reads declared syntax,
// not future world state; the caller still checks ownership and nonclock readiness.
fn c1n_clock_boundaries(condition):
    let key = ["c1n_clock_boundaries"]
    let cached = rt_memo_get(condition, key)
    if cached[0]:
        return cached[1]
    return rt_memo_put(condition, key, c1n_clock_boundaries_uncached(condition))

fn c1n_clock_boundaries_uncached(condition):
    if dv_find(condition, "op", "") == "not":
        return c1n_clock_boundaries(condition.item)
    var result = c1n_positive_clock_bounds(condition)
    if dv_find(condition, "op", "") == "all":
        var i = 0
        while i < rt_count(condition.items):
            let nested = c1n_clock_boundaries(condition.items[i])
            var j = 0
            while j < rt_count(nested):
                if not dv_has(result, nested[j]):
                    rt_push(result, nested[j])
                j = j + 1
            i = i + 1
    return result

// Time alone may open a known opportunity. All remaining conditions must
// already hold in the owner's mind, including being at its execution site.
fn c1n_without_clock(condition):
    let key = ["c1n_without_clock"]
    let cached = rt_memo_get(condition, key)
    if cached[0]:
        return cached[1]
    return rt_memo_put(condition, key, c1n_without_clock_uncached(condition))

fn c1n_without_clock_uncached(condition):
    let op = dv_find(condition, "op", "")
    if dv_record_like(condition) and dv_has_key(condition, "ref") and dv_find(condition.ref, "object", "") == "c2.weather":
        return dv_true()
    if op == "at_least" and dv_same(condition.ref, c1_other_clock_ref()):
        return dv_true()
    if op == "not":
        let inner = dv_find(condition, "item", false)
        if inner != false and dv_record_like(inner) and dv_has_key(inner, "ref") and dv_find(inner.ref, "object", "") == "c2.weather":
            return dv_true()
        if inner != false and dv_find(inner, "op", "") == "at_least" and dv_same(inner.ref, c1_other_clock_ref()):
            return dv_true()
    if op == "all":
        var items = []
        var i = 0
        while i < rt_count(condition.items):
            rt_push(items, c1n_without_clock(condition.items[i]))
            i = i + 1
        return dv_all(items)
    return condition

fn c1n_future_goal_pending(actor, goal):
    let kind = dv_find(goal, "kind", "")
    if kind == "achieve":
        return dv_truth(actor.mind, goal.proposition) != "true"
    if kind == "communicate":
        return not dv_has(dv_find(actor, "completed_actions", []), dv_find(goal, "method_id", ""))
    if kind == "know" or kind == "evidence":
        return not dv_uncontested(dv_read(actor.mind, goal.ref))
    return false

// Static syntax metadata is built with the goal, never from physical future state.
fn c1n_index_goal_window(goal):
    let condition = dv_find(goal, "available_when", dv_true())
    let key = ["c1n_goal_window"]
    let cached = rt_memo_get(condition, key)
    var window = []
    if cached[0]:
        window = cached[1]
    else:
        window = rt_memo_put(condition, key, {"future_clock_condition": condition, "future_clock_bounds": c1n_positive_clock_bounds(condition), "future_nonclock": c1n_without_clock(condition)})
    return dv_with_many(goal, window)

fn c1n_known_future_wait_actor(actor):
    if actor.id == "demon" and not dv_has_key(actor.policy, "chapter2_profile"):
        return actor
    var target = -1
    var basis = []
    let goals = dv_find(actor.policy, "goals", [])
    var i = 0
    while i < rt_count(goals):
        let goal = goals[i]
        let own_basis = dv_find(goal, "basis", [])
        if not dv_find(goal, "known_opportunity_wait", false) and 0 < rt_count(own_basis):
            var indexed = goal
            if not dv_has_key(goal, "future_clock_bounds") or not dv_same(dv_find(goal, "future_clock_condition", false), dv_find(goal, "available_when", dv_true())):
                indexed = c1n_index_goal_window(goal)
            let bounds = indexed.future_clock_bounds
            var candidate = -1
            var j = 0
            while j < rt_count(bounds):
                if actor.mind.time < bounds[j] and (candidate < 0 or bounds[j] < candidate):
                    candidate = bounds[j]
                j = j + 1
            if candidate >= 0 and (target < 0 or candidate < target) and c1n_future_goal_pending(actor, goal) and dv_truth(actor.mind, indexed.future_nonclock) == "true":
                target = candidate
                basis = dv_append(own_basis, {"kind": "own-declared-future-opportunity", "condition": goal.available_when, "scope": "time-opportunity-only-not-future-success"})
        i = i + 1
    if 0 <= target:
        // Reconsider at an earlier boundary of another pending, personally known
        // opportunity, including the end of one that is already open.
        i = 0
        while i < rt_count(goals):
            let goal = goals[i]
            let own_basis = dv_find(goal, "basis", [])
            if not dv_find(goal, "known_opportunity_wait", false) and 0 < rt_count(own_basis) and c1n_future_goal_pending(actor, goal):
                let condition = dv_find(goal, "available_when", dv_true())
                if dv_truth(actor.mind, c1n_without_clock(condition)) == "true":
                    let boundaries = c1n_clock_boundaries(condition)
                    var j = 0
                    while j < rt_count(boundaries):
                        if actor.mind.time < boundaries[j] and boundaries[j] < target:
                            target = boundaries[j]
                            basis = dv_append(own_basis, {"kind": "own-declared-opportunity-boundary", "condition": condition, "scope": "reconsideration-only-not-future-success"})
                        j = j + 1
            i = i + 1
        return c1n_known_wait_actor(actor, target, basis)
    // Also removes a previous waiting candidate when its opportunity is no longer future.
    return c1n_known_wait_actor(actor, actor.mind.time, [])

fn c1n_call_ref(actor):
    return dv_ref(rt_cat("night.call.", actor), "state", "heard")

axiom c1n_call_law(actor):
    return dv_axiom("c1n_call_law", 1, dv_all([c1_at(actor, "living_hall"), c2_window(1, 1440, 1800), dv_fact(c1n_night_seen_ref(actor), true), dv_fact(c1n_call_ref(actor), false)]), [dv_assign(c1n_call_ref(actor), true)])

fn c1n_night_seen_ref(actor):
    return dv_ref(rt_cat("night.call.", actor), "state", "night_observed")

axiom c1n_night_seen_law(actor):
    return dv_axiom("c1n_night_seen_law", 1, dv_all([c1_at(actor, "living_hall"), c2_window(1, 1440, 1800)]), [dv_assign(c1n_night_seen_ref(actor), true)])

// Content-owned configuration. Callers supply approved numeric budgets and value lists.
fn Standard_Detective(replay_depth, resistance, empirical_values, mediation_rules, basis):
    dv_require(0 < rt_count(basis), "Detective profile needs content provenance")
    return {"cognitive_profile": "Standard_Detective", "Replay_Depth": replay_depth, "plan_depth": 6, "Implicature_Resistance": resistance, "scope_reference_check": true, "value_order": empirical_values, "value_basis": basis, "norm_rules": mediation_rules, "class_bias": [], "profile_basis": basis}

fn Foolish_Detective(replay_depth, resistance, values, norm_rules, class_bias, basis):
    dv_require(0 < rt_count(basis), "Detective profile needs content provenance")
    return {"cognitive_profile": "Foolish_Detective", "Replay_Depth": replay_depth, "plan_depth": 2, "Implicature_Resistance": resistance, "scope_reference_check": false, "value_order": values, "value_basis": basis, "norm_rules": norm_rules, "class_bias": class_bias, "profile_basis": basis}

fn cognitive_sample(key, options, basis):
    dv_require(0 < rt_count(options) and 0 < rt_count(basis), "Cognitive sampling needs options and provenance")
    return {"key": key, "options": options, "basis": basis}

fn cognitive_initialization(profile, samples, basis):
    return {"profile": profile, "samples": samples, "basis": basis}

// Narrow engineering initial ranges, not narrative facts or acceptance targets.
fn c1c_install_scene(scene, seed, profile):
    dv_require(profile == "Standard_Detective" or profile == "Foolish_Detective", "Unknown detective cognitive profile")
    let basis = [{"path": "user:current-request", "line": 0, "id": "declared-engineering-cognitive-initial-ranges"}]
    var actors = []
    var i = 0
    while i < rt_count(scene.actors):
        var actor = scene.actors[i]
        if actor.id != "demon":
            var low_trust = []
            var middle_trust = []
            var high_trust = []
            var j = 0
            while j < rt_count(scene.actors):
                let peer = scene.actors[j].id
                let current = dv_find(dv_find(actor.policy, "speaker_trust", []), peer, 0.5)
                low_trust = dv_with(low_trust, peer, dv_max(0, current - 0.05))
                middle_trust = dv_with(middle_trust, peer, current)
                high_trust = dv_with(high_trust, peer, dv_min(1, current + 0.05))
                j = j + 1
            let old = actor.policy
            let drive = dv_find(old, "drive", 1)
            let caution = dv_find(old, "caution", 0.5)
            let information = dv_find(old, "information_weight", 1)
            var samples = [cognitive_sample("drive", [dv_max(0, drive - 0.1), drive, drive + 0.1], basis), cognitive_sample("caution", [dv_max(0, caution - 0.05), caution, caution + 0.05], basis), cognitive_sample("speaker_trust", [low_trust, middle_trust, high_trust], basis), cognitive_sample("information_weight", [information * 0.95, information, information * 1.05], basis), cognitive_sample("implicature_threshold", [0.45, 0.5, 0.55], basis)]
            samples = dv_append(samples, cognitive_sample("resonance_relevance", [0.9, 1, 1.1], basis))
            samples = dv_append(samples, cognitive_sample("truth_bonus", [0.05, 0.1, 0.15], basis))
            // This is a subjective risk prior, never an observation of all actual costs.
            samples = dv_append(samples, cognitive_sample("perceived_risk", [0.45, 0.5, 0.55], basis))
            var selected_profile = []
            if actor.id == "detective":
                let norms = dv_find(old, "norm_rules", [])
                if profile == "Standard_Detective":
                    selected_profile = Standard_Detective(64, 0.75, ["understand_cost", "solve_case", "evidence", "safety", "night_exception", "records", "measured_work", "clarify_terms", "seek_advice", "avoid_attachment"], norms, basis)
                else:
                    selected_profile = Foolish_Detective(2, 0.25, ["pursue_desire", "avoid_attachment", "solve_case", "understand_cost"], [], dv_find(old, "class_bias", []), basis)
            if actor.id == "detective":
                let threshold = selected_profile.Implicature_Resistance
                samples = dv_append(samples, cognitive_sample("implicature_threshold", [dv_max(0, threshold - 0.05), threshold, dv_min(1, threshold + 0.05)], basis))
            actor = dv_with(actor, "cognitive_initialization", cognitive_initialization(selected_profile, samples, basis))
        rt_push(actors, actor)
        i = i + 1
    return dv_with_many(scene, {"actors": actors, "opening_seed": seed, "detective_profile": profile})

fn cognitive_erosion(exposure_ref, thresholds, coupling_factor, basis):
    dv_require(0 < rt_count(basis), "Erosion needs declared provenance")
    return {"physical_ref": exposure_ref, "thresholds": thresholds, "coupling_factor": coupling_factor, "basis": basis}

// Native chapter-two content. No scheduled loss, illness, death, adoption or answer.
// Install into a committed chapter-one handoff; retain every existing mind and world object.
// Missing environment/physiology inputs remain unknown, never replaced by authored outcomes.

fn c2_source(file, line, id):
    return c1_source(rt_cat("godot_csharp/scenes/Awakening/Script/story/续篇/", file), line, id)

fn c2_approved(id):
    return c1_source("docs/design-standard.md", 0, id)

fn c2_ref(object, field):
    return dv_ref(object, "state", field)

fn c2_body(actor):
    return rt_cat("c2.person.", actor)

fn c2_own(actor, field):
    return c2_ref(c2_body(actor), field)

fn c2_clock():
    return dv_ref("campaign.clock", "state", "minute")

fn c2_access(gate):
    return dv_ref("campaign.access", "state", gate)

fn c2_position_ref(actor):
    return dv_ref(actor, "state", "location")

fn c2_at(actor, room):
    return dv_fact(c2_position_ref(actor), room)

fn c2_window(day, start, end):
    let origin = (day - 1) * 1440
    return dv_all(dv_pair(dv_at_least(c2_clock(), origin + start), dv_not(dv_at_least(c2_clock(), origin + end))))

fn c2_night(day):
    return c2_window(day, 1260, 1800)

fn c2_any_night():
    return c1_any(c2_night(1), c1_any(c2_night(2), c1_any(c2_night(3), c1_any(c2_night(4), c2_night(5)))))

fn c2_people():
    return ["detective", "huo", "shen", "su", "lucian", "gu", "quer", "ward", "selma", "ruan", "elena", "moran", "veronica", "bertrand", "margaret", "mora"]

fn c2_person_source(actor):
    let rows = [["detective", "01_侦探.story", 11], ["huo", "02_霍铎.story", 48], ["shen", "03_沈鼎.story", 45], ["su", "04_苏泠.story", 43], ["lucian", "05_卢西安.story", 25], ["gu", "06_顾平章.story", 25], ["quer", "07_雀儿.story", 27], ["ward", "08_沃德.story", 24], ["selma", "09_赛尔玛.story", 25], ["ruan", "10_阮清越.story", 24], ["elena", "11_伊莲娜.story", 24], ["moran", "12_莫兰.story", 23], ["veronica", "13_维罗妮卡.story", 25], ["bertrand", "14_贝尔特朗.story", 26], ["margaret", "15_玛格丽特.story", 27], ["mora", "16_茉拉.story", 26]]
    var i = 0
    while i < rt_count(rows):
        if rows[i][0] == actor:
            return c1_source(rt_cat("godot_csharp/scenes/Awakening/Script/story/生态/人物/", rows[i][1]), rows[i][2], rt_cat(actor, ".personal-values"))
        i = i + 1
    return c2_approved("unknown-person-profile-needs-source")

fn c2_profile(actor):
    var group = "living"
    var domain = "investigation"
    var roles = []
    var values = ["evidence", "safety", "patient_priority", "records"]
    if dv_has(["quer", "ward", "gu", "lucian"], actor):
        group = "contract"
    if dv_has(["selma", "ruan", "elena", "moran"], actor):
        group = "astral"
    if dv_has(["veronica", "bertrand", "margaret", "mora"], actor):
        group = "logistics"
    if dv_has(["mora", "shen", "ruan"], actor):
        domain = "resources"
    if dv_has(["selma", "veronica", "gu", "lucian"], actor):
        domain = "research"
    if dv_has(["bertrand", "margaret", "huo"], actor):
        domain = "safety"
    if actor == "huo":
        roles = ["weight"]
        values = ["measured_work", "records", "central_cooking", "evidence", "safety"]
    if actor == "quer":
        roles = ["lock"]
        values = ["not_targeted", "evidence", "movement_freedom", "night_exception", "measured_work"]
    if actor == "su":
        roles = ["relay"]
        values = ["measured_work", "signal", "evidence"]
    if actor == "bertrand":
        roles = ["weight"]
        values = ["patient_priority", "records", "safety"]
    if actor == "margaret":
        roles = ["weight"]
        values = ["evidence", "central_cooking", "records", "safety"]
    if actor == "mora":
        values = ["patient_priority", "cautious_travel", "evidence", "night_exception"]
    if actor == "shen":
        values = ["central_cooking", "patient_priority", "per_person", "not_targeted", "cautious_travel"]
    if actor == "ruan":
        values = ["records", "per_person", "committee", "witnesses", "evidence"]
    if actor == "ward":
        values = ["committee", "records", "ward_authority", "restriction", "no_exception", "witnesses", "evidence"]
    if actor == "gu":
        values = ["cautious_travel", "tradition", "records", "evidence", "contract"]
    if actor == "lucian":
        values = ["not_targeted", "evidence", "movement_freedom", "patient_priority", "contract", "records"]
    if actor == "selma":
        values = ["patient_priority", "evidence", "research"]
    if actor == "veronica":
        values = ["evidence", "records", "committee", "research"]
    if actor == "elena":
        values = ["tradition", "evidence", "contract", "safety", "cautious_travel"]
    if actor == "moran":
        values = ["measured_work", "research"]
    return {"id": actor, "group": group, "domain": domain, "station_roles": roles, "value_order": values, "basis": [c2_person_source(actor), c2_approved("chapter-two-role-groups")]}

fn c2_edges():
