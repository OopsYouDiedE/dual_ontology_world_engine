fn c1_active_configuration(data):
    return dv_with(dv_with(dv_with(dv_with(dv_with(data, "report_labels", c1_report_labels()), "game_duration_budget", 360), "capability_actor", "detective"), "binding_gaps", c1_binding_gaps()), "budget_scope", "Per-actor action cap240 across inherited campaign state; campaign max_actions is the sum of actor caps; reason/model/plan budgets and action costs are separate")

fn dvs_scenario_base():
    return c1_active_configuration(c1_hist_install_scene(c1_scenario_native()))

fn c1_question_text(stage):
    if (stage == "prompt"):
        return "门是谁闩上的？"
    else:
        if (stage == "voice_source"):
            return "苏泠听见的呼喊来自哪里？"
        else:
            if (stage == "words"):
                return "原话是什么？"
            else:
                return "既听同伴说门外有人，为何仍闩门？"

fn c1_person_policy(id):
    let policy = c1_base_person_policy(id)
    var bindings = policy.topic_bindings
    let stages = ["identity", "voice_source", "words", "trust"]
    var i = 0
    while (i < rt_count(stages)):
        let stage = stages[i]
        rt_push(bindings, {"topic": stage, "heard_when": dv_fact(dv_ref("question", "state", rt_cat("open_", stage)), true), "completed_when": dv_not(dv_true()), "basis": [c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/07_答辩.story", 3, "answer_open.002")]})
        i = i + 1
    var updated = dv_with(policy, "topic_bindings", bindings)
    var palm_goals = dv_find(updated, "goals", [])
    rt_push(palm_goals, {"kind": "achieve", "proposition": c1_at(id, "R05"), "available_when": dv_fact(c1_palm_invitation_ref(), true), "basis": [c1_source("user", 0, "实际听闻邀请后可自行走到书架旁比对")]})
    if id == "detective":
        rt_push(palm_goals, {"kind": "know", "ref": c1_knowledge("hand_not_mine"), "available_when": c1_statement("shelf_old"), "basis": [c1_source("user", 0, "亲见书架手印后本人需要真实掌宽比对")]})
        let rooms = ["hall", "pantry", "foyer", "corridor", "R05", "R06", "R07", "R08"]
        var invitation_room = 0
        while invitation_room < rt_count(rooms):
            rt_push(palm_goals, {"kind": "communicate", "method_id": rt_cat("detective.invite-palms.", rooms[invitation_room]), "available_when": c1_statement("shelf_old"), "basis": [c1_source("user", 0, "亲见书架后请同伴一同比对")]})
            invitation_room = invitation_room + 1
    updated = dv_with(updated, "goals", palm_goals)
    if id != "detective":
        var goals = dv_find(updated, "goals", [])
        rt_push(goals, {"kind": "know", "ref": c1_deep_resonance_ref(id), "available_when": c1_statement(c1_deep_resonance_site(id).evidence), "basis": c1_op_desire(id).basis})
        let keys = ["voice-source", "original-words", "familiarity"]
        var key_index = 0
        while key_index < rt_count(keys):
            rt_push(goals, {"kind": "communicate", "method_id": rt_cat(rt_cat(id, ".respond-defense-conflict."), keys[key_index]), "available_when": c1_at(id, "hall"), "basis": c1_op_desire(id).basis})
            key_index = key_index + 1
        updated = dv_with(updated, "goals", goals)
    return updated


// These actions publish evidence only after successful execution at the site.
fn c1_evidence_contact_ref(actor, evidence):
    return dv_ref("ritual", "state", rt_cat(rt_cat("compared.", actor), rt_cat(".", evidence)))

fn c1_evidence_contact_premise(actor, evidence):
    if evidence == "E2":
        return c1_at(actor, "foyer")
    return dv_all([c1_at(actor, "R05"), c1_at("detective", "R05"), c1_at("huo", "R05"), c1_at("shen", "R05"), c1_at("su", "R05")])

axiom c1_evidence_contact(actor, evidence):
    return dv_axiom("c1_evidence_contact", 1, c1_evidence_contact_premise(actor, evidence), [dv_assign(c1_evidence_contact_ref(actor, evidence), true)])

fn c1_evidence_contact_methods(world, actor, mode):
    var result = world
    let evidence = ["E2", "E11"]
    var i = 0
    while i < rt_count(evidence):
        let name = rt_cat(rt_cat(actor, ".compare."), evidence[i])
        result = dv_adopt(result, c1_method(name, c1_evidence_contact(actor, evidence[i])), mode, 1, [c1_source("user", 0, "现场比对；成功Complete后形成证据")])
        i = i + 1
    if actor == "detective":
        let rooms = ["hall", "pantry", "foyer", "corridor", "R05", "R06", "R07", "R08"]
        var invitation_room = 0
        while invitation_room < rt_count(rooms):
            result = dv_adopt(result, c1_method(rt_cat("detective.invite-palms.", rooms[invitation_room]), c1_palm_invitation_law(rooms[invitation_room])), mode, 1, [c1_source("user", 0, "亲见手印后实际邀请同行比对")])
            invitation_room = invitation_room + 1
    if actor != "detective":
        result = dv_adopt(result, c1_method(rt_cat(actor, ".deep-resonance"), c1_deep_resonance_law(actor)), mode, 1, [c1_deep_resonance_source(actor)])
    return result

fn c1_compare_wedge_action(actor):
    let name = rt_cat(actor, ".compare.E2")
    var action = c1_once(c1_action(name, "move", c1_at(actor, "foyer"), c1_at(actor, "foyer"), name, [c1_evidence_contact_ref(actor, "E2"), c1_knowledge("ash_wedge")], c1_source("user", 0, "E2厚度、擦痕和灰扇现场比对")))
    return dv_with_many(action, {"predict_law": name, "travel": {"from": "foyer", "to": "foyer", "station": "site:E2"}, "surface": "把木楔的厚度贴着门底擦痕比过，再对照门缝向内散开的灰扇。木楔曾撑起门缝，烟灰从门缝进入。", "sensory_mode": "executed-physical-comparison"})

fn c1_compare_palms_action(actor):
    let name = rt_cat(actor, ".compare.E11")
    let premise = c1_evidence_contact_premise(actor, "E11")
    var action = c1_once(c1_action(name, "move", premise, premise, name, [c1_evidence_contact_ref(actor, "E11"), c1_knowledge("hand_not_mine")], c1_source("user", 0, "E11四人在场逐一比对掌宽")))
    return dv_with_many(action, {"predict_law": name, "travel": {"from": "R05", "to": "R05", "station": "site:E11"}, "surface": "四个人都在书架旁，依次将手掌靠近灰上的半枚手印，比过掌宽。侦探、霍铎、沈鼎、苏泠，都与它不合。", "sensory_mode": "executed-four-person-palm-comparison"})


fn c1_deep_resonance_site(actor):
    if actor == "huo":
        return {"room": "hall", "station": "site:E7", "evidence": "slate_marks"}
    if actor == "shen":
        return {"room": "pantry", "station": "site:E10", "evidence": "starter_layers"}
    return {"room": "R08", "station": "site:E6", "evidence": "score_partial"}

fn c1_deep_resonance_source(actor):
    return c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/04_低语与回想.story", 1, rt_cat("recall_", actor))

fn c1_deep_resonance_ref(actor):
    return dv_ref("ritual", "state", rt_cat("deep-retrieved.", actor))

axiom c1_deep_resonance_law(actor):
    return dv_axiom("c1_deep_resonance_law", 1, c1_at(actor, c1_deep_resonance_site(actor).room), [dv_assign(c1_deep_resonance_ref(actor), true)])

fn c1_deep_resonance_action(actor):
    let site = c1_deep_resonance_site(actor)
    let source = c1_deep_resonance_source(actor)
    var grants = [c1_deep_resonance_ref(actor)]
    var surface = "苏泠闭上眼，沿着乐谱里缺失的声音继续追索。门边有人喊开门；她想让那人进来。她睁开眼，脸色发白。"
    if actor == "huo":
        rt_push(grants, c1_knowledge("recalled_copper"))
        surface = "粉笔灰沾了霍铎一手。他没有松开石板，继续追索那声音：铜口里很清楚，‘等我下一次通知。’他叫我守铜口。……他再也没有来。"
    if actor == "shen":
        rt_push(grants, c1_knowledge("recalled_names"))
        surface = "沈鼎的拇指沿着罐壁上一层层干面痕继续摸索。阿泠的茶不放糖，老霍的放两勺，那位清茶不放奶。阿泠……这称呼怎么脱口就来了。"
    let prerequisite = dv_all([c1_at(actor, site.room), c1_statement(site.evidence)])
    var action = c1_once(c1_action(rt_cat(actor, ".deep-resonance"), "move", prerequisite, c1_at(actor, site.room), rt_cat(actor, ".deep-resonance"), grants, source))
    var requires = c1_statement(site.evidence)
    if actor == "huo":
        requires = dv_all([requires, c1_op_property("opening.facilities", "drawing_exists", true)])
    return dv_with_many(action, {"predict_law": rt_cat(actor, ".deep-resonance"), "travel": {"from": site.room, "to": site.room, "station": site.station}, "received_speech_requirement": {"speaker": "demon", "action_id": "demon.opening.desire-offer", "receipt_kind": "actual-listener-parse"}, "desire_requirement": {"subject": actor, "desire_id": c1_op_desire(actor).id, "basis": c1_op_desire(actor).basis}, "resonance": {"basis": [source], "requires": requires, "drive": {"policy_key": "drive"}, "relevance": {"policy_key": "resonance_relevance"}, "truth_bonus": {"policy_key": "truth_bonus"}, "caution": {"policy_key": "caution"}, "perceived_risk": {"policy_key": "perceived_risk"}, "retrieved_when": dv_fact(c1_deep_resonance_ref(actor), true), "coupling": 1, "night_call": true, "night_when": dv_fact(c1_deep_resonance_ref(actor), true)}, "surface": surface, "sensory_mode": "active-deep-resonance"})


fn c1_public_answer_speech(action):
    if action.answer_id == "me" or action.answer_id == "trust":
        var surface = "是我闩的门。"
        if action.answer_id == "trust":
            surface = "我因早已相熟而信霍铎。"
        return dv_with_many(action, {"speech": dv_with(c1_speech(action.answer, surface, "actual-public-defense"), "surface", surface), "listeners": ["demon", "huo", "shen", "su"]})
    if action.answer_id == "V5_0" or action.answer_id == "V5_1" or action.answer_id == "V5_2":
        var surface = "我决定先听霍铎的。"
        if action.answer_id == "V5_1":
            surface = "我决定先听苏泠的。"
        if action.answer_id == "V5_2":
            surface = "我决定暂不听从任何一方。"
        return dv_with_many(action, {"speech": dv_with(c1_speech(action.answer, surface, "actual-public-defense"), "surface", surface), "listeners": ["demon", "huo", "shen", "su"]})
    let pairs = [["V3_0", "V3_1", "voice-source", "声音来自铜口，经管道传来。", "声音就在门外。"], ["V4_0", "V4_1", "original-words", "原话是闩门禁开。", "原话是开门救人。"], ["V6_1", "V6_0", "familiarity", "我们原本相熟。", "我们原本不相熟。"]]
    var i = 0
    while i < rt_count(pairs):
        let pair = pairs[i]
        if action.answer_id == pair[0] or action.answer_id == pair[1]:
            var opposite = pair[0]
            var surface = pair[4]
            if action.answer_id == pair[0]:
                opposite = pair[1]
                surface = pair[3]
            let speech = dv_with_many(c1_speech(action.answer, surface, "actual-public-defense"), {"surface": surface, "public_claim": {"key": pair[2], "value": action.answer_id, "conflicts_with": [opposite], "basis": action.source_refs}})
            return dv_with_many(action, {"speech": speech, "listeners": ["demon", "huo", "shen", "su"]})
        i = i + 1
    return action

fn c1_answer_conflict_response(actor, key):
    var surface = "你刚才的答辩和现在说的互相矛盾。我不能只因你说得笃定就跟着你。"
    if actor == "su":
        surface = "你刚才明明那样说，现在又换了说法。别把我们当作可以随你推论摆弄的人。那是同伴的呼喊，也是人的性命。"
    if actor == "huo":
        surface = "你前后的答辩对不上。哪一处证物让你改了判断？我要看根据。"
    if actor == "shen":
        surface = "你前后说得不一样。我得先弄清你改口的根据，才敢让身边的人跟着做。"
    var action = c1_once(c1_action(rt_cat(rt_cat(actor, ".respond-defense-conflict."), key), "talk", c1_at(actor, "hall"), c1_at(actor, "hall"), "", [], c1_source("user", 0, "实际前后矛盾答辩引起的道德谴责与疑虑")))
    return dv_with_many(action, {"received_claim_conflict": {"speaker": "detective", "key": key}, "speech": dv_with(c1_speech(dv_true(), surface, "own-moral-appraisal-of-actually-heard-defense"), "surface", surface), "listeners": ["detective", "huo", "shen", "su"], "personal_purpose": {"subject": actor, "id": "question-contradictory-defense", "basis": c1_op_desire(actor).basis}})


fn c1_palm_invitation_ref():
