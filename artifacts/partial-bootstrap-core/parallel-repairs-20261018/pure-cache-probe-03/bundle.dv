            return dv_with_many(result, {"world": local_1, "remaining": (remaining - 1), "expanded": 1})

fn dvs_sim_gated_response(actor, world, step, time, remaining, confidence):
    var gate = dv_find(step, "available_when", dv_true())
    var truth = dv_truth(world, dv_find(step, "available_when", dv_true()))
    var result = false
