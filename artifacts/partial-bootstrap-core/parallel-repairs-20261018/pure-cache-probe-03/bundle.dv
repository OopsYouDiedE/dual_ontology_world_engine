fn c1_hist_adopt_routes(mind):
    var result = mind
    var routes = [["past.detective", "R05", "corridor", "seek-instruction"], ["past.detective", "corridor", "hall", "seek-instruction"], ["past.detective", "hall", "foyer", "visit-door"], ["past.detective", "foyer", "hall", "return-report"], ["past.su", "R08", "corridor", "open-and-listen"], ["past.su", "corridor", "hall", "open-and-listen"], ["past.su", "hall", "foyer", "open-and-listen"], ["past.su", "foyer", "hall", "write-score"], ["past.su", "hall", "corridor", "write-score"], ["past.su", "corridor", "R08", "write-score"], ["past.shen", "pantry", "hall", "place-wet-cloth"], ["past.shen", "hall", "foyer", "place-wet-cloth"]]
    var index = 0
    while (index < rt_count(routes)):
        var route = routes[index]
        result = c1_hist_add_travel(result, route[0], route[1], route[2], route[3])
        index = (index + 1)
    return result

fn c1_hist_add_variant_laws(mind):
    var result = mind
    var listeners = dv_pair("past.su", "past.huo")
    var preferences = dv_list3("huo", "su", "self")
    var index = 0
    while (index < 2):
        var listener = listeners[index]
        result = c1_hist_adopt(result, rt_cat("history.tail-belief.", listener), c1_hist_open_interpretation("history", listener))
        result = c1_hist_adopt(result, rt_cat("history.open-belief.", listener), c1_hist_open_full_interpretation("history", listener))
        result = c1_hist_adopt(result, rt_cat("history.open-door.", listener), c1_hist_open_door("history", listener, "cognition"))
        index = (index + 1)
    index = 0
    while (index < 3):
        var preference = preferences[index]
        var local_1 = false
        if (preference == "huo"):
            local_1 = 4
        else:
            local_1 = 3
        var local_2 = false
        if (preference == "su"):
            local_2 = 4
        else:
            local_2 = 3
        result = c1_hist_adopt(result, rt_cat("history.relations.", preference), c1_hist_familiar_relations("history", preference, local_1, local_2))
        index = (index + 1)
    result = c1_hist_adopt(result, "history.layout", c1_hist_layout_known("cognition", "history"))
    result = c1_hist_adopt(result, "history.slate.BoltKeepShut", c1_hist_instruction_record("history", "cognition", "BoltKeepShut"))
    result = c1_hist_adopt(result, "history.slate.OpenSaveMe", c1_hist_instruction_record("history", "cognition", "OpenSaveMe"))
    result = c1_hist_adopt(result, "history.footprint", c1_hist_footprint("history", "cognition", "PoloBoot", "Bolt", "predicted_boots_bolt"))
    result = c1_hist_adopt(result, "history.argument.source.Tube", c1_hist_argument_source("history", "cognition", "Tube", "stressed-tail-without-leading-qualification"))
    result = c1_hist_adopt(result, "history.argument.source.OutsideDoor", c1_hist_argument_source("history", "cognition", "OutsideDoor", "muffled-full-speech"))
    result = c1_hist_adopt(result, "history.argument.heard.both", c1_hist_heard_argument("history", "cognition", true, "Huo-relay-and-Su-report"))
    result = c1_hist_adopt(result, "history.argument.heard.relay", c1_hist_heard_argument("history", "cognition", false, "Huo-relay-only"))
    return result

fn c1_hist_hearing_ids(source, words):
    var result = []
    var listeners = dv_pair("past.su", "past.huo")
    var rooms = ["hall", "R08", "foyer", "pantry", "R05", "R06"]
    var i = 0
    var j = 0
    while (i < 2):
        j = 0
        while (j < 6):
            rt_push(result, c1_hist_acoustic_id(source, words, listeners[i], rooms[j]))
            j = (j + 1)
        i = (i + 1)
    return result

fn c1_hist_order(stages):
    var result = []
    var used = []
    var count = 0
    while (count < rt_count(stages)):
        var found = false
        var best = 0
        var best_at = 0
        var index = 0
        while (index < rt_count(stages)):
            if dv_has(used, index):
                false
            else:
                var local_1 = false
                if found:
                    local_1 = (stages[index].at < best_at)
                else:
                    local_1 = true
                if local_1:
                    found = true
                    best = index
                    best_at = stages[index].at
            index = (index + 1)
        rt_push(used, best)
        rt_push(result, stages[best])
        count = (count + 1)
    return result

axiom c1_hist_smoke_pantry(history):
    return dv_axiom("c1_hist_smoke_pantry", 1, dv_fact(dv_ref(history, "state", "smoke_entered"), true), dv_single(dv_assign(dv_ref("past.shen", "belief", "smoke"), true)))

fn c1_hist_timeline(su_room, huo_room, source, words, preference):
    var stages = []
    var su_start = 1
    var su_corridor = (1 + (1.2 / 1.3))
    var su_hall = (1 + (3.2 / 1.3))
    var su_foyer = (1 + (5.7 / 1.3))
    rt_push(stages, c1_hist_stage(0, [c1_hist_origin_id(su_room, huo_room), "history.reset", "history.reset.records", "history.layout", "history.wake"]))
    rt_push(stages, c1_hist_stage(1, dv_single(rt_cat("history.voice.", c1_hist_source_id(source, words)))))
    c1_hist_hearing_stages(stages, 1, source, words)
    rt_push(stages, c1_hist_stage(1, ["history.tail-belief.past.su", "history.open-belief.past.su", "history.tail-belief.past.huo", "history.open-belief.past.huo", "history.su.intent", "history.huo.intent", rt_cat("history.slate.", words), "history.huo.guard", "history.open-door.past.huo", rt_cat("history.relations.", preference)]))
    rt_push(stages, c1_hist_stage(1.2, dv_single(c1_hist_travel_id("past.detective", "R05", "corridor", "seek-instruction"))))
    rt_push(stages, c1_hist_stage(2, dv_single("history.smoke.due")))
    c1_hist_hearing_stages(stages, 2.2, source, words)
    rt_push(stages, c1_hist_stage(3.2, dv_list3(c1_hist_travel_id("past.detective", "corridor", "hall", "seek-instruction"), "history.request", "history.visit")))
    if (su_room == "R08"):
        rt_push(stages, c1_hist_stage(su_corridor, dv_single(c1_hist_travel_id("past.su", "R08", "corridor", "open-and-listen"))))
        rt_push(stages, c1_hist_stage(su_hall, dv_single(c1_hist_travel_id("past.su", "corridor", "hall", "open-and-listen"))))
    if (su_room == "hall"):
        su_foyer = (1 + (2.5 / 1.3))
    rt_push(stages, c1_hist_stage(su_foyer, [c1_hist_travel_id("past.su", "hall", "foyer", "open-and-listen"), "history.open-door.past.su", "history.fork", "history.smoke", "history.soot"]))
    rt_push(stages, c1_hist_stage(5.7, dv_list3(c1_hist_travel_id("past.detective", "hall", "foyer", "visit-door"), "history.su.report", "history.smoke")))
    rt_push(stages, dv_with({"at": 5.7, "response": {"model": rt_cat("history.", preference), "request": "competing-reports", "options": dv_list3("accept-huo", "accept-su", "inspect")}, "optional": true}, "available_when", dv_fact(dv_ref("history", "state", "request_received"), true)))
    rt_push(stages, c1_hist_stage(5.7, ["history.latch", "history.close-smoke", "history.footprint", "history.prints", "history.return", "history.su.return", "history.argument.heard.both", "history.argument.heard.relay"]))
    rt_push(stages, c1_hist_stage(8.2, dv_pair(c1_hist_travel_id("past.detective", "foyer", "hall", "return-report"), "history.report")))
    rt_push(stages, c1_hist_stage((5.7 + (2.5 / 1.3)), dv_single(c1_hist_travel_id("past.su", "foyer", "hall", "write-score"))))
    rt_push(stages, c1_hist_stage((5.7 + (4.5 / 1.3)), dv_single(c1_hist_travel_id("past.su", "hall", "corridor", "write-score"))))
    rt_push(stages, c1_hist_stage((5.7 + (5.7 / 1.3)), dv_pair(c1_hist_travel_id("past.su", "corridor", "R08", "write-score"), "history.score")))
    rt_push(stages, c1_hist_stage((5.7 + (5.7 / 1.3)), dv_pair("history.smoke.pantry", "history.shen.intent")))
    rt_push(stages, c1_hist_stage(((5.7 + (5.7 / 1.3)) + (2 / 0.9)), dv_single(c1_hist_travel_id("past.shen", "pantry", "hall", "place-wet-cloth"))))
    rt_push(stages, c1_hist_stage(((5.7 + (5.7 / 1.3)) + (4.5 / 0.9)), dv_list3(c1_hist_travel_id("past.shen", "hall", "foyer", "place-wet-cloth"), "history.cloth.place", "history.cloth")))
    rt_push(stages, c1_hist_stage(160, dv_list3(rt_cat("history.argument.source.", source), "history.argument.heard.both", "history.argument.heard.relay")))
    return c1_hist_order(stages)

fn c1_hist_candidate(number, su_room, huo_room, source, words, preference, familiar):
    var assumptions = c1_hist_assumptions(su_room, huo_room, source, words, preference, familiar)
    rt_push(assumptions, dv_fact(c1_knowledge("own_alarm_anchor"), true))
    rt_push(assumptions, dv_fact(dv_ref("history", "state", "sole"), "PoloBoot"))
    rt_push(assumptions, dv_fact(dv_ref("history", "state", "direction"), "Bolt"))
    return dv_with(dv_with(dv_with(dv_with(dv_with(dv_with(dv_with(dv_with(dv_with({"id": rt_cat("history-case-", rt_show(number)), "question": "original_q2_complete", "group": "six-variable-history", "prior": 0.5}, "proposition", dv_all(c1_hist_assumptions(su_room, huo_room, source, words, preference, familiar))), "basis", dv_pair(c1_source("docs/design-standard.md", 703, "public-six-variable-candidate-space"), c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/声路与真相.story", 102, "fixed-external-event-catalog"))), "available_when", dv_fact(dv_ref("question", "state", "outstanding_complete"), true)), "assumptions", assumptions), "variable_assignments", c1_hist_assignments(su_room, huo_room, source, words, preference, familiar)), "timeline", c1_hist_timeline(su_room, huo_room, source, words, preference)), "start_time", 0), "features", c1_hist_features()), "claim_slots", c1_hist_claim_slots())

fn c1_hist_candidates():
    var result = []
    var domains = c1_hist_domains()
    var a = 0
    var b = 0
    var c = 0
    var d = 0
    var e = 0
    var f = 0
    var number = 0
    while (a < 3):
        b = 0
        while (b < 3):
            c = 0
            while (c < 2):
                d = 0
                while (d < 2):
                    e = 0
                    while (e < 3):
                        f = 0
                        while (f < 2):
                            rt_push(result, c1_hist_candidate(number, domains[0].values[a], domains[1].values[b], domains[2].values[c], domains[3].values[d], domains[4].values[e], domains[5].values[f]))
                            number = (number + 1)
                            f = (f + 1)
                        e = (e + 1)
                    d = (d + 1)
                c = (c + 1)
            b = (b + 1)
        a = (a + 1)
    return result

fn c1_hist_policy(policy):
    var hypotheses = policy.hypotheses
    var candidates = c1_hist_candidates()
    var combined = []
    var index = 0
    while (index < rt_count(hypotheses)):
        rt_push(combined, hypotheses[index])
        index = (index + 1)
    index = 0
    while (index < rt_count(candidates)):
        rt_push(combined, candidates[index])
        index = (index + 1)
    return dv_with(dv_with(dv_with(dv_with(dv_with(policy, "hypotheses", combined), "factor_domains", c1_hist_domains()), "factor_constraints", c1_hist_constraints()), "prune_confidence_limit", 0.85), "abduction", {"active": true, "confidence_cap": 0.85, "basis": dv_single(c1_source("docs/design-standard.md", 1500, "approved-paid-model-best-explanation-not-certainty"))})

fn c1_hist_expected_answer():
    return dv_all(dv_list3(dv_fact(c1_hist_claim_ref("actual_heard"), "Huo-relay-and-Su-report"), dv_fact(c1_hist_claim_ref("voice_source"), "Tube"), dv_fact(c1_hist_claim_ref("transmission_loss"), "stressed-tail-without-leading-qualification")))

fn c1_hist_claim_ref(field):
    return dv_ref("history_claims", "state", field)

fn c1_hist_author_truth():
    return c1_state_object("history_claims", {"actual_heard": dv_with(dv_field("Huo-relay-and-Su-report"), "basis", dv_single(c1_source("docs/design-standard.md", 1509, "original-Q2-author-history"))), "voice_source": dv_with(dv_field("Tube"), "basis", dv_single(c1_source("docs/design-standard.md", 640, "author-event-1-main-building-copper-source"))), "transmission_loss": dv_with(dv_field("stressed-tail-without-leading-qualification"), "basis", dv_single(c1_source("docs/design-standard.md", 718, "transmission-table")))})

fn c1_hist_install_mind(mind):
    var result = c1_hist_adopt_shared(c1_hist_setup(mind))
    result = c1_hist_add_source_laws(result)
    result = c1_hist_adopt_routes(result)
    result = c1_hist_add_variant_laws(result)
    return c1_hist_adopt(result, "history.smoke.pantry", c1_hist_smoke_pantry("history"))

fn c1_hist_share_basis():
    return dv_single(c1_source("docs/design-standard.md", 1500, "approved-estimated-argument-sharing-and-paid-scope-reassessment"))

fn c1_hist_share_action(actor):
    return dv_with(dv_with(dv_with(dv_with(dv_with(dv_with(dv_with(dv_with(c1_action(rt_cat(actor, ".share.original_q2_complete"), "talk", c1_at(actor, "hall"), c1_at(actor, "hall"), "", [], c1_source("docs/design-standard.md", 1500, "approved-actual-argument-sharing")), "speech_from_argument", true), "argument_slots", dv_list3("actual_heard", "voice_source", "transmission_loss")), "argument_question", "original_q2_complete"), "topic", "original_q2_complete"), "listeners", ["detective", "huo", "shen", "su"]), "speech", dv_with(c1_speech(dv_true(), "本人形成的历史解释；估计性、置信度与来源由实际论证生成。", "estimated-history-argument"), "channel", "speech")), "reassessment_source_scope", "awake_self"), "reassessment_scope_refs", dv_single(dv_ref("question", "state", "awake_scope")))

fn c1_hist_share_goal(actor):
    return dv_with({"kind": "communicate", "method_id": rt_cat(actor, ".share.original_q2_complete"), "requires_argument": true, "basis": c1_hist_share_basis()}, "available_when", c1_at(actor, "hall"))

fn c1_hist_proposal_policy(policy):
    return dv_with(dv_with(policy, "proposal_acceptance", dv_with({"enabled": true, "basis": c1_hist_share_basis(), "required_slots": dv_list3("actual_heard", "voice_source", "transmission_loss"), "confidence_threshold": 0.5}, "available_when", dv_true())), "proposal_reassessment", dv_with(dv_with({"enabled": true, "basis": c1_hist_share_basis(), "required_slots": dv_list3("actual_heard", "voice_source", "transmission_loss"), "interpretation_ids": dv_single("short_stay")}, "source_scope", "awake_self"), "target_scope", "body_history"))

fn c1_hist_install_character(actor):
    var result = actor
    var actions = actor.actions
    var new_actions = []
    var index = 0
    while (index < rt_count(actions)):
        rt_push(new_actions, actions[index])
        index = (index + 1)
    rt_push(new_actions, c1_hist_share_action(actor.id))
    result = dv_with(result, "actions", new_actions)
    result = dv_with(result, "policy", c1_hist_proposal_policy(result.policy))
    if (actor.id == "detective"):
        result = dv_with(result, "mind", c1_hist_install_mind(result.mind))
        var policy = c1_hist_policy(result.policy)
        var goals = result.policy.goals
        var new_goals = []
        var goal_index = 0
        while (goal_index < rt_count(goals)):
            rt_push(new_goals, goals[goal_index])
            goal_index = (goal_index + 1)
        rt_push(new_goals, c1_hist_goal())
        rt_push(new_goals, c1_hist_share_goal(actor.id))
        result = dv_with(result, "policy", dv_with(policy, "goals", new_goals))
        result = dv_with(result, "response_models", c1_hist_response_models())
        return result
    else:
        return dv_with(result, "mind", dv_add_object(result.mind, c1_local_object("history_claims")))

fn c1_hist_goal():
    return {"kind": "know", "question": "original_q2_complete", "ref": c1_hist_claim_ref("actual_heard"), "basis": dv_single(c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/01_开场.story", 46, "s5_question.004"))}

fn c1_hist_install_scene(scene):
    var actors = scene.actors
    var result = []
    var index = 0
    var formal = scene.formal_answers
    var new_formal = []
    var world = scene.physical
    while (index < rt_count(actors)):
        var actor = actors[index]
        var local_1 = false
        if (actor.id == "demon"):
            local_1 = actor
        else:
            local_1 = c1_hist_install_character(actor)
        rt_push(result, local_1)
        index = (index + 1)
    index = 0
    while (index < rt_count(formal)):
        rt_push(new_formal, formal[index])
        index = (index + 1)
    // Original question remains a modeling source, not a fifth submission stage.
    world = dv_add_object(world, c1_hist_author_truth())
    return dv_with(dv_with(dv_with(scene, "actors", result), "physical", world), "formal_answers", c1_protocol_coordinates(new_formal))

fn c1_protocol_coordinates(rules):
    var result = []
    var i = 0
    while (i < rt_count(rules)):
        let rule = rules[i]
        var stage = c1_answer_topic(rule.id)
        if stage == "auxiliary":
            rt_push(result, rule)
        else:
            let progress_ref = dv_ref("question", "state", rt_cat("level_", stage))
            let completion_ref = dv_ref("question", "state", rt_cat("solved_", stage))
            let receipt_fields = dv_append(dv_append(dv_find(rule, "accepted_public_grants", []), progress_ref), completion_ref)
            rt_push(result, dv_with_many(rule, {"stage": stage, "progress_ref": progress_ref, "completion_ref": completion_ref, "accepted_public_grants": receipt_fields, "accepted_listeners": ["demon", "detective", "huo", "shen", "su"]}))
        i = i + 1
    return result

fn c1_hist_hearing_stages(stages, at, source, words):
    let listeners = ["past.su", "past.huo"]
    let rooms = ["hall", "R08", "foyer", "pantry", "R05", "R06"]
    var i = 0
    while (i < rt_count(listeners)):
        var laws = []
        var j = 0
        while (j < rt_count(rooms)):
            rt_push(laws, c1_hist_acoustic_id(source, words, listeners[i], rooms[j]))
            j = j + 1
        rt_push(stages, {"at": at, "dispatch": {"selector": dv_ref(listeners[i], "state", "location"), "laws": laws}})
        i = i + 1
    return stages

// One world and the same session mechanism for all sixteen residents.
fn c1_campaign_scene():
    var scene = c1_opening_install_scene(c1_hist_install_scene(c1_scenario_native()), "侦探")
    scene = c1_other_groups_install_scene(scene)
    var physical = dv_add_object(scene.physical, c1_state_object("campaign.clock", {"minute": dv_field(scene.physical.time)}))
    physical = dv_add_object(physical, c1_state_object("campaign.access", {"living": dv_field(true), "contract": dv_field(false), "astral": dv_field(false), "logistics": dv_field(false)}))
    var actors = []
    var limit = 0
    var i = 0
    while i < rt_count(scene.actors):
        var actor = scene.actors[i]
        if actor.id == "demon":
            var goals = dv_find(actor.policy, "goals", [])
            let groups = ["contract", "astral", "logistics"]
            var j = 0
            while j < rt_count(groups):
                let action = c1_other_open_action(groups[j], "demon")
                rt_push(goals, {"kind": "communicate", "scope": "personal", "method_id": action.id, "available_when": action.precondition, "requires_argument": false, "basis": [c1_other_case(groups[j]).source]})
                j = j + 1
            actor = dv_with(actor, "policy", dv_with(actor.policy, "goals", goals))
        rt_push(actors, actor)
        limit = limit + actor.policy.budget
        i = i + 1
    return dv_with_many(c1_active_configuration(scene), {"physical": physical, "actors": actors, "max_actions": limit, "clock_ref": c1_other_clock_ref()})

// Native first-chapter content for the three other dormitory groups.
// Personal perception, authority history, fallible hypotheses, literal answer and motive hypotheses
// occupy separate fields. No .story loader, answer grants, forced adoption or fixed route.
// This module does not give these people the living-wing broadcast.
// Prior strengths from old authorship remain provenance, not new personality weights.
// c1_other_group_extend installs content; source catalog data alone never completes an action.

fn c1_other_people():
    let key = ["authored-declaration", "c1_other_people"]
    let cached = rt_memo_get([], key)
    if cached[0]:
        return cached[1]
    return rt_memo_put([], key, c1_other_people_build())

