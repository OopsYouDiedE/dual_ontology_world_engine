        var effects = dv_get(adoptions, name).law.effects
        if dv_or((remaining < 1), (not dv_and(adoption.active, (adoption.mode == "predict")))):
            return dv_with({"world": dvs_sim_withhold(world, effects).world, "changes": [], "remaining": remaining, "status": "unavailable-response-bridge"}, "expanded", 0)
        else:
            var local = dv_with_many(world, {"domain": "mind", "adoptions": dv_with(world.adoptions, name, dv_with(adoption, "confidence", dv_min(confidence, dv_min(adoption.confidence, dv_premise_confidence(world, adoption.law.premise)))))})
            var result = false
