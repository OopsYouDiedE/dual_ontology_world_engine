fn neutral_projection_probe():
    let first = dv_ref("physical-object", "state", "first")
    let second = dv_ref("physical-object", "state", "second")
    let room = dv_ref("physical-object", "state", "room")
    let physical = dv_add_object(dv_world("neutral-physical", "physical", ""), dv_object("physical-object", "neutral", {"state": {"first": dv_field(1), "second": dv_field(2), "room": dv_field("room")}}))
    let bindings = [dv_binding("physical-object", "local-speaker", "speaker"), dv_binding("physical-object", "different-listener-local", "listener")]
    let speaker_mind = dv_world("neutral-speaker", "mind", "speaker")
    let listener_mind = dv_world("neutral-listener", "mind", "listener")
    let profile = dv_observation_profile({"perception": 1, "testimony": 1, "recall": 1}, 0.5)
    let own = dv_perceive(physical, speaker_mind, bindings, [first], "execution-neutral", 1)
    let visual = dv_perceive(physical, listener_mind, bindings, [first], "execution-neutral", 1)
    let speaker = {"id": "speaker", "mind": dv_update_mind(speaker_mind, own, speaker_mind.revision, profile).world, "policy": [], "location_ref": room}
    let listener = {"id": "listener", "mind": dv_update_mind(listener_mind, visual, listener_mind.revision, profile).world, "policy": [], "location_ref": room}
    var events = []
    dvs_event(events, "observation", "speaker", 1, [], {"observations": own, "execution_id": "execution-neutral"})
    dvs_event(events, "observation", "listener", 1, [], {"observations": visual, "execution_id": "execution-neutral"})
    let projected = dv_perceive(physical, listener.mind, bindings, [first, second], "execution-neutral", 1)
    let before_projection = dvs_public_projection_inputs(events, "execution-neutral")
    let missing = dvs_public_filter_projected(projected, dv_find(before_projection.by_subject, "listener", []))
    let action = {"id": "neutral-public", "listeners": ["speaker", "listener"], "public_grants": [first, second], "speech": {"channel": "neutral"}}
    let actors = dvs_public_grants([speaker, listener], 0, action, physical, bindings, events, 1, "neutral-parent", "execution-neutral")
    if rt_arg(0) == "repeat":
        return dvs_public_grants(actors, 0, action, physical, bindings, events, 1, "neutral-parent", "execution-neutral")
    if rt_arg(0) == "core-repeat":
        return dv_update_mind(actors[1].mind, projected, actors[1].mind.revision, profile)
    let after_projection = dvs_public_projection_inputs(events, "execution-neutral")
    let all_covered = dvs_public_filter_projected(projected, dv_find(after_projection.by_subject, "listener", []))
    var unseen_events = []
    let unseen = dvs_public_grants([dv_with(speaker, "mind", speaker_mind), dv_with(listener, "mind", listener_mind)], 0, action, physical, bindings, unseen_events, 1, "neutral-parent", "fresh-execution")
    return {"partial_overlap_remaining": rt_count(missing), "remaining_local_ref": missing[0].ref.object, "speaker_seen": rt_count(actors[0].mind.seen), "listener_seen": rt_count(actors[1].mind.seen), "fully_covered_remaining": rt_count(all_covered), "fresh_execution_listener_seen": rt_count(unseen[1].mind.seen), "fresh_second_value": dv_read(unseen[1].mind, dv_scoped_ref("listener", "different-listener-local", "state", "second")).value}
(main (rt_print (rt_json_stringify (neutral_projection_probe))))
