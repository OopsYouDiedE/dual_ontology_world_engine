; DuelView bootstrap compiler. The complete frontend and C# backend live here.
; AST = [kind, payload, UTF-16 offset]; IR is checked C# expression text for now.
(defn pair (a b) (let (r (rt_list)) (do (rt_push r a) (rt_push r b) r)))
(defn node (kind payload pos)
  (let (r (pair kind payload)) (do (rt_push r pos) r)))
(defn kind (n) (rt_at n 0))
(defn payload (n) (rt_at n 1))
(defn bad (n message) (rt_fail (rt_cat (rt_cat "DV at offset " (rt_show (rt_at n 2))) (rt_cat ": " message))))
(defn both (a b) (if a b false))
(defn either (a b) (if a true b))
(defn space (c) (either (either (rt_eq c " ") (rt_eq c "\n")) (either (rt_eq c "\r") (rt_eq c "\t"))))
(defn letter (c)
  (let (n (rt_code c))
    (either (rt_eq c "_") (either (both (rt_lt 64 n) (rt_lt n 91)) (both (rt_lt 96 n) (rt_lt n 123))))))
(defn digit (c) (let (n (rt_code c)) (both (rt_lt 47 n) (rt_lt n 58))))
(defn identifier (s)
  (if (rt_eq (rt_length s) 0) false
    (let (ok (letter (rt_chr s 0)) i 1)
      (do (while (rt_lt i (rt_length s))
        (do (set ok (both ok (either (letter (rt_chr s i)) (digit (rt_chr s i))))) (set i (rt_add i 1)))) ok))))
(defn skip (s start)
  (let (i start running true)
    (do (while (both running (rt_lt i (rt_length s)))
      (let (c (rt_chr s i))
        (if (space c) (set i (rt_add i 1))
          (if (rt_eq c ";")
            (while (if (rt_lt i (rt_length s)) (rt_not (rt_eq (rt_chr s i) "\n")) false) (set i (rt_add i 1)))
            (set running false))))) i)))
(defn hex_digit (c)
  (let (n (rt_code c)) (either (digit c) (either (both (rt_lt 64 n) (rt_lt n 71)) (both (rt_lt 96 n) (rt_lt n 103))))))
(defn scan_string (s start)
  (let (i (rt_add start 1) done false)
    (do
      (while (both (rt_not done) (rt_lt i (rt_length s)))
        (let (c (rt_chr s i))
          (do
            (if (rt_eq c "\"") (set done true)
              (if (rt_eq c "\\")
                (do
                  (set i (rt_add i 1))
                  (if (rt_lt i (rt_length s)) false (rt_fail "DV: unfinished escape"))
                  (let (e (rt_chr s i))
                    (if (rt_eq e "u")
                      (let (k 0) (while (rt_lt k 4)
                        (do (set i (rt_add i 1))
                          (if (rt_lt i (rt_length s)) false (rt_fail "DV: unfinished unicode escape"))
                          (if (hex_digit (rt_chr s i)) false (rt_fail "DV: invalid unicode escape"))
                          (set k (rt_add k 1)))))
                      (if (either (either (rt_eq e "n") (rt_eq e "r")) (either (rt_eq e "t") (either (rt_eq e "\"") (rt_eq e "\\")))) false
                        (rt_fail "DV: unsupported escape")))))
                (if (rt_lt (rt_code c) 32) (rt_fail "DV: control character in string") false)))
            (set i (rt_add i 1)))))
      (if done (pair (node "str" (rt_slice s start (rt_sub i start)) start) i) (rt_fail "DV: unterminated string")))))
(defn parse_one (s start depth)
  (let (i (skip s start))
    (do
      (if (rt_lt depth 129) false (rt_fail "DV: nesting limit"))
      (if (rt_lt i (rt_length s)) false (rt_fail "DV: unexpected end"))
      (let (c (rt_chr s i))
        (if (rt_eq c "(")
          (let (children (rt_list) cursor (skip s (rt_add i 1)) done false)
            (do
              (while (rt_not done)
                (do
                  (if (rt_lt cursor (rt_length s)) false (rt_fail "DV: unclosed list"))
                  (if (rt_eq (rt_chr s cursor) ")") (set done true)
                    (let (parsed (parse_one s cursor (rt_add depth 1)))
                      (do (rt_push children (rt_at parsed 0)) (set cursor (skip s (rt_at parsed 1))))))))
              (pair (node "list" children i) (rt_add cursor 1))))
          (if (rt_eq c ")") (rt_fail "DV: unexpected closing parenthesis")
            (if (rt_eq c "\"") (scan_string s i)
              (let (end i scanning true)
                (do
                  (while (both scanning (rt_lt end (rt_length s)))
                    (let (ch (rt_chr s end))
                      (if (either (space ch) (either (rt_eq ch "(") (either (rt_eq ch ")") (either (rt_eq ch ";") (rt_eq ch "\"")))))
                        (set scanning false) (set end (rt_add end 1)))))
                  (let (token (rt_slice s i (rt_sub end i)))
                    (pair (node (if (rt_is_number token) "num" "sym") token i) end)))))))))))
(defn parse (s)
  (let (result (rt_list) i (skip s 0))
    (do
      (if (rt_lt (rt_length s) 1048577) false (rt_fail "DV: source size limit"))
      (while (rt_lt i (rt_length s))
        (let (p (parse_one s i 0)) (do (rt_push result (rt_at p 0)) (set i (skip s (rt_at p 1)))))) result)))
(defn sym (n)
  (if (rt_eq (kind n) "sym")
    (if (identifier (payload n)) (payload n) (bad n "invalid identifier"))
    (bad n "expected identifier")))
(defn children (n) (if (rt_eq (kind n) "list") (payload n) (bad n "expected list")))
(defn has (items name)
  (let (i 0 found false)
    (do (while (rt_lt i (rt_count items))
      (do (if (rt_eq (rt_at items i) name) (set found true) false) (set i (rt_add i 1)))) found)))
(defn copy (items)
  (let (r (rt_list) i 0)
    (do (while (rt_lt i (rt_count items)) (do (rt_push r (rt_at items i)) (set i (rt_add i 1)))) r)))
(defn words (s)
  (let (nodes (parse s) r (rt_list) i 0)
    (do (while (rt_lt i (rt_count nodes)) (do (rt_push r (payload (rt_at nodes i))) (set i (rt_add i 1)))) r)))
(defn reserved (name) (has (words "if let set while do true false") name))
(defn runtime_name (name) (if (rt_lt (rt_length name) 3) false (rt_eq (rt_slice name 0 3) "rt_")))
(defn native_arity (name)
  (if (has (words "rt_list") name) 0
    (if (has (words "rt_number rt_is_number rt_not rt_length rt_code rt_show rt_count rt_is_list rt_fail rt_arg rt_read rt_print") name) 1
      (if (has (words "rt_add rt_sub rt_mul rt_div rt_lt rt_eq rt_cat rt_chr rt_push rt_at rt_write") name) 2
        (if (rt_eq name "rt_slice") 3 -1)))))
(defn lookup (signatures name)
  (let (i 0 found -1)
    (do (while (rt_lt i (rt_count signatures))
      (let (entry (rt_at signatures i))
        (do (if (rt_eq (rt_at entry 0) name) (set found (rt_at entry 1)) false) (set i (rt_add i 1))))) found)))
(defn arity (n xs expected) (if (rt_eq (rt_count xs) expected) false (bad n "invalid form arity")))
(defn add_local (n scope)
  (let (name (sym n))
    (if (either (reserved name) (has scope name)) (bad n "reserved, duplicate or shadowed local") (rt_push scope name))))
(defn cs_string (raw)
  (let (i 0 result "")
    (do
      (while (rt_lt i (rt_length raw))
        (let (c (rt_chr raw i) code (rt_code c))
          (do
            (set result (rt_cat result
              (if (rt_eq code 133) "\\u0085"
                (if (rt_eq code 8232) "\\u2028"
                  (if (rt_eq code 8233) "\\u2029" c)))))
            (set i (rt_add i 1)))))
      result)))
(defn emit (n scope signatures)
  (let (tag (kind n) value (payload n))
    (if (rt_eq tag "str") (cs_string value)
      (if (rt_eq tag "num") (rt_cat (rt_cat "R.number(\"" value) "\")")
        (if (rt_eq tag "sym")
          (if (either (rt_eq value "true") (rt_eq value "false")) value
            (if (has scope (sym n)) (rt_cat "v_" value) (bad n "unbound local")))
          (emit_form n scope signatures))))))
(defn emit_form (n scope signatures)
  (let (xs (children n))
    (do
      (if (rt_eq (rt_count xs) 0) (bad n "empty expression") false)
      (let (head (sym (rt_at xs 0)))
        (if (rt_eq head "if")
          (do (arity n xs 4)
            (rt_cat (rt_cat (rt_cat (rt_cat (rt_cat "(R.Bool(" (emit (rt_at xs 1) scope signatures)) ") ? (object)(") (emit (rt_at xs 2) scope signatures)) ") : (object)(") (rt_cat (emit (rt_at xs 3) scope signatures) "))")))
          (if (rt_eq head "let") (emit_let n xs scope signatures)
            (if (rt_eq head "do") (emit_do n xs scope signatures)
              (if (rt_eq head "set")
                (do (arity n xs 3)
                  (let (name (sym (rt_at xs 1)))
                    (do (if (has scope name) false (bad n "assignment to unbound local"))
                      (rt_cat (rt_cat (rt_cat "(v_" name) " = ") (rt_cat (emit (rt_at xs 2) scope signatures) ")")))))
                (if (rt_eq head "while")
                  (do (arity n xs 3)
                    (rt_cat (rt_cat "R.Block(() => {while(R.Bool(" (emit (rt_at xs 1) scope signatures))
                      (rt_cat ")) { _ = " (rt_cat (emit (rt_at xs 2) scope signatures) ";} return false;})"))))
                  (emit_call n xs head scope signatures))))))))))
(defn emit_let (n xs scope signatures)
  (do (arity n xs 3)
    (let (bindings (children (rt_at xs 1)) locals (copy scope) i 0 result "R.Block(() => {")
      (do
        (while (rt_lt i (rt_count bindings))
          (do
            (if (rt_lt (rt_add i 1) (rt_count bindings)) false (bad n "uneven let bindings"))
            (let (name_node (rt_at bindings i) init (emit (rt_at bindings (rt_add i 1)) locals signatures))
              (do (add_local name_node locals)
                (set result (rt_cat result (rt_cat (rt_cat "object v_" (sym name_node)) (rt_cat " = " (rt_cat init ";")))))))
            (set i (rt_add i 2))))
        (rt_cat result (rt_cat "return (object)(" (rt_cat (emit (rt_at xs 2) locals signatures) ");})"))))))
)
(defn emit_do (n xs scope signatures)
  (let (i 1 result "R.Block(() => {")
    (do
      (if (rt_lt 1 (rt_count xs)) false (bad n "empty do"))
      (while (rt_lt i (rt_sub (rt_count xs) 1))
        (do (set result (rt_cat result (rt_cat "_ = " (rt_cat (emit (rt_at xs i) scope signatures) ";")))) (set i (rt_add i 1))))
      (rt_cat result (rt_cat "return (object)(" (rt_cat (emit (rt_at xs i) scope signatures) ");})")))))
)
(defn emit_call (n xs name scope signatures)
  (let (native (native_arity name) expected (if (rt_lt native 0) (lookup signatures name) native) i 1 result "")
    (do
      (if (rt_lt expected 0) (bad n "unknown function or primitive") false)
      (if (rt_eq expected (rt_sub (rt_count xs) 1)) false (bad n "function arity mismatch"))
      (set result (if (rt_lt native 0) (rt_cat "F_" name) (rt_cat "R." (rt_slice name 3 (rt_sub (rt_length name) 3)))))
      (set result (rt_cat result "("))
      (while (rt_lt i (rt_count xs))
        (do (if (rt_lt 1 i) (set result (rt_cat result ",")) false)
          (set result (rt_cat result (emit (rt_at xs i) scope signatures))) (set i (rt_add i 1))))
      (rt_cat result ")"))))
(defn signatures_of (forms)
  (let (signatures (rt_list) i 0 mains 0)
    (do
      (while (rt_lt i (rt_count forms))
        (let (n (rt_at forms i) xs (children n))
          (do
            (if (rt_eq (rt_count xs) 0) (bad n "empty declaration") false)
            (let (head (sym (rt_at xs 0)))
              (if (rt_eq head "defn")
                (do (arity n xs 4)
                  (let (name (sym (rt_at xs 1)) params (children (rt_at xs 2)))
                    (do
                      (if (either (reserved name) (either (runtime_name name) (rt_not (rt_lt (lookup signatures name) 0)))) (bad n "duplicate or reserved function") false)
                      (rt_push signatures (pair name (rt_count params))))))
                (if (rt_eq head "main") (do (arity n xs 2) (set mains (rt_add mains 1))) (bad n "unsupported declaration"))))
            (set i (rt_add i 1)))))
      (if (rt_eq mains 1) signatures (rt_fail "DV: exactly one main required")))))
(defn emit_function (n signatures)
  (let (xs (children n) name (sym (rt_at xs 1)) params (children (rt_at xs 2)) scope (rt_list) i 0 result (rt_cat "static object F_" name))
    (do
      (set result (rt_cat result "("))
      (while (rt_lt i (rt_count params))
        (let (p (rt_at params i))
          (do (add_local p scope)
            (if (rt_lt 0 i) (set result (rt_cat result ",")) false)
            (set result (rt_cat result (rt_cat "object v_" (sym p)))) (set i (rt_add i 1)))))
      (rt_cat result (rt_cat ") => " (rt_cat (emit (rt_at xs 3) scope signatures) ";\n"))))))
(defn compile (source)
  (let (forms (parse source) signatures (signatures_of forms) i 0 result "using DuelView.Compiled;\npublic static class IndependentReviewProgram {\n")
    (do
      (while (rt_lt i (rt_count forms))
        (let (n (rt_at forms i) xs (children n))
          (do
            (set result (rt_cat result
              (if (rt_eq (sym (rt_at xs 0)) "defn") (emit_function n signatures)
                (rt_cat "public static int Main(string[] args) { R.Arguments=args; try { _ = "
                  (rt_cat (emit (rt_at xs 1) (rt_list) signatures) "; return 0; } catch(System.Exception e) { System.Console.Error.WriteLine(e.Message); return 1; } }\n")))))
            (set i (rt_add i 1)))))
      (rt_cat result "}\n"))))
(main (rt_write (rt_arg 1) (compile (rt_read (rt_arg 0)))))
