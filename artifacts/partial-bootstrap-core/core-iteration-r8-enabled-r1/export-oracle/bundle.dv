; Persistent-by-copy data operations. Runtime lists are never mutated in place here.
(defn dv_pair (a b) (let (r (rt_list)) (do (rt_push r a) (rt_push r b) r)))
(defn dv_single (a) (let (r (rt_list)) (do (rt_push r a) r)))
(defn dv_list3 (a b c) (let (r (dv_pair a b)) (do (rt_push r c) r)))
(defn dv_and (a b) (if a b false))
(defn dv_or (a b) (if a true b))
(defn dv_require (condition message) (if condition true (rt_fail message)))
(defn dv_clone (value)
  (if (rt_is_list value)
    (let (result (rt_list) i 0)
      (do (while (rt_lt i (rt_count value))
        (do (rt_push result (dv_clone (rt_at value i))) (set i (rt_add i 1)))) result)) value))
(defn dv_same (a b)
  (if (rt_is_list a)
    (if (rt_is_list b)
      (if (rt_eq (rt_count a) (rt_count b))
        (let (i 0 same true)
          (do (while (dv_and same (rt_lt i (rt_count a)))
            (do (set same (dv_same (rt_at a i) (rt_at b i))) (set i (rt_add i 1)))) same)) false) false)
    (rt_eq a b)))
(defn dv_append (items value) (let (r (dv_clone items)) (do (rt_push r (dv_clone value)) r)))
(defn dv_has (items value)
  (let (i 0 found false) (do (while (rt_lt i (rt_count items))
    (do (if (dv_same (rt_at items i) value) (set found true) false) (set i (rt_add i 1)))) found)))
(defn dv_find (record key fallback)
  (let (i 0 result fallback)
    (do (while (rt_lt i (rt_count record))
      (let (entry (rt_at record i))
        (do (if (rt_eq (rt_at entry 0) key) (set result (rt_at entry 1)) false) (set i (rt_add i 1))))) result)))
(defn dv_has_key (record key)
  (let (i 0 found false) (do (while (rt_lt i (rt_count record))
    (do (if (rt_eq (rt_at (rt_at record i) 0) key) (set found true) false) (set i (rt_add i 1)))) found)))
(defn dv_record_like (value)
  (if (rt_is_list value)
    (let (i 0 valid true)
      (do (while (dv_and valid (rt_lt i (rt_count value)))
        (let (entry (rt_at value i))
          (do (set valid (if (rt_is_list entry) (rt_eq (rt_count entry) 2) false)) (set i (rt_add i 1))))) valid)) false))
(defn dv_get (record key)
  (do (dv_require (dv_has_key record key) (rt_cat "Missing field: " key)) (dv_find record key false)))
(defn dv_with (record key value)
  (let (r (rt_list) i 0 found false)
    (do (while (rt_lt i (rt_count record))
      (let (entry (rt_at record i))
        (do (if (rt_eq (rt_at entry 0) key)
          (do (rt_push r (dv_pair key (dv_clone value))) (set found true))
          (rt_push r (dv_clone entry))) (set i (rt_add i 1)))))
      (if found false (rt_push r (dv_pair key (dv_clone value)))) r)))
(defn dv_m2 (k1 v1 k2 v2) (dv_pair (dv_pair k1 v1) (dv_pair k2 v2)))
(defn dv_without (record key)
  (let (result (rt_list) i 0)
    (do (while (rt_lt i (rt_count record))
      (let (entry (rt_at record i))
        (do (if (rt_eq (rt_at entry 0) key) false (rt_push result (dv_clone entry))) (set i (rt_add i 1))))) result)))
(defn dv_m3 (k1 v1 k2 v2 k3 v3) (dv_with (dv_m2 k1 v1 k2 v2) k3 v3))
(defn dv_m4 (k1 v1 k2 v2 k3 v3 k4 v4) (dv_with (dv_m3 k1 v1 k2 v2 k3 v3) k4 v4))
(defn dv_unit (x) (do (dv_require (dv_and (rt_not (rt_lt x 0)) (rt_not (rt_lt 1 x))) "Expected weight in [0,1]") x))
(defn dv_unknown ()
  (dv_with (dv_with (dv_m4 "known" false "value" false "confidence" 0 "time" -1) "claims" (rt_list)) "conflicted" false))
(defn dv_cell (value confidence time claims)
  (dv_with (dv_with (dv_with (dv_m4 "known" true "value" (dv_clone value) "confidence" (dv_unit confidence) "time" time) "claims" (rt_list)) "basis" claims) "conflicted" false))
(defn dv_entity_ref (id) (dv_m2 "type" "entity-ref" "id" id))
(defn dv_ref (object_id facet field) (dv_m3 "object" object_id "facet" facet "field" field))
(defn dv_world (id domain subject)
  (do
    (dv_require (dv_or (rt_eq domain "physical") (rt_eq domain "mind")) "Invalid world domain")
    (dv_require (if (rt_eq domain "physical") (rt_eq subject "") (rt_lt 0 (rt_length subject))) "World subject mismatch")
    (dv_with (dv_with (dv_with (dv_with
      (dv_m4 "id" id "domain" domain "subject" subject "revision" 0)
      "objects" (rt_list)) "adoptions" (rt_list)) "history" (rt_list)) "seen" (rt_list))))
(defn dv_domain (world domain) (dv_require (rt_eq (dv_get world "domain") domain) "Wrong world domain"))
(defn dv_object (id kind facets)
  (dv_m3 "id" id "kind" kind "facets"
    (dv_with facets "identity" (dv_with (dv_find facets "identity" (rt_list)) "kind" (if (rt_eq kind "perceived") (dv_unknown) (dv_field kind))))))
(defn dv_add_object (world object)
  (let (objects (dv_get world "objects") id (dv_get object "id"))
    (do (dv_require (rt_not (dv_has_key objects id)) "Duplicate object identity")
      (dv_with (dv_with world "objects" (dv_with objects id object)) "revision" (rt_add (dv_get world "revision") 1)))))
(defn dv_read (world ref)
  (let (objects (dv_get world "objects") id (dv_get ref "object"))
    (if (dv_has_key objects id)
      (let (facets (dv_get (dv_get objects id) "facets") facet (dv_get ref "facet"))
        (if (dv_has_key facets facet) (dv_clone (dv_find (dv_get facets facet) (dv_get ref "field") (dv_unknown))) (dv_unknown)))
      (dv_unknown))))
(defn dv_store (world ref cell)
  (let (objects (dv_get world "objects") id (dv_get ref "object"))
    (do
      (dv_require (dv_has_key objects id) "Unknown object identity")
      (let (object (dv_get objects id) facets (dv_get object "facets") facet (dv_get ref "facet") fields (dv_find facets facet (rt_list)))
        (dv_with world "objects" (dv_with objects id
          (dv_with object "facets" (dv_with facets facet (dv_with fields (dv_get ref "field") cell)))))))))
(defn dv_slice (world object_id facet fields)
  (let (result (rt_list) i 0)
    (do
      (while (rt_lt i (rt_count fields))
        (let (field (rt_at fields i))
          (do (rt_push result (dv_pair field (dv_read world (dv_ref object_id facet field)))) (set i (rt_add i 1)))))
      (dv_with (dv_with (dv_with
        (dv_m4 "world" (dv_get world "id") "domain" (dv_get world "domain") "subject" (dv_get world "subject") "revision" (dv_get world "revision"))
        "object" object_id) "facet" facet) "fields" result))))
(defn dv_field (value) (dv_cell value 1 0 (rt_list)))
(defn dv_uncontested (cell) (dv_and (dv_get cell "known") (rt_not (dv_get cell "conflicted"))))
(defn dv_door (id from to closed held inside outside automatic gap)
  (dv_object id "door"
    (dv_m2 "link" (dv_m2 "from" (dv_field (dv_entity_ref from)) "to" (dv_field (dv_entity_ref to)))
      "mechanical" (dv_with (dv_with (dv_with
        (dv_m4 "closed" (dv_field closed) "held" (dv_field held) "inside_latch" (dv_field inside) "outside_latch" (dv_field outside))
        "automatic" (dv_field automatic)) "gap" (dv_field gap)) "sealed" (dv_field false)))))
(defn dv_channel (id from to medium enabled gain gate)
  (do
    (dv_unit gain)
    (dv_object id "channel"
      (dv_m2 "link" (dv_m4 "from" (dv_field (dv_entity_ref from)) "to" (dv_field (dv_entity_ref to)) "medium" (dv_field medium) "gate" (dv_field gate))
        "transport" (dv_m3 "enabled" (dv_field enabled) "gain" (dv_field gain) "bands" (dv_field (rt_list)))))))

; Ordered multi-field copy update. Inputs and all output branches stay independent.
(defn dv_with_many (record updates)
  (if (rt_eq (rt_count updates) 0) record
  (let (result (rt_list) keys (rt_list) i 0)
    (do
      (while (rt_lt i (rt_count record))
        (let (entry (rt_at record i) key (rt_at (rt_at record i) 0))
          (do
            (if (dv_has_key updates key)
              (rt_push result (dv_pair key (dv_clone (dv_get updates key))))
              (rt_push result (dv_clone entry)))
            (rt_push keys key) (set i (rt_add i 1)))))
      (set i 0)
      (while (rt_lt i (rt_count updates))
        (let (key (rt_at (rt_at updates i) 0))
          (do
            (if (dv_has keys key) false
              (do (rt_push result (dv_pair key (dv_clone (dv_get updates key)))) (rt_push keys key)))
            (set i (rt_add i 1))))) result))))

; Law schema is data. Adoption in each world determines how the schema is used.
(defn dv_true () (dv_m2 "op" "constant" "value" "true"))
(defn dv_fact (ref expected) (dv_m3 "op" "equals" "ref" ref "value" expected))
(defn dv_at_least (ref minimum) (dv_m3 "op" "at_least" "ref" ref "value" minimum))
(defn dv_all (conditions) (dv_m2 "op" "all" "items" conditions))
(defn dv_not (condition) (dv_m2 "op" "not" "item" condition))
(defn dv_truth (world proposition)
  (let (op (dv_get proposition "op"))
    (if (rt_eq op "constant") (dv_get proposition "value")
      (if (rt_eq op "not")
        (let (inner (dv_truth world (dv_get proposition "item")))
          (if (rt_eq inner "unknown") "unknown" (if (rt_eq inner "true") "false" "true")))
        (if (rt_eq op "all")
          (let (items (dv_get proposition "items") i 0 result "true")
            (do (while (rt_lt i (rt_count items))
              (let (truth (dv_truth world (rt_at items i)))
                (do (if (rt_eq truth "false") (set result "false")
                  (if (dv_and (rt_eq truth "unknown") (rt_eq result "true")) (set result "unknown") false)) (set i (rt_add i 1))))) result))
          (let (cell (dv_read world (dv_get proposition "ref")))
            (if (dv_or (rt_not (dv_get cell "known")) (dv_get cell "conflicted")) "unknown"
              (if (rt_eq op "equals")
                (if (dv_same (dv_get cell "value") (dv_get proposition "value")) "true" "false")
                (if (rt_eq op "at_least")
                  (if (rt_lt (dv_get cell "value") (dv_get proposition "value")) "false" "true")
                  (rt_fail "Unknown proposition operator"))))))))))
(defn dv_assign (ref value) (dv_m3 "op" "assign" "ref" ref "value" value))
(defn dv_increment (ref amount) (dv_m3 "op" "increment" "ref" ref "value" amount))
(defn dv_axiom (name version premise effects)
  (dv_m4 "name" name "version" version "premise" (dv_clone premise) "effects" (dv_clone effects)))
(defn dv_instance (id law) (dv_with (dv_with law "schema" (dv_get law "name")) "name" id))
(defn dv_adopt (world law mode confidence basis)
  (do
    (dv_unit confidence)
    (dv_require (if (rt_eq (dv_get world "domain") "physical") (rt_eq confidence 1) true) "Physical laws require certainty")
    (dv_require (rt_lt 0 (rt_count basis)) "Adoption needs a basis")
    (dv_require (rt_not (dv_has_key (dv_get world "adoptions") (dv_get law "name"))) "Duplicate law instance: provide a distinct instance identity")
    (dv_require
      (if (rt_eq (dv_get world "domain") "physical") (rt_eq mode "enforce")
        (dv_and (rt_eq (dv_get world "domain") "mind") (dv_or (rt_eq mode "predict") (dv_or (rt_eq mode "infer") (rt_eq mode "norm")))))
      "Adoption mode is incompatible with world")
    (let (adoption (dv_with (dv_m4 "law" law "mode" mode "confidence" confidence "basis" basis) "active" true))
      (dv_with (dv_with world "adoptions" (dv_with (dv_get world "adoptions") (dv_get law "name") adoption)) "revision" (rt_add (dv_get world "revision") 1)))))
(defn dv_suspend (world name)
  (let (adoptions (dv_get world "adoptions"))
    (dv_with (dv_with world "adoptions" (dv_with adoptions name (dv_with (dv_get adoptions name) "active" false))) "revision" (rt_add (dv_get world "revision") 1))))
(defn dv_reconsider (world law mode confidence basis)
  (let (name (dv_get law "name") previous (dv_get (dv_get world "adoptions") name))
    (let (updated (dv_adopt (dv_with world "adoptions" (dv_without (dv_get world "adoptions") name)) law mode confidence basis))
      (dv_with updated "history" (dv_append (dv_get world "history")
        (dv_m4 "kind" "reconsideration" "previous" previous "current" (dv_get (dv_get updated "adoptions") name) "basis" basis))))))
(defn dv_result (status world changes basis)
  (dv_m4 "status" status "world" (dv_clone world) "changes" changes "basis" basis))
(defn dv_stage (world effects time basis confidence)
  (let (stage (dv_clone world) changes (rt_list) touched (rt_list) i 0 status "ready")
    (do
      (while (dv_and (rt_eq status "ready") (rt_lt i (rt_count effects)))
        (let (effect (rt_at effects i) ref (dv_get effect "ref") op (dv_get effect "op") before (dv_read stage ref))
          (do
            (if (rt_not (dv_has_key (dv_get stage "objects") (dv_get ref "object"))) (set status "unknown-object")
              (if (dv_has touched ref) (set status "duplicate-write")
                (if (dv_and (rt_eq op "increment") (rt_not (dv_get before "known"))) (set status "unknown-state")
                  (do
                    (dv_require (dv_or (rt_eq op "assign") (rt_eq op "increment")) "Unknown effect operator")
                    (let (value (if (rt_eq op "assign") (dv_get effect "value") (rt_add (dv_get before "value") (dv_get effect "value"))))
                      (do
                        (set stage (dv_store stage ref (dv_cell value confidence time basis)))
                        (rt_push changes (dv_m3 "ref" ref "before" before "after" (dv_read stage ref)))
                        (rt_push touched (dv_clone ref))))))))
            (set i (rt_add i 1)))))
      (if (rt_eq status "ready") (dv_result "ready" stage changes basis) (dv_result status world (rt_list) basis)))))
(defn dv_apply_law (world name mode event_id time expected_revision)
  (do
    (dv_require (rt_eq (dv_get world "revision") expected_revision) "Stale world revision")
    (dv_require (rt_not (dv_has (dv_get world "seen") event_id)) "Repeated world event")
    (dv_require (rt_not (rt_lt time (dv_find world "time" 0))) "World time cannot move backwards")
    (let (adoption (dv_get (dv_get world "adoptions") name) law (dv_get adoption "law") basis (dv_get adoption "basis"))
      (if (rt_not (dv_get adoption "active")) (dv_result "not-adopted" world (rt_list) basis)
        (if (rt_not (rt_eq (dv_get adoption "mode") mode)) (dv_result "wrong-adoption-mode" world (rt_list) basis)
          (let (truth (dv_truth world (dv_get law "premise")))
            (if (rt_not (rt_eq truth "true")) (dv_result (rt_cat "premise-" truth) world (rt_list) basis)
              (let (staged (dv_stage world (dv_get law "effects") time basis (dv_get adoption "confidence")))
                (if (rt_not (rt_eq (dv_get staged "status") "ready")) staged
                  (let (next (dv_get staged "world") revision (rt_add expected_revision 1)
                        event (dv_with (dv_with (dv_m4 "id" event_id "time" time "law" name "law_version" (dv_get law "version")) "changes" (dv_get staged "changes")) "basis" basis))
                    (do
                      (set next (dv_with (dv_with (dv_with (dv_with next "revision" revision) "seen" (dv_append (dv_get next "seen") event_id)) "history" (dv_append (dv_get next "history") event)) "time" time))
                      (dv_with (dv_with (dv_result "applied" next (dv_get staged "changes") basis) "event" event_id) "time" time))))))))))))
(defn dv_execute (physical name event_id time expected_revision)
  (do (dv_domain physical "physical") (dv_apply_law physical name "enforce" event_id time expected_revision)))
(defn dv_predict (mind name event_id time expected_revision)
  (do
    (dv_domain mind "mind")
    (let (result (dv_apply_law mind name "predict" event_id time expected_revision))
      (dv_with (dv_with result "world" (dv_with (dv_with (dv_get result "world") "domain" "prediction") "source_revision" expected_revision)) "source_revision" expected_revision))))
(defn dv_infer (mind name event_id time expected_revision)
  (do (dv_domain mind "mind") (dv_apply_law mind name "infer" event_id time expected_revision)))
(defn dv_norm (mind name)
  (do (dv_domain mind "mind")
    (let (adoption (dv_get (dv_get mind "adoptions") name))
      (do (dv_require (rt_eq (dv_get adoption "mode") "norm") "Not a normative adoption")
        (if (dv_get adoption "active") (dv_truth mind (dv_get (dv_get adoption "law") "premise")) "unknown")))))

; Observation adaptation is an explicit trusted boundary. Minds receive no world pointer.
(defn dv_binding (physical local subject) (dv_m3 "physical" physical "local" local "subject" subject))
(defn dv_local (bindings physical subject)
  (let (i 0 result "")
    (do (while (rt_lt i (rt_count bindings))
      (let (binding (rt_at bindings i))
        (do (if (dv_and (rt_eq (dv_get binding "physical") physical) (rt_eq (dv_get binding "subject") subject))
          (do (dv_require (rt_eq result "") "Ambiguous projection binding") (set result (dv_get binding "local"))) false)
          (set i (rt_add i 1))))) result)))
(defn dv_validate_bindings (bindings subject)
  (let (i 0 locals (rt_list) physicals (rt_list))
    (do (while (rt_lt i (rt_count bindings))
      (let (b (rt_at bindings i))
        (do
          (if (rt_eq (dv_get b "subject") subject)
            (do
              (dv_require (rt_lt 0 (rt_length (dv_get b "local"))) "Empty local identity")
              (dv_require (rt_not (dv_has locals (dv_get b "local"))) "Local projection cannot bind two objects")
              (dv_require (rt_not (dv_has physicals (dv_get b "physical"))) "Ambiguous physical binding")
              (rt_push locals (dv_get b "local")) (rt_push physicals (dv_get b "physical"))) false)
          (set i (rt_add i 1))))) true)))
(defn dv_project_value (value bindings subject)
  (if (rt_is_list value)
    (if (if (dv_record_like value) (dv_same (dv_find value "type" "") "entity-ref") false)
      (let (local (dv_local bindings (dv_get value "id") subject))
        (if (rt_eq local "") (dv_m2 "known" false "value" false) (dv_m2 "known" true "value" (dv_entity_ref local))))
      (let (i 0 items (rt_list) known true)
        (do (while (rt_lt i (rt_count value))
          (let (projected (dv_project_value (rt_at value i) bindings subject))
            (do (set known (dv_and known (dv_get projected "known"))) (rt_push items (dv_get projected "value")) (set i (rt_add i 1)))))
          (dv_m2 "known" known "value" items))))
    (dv_m2 "known" true "value" value)))
(defn dv_observation (id subject ref value source origin time trust dependency)
  (do
    (dv_unit trust)
    (dv_require (rt_not (rt_lt time 0)) "Negative observation time")
    (dv_require (dv_has (dv_list3 "perception" "testimony" "recall") source)
      "Direct observations use perception, testimony or recall; inference uses adopted rules")
    (dv_with (dv_with (dv_with (dv_with (dv_with
      (dv_m4 "id" id "subject" subject "ref" ref "value" (dv_clone value))
      "source" source) "origin" origin) "time" time) "trust" trust) "dependency" dependency)))
(defn dv_perceive (physical mind bindings grants event_id time)
  (do
    (dv_domain physical "physical") (dv_domain mind "mind")
    (dv_validate_bindings bindings (dv_get mind "subject"))
    (let (observations (rt_list) i 0 subject (dv_get mind "subject"))
      (do (while (rt_lt i (rt_count grants))
        (let (ref (rt_at grants i) local (dv_local bindings (dv_get ref "object") subject) cell (dv_read physical ref))
          (do
            (if (dv_and (rt_not (rt_eq local "")) (dv_get cell "known"))
              (let (mapped (dv_project_value (dv_get cell "value") bindings subject)
                    local_ref (dv_ref local (dv_get ref "facet") (dv_get ref "field")))
                (if (dv_get mapped "known")
                  (rt_push observations (dv_observation (dv_list3 event_id subject local_ref) subject local_ref (dv_get mapped "value")
                    "perception" "direct" time 1 (dv_pair event_id local_ref))) false)) false)
            (set i (rt_add i 1))))) observations))))
(defn dv_perceive_changes (receipt mind bindings grants)
  (do
    (dv_require (rt_eq (dv_get receipt "status") "applied") "Only applied world changes can be perceived")
    (let (changes (dv_get receipt "changes") exposed (rt_list) i 0)
      (do (while (rt_lt i (rt_count changes))
        (let (ref (dv_get (rt_at changes i) "ref"))
          (do (if (dv_has grants ref) (rt_push exposed ref) false) (set i (rt_add i 1)))))
        (dv_perceive (dv_get receipt "world") mind bindings exposed (dv_get receipt "event") (dv_get receipt "time"))))))
(defn dv_observation_profile (source_weights threshold)
  (dv_m2 "weights" source_weights "threshold" (dv_unit threshold)))
(defn dv_weight (observation profile)
  (let (weight (dv_get (dv_get profile "weights") (dv_get observation "source")))
    (do (dv_require (rt_not (rt_lt weight 0)) "Negative evidence weight") (rt_mul weight (dv_unit (dv_get observation "trust"))))))
(defn dv_replace_claim (claims observation)
  (let (result (rt_list) i 0)
    (do (while (rt_lt i (rt_count claims))
      (let (old (rt_at claims i))
        (do (if (dv_same (dv_get old "dependency") (dv_get observation "dependency")) false (rt_push result (dv_clone old))) (set i (rt_add i 1)))))
      (rt_push result (dv_clone observation)) result)))
(defn dv_aggregate (claims profile time)
  (let (alternatives (rt_list) i 0 total 0 best 0 chosen false)
    (do
      (while (rt_lt i (rt_count claims))
        (let (claim (rt_at claims i) weight (dv_weight claim profile) value (dv_get claim "value") j 0 found false new_items (rt_list))
          (do
            (while (rt_lt j (rt_count alternatives))
              (let (alternative (rt_at alternatives j))
                (do
                  (if (dv_same (rt_at alternative 0) value)
                    (do (rt_push new_items (dv_pair value (rt_add (rt_at alternative 1) weight))) (set found true))
                    (rt_push new_items alternative)) (set j (rt_add j 1)))))
            (if (dv_or found (rt_eq weight 0)) false (rt_push new_items (dv_pair value weight)))
            (set alternatives new_items) (set total (rt_add total weight)) (set i (rt_add i 1)))))
      (set i 0)
      (let (distribution (rt_list))
        (do
          (while (rt_lt i (rt_count alternatives))
            (let (alternative (rt_at alternatives i) weight (rt_at alternative 1))
              (do
                (if (rt_lt best weight) (do (set best weight) (set chosen (rt_at alternative 0))) false)
                (rt_push distribution (dv_pair (rt_at alternative 0) (rt_div weight total)))
                (set i (rt_add i 1)))))
          (let (confidence (if (rt_eq total 0) 0 (rt_div best total)) cell (dv_cell chosen confidence time claims))
            (dv_with (dv_with (dv_with (dv_with cell "known" (dv_and (rt_lt 0 total) (rt_not (rt_lt confidence (dv_get profile "threshold")))))
              "conflicted" (rt_lt 1 (rt_count alternatives))) "claims" claims) "alternatives" distribution)))))))
(defn dv_update_mind (mind observations expected_revision profile)
  (do
    (dv_domain mind "mind")
    (dv_require (rt_eq (dv_get mind "revision") expected_revision) "Stale cognition revision")
    (let (next (dv_clone mind) i 0 accepted (rt_list) dispositions (rt_list))
      (do
        (while (rt_lt i (rt_count observations))
          (let (observation (rt_at observations i) id (dv_get observation "id") ref (dv_get observation "ref") object_id (dv_get ref "object"))
            (do
              (dv_require (rt_eq (dv_get observation "subject") (dv_get mind "subject")) "Foreign observation")
              (dv_require (rt_not (dv_has (dv_get next "seen") id)) "Repeated observation")
              (dv_weight observation profile)
              (if (dv_has_key (dv_get next "objects") object_id) false
                (set next (dv_add_object next (dv_object object_id "perceived" (rt_list)))))
              (let (old (dv_read next ref) time (dv_get observation "time"))
                (if (rt_lt time (dv_get old "time")) (rt_push dispositions (dv_pair id "older-than-current"))
                  (let (claims (if (rt_lt (dv_get old "time") time) (rt_list) (dv_get old "claims")))
                    (do
                      (set next (dv_store next ref (dv_aggregate (dv_replace_claim claims observation) profile time)))
                      (rt_push dispositions (dv_pair id "updated"))))))
              (set next (dv_with next "seen" (dv_append (dv_get next "seen") id)))
              (rt_push accepted (dv_clone observation))
              (set i (rt_add i 1)))))
        (set next (dv_with next "revision" (if (rt_eq (rt_count observations) 0) expected_revision (rt_add expected_revision 1))))
        (set next (dv_with next "history" (dv_append (dv_get mind "history") (dv_m3 "kind" "observation-batch" "observations" accepted "dispositions" dispositions))))
        (dv_m3 "world" next "dispositions" dispositions "revision" (dv_get next "revision"))))))

; Signals are segmented by the author/host. No hidden reconstruction of lost words.
(defn dv_segment (content strength band) (dv_m3 "content" content "strength" strength "band" band))
(defn dv_signal (location medium segments) (dv_m3 "location" (dv_entity_ref location) "medium" medium "segments" segments))
(defn dv_filter_signal (segments gain threshold bands)
  (let (result (rt_list) i 0)
    (do (while (rt_lt i (rt_count segments))
      (let (segment (rt_at segments i) strength (rt_mul (dv_get segment "strength") gain))
        (do
          (if (dv_and (rt_not (rt_lt strength threshold)) (dv_or (rt_eq (rt_count bands) 0) (dv_has bands (dv_get segment "band"))))
            (rt_push result (dv_segment (dv_get segment "content") strength (dv_get segment "band"))) false)
          (set i (rt_add i 1))))) result)))
(defn dv_transport (world path signal threshold)
  (do
    (dv_require (rt_not (rt_lt threshold 0)) "Negative perception threshold")
    (let (i 0 location (dv_get signal "location") segments (dv_clone (dv_get signal "segments")) status "delivered" trace (rt_list))
      (do
        (while (dv_and (rt_eq status "delivered") (rt_lt i (rt_count path)))
          (let (channel (rt_at path i) objects (dv_get world "objects"))
            (do
              (dv_require (dv_has_key objects channel) "Unknown channel")
              (dv_require (rt_eq (dv_truth world (dv_fact (dv_ref channel "identity" "kind") "channel")) "true") "Transport object must be known as a channel")
              (let (from (dv_read world (dv_ref channel "link" "from"))
                    to (dv_read world (dv_ref channel "link" "to"))
                    medium (dv_read world (dv_ref channel "link" "medium"))
                    gate (dv_read world (dv_ref channel "link" "gate"))
                    enabled (dv_read world (dv_ref channel "transport" "enabled"))
                    gain (dv_read world (dv_ref channel "transport" "gain")))
                (if (dv_and (dv_and (dv_uncontested from) (dv_uncontested to))
                      (dv_and (dv_and (dv_uncontested medium) (dv_uncontested gate)) (dv_and (dv_uncontested enabled) (dv_uncontested gain))))
                  (do
                    (dv_require (dv_same location (dv_get from "value")) "Discontinuous channel path")
                    (dv_require (rt_eq (dv_get signal "medium") (dv_get medium "value")) "Channel medium mismatch")
                    (let (gate_truth (dv_truth world (dv_get gate "value")))
                      (if (dv_and (dv_get enabled "value") (rt_eq gate_truth "true"))
                        (let (bands_cell (dv_read world (dv_ref channel "transport" "bands")))
                          (if (dv_uncontested bands_cell)
                            (do
                              (set segments (dv_filter_signal segments (dv_unit (dv_get gain "value")) threshold (dv_get bands_cell "value")))
                              (set location (dv_get to "value"))
                              (rt_push trace channel))
                            (set status "unknown")))
                        (set status (if (rt_eq gate_truth "unknown") "unknown" "blocked")))))
                  (set status "unknown")))
              (set i (rt_add i 1)))))
        (dv_with (dv_m4 "status" status "location" location "segments" (if (rt_eq status "delivered") segments (rt_list)) "trace" trace)
          "world_revision" (dv_get world "revision"))))))
(defn dv_hear (delivery subject local_ref perceived_origin event_id time)
  (do
    (dv_require (rt_eq (dv_get delivery "status") "delivered") "No delivered signal")
    (dv_require (rt_eq (dv_find delivery "hypothetical" true) false) "Predicted or unauthorised transmission cannot become perception")
    (dv_observation event_id subject local_ref (dv_get delivery "segments") "perception" perceived_origin time 1 event_id)))
(defn dv_transport_theory (law) (dv_with law "operation" "attenuate-filter"))
(defn dv_transmit (world law_name path signal threshold)
  (let (adoption (dv_get (dv_get world "adoptions") law_name) law (dv_get adoption "law"))
    (do
      (dv_require (dv_get adoption "active") "Transmission law is not active")
      (dv_require (rt_eq (dv_get law "operation") "attenuate-filter") "Not a transport theory")
      (dv_require (if (rt_eq (dv_get world "domain") "physical") (rt_eq (dv_get adoption "mode") "enforce")
        (dv_and (rt_eq (dv_get world "domain") "mind") (rt_eq (dv_get adoption "mode") "predict"))) "Wrong transmission adoption")
      (dv_require (rt_eq (dv_truth world (dv_get law "premise")) "true") "Transmission premise is not established")
      (dv_with (dv_with (dv_transport world path signal threshold) "basis" (dv_get adoption "basis")) "hypothetical" (rt_not (rt_eq (dv_get world "domain") "physical"))))))

; Value is computed against an explicit rubric, not a truth or legality judgement.
(defn dv_criterion (id ref mode target weight)
  (do
    (dv_require (dv_or (rt_eq mode "numeric") (rt_eq mode "matches")) "Unsupported value criterion")
    (dv_with (dv_m4 "id" id "ref" ref "mode" mode "target" target) "weight" weight)))
(defn dv_measure (value criterion)
  (if (rt_eq (dv_get criterion "mode") "numeric") (rt_mul value (dv_get criterion "weight"))
    (if (dv_same value (dv_get criterion "target")) (dv_get criterion "weight") 0)))
(defn dv_expected_measure (cell criterion)
  (let (alternatives (dv_find cell "alternatives" (rt_list)) sum 0 i 0)
    (if (rt_eq (rt_count alternatives) 0)
      (rt_mul (dv_measure (dv_get cell "value") criterion) (dv_get cell "confidence"))
      (do (while (rt_lt i (rt_count alternatives))
        (let (alternative (rt_at alternatives i))
          (do (set sum (rt_add sum (rt_mul (dv_measure (rt_at alternative 0) criterion) (rt_at alternative 1)))) (set i (rt_add i 1))))) sum))))
(defn dv_value (world criteria subjective)
  (let (i 0 score 0 details (rt_list) unknown (rt_list) ids (rt_list))
    (do
      (while (rt_lt i (rt_count criteria))
        (let (criterion (rt_at criteria i) id (dv_get criterion "id") cell (dv_read world (dv_get criterion "ref")))
          (do
            (dv_require (rt_not (dv_has ids id)) "Duplicate value criterion") (rt_push ids id)
            (if (dv_get cell "known")
              (let (amount (if subjective (dv_expected_measure cell criterion) (dv_measure (dv_get cell "value") criterion)))
                (do (set score (rt_add score amount))
                  (rt_push details (dv_m4 "criterion" id "contribution" amount "confidence" (dv_get cell "confidence") "conflicted" (dv_get cell "conflicted")))))
              (rt_push unknown id))
            (set i (rt_add i 1)))))
      (dv_with (dv_with (dv_with (dv_m4 "score" score "details" details "unknown" unknown "complete" (rt_eq (rt_count unknown) 0))
        "world" (dv_get world "id")) "revision" (dv_get world "revision")) "subject" (dv_get world "subject")))))
(defn dv_value_subjective (mind criteria)
  (do (dv_require (dv_or (rt_eq (dv_get mind "domain") "mind") (rt_eq (dv_get mind "domain") "prediction")) "Subjective value requires a mind or prediction")
    (dv_value mind criteria true)))
(defn dv_value_objective (physical criteria) (do (dv_domain physical "physical") (dv_value physical criteria false)))
(defn dv_value_change (before after criteria)
  (do
    (dv_require (dv_and (rt_eq (dv_get before "id") (dv_get after "id")) (rt_eq (dv_get before "subject") (dv_get after "subject"))) "Value comparison crosses worlds")
    (let (subjective (rt_not (rt_eq (dv_get before "domain") "physical")))
      (do
        (dv_require (if subjective (dv_and (rt_eq (dv_get before "domain") "mind") (dv_or (rt_eq (dv_get after "domain") "mind") (rt_eq (dv_get after "domain") "prediction"))) (rt_eq (dv_get after "domain") "physical")) "Value domain mismatch")
        (let (a (dv_value before criteria subjective) b (dv_value after criteria subjective))
          (dv_m4 "delta" (rt_sub (dv_get b "score") (dv_get a "score")) "before" a "after" b "complete" (dv_and (dv_get a "complete") (dv_get b "complete"))))))))

; Appraisal-inspired game mechanism, not a clinical or psychometric model.
; Intent, instrumental value and expression are separate outputs.
(defn dv_request (id requester self)
  (dv_m3 "id" id "requester" requester "self" self))
(defn dv_feature_refs (request)
  (let (speaker (dv_get request "requester") self (dv_get request "self") id (dv_get request "id") refs (rt_list))
    (do
      (rt_push refs (dv_pair "trust" (dv_ref speaker "relationship" "trust")))
      (rt_push refs (dv_pair "closeness" (dv_ref speaker "relationship" "closeness")))
      (rt_push refs (dv_pair "respect" (dv_ref speaker "relationship" "respect")))
      (rt_push refs (dv_pair "reciprocity" (dv_ref speaker "relationship" "reciprocity")))
      (rt_push refs (dv_pair "valence" (dv_ref self "affect" "valence")))
      (rt_push refs (dv_pair "arousal" (dv_ref self "affect" "arousal")))
      (rt_push refs (dv_pair "fatigue" (dv_ref self "resources" "fatigue")))
      (rt_push refs (dv_pair "stress" (dv_ref self "resources" "stress")))
      (rt_push refs (dv_pair "attention" (dv_ref self "resources" "attention")))
      (rt_push refs (dv_pair "threat" (dv_ref id "appraisal" "threat")))
      (rt_push refs (dv_pair "fairness" (dv_ref id "appraisal" "fairness")))
      (rt_push refs (dv_pair "control" (dv_ref id "appraisal" "control")))
      (rt_push refs (dv_pair "certainty" (dv_ref id "appraisal" "certainty")))
      (rt_push refs (dv_pair "importance" (dv_ref id "appraisal" "importance"))) refs)))
(defn dv_appraise_request (mind request)
  (do
    (dv_domain mind "mind")
    (let (refs (dv_feature_refs request) features (rt_list) unknown (rt_list) basis (rt_list) i 0)
      (do
        (while (rt_lt i (rt_count refs))
          (let (entry (rt_at refs i) key (rt_at entry 0) cell (dv_read mind (rt_at entry 1)))
            (do
              (if (dv_and (dv_get cell "known") (rt_not (dv_get cell "conflicted")))
                (do
                  (rt_push features (dv_pair key (dv_get cell "value")))
                  (rt_push basis (dv_m3 "feature" key "ref" (rt_at entry 1) "cell" cell)))
                (rt_push unknown key))
              (set i (rt_add i 1)))))
        (dv_with (dv_with (dv_m4 "features" features "unknown" unknown "basis" basis "revision" (dv_get mind "revision")) "subject" (dv_get mind "subject")) "request" (dv_get request "id"))))))
(defn dv_dot (features weights)
  (let (i 0 score 0 terms (rt_list) unknown (rt_list))
    (do
      (while (rt_lt i (rt_count weights))
        (let (entry (rt_at weights i) key (rt_at entry 0))
          (do
            (if (dv_has_key features key)
              (let (contribution (rt_mul (dv_get features key) (rt_at entry 1)))
                (do (set score (rt_add score contribution)) (rt_push terms (dv_pair key contribution))))
              (rt_push unknown key))
            (set i (rt_add i 1)))))
      (dv_m3 "score" score "terms" terms "unknown" unknown))))
(defn dv_clamp_signed (value) (if (rt_lt value -1) -1 (if (rt_lt 1 value) 1 value)))
(defn dv_expression (appraisal expression_policy)
  (let (axes (rt_list) i 0)
    (do
      (while (rt_lt i (rt_count expression_policy))
        (let (axis (rt_at expression_policy i) evaluation (dv_dot (dv_get appraisal "features") (rt_at axis 1)))
          (do (rt_push axes (dv_pair (rt_at axis 0) (dv_with (dv_with evaluation "value" (dv_clamp_signed (dv_get evaluation "score"))) "complete" (rt_eq (rt_count (dv_get evaluation "unknown")) 0)))) (set i (rt_add i 1))))) axes)))
(defn dv_no_change_prediction (mind)
  (do (dv_domain mind "mind") (dv_with (dv_with mind "domain" "prediction") "source_revision" (dv_get mind "revision"))))
(defn dv_response_option (id intent feasible prediction effort feature_weights)
  (do
    (dv_require (rt_not (rt_lt effort 0)) "Negative effort")
    (dv_with (dv_with (dv_m4 "id" id "intent" intent "feasible" feasible "prediction" prediction) "effort" effort) "feature_weights" feature_weights)))
(defn dv_validate_expression_policy (expression_policy)
  (do (dv_require (dv_record_like expression_policy) "Expression policy must be an axis-to-weight-record matrix")
    (let (i 0)
      (do (while (rt_lt i (rt_count expression_policy))
        (let (axis (rt_at expression_policy i) key (rt_at (rt_at expression_policy i) 0) weights (rt_at (rt_at expression_policy i) 1) j 0)
          (do (dv_require (rt_eq (rt_slice (rt_json_stringify key) 0 1) "\"") "Expression policy axis name must be Text")
            (dv_require (dv_record_like weights) (rt_cat "Expression policy axis weights must be a record: " key))
            (while (rt_lt j (rt_count weights))
              (let (weight (rt_at weights j) feature (rt_at (rt_at weights j) 0))
                (do (dv_require (rt_eq (rt_slice (rt_json_stringify feature) 0 1) "\"") "Expression policy feature name must be Text")
                  (dv_require (rt_is_number (rt_json_stringify (rt_at weight 1)))
                    (rt_cat (rt_cat (rt_cat "Expression policy weight must be a finite Number: " key) ".") feature))
                  (set j (rt_add j 1))))) (set i (rt_add i 1))))) true))))
(defn dv_person_policy (subject values effort_cost uncertainty_cost expression_policy)
  (do
    (dv_validate_expression_policy expression_policy)
    (dv_require (dv_and (rt_not (rt_lt effort_cost 0)) (rt_not (rt_lt uncertainty_cost 0))) "Negative policy cost")
    (dv_with (dv_m4 "subject" subject "values" values "effort_cost" effort_cost "uncertainty_cost" uncertainty_cost) "expression" expression_policy)))
(defn dv_accept_policy (mind id policy basis)
  (do
    (dv_domain mind "mind")
    (dv_require (rt_eq (dv_get mind "subject") (dv_get policy "subject")) "Foreign value policy")
    (dv_require (rt_lt 0 (rt_count basis)) "Value policy needs an acceptance basis")
    (let (policies (dv_find mind "policies" (rt_list)))
      (do
        (dv_require (rt_not (dv_has_key policies id)) "Duplicate accepted policy")
        (dv_with (dv_with mind "policies" (dv_with policies id (dv_m3 "policy" policy "basis" basis "active" true)))
          "revision" (rt_add (dv_get mind "revision") 1))))))
(defn dv_respond_adopted (mind request options policy_id)
  (let (accepted (dv_get (dv_get mind "policies") policy_id))
    (do (dv_require (dv_get accepted "active") "Response policy is not adopted")
      (dv_with (dv_respond mind request options (dv_get accepted "policy")) "policy_basis" (dv_get accepted "basis")))))
(defn dv_response_score (mind option appraisal policy)
  (let (prediction (dv_get option "prediction"))
    (do
      (dv_domain prediction "prediction")
      (dv_require (rt_eq (dv_get prediction "source_revision") (dv_get mind "revision")) "Stale response prediction")
      (let (value (dv_value_change mind prediction (dv_get policy "values"))
            relation_and_state (dv_dot (dv_get appraisal "features") (dv_get option "feature_weights"))
            effort (rt_mul (dv_get option "effort") (dv_get policy "effort_cost"))
            uncertainty (rt_mul (rt_add (rt_count (dv_get relation_and_state "unknown")) (rt_count (dv_get (dv_get value "after") "unknown"))) (dv_get policy "uncertainty_cost")))
        (dv_with
          (dv_m4 "score" (rt_sub (rt_add (dv_get value "delta") (dv_get relation_and_state "score")) (rt_add effort uncertainty))
            "value" value "relationship_and_state" relation_and_state "effort" effort)
          "uncertainty_cost" uncertainty)))))
(defn dv_respond (mind request options policy)
  (do
    (dv_domain mind "mind")
    (dv_require (rt_eq (dv_get mind "subject") (dv_get policy "subject")) "Foreign person policy")
    (let (appraisal (dv_appraise_request mind request) i 0 found false best 0 chosen false evaluated (rt_list) rejected (rt_list) ids (rt_list))
      (do
        (while (rt_lt i (rt_count options))
          (let (option (rt_at options i) id (dv_get option "id") legal (dv_truth mind (dv_get option "feasible")))
            (do
              (dv_require (rt_not (dv_has ids id)) "Duplicate response identity") (rt_push ids id)
              (if (rt_eq legal "true")
                (let (evaluation (dv_response_score mind option appraisal policy))
                  (do
                    (rt_push evaluated (dv_pair id evaluation))
                    (if (if found (rt_lt best (dv_get evaluation "score")) true)
                      (do (set found true) (set best (dv_get evaluation "score")) (set chosen option)) false)))
                (rt_push rejected (dv_pair id legal)))
              (set i (rt_add i 1)))))
        (dv_with (dv_with (dv_with
          (dv_m4 "status" (if found "selected" "no-response") "choice" chosen "appraisal" appraisal "evaluated" evaluated)
          "rejected" rejected) "expression" (dv_expression appraisal (dv_get policy "expression"))) "committed" false)))))
(defn dv_relax (current baseline retention)
  (rt_add baseline (rt_mul (rt_sub current baseline) (dv_unit retention))))
(defn dv_affect_proposal (mind request policy)
  (let (appraisal (dv_appraise_request mind request) features (dv_get appraisal "features") self (dv_get request "self")
        valence_ref (dv_ref self "affect" "valence") arousal_ref (dv_ref self "affect" "arousal")
        valence (dv_read mind valence_ref) arousal (dv_read mind arousal_ref))
    (do
      (dv_require (dv_and (dv_get valence "known") (dv_get arousal "known")) "Unknown current affect")
      (let (v_delta (dv_dot features (dv_get policy "valence_weights")) a_delta (dv_dot features (dv_get policy "arousal_weights")))
        (dv_m3 "source_revision" (dv_get mind "revision") "basis" appraisal
          "effects" (dv_pair
            (dv_assign valence_ref (dv_clamp_signed (rt_add
              (dv_relax (dv_get valence "value") (dv_get policy "baseline_valence") (dv_get policy "retention")) (dv_get v_delta "score"))))
            (dv_assign arousal_ref (dv_clamp_signed (rt_add
              (dv_relax (dv_get arousal "value") (dv_get policy "baseline_arousal") (dv_get policy "retention")) (dv_get a_delta "score"))))))))))

; Generic operational axioms. No chapter identities, answers or authored dialogue.
(axiom door_open 1 (door)
  (dv_all (dv_pair (dv_fact (dv_ref door "mechanical" "inside_latch") false)
                  (dv_fact (dv_ref door "mechanical" "outside_latch") false)))
  (dv_single (dv_assign (dv_ref door "mechanical" "closed") false)))
(axiom door_self_close 1 (door)
  (dv_all (dv_pair (dv_fact (dv_ref door "mechanical" "automatic") true)
                  (dv_fact (dv_ref door "mechanical" "held") false)))
  (dv_pair (dv_assign (dv_ref door "mechanical" "closed") true)
           (dv_assign (dv_ref door "mechanical" "gap") 0)))
(axiom door_latch 1 (door)
  (dv_fact (dv_ref door "mechanical" "closed") true)
  (dv_single (dv_assign (dv_ref door "mechanical" "inside_latch") true)))
(axiom door_seal 1 (door)
  (dv_fact (dv_ref door "mechanical" "closed") true)
  (dv_single (dv_assign (dv_ref door "mechanical" "sealed") true)))
(axiom channel_reconfigure 1 (channel gain)
  (dv_true)
  (dv_single (dv_assign (dv_ref channel "transport" "gain") (dv_unit gain))))
(axiom channel_flow 1 (channel)
  (dv_fact (dv_ref channel "transport" "enabled") true)
  (rt_list))

; Validity is checked before cost. Cost is not truth, probability or action utility.
(defn dv_proof_step (id kind conclusion parents law)
  (dv_with (dv_m4 "id" id "kind" kind "conclusion" conclusion "parents" parents) "law" law))
(defn dv_cost_policy (step evidence assumption conflict reference maximum allow_assumptions budget)
  (do
    (dv_require (dv_and (dv_and (rt_not (rt_lt step 0)) (rt_not (rt_lt evidence 0)))
      (dv_and (dv_and (rt_lt 0 assumption) (rt_not (rt_lt conflict 0))) (dv_and (rt_lt 0 reference) (rt_not (rt_lt maximum 0))))) "Invalid reasoning costs")
    (dv_require (rt_lt 0 budget) "Invalid proof budget")
    (dv_with (dv_with (dv_with (dv_with (dv_m4 "step" step "evidence" evidence "assumption" assumption "conflict" conflict)
      "reference" reference) "maximum" maximum) "allow_assumptions" allow_assumptions) "budget" budget)))
(defn dv_min (a b) (if (rt_lt a b) a b))
(defn dv_premise_confidence (world proposition)
  (let (op (dv_get proposition "op"))
    (if (rt_eq op "constant") 1
      (if (rt_eq op "not") (dv_premise_confidence world (dv_get proposition "item"))
        (if (rt_eq op "all")
          (let (items (dv_get proposition "items") i 0 confidence 1)
            (do (while (rt_lt i (rt_count items))
              (do (set confidence (dv_min confidence (dv_premise_confidence world (rt_at items i)))) (set i (rt_add i 1)))) confidence))
          (dv_get (dv_read world (dv_get proposition "ref")) "confidence"))))))
(defn dv_rule_concludes (law conclusion)
  (let (effects (dv_get law "effects") i 0 found false)
    (do (while (rt_lt i (rt_count effects))
      (let (effect (rt_at effects i))
        (do (if (rt_eq (dv_get effect "op") "assign")
          (if (dv_same conclusion (dv_fact (dv_get effect "ref") (dv_get effect "value"))) (set found true) false) false)
          (set i (rt_add i 1))))) found)))
(defn dv_match_premises (premise supplied)
  (if (dv_same premise (dv_true)) (rt_eq (rt_count supplied) 0)
    (if (rt_eq (dv_get premise "op") "all")
      (let (required (dv_get premise "items") i 0 valid (rt_eq (rt_count supplied) (rt_count required)))
        (do (while (rt_lt i (rt_count required))
          (do (set valid (dv_and valid (dv_has supplied (rt_at required i)))) (set i (rt_add i 1)))) valid))
      (dv_same supplied (dv_single premise)))))
(defn dv_check_step (world step checked policy)
  (let (kind (dv_get step "kind") conclusion (dv_get step "conclusion") parents (dv_get step "parents")
        supplied (rt_list) confidence 1 i 0 hypothetical false)
    (do
      (while (rt_lt i (rt_count parents))
        (let (parent (dv_get checked (rt_at parents i)))
          (do (rt_push supplied (dv_get parent "conclusion"))
            (set confidence (dv_min confidence (dv_get parent "confidence")))
            (set hypothetical (dv_or hypothetical (dv_get parent "hypothetical")))
            (set i (rt_add i 1)))))
      (let (assumptions 0 conflicts 0 local_uncertainty 0)
        (do
          (if (rt_eq kind "known")
            (do
              (dv_require (rt_eq (rt_count parents) 0) "Known premise cannot hide parents")
              (dv_require (rt_eq (dv_truth world conclusion) "true") "Conclusion is not available in this view")
              (set confidence (dv_premise_confidence world conclusion))
              (set local_uncertainty (rt_sub 1 confidence)))
            (if (rt_eq kind "assume")
              (do
                (dv_require (rt_eq (rt_count parents) 0) "Assumption cannot hide parents")
                (dv_require (dv_and (dv_get policy "allow_assumptions") (rt_not (rt_eq (dv_get world "domain") "physical"))) "Assumption not permitted")
                (set hypothetical true) (set assumptions 1) (set confidence 0)
                (if (rt_eq (dv_truth world conclusion) "false") (set conflicts 1) false))
              (if (rt_eq kind "axiom")
                (let (adoption (dv_get (dv_get world "adoptions") (dv_get step "law")) law (dv_get adoption "law"))
                  (do
                    (dv_require (dv_get adoption "active") "Proof uses a suspended axiom")
                    (dv_require (rt_eq (dv_get adoption "mode") "infer") "Operational effects do not prove that an event occurred")
                    (dv_require (dv_rule_concludes law conclusion) "Axiom does not conclude this proposition")
                    (dv_require (dv_match_premises (dv_get law "premise") supplied) "Axiom premises are not established")
                    (set confidence (dv_min confidence (dv_get adoption "confidence")))
                    (set local_uncertainty (rt_sub 1 (dv_get adoption "confidence")))))
                (rt_fail "Unsupported proof step"))))
          (dv_with (dv_with (dv_with (dv_with (dv_with (dv_clone step) "confidence" confidence) "hypothetical" hypothetical)
            "assumptions" assumptions) "conflicts" conflicts) "local_uncertainty" local_uncertainty))))))
(defn dv_judge_conclusion (world conclusion proof policy)
  (do
    (dv_require (rt_lt 0 (rt_count proof)) "Empty derivation")
    (dv_require (rt_not (rt_lt (dv_get policy "budget") (rt_count proof))) "Derivation budget exhausted")
    (let (checked (rt_list) i 0)
      (do
        (while (rt_lt i (rt_count proof))
          (let (step (rt_at proof i) id (dv_get step "id"))
            (do
              (dv_require (rt_not (dv_has_key checked id)) "Repeated proof node identity")
              (set checked (dv_with checked id (dv_check_step world step checked policy)))
              (set i (rt_add i 1)))))
        (let (root (dv_get checked (dv_get (rt_at proof (rt_sub (rt_count proof) 1)) "id"))
              queue (dv_single (dv_get root "id")) visited (rt_list) cursor 0 steps 0 uncertainty 0 assumptions 0 conflicts 0)
          (do
            (dv_require (dv_same conclusion (dv_get root "conclusion")) "Derivation concludes another proposition")
            (while (rt_lt cursor (rt_count queue))
              (let (id (rt_at queue cursor))
                (do
                  (if (dv_has visited id) false
                    (let (step (dv_get checked id) parents (dv_get step "parents") p 0)
                      (do
                        (rt_push visited id) (set steps (rt_add steps 1))
                        (set uncertainty (rt_add uncertainty (dv_get step "local_uncertainty")))
                        (set assumptions (rt_add assumptions (dv_get step "assumptions")))
                        (set conflicts (rt_add conflicts (dv_get step "conflicts")))
                        (while (rt_lt p (rt_count parents)) (do (rt_push queue (rt_at parents p)) (set p (rt_add p 1)))))))
                  (set cursor (rt_add cursor 1)))))
            (let (cost (rt_add (rt_add (rt_mul steps (dv_get policy "step")) (rt_mul uncertainty (dv_get policy "evidence")))
                        (rt_add (rt_mul assumptions (dv_get policy "assumption")) (rt_mul conflicts (dv_get policy "conflict"))))
                  components (dv_m4 "steps" steps "evidence_uncertainty" uncertainty "assumptions" assumptions "conflicts" conflicts))
              (dv_with (dv_with (dv_with (dv_with (dv_with
                (dv_m4 "valid" true "cost" cost "components" components "reasonable" (rt_not (rt_lt (dv_get policy "maximum") cost)))
                "reasonableness" (rt_div 1 (rt_add 1 (rt_div cost (dv_get policy "reference")))))
                "confidence" (dv_get root "confidence"))
                "hypothetical" (dv_or (dv_get root "hypothetical") (rt_eq (dv_get world "domain") "prediction")))
                "scope" (dv_m3 "world" (dv_get world "id") "subject" (dv_get world "subject") "revision" (dv_get world "revision")))
                "basis" visited))))))))

; Inspector reads committed checkpoints, not reconstructed or omniscient minds.
(defn dv_checkpoint (world time)
  (dv_m3 "time" time "revision" (dv_get world "revision") "world" (dv_clone world)))
(defn dv_session (worlds time time_unit)
  (let (catalog (rt_list) history (rt_list) subjects (rt_list) i 0)
    (do
      (dv_require (rt_not (rt_lt time 0)) "Negative session time")
      (while (rt_lt i (rt_count worlds))
        (let (world (rt_at worlds i) id (dv_get world "id") domain (dv_get world "domain"))
          (do
            (dv_require (dv_or (rt_eq domain "physical") (rt_eq domain "mind")) "Predictions cannot be committed as worlds")
            (dv_require (rt_not (dv_has_key catalog id)) "Duplicate world identity")
            (if (rt_eq domain "mind")
              (do (dv_require (rt_not (dv_has subjects (dv_get world "subject"))) "Duplicate subject world") (rt_push subjects (dv_get world "subject"))) false)
            (set catalog (dv_with catalog id world))
            (rt_push history (dv_checkpoint world time))
            (set i (rt_add i 1)))))
      (dv_m4 "worlds" catalog "history" history "time" time "time_unit" time_unit))))
(defn dv_session_commit (session expected_revision world time)
  (let (catalog (dv_get session "worlds") id (dv_get world "id") old (dv_get catalog id))
    (do
      (dv_require (rt_eq (dv_get old "revision") expected_revision) "Stale session commit")
      (dv_require (rt_lt expected_revision (dv_get world "revision")) "Commit needs a newer world revision")
      (dv_require (dv_and (rt_eq (dv_get old "domain") (dv_get world "domain")) (rt_eq (dv_get old "subject") (dv_get world "subject"))) "World identity changed")
      (dv_require (rt_not (rt_lt time (dv_get session "time"))) "Session time cannot move backwards")
      (dv_with (dv_with (dv_with session "worlds" (dv_with catalog id world))
        "history" (dv_append (dv_get session "history") (dv_checkpoint world time))) "time" time))))
(defn dv_session_advance (session time)
  (do (dv_require (rt_not (rt_lt time (dv_get session "time"))) "Session time cannot move backwards") (dv_with session "time" time)))
(defn dv_active_worldview (world)
  (let (adoptions (dv_get world "adoptions") result (rt_list) i 0 policies (dv_find world "policies" (rt_list)) accepted_policies (rt_list))
    (do (while (rt_lt i (rt_count adoptions))
      (let (entry (rt_at adoptions i))
        (do (if (dv_get (rt_at entry 1) "active") (rt_push result (dv_clone entry)) false) (set i (rt_add i 1)))))
      (set i 0)
      (while (rt_lt i (rt_count policies))
        (let (entry (rt_at policies i))
          (do (if (dv_get (rt_at entry 1) "active") (rt_push accepted_policies (dv_clone entry)) false) (set i (rt_add i 1)))))
      (dv_m2 "laws" result "value_policies" accepted_policies))))
(defn dv_inspect_content (world command object_id facet)
  (if (rt_eq command "worldview") (dv_active_worldview world)
    (if (rt_eq command "state") (dv_clone (dv_get world "objects"))
      (if (rt_eq command "slice")
        (let (objects (dv_get world "objects") fields (rt_list))
          (do
            (if (dv_has_key objects object_id)
              (let (facets (dv_get (dv_get objects object_id) "facets") values (dv_find facets facet (rt_list)) i 0)
                (while (rt_lt i (rt_count values)) (do (rt_push fields (rt_at (rt_at values i) 0)) (set i (rt_add i 1))))) false)
            (dv_slice world object_id facet fields)))
        (rt_fail "Inspector command must be worldview, state or slice")))))
(defn dv_inspect_at (session subject time command object_id facet)
  (do
    (dv_require (rt_not (rt_lt (dv_get session "time") time)) "Requested time has not been reached")
    (let (history (dv_get session "history") i 0 found false chosen false)
      (do
        (while (rt_lt i (rt_count history))
          (let (checkpoint (rt_at history i) world (dv_get checkpoint "world"))
            (do
              (if (dv_and (rt_eq (dv_get world "domain") "mind")
                    (dv_and (rt_eq (dv_get world "subject") subject) (rt_not (rt_lt time (dv_get checkpoint "time")))))
                (do (set found true) (set chosen checkpoint)) false)
              (set i (rt_add i 1)))))
        (if found
          (let (world (dv_get chosen "world"))
            (dv_with (dv_with (dv_with
              (dv_m4 "status" "snapshot" "subject" subject "requested_time" time "checkpoint_time" (dv_get chosen "time"))
              "time_unit" (dv_get session "time_unit")) "revision" (dv_get world "revision")) "content" (dv_inspect_content world command object_id facet)))
          (dv_m3 "status" "no-checkpoint" "subject" subject "requested_time" time))))))
(defn dv_inspector_main ()
  (let (argc (rt_arg_count))
    (do
      (dv_require (dv_or (rt_eq argc 4) (rt_eq argc 6)) "Usage: Inspector session.json subject time worldview|state|slice [object facet]")
      (let (command (rt_arg 3))
        (do
          (dv_require (if (rt_eq command "slice") (rt_eq argc 6) (rt_eq argc 4)) "Wrong inspector argument count")
          (rt_print (rt_json_stringify (dv_inspect_at (rt_json_parse (rt_read (rt_arg 0))) (rt_arg 1) (rt_number (rt_arg 2)) command
            (if (rt_eq argc 6) (rt_arg 4) "") (if (rt_eq argc 6) (rt_arg 5) "")))))))))

; Resource accounting is independent of preference/effort scores. All transitions return copies.
(defn dv_action_cost_vector (time computation stamina)
  (do (dv_require (dv_and (rt_not (rt_lt time 0)) (dv_and (rt_not (rt_lt computation 0)) (rt_not (rt_lt stamina 0)))) "Negative action cost")
    (dv_m3 "time" time "computation" computation "stamina" stamina)))
(defn dv_action_cost_validate (v)
  (dv_action_cost_vector (dv_get v "time") (dv_get v "computation") (dv_get v "stamina")))
(defn dv_action_cost_le (a b)
  (dv_and (rt_not (rt_lt (dv_get b "time") (dv_get a "time")))
    (dv_and (rt_not (rt_lt (dv_get b "computation") (dv_get a "computation"))) (rt_not (rt_lt (dv_get b "stamina") (dv_get a "stamina"))))))
(defn dv_action_cost_add (a b)
  (dv_action_cost_vector (rt_add (dv_get a "time") (dv_get b "time")) (rt_add (dv_get a "computation") (dv_get b "computation")) (rt_add (dv_get a "stamina") (dv_get b "stamina"))))
(defn dv_action_cost_sub (a b)
  (dv_action_cost_vector (rt_sub (dv_get a "time") (dv_get b "time")) (rt_sub (dv_get a "computation") (dv_get b "computation")) (rt_sub (dv_get a "stamina") (dv_get b "stamina"))))
(defn dv_action_cost_bounds (minimum maximum)
  (do (dv_action_cost_validate minimum) (dv_action_cost_validate maximum)
    (dv_require (dv_action_cost_le minimum maximum) "Action minimum exceeds maximum") (dv_m2 "minimum" minimum "maximum" maximum)))
(defn dv_action_cost_ledger (id balances)
  (do (dv_action_cost_validate balances)
    (dv_with (dv_with (dv_with (dv_m4 "id" id "revision" 0 "balances" balances "reserved" (dv_action_cost_vector 0 0 0))
      "receipts" (rt_list)) "events" (rt_list)) "spent" (dv_action_cost_vector 0 0 0))))
(defn dv_action_cost_quote (ledger world action event bounds)
  (do (dv_domain world "physical") (dv_action_cost_bounds (dv_get bounds "minimum") (dv_get bounds "maximum"))
    (dv_require (rt_not (dv_has (dv_get ledger "events") event)) "Repeated cost event")
    (dv_require (rt_not (dv_has (dv_get world "seen") event)) "Repeated world event")

    (dv_with (dv_with (dv_with (dv_m4 "ledger" (dv_get ledger "id") "revision" (dv_get ledger "revision") "world" (dv_get world "id") "world_revision" (dv_get world "revision"))
      "action" action) "event" event) "bounds" bounds)))
(defn dv_action_cost_admit (ledger world quote)
  (let (maximum (dv_get (dv_get quote "bounds") "maximum") event (dv_get quote "event"))
    (do
      (dv_require (dv_and (rt_eq (dv_get ledger "id") (dv_get quote "ledger")) (rt_eq (dv_get ledger "revision") (dv_get quote "revision"))) "Stale cost quote")
      (dv_require (dv_and (rt_eq (dv_get world "id") (dv_get quote "world")) (rt_eq (dv_get world "revision") (dv_get quote "world_revision"))) "Stale cost world")
      (dv_action_cost_quote ledger world (dv_get quote "action") event (dv_get quote "bounds"))
      (dv_require (dv_action_cost_le maximum (dv_get ledger "balances")) "Insufficient action resources")
      (let (receipt (dv_with quote "state" "reserved") next (dv_with ledger "revision" (rt_add (dv_get ledger "revision") 1)))
        (do (set next (dv_with next "balances" (dv_action_cost_sub (dv_get ledger "balances") maximum)))
          (set next (dv_with next "reserved" (dv_action_cost_add (dv_get ledger "reserved") maximum)))
          (set next (dv_with next "events" (dv_append (dv_get ledger "events") event)))
          (set next (dv_with next "receipts" (dv_with (dv_get ledger "receipts") event receipt)))
          (dv_m2 "ledger" next "receipt" receipt))))))
(defn dv_action_cost_actual (receipt actual)
  (do (dv_action_cost_validate actual)
    (dv_require (dv_and (dv_action_cost_le (dv_get (dv_get receipt "bounds") "minimum") actual)
      (dv_action_cost_le actual (dv_get (dv_get receipt "bounds") "maximum"))) "Actual action cost outside bounds") actual))
(defn dv_action_cost_settle (ledger receipt actual outcome)
  (let (event (dv_get receipt "event") stored (dv_get (dv_get ledger "receipts") event) maximum (dv_get (dv_get receipt "bounds") "maximum"))
    (do
      (dv_require (dv_and (rt_eq (dv_get ledger "id") (dv_get receipt "ledger")) (dv_same stored receipt)) "Receipt mismatch or already settled")
      (dv_require (rt_eq (dv_get stored "state") "reserved") "Receipt already settled")
      (dv_require (dv_or (rt_eq outcome "applied") (rt_eq outcome "rejected")) "Unknown settlement outcome")
      (dv_action_cost_actual receipt actual)
      (let (next (dv_with ledger "revision" (rt_add (dv_get ledger "revision") 1)) settled (dv_with (dv_with (dv_with receipt "state" "settled") "actual" actual) "outcome" outcome))
        (do (set next (dv_with next "balances" (dv_action_cost_add (dv_get ledger "balances") (dv_action_cost_sub maximum actual))))
          (set next (dv_with next "reserved" (dv_action_cost_sub (dv_get ledger "reserved") maximum)))
          (set next (dv_with next "spent" (dv_action_cost_add (dv_get ledger "spent") actual)))
          (dv_with next "receipts" (dv_with (dv_get ledger "receipts") event settled)))))))
(defn dv_action_cost_clock_commit (physical receipt actual status)
  (let (event (dv_get receipt "event") time (rt_add (dv_find physical "time" 0) (dv_get actual "time")))
    (let (history (dv_with (dv_with (dv_m4 "id" event "time" time "kind" "action-cost" "status" status) "receipt" receipt) "actual" actual))
      (dv_with (dv_with (dv_with (dv_with physical "time" time) "revision" (rt_add (dv_get physical "revision") 1))
        "seen" (dv_append (dv_get physical "seen") event)) "history" (dv_append (dv_get physical "history") history)))))
(defn dv_action_cost_execution_metadata (execution receipt actual)
  (dv_with (dv_with (dv_with execution "event" (dv_get receipt "event")) "time" (dv_get (dv_get execution "world") "time")) "actual_cost" actual))
(defn dv_action_cost_execute (ledger physical quote actual)
  (let (admitted (dv_action_cost_admit ledger physical quote) receipt (dv_get admitted "receipt"))
    (do (dv_action_cost_actual receipt actual)
      (let (execution (dv_execute physical (dv_get receipt "action") (dv_get receipt "event")
        (rt_add (dv_find physical "time" 0) (dv_get actual "time")) (dv_get receipt "world_revision")))
        (do (if (rt_eq (dv_get execution "status") "applied") false
          (set execution (dv_with execution "world" (dv_action_cost_clock_commit physical receipt actual (dv_get execution "status")))))
          (dv_m3 "ledger" (dv_action_cost_settle (dv_get admitted "ledger") receipt actual
            (if (rt_eq (dv_get execution "status") "applied") "applied" "rejected"))
            "execution" (dv_action_cost_execution_metadata execution receipt actual) "receipt" receipt))))))
(defn dv_action_cost_finish (ledger physical quote actual outcome)
  (let (admitted (dv_action_cost_admit ledger physical quote) receipt (dv_get admitted "receipt"))
    (do (dv_action_cost_actual receipt actual)
      (let (next (dv_action_cost_clock_commit physical receipt actual outcome))
        (dv_m3 "ledger" (dv_action_cost_settle (dv_get admitted "ledger") receipt actual outcome)
          "execution" (dv_action_cost_execution_metadata (dv_result outcome next (rt_list) (dv_single (dv_get receipt "event"))) receipt actual) "receipt" receipt)))))

; Explicit, defeasible acceptance of a paid explanation. This is not an observation adapter.
(defn dv_explanation_model_complete (model status revision)
  (dv_and (rt_eq (dv_find model "status" "unknown") status)
    (dv_and (dv_or (rt_eq (dv_find model "source_revision" -1) revision) (dv_find model "validated_by_inputs" false))
      (dv_and (dv_find model "plan_complete" false)
        (dv_and (rt_not (rt_lt (dv_find model "remaining" -1) 0))
          (dv_and (rt_not (rt_lt (dv_find model "work_remaining" -1) 0))
            (dv_and (rt_eq (rt_count (dv_find model "failures" (rt_list))) 0)
              (dv_and (rt_lt 0 (rt_count (dv_find model "predictions" (rt_list))))
                (dv_and (rt_eq (rt_count (dv_find model "predictions" (rt_list))) (rt_count (dv_find model "comparisons" (rt_list))))
                  (dv_has_key model "event"))))))))))
(defn dv_explanation_observation_sources (mind comparison sources)
  (let (observed (dv_get comparison "observed_cells") i 0 valid true ids (rt_list) inputs (rt_list))
    (do (if (rt_eq (rt_count observed) 0) (set valid false) false)
      (while (rt_lt i (rt_count observed))
        (let (item (rt_at observed i) ref (dv_get (rt_at observed i) "ref") cell (dv_read mind (dv_get (rt_at observed i) "ref")) j 0 found false)
          (do (if (dv_same cell (dv_get item "cell")) false (set valid false))
            (while (rt_lt j (rt_count sources))
              (let (source (rt_at sources j) observation (dv_get (rt_at sources j) "observation"))
                (do (if (dv_and (rt_eq (dv_get observation "subject") (dv_get mind "subject"))
                  (dv_and (dv_same (dv_get observation "ref") ref) (dv_same (dv_get observation "value") (dv_get cell "value"))))
                  (if (dv_has (dv_find cell "claims" (rt_list)) observation)
                    (do (set found true) (if (dv_has ids (dv_get source "event_id")) false (set ids (dv_append ids (dv_get source "event_id"))))) false) false)
                  (set j (rt_add j 1)))))
            (if found false (set valid false))
            (rt_push inputs item) (set i (rt_add i 1)))))
      (dv_m3 "valid" valid "source_event_ids" ids "inputs" inputs))))
(defn dv_explanation_trace_changes (step)
  (if (dv_has_key step "changes") (dv_get step "changes")
    (if (dv_has_key step "response")
      (let (response (dv_get step "response"))
        (if (dv_has_key response "bridge") (dv_find (dv_get response "bridge") "changes" (rt_list)) (rt_list))) (rt_list))))
(defn dv_explanation_slot (model slot)
  (let (predictions (dv_get model "predictions") index (dv_get slot "feature_index") valid false value false confidence 0 trace_step -1 trace (dv_get model "trace") j 0)
    (do (if (dv_and (rt_not (rt_lt index 0)) (rt_lt index (rt_count predictions)))
      (let (prediction (rt_at predictions index))
        (do (while (rt_lt j (rt_count trace))
          (let (step (rt_at trace j) changes (dv_explanation_trace_changes (rt_at trace j)) k 0)
            (do (if (rt_eq (dv_get step "at") (dv_get slot "trace_at"))
              (while (rt_lt k (rt_count changes))
                (let (change (rt_at changes k))
                  (do (if (dv_and (dv_same (dv_get change "ref") (dv_get slot "ref"))
                    (dv_and (dv_uncontested (dv_get change "after"))
                      (dv_and (dv_get prediction "covered") (dv_find slot "value_from_prediction" false))))
                    (do (set valid true) (set value (dv_get (dv_get change "after") "value"))
                      (set confidence (dv_min (dv_get prediction "confidence") (dv_get (dv_get change "after") "confidence"))) (set trace_step j)) false)
                    (set k (rt_add k 1))))) false) (set j (rt_add j 1))))) )) false)
      (dv_with (dv_m4 "valid" valid "value" value "confidence" confidence "trace_step" trace_step) "slot" slot))))
(defn dv_explanation_model_inputs (mind model)
  (let (trace (dv_find model "trace" (rt_list)) result (rt_list) i 0)
    (do (while (rt_lt i (rt_count trace))
      (let (refs (dv_find (rt_at trace i) "inputs" (rt_list)) j 0)
        (do (while (rt_lt j (rt_count refs))
          (let (ref (dv_get (rt_at refs j) "ref"))
            (do (set result (dv_explanation_merge result (dv_single (dv_m2 "ref" ref "cell" (dv_read mind ref)))))
              (set j (rt_add j 1))))) (set i (rt_add i 1))))) result)))
(defn dv_explanation_model_current (mind model)
  (let (inputs (dv_find model "validation_inputs" (rt_list)) valid (dv_same (dv_find model "source_adoptions" false) (dv_get mind "adoptions")) i 0)
    (do (while (rt_lt i (rt_count inputs))
      (let (input (rt_at inputs i))
        (do (if (dv_same (dv_without (dv_get input "cell") "time") (dv_without (dv_read mind (dv_get input "ref")) "time")) false (set valid false)) (set i (rt_add i 1))))) valid)))
(defn dv_accept_explanation (mind model competitors slots sources policy budget time id)
  (let (valid true reason "accepted-estimated" comparisons (dv_find model "comparisons" (rt_list)) i 0 source_ids (rt_list)
        inputs (rt_list) competitor_ids (rt_list) claims (rt_list) effects (rt_list) remaining budget confidence (dv_find policy "confidence_cap" 0))
    (do (dv_domain mind "mind")
      (if (dv_and (dv_find policy "active" false) (dv_and (rt_lt 0 confidence) (dv_and (rt_lt confidence 1) (rt_lt 0 (rt_count (dv_find policy "basis" (rt_list))))))) false
        (do (set valid false) (set reason "abduction-strategy-not-adopted")))
      (if (dv_and (dv_explanation_model_complete model "explained" (dv_get mind "revision")) (if (dv_find model "validated_by_inputs" false) (dv_explanation_model_current mind model) true)) false
        (do (set valid false) (set reason "model-incomplete-or-stale")))
      (while (rt_lt i (rt_count comparisons))
        (let (comparison (rt_at comparisons i) observed (dv_explanation_observation_sources mind (rt_at comparisons i) sources))
          (do (if (dv_and (rt_eq (dv_get comparison "result") "match") (dv_get observed "valid")) false
            (do (set valid false) (set reason "unobserved-or-unmatched-feature")))
            (set confidence (dv_min confidence (dv_get comparison "confidence")))
            (set source_ids (dv_explanation_merge source_ids (dv_get observed "source_event_ids")))
            (set inputs (dv_explanation_merge inputs (dv_get observed "inputs"))) (set i (rt_add i 1)))))
      (set inputs (dv_explanation_merge inputs (dv_explanation_model_inputs mind model)))
      (set i 0)
      (while (rt_lt i (rt_count competitors))
        (let (other (rt_at competitors i) j 0 other_comparisons (dv_find (rt_at competitors i) "comparisons" (rt_list)) contradiction false)
          (do (if (dv_and (dv_explanation_model_complete other "inconsistent" (dv_get mind "revision")) (if (dv_find other "validated_by_inputs" false) (dv_explanation_model_current mind other) true)) false
            (do (set valid false) (set reason "unresolved-competitor")))
            (while (rt_lt j (rt_count other_comparisons))
              (let (comparison (rt_at other_comparisons j) observed (dv_explanation_observation_sources mind (rt_at other_comparisons j) sources))
                (do (if (dv_and (rt_not (rt_eq (dv_get comparison "result") "unknown")) (dv_get observed "valid")) false
                  (do (set valid false) (set reason "competitor-feature-unresolved")))
                  (if (rt_eq (dv_get comparison "result") "contradiction") (set contradiction true) false)
                  (set source_ids (dv_explanation_merge source_ids (dv_get observed "source_event_ids")))
                  (set inputs (dv_explanation_merge inputs (dv_get observed "inputs"))) (set j (rt_add j 1)))))
            (set inputs (dv_explanation_merge inputs (dv_explanation_model_inputs mind other)))
            (if contradiction false (do (set valid false) (set reason "competitor-not-refuted")))
            (if (dv_has_key other "event") (set competitor_ids (dv_append competitor_ids (dv_get other "event"))) false) (set i (rt_add i 1)))))
      (if (rt_eq (rt_count slots) 0) (do (set valid false) (set reason "no-public-claim-slots")) false)
      (set i 0)
      (while (dv_and valid (rt_lt i (rt_count slots)))
        (if (rt_lt remaining 1) (do (set valid false) (set reason "argument-reason-budget"))
          (let (slot (rt_at slots i) resolved (dv_explanation_slot model (rt_at slots i)))
            (do (set remaining (rt_sub remaining 1))
              (if (dv_get resolved "valid")
                (let (ref (dv_get slot "ref") existing (dv_read mind (dv_get slot "ref")))
                  (do (if (dv_has_key (dv_get mind "objects") (dv_get ref "object")) false (do (set valid false) (set reason "unknown-local-claim-object")))
                    (if (dv_and (dv_uncontested existing) (rt_not (dv_same (dv_get existing "value") (dv_get resolved "value"))))
                      (do (set valid false) (set reason "claim-conflicts-with-current-evidence")) false)
                    (set confidence (dv_min confidence (dv_get resolved "confidence")))
                    (rt_push claims (dv_with (dv_m4 "slot_id" (dv_get slot "slot_id") "ref" ref "value" (dv_get resolved "value") "trace_step" (dv_get resolved "trace_step")) "feature_index" (dv_get slot "feature_index")))
                    (if (dv_uncontested existing) false (rt_push effects (dv_assign ref (dv_get resolved "value"))))))
                (do (set valid false) (set reason "claim-not-covered-by-actual-predictive-trace")))
              (set i (rt_add i 1))))))
      (if (rt_lt 0 confidence) false (do (set valid false) (set reason "unsupported-zero-confidence")))
      (let (basis (dv_explanation_merge (dv_find policy "basis" (rt_list)) (dv_explanation_merge source_ids (dv_append competitor_ids (dv_find model "event" "")))) world mind changes (rt_list))
        (do (if valid
          (let (stage (dv_stage mind effects time (dv_append basis id) confidence) j 0)
            (if (rt_eq (dv_get stage "status") "ready")
              (do (set world (dv_get stage "world")) (set changes (dv_get stage "changes"))
                (while (rt_lt j (rt_count changes))
                  (let (ref (dv_get (rt_at changes j) "ref"))
                    (do (set world (dv_store world ref (dv_with (dv_with (dv_read world ref) "source" "abduction") "estimated" true))) (set j (rt_add j 1)))))
                (if (rt_lt 0 (rt_count changes)) (set world (dv_with world "revision" (rt_add (dv_get mind "revision") 1))) false))
              (do (set valid false) (set reason (dv_get stage "status"))))) false)
          (let (argument (dv_with (dv_with (dv_with (dv_with (dv_with (dv_with (dv_with (dv_with
            (dv_m4 "id" id "estimated" true "confidence" confidence "claims" claims) "model_event" (dv_find model "event" ""))
              "source_event_ids" source_ids) "competitor_events" competitor_ids) "source_revision" (dv_get mind "revision"))
              "mind_revision_after" (dv_get world "revision")) "inputs" inputs) "changes" changes) "basis" basis))
            (do (if valid (set world (dv_with world "history" (dv_append (dv_get world "history") (dv_m3 "kind" "estimated-model-argument" "argument" argument "time" time)))) false)
              (dv_with (dv_with (dv_m4 "accepted" valid "reason" reason "world" world "argument" argument) "remaining" remaining) "expanded" (rt_sub budget remaining)))))))))
(defn dv_explanation_merge (a b)
  (let (result a i 0) (do (while (rt_lt i (rt_count b))
    (do (if (dv_has result (rt_at b i)) false (set result (dv_append result (rt_at b i)))) (set i (rt_add i 1)))) result)))

; Independent read-only oracle. Never linked into the session or subjective policy.
(defn c1_oracle_source (path line id) (dv_m3 "path" path "line" line "id" id))
(defn c1_oracle_fact (atom) (dv_fact (dv_ref "cognition" "state" atom) true))
(defn c1_original_heard_requirement ()
 (dv_all (dv_list3
  (dv_fact (dv_ref "history_claims" "state" "actual_heard") "Huo-relay-and-Su-report")
  (dv_fact (dv_ref "history_claims" "state" "voice_source") "Tube")
  (dv_fact (dv_ref "history_claims" "state" "transmission_loss") "stressed-tail-without-leading-qualification"))))
(defn c1_milestone (id type after)
 (dv_m4 "id" id "type" type "actor" "detective" "after" after))
(defn c1_oracle_milestones ()
 (let (events (rt_list))
  (do (rt_push events (dv_m4 "id" "opening" "type" "speech_literal" "actor" "demon" "after" (rt_list)))
   (rt_push events (dv_with (dv_with (c1_milestone "first_answer" "answer_accepted" (dv_single "opening")) "answer_id" "me") "semantic_kind" "formal_answer"))
   (rt_push events (dv_with (dv_with (c1_milestone "genuine_rejection" "answer_rejected" (dv_single "first_answer")) "question_id" "original_q2_complete") "semantic_kind" "genuine_rejection"))
   (rt_push events (dv_with (c1_milestone "serious_wrong_use" "mind_simulation" (dv_single "genuine_rejection")) "semantic_kind" "serious_wrong_model_use"))
   (rt_push events (dv_with (c1_milestone "new_evidence" "observation" (dv_single "serious_wrong_use")) "requirement" (c1_oracle_fact "cups_precise")))
   (rt_push events (c1_milestone "ready" "answer_ready" (dv_single "new_evidence")))
   (rt_push events (dv_with (dv_with (c1_milestone "second_submit" "answer_submitted" (dv_single "ready")) "answer_id" "original_q2_complete") "semantic_kind" "formal_answer"))
   (rt_push events (dv_with (dv_with (c1_milestone "second_accept" "answer_accepted" (dv_single "second_submit")) "answer_id" "original_q2_complete") "semantic_kind" "formal_answer"))
   (rt_push events (dv_with (c1_milestone "sharing" "speech_literal" (dv_single "second_accept")) "semantic_kind" "sharing_withdrawal")) events)))
(defn c1_oracle_questions ()
 (dv_m2 "identity" (dv_m2 "causal_requirements" (dv_single (c1_oracle_fact "me")) "competing_requirements" (rt_list))
 "original_q2_complete" (dv_with (dv_m2 "causal_requirements" (dv_single (c1_original_heard_requirement))
   "competing_requirements" (rt_list)) "coverage_limit" "Six declared discrete variables; unknown personal wake latency is not claimed or used as a verified timestamp")))
(defn c1_raw_chapter1_oracle ()
 (dv_with (dv_with (dv_with (dv_with (dv_with (dv_m4
  "format" "dv-oracle-v1" "actor" "detective" "first_question_id" "identity" "target_question_id" "original_q2_complete")
  "milestones" (c1_oracle_milestones)) "questions" (c1_oracle_questions))
  "causal_requirements" (dv_single (c1_original_heard_requirement)))
  "limit" (dv_m4 "origin" "run_start" "destinations" (c1_oracle_destinations) "maximum_game_minutes" 360 "destination" "second_accept"))
  "source_refs" (dv_pair
   (c1_oracle_source "godot_csharp/scenes/Awakening/Script/story/第一章/场面/01_开场.story" 46 "s5_question.004")
   (c1_oracle_source "docs/design-standard.md" 1509 "原题第二问"))))

(defn c1_oracle_destinations ()
 (let (result (dv_list3 "ready" "second_submit" "second_accept"))
  (do (rt_push result "sharing") result)))

(defn c1_oracle_temporal_contract ()
 (dv_list3
  (dv_m4 "id" "fixed-alarm-history" "kind" "fixed_history" "actor" "detective"
   "not_bound" "The alarm is a fixed source-order anchor; no absolute personal wake timestamp is observed")
  (dv_with (dv_m4 "id" "body-residence-duration" "kind" "body_cumulative" "actor" "detective"
   "minimum_duration" 3) "not_bound" "No first-chapter quantified >=3-day body-history record; unsupported pragmatic adoption may be withdrawn without notP")
  (dv_m4 "id" "recalled-latching-history" "kind" "recall" "actor" "detective"
   "not_bound" "Actual touch recall has source and acquisition time, but no exact past occurrence timestamp; acquisition time is not the past anchor")))
(defn dvs_chapter1_oracle ()
 (dv_with (c1_raw_chapter1_oracle) "temporal_contract" (c1_oracle_temporal_contract)))

(main (rt_write (rt_arg 0) (rt_json_stringify (if (rt_eq (rt_arg 1) "dvs_chapter1_oracle") (dvs_chapter1_oracle) (rt_fail "Unknown I/O export function")))))
