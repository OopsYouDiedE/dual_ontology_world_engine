; Persistent-by-copy data operations. Runtime lists are never mutated in place here.
(defn dv_pair (a b) (let (r (rt_list)) (do (rt_push r a) (rt_push r b) r)))
(defn dv_single (a) (let (r (rt_list)) (do (rt_push r a) r)))
(defn dv_list3 (a b c) (let (r (dv_pair a b)) (do (rt_push r c) r)))
(defn dv_and (a b) (if a b false))
(defn dv_or (a b) (if a true b))
(defn dv_require (condition message) (if condition true (rt_fail message)))
(defn dv_clone (value)
  (if (rt_is_list value)
    (let (result (rt_list) i 0)
      (do (while (rt_lt i (rt_count value))
        (do (rt_push result (dv_clone (rt_at value i))) (set i (rt_add i 1)))) result)) value))
(defn dv_same (a b)
  (if (rt_is_list a)
    (if (rt_is_list b)
      (if (rt_eq (rt_count a) (rt_count b))
        (let (i 0 same true)
          (do (while (dv_and same (rt_lt i (rt_count a)))
            (do (set same (dv_same (rt_at a i) (rt_at b i))) (set i (rt_add i 1)))) same)) false) false)
    (rt_eq a b)))
(defn dv_append (items value) (let (r (dv_clone items)) (do (rt_push r (dv_clone value)) r)))
(defn dv_has (items value)
  (let (i 0 found false) (do (while (rt_lt i (rt_count items))
    (do (if (dv_same (rt_at items i) value) (set found true) false) (set i (rt_add i 1)))) found)))
(defn dv_find (record key fallback)
  (let (i 0 result fallback)
    (do (while (rt_lt i (rt_count record))
      (let (entry (rt_at record i))
        (do (if (rt_eq (rt_at entry 0) key) (set result (rt_at entry 1)) false) (set i (rt_add i 1))))) result)))
(defn dv_has_key (record key)
  (let (i 0 found false) (do (while (rt_lt i (rt_count record))
    (do (if (rt_eq (rt_at (rt_at record i) 0) key) (set found true) false) (set i (rt_add i 1)))) found)))
(defn dv_record_like (value)
  (if (rt_is_list value)
    (let (i 0 valid true)
      (do (while (dv_and valid (rt_lt i (rt_count value)))
        (let (entry (rt_at value i))
          (do (set valid (if (rt_is_list entry) (rt_eq (rt_count entry) 2) false)) (set i (rt_add i 1))))) valid)) false))
(defn dv_get (record key)
  (do (dv_require (dv_has_key record key) (rt_cat "Missing field: " key)) (dv_find record key false)))
(defn dv_with (record key value)
  (let (r (rt_list) i 0 found false)
    (do (while (rt_lt i (rt_count record))
      (let (entry (rt_at record i))
        (do (if (rt_eq (rt_at entry 0) key)
          (do (rt_push r (dv_pair key (dv_clone value))) (set found true))
          (rt_push r (dv_clone entry))) (set i (rt_add i 1)))))
      (if found false (rt_push r (dv_pair key (dv_clone value)))) r)))
(defn dv_m2 (k1 v1 k2 v2) (dv_pair (dv_pair k1 v1) (dv_pair k2 v2)))
(defn dv_without (record key)
  (let (result (rt_list) i 0)
    (do (while (rt_lt i (rt_count record))
      (let (entry (rt_at record i))
        (do (if (rt_eq (rt_at entry 0) key) false (rt_push result (dv_clone entry))) (set i (rt_add i 1))))) result)))
(defn dv_m3 (k1 v1 k2 v2 k3 v3) (dv_with (dv_m2 k1 v1 k2 v2) k3 v3))
(defn dv_m4 (k1 v1 k2 v2 k3 v3 k4 v4) (dv_with (dv_m3 k1 v1 k2 v2 k3 v3) k4 v4))
(defn dv_unit (x) (do (dv_require (dv_and (rt_not (rt_lt x 0)) (rt_not (rt_lt 1 x))) "Expected weight in [0,1]") x))
(defn dv_unknown ()
  (dv_with (dv_with (dv_m4 "known" false "value" false "confidence" 0 "time" -1) "claims" (rt_list)) "conflicted" false))
(defn dv_cell (value confidence time claims)
  (dv_with (dv_with (dv_with (dv_m4 "known" true "value" (dv_clone value) "confidence" (dv_unit confidence) "time" time) "claims" (rt_list)) "basis" claims) "conflicted" false))
(defn dv_entity_ref (id) (dv_m2 "type" "entity-ref" "id" id))
(defn dv_ref (object_id facet field) (dv_m3 "object" object_id "facet" facet "field" field))
(defn dv_world (id domain subject)
  (do
    (dv_require (dv_or (rt_eq domain "physical") (rt_eq domain "mind")) "Invalid world domain")
    (dv_require (if (rt_eq domain "physical") (rt_eq subject "") (rt_lt 0 (rt_length subject))) "World subject mismatch")
    (dv_with (dv_with (dv_with (dv_with
      (dv_m4 "id" id "domain" domain "subject" subject "revision" 0)
      "objects" (rt_list)) "adoptions" (rt_list)) "history" (rt_list)) "seen" (rt_list))))
(defn dv_domain (world domain) (dv_require (rt_eq (dv_get world "domain") domain) "Wrong world domain"))
(defn dv_object (id kind facets)
  (dv_m3 "id" id "kind" kind "facets"
    (dv_with facets "identity" (dv_with (dv_find facets "identity" (rt_list)) "kind" (if (rt_eq kind "perceived") (dv_unknown) (dv_field kind))))))
(defn dv_add_object (world object)
  (let (objects (dv_get world "objects") id (dv_get object "id"))
    (do (dv_require (rt_not (dv_has_key objects id)) "Duplicate object identity")
      (dv_with (dv_with world "objects" (dv_with objects id object)) "revision" (rt_add (dv_get world "revision") 1)))))
(defn dv_read (world ref)
  (let (objects (dv_get world "objects") id (dv_get ref "object"))
    (if (dv_has_key objects id)
      (let (facets (dv_get (dv_get objects id) "facets") facet (dv_get ref "facet"))
        (if (dv_has_key facets facet) (dv_clone (dv_find (dv_get facets facet) (dv_get ref "field") (dv_unknown))) (dv_unknown)))
      (dv_unknown))))
(defn dv_store (world ref cell)
  (let (objects (dv_get world "objects") id (dv_get ref "object"))
    (do
      (dv_require (dv_has_key objects id) "Unknown object identity")
      (let (object (dv_get objects id) facets (dv_get object "facets") facet (dv_get ref "facet") fields (dv_find facets facet (rt_list)))
        (dv_with world "objects" (dv_with objects id
          (dv_with object "facets" (dv_with facets facet (dv_with fields (dv_get ref "field") cell)))))))))
(defn dv_slice (world object_id facet fields)
  (let (result (rt_list) i 0)
    (do
      (while (rt_lt i (rt_count fields))
        (let (field (rt_at fields i))
          (do (rt_push result (dv_pair field (dv_read world (dv_ref object_id facet field)))) (set i (rt_add i 1)))))
      (dv_with (dv_with (dv_with
        (dv_m4 "world" (dv_get world "id") "domain" (dv_get world "domain") "subject" (dv_get world "subject") "revision" (dv_get world "revision"))
        "object" object_id) "facet" facet) "fields" result))))
(defn dv_field (value) (dv_cell value 1 0 (rt_list)))
(defn dv_uncontested (cell) (dv_and (dv_get cell "known") (rt_not (dv_get cell "conflicted"))))
(defn dv_door (id from to closed held inside outside automatic gap)
  (dv_object id "door"
    (dv_m2 "link" (dv_m2 "from" (dv_field (dv_entity_ref from)) "to" (dv_field (dv_entity_ref to)))
      "mechanical" (dv_with (dv_with (dv_with
        (dv_m4 "closed" (dv_field closed) "held" (dv_field held) "inside_latch" (dv_field inside) "outside_latch" (dv_field outside))
        "automatic" (dv_field automatic)) "gap" (dv_field gap)) "sealed" (dv_field false)))))
(defn dv_channel (id from to medium enabled gain gate)
  (do
    (dv_unit gain)
    (dv_object id "channel"
      (dv_m2 "link" (dv_m4 "from" (dv_field (dv_entity_ref from)) "to" (dv_field (dv_entity_ref to)) "medium" (dv_field medium) "gate" (dv_field gate))
        "transport" (dv_m3 "enabled" (dv_field enabled) "gain" (dv_field gain) "bands" (dv_field (rt_list)))))))

; Ordered multi-field copy update. Inputs and all output branches stay independent.
(defn dv_with_many (record updates)
  (if (rt_eq (rt_count updates) 0) record
  (let (result (rt_list) keys (rt_list) i 0)
    (do
      (while (rt_lt i (rt_count record))
        (let (entry (rt_at record i) key (rt_at (rt_at record i) 0))
          (do
            (if (dv_has_key updates key)
              (rt_push result (dv_pair key (dv_clone (dv_get updates key))))
              (rt_push result (dv_clone entry)))
            (rt_push keys key) (set i (rt_add i 1)))))
      (set i 0)
      (while (rt_lt i (rt_count updates))
        (let (key (rt_at (rt_at updates i) 0))
          (do
            (if (dv_has keys key) false
              (do (rt_push result (dv_pair key (dv_clone (dv_get updates key)))) (rt_push keys key)))
            (set i (rt_add i 1))))) result))))

; Law schema is data. Adoption in each world determines how the schema is used.
(defn dv_true () (dv_m2 "op" "constant" "value" "true"))
(defn dv_fact (ref expected) (dv_m3 "op" "equals" "ref" ref "value" expected))
(defn dv_at_least (ref minimum) (dv_m3 "op" "at_least" "ref" ref "value" minimum))
(defn dv_all (conditions) (dv_m2 "op" "all" "items" conditions))
(defn dv_not (condition) (dv_m2 "op" "not" "item" condition))
(defn dv_truth (world proposition)
  (let (op (dv_get proposition "op"))
    (if (rt_eq op "constant") (dv_get proposition "value")
      (if (rt_eq op "not")
        (let (inner (dv_truth world (dv_get proposition "item")))
          (if (rt_eq inner "unknown") "unknown" (if (rt_eq inner "true") "false" "true")))
        (if (rt_eq op "all")
          (let (items (dv_get proposition "items") i 0 result "true")
            (do (while (rt_lt i (rt_count items))
              (let (truth (dv_truth world (rt_at items i)))
                (do (if (rt_eq truth "false") (set result "false")
                  (if (dv_and (rt_eq truth "unknown") (rt_eq result "true")) (set result "unknown") false)) (set i (rt_add i 1))))) result))
          (let (cell (dv_read world (dv_get proposition "ref")))
            (if (dv_or (rt_not (dv_get cell "known")) (dv_get cell "conflicted")) "unknown"
              (if (rt_eq op "equals")
                (if (dv_same (dv_get cell "value") (dv_get proposition "value")) "true" "false")
                (if (rt_eq op "at_least")
                  (if (rt_lt (dv_get cell "value") (dv_get proposition "value")) "false" "true")
                  (rt_fail "Unknown proposition operator"))))))))))
(defn dv_assign (ref value) (dv_m3 "op" "assign" "ref" ref "value" value))
(defn dv_increment (ref amount) (dv_m3 "op" "increment" "ref" ref "value" amount))
(defn dv_axiom (name version premise effects)
  (dv_m4 "name" name "version" version "premise" (dv_clone premise) "effects" (dv_clone effects)))
(defn dv_instance (id law) (dv_with (dv_with law "schema" (dv_get law "name")) "name" id))
(defn dv_adopt (world law mode confidence basis)
  (do
    (dv_unit confidence)
    (dv_require (if (rt_eq (dv_get world "domain") "physical") (rt_eq confidence 1) true) "Physical laws require certainty")
    (dv_require (rt_lt 0 (rt_count basis)) "Adoption needs a basis")
    (dv_require (rt_not (dv_has_key (dv_get world "adoptions") (dv_get law "name"))) "Duplicate law instance: provide a distinct instance identity")
    (dv_require
      (if (rt_eq (dv_get world "domain") "physical") (rt_eq mode "enforce")
        (dv_and (rt_eq (dv_get world "domain") "mind") (dv_or (rt_eq mode "predict") (dv_or (rt_eq mode "infer") (rt_eq mode "norm")))))
      "Adoption mode is incompatible with world")
    (let (adoption (dv_with (dv_m4 "law" law "mode" mode "confidence" confidence "basis" basis) "active" true))
      (dv_with (dv_with world "adoptions" (dv_with (dv_get world "adoptions") (dv_get law "name") adoption)) "revision" (rt_add (dv_get world "revision") 1)))))
(defn dv_suspend (world name)
  (let (adoptions (dv_get world "adoptions"))
    (dv_with (dv_with world "adoptions" (dv_with adoptions name (dv_with (dv_get adoptions name) "active" false))) "revision" (rt_add (dv_get world "revision") 1))))
(defn dv_reconsider (world law mode confidence basis)
  (let (name (dv_get law "name") previous (dv_get (dv_get world "adoptions") name))
    (let (updated (dv_adopt (dv_with world "adoptions" (dv_without (dv_get world "adoptions") name)) law mode confidence basis))
      (dv_with updated "history" (dv_append (dv_get world "history")
        (dv_m4 "kind" "reconsideration" "previous" previous "current" (dv_get (dv_get updated "adoptions") name) "basis" basis))))))
(defn dv_result (status world changes basis)
  (dv_m4 "status" status "world" (dv_clone world) "changes" changes "basis" basis))
(defn dv_stage (world effects time basis confidence)
  (let (stage (dv_clone world) changes (rt_list) touched (rt_list) i 0 status "ready")
    (do
      (while (dv_and (rt_eq status "ready") (rt_lt i (rt_count effects)))
        (let (effect (rt_at effects i) ref (dv_get effect "ref") op (dv_get effect "op") before (dv_read stage ref))
          (do
            (if (rt_not (dv_has_key (dv_get stage "objects") (dv_get ref "object"))) (set status "unknown-object")
              (if (dv_has touched ref) (set status "duplicate-write")
                (if (dv_and (rt_eq op "increment") (rt_not (dv_get before "known"))) (set status "unknown-state")
                  (do
                    (dv_require (dv_or (rt_eq op "assign") (rt_eq op "increment")) "Unknown effect operator")
                    (let (value (if (rt_eq op "assign") (dv_get effect "value") (rt_add (dv_get before "value") (dv_get effect "value"))))
                      (do
                        (set stage (dv_store stage ref (dv_cell value confidence time basis)))
                        (rt_push changes (dv_m3 "ref" ref "before" before "after" (dv_read stage ref)))
                        (rt_push touched (dv_clone ref))))))))
            (set i (rt_add i 1)))))
      (if (rt_eq status "ready") (dv_result "ready" stage changes basis) (dv_result status world (rt_list) basis)))))
(defn dv_apply_law (world name mode event_id time expected_revision)
  (do
    (dv_require (rt_eq (dv_get world "revision") expected_revision) "Stale world revision")
    (dv_require (rt_not (dv_has (dv_get world "seen") event_id)) "Repeated world event")
    (dv_require (rt_not (rt_lt time (dv_find world "time" 0))) "World time cannot move backwards")
    (let (adoption (dv_get (dv_get world "adoptions") name) law (dv_get adoption "law") basis (dv_get adoption "basis"))
      (if (rt_not (dv_get adoption "active")) (dv_result "not-adopted" world (rt_list) basis)
        (if (rt_not (rt_eq (dv_get adoption "mode") mode)) (dv_result "wrong-adoption-mode" world (rt_list) basis)
          (let (truth (dv_truth world (dv_get law "premise")))
            (if (rt_not (rt_eq truth "true")) (dv_result (rt_cat "premise-" truth) world (rt_list) basis)
              (let (staged (dv_stage world (dv_get law "effects") time basis (dv_get adoption "confidence")))
                (if (rt_not (rt_eq (dv_get staged "status") "ready")) staged
                  (let (next (dv_get staged "world") revision (rt_add expected_revision 1)
                        event (dv_with (dv_with (dv_m4 "id" event_id "time" time "law" name "law_version" (dv_get law "version")) "changes" (dv_get staged "changes")) "basis" basis))
                    (do
                      (set next (dv_with (dv_with (dv_with (dv_with next "revision" revision) "seen" (dv_append (dv_get next "seen") event_id)) "history" (dv_append (dv_get next "history") event)) "time" time))
                      (dv_with (dv_with (dv_result "applied" next (dv_get staged "changes") basis) "event" event_id) "time" time))))))))))))
(defn dv_execute (physical name event_id time expected_revision)
  (do (dv_domain physical "physical") (dv_apply_law physical name "enforce" event_id time expected_revision)))
(defn dv_predict (mind name event_id time expected_revision)
  (do
    (dv_domain mind "mind")
    (let (result (dv_apply_law mind name "predict" event_id time expected_revision))
      (dv_with (dv_with result "world" (dv_with (dv_with (dv_get result "world") "domain" "prediction") "source_revision" expected_revision)) "source_revision" expected_revision))))
(defn dv_infer (mind name event_id time expected_revision)
  (do (dv_domain mind "mind") (dv_apply_law mind name "infer" event_id time expected_revision)))
(defn dv_norm (mind name)
  (do (dv_domain mind "mind")
    (let (adoption (dv_get (dv_get mind "adoptions") name))
      (do (dv_require (rt_eq (dv_get adoption "mode") "norm") "Not a normative adoption")
        (if (dv_get adoption "active") (dv_truth mind (dv_get (dv_get adoption "law") "premise")) "unknown")))))

; Observation adaptation is an explicit trusted boundary. Minds receive no world pointer.
(defn dv_binding (physical local subject) (dv_m3 "physical" physical "local" local "subject" subject))
(defn dv_local (bindings physical subject)
  (let (i 0 result "")
    (do (while (rt_lt i (rt_count bindings))
      (let (binding (rt_at bindings i))
        (do (if (dv_and (rt_eq (dv_get binding "physical") physical) (rt_eq (dv_get binding "subject") subject))
          (do (dv_require (rt_eq result "") "Ambiguous projection binding") (set result (dv_get binding "local"))) false)
          (set i (rt_add i 1))))) result)))
(defn dv_validate_bindings (bindings subject)
  (let (i 0 locals (rt_list) physicals (rt_list))
    (do (while (rt_lt i (rt_count bindings))
      (let (b (rt_at bindings i))
        (do
          (if (rt_eq (dv_get b "subject") subject)
            (do
              (dv_require (rt_lt 0 (rt_length (dv_get b "local"))) "Empty local identity")
              (dv_require (rt_not (dv_has locals (dv_get b "local"))) "Local projection cannot bind two objects")
              (dv_require (rt_not (dv_has physicals (dv_get b "physical"))) "Ambiguous physical binding")
              (rt_push locals (dv_get b "local")) (rt_push physicals (dv_get b "physical"))) false)
          (set i (rt_add i 1))))) true)))
(defn dv_project_value (value bindings subject)
  (if (rt_is_list value)
    (if (if (dv_record_like value) (dv_same (dv_find value "type" "") "entity-ref") false)
      (let (local (dv_local bindings (dv_get value "id") subject))
        (if (rt_eq local "") (dv_m2 "known" false "value" false) (dv_m2 "known" true "value" (dv_entity_ref local))))
      (let (i 0 items (rt_list) known true)
        (do (while (rt_lt i (rt_count value))
          (let (projected (dv_project_value (rt_at value i) bindings subject))
            (do (set known (dv_and known (dv_get projected "known"))) (rt_push items (dv_get projected "value")) (set i (rt_add i 1)))))
          (dv_m2 "known" known "value" items))))
    (dv_m2 "known" true "value" value)))
(defn dv_observation (id subject ref value source origin time trust dependency)
  (do
    (dv_unit trust)
    (dv_require (rt_not (rt_lt time 0)) "Negative observation time")
    (dv_require (dv_has (dv_list3 "perception" "testimony" "recall") source)
      "Direct observations use perception, testimony or recall; inference uses adopted rules")
    (dv_with (dv_with (dv_with (dv_with (dv_with
      (dv_m4 "id" id "subject" subject "ref" ref "value" (dv_clone value))
      "source" source) "origin" origin) "time" time) "trust" trust) "dependency" dependency)))
(defn dv_perceive (physical mind bindings grants event_id time)
  (do
    (dv_domain physical "physical") (dv_domain mind "mind")
    (dv_validate_bindings bindings (dv_get mind "subject"))
    (let (observations (rt_list) i 0 subject (dv_get mind "subject"))
      (do (while (rt_lt i (rt_count grants))
        (let (ref (rt_at grants i) local (dv_local bindings (dv_get ref "object") subject) cell (dv_read physical ref))
          (do
            (if (dv_and (rt_not (rt_eq local "")) (dv_get cell "known"))
              (let (mapped (dv_project_value (dv_get cell "value") bindings subject)
                    local_ref (dv_ref local (dv_get ref "facet") (dv_get ref "field")))
                (if (dv_get mapped "known")
                  (rt_push observations (dv_observation (dv_list3 event_id subject local_ref) subject local_ref (dv_get mapped "value")
                    "perception" "direct" time 1 (dv_pair event_id local_ref))) false)) false)
            (set i (rt_add i 1))))) observations))))
(defn dv_perceive_changes (receipt mind bindings grants)
  (do
    (dv_require (rt_eq (dv_get receipt "status") "applied") "Only applied world changes can be perceived")
    (let (changes (dv_get receipt "changes") exposed (rt_list) i 0)
      (do (while (rt_lt i (rt_count changes))
        (let (ref (dv_get (rt_at changes i) "ref"))
          (do (if (dv_has grants ref) (rt_push exposed ref) false) (set i (rt_add i 1)))))
        (dv_perceive (dv_get receipt "world") mind bindings exposed (dv_get receipt "event") (dv_get receipt "time"))))))
(defn dv_observation_profile (source_weights threshold)
  (dv_m2 "weights" source_weights "threshold" (dv_unit threshold)))
(defn dv_weight (observation profile)
  (let (weight (dv_get (dv_get profile "weights") (dv_get observation "source")))
    (do (dv_require (rt_not (rt_lt weight 0)) "Negative evidence weight") (rt_mul weight (dv_unit (dv_get observation "trust"))))))
(defn dv_replace_claim (claims observation)
  (let (result (rt_list) i 0)
    (do (while (rt_lt i (rt_count claims))
      (let (old (rt_at claims i))
        (do (if (dv_same (dv_get old "dependency") (dv_get observation "dependency")) false (rt_push result (dv_clone old))) (set i (rt_add i 1)))))
      (rt_push result (dv_clone observation)) result)))
(defn dv_aggregate (claims profile time)
  (let (alternatives (rt_list) i 0 total 0 best 0 chosen false)
    (do
      (while (rt_lt i (rt_count claims))
        (let (claim (rt_at claims i) weight (dv_weight claim profile) value (dv_get claim "value") j 0 found false new_items (rt_list))
          (do
            (while (rt_lt j (rt_count alternatives))
              (let (alternative (rt_at alternatives j))
                (do
                  (if (dv_same (rt_at alternative 0) value)
                    (do (rt_push new_items (dv_pair value (rt_add (rt_at alternative 1) weight))) (set found true))
                    (rt_push new_items alternative)) (set j (rt_add j 1)))))
            (if (dv_or found (rt_eq weight 0)) false (rt_push new_items (dv_pair value weight)))
            (set alternatives new_items) (set total (rt_add total weight)) (set i (rt_add i 1)))))
      (set i 0)
      (let (distribution (rt_list))
        (do
          (while (rt_lt i (rt_count alternatives))
            (let (alternative (rt_at alternatives i) weight (rt_at alternative 1))
              (do
                (if (rt_lt best weight) (do (set best weight) (set chosen (rt_at alternative 0))) false)
                (rt_push distribution (dv_pair (rt_at alternative 0) (rt_div weight total)))
                (set i (rt_add i 1)))))
          (let (confidence (if (rt_eq total 0) 0 (rt_div best total)) cell (dv_cell chosen confidence time claims))
            (dv_with (dv_with (dv_with (dv_with cell "known" (dv_and (rt_lt 0 total) (rt_not (rt_lt confidence (dv_get profile "threshold")))))
              "conflicted" (rt_lt 1 (rt_count alternatives))) "claims" claims) "alternatives" distribution)))))))
(defn dv_update_mind (mind observations expected_revision profile)
  (do
    (dv_domain mind "mind")
    (dv_require (rt_eq (dv_get mind "revision") expected_revision) "Stale cognition revision")
    (let (next (dv_clone mind) i 0 accepted (rt_list) dispositions (rt_list))
      (do
        (while (rt_lt i (rt_count observations))
          (let (observation (rt_at observations i) id (dv_get observation "id") ref (dv_get observation "ref") object_id (dv_get ref "object"))
            (do
              (dv_require (rt_eq (dv_get observation "subject") (dv_get mind "subject")) "Foreign observation")
              (dv_require (rt_not (dv_has (dv_get next "seen") id)) "Repeated observation")
              (dv_weight observation profile)
              (if (dv_has_key (dv_get next "objects") object_id) false
                (set next (dv_add_object next (dv_object object_id "perceived" (rt_list)))))
              (let (old (dv_read next ref) time (dv_get observation "time"))
                (if (rt_lt time (dv_get old "time")) (rt_push dispositions (dv_pair id "older-than-current"))
                  (let (claims (if (rt_lt (dv_get old "time") time) (rt_list) (dv_get old "claims")))
                    (do
                      (set next (dv_store next ref (dv_aggregate (dv_replace_claim claims observation) profile time)))
                      (rt_push dispositions (dv_pair id "updated"))))))
              (set next (dv_with next "seen" (dv_append (dv_get next "seen") id)))
              (rt_push accepted (dv_clone observation))
              (set i (rt_add i 1)))))
        (set next (dv_with next "revision" (if (rt_eq (rt_count observations) 0) expected_revision (rt_add expected_revision 1))))
        (set next (dv_with next "history" (dv_append (dv_get mind "history") (dv_m3 "kind" "observation-batch" "observations" accepted "dispositions" dispositions))))
        (dv_m3 "world" next "dispositions" dispositions "revision" (dv_get next "revision"))))))

; Signals are segmented by the author/host. No hidden reconstruction of lost words.
(defn dv_segment (content strength band) (dv_m3 "content" content "strength" strength "band" band))
(defn dv_signal (location medium segments) (dv_m3 "location" (dv_entity_ref location) "medium" medium "segments" segments))
(defn dv_filter_signal (segments gain threshold bands)
  (let (result (rt_list) i 0)
    (do (while (rt_lt i (rt_count segments))
      (let (segment (rt_at segments i) strength (rt_mul (dv_get segment "strength") gain))
        (do
          (if (dv_and (rt_not (rt_lt strength threshold)) (dv_or (rt_eq (rt_count bands) 0) (dv_has bands (dv_get segment "band"))))
            (rt_push result (dv_segment (dv_get segment "content") strength (dv_get segment "band"))) false)
          (set i (rt_add i 1))))) result)))
(defn dv_transport (world path signal threshold)
  (do
    (dv_require (rt_not (rt_lt threshold 0)) "Negative perception threshold")
    (let (i 0 location (dv_get signal "location") segments (dv_clone (dv_get signal "segments")) status "delivered" trace (rt_list))
      (do
        (while (dv_and (rt_eq status "delivered") (rt_lt i (rt_count path)))
          (let (channel (rt_at path i) objects (dv_get world "objects"))
            (do
              (dv_require (dv_has_key objects channel) "Unknown channel")
              (dv_require (rt_eq (dv_truth world (dv_fact (dv_ref channel "identity" "kind") "channel")) "true") "Transport object must be known as a channel")
              (let (from (dv_read world (dv_ref channel "link" "from"))
                    to (dv_read world (dv_ref channel "link" "to"))
                    medium (dv_read world (dv_ref channel "link" "medium"))
                    gate (dv_read world (dv_ref channel "link" "gate"))
                    enabled (dv_read world (dv_ref channel "transport" "enabled"))
                    gain (dv_read world (dv_ref channel "transport" "gain")))
                (if (dv_and (dv_and (dv_uncontested from) (dv_uncontested to))
                      (dv_and (dv_and (dv_uncontested medium) (dv_uncontested gate)) (dv_and (dv_uncontested enabled) (dv_uncontested gain))))
                  (do
                    (dv_require (dv_same location (dv_get from "value")) "Discontinuous channel path")
                    (dv_require (rt_eq (dv_get signal "medium") (dv_get medium "value")) "Channel medium mismatch")
                    (let (gate_truth (dv_truth world (dv_get gate "value")))
                      (if (dv_and (dv_get enabled "value") (rt_eq gate_truth "true"))
                        (let (bands_cell (dv_read world (dv_ref channel "transport" "bands")))
                          (if (dv_uncontested bands_cell)
                            (do
                              (set segments (dv_filter_signal segments (dv_unit (dv_get gain "value")) threshold (dv_get bands_cell "value")))
                              (set location (dv_get to "value"))
                              (rt_push trace channel))
                            (set status "unknown")))
                        (set status (if (rt_eq gate_truth "unknown") "unknown" "blocked")))))
                  (set status "unknown")))
              (set i (rt_add i 1)))))
        (dv_with (dv_m4 "status" status "location" location "segments" (if (rt_eq status "delivered") segments (rt_list)) "trace" trace)
          "world_revision" (dv_get world "revision"))))))
(defn dv_hear (delivery subject local_ref perceived_origin event_id time)
  (do
    (dv_require (rt_eq (dv_get delivery "status") "delivered") "No delivered signal")
    (dv_require (rt_eq (dv_find delivery "hypothetical" true) false) "Predicted or unauthorised transmission cannot become perception")
    (dv_observation event_id subject local_ref (dv_get delivery "segments") "perception" perceived_origin time 1 event_id)))
(defn dv_transport_theory (law) (dv_with law "operation" "attenuate-filter"))
(defn dv_transmit (world law_name path signal threshold)
  (let (adoption (dv_get (dv_get world "adoptions") law_name) law (dv_get adoption "law"))
    (do
      (dv_require (dv_get adoption "active") "Transmission law is not active")
      (dv_require (rt_eq (dv_get law "operation") "attenuate-filter") "Not a transport theory")
      (dv_require (if (rt_eq (dv_get world "domain") "physical") (rt_eq (dv_get adoption "mode") "enforce")
        (dv_and (rt_eq (dv_get world "domain") "mind") (rt_eq (dv_get adoption "mode") "predict"))) "Wrong transmission adoption")
      (dv_require (rt_eq (dv_truth world (dv_get law "premise")) "true") "Transmission premise is not established")
      (dv_with (dv_with (dv_transport world path signal threshold) "basis" (dv_get adoption "basis")) "hypothetical" (rt_not (rt_eq (dv_get world "domain") "physical"))))))

; Value is computed against an explicit rubric, not a truth or legality judgement.
(defn dv_criterion (id ref mode target weight)
  (do
    (dv_require (dv_or (rt_eq mode "numeric") (rt_eq mode "matches")) "Unsupported value criterion")
    (dv_with (dv_m4 "id" id "ref" ref "mode" mode "target" target) "weight" weight)))
(defn dv_measure (value criterion)
  (if (rt_eq (dv_get criterion "mode") "numeric") (rt_mul value (dv_get criterion "weight"))
    (if (dv_same value (dv_get criterion "target")) (dv_get criterion "weight") 0)))
(defn dv_expected_measure (cell criterion)
  (let (alternatives (dv_find cell "alternatives" (rt_list)) sum 0 i 0)
    (if (rt_eq (rt_count alternatives) 0)
      (rt_mul (dv_measure (dv_get cell "value") criterion) (dv_get cell "confidence"))
      (do (while (rt_lt i (rt_count alternatives))
        (let (alternative (rt_at alternatives i))
          (do (set sum (rt_add sum (rt_mul (dv_measure (rt_at alternative 0) criterion) (rt_at alternative 1)))) (set i (rt_add i 1))))) sum))))
(defn dv_value (world criteria subjective)
  (let (i 0 score 0 details (rt_list) unknown (rt_list) ids (rt_list))
    (do
      (while (rt_lt i (rt_count criteria))
        (let (criterion (rt_at criteria i) id (dv_get criterion "id") cell (dv_read world (dv_get criterion "ref")))
          (do
            (dv_require (rt_not (dv_has ids id)) "Duplicate value criterion") (rt_push ids id)
            (if (dv_get cell "known")
              (let (amount (if subjective (dv_expected_measure cell criterion) (dv_measure (dv_get cell "value") criterion)))
                (do (set score (rt_add score amount))
                  (rt_push details (dv_m4 "criterion" id "contribution" amount "confidence" (dv_get cell "confidence") "conflicted" (dv_get cell "conflicted")))))
              (rt_push unknown id))
            (set i (rt_add i 1)))))
      (dv_with (dv_with (dv_with (dv_m4 "score" score "details" details "unknown" unknown "complete" (rt_eq (rt_count unknown) 0))
        "world" (dv_get world "id")) "revision" (dv_get world "revision")) "subject" (dv_get world "subject")))))
(defn dv_value_subjective (mind criteria)
  (do (dv_require (dv_or (rt_eq (dv_get mind "domain") "mind") (rt_eq (dv_get mind "domain") "prediction")) "Subjective value requires a mind or prediction")
    (dv_value mind criteria true)))
(defn dv_value_objective (physical criteria) (do (dv_domain physical "physical") (dv_value physical criteria false)))
(defn dv_value_change (before after criteria)
  (do
    (dv_require (dv_and (rt_eq (dv_get before "id") (dv_get after "id")) (rt_eq (dv_get before "subject") (dv_get after "subject"))) "Value comparison crosses worlds")
    (let (subjective (rt_not (rt_eq (dv_get before "domain") "physical")))
      (do
        (dv_require (if subjective (dv_and (rt_eq (dv_get before "domain") "mind") (dv_or (rt_eq (dv_get after "domain") "mind") (rt_eq (dv_get after "domain") "prediction"))) (rt_eq (dv_get after "domain") "physical")) "Value domain mismatch")
        (let (a (dv_value before criteria subjective) b (dv_value after criteria subjective))
          (dv_m4 "delta" (rt_sub (dv_get b "score") (dv_get a "score")) "before" a "after" b "complete" (dv_and (dv_get a "complete") (dv_get b "complete"))))))))

; Appraisal-inspired game mechanism, not a clinical or psychometric model.
; Intent, instrumental value and expression are separate outputs.
(defn dv_request (id requester self)
  (dv_m3 "id" id "requester" requester "self" self))
(defn dv_feature_refs (request)
  (let (speaker (dv_get request "requester") self (dv_get request "self") id (dv_get request "id") refs (rt_list))
    (do
      (rt_push refs (dv_pair "trust" (dv_ref speaker "relationship" "trust")))
      (rt_push refs (dv_pair "closeness" (dv_ref speaker "relationship" "closeness")))
      (rt_push refs (dv_pair "respect" (dv_ref speaker "relationship" "respect")))
      (rt_push refs (dv_pair "reciprocity" (dv_ref speaker "relationship" "reciprocity")))
      (rt_push refs (dv_pair "valence" (dv_ref self "affect" "valence")))
      (rt_push refs (dv_pair "arousal" (dv_ref self "affect" "arousal")))
      (rt_push refs (dv_pair "fatigue" (dv_ref self "resources" "fatigue")))
      (rt_push refs (dv_pair "stress" (dv_ref self "resources" "stress")))
      (rt_push refs (dv_pair "attention" (dv_ref self "resources" "attention")))
      (rt_push refs (dv_pair "threat" (dv_ref id "appraisal" "threat")))
      (rt_push refs (dv_pair "fairness" (dv_ref id "appraisal" "fairness")))
      (rt_push refs (dv_pair "control" (dv_ref id "appraisal" "control")))
      (rt_push refs (dv_pair "certainty" (dv_ref id "appraisal" "certainty")))
      (rt_push refs (dv_pair "importance" (dv_ref id "appraisal" "importance"))) refs)))
(defn dv_appraise_request (mind request)
  (do
    (dv_domain mind "mind")
    (let (refs (dv_feature_refs request) features (rt_list) unknown (rt_list) basis (rt_list) i 0)
      (do
        (while (rt_lt i (rt_count refs))
          (let (entry (rt_at refs i) key (rt_at entry 0) cell (dv_read mind (rt_at entry 1)))
            (do
              (if (dv_and (dv_get cell "known") (rt_not (dv_get cell "conflicted")))
                (do
                  (rt_push features (dv_pair key (dv_get cell "value")))
                  (rt_push basis (dv_m3 "feature" key "ref" (rt_at entry 1) "cell" cell)))
                (rt_push unknown key))
              (set i (rt_add i 1)))))
        (dv_with (dv_with (dv_m4 "features" features "unknown" unknown "basis" basis "revision" (dv_get mind "revision")) "subject" (dv_get mind "subject")) "request" (dv_get request "id"))))))
(defn dv_dot (features weights)
  (let (i 0 score 0 terms (rt_list) unknown (rt_list))
    (do
      (while (rt_lt i (rt_count weights))
        (let (entry (rt_at weights i) key (rt_at entry 0))
          (do
            (if (dv_has_key features key)
              (let (contribution (rt_mul (dv_get features key) (rt_at entry 1)))
                (do (set score (rt_add score contribution)) (rt_push terms (dv_pair key contribution))))
              (rt_push unknown key))
            (set i (rt_add i 1)))))
      (dv_m3 "score" score "terms" terms "unknown" unknown))))
(defn dv_clamp_signed (value) (if (rt_lt value -1) -1 (if (rt_lt 1 value) 1 value)))
(defn dv_expression (appraisal expression_policy)
  (let (axes (rt_list) i 0)
    (do
      (while (rt_lt i (rt_count expression_policy))
        (let (axis (rt_at expression_policy i) evaluation (dv_dot (dv_get appraisal "features") (rt_at axis 1)))
          (do (rt_push axes (dv_pair (rt_at axis 0) (dv_with (dv_with evaluation "value" (dv_clamp_signed (dv_get evaluation "score"))) "complete" (rt_eq (rt_count (dv_get evaluation "unknown")) 0)))) (set i (rt_add i 1))))) axes)))
(defn dv_no_change_prediction (mind)
  (do (dv_domain mind "mind") (dv_with (dv_with mind "domain" "prediction") "source_revision" (dv_get mind "revision"))))
(defn dv_response_option (id intent feasible prediction effort feature_weights)
  (do
    (dv_require (rt_not (rt_lt effort 0)) "Negative effort")
    (dv_with (dv_with (dv_m4 "id" id "intent" intent "feasible" feasible "prediction" prediction) "effort" effort) "feature_weights" feature_weights)))
(defn dv_validate_expression_policy (expression_policy)
  (do (dv_require (dv_record_like expression_policy) "Expression policy must be an axis-to-weight-record matrix")
    (let (i 0)
      (do (while (rt_lt i (rt_count expression_policy))
        (let (axis (rt_at expression_policy i) key (rt_at (rt_at expression_policy i) 0) weights (rt_at (rt_at expression_policy i) 1) j 0)
          (do (dv_require (rt_eq (rt_slice (rt_json_stringify key) 0 1) "\"") "Expression policy axis name must be Text")
            (dv_require (dv_record_like weights) (rt_cat "Expression policy axis weights must be a record: " key))
            (while (rt_lt j (rt_count weights))
              (let (weight (rt_at weights j) feature (rt_at (rt_at weights j) 0))
                (do (dv_require (rt_eq (rt_slice (rt_json_stringify feature) 0 1) "\"") "Expression policy feature name must be Text")
                  (dv_require (rt_is_number (rt_json_stringify (rt_at weight 1)))
                    (rt_cat (rt_cat (rt_cat "Expression policy weight must be a finite Number: " key) ".") feature))
                  (set j (rt_add j 1))))) (set i (rt_add i 1))))) true))))
(defn dv_person_policy (subject values effort_cost uncertainty_cost expression_policy)
  (do
    (dv_validate_expression_policy expression_policy)
    (dv_require (dv_and (rt_not (rt_lt effort_cost 0)) (rt_not (rt_lt uncertainty_cost 0))) "Negative policy cost")
    (dv_with (dv_m4 "subject" subject "values" values "effort_cost" effort_cost "uncertainty_cost" uncertainty_cost) "expression" expression_policy)))
(defn dv_accept_policy (mind id policy basis)
  (do
    (dv_domain mind "mind")
    (dv_require (rt_eq (dv_get mind "subject") (dv_get policy "subject")) "Foreign value policy")
    (dv_require (rt_lt 0 (rt_count basis)) "Value policy needs an acceptance basis")
    (let (policies (dv_find mind "policies" (rt_list)))
      (do
        (dv_require (rt_not (dv_has_key policies id)) "Duplicate accepted policy")
        (dv_with (dv_with mind "policies" (dv_with policies id (dv_m3 "policy" policy "basis" basis "active" true)))
          "revision" (rt_add (dv_get mind "revision") 1))))))
(defn dv_respond_adopted (mind request options policy_id)
  (let (accepted (dv_get (dv_get mind "policies") policy_id))
    (do (dv_require (dv_get accepted "active") "Response policy is not adopted")
      (dv_with (dv_respond mind request options (dv_get accepted "policy")) "policy_basis" (dv_get accepted "basis")))))
(defn dv_response_score (mind option appraisal policy)
  (let (prediction (dv_get option "prediction"))
    (do
      (dv_domain prediction "prediction")
      (dv_require (rt_eq (dv_get prediction "source_revision") (dv_get mind "revision")) "Stale response prediction")
      (let (value (dv_value_change mind prediction (dv_get policy "values"))
            relation_and_state (dv_dot (dv_get appraisal "features") (dv_get option "feature_weights"))
            effort (rt_mul (dv_get option "effort") (dv_get policy "effort_cost"))
            uncertainty (rt_mul (rt_add (rt_count (dv_get relation_and_state "unknown")) (rt_count (dv_get (dv_get value "after") "unknown"))) (dv_get policy "uncertainty_cost")))
        (dv_with
          (dv_m4 "score" (rt_sub (rt_add (dv_get value "delta") (dv_get relation_and_state "score")) (rt_add effort uncertainty))
            "value" value "relationship_and_state" relation_and_state "effort" effort)
          "uncertainty_cost" uncertainty)))))
(defn dv_respond (mind request options policy)
  (do
    (dv_domain mind "mind")
    (dv_require (rt_eq (dv_get mind "subject") (dv_get policy "subject")) "Foreign person policy")
    (let (appraisal (dv_appraise_request mind request) i 0 found false best 0 chosen false evaluated (rt_list) rejected (rt_list) ids (rt_list))
      (do
        (while (rt_lt i (rt_count options))
          (let (option (rt_at options i) id (dv_get option "id") legal (dv_truth mind (dv_get option "feasible")))
            (do
              (dv_require (rt_not (dv_has ids id)) "Duplicate response identity") (rt_push ids id)
              (if (rt_eq legal "true")
                (let (evaluation (dv_response_score mind option appraisal policy))
                  (do
                    (rt_push evaluated (dv_pair id evaluation))
                    (if (if found (rt_lt best (dv_get evaluation "score")) true)
                      (do (set found true) (set best (dv_get evaluation "score")) (set chosen option)) false)))
                (rt_push rejected (dv_pair id legal)))
              (set i (rt_add i 1)))))
        (dv_with (dv_with (dv_with
          (dv_m4 "status" (if found "selected" "no-response") "choice" chosen "appraisal" appraisal "evaluated" evaluated)
          "rejected" rejected) "expression" (dv_expression appraisal (dv_get policy "expression"))) "committed" false)))))
(defn dv_relax (current baseline retention)
  (rt_add baseline (rt_mul (rt_sub current baseline) (dv_unit retention))))
(defn dv_affect_proposal (mind request policy)
  (let (appraisal (dv_appraise_request mind request) features (dv_get appraisal "features") self (dv_get request "self")
        valence_ref (dv_ref self "affect" "valence") arousal_ref (dv_ref self "affect" "arousal")
        valence (dv_read mind valence_ref) arousal (dv_read mind arousal_ref))
    (do
      (dv_require (dv_and (dv_get valence "known") (dv_get arousal "known")) "Unknown current affect")
      (let (v_delta (dv_dot features (dv_get policy "valence_weights")) a_delta (dv_dot features (dv_get policy "arousal_weights")))
        (dv_m3 "source_revision" (dv_get mind "revision") "basis" appraisal
          "effects" (dv_pair
            (dv_assign valence_ref (dv_clamp_signed (rt_add
              (dv_relax (dv_get valence "value") (dv_get policy "baseline_valence") (dv_get policy "retention")) (dv_get v_delta "score"))))
            (dv_assign arousal_ref (dv_clamp_signed (rt_add
              (dv_relax (dv_get arousal "value") (dv_get policy "baseline_arousal") (dv_get policy "retention")) (dv_get a_delta "score"))))))))))

; Generic operational axioms. No chapter identities, answers or authored dialogue.
(axiom door_open 1 (door)
  (dv_all (dv_pair (dv_fact (dv_ref door "mechanical" "inside_latch") false)
                  (dv_fact (dv_ref door "mechanical" "outside_latch") false)))
  (dv_single (dv_assign (dv_ref door "mechanical" "closed") false)))
(axiom door_self_close 1 (door)
  (dv_all (dv_pair (dv_fact (dv_ref door "mechanical" "automatic") true)
                  (dv_fact (dv_ref door "mechanical" "held") false)))
  (dv_pair (dv_assign (dv_ref door "mechanical" "closed") true)
           (dv_assign (dv_ref door "mechanical" "gap") 0)))
(axiom door_latch 1 (door)
  (dv_fact (dv_ref door "mechanical" "closed") true)
  (dv_single (dv_assign (dv_ref door "mechanical" "inside_latch") true)))
(axiom door_seal 1 (door)
  (dv_fact (dv_ref door "mechanical" "closed") true)
  (dv_single (dv_assign (dv_ref door "mechanical" "sealed") true)))
(axiom channel_reconfigure 1 (channel gain)
  (dv_true)
  (dv_single (dv_assign (dv_ref channel "transport" "gain") (dv_unit gain))))
(axiom channel_flow 1 (channel)
  (dv_fact (dv_ref channel "transport" "enabled") true)
  (rt_list))

; Validity is checked before cost. Cost is not truth, probability or action utility.
(defn dv_proof_step (id kind conclusion parents law)
  (dv_with (dv_m4 "id" id "kind" kind "conclusion" conclusion "parents" parents) "law" law))
(defn dv_cost_policy (step evidence assumption conflict reference maximum allow_assumptions budget)
  (do
    (dv_require (dv_and (dv_and (rt_not (rt_lt step 0)) (rt_not (rt_lt evidence 0)))
      (dv_and (dv_and (rt_lt 0 assumption) (rt_not (rt_lt conflict 0))) (dv_and (rt_lt 0 reference) (rt_not (rt_lt maximum 0))))) "Invalid reasoning costs")
    (dv_require (rt_lt 0 budget) "Invalid proof budget")
    (dv_with (dv_with (dv_with (dv_with (dv_m4 "step" step "evidence" evidence "assumption" assumption "conflict" conflict)
      "reference" reference) "maximum" maximum) "allow_assumptions" allow_assumptions) "budget" budget)))
(defn dv_min (a b) (if (rt_lt a b) a b))
(defn dv_premise_confidence (world proposition)
  (let (op (dv_get proposition "op"))
    (if (rt_eq op "constant") 1
      (if (rt_eq op "not") (dv_premise_confidence world (dv_get proposition "item"))
        (if (rt_eq op "all")
          (let (items (dv_get proposition "items") i 0 confidence 1)
            (do (while (rt_lt i (rt_count items))
              (do (set confidence (dv_min confidence (dv_premise_confidence world (rt_at items i)))) (set i (rt_add i 1)))) confidence))
          (dv_get (dv_read world (dv_get proposition "ref")) "confidence"))))))
(defn dv_rule_concludes (law conclusion)
  (let (effects (dv_get law "effects") i 0 found false)
    (do (while (rt_lt i (rt_count effects))
      (let (effect (rt_at effects i))
        (do (if (rt_eq (dv_get effect "op") "assign")
          (if (dv_same conclusion (dv_fact (dv_get effect "ref") (dv_get effect "value"))) (set found true) false) false)
          (set i (rt_add i 1))))) found)))
(defn dv_match_premises (premise supplied)
  (if (dv_same premise (dv_true)) (rt_eq (rt_count supplied) 0)
    (if (rt_eq (dv_get premise "op") "all")
      (let (required (dv_get premise "items") i 0 valid (rt_eq (rt_count supplied) (rt_count required)))
        (do (while (rt_lt i (rt_count required))
          (do (set valid (dv_and valid (dv_has supplied (rt_at required i)))) (set i (rt_add i 1)))) valid))
      (dv_same supplied (dv_single premise)))))
(defn dv_check_step (world step checked policy)
  (let (kind (dv_get step "kind") conclusion (dv_get step "conclusion") parents (dv_get step "parents")
        supplied (rt_list) confidence 1 i 0 hypothetical false)
    (do
      (while (rt_lt i (rt_count parents))
        (let (parent (dv_get checked (rt_at parents i)))
          (do (rt_push supplied (dv_get parent "conclusion"))
            (set confidence (dv_min confidence (dv_get parent "confidence")))
            (set hypothetical (dv_or hypothetical (dv_get parent "hypothetical")))
            (set i (rt_add i 1)))))
      (let (assumptions 0 conflicts 0 local_uncertainty 0)
        (do
          (if (rt_eq kind "known")
            (do
              (dv_require (rt_eq (rt_count parents) 0) "Known premise cannot hide parents")
              (dv_require (rt_eq (dv_truth world conclusion) "true") "Conclusion is not available in this view")
              (set confidence (dv_premise_confidence world conclusion))
              (set local_uncertainty (rt_sub 1 confidence)))
            (if (rt_eq kind "assume")
              (do
                (dv_require (rt_eq (rt_count parents) 0) "Assumption cannot hide parents")
                (dv_require (dv_and (dv_get policy "allow_assumptions") (rt_not (rt_eq (dv_get world "domain") "physical"))) "Assumption not permitted")
                (set hypothetical true) (set assumptions 1) (set confidence 0)
                (if (rt_eq (dv_truth world conclusion) "false") (set conflicts 1) false))
              (if (rt_eq kind "axiom")
                (let (adoption (dv_get (dv_get world "adoptions") (dv_get step "law")) law (dv_get adoption "law"))
                  (do
                    (dv_require (dv_get adoption "active") "Proof uses a suspended axiom")
                    (dv_require (rt_eq (dv_get adoption "mode") "infer") "Operational effects do not prove that an event occurred")
                    (dv_require (dv_rule_concludes law conclusion) "Axiom does not conclude this proposition")
                    (dv_require (dv_match_premises (dv_get law "premise") supplied) "Axiom premises are not established")
                    (set confidence (dv_min confidence (dv_get adoption "confidence")))
                    (set local_uncertainty (rt_sub 1 (dv_get adoption "confidence")))))
                (rt_fail "Unsupported proof step"))))
          (dv_with (dv_with (dv_with (dv_with (dv_with (dv_clone step) "confidence" confidence) "hypothetical" hypothetical)
            "assumptions" assumptions) "conflicts" conflicts) "local_uncertainty" local_uncertainty))))))
(defn dv_judge_conclusion (world conclusion proof policy)
  (do
    (dv_require (rt_lt 0 (rt_count proof)) "Empty derivation")
    (dv_require (rt_not (rt_lt (dv_get policy "budget") (rt_count proof))) "Derivation budget exhausted")
    (let (checked (rt_list) i 0)
      (do
        (while (rt_lt i (rt_count proof))
          (let (step (rt_at proof i) id (dv_get step "id"))
            (do
              (dv_require (rt_not (dv_has_key checked id)) "Repeated proof node identity")
              (set checked (dv_with checked id (dv_check_step world step checked policy)))
              (set i (rt_add i 1)))))
        (let (root (dv_get checked (dv_get (rt_at proof (rt_sub (rt_count proof) 1)) "id"))
              queue (dv_single (dv_get root "id")) visited (rt_list) cursor 0 steps 0 uncertainty 0 assumptions 0 conflicts 0)
          (do
            (dv_require (dv_same conclusion (dv_get root "conclusion")) "Derivation concludes another proposition")
            (while (rt_lt cursor (rt_count queue))
              (let (id (rt_at queue cursor))
                (do
                  (if (dv_has visited id) false
                    (let (step (dv_get checked id) parents (dv_get step "parents") p 0)
                      (do
                        (rt_push visited id) (set steps (rt_add steps 1))
                        (set uncertainty (rt_add uncertainty (dv_get step "local_uncertainty")))
                        (set assumptions (rt_add assumptions (dv_get step "assumptions")))
                        (set conflicts (rt_add conflicts (dv_get step "conflicts")))
                        (while (rt_lt p (rt_count parents)) (do (rt_push queue (rt_at parents p)) (set p (rt_add p 1)))))))
                  (set cursor (rt_add cursor 1)))))
            (let (cost (rt_add (rt_add (rt_mul steps (dv_get policy "step")) (rt_mul uncertainty (dv_get policy "evidence")))
                        (rt_add (rt_mul assumptions (dv_get policy "assumption")) (rt_mul conflicts (dv_get policy "conflict"))))
                  components (dv_m4 "steps" steps "evidence_uncertainty" uncertainty "assumptions" assumptions "conflicts" conflicts))
              (dv_with (dv_with (dv_with (dv_with (dv_with
                (dv_m4 "valid" true "cost" cost "components" components "reasonable" (rt_not (rt_lt (dv_get policy "maximum") cost)))
                "reasonableness" (rt_div 1 (rt_add 1 (rt_div cost (dv_get policy "reference")))))
                "confidence" (dv_get root "confidence"))
                "hypothetical" (dv_or (dv_get root "hypothetical") (rt_eq (dv_get world "domain") "prediction")))
                "scope" (dv_m3 "world" (dv_get world "id") "subject" (dv_get world "subject") "revision" (dv_get world "revision")))
                "basis" visited))))))))

; Inspector reads committed checkpoints, not reconstructed or omniscient minds.
(defn dv_checkpoint (world time)
  (dv_m3 "time" time "revision" (dv_get world "revision") "world" (dv_clone world)))
(defn dv_session (worlds time time_unit)
  (let (catalog (rt_list) history (rt_list) subjects (rt_list) i 0)
    (do
      (dv_require (rt_not (rt_lt time 0)) "Negative session time")
      (while (rt_lt i (rt_count worlds))
        (let (world (rt_at worlds i) id (dv_get world "id") domain (dv_get world "domain"))
          (do
            (dv_require (dv_or (rt_eq domain "physical") (rt_eq domain "mind")) "Predictions cannot be committed as worlds")
            (dv_require (rt_not (dv_has_key catalog id)) "Duplicate world identity")
            (if (rt_eq domain "mind")
              (do (dv_require (rt_not (dv_has subjects (dv_get world "subject"))) "Duplicate subject world") (rt_push subjects (dv_get world "subject"))) false)
            (set catalog (dv_with catalog id world))
            (rt_push history (dv_checkpoint world time))
            (set i (rt_add i 1)))))
      (dv_m4 "worlds" catalog "history" history "time" time "time_unit" time_unit))))
(defn dv_session_commit (session expected_revision world time)
  (let (catalog (dv_get session "worlds") id (dv_get world "id") old (dv_get catalog id))
    (do
      (dv_require (rt_eq (dv_get old "revision") expected_revision) "Stale session commit")
      (dv_require (rt_lt expected_revision (dv_get world "revision")) "Commit needs a newer world revision")
      (dv_require (dv_and (rt_eq (dv_get old "domain") (dv_get world "domain")) (rt_eq (dv_get old "subject") (dv_get world "subject"))) "World identity changed")
      (dv_require (rt_not (rt_lt time (dv_get session "time"))) "Session time cannot move backwards")
      (dv_with (dv_with (dv_with session "worlds" (dv_with catalog id world))
        "history" (dv_append (dv_get session "history") (dv_checkpoint world time))) "time" time))))
(defn dv_session_advance (session time)
  (do (dv_require (rt_not (rt_lt time (dv_get session "time"))) "Session time cannot move backwards") (dv_with session "time" time)))
(defn dv_active_worldview (world)
  (let (adoptions (dv_get world "adoptions") result (rt_list) i 0 policies (dv_find world "policies" (rt_list)) accepted_policies (rt_list))
    (do (while (rt_lt i (rt_count adoptions))
      (let (entry (rt_at adoptions i))
        (do (if (dv_get (rt_at entry 1) "active") (rt_push result (dv_clone entry)) false) (set i (rt_add i 1)))))
      (set i 0)
      (while (rt_lt i (rt_count policies))
        (let (entry (rt_at policies i))
          (do (if (dv_get (rt_at entry 1) "active") (rt_push accepted_policies (dv_clone entry)) false) (set i (rt_add i 1)))))
      (dv_m2 "laws" result "value_policies" accepted_policies))))
(defn dv_inspect_content (world command object_id facet)
  (if (rt_eq command "worldview") (dv_active_worldview world)
    (if (rt_eq command "state") (dv_clone (dv_get world "objects"))
      (if (rt_eq command "slice")
        (let (objects (dv_get world "objects") fields (rt_list))
          (do
            (if (dv_has_key objects object_id)
              (let (facets (dv_get (dv_get objects object_id) "facets") values (dv_find facets facet (rt_list)) i 0)
                (while (rt_lt i (rt_count values)) (do (rt_push fields (rt_at (rt_at values i) 0)) (set i (rt_add i 1))))) false)
            (dv_slice world object_id facet fields)))
        (rt_fail "Inspector command must be worldview, state or slice")))))
(defn dv_inspect_at (session subject time command object_id facet)
  (do
    (dv_require (rt_not (rt_lt (dv_get session "time") time)) "Requested time has not been reached")
    (let (history (dv_get session "history") i 0 found false chosen false)
      (do
        (while (rt_lt i (rt_count history))
          (let (checkpoint (rt_at history i) world (dv_get checkpoint "world"))
            (do
              (if (dv_and (rt_eq (dv_get world "domain") "mind")
                    (dv_and (rt_eq (dv_get world "subject") subject) (rt_not (rt_lt time (dv_get checkpoint "time")))))
                (do (set found true) (set chosen checkpoint)) false)
              (set i (rt_add i 1)))))
        (if found
          (let (world (dv_get chosen "world"))
            (dv_with (dv_with (dv_with
              (dv_m4 "status" "snapshot" "subject" subject "requested_time" time "checkpoint_time" (dv_get chosen "time"))
              "time_unit" (dv_get session "time_unit")) "revision" (dv_get world "revision")) "content" (dv_inspect_content world command object_id facet)))
          (dv_m3 "status" "no-checkpoint" "subject" subject "requested_time" time))))))
(defn dv_inspector_main ()
  (let (argc (rt_arg_count))
    (do
      (dv_require (dv_or (rt_eq argc 4) (rt_eq argc 6)) "Usage: Inspector session.json subject time worldview|state|slice [object facet]")
      (let (command (rt_arg 3))
        (do
          (dv_require (if (rt_eq command "slice") (rt_eq argc 6) (rt_eq argc 4)) "Wrong inspector argument count")
          (rt_print (rt_json_stringify (dv_inspect_at (rt_json_parse (rt_read (rt_arg 0))) (rt_arg 1) (rt_number (rt_arg 2)) command
            (if (rt_eq argc 6) (rt_arg 4) "") (if (rt_eq argc 6) (rt_arg 5) "")))))))))

; Resource accounting is independent of preference/effort scores. All transitions return copies.
(defn dv_action_cost_vector (time computation stamina)
  (do (dv_require (dv_and (rt_not (rt_lt time 0)) (dv_and (rt_not (rt_lt computation 0)) (rt_not (rt_lt stamina 0)))) "Negative action cost")
    (dv_m3 "time" time "computation" computation "stamina" stamina)))
(defn dv_action_cost_validate (v)
  (dv_action_cost_vector (dv_get v "time") (dv_get v "computation") (dv_get v "stamina")))
(defn dv_action_cost_le (a b)
  (dv_and (rt_not (rt_lt (dv_get b "time") (dv_get a "time")))
    (dv_and (rt_not (rt_lt (dv_get b "computation") (dv_get a "computation"))) (rt_not (rt_lt (dv_get b "stamina") (dv_get a "stamina"))))))
(defn dv_action_cost_add (a b)
  (dv_action_cost_vector (rt_add (dv_get a "time") (dv_get b "time")) (rt_add (dv_get a "computation") (dv_get b "computation")) (rt_add (dv_get a "stamina") (dv_get b "stamina"))))
(defn dv_action_cost_sub (a b)
  (dv_action_cost_vector (rt_sub (dv_get a "time") (dv_get b "time")) (rt_sub (dv_get a "computation") (dv_get b "computation")) (rt_sub (dv_get a "stamina") (dv_get b "stamina"))))
(defn dv_action_cost_bounds (minimum maximum)
  (do (dv_action_cost_validate minimum) (dv_action_cost_validate maximum)
    (dv_require (dv_action_cost_le minimum maximum) "Action minimum exceeds maximum") (dv_m2 "minimum" minimum "maximum" maximum)))
(defn dv_action_cost_ledger (id balances)
  (do (dv_action_cost_validate balances)
    (dv_with (dv_with (dv_with (dv_m4 "id" id "revision" 0 "balances" balances "reserved" (dv_action_cost_vector 0 0 0))
      "receipts" (rt_list)) "events" (rt_list)) "spent" (dv_action_cost_vector 0 0 0))))
(defn dv_action_cost_quote (ledger world action event bounds)
  (do (dv_domain world "physical") (dv_action_cost_bounds (dv_get bounds "minimum") (dv_get bounds "maximum"))
    (dv_require (rt_not (dv_has (dv_get ledger "events") event)) "Repeated cost event")
    (dv_require (rt_not (dv_has (dv_get world "seen") event)) "Repeated world event")

    (dv_with (dv_with (dv_with (dv_m4 "ledger" (dv_get ledger "id") "revision" (dv_get ledger "revision") "world" (dv_get world "id") "world_revision" (dv_get world "revision"))
      "action" action) "event" event) "bounds" bounds)))
(defn dv_action_cost_admit (ledger world quote)
  (let (maximum (dv_get (dv_get quote "bounds") "maximum") event (dv_get quote "event"))
    (do
      (dv_require (dv_and (rt_eq (dv_get ledger "id") (dv_get quote "ledger")) (rt_eq (dv_get ledger "revision") (dv_get quote "revision"))) "Stale cost quote")
      (dv_require (dv_and (rt_eq (dv_get world "id") (dv_get quote "world")) (rt_eq (dv_get world "revision") (dv_get quote "world_revision"))) "Stale cost world")
      (dv_action_cost_quote ledger world (dv_get quote "action") event (dv_get quote "bounds"))
      (dv_require (dv_action_cost_le maximum (dv_get ledger "balances")) "Insufficient action resources")
      (let (receipt (dv_with quote "state" "reserved") next (dv_with ledger "revision" (rt_add (dv_get ledger "revision") 1)))
        (do (set next (dv_with next "balances" (dv_action_cost_sub (dv_get ledger "balances") maximum)))
          (set next (dv_with next "reserved" (dv_action_cost_add (dv_get ledger "reserved") maximum)))
          (set next (dv_with next "events" (dv_append (dv_get ledger "events") event)))
          (set next (dv_with next "receipts" (dv_with (dv_get ledger "receipts") event receipt)))
          (dv_m2 "ledger" next "receipt" receipt))))))
(defn dv_action_cost_actual (receipt actual)
  (do (dv_action_cost_validate actual)
    (dv_require (dv_and (dv_action_cost_le (dv_get (dv_get receipt "bounds") "minimum") actual)
      (dv_action_cost_le actual (dv_get (dv_get receipt "bounds") "maximum"))) "Actual action cost outside bounds") actual))
(defn dv_action_cost_settle (ledger receipt actual outcome)
  (let (event (dv_get receipt "event") stored (dv_get (dv_get ledger "receipts") event) maximum (dv_get (dv_get receipt "bounds") "maximum"))
    (do
      (dv_require (dv_and (rt_eq (dv_get ledger "id") (dv_get receipt "ledger")) (dv_same stored receipt)) "Receipt mismatch or already settled")
      (dv_require (rt_eq (dv_get stored "state") "reserved") "Receipt already settled")
      (dv_require (dv_or (rt_eq outcome "applied") (rt_eq outcome "rejected")) "Unknown settlement outcome")
      (dv_action_cost_actual receipt actual)
      (let (next (dv_with ledger "revision" (rt_add (dv_get ledger "revision") 1)) settled (dv_with (dv_with (dv_with receipt "state" "settled") "actual" actual) "outcome" outcome))
        (do (set next (dv_with next "balances" (dv_action_cost_add (dv_get ledger "balances") (dv_action_cost_sub maximum actual))))
          (set next (dv_with next "reserved" (dv_action_cost_sub (dv_get ledger "reserved") maximum)))
          (set next (dv_with next "spent" (dv_action_cost_add (dv_get ledger "spent") actual)))
          (dv_with next "receipts" (dv_with (dv_get ledger "receipts") event settled)))))))
(defn dv_action_cost_clock_commit (physical receipt actual status)
  (let (event (dv_get receipt "event") time (rt_add (dv_find physical "time" 0) (dv_get actual "time")))
    (let (history (dv_with (dv_with (dv_m4 "id" event "time" time "kind" "action-cost" "status" status) "receipt" receipt) "actual" actual))
      (dv_with (dv_with (dv_with (dv_with physical "time" time) "revision" (rt_add (dv_get physical "revision") 1))
        "seen" (dv_append (dv_get physical "seen") event)) "history" (dv_append (dv_get physical "history") history)))))
(defn dv_action_cost_execution_metadata (execution receipt actual)
  (dv_with (dv_with (dv_with execution "event" (dv_get receipt "event")) "time" (dv_get (dv_get execution "world") "time")) "actual_cost" actual))
(defn dv_action_cost_execute (ledger physical quote actual)
  (let (admitted (dv_action_cost_admit ledger physical quote) receipt (dv_get admitted "receipt"))
    (do (dv_action_cost_actual receipt actual)
      (let (execution (dv_execute physical (dv_get receipt "action") (dv_get receipt "event")
        (rt_add (dv_find physical "time" 0) (dv_get actual "time")) (dv_get receipt "world_revision")))
        (do (if (rt_eq (dv_get execution "status") "applied") false
          (set execution (dv_with execution "world" (dv_action_cost_clock_commit physical receipt actual (dv_get execution "status")))))
          (dv_m3 "ledger" (dv_action_cost_settle (dv_get admitted "ledger") receipt actual
            (if (rt_eq (dv_get execution "status") "applied") "applied" "rejected"))
            "execution" (dv_action_cost_execution_metadata execution receipt actual) "receipt" receipt))))))
(defn dv_action_cost_finish (ledger physical quote actual outcome)
  (let (admitted (dv_action_cost_admit ledger physical quote) receipt (dv_get admitted "receipt"))
    (do (dv_action_cost_actual receipt actual)
      (let (next (dv_action_cost_clock_commit physical receipt actual outcome))
        (dv_m3 "ledger" (dv_action_cost_settle (dv_get admitted "ledger") receipt actual outcome)
          "execution" (dv_action_cost_execution_metadata (dv_result outcome next (rt_list) (dv_single (dv_get receipt "event"))) receipt actual) "receipt" receipt)))))

; Explicit, defeasible acceptance of a paid explanation. This is not an observation adapter.
(defn dv_explanation_model_complete (model status revision)
  (dv_and (rt_eq (dv_find model "status" "unknown") status)
    (dv_and (dv_or (rt_eq (dv_find model "source_revision" -1) revision) (dv_find model "validated_by_inputs" false))
      (dv_and (dv_find model "plan_complete" false)
        (dv_and (rt_not (rt_lt (dv_find model "remaining" -1) 0))
          (dv_and (rt_not (rt_lt (dv_find model "work_remaining" -1) 0))
            (dv_and (rt_eq (rt_count (dv_find model "failures" (rt_list))) 0)
              (dv_and (rt_lt 0 (rt_count (dv_find model "predictions" (rt_list))))
                (dv_and (rt_eq (rt_count (dv_find model "predictions" (rt_list))) (rt_count (dv_find model "comparisons" (rt_list))))
                  (dv_has_key model "event"))))))))))
(defn dv_explanation_observation_sources (mind comparison sources)
  (let (observed (dv_get comparison "observed_cells") i 0 valid true ids (rt_list) inputs (rt_list))
    (do (if (rt_eq (rt_count observed) 0) (set valid false) false)
      (while (rt_lt i (rt_count observed))
        (let (item (rt_at observed i) ref (dv_get (rt_at observed i) "ref") cell (dv_read mind (dv_get (rt_at observed i) "ref")) j 0 found false)
          (do (if (dv_same cell (dv_get item "cell")) false (set valid false))
            (while (rt_lt j (rt_count sources))
              (let (source (rt_at sources j) observation (dv_get (rt_at sources j) "observation"))
                (do (if (dv_and (rt_eq (dv_get observation "subject") (dv_get mind "subject"))
                  (dv_and (dv_same (dv_get observation "ref") ref) (dv_same (dv_get observation "value") (dv_get cell "value"))))
                  (if (dv_has (dv_find cell "claims" (rt_list)) observation)
                    (do (set found true) (if (dv_has ids (dv_get source "event_id")) false (set ids (dv_append ids (dv_get source "event_id"))))) false) false)
                  (set j (rt_add j 1)))))
            (if found false (set valid false))
            (rt_push inputs item) (set i (rt_add i 1)))))
      (dv_m3 "valid" valid "source_event_ids" ids "inputs" inputs))))
(defn dv_explanation_trace_changes (step)
  (if (dv_has_key step "changes") (dv_get step "changes")
    (if (dv_has_key step "response")
      (let (response (dv_get step "response"))
        (if (dv_has_key response "bridge") (dv_find (dv_get response "bridge") "changes" (rt_list)) (rt_list))) (rt_list))))
(defn dv_explanation_slot (model slot)
  (let (predictions (dv_get model "predictions") index (dv_get slot "feature_index") valid false value false confidence 0 trace_step -1 trace (dv_get model "trace") j 0)
    (do (if (dv_and (rt_not (rt_lt index 0)) (rt_lt index (rt_count predictions)))
      (let (prediction (rt_at predictions index))
        (do (while (rt_lt j (rt_count trace))
          (let (step (rt_at trace j) changes (dv_explanation_trace_changes (rt_at trace j)) k 0)
            (do (if (rt_eq (dv_get step "at") (dv_get slot "trace_at"))
              (while (rt_lt k (rt_count changes))
                (let (change (rt_at changes k))
                  (do (if (dv_and (dv_same (dv_get change "ref") (dv_get slot "ref"))
                    (dv_and (dv_uncontested (dv_get change "after"))
                      (dv_and (dv_get prediction "covered") (dv_find slot "value_from_prediction" false))))
                    (do (set valid true) (set value (dv_get (dv_get change "after") "value"))
                      (set confidence (dv_min (dv_get prediction "confidence") (dv_get (dv_get change "after") "confidence"))) (set trace_step j)) false)
                    (set k (rt_add k 1))))) false) (set j (rt_add j 1))))) )) false)
      (dv_with (dv_m4 "valid" valid "value" value "confidence" confidence "trace_step" trace_step) "slot" slot))))
(defn dv_explanation_model_inputs (mind model)
  (let (trace (dv_find model "trace" (rt_list)) result (rt_list) i 0)
    (do (while (rt_lt i (rt_count trace))
      (let (refs (dv_find (rt_at trace i) "inputs" (rt_list)) j 0)
        (do (while (rt_lt j (rt_count refs))
          (let (ref (dv_get (rt_at refs j) "ref"))
            (do (set result (dv_explanation_merge result (dv_single (dv_m2 "ref" ref "cell" (dv_read mind ref)))))
              (set j (rt_add j 1))))) (set i (rt_add i 1))))) result)))
(defn dv_explanation_model_current (mind model)
  (let (inputs (dv_find model "validation_inputs" (rt_list)) valid (dv_same (dv_find model "source_adoptions" false) (dv_get mind "adoptions")) i 0)
    (do (while (rt_lt i (rt_count inputs))
      (let (input (rt_at inputs i))
        (do (if (dv_same (dv_without (dv_get input "cell") "time") (dv_without (dv_read mind (dv_get input "ref")) "time")) false (set valid false)) (set i (rt_add i 1))))) valid)))
(defn dv_accept_explanation (mind model competitors slots sources policy budget time id)
  (let (valid true reason "accepted-estimated" comparisons (dv_find model "comparisons" (rt_list)) i 0 source_ids (rt_list)
        inputs (rt_list) competitor_ids (rt_list) claims (rt_list) effects (rt_list) remaining budget confidence (dv_find policy "confidence_cap" 0))
    (do (dv_domain mind "mind")
      (if (dv_and (dv_find policy "active" false) (dv_and (rt_lt 0 confidence) (dv_and (rt_lt confidence 1) (rt_lt 0 (rt_count (dv_find policy "basis" (rt_list))))))) false
        (do (set valid false) (set reason "abduction-strategy-not-adopted")))
      (if (dv_and (dv_explanation_model_complete model "explained" (dv_get mind "revision")) (if (dv_find model "validated_by_inputs" false) (dv_explanation_model_current mind model) true)) false
        (do (set valid false) (set reason "model-incomplete-or-stale")))
      (while (rt_lt i (rt_count comparisons))
        (let (comparison (rt_at comparisons i) observed (dv_explanation_observation_sources mind (rt_at comparisons i) sources))
          (do (if (dv_and (rt_eq (dv_get comparison "result") "match") (dv_get observed "valid")) false
            (do (set valid false) (set reason "unobserved-or-unmatched-feature")))
            (set confidence (dv_min confidence (dv_get comparison "confidence")))
            (set source_ids (dv_explanation_merge source_ids (dv_get observed "source_event_ids")))
            (set inputs (dv_explanation_merge inputs (dv_get observed "inputs"))) (set i (rt_add i 1)))))
      (set inputs (dv_explanation_merge inputs (dv_explanation_model_inputs mind model)))
      (set i 0)
      (while (rt_lt i (rt_count competitors))
        (let (other (rt_at competitors i) j 0 other_comparisons (dv_find (rt_at competitors i) "comparisons" (rt_list)) contradiction false)
          (do (if (dv_and (dv_explanation_model_complete other "inconsistent" (dv_get mind "revision")) (if (dv_find other "validated_by_inputs" false) (dv_explanation_model_current mind other) true)) false
            (do (set valid false) (set reason "unresolved-competitor")))
            (while (rt_lt j (rt_count other_comparisons))
              (let (comparison (rt_at other_comparisons j) observed (dv_explanation_observation_sources mind (rt_at other_comparisons j) sources))
                (do (if (dv_and (rt_not (rt_eq (dv_get comparison "result") "unknown")) (dv_get observed "valid")) false
                  (do (set valid false) (set reason "competitor-feature-unresolved")))
                  (if (rt_eq (dv_get comparison "result") "contradiction") (set contradiction true) false)
                  (set source_ids (dv_explanation_merge source_ids (dv_get observed "source_event_ids")))
                  (set inputs (dv_explanation_merge inputs (dv_get observed "inputs"))) (set j (rt_add j 1)))))
            (set inputs (dv_explanation_merge inputs (dv_explanation_model_inputs mind other)))
            (if contradiction false (do (set valid false) (set reason "competitor-not-refuted")))
            (if (dv_has_key other "event") (set competitor_ids (dv_append competitor_ids (dv_get other "event"))) false) (set i (rt_add i 1)))))
      (if (rt_eq (rt_count slots) 0) (do (set valid false) (set reason "no-public-claim-slots")) false)
      (set i 0)
      (while (dv_and valid (rt_lt i (rt_count slots)))
        (if (rt_lt remaining 1) (do (set valid false) (set reason "argument-reason-budget"))
          (let (slot (rt_at slots i) resolved (dv_explanation_slot model (rt_at slots i)))
            (do (set remaining (rt_sub remaining 1))
              (if (dv_get resolved "valid")
                (let (ref (dv_get slot "ref") existing (dv_read mind (dv_get slot "ref")))
                  (do (if (dv_has_key (dv_get mind "objects") (dv_get ref "object")) false (do (set valid false) (set reason "unknown-local-claim-object")))
                    (if (dv_and (dv_uncontested existing) (rt_not (dv_same (dv_get existing "value") (dv_get resolved "value"))))
                      (do (set valid false) (set reason "claim-conflicts-with-current-evidence")) false)
                    (set confidence (dv_min confidence (dv_get resolved "confidence")))
                    (rt_push claims (dv_with (dv_m4 "slot_id" (dv_get slot "slot_id") "ref" ref "value" (dv_get resolved "value") "trace_step" (dv_get resolved "trace_step")) "feature_index" (dv_get slot "feature_index")))
                    (if (dv_uncontested existing) false (rt_push effects (dv_assign ref (dv_get resolved "value"))))))
                (do (set valid false) (set reason "claim-not-covered-by-actual-predictive-trace")))
              (set i (rt_add i 1))))))
      (if (rt_lt 0 confidence) false (do (set valid false) (set reason "unsupported-zero-confidence")))
      (let (basis (dv_explanation_merge (dv_find policy "basis" (rt_list)) (dv_explanation_merge source_ids (dv_append competitor_ids (dv_find model "event" "")))) world mind changes (rt_list))
        (do (if valid
          (let (stage (dv_stage mind effects time (dv_append basis id) confidence) j 0)
            (if (rt_eq (dv_get stage "status") "ready")
              (do (set world (dv_get stage "world")) (set changes (dv_get stage "changes"))
                (while (rt_lt j (rt_count changes))
                  (let (ref (dv_get (rt_at changes j) "ref"))
                    (do (set world (dv_store world ref (dv_with (dv_with (dv_read world ref) "source" "abduction") "estimated" true))) (set j (rt_add j 1)))))
                (if (rt_lt 0 (rt_count changes)) (set world (dv_with world "revision" (rt_add (dv_get mind "revision") 1))) false))
              (do (set valid false) (set reason (dv_get stage "status"))))) false)
          (let (argument (dv_with (dv_with (dv_with (dv_with (dv_with (dv_with (dv_with (dv_with
            (dv_m4 "id" id "estimated" true "confidence" confidence "claims" claims) "model_event" (dv_find model "event" ""))
              "source_event_ids" source_ids) "competitor_events" competitor_ids) "source_revision" (dv_get mind "revision"))
              "mind_revision_after" (dv_get world "revision")) "inputs" inputs) "changes" changes) "basis" basis))
            (do (if valid (set world (dv_with world "history" (dv_append (dv_get world "history") (dv_m3 "kind" "estimated-model-argument" "argument" argument "time" time)))) false)
              (dv_with (dv_with (dv_m4 "accepted" valid "reason" reason "world" world "argument" argument) "remaining" remaining) "expanded" (rt_sub budget remaining)))))))))
(defn dv_explanation_merge (a b)
  (let (result a i 0) (do (while (rt_lt i (rt_count b))
    (do (if (dv_has result (rt_at b i)) false (set result (dv_append result (rt_at b i)))) (set i (rt_add i 1)))) result)))

; The selector receives only one actor snapshot. No authority or oracle argument.
(defn dvs_event (events kind actor time parents data)
  (let (id (rt_cat "e" (rt_show (rt_count events))))
    (do (rt_push events (dv_with (dv_with (dv_m4 "id" id "type" kind "actor" actor "time" time) "parents" parents) "data" data)) id)))
(defn dvs_cognitive_parents (actor parents)
  (let (previous (dv_find actor "last_cognitive_event" ""))
    (if (rt_eq previous "") parents (dv_explanation_merge parents (dv_single previous)))))
(defn dvs_reason_cell (cell)
  (dv_without cell "time"))
(defn dvs_reason_value (cell)
  (dv_m4 "known" (dv_get cell "known") "value" (dv_get cell "value") "confidence" (dv_get cell "confidence") "conflicted" (dv_get cell "conflicted")))
(defn dvs_reason_premises (mind proposition)
  (let (op (dv_get proposition "op"))
    (if (rt_eq op "constant") proposition
      (if (rt_eq op "not") (dvs_reason_premises mind (dv_get proposition "item"))
        (if (rt_eq op "all")
          (let (items (dv_get proposition "items") result (rt_list) i 0)
            (do (while (rt_lt i (rt_count items))
              (do (rt_push result (dvs_reason_premises mind (rt_at items i))) (set i (rt_add i 1)))) result))
          (dv_m2 "proposition" proposition "support" (dvs_reason_cell (dv_read mind (dv_get proposition "ref")))))))))
(defn dvs_reason_signature (mind adoption)
  (let (law (dv_get adoption "law") effects (dv_get (dv_get adoption "law") "effects") outputs (rt_list) i 0)
    (do (while (rt_lt i (rt_count effects))
      (let (cell (dv_read mind (dv_get (rt_at effects i) "ref")))
        (do (rt_push outputs (dv_m4 "known" (dv_get cell "known") "value" (dv_get cell "value") "confidence" (dv_get cell "confidence") "conflicted" (dv_get cell "conflicted")))
          (set i (rt_add i 1)))))
      (dv_with (dv_m4 "law" law "confidence" (dv_get adoption "confidence") "basis" (dv_get adoption "basis")
        "premises" (dvs_reason_premises mind (dv_get law "premise"))) "outputs" outputs))))
(defn dvs_reason_changes (changes)
  (let (i 0 changed false)
    (do (while (rt_lt i (rt_count changes))
      (let (change (rt_at changes i))
        (do (if (dv_same (dvs_reason_value (dv_get change "before")) (dvs_reason_value (dv_get change "after"))) false (set changed true))
          (set i (rt_add i 1))))) changed)))
(defn dvs_reason_run (actor events time parent)
  (let (mind (dv_get actor "mind") policy (dv_get actor "policy") budget (dv_find policy "reason_budget" 0) count 0 changed true
        signatures (dv_find actor "inference_signatures" (rt_list)) derivations (dv_find actor "inference_derivations" (rt_list)))
    (do
      (while (dv_and changed (rt_lt count budget))
        (let (adoptions (dv_get mind "adoptions") i 0)
          (do (set changed false)
            (while (dv_and (rt_lt i (rt_count adoptions)) (rt_lt count budget))
              (let (entry (rt_at adoptions i) law (dv_get (rt_at entry 1) "law"))
                (do
                  (if (dv_and (dv_get (rt_at entry 1) "active") (rt_eq (dv_get (rt_at entry 1) "mode") "infer"))
                    (if (dv_and (rt_eq (dv_truth mind (dv_get law "premise")) "true")
                      (rt_not (dv_same (dv_find signatures (rt_at entry 0) false) (dvs_reason_signature mind (rt_at entry 1)))))
                      (let (stage (dv_stage mind (dv_get law "effects") time (dv_get (rt_at entry 1) "basis") (dv_get (rt_at entry 1) "confidence")))
                        (if (dv_and (rt_eq (dv_get stage "status") "ready") (dvs_reason_changes (dv_get stage "changes")))
                          (let (before mind result (dv_infer mind (rt_at entry 0) (rt_cat "infer" (rt_show (rt_count events))) time (dv_get mind "revision")))
                            (do (set mind (dv_get result "world")) (set changed true) (set count (rt_add count 1))
                              (set signatures (dv_with signatures (rt_at entry 0) (dvs_reason_signature mind (rt_at entry 1))))
                              (let (event (dvs_event events "inference" (dv_get actor "id") time (dv_explanation_merge (dvs_cognitive_parents actor (dv_single parent)) (dvs_support_parents before (dvs_sim_refs (dv_get law "premise")) events (dv_get actor "id"))) (dv_m4 "mind_before" before "mind_after" mind "law" law "receipt" result)))
                                (do (set actor (dv_with actor "last_cognitive_event" event)) (rt_push derivations (dv_with (dv_m4 "event" event "adoption" (rt_at entry 1) "inputs" (dvs_sim_inputs before (dv_get law "premise")) "changes" (dv_get result "changes")) "valid" true))))))
                          (if (rt_eq (dv_get stage "status") "ready")
                            (do (set count (rt_add count 1)) (set signatures (dv_with signatures (rt_at entry 0) (dvs_reason_signature mind (rt_at entry 1))))
                              (dvs_event events "inference_alternative_basis" (dv_get actor "id") time (dvs_cognitive_parents actor (dv_single parent))
                                (dv_m4 "law" law "basis" (dv_get (rt_at entry 1) "basis") "premises" (dvs_reason_premises mind (dv_get law "premise")) "mind_revision" (dv_get mind "revision")))) false))) false) false)
                  (set i (rt_add i 1))))))))
      (set actor (dv_with actor "last_cognitive_event" (dvs_event events "reason_stop" (dv_get actor "id") time (dvs_cognitive_parents actor (dv_single parent))
        (dv_m4 "steps" count "remaining" (rt_sub budget count) "stop" (if (rt_lt count budget) "no-new-effective-conclusion" "budget-exhausted") "mind_revision" (dv_get mind "revision")))))
      (dv_with (dv_with (dv_with (dv_with actor "mind" mind) "inference_derivations" derivations) "inference_signatures" signatures) "policy" (dv_with policy "reason_budget" (rt_sub budget count))))))
(defn dvs_cached_model (actor hypothesis)
  (let (model (dv_find (dv_find actor "simulations" (rt_list)) (dv_get hypothesis "id") (dv_m2 "fit" 0 "status" "not-simulated")))
    (if (dv_or (rt_eq (dv_find model "source_revision" -1) (dv_get (dv_get actor "mind") "revision"))
      (dv_and (dv_explanation_model_current (dv_get actor "mind") model) (dv_same (dv_find model "source_response_models" false) (dv_find actor "response_models" (rt_list)))))
      (dv_with model "validated_by_inputs" true)
      (if (dv_and (dvs_argument_valid actor) (dvs_argument_inputs_current actor))
        (let (argument (dv_get actor "argument"))
          (if (dv_and (rt_eq (dv_find model "source_revision" -1) (dv_get argument "source_revision"))
            (dv_or (rt_eq (dv_find model "event" "") (dv_get argument "model_event")) (dv_has (dv_get argument "competitor_events") (dv_find model "event" ""))))
            (dv_with model "validated_by_argument" (dv_get argument "id"))
            (dv_m3 "fit" 0 "status" "stale-or-unavailable" "source_revision" (dv_find model "source_revision" -1))))
        (dv_m3 "fit" 0 "status" "stale-or-unavailable" "source_revision" (dv_find model "source_revision" -1))))))
(defn dvs_working_explanation (actor hypothesis)
  (dv_and (dvp_topic actor hypothesis)
    (dv_and (rt_lt 0 (rt_count (dv_find hypothesis "features" (rt_list))))
      (dv_and (rt_lt 0 (rt_count (dvs_sim_plan hypothesis)))
        (dv_and (rt_lt 0 (rt_count (dv_find hypothesis "basis" (rt_list))))
          (dv_and (rt_eq (dv_truth (dv_get actor "mind") (dv_find hypothesis "available_when" (dv_true))) "true")
            (dv_and (rt_not (rt_eq (dv_truth (dv_get actor "mind") (dv_get hypothesis "proposition")) "false"))
              (rt_not (dvs_factor_candidate_rejected actor hypothesis)))))))))
(defn dvs_hypotheses (actor events time parent)
  (let (mind (dv_get actor "mind") candidates (dv_find (dv_get actor "policy") "hypotheses" (rt_list)) i 0 best false score -1 working false)
    (do (while (rt_lt i (rt_count candidates))
      (do (if (dvs_working_explanation actor (rt_at candidates i)) (set working true) false) (set i (rt_add i 1))))
      (set i 0) (while (rt_lt i (rt_count candidates))
      (let (h (rt_at candidates i) available (dv_find h "available_when" (dv_true)))
        (do (if (dv_and (if working (dvs_working_explanation actor h) true) (dv_and (dvp_topic actor h) (dv_and (rt_lt 0 (rt_count (dv_find h "basis" (rt_list)))) (rt_eq (dv_truth mind available) "true"))))
          (let (truth (dv_truth mind (dv_get h "proposition")) weight (if (rt_eq truth "false") -1 (if (rt_eq truth "true") 1 (dv_find h "prior" 0.5)))
                model (dvs_cached_model actor h))
            (do (set weight (rt_add weight (dv_get model "fit")))
              (if (dv_or (dvs_factor_candidate_rejected actor h) (dv_or (rt_eq truth "false") (rt_eq (dv_find model "status" "unknown") "inconsistent"))) false
                (if (rt_lt score weight) (do (set best (dv_with h "simulation" model)) (set score weight)) false)))) false) (set i (rt_add i 1)))))
      (let (previous (dv_find actor "hypothesis" false) event (dv_find actor "hypothesis_event" ""))
        (do (if (dv_same previous best) false
          (set event (dvs_event events (if (rt_eq previous false) "hypothesis_adopted" "hypothesis_revised") (dv_get actor "id") time (dvs_cognitive_parents actor (dv_single parent))
            (dv_m4 "previous" previous "current" best "mind" mind "preference" score))))
          (if (rt_eq event (dv_find actor "hypothesis_event" "")) false (set actor (dv_with actor "last_cognitive_event" event)))
          (dv_with (dv_with actor "hypothesis" best) "hypothesis_event" event))))))
(defn dvs_choose (actor bindings costs) (dvp_plan actor bindings costs))
(defn dvs_ready (actor events time parent)
  (let (hypothesis (dv_find actor "hypothesis" false) ready true reasons (rt_list) parents (dvs_cognitive_parents actor (dv_single parent))
        question (if (dv_has_key actor "question_ref") (dv_read (dv_get actor "mind") (dv_get actor "question_ref")) (dv_unknown)))
    (do (if (dv_uncontested question) false (do (set ready false) (rt_push reasons "current-public-question-unobserved")))
      (if (rt_eq hypothesis false) (do (set ready false) (rt_push reasons "no-seriously-adopted-hypothesis"))
      (let (simulation (dv_find hypothesis "simulation" (rt_list)) candidates (dv_find (dv_get actor "policy") "hypotheses" (rt_list)) i 0
            simulations (dv_find actor "simulations" (rt_list)) mind (dv_get actor "mind"))
        (do
          (if (dv_or (rt_eq (dv_find simulation "source_revision" -1) (dv_get mind "revision"))
            (dv_or (dv_find simulation "validated_by_inputs" false) (if (dv_has_key simulation "validated_by_argument") (dv_and (dvs_argument_valid actor) (dvs_argument_inputs_current actor)) false))) false
            (do (set ready false) (rt_push reasons "simulation-evidence-version-stale")))
          (if (dv_explanation_model_complete simulation "explained"
            (if (dv_has_key simulation "validated_by_argument") (dv_get (dv_get actor "argument") "source_revision") (dv_get mind "revision"))) false
            (do (set ready false) (rt_push reasons "simulation-incomplete-or-unknown")))
          (if (dv_has_key simulation "validated_by_argument") (rt_push parents (dv_get simulation "validated_by_argument")) false)
          (if (dv_has_key simulation "event") (rt_push parents (dv_get simulation "event"))
            (do (set ready false) (rt_push reasons "missing-paid-simulation-event")))
          (while (rt_lt i (rt_count candidates))
            (let (candidate (rt_at candidates i))
              (do (if (dv_and (rt_not (rt_eq (dv_get candidate "id") (dv_get hypothesis "id")))
                (dv_and (dvp_topic actor candidate) (dv_and (rt_eq (dv_find candidate "group" "") (dv_find hypothesis "group" ""))
                  (rt_eq (dv_truth mind (dv_find candidate "available_when" (dv_true))) "true"))))
                (let (other (dvs_cached_model actor candidate))
                  (if (dv_or (rt_eq (dv_find other "status" "unknown") "inconsistent")
                    (if (dv_and (dvs_argument_valid actor) (dvs_argument_inputs_current actor))
                      (dvs_factor_covered candidate (dv_get (dv_find (dv_get actor "argument") "factor_coverage" (dv_m2 "catalog" (rt_list) "certificates" (rt_list))) "certificates")) false))
                    (if (dv_has_key other "event") (rt_push parents (dv_get other "event"))
                      (if (dv_and (dvs_argument_valid actor) (dvs_argument_inputs_current actor)) (rt_push parents (dv_get (dv_get actor "argument") "id")) (do (set ready false) (rt_push reasons "missing-competitor-simulation-event"))))
                    (do (set ready false) (rt_push reasons (rt_cat "unresolved-competitor:" (dv_get candidate "id")))))) false)
                (set i (rt_add i 1))))))))
      (if ready
        (if (dv_same (dv_find actor "ready_hypothesis" false) hypothesis) actor
          (do (set actor (dv_with actor "last_cognitive_event" (dvs_event events "answer_ready" (dv_get actor "id") time parents
            (dv_with (dv_with (dv_m4 "hypothesis" hypothesis "mind" (dv_get actor "mind") "question_id" (dv_find hypothesis "question" (dv_get question "value")) "actor_before" actor) "argument" (dv_find actor "argument" false)) "argument_question" (dv_find hypothesis "question" (dv_get question "value"))))))
            (dv_with actor "ready_hypothesis" hypothesis)))
        (do (dvs_event events "why_not_ready" (dv_get actor "id") time parents (dv_m2 "reasons" reasons "hypothesis" hypothesis)) actor)))))

(defn dvs_reason (actor events time parent)
  (let (refreshed (dvs_refresh_derivations actor events time parent))
    (if (dv_find refreshed "cognition_blocked" false) refreshed (dvs_reason_run refreshed events time parent))))

; Subject-local goals, method scopes and bounded complete-layer comparison.
; Observing a scope has information value; its unknown result is never inserted into a forecast.
(defn dvp_question (actor)
  (if (dv_has_key actor "question_ref")
    (let (cell (dv_read (dv_get actor "mind") (dv_get actor "question_ref")))
      (if (dv_uncontested cell) (dv_get cell "value") "")) ""))
(defn dvp_topic (actor item)
  (let (topic (dv_find item "question" (dv_find item "topic" "")) question (dvp_question actor)
        bindings (dv_find (dv_get actor "policy") "topic_bindings" (rt_list)) i 0 active false)
    (do (if (dv_and (rt_not (rt_eq question "")) (rt_eq topic question)) (set active true) false)
      (while (rt_lt i (rt_count bindings))
        (let (binding (rt_at bindings i))
          (do (if (dv_and (rt_eq (dv_get binding "topic") topic)
            (dv_and (rt_lt 0 (rt_count (dv_find binding "basis" (rt_list))))
              (dv_and (dv_or (dvs_topic_was_heard actor topic) (rt_eq (dv_truth (dv_get actor "mind") (dv_get binding "heard_when")) "true"))
                (rt_not (rt_eq (dv_truth (dv_get actor "mind") (dv_get binding "completed_when")) "true")))))
            (set active true) false) (set i (rt_add i 1))))) active)))
(defn dvp_add_ref (refs ref) (if (dv_has refs ref) refs (dv_append refs ref)))
(defn dvp_merge_refs (refs extra)
  (let (result refs i 0) (do (while (rt_lt i (rt_count extra))
    (do (set result (dvp_add_ref result (rt_at extra i))) (set i (rt_add i 1)))) result)))
(defn dvp_unmet_refs (mind proposition include_known)
  (let (op (dv_get proposition "op"))
    (if (rt_eq op "constant") (rt_list)
      (if (rt_eq op "not") (dvp_unmet_refs mind (dv_get proposition "item") include_known)
        (if (rt_eq op "all")
          (let (items (dv_get proposition "items") result (rt_list) i 0)
            (do (while (rt_lt i (rt_count items))
              (do (set result (dvp_merge_refs result (dvp_unmet_refs mind (rt_at items i) include_known))) (set i (rt_add i 1)))) result))
          (if (dv_or include_known (rt_not (rt_eq (dv_truth mind proposition) "true"))) (dv_single (dv_get proposition "ref")) (rt_list)))))))
(defn dvp_dependencies (mind seeds budget)
  (let (refs seeds queue seeds cursor 0 expanded 0 adoptions (dv_get mind "adoptions"))
    (do (while (dv_and (rt_lt cursor (rt_count queue)) (rt_lt expanded budget))
      (let (ref (rt_at queue cursor) i 0)
        (do (set expanded (rt_add expanded 1))
          (while (rt_lt i (rt_count adoptions))
            (let (adoption (rt_at (rt_at adoptions i) 1) law (dv_get (rt_at (rt_at adoptions i) 1) "law") j 0 effects (dv_get (dv_get (rt_at (rt_at adoptions i) 1) "law") "effects"))
              (do (if (dv_and (dv_get adoption "active") (rt_eq (dv_get adoption "mode") "infer"))
                (while (rt_lt j (rt_count effects))
                  (let (effect (rt_at effects j))
                    (do (if (dv_same (dv_get effect "ref") ref)
                      (let (premises (dvp_unmet_refs mind (dv_get law "premise") true) k 0)
                        (do (while (rt_lt k (rt_count premises))
                          (let (premise (rt_at premises k))
                            (do (if (dv_has refs premise) false
                              (do (set refs (dv_append refs premise)) (set queue (dv_append queue premise))))
                              (set k (rt_add k 1))))))) false) (set j (rt_add j 1))))) false)
                (set i (rt_add i 1))))) (set cursor (rt_add cursor 1)))))
      (dv_m3 "refs" refs "expanded" expanded "stop" (if (rt_lt cursor (rt_count queue)) "dependency-budget" "dependency-closure")))))
(defn dvp_goal_refs (actor)
  (let (goals (dv_find (dv_get actor "policy") "goals" (rt_list)) mind (dv_get actor "mind") refs (rt_list) i 0)
    (do (while (rt_lt i (rt_count goals))
      (let (goal (rt_at goals i))
        (do (if (dv_and (dvp_topic actor goal) (rt_eq (dv_truth (dv_get actor "mind") (dv_find goal "available_when" (dv_true))) "true"))
          (if (dv_has_key goal "ref") (set refs (dvp_add_ref refs (dv_get goal "ref")))
            (if (dv_has_key goal "proposition") (set refs (dvp_merge_refs refs (dvp_unmet_refs mind (dv_get goal "proposition") true))) false)) false)
          (set i (rt_add i 1))))) refs)))
(defn dvp_probe_refs (actor)
  (let (hypothesis (dv_find actor "hypothesis" false) refs (rt_list))
    (do
      (if (rt_eq hypothesis false) false
        (if (dvp_topic actor hypothesis)
          (let (features (dv_find hypothesis "features" (rt_list)) i 0)
            (do (while (rt_lt i (rt_count features))
              (let (feature (rt_at features i))
                (do (set refs (dvp_merge_refs refs (dvs_sim_refs (dv_find feature "observation" (if (dv_has_key feature "proposition") (dv_get feature "proposition") feature)))))
                  (set i (rt_add i 1))))))) false))
      refs)))
(defn dvp_scope (actor action bindings)
  (let (declared (dv_find action "purpose_refs" (rt_list)) grants (dv_find action "grants" (rt_list)) refs declared i 0)
    (do (while (rt_lt i (rt_count grants))
      (let (ref (rt_at grants i) local (dv_local bindings (dv_get (rt_at grants i) "object") (dv_get actor "id")))
        (do (if (rt_eq local "") false (set refs (dvp_add_ref refs (dv_ref local (dv_get ref "facet") (dv_get ref "field")))))
          (set i (rt_add i 1))))) refs)))
(defn dvp_answer_reward (actor action mind)
  (if (dv_has_key action "answer")
    (if (rt_eq (dv_truth mind (dv_get action "answer")) "true") 1.0
      (if (dv_and (dv_has_key actor "argument") (rt_eq (dv_find (dv_find actor "argument" (rt_list)) "question" "") (dv_find action "argument_question" ""))) 1.0
        (let (hypothesis (dv_find actor "hypothesis" false))
          (if (rt_eq hypothesis false) 0
            (if (dv_same (dv_get hypothesis "proposition") (dv_get action "answer"))
              (dv_find hypothesis "prior" 0.5) 0))))) 0))
(defn dvp_input_signature (actor action refs)
  (let (mind (dv_get actor "mind") inputs (rt_list) i 0 selected (dvp_merge_refs refs (if (dv_has_key action "answer") (dvs_sim_refs (dv_get action "answer")) (rt_list))))
    (do (if (dv_has_key action "support") (set selected (dvp_merge_refs selected (dvs_sim_refs (dv_get action "support")))) false)
      (while (rt_lt i (rt_count selected))
        (do (rt_push inputs (dv_m2 "ref" (rt_at selected i) "cell" (dvs_reason_cell (dv_read mind (rt_at selected i))))) (set i (rt_add i 1))))
      (dv_with (dv_m3 "question" (dvp_question actor) "claim" (dv_find action "answer" false) "inputs" inputs)
        "reward" (dvp_answer_reward actor action mind)))))
(defn dvp_answer_relevant (actor action)
  (if (dv_has_key action "topic") (dvp_topic actor action)
    (let (refs (dvs_sim_refs (dv_get action "answer")) goals (dvp_goal_refs actor) i 0 found false)
      (do (while (rt_lt i (rt_count refs))
        (do (if (dv_has goals (rt_at refs i)) (set found true) false) (set i (rt_add i 1)))) found))))
(defn dvp_answer_attempt_allowed (prev_sig cur_sig)
  (if (rt_eq prev_sig false) true
    (if (rt_not (dv_same (dv_get prev_sig "inputs") (dv_get cur_sig "inputs"))) true
      (if (rt_not (dv_same (dv_get prev_sig "claim") (dv_get cur_sig "claim"))) true
        (if (rt_not (dv_same (dv_get prev_sig "question") (dv_get cur_sig "question"))) true
          (let (r1 (dv_find prev_sig "reward" 0) r2 (dv_find cur_sig "reward" 0) diff (if (rt_lt r1 r2) (rt_sub r2 r1) (rt_sub r1 r2)))
            (rt_not (rt_lt diff 0.2))))))))
(defn dvp_eligible (actor action mind relevant)
  (let (id (dv_get action "id") used (dv_find actor "used" (rt_list)))
    (if (dv_and (rt_not (dv_find actor "cognition_blocked" false)) (dv_and (dv_find action "argument_available" true) (rt_eq (dv_truth mind (dv_get action "precondition")) "true")))
      (if (dv_has_key action "answer")
        (if (dvp_answer_relevant actor action)
          (dv_and (rt_not (rt_eq (dv_truth (dv_get actor "mind") (dv_get action "answer")) "false"))
            (dvp_answer_attempt_allowed (dv_find (dv_find actor "answer_attempt_signatures" (rt_list)) id false) (dvp_input_signature actor action relevant))) false)
        (if (dv_has_key action "speech")
          (dv_and (rt_eq (dvs_speech_truth (dv_get actor "mind") (dv_get action "speech")) "true") (rt_not (dv_has used id)))
          (if (rt_eq (dv_get action "kind") "replay")
            (rt_not (dv_same (dv_find (dv_find actor "replay_attempt_signatures" (rt_list)) id false) (dvp_input_signature actor action relevant)))
            (if (dv_find action "repeatable" false) true (rt_not (dv_has used id)))))) false)))
(defn dvp_source_supported (cell source)
  (let (claims (dv_find cell "claims" (rt_list)) i 0 found false)
    (do (while (rt_lt i (rt_count claims))
      (let (claim (rt_at claims i))
        (do (if (dv_and (rt_eq (dv_get claim "source") source) (dv_same (dv_get claim "value") (dv_get cell "value"))) (set found true) false)
          (set i (rt_add i 1))))) found)))
(defn dvp_needs_evidence (actor ref)
  (let (goals (dv_find (dv_get actor "policy") "goals" (rt_list)) i 0 needed false)
    (do (while (rt_lt i (rt_count goals))
      (let (goal (rt_at goals i))
        (do (if (dv_and (dvp_topic actor goal) (rt_eq (dv_truth (dv_get actor "mind") (dv_find goal "available_when" (dv_true))) "true"))
          (if (rt_eq (dv_find goal "kind" "know") "evidence")
            (if (dv_has_key goal "ref")
              (if (dv_same (dv_get goal "ref") ref)
                (let (cell (dv_read (dv_get actor "mind") ref))
                  (if (dvp_source_supported cell (dv_find goal "source" "perception")) false (set needed true))) false) false) false) false)
          (set i (rt_add i 1))))) needed)))
(defn dvp_action_value (actor action bindings relevant probes)
  (let (mind (dv_get actor "mind") policy (dv_get actor "policy") scope (dvp_scope actor action bindings)
        i 0 information 0 verification 0 progress 0 hypothesis (dv_find actor "hypothesis" false))
    (do (while (rt_lt i (rt_count scope))
      (let (ref (rt_at scope i) cell (dv_read mind (rt_at scope i)))
        (do (if (dv_or (rt_not (dv_uncontested cell)) (dvp_needs_evidence actor ref))
          (do (if (dv_has relevant ref) (set information (rt_add information 1)) false)
            (if (dv_has probes ref) (set verification (rt_add verification 1)) false)) false) (set i (rt_add i 1)))))
      (if (dv_has_key action "answer")
        (set progress (dvp_answer_reward actor action mind)) false)
      (if (dv_has_key action "speech")
        (if (rt_lt 0 (rt_count (dvs_speech_goals actor)))
          (let (choice (dv_find (dv_find actor "speech_choice_values" (rt_list)) (dv_get action "id") (rt_list)))
            (if (rt_eq (dv_find choice "status" "") "ready") (set progress (dv_get choice "utility")) false))
          (set progress 1)) false)
      (if (dvp_communication_progress actor action) (set progress 1) false)
      (if (rt_eq (dv_get action "kind") "replay")
        (if (rt_lt 0 (dv_find policy "model_budget" 0))
          (if (rt_eq hypothesis false) false
            (if (dv_and (dvp_topic actor hypothesis)
              (dv_and (rt_lt 0 (rt_count (dv_find hypothesis "features" (rt_list))))
                (rt_lt 0 (rt_count (dvs_sim_plan hypothesis)))))
              (if (rt_eq (dv_find (dvs_cached_model actor hypothesis) "status" "unknown") "stale-or-unavailable")
                (set verification (rt_add verification 1)) false) false)) false) false)
      (dv_m4 "information" information "verification" verification "progress" progress "value"
        (rt_add (rt_mul (rt_add information verification) (dv_find policy "information_weight" 1)) (rt_mul progress (dv_find policy "progress_weight" 1)))))))
(defn dvp_state_key (mind)
  (let (objects (dv_get mind "objects") result (rt_list) i 0)
    (do (while (rt_lt i (rt_count objects))
      (let (entry (rt_at objects i) object (rt_at (rt_at objects i) 1) facets (dv_get (rt_at (rt_at objects i) 1) "facets") j 0)
        (do (while (rt_lt j (rt_count facets))
          (let (facet (rt_at facets j) fields (rt_at (rt_at facets j) 1) k 0)
            (do (while (rt_lt k (rt_count fields))
              (let (field (rt_at fields k))
                (do (rt_push result (dv_m2 "ref" (dv_ref (rt_at entry 0) (rt_at facet 0) (rt_at field 0)) "cell" (dvs_reason_value (rt_at field 1))))
                  (set k (rt_add k 1))))) (set j (rt_add j 1))))) (set i (rt_add i 1))))) result)))
(defn dvp_frontier_put (frontier node)
  (let (key (dvp_state_key (dv_get node "mind")) i 0 result frontier found false)
    (do (while (rt_lt i (rt_count frontier))
      (let (existing (rt_at frontier i))
        (do (if (dv_same key (dvp_state_key (dv_get existing "mind")))
          (do (set found true) (if (rt_lt (dv_get existing "score") (dv_get node "score")) (set result (dvs_replace result i node)) false)) false)
          (set i (rt_add i 1))))) (if found result (dv_append result node)))))
(defn dvp_cached_dependencies (actor seeds budget)
  (let (signature (dv_m3 "question" (dvp_question actor) "seeds" seeds "adoptions" (dv_get (dv_get actor "mind") "adoptions")) cache (dv_find actor "dependency_cache" false))
    (if (rt_eq cache false)
      (let (result (dvp_dependencies (dv_get actor "mind") seeds budget))
        (dv_with (dv_with result "cache_hit" false) "cache" (if (rt_eq (dv_get result "stop") "dependency-closure") (dv_m2 "signature" signature "result" result) false)))
      (if (dv_same (dv_get cache "signature") signature)
        (dv_with (dv_with (dv_with (dv_get cache "result") "expanded" 0) "cache_hit" true) "cache" cache)
        (let (result (dvp_dependencies (dv_get actor "mind") seeds budget))
          (dv_with (dv_with result "cache_hit" false) "cache" (if (rt_eq (dv_get result "stop") "dependency-closure") (dv_m2 "signature" signature "result" result) false)))))))
(defn dvp_plan (actor bindings costs)
  (let (budget (dv_find (dv_get actor "policy") "plan_budget" 0) depth_limit (dv_find (dv_get actor "policy") "plan_depth" 2)
        goals (dvp_goal_refs actor) probes (dvp_probe_refs actor) dependencies (dvp_cached_dependencies actor (dvp_merge_refs (dvp_goal_refs actor) probes) budget)
        relevant (dv_get dependencies "refs") expanded (dv_get dependencies "expanded") best false best_score -100000 best_path (rt_list)
        plans (rt_list) frontier (dv_single (dv_m4 "mind" (dv_get actor "mind") "path" (rt_list) "score" 0 "seen" (dv_single (dvp_state_key (dv_get actor "mind")))))
        depth 0 time_blocked 0 stop "complete-depth" actions (dv_get actor "actions"))
    (do (while (dv_and (rt_lt depth depth_limit) (rt_lt 0 (rt_count frontier)))
      (if (rt_lt (rt_sub budget expanded) (rt_count frontier)) (do (set stop "incomplete-layer-budget") (set frontier (rt_list)))
        (let (next_frontier (rt_list) n 0)
          (do (while (rt_lt n (rt_count frontier))
            (let (node (rt_at frontier n) i 0 mind (dv_get (rt_at frontier n) "mind"))
              (do (set expanded (rt_add expanded 1))
                (while (rt_lt i (rt_count actions))
                  (let (action (rt_at actions i))
                    (do (if (if (dvp_eligible actor action mind relevant)
                      (if (dv_has_key (dv_get actor "policy") "remaining_game_time")
                        (if (rt_lt (dv_get (dv_get actor "policy") "remaining_game_time")
                          (rt_add (dv_find node "elapsed" 0) (dv_get (dv_get (dv_get costs (dv_get action "kind")) "maximum") "time")))
                          (do (set time_blocked (rt_add time_blocked 1)) false) true) true) false)
                      (let (value (dvp_action_value actor action bindings relevant probes) cost (dv_get (dv_get costs (dv_get action "kind")) "actual")
                            path (dv_append (dv_get node "path") (dv_get action "id")) score 0)
                        (do (set score (rt_add (dv_get node "score") (rt_sub (dv_get value "value")
                          (rt_mul (dv_get cost "time") (dv_find (dv_get actor "policy") "time_cost" 0.01)))))
                          (rt_push plans (dv_with (dv_with (dv_with (dv_m4 "path" path "score" score "value" value "relevant_refs" relevant) "probe_refs" probes) "mind_revision" (dv_get (dv_get actor "mind") "revision")) "prediction_basis" (dv_find node "prediction_basis" (rt_list))))
                          (if (rt_lt best_score score) (do (set best_score score) (set best_path path) (set best (dvp_find_action actions (rt_at path 0)))) false)
                          (if (dv_and (rt_lt 0 (rt_count relevant)) (dv_and (rt_eq (dv_get value "value") 0) (dv_has_key action "predict_law")))
                            (let (name (dv_get action "predict_law") adoptions (dv_get mind "adoptions"))
                              (if (dv_has_key adoptions name)
                                (let (adoption (dv_get adoptions name))
                                  (if (dv_and (dv_get adoption "active") (rt_eq (dv_get adoption "mode") "predict"))
                                    (let (prediction (dv_predict (dv_with mind "domain" "mind") name
                                      (rt_cat "plan-" (rt_show (rt_count plans))) (dv_find mind "time" 0) (dv_get mind "revision")))
                                      (if (rt_eq (dv_get prediction "status") "applied")
                                        (let (predicted (dv_get prediction "world"))
                                          (if (dv_has (dv_get node "seen") (dvp_state_key predicted)) false
                                            (set next_frontier (dvp_frontier_put next_frontier (dv_with (dv_with (dv_m4 "mind" predicted "path" path "score" score "seen" (dv_append (dv_get node "seen") (dvp_state_key predicted))) "prediction_basis" (dv_get adoption "basis")) "elapsed" (rt_add (dv_find node "elapsed" 0) (dv_get (dv_get (dv_get costs (dv_get action "kind")) "maximum") "time"))))))) false)) false)) false)) false))) false)
                      (set i (rt_add i 1))))) (set n (rt_add n 1)))))
            (set frontier next_frontier) (set depth (rt_add depth 1))))))
      (dv_with (dv_with (dv_with (dv_with (dv_with (dv_with (dv_m4 "action" (if (rt_lt 0 best_score) best false) "score" best_score "plan_expansions" expanded "plans" plans) "selected_path" best_path)
        "relevant_refs" relevant) "stop" (if (dv_and (rt_not (rt_lt 0 best_score)) (rt_lt 0 time_blocked)) "duration-budget" stop)) "time_blocked" time_blocked) "dependency_cache" (dv_get dependencies "cache")) "dependency_cache_hit" (dv_get dependencies "cache_hit")))))
(defn dvp_find_action (actions id)
  (let (i 0 result false) (do (while (rt_lt i (rt_count actions))
    (do (if (rt_eq (dv_get (rt_at actions i) "id") id) (set result (rt_at actions i)) false) (set i (rt_add i 1)))) result)))

; Public transmission progress never predicts another subject's acceptance.
(defn dvp_communication_progress (actor action)
  (let (goals (dv_find (dv_get actor "policy") "goals" (rt_list)) i 0 value false)
    (do (while (rt_lt i (rt_count goals))
      (let (goal (rt_at goals i))
        (do (if (rt_eq (dv_find goal "kind" "") "communicate")
          (if (dv_and (rt_eq (dv_find goal "method_id" "") (dv_get action "id"))
            (dv_and (rt_lt 0 (rt_count (dv_find goal "basis" (rt_list))))
              (rt_eq (dv_truth (dv_get actor "mind") (dv_find goal "available_when" (dv_m2 "op" "constant" "value" "true"))) "true")))
            (if (dv_and (dv_find goal "requires_argument" false) (dv_find action "speech_from_argument" false))
              (if (dv_find action "argument_available" false) (set value true) false) false) false) false)
          (set i (rt_add i 1))))) value)))

; Structured speech: authority is checked by execution, cognition by each owner.
(defn dvs_speech_cognitive_parents (parents previous)
  (if (dv_or (rt_eq previous "") (dv_has parents previous)) parents (dv_append parents previous)))
(defn dvs_speech_ast_nodes (ast)
  (let (op (dv_get ast "op") count 1)
    (do (if (rt_eq op "not") (set count (rt_add count (dvs_speech_ast_nodes (dv_get ast "item"))))
      (if (rt_eq op "all") (let (items (dv_get ast "items") i 0)
        (do (while (rt_lt i (rt_count items)) (do (set count (rt_add count (dvs_speech_ast_nodes (rt_at items i)))) (set i (rt_add i 1)))))) false)) count)))
(defn dvs_speech_map (mind proposition bindings)
  (let (op (dv_get proposition "op"))
    (if (rt_eq op "constant") proposition
      (if (rt_eq op "all")
        (let (mapped (rt_list) i 0 items (dv_get proposition "items"))
          (do (while (rt_lt i (rt_count items))
            (do (rt_push mapped (dvs_speech_map mind (rt_at items i) bindings)) (set i (rt_add i 1)))) (dv_all mapped)))
        (if (rt_eq op "not") (dv_not (dvs_speech_map mind (dv_get proposition "item") bindings))
          (let (ref (dv_get proposition "ref") local (dv_local bindings (dv_get ref "object") (dv_get mind "subject")))
            (if (rt_eq local "")
              (if (dv_has_key (dv_get mind "objects") (dv_get ref "object")) proposition (dv_m2 "op" "constant" "value" "unknown"))
              (dv_with proposition "ref" (dv_ref local (dv_get ref "facet") (dv_get ref "field"))))))))))
(defn dvs_speech_truth (mind speech)
  (dv_truth mind (dvs_speech_map mind (dv_get speech "literal_ast") (dv_find speech "referents" (rt_list)))))
(defn dvs_speech_presuppositions (mind speech)
  (let (items (dv_find speech "presuppositions" (rt_list)) bindings (dv_find speech "referents" (rt_list)) i 0 result (rt_list))
    (do (while (rt_lt i (rt_count items))
      (let (proposition (dvs_speech_map mind (rt_at items i) bindings))
        (do (rt_push result (dv_m2 "proposition" proposition "truth" (dv_truth mind proposition))) (set i (rt_add i 1))))) result)))
(defn dvs_speech_hearing (speaker listener speech)
  (let (source (dv_get speaker "id") channel (dv_find speech "channel" "")
        source_location (dv_find speaker "location" "") target_location (dv_find listener "location" "")
        grants (dv_find listener "hearing_grants" (rt_list)) i 0 heard false)
    (do
      (if (dv_and (rt_not (rt_eq source_location "")) (dv_same source_location target_location)) (set heard true) false)
      (while (rt_lt i (rt_count grants))
        (let (grant (rt_at grants i))
          (do (if (dv_and (rt_eq (dv_get grant "speaker") source) (rt_eq (dv_get grant "channel") channel)) (set heard true) false)
            (set i (rt_add i 1)))))
      heard)))
; Only positive equals atoms support testimony cells. Other ASTs remain speech records.
(defn dvs_speech_observations (mind proposition source origin time trust)
  (let (op (dv_get proposition "op") observations (rt_list))
    (do
      (if (rt_eq op "all")
        (let (items (dv_get proposition "items") i 0)
          (do (while (rt_lt i (rt_count items))
            (let (part (dvs_speech_observations mind (rt_at items i) source origin time trust) j 0)
              (do (while (rt_lt j (rt_count part))
                (do (if (dv_has observations (rt_at part j)) false (rt_push observations (rt_at part j))) (set j (rt_add j 1))))
                (set i (rt_add i 1)))))))
        (if (rt_eq op "equals")
          (let (ref (dv_get proposition "ref"))
            (rt_push observations (dv_observation (dv_list3 source (dv_get mind "subject") ref) (dv_get mind "subject") ref
              (dv_get proposition "value") "testimony" origin time trust (dv_pair origin ref)))) false))
      observations)))
; A received estimated proposal is a public record before any personal adoption.
; Only an owner's declared policy can authorize its bounded testimony support.
(defn dvs_speech_proposal_decision (mind policy speech trust)
  (let (proposal (dv_find speech "proposal" false) status "ordinary" reason "ordinary-testimony"
        confidence trust units 0 acceptance (dv_find policy "proposal_acceptance" false))
    (do
      (if (rt_eq proposal false) false
        (let (claims (dv_find proposal "claims" (rt_list)) required (if (rt_eq acceptance false) (rt_list) (dv_find acceptance "required_slots" (rt_list)))
              propositions (rt_list) allowed true i 0 available "unknown")
          (do
            (set status "retained") (set reason "missing-personal-proposal-policy") (set units 1)
            (set confidence (dv_min trust (dv_find proposal "confidence" 0)))
            (while (rt_lt i (rt_count claims))
              (let (claim (rt_at claims i))
                (do (rt_push propositions (dv_fact (dv_get claim "ref") (dv_get claim "value")))
                  (set units (rt_add units 1)) (set i (rt_add i 1)))))
            (set i 0)
            (while (rt_lt i (rt_count required))
              (let (j 0 found false)
                (do (while (rt_lt j (rt_count claims))
                  (do (if (rt_eq (rt_at required i) (dv_get (rt_at claims j) "slot_id")) (set found true) false)
                    (set units (rt_add units 1)) (set j (rt_add j 1))))
                  (if found false (set allowed false)) (set i (rt_add i 1)))))
            (if (rt_eq acceptance false) false
              (do
                (set available (dv_truth mind (dvs_speech_map mind (dv_find acceptance "available_when" (dv_true)) (dv_find speech "referents" (rt_list)))))
                (set units (rt_add units (rt_mul 2 (dvs_speech_ast_nodes (dv_find acceptance "available_when" (dv_true))))))
                (set reason "personal-proposal-policy-withheld")
                (if (dv_find acceptance "enabled" false) false (set allowed false))
                (if (rt_lt 0 (rt_count (dv_find acceptance "basis" (rt_list)))) false (set allowed false))
                (if (rt_eq available "true") false (set allowed false))
                (if (rt_lt 0 (rt_count required)) false (set allowed false))
                (if (rt_lt 0 (rt_count claims)) false (set allowed false))
                (if (dv_find proposal "estimated" false) false (set allowed false))
                (if (rt_eq (dv_find proposal "argument_id" "") "") (set allowed false) false)
                (if (dv_and (rt_lt 0 (dv_find proposal "confidence" 0)) (rt_lt (dv_find proposal "confidence" 0) 1)) false (set allowed false))
                (if (rt_lt 0 (rt_count (dv_find proposal "source_event_ids" (rt_list)))) false (set allowed false))
                (if (rt_eq (dv_find proposal "model_event" "") "") (set allowed false) false)
                (if (dv_same (dv_all propositions) (dv_get speech "literal_ast")) false (set allowed false))
                (if (rt_lt confidence (dv_find acceptance "confidence_threshold" 0.5)) (set allowed false) false)
                (if allowed (do (set status "accepted") (set reason "personal-bounded-proposal-adoption")) false))))))
      (dv_with (dv_with (dv_m4 "status" status "reason" reason "confidence_cap" confidence "proposal" proposal)
        "policy_basis" (if (rt_eq acceptance false) (rt_list) (dv_find acceptance "basis" (rt_list)))) "calculation_units" units))))
(defn dvs_speech_received_observations (mind parsed source speaker time decision)
  (if (rt_eq (dv_get decision "status") "retained") (rt_list)
    (let (items (dvs_speech_observations mind parsed source speaker time (dv_get decision "confidence_cap")) i 0 result (rt_list))
      (do (while (rt_lt i (rt_count items))
        (do (rt_push result (if (rt_eq (dv_get decision "status") "ordinary") (rt_at items i)
          (dv_with (dv_with (rt_at items i) "estimated" true) "proposal_source" (dv_get decision "proposal"))))
          (set i (rt_add i 1)))) result))))
; Speech exposes cue identity only. Conclusions and priors belong to local rules.
(defn dvs_speech_candidates (policy speech)
  (let (cues (dv_find speech "implicature_candidates" (rt_list)) rules (dv_find policy "implicature_bridges" (rt_list))
        result (rt_list) ids (rt_list) local_ids (rt_list) i 0)
    (do
      (while (rt_lt i (rt_count rules))
        (let (rule (rt_at rules i) id (dv_get (rt_at rules i) "id") required (dv_find (rt_at rules i) "cue" "") j 0 matched false)
          (do
            (rt_push local_ids id)
            (if (rt_eq required "") (set matched true) false)
            (while (rt_lt j (rt_count cues))
              (do (if (rt_eq (dv_get (rt_at cues j) "id") required) (set matched true) false) (set j (rt_add j 1))))
            (if matched (do (rt_push result (dv_m3 "id" id "rule_source" (dv_find rule "basis" (rt_list)) "utterance_scope" (dv_find speech "scope" ""))) (rt_push ids id)) false)
            (set i (rt_add i 1)))))
      (set i 0)
      (while (rt_lt i (rt_count cues))
        (let (cue_id (dv_get (rt_at cues i) "id"))
          (do (if (dv_or (dv_has ids cue_id) (dv_has local_ids cue_id)) false (do (rt_push result (dv_m3 "id" cue_id "rule_source" (rt_list) "utterance_scope" (dv_find speech "scope" ""))) (rt_push ids cue_id))) (set i (rt_add i 1)))))
      result)))
(defn dvs_speech_interpret (mind policy candidate bindings)
  (let (bridges (dv_find policy "implicature_bridges" (rt_list)) i 0 bridge false
        proposition (dv_m2 "op" "constant" "value" "unknown") available (dv_true)
        threshold (dv_find policy "implicature_threshold" 0.5) confidence 0
        basis (rt_list) status "rejected" missing "missing-bridge" scope_check (rt_list) work 0)
    (do
      (while (rt_lt i (rt_count bridges))
        (let (item (rt_at bridges i))
          (do (if (rt_eq (dv_get item "id") (dv_get candidate "id"))
            (do (dv_require (rt_eq bridge false) "Ambiguous interpretation bridge") (set bridge item)) false) (set i (rt_add i 1)))))
      (if (rt_eq bridge false) false
        (let (premise (dvs_speech_map mind (dv_get bridge "premise") bindings)
              bridge_basis (dv_find bridge "basis" (rt_list))
              withdrawal (dvs_speech_map mind (dv_find bridge "withdraw_when" (dv_not (dv_true))) bindings)
              scope_ast (dvs_speech_map mind (dv_find bridge "scope_bridge" (dv_m2 "op" "constant" "value" "unknown")) bindings))
          (do
            (set proposition (dvs_speech_map mind (dv_get bridge "proposition") bindings))
            (set available (dvs_speech_map mind (dv_find bridge "available_when" (dv_true)) bindings))
            (set confidence (dv_unit (dv_find bridge "prior" 0.5)))
            (set basis bridge_basis)
            (set work (rt_add 1 (rt_mul 2 (rt_add (rt_add (dvs_speech_ast_nodes premise) (dvs_speech_ast_nodes proposition))
              (rt_add (dvs_speech_ast_nodes available) (rt_add (dvs_speech_ast_nodes withdrawal) (dvs_speech_ast_nodes scope_ast)))))))
            (let (literal_scope (dv_find candidate "utterance_scope" (dv_find bridge "source_scope" ""))
                  interpreted_scope (dv_find bridge "target_scope" (dv_find bridge "source_scope" ""))
                  scope_truth (dv_truth mind scope_ast)
                  withdraw_truth (dv_truth mind withdrawal) available_truth (dv_truth mind available)
                  premise_truth (dv_truth mind premise) proposition_truth (dv_truth mind proposition))
              (do
              (set scope_check (dv_with (dv_m4 "literal_scope" literal_scope "interpretation_scope" interpreted_scope "bridge_truth" scope_truth
                "check_enabled" (dv_find policy "scope_reference_check" false)) "gap" (dv_and (rt_not (rt_eq literal_scope interpreted_scope)) (rt_not (rt_eq scope_truth "true")))))
            (if (rt_eq withdraw_truth "true")
              (do (set status "withdrawn") (set missing "explicit-withdrawal-evidence"))
              (if (rt_not (rt_eq available_truth "true")) (set missing "availability-not-known")
                (if (rt_eq (rt_count bridge_basis) 0) (set missing "bridge-without-source")
                  (if (rt_not (rt_eq premise_truth "true")) (set missing "bridge-premise-not-known")
                    (if (rt_eq (rt_count basis) 0) (set missing "candidate-without-source")
                      (if (rt_eq proposition_truth "false") (set missing "contrary-evidence")
                        (if (rt_lt confidence threshold) (set missing "below-policy-threshold")
                          (do (set status "accepted") (set missing "")))))))))))
            (if (dv_and (rt_eq status "accepted") (dv_and (dv_get scope_check "check_enabled") (dv_get scope_check "gap")))
              (do (set status "retained") (set missing "scope-reference-bridge-not-supported")) false)
            (set basis (dv_append basis (dv_m2 "bridge" (dv_get bridge "id") "basis" bridge_basis))))))
      (dv_with (dv_with (dv_with (dv_with (dv_with (dv_m4 "id" (dv_get candidate "id") "proposition" proposition "status" status "confidence" confidence)
        "basis" basis) "missing_bridge" missing) "scope_check" scope_check) "kind" "defeasible-interpretation") "calculation_units" work))))
(defn dvs_speech_model_interpretations (mind policy speech bindings)
  (let (candidates (dvs_speech_candidates policy speech) result (rt_list) i 0)
    (do (while (rt_lt i (rt_count candidates))
      (do (rt_push result (dvs_speech_interpret mind policy (rt_at candidates i) bindings)) (set i (rt_add i 1)))) result)))
; Model reception is hypothetical testimony into a private copied prediction world.
; Neither the model nor its alternatives is sourced from another actor's real mind.
(defn dvs_speech_model_prediction (model speech speaker source time)
  (let (before (dv_clone (dv_get model "mind")) policy (dv_get model "policy") bindings (dv_find speech "referents" (rt_list))
        parsed (dvs_speech_map (dv_get model "mind") (dv_get speech "literal_ast") (dv_find speech "referents" (rt_list))))
    (let (decision (dvs_speech_proposal_decision before policy speech (dv_find (dv_find policy "speaker_trust" (rt_list)) speaker 0.5))
          observations (dvs_speech_received_observations before parsed (rt_cat "prediction-" source) speaker time decision)
          profile (dv_observation_profile (dv_m3 "perception" 1 "testimony" 1 "recall" 1) (dv_find policy "observation_threshold" 0.5)))
      (let (receipt (dv_update_mind before observations (dv_get before "revision") profile) after (dv_get receipt "world"))
        (let (primary (dvs_speech_model_interpretations after policy speech bindings)
              checked (dv_find policy "scope_reference_check" false))
        (dv_with (dv_with (dv_with (dv_with (dv_with (dv_with (dv_m4 "model_before" before "model_after" after "predicted_literal" parsed "observations" observations)
          "observation_profile" profile) "prediction" primary)
          "conditional_prediction" (dv_m2
            "scope_reference_check_false" (if checked (dvs_speech_model_interpretations after (dv_with policy "scope_reference_check" false) speech bindings) primary)
            "scope_reference_check_true" (if checked primary (dvs_speech_model_interpretations after (dv_with policy "scope_reference_check" true) speech bindings))))
          "assumptions" (dv_find model "assumptions" (rt_list)))
          "conditional_reuse" (if checked "scope_reference_check_true=primary" "scope_reference_check_false=primary")) "proposal_decision" decision))))))
(defn dvs_speech_rule_units (rule)
  (rt_add 1 (rt_mul 2 (rt_add (rt_add (dvs_speech_ast_nodes (dv_get rule "premise")) (dvs_speech_ast_nodes (dv_get rule "proposition")))
    (rt_add (dvs_speech_ast_nodes (dv_find rule "available_when" (dv_true)))
      (rt_add (dvs_speech_ast_nodes (dv_find rule "withdraw_when" (dv_not (dv_true))))
        (dvs_speech_ast_nodes (dv_find rule "scope_bridge" (dv_m2 "op" "constant" "value" "unknown")))))))))
(defn dvs_speech_prediction_units (model speech)
  (let (rules (dv_find (dv_get model "policy") "implicature_bridges" (rt_list)) candidates (dvs_speech_candidates (dv_get model "policy") speech)
        work (rt_add (dv_get (dvs_speech_proposal_decision (dv_get model "mind") (dv_get model "policy") speech 0.5) "calculation_units")
          (rt_add 1 (rt_mul 2 (dvs_speech_ast_nodes (dv_get speech "literal_ast"))))) i 0)
    (do (while (rt_lt i (rt_count candidates))
      (let (j 0 id (dv_get (rt_at candidates i) "id"))
        (do (while (rt_lt j (rt_count rules))
          (do (if (rt_eq (dv_get (rt_at rules j) "id") id) (set work (rt_add work (rt_mul 2 (dvs_speech_rule_units (rt_at rules j))))) false) (set j (rt_add j 1)))) (set i (rt_add i 1))))) work)))
(defn dvs_speech_goals (actor)
  (let (goals (dv_find (dv_get actor "policy") "communication_goals" (rt_list)) active (rt_list) i 0)
    (do (while (rt_lt i (rt_count goals))
      (let (goal (rt_at goals i))
        (do (if (dv_and (rt_lt 0 (rt_count (dv_find goal "basis" (rt_list))))
          (rt_eq (dv_truth (dv_get actor "mind") (dv_find goal "available_when" (dv_true))) "true"))
          (do (dv_require (rt_not (rt_lt (dv_get goal "weight") 0)) "Negative communication weight") (rt_push active goal)) false) (set i (rt_add i 1))))) active)))
(defn dvs_speech_choice_signature (actor action goals)
  (dv_m4 "mind" (dv_get actor "mind") "speech" (dv_get action "speech") "goals" goals "listeners" (dv_find action "listeners" (rt_list))))
(defn dvs_speech_goal_value (goals listener prediction)
  (let (value 0 i 0 interpretations (dv_get prediction "prediction"))
    (do (while (rt_lt i (rt_count goals))
      (let (goal (rt_at goals i) targets (dv_find (rt_at goals i) "listeners" (rt_list)) j 0)
        (do (if (dv_or (rt_eq (rt_count targets) 0) (dv_has targets listener))
          (while (rt_lt j (rt_count interpretations))
            (let (interpretation (rt_at interpretations j))
              (do (if (dv_and (rt_eq (dv_get interpretation "id") (dv_get goal "interpretation_id"))
                (rt_eq (dv_get interpretation "status") (dv_get goal "desired_status")))
                (set value (rt_add value (rt_mul (dv_get goal "weight") (dv_get interpretation "confidence")))) false) (set j (rt_add j 1))))) false) (set i (rt_add i 1))))) value)))
; A complete candidate layer is quoted before any prediction is evaluated.
; Work draws only from the existing total model budget, never replay-work allowance.
(defn dvs_prepare_speech_choices (actor events time parent)
  (let (goals (dvs_speech_goals actor) actions (dv_get actor "actions") mind (dv_get actor "mind")
        models (dv_find (dv_get actor "mind") "listener_models" (rt_list)) cache (dv_find actor "speech_choice_values" (rt_list))
        candidates (rt_list) eligible (rt_list) total 0 i 0 before actor remaining (dv_find (dv_get actor "policy") "model_budget" 0)
        budget_parent (dv_find actor "model_previous_event" "") choice_cognitive (dv_find actor "last_cognitive_event" ""))
    (do
      (if (rt_eq (rt_count goals) 0) false
        (while (rt_lt i (rt_count actions))
          (let (action (rt_at actions i) id (dv_get (rt_at actions i) "id"))
            (do (if (dv_and (dv_has_key action "speech") (dv_find action "argument_available" true))
              (if (dv_and (rt_not (dv_has (dv_find actor "used" (rt_list)) id)) (rt_eq (dv_truth mind (dv_get action "precondition")) "true"))
                (let (truth (dvs_speech_truth mind (dv_get action "speech")) signature (dvs_speech_choice_signature actor action goals))
                  (if (rt_not (rt_eq truth "true"))
                    (do (set cache (dv_with cache id (dv_m3 "status" "illegal-literal" "utility" 0 "signature" signature)))
                      (dvs_event events "speech_choice_rejected" (dv_get actor "id") time (dv_single parent)
                        (dv_m4 "action" action "actor_before" before "truth" truth "charged_units" 0)))
                    (do (rt_push eligible (dv_pair id signature))
                    (if (if (dv_has_key cache id) (dv_and (rt_eq (dv_get (dv_get cache id) "status") "ready") (dv_same (dv_get (dv_get cache id) "signature") signature)) false) false
                      (let (listeners (dv_find action "listeners" (rt_list)) j 0 units 0)
                        (do (while (rt_lt j (rt_count listeners))
                          (let (listener (rt_at listeners j))
                            (do (if (if (dv_has_key models listener) (rt_lt 0 (rt_count (dv_find (dv_get models listener) "basis" (rt_list)))) false)
                              (set units (rt_add units (dvs_speech_prediction_units (dv_get models listener) (dv_get action "speech")))) false) (set j (rt_add j 1)))))
                          (rt_push candidates (dv_m3 "action" action "signature" signature "units" units)) (set total (rt_add total units)))))))) false) false)
              (set i (rt_add i 1))))))
      (set i 0)
      (if (rt_lt remaining total)
        (do (while (rt_lt i (rt_count eligible))
          (let (entry (rt_at eligible i))
            (do (set cache (dv_with cache (rt_at entry 0)
              (dv_m3 "status" "unknown-incomplete-layer" "utility" 0 "signature" (rt_at entry 1)))) (set i (rt_add i 1)))))
          (if (rt_lt 0 (rt_count candidates))
            (dvs_event events "speech_choice_budget_stop" (dv_get actor "id") time (dv_single parent)
              (dv_m4 "actor_before" before "required_units" total "available_units" remaining "charged_units" 0)) false))
        (while (rt_lt i (rt_count candidates))
          (let (entry (rt_at candidates i) action (dv_get (rt_at candidates i) "action") forecasts (rt_list) event_ids (rt_list)
                listeners (dv_find (dv_get (rt_at candidates i) "action") "listeners" (rt_list)) j 0 value 0)
            (do (while (rt_lt j (rt_count listeners))
              (let (listener (rt_at listeners j) data false units 0)
                (do
                  (if (if (dv_has_key models listener) (rt_lt 0 (rt_count (dv_find (dv_get models listener) "basis" (rt_list)))) false)
                    (do (set units (dvs_speech_prediction_units (dv_get models listener) (dv_get action "speech")))
                      (set data (dvs_speech_model_prediction (dv_get models listener) (dv_get action "speech") (dv_get actor "id")
                        (rt_cat "preselect-" (dv_get action "id")) time))
                      (set data (dv_with (dv_with data "status" "model-based") "model" (dv_get models listener)))
                      (set value (rt_add value (dvs_speech_goal_value goals listener data))))
                    (set data (dv_m2 "status" "unknown-no-model" "prediction" (rt_list))))
                  (set data (dv_with (dv_with (dv_with (dv_with (dv_with (dv_with data "listener" listener) "action" action)
                    "actor_before" (dv_with (dv_with (dv_with actor "policy" (dv_with (dv_get actor "policy") "model_budget" remaining)) "model_previous_event" budget_parent) "last_cognitive_event" choice_cognitive))
                    "budget_before" remaining) "charged_units" units) "goals" goals))
                  (set remaining (rt_sub remaining units))
                  (set data (dv_with data "budget_after" remaining))
                  (set data (dv_with data "prediction_time" time))
                  (set data (dv_with data "actor_after" (dv_with (dv_with (dv_with actor "policy" (dv_with (dv_get actor "policy") "model_budget" remaining))
                    "model_previous_event" (if (rt_lt 0 units) (rt_cat "e" (rt_show (rt_count events))) budget_parent))
                      "last_cognitive_event" (if (rt_lt 0 units) (rt_cat "e" (rt_show (rt_count events))) choice_cognitive))))
                  (let (prediction_id (dvs_event events "speech_choice_prediction" (dv_get actor "id") time
                    (dvs_speech_cognitive_parents (if (rt_eq budget_parent "") (dv_single parent) (dv_pair parent budget_parent)) choice_cognitive) data))
                    (do (rt_push event_ids prediction_id) (if (rt_lt 0 units) (do (set budget_parent prediction_id) (set choice_cognitive prediction_id)) false)))
                  (rt_push forecasts (dv_pair listener data)) (set j (rt_add j 1)))))
              (set cache (dv_with cache (dv_get action "id") (dv_with (dv_with (dv_m4 "status" "ready" "utility" value "signature" (dv_get entry "signature") "forecasts" forecasts)
                "prediction_events" event_ids) "charged_units" (dv_get entry "units"))))
              (set i (rt_add i 1))))))
      (dv_with (dv_with (dv_with (dv_with actor "speech_choice_values" cache) "policy" (dv_with (dv_get actor "policy") "model_budget" remaining))
        "model_previous_event" budget_parent) "last_cognitive_event" choice_cognitive))))
; Reassessment consumes personal reasoning and withdraws only a scoped interpretation.
(defn dvs_proposal_reassess (actor decision events time parent)
  (let (rule (dv_find (dv_get actor "policy") "proposal_reassessment" false)
        proposal (dv_get decision "proposal") interpretations (dv_find actor "interpretations" (rt_list))
        remaining (dv_find (dv_get actor "policy") "reason_budget" 0) last (dv_find actor "last_interpretation_event" "")
        cognitive (dv_find actor "last_cognitive_event" "")
        seen (dv_find actor "reassessed_proposals" (rt_list)) proposal_id (if (rt_eq (dv_get decision "proposal") false) "" (dv_find (dv_get decision "proposal") "argument_id" "")))
    (do
      (if (dv_and (rt_eq (dv_get decision "status") "accepted") (rt_not (dv_has seen proposal_id)))
        (if (rt_eq rule false) false
          (if (dv_and (dv_find rule "enabled" false) (rt_lt 0 (rt_count (dv_find rule "basis" (rt_list)))))
            (let (targets (dv_find rule "interpretation_ids" (rt_list)) required (dv_find rule "required_slots" (rt_list))
                  claims (dv_find proposal "claims" (rt_list)) complete true i 0)
              (do
                (if (rt_eq (rt_count required) 0) (set complete false) false)
                (while (rt_lt i (rt_count required))
                  (let (j 0 found false)
                    (do (while (rt_lt j (rt_count claims))
                      (do (if (rt_eq (rt_at required i) (dv_get (rt_at claims j) "slot_id")) (set found true) false) (set j (rt_add j 1))))
                      (if found false (set complete false)) (set i (rt_add i 1)))))
                (set i 0)
                (while (rt_lt i (rt_count targets))
                  (let (id (rt_at targets i) old (dv_find interpretations (rt_at targets i) false) status "insufficient-origin" charged 0
                        before (dv_with (dv_with (dv_with (dv_with actor "interpretations" interpretations) "policy" (dv_with (dv_get actor "policy") "reason_budget" remaining)) "last_interpretation_event" last) "last_cognitive_event" cognitive))
                    (do
                      (if (rt_eq old false) (set status "no-personal-interpretation")
                        (let (scope (dv_find old "scope_check" (rt_list)) source (dv_find old "source_event" ""))
                          (do (if (rt_eq (dv_get old "status") "accepted") false (set status "no-prior-accepted-interpretation"))
                          (if (dv_and complete (dv_and (rt_eq (dv_get old "status") "accepted")
                            (dv_and (dv_has (dv_find proposal "reassessment_sources" (rt_list)) source)
                              (dv_and (rt_eq (dv_find scope "literal_scope" "") (dv_find rule "source_scope" ""))
                                (rt_eq (dv_find scope "interpretation_scope" "") (dv_find rule "target_scope" ""))))))
                            (if (rt_lt remaining 1) (set status "reason-budget-exhausted")
                              (do (set remaining (rt_sub remaining 1)) (set charged 1)
                                (let (candidate (dv_m2 "id" id "utterance_scope" (dv_find scope "literal_scope" ""))
                                      revised (dvs_speech_interpret (dv_get actor "mind") (dv_get actor "policy")
                                        (dv_m2 "id" id "utterance_scope" (dv_find scope "literal_scope" "")) (dv_find old "referents" (rt_list))))
                                  (if (rt_eq (dv_get (dv_get revised "scope_check") "bridge_truth") "unknown")
                                    (do (set status "withdrawn")
                                      (set interpretations (dv_with interpretations id (dv_with (dv_with (dv_with old "status" "withdrawn") "withdrawal_reason" "paid-scope-bridge-unsupported") "proposal_event" parent))))
                                    (set status "retained-supported-bridge"))))) false))))
                      (let (after (dv_with (dv_with (dv_with (dv_with actor "interpretations" interpretations) "policy" (dv_with (dv_get actor "policy") "reason_budget" remaining)) "last_interpretation_event" (rt_cat "e" (rt_show (rt_count events)))) "last_cognitive_event" (rt_cat "e" (rt_show (rt_count events)))))
                        (do
                          (set last (dvs_event events (if (rt_eq status "withdrawn") "implicature_withdrawn" "proposal_scope_reassessment") (dv_get actor "id") time
                            (dvs_speech_cognitive_parents
                              (if (rt_eq last "") (dv_pair parent (if (rt_eq old false) "" (dv_find old "source_event" "")))
                                (dv_list3 parent (if (rt_eq old false) "" (dv_find old "source_event" "")) last)) cognitive)
                            (dv_with (dv_with (dv_with (dv_with (dv_with (dv_with (dv_m4 "status" status "actor_before" before "actor_after" after "charged_units" charged)
                              "mind_before" (dv_get actor "mind")) "mind_after" (dv_get actor "mind"))
                              "interpretations_before" (dv_find before "interpretations" (rt_list))) "interpretations_after" interpretations)
                              "source_event" (if (rt_eq old false) "" (dv_find old "source_event" ""))) "proposal" proposal)))
                          (set cognitive last)
                          (set i (rt_add i 1)))))))
                (set seen (dv_append seen proposal_id)))) false)) false)
      (dv_with (dv_with (dv_with (dv_with (dv_with actor "interpretations" interpretations) "policy" (dv_with (dv_get actor "policy") "reason_budget" remaining))
        "last_interpretation_event" last) "reassessed_proposals" seen) "last_cognitive_event" cognitive))))
(defn dvs_speech (actors speaker_index action events time parent)
  (let (speaker (rt_at actors speaker_index) speech (dv_get action "speech") speaker_mind (dv_get speaker "mind")
        bindings (dv_find speech "referents" (rt_list)) literal (dv_get speech "literal_ast")
        claim (dvs_speech_map speaker_mind literal bindings) listeners (dv_find action "listeners" (rt_list))
        next (dv_clone actors) i 0 source false visited (rt_list))
    (do
      (set source (dvs_event events "speech_literal" (dv_get speaker "id") time (dvs_speech_cognitive_parents (dv_single parent) (dv_find speaker "last_cognitive_event" ""))
        (dv_with (dv_m4 "literal" literal "claim" claim "mind_before" speaker_mind "speech" speech) "speaker_truth" (dv_truth speaker_mind claim))))
      (if (rt_not (rt_eq (dv_truth speaker_mind claim) "true"))
        (dvs_event events "speech_rejected" (dv_get speaker "id") time (dv_single source) (dv_m2 "reason" "speaker-truth-not-supported" "source_event" source))
        (while (rt_lt i (rt_count listeners))
          (let (listener_id (rt_at listeners i) j 0 target_index -1
                prepared (dv_find (dv_find speaker "speech_choice_values" (rt_list)) (dv_get action "id") false))
            (do
              (dv_require (rt_not (dv_has visited listener_id)) "Repeated speech listener")
              (rt_push visited listener_id)
              (while (rt_lt j (rt_count next))
                (do (if (rt_eq (dv_get (rt_at next j) "id") listener_id) (set target_index j) false) (set j (rt_add j 1))))
              (if (if (rt_eq prepared false) false (rt_eq (dv_get prepared "status") "ready"))
                (let (predicted (dv_find (dv_get prepared "forecasts") listener_id (dv_m2 "status" "unknown-no-model" "prediction" (rt_list))))
                  (dvs_event events "speaker_prediction" (dv_get speaker "id") time (dv_append (dv_get prepared "prediction_events") source)
                    (dv_with (dv_with (dv_with (dv_with (dv_with (dv_with (dv_with predicted "source_event" source) "paid_prediction_events" (dv_get prepared "prediction_events"))
                      "paid_forecast" predicted) "charged_units" 0) "execution_charged_units" 0) "speaker_after" speaker)
                        "preselection_source_revision" (dv_get (dv_get (dv_get predicted "actor_before") "mind") "revision"))))
                (dvs_event events "speaker_prediction" (dv_get speaker "id") time (dv_single source)
                  (dv_m3 "listener" listener_id "status" "unknown-no-paid-preselection" "source_event" source)))
              (if (rt_lt target_index 0)
                (dvs_event events "speech_unheard" listener_id time (dv_single source) (dv_m2 "reason" "unknown-listener" "source_event" source))
                (let (listener (rt_at next target_index))
                  (if (rt_not (dvs_speech_hearing speaker listener speech))
                    (dvs_event events "speech_unheard" listener_id time (dv_single source) (dv_m2 "reason" "no-audibility-grant" "source_event" source))
                    (let (before (dv_get listener "mind") parsed (dvs_speech_map before literal bindings)
                          policy (dv_get listener "policy") trust (dv_find (dv_find (dv_get listener "policy") "speaker_trust" (rt_list)) (dv_get speaker "id") 0.5)
                          decision (dvs_speech_proposal_decision before policy speech trust)
                          observations (dvs_speech_received_observations before parsed source (dv_get speaker "id") time decision)
                          profile (dv_observation_profile (dv_m3 "perception" 1 "testimony" 1 "recall" 1) (dv_find (dv_get listener "policy") "observation_threshold" 0.5)))
                      (let (receipt (dv_update_mind before observations (dv_get before "revision") profile) after (dv_get receipt "world")
                            interpretations (dv_find listener "interpretations" (rt_list)) last_interpretation (dv_find listener "last_interpretation_event" "")
                            candidates_actual (dvs_speech_candidates policy speech) n 0 parse_event false proposal_event false)
                        (do
                          (if (rt_eq (dv_get decision "status") "ordinary") false
                            (do
                              (set proposal_event (dvs_event events "proposal_receipt" listener_id time (dvs_speech_cognitive_parents (dv_single source) (dv_find listener "last_cognitive_event" ""))
                                (dv_with (dv_with (dv_with decision "source_event" source) "mind_before" before) "mind_after" before)))
                              (set proposal_event (dvs_event events "proposal_adoption" listener_id time (dv_pair source proposal_event)
                                (dv_with (dv_with (dv_with decision "source_event" source) "mind_before" before) "mind_after" after)))))
                          (set parse_event (dvs_event events "listener_parse" listener_id time
                            (dvs_speech_cognitive_parents (if (rt_eq proposal_event false) (dv_single source) (dv_pair source proposal_event)) (dv_find listener "last_cognitive_event" ""))
                            (dv_with (dv_with (dv_with (dv_with (dv_with (dv_with (dv_m4 "mind_before" before "mind_after" after "literal" parsed "observations" observations)
                              "source_event" source) "speech" speech) "presuppositions" (dvs_speech_presuppositions before speech))
                              "audibility" (dv_m3 "speaker_location" (dv_find speaker "location" "") "listener_location" (dv_find listener "location" "")
                                "hearing_grants" (dv_find listener "hearing_grants" (rt_list)))) "observation_profile" profile) "proposal_decision" decision)))
                          (while (rt_lt n (rt_count candidates_actual))
                            (let (candidate (rt_at candidates_actual n) interpretation (dvs_speech_interpret after policy (rt_at candidates_actual n) bindings)
                                  interpretations_before (dv_clone interpretations))
                              (do
                                (set interpretation (dv_with (dv_with interpretation "source_event" source) "referents" bindings))
                                (if (dv_and (rt_eq (dv_get interpretation "status") "withdrawn")
                                  (rt_not (if (dv_has_key interpretations (dv_get candidate "id"))
                                    (rt_eq (dv_get (dv_get interpretations (dv_get candidate "id")) "status") "accepted") false)))
                                  (set interpretation (dv_with interpretation "status" "rejected")) false)
                                (set interpretations (dv_with interpretations (dv_get candidate "id") interpretation))
                                (set last_interpretation (dvs_event events (if (rt_eq (dv_get interpretation "status") "withdrawn") "implicature_withdrawn" "implicature") listener_id time
                                  (if (rt_eq last_interpretation "") (dv_pair source parse_event) (dv_list3 source parse_event last_interpretation))
                                  (dv_with (dv_with (dv_with (dv_with (dv_with interpretation "source_event" source) "mind_before" after) "mind_after" after)
                                    "interpretations_before" interpretations_before) "interpretations_after" interpretations)))
                                (set n (rt_add n 1)))))
                          (set next (dvs_replace next target_index (dvs_proposal_reassess (dv_with (dv_with (dv_with (dv_with (dv_with listener "mind" after) "interpretations" interpretations) "last_interpretation_event" last_interpretation)
                            "proposals" (if (rt_eq (dv_get decision "status") "ordinary") (dv_find listener "proposals" (rt_list))
                              (dv_append (dv_find listener "proposals" (rt_list)) (dv_with decision "source_event" source)))) "last_cognitive_event" parse_event) decision events time parse_event)))))))))
              (set i (rt_add i 1))))))
      next)))

; New personal evidence can defeat an earlier interpretation without new speech.
; This operation never writes observations or negates the interpreted proposition.
(defn dvs_pragmatics_reconsider (actor events time parent)
  (let (mind (dv_get actor "mind") policy (dv_get actor "policy") interpretations (dv_find actor "interpretations" (rt_list))
        entries (dv_clone (dv_find actor "interpretations" (rt_list))) i 0 last (dv_find actor "last_interpretation_event" "")
        cognitive (dv_find actor "last_cognitive_event" ""))
    (do
      (while (rt_lt i (rt_count entries))
        (let (entry (rt_at entries i) old (rt_at (rt_at entries i) 1))
          (do
            (if (rt_eq (dv_get old "status") "accepted")
              (let (candidate (dv_m2 "id" (rt_at entry 0) "utterance_scope" (dv_find (dv_find old "scope_check" (rt_list)) "literal_scope" ""))
                    bindings (dv_find old "referents" (rt_list)))
                (let (revised (dvs_speech_interpret mind policy candidate bindings) before_interpretations (dv_clone interpretations)
                      source (dv_find old "source_event" ""))
                  (if (rt_eq (dv_get revised "status") "withdrawn")
                    (do
                      (set revised (dv_with (dv_with revised "source_event" source) "referents" bindings))
                      (set interpretations (dv_with interpretations (rt_at entry 0) revised))
                      (set last (dvs_event events "implicature_withdrawn" (dv_get actor "id") time
                        (dvs_speech_cognitive_parents (if (rt_eq last "") (dv_pair parent source) (dv_list3 parent source last)) cognitive)
                        (dv_with (dv_with (dv_with (dv_with revised "mind_before" mind) "mind_after" mind)
                          "interpretations_before" before_interpretations) "interpretations_after" interpretations)))
                      (set cognitive last)) false))) false)
            (set i (rt_add i 1)))))
      (dv_with (dv_with (dv_with actor "interpretations" interpretations) "last_interpretation_event" last) "last_cognitive_event" cognitive))))

; Subject-local counterfactual temporal models. No authority or other actor lookup.
(defn dvs_sim_refs (proposition)
  (let (op (dv_get proposition "op"))
    (if (dv_or (rt_eq op "equals") (rt_eq op "at_least")) (dv_single (dv_get proposition "ref"))
      (if (rt_eq op "not") (dvs_sim_refs (dv_get proposition "item"))
        (if (rt_eq op "all")
          (let (items (dv_get proposition "items") refs (rt_list) i 0)
            (do (while (rt_lt i (rt_count items))
              (let (nested (dvs_sim_refs (rt_at items i)) j 0)
                (do (while (rt_lt j (rt_count nested))
                  (do (if (dv_has refs (rt_at nested j)) false (rt_push refs (rt_at nested j))) (set j (rt_add j 1))))
                  (set i (rt_add i 1))))) refs)) (rt_list))))))
(defn dvs_sim_plan (hypothesis)
  (let (timeline (dv_find hypothesis "timeline" (rt_list)) plan (rt_list) i 0)
    (do (if (dv_has_key hypothesis "timeline")
      (while (rt_lt i (rt_count timeline))
        (let (stage (rt_at timeline i) j 0)
          (do (if (dv_has_key stage "response")
            (rt_push plan (dv_with (dv_with (dv_m4 "law" "" "at" (dv_get stage "at") "optional" (dv_find stage "optional" false) "stage" i) "response" (dv_get stage "response")) "available_when" (dv_find stage "available_when" (dv_true))))
            (let (laws (if (dv_has_key stage "laws") (dv_get stage "laws") (dv_single (dv_get stage "law"))))
              (do (dv_require (rt_lt 0 (rt_count laws)) "Empty model event stage")
                (while (rt_lt j (rt_count laws))
                  (do (rt_push plan (dv_m4 "law" (rt_at laws j) "at" (dv_get stage "at") "optional" (dv_find stage "optional" false) "stage" i)) (set j (rt_add j 1)))))))
            (set i (rt_add i 1)))))
      (let (laws (dv_find hypothesis "predict_laws" (rt_list)))
        (while (rt_lt i (rt_count laws))
          (do (rt_push plan (dv_m4 "law" (rt_at laws i) "at" 0 "optional" false "stage" i)) (set i (rt_add i 1)))))) plan)))
; An undecidable conditional reaction invalidates its possible outputs, not merely its score.
(defn dvs_sim_withhold (world effects)
  (let (copy world refs (rt_list) i 0)
    (do (while (rt_lt i (rt_count effects))
      (let (ref (dv_get (rt_at effects i) "ref"))
        (do (if (dv_has_key (dv_get copy "objects") (dv_get ref "object"))
          (do (set copy (dv_store copy ref (dv_unknown))) (rt_push refs ref)) false) (set i (rt_add i 1)))))
      (dv_m2 "world" copy "refs" refs))))
(defn dvs_sim_feature (feature)
  (if (dv_has_key feature "proposition") (dv_get feature "proposition") feature))
; Withhold predicted output fields before replay. Repeating old observations is not prediction.
(defn dvs_sim_mask (mind plan start)
  (let (copy (dv_with (dv_with (dv_with mind "time" start) "seen" (rt_list)) "history" (rt_list)) i 0)
    (do (while (rt_lt i (rt_count plan))
      (let (name (dv_get (rt_at plan i) "law") adoptions (dv_get mind "adoptions"))
        (do (if (dv_has_key adoptions name)
          (let (adoption (dv_get adoptions name) j 0 effects (dv_get (dv_get (dv_get adoptions name) "law") "effects"))
            (do (if (dv_and (dv_get adoption "active") (rt_eq (dv_get adoption "mode") "predict"))
              (while (rt_lt j (rt_count effects))
                (let (ref (dv_get (rt_at effects j) "ref"))
                  (do (if (dv_has_key (dv_get copy "objects") (dv_get ref "object"))
                    (set copy (dv_store copy ref (dv_unknown))) false) (set j (rt_add j 1))))) false))) false)
          (set i (rt_add i 1))))) copy)))
(defn dvs_sim_inputs (world proposition)
  (let (refs (dvs_sim_refs proposition) i 0 inputs (rt_list))
    (do (while (rt_lt i (rt_count refs))
      (do (rt_push inputs (dv_m2 "ref" (rt_at refs i) "cell" (dv_read world (rt_at refs i)))) (set i (rt_add i 1)))) inputs)))
(defn dvs_sim_snapshot (snapshots final covered feature)
  (if (dv_has_key feature "at")
    (let (i 0 selected (dv_m3 "world" final "coverage" (rt_list) "step" -1) found false at (dv_get feature "at"))
      (do (dv_require (rt_not (rt_lt at 0)) "Negative model feature time")
        (while (rt_lt i (rt_count snapshots))
          (let (snapshot (rt_at snapshots i))
            (do (if (rt_eq at (dv_get snapshot "at"))
              (do (set selected snapshot) (set found true)) false) (set i (rt_add i 1)))))
        (if found selected (dv_m3 "world" final "coverage" (rt_list) "step" -1))))
    (dv_m3 "world" final "coverage" covered "step" (rt_sub (rt_count snapshots) 1))))
(defn dvs_sim_prediction (feature snapshot start)
  (let (proposition (dvs_sim_feature feature) refs (dvs_sim_refs (dvs_sim_feature feature)) world (dv_get snapshot "world")
        coverage (dv_get snapshot "coverage") i 0 cells (rt_list) valid true confidence 1)
    (do (if (rt_eq (rt_count refs) 0) (set valid false) false)
      (while (rt_lt i (rt_count refs))
        (let (ref (rt_at refs i) cell (dv_read world (rt_at refs i)))
          (do (rt_push cells (dv_m2 "ref" ref "cell" cell))
            (if (dv_and (dv_has coverage ref) (dv_uncontested cell))
              (set confidence (dv_min confidence (dv_get cell "confidence"))) (set valid false)) (set i (rt_add i 1)))))
      (dv_with (dv_with (dv_with (dv_m4 "feature" feature "proposition" proposition "prediction" (if valid (dv_truth world proposition) "unknown") "cells" cells)
        "covered" valid) "confidence" (if valid confidence 0)) "source_step" (dv_find snapshot "step" -1)))))
(defn dvs_sim_compare (mind prediction)
  (let (feature (dv_get prediction "feature") proposition (dv_get prediction "proposition") refs (dvs_sim_refs (dv_find (dv_get prediction "feature") "observation" (dv_get prediction "proposition")))
        observation (dv_truth mind (dv_find (dv_get prediction "feature") "observation" (dv_get prediction "proposition"))) certainty (dv_get prediction "confidence") available true temporal_mismatch false i 0 observed (rt_list))
    (do (while (rt_lt i (rt_count refs))
      (let (cell (dv_read mind (rt_at refs i)))
        (do (rt_push observed (dv_m2 "ref" (rt_at refs i) "cell" cell))
          (if (dv_uncontested cell) (set certainty (dv_min certainty (dv_get cell "confidence"))) (set available false)) (set i (rt_add i 1)))))
      (if (dv_has_key feature "occurrence_ref")
        (let (occurrence (dv_read mind (dv_get feature "occurrence_ref")))
          (do (rt_push observed (dv_m2 "ref" (dv_get feature "occurrence_ref") "cell" occurrence))
            (if (dv_uncontested occurrence)
              (do (set certainty (dv_min certainty (dv_get occurrence "confidence")))
                (if (dv_same (dv_get occurrence "value") (dv_get feature "occurrence_time")) false (set temporal_mismatch true)))
              (set available false)))) false)
      (let (resolved (dv_and available (dv_and (dv_get prediction "covered")
        (dv_and (rt_lt 0 certainty) (dv_and (rt_not (rt_eq observation "unknown")) (rt_not (rt_eq (dv_get prediction "prediction") "unknown")))))))
        (dv_with (dv_with (dv_with (dv_m4 "feature" feature "prediction" (dv_get prediction "prediction") "observation" (if available observation "unknown") "covered" (dv_get prediction "covered"))
          "confidence" (if resolved certainty 0)) "observed_cells" observed) "result"
          (if resolved (if (dv_and (rt_not temporal_mismatch) (rt_eq observation (dv_get prediction "prediction"))) "match" "contradiction") "unknown"))))))
(defn dvs_sim_comparisons (mind predictions budget)
  (let (remaining budget expanded 0 i 0 fit 0 comparisons (rt_list) contradictions (rt_list) complete true probes (rt_list))
    (do (dv_require (rt_not (rt_lt budget 0)) "Negative simulation comparison budget")
      (while (dv_and (rt_lt i (rt_count predictions)) (rt_not (rt_lt remaining 1)))
        (let (prediction (rt_at predictions i) comparison (dvs_sim_compare mind (rt_at predictions i)) j 0 refs (dvs_sim_refs (dv_get (rt_at predictions i) "proposition")))
          (do (set remaining (rt_sub remaining 1)) (set expanded (rt_add expanded 1)) (rt_push comparisons comparison)
            (if (rt_eq (dv_get comparison "result") "match") (set fit (rt_add fit (dv_get comparison "confidence")))
              (if (rt_eq (dv_get comparison "result") "contradiction") (rt_push contradictions comparison)
                (do (set complete false) (while (rt_lt j (rt_count refs))
                  (do (if (dv_has probes (rt_at refs j)) false (rt_push probes (rt_at refs j))) (set j (rt_add j 1)))))))
            (set i (rt_add i 1)))))
      (if (dv_or (rt_eq (rt_count predictions) 0) (rt_lt i (rt_count predictions))) (set complete false) false)
      (dv_with (dv_with (dv_with (dv_m4 "fit" (if (rt_lt 0 (rt_count contradictions)) -1000000 fit) "comparisons" comparisons "contradictions" contradictions "remaining" remaining)
        "expanded" expanded) "probe_refs" probes) "status" (if (rt_lt 0 (rt_count contradictions)) "inconsistent" (if complete "explained" "unknown"))))))
(defn dvs_sim_work_budget (actor)
  (let (policy (dv_get actor "policy") total (dv_find (dv_get actor "policy") "model_budget" 0)
        work (dv_find (dv_get actor "policy") "model_work_remaining" (dv_find (dv_get actor "policy") "model_work_limit" (dv_find (dv_get actor "policy") "model_budget" 0))))
    (do (dv_require (rt_not (rt_lt work 0)) "Negative method work limit")
      (dv_require (rt_not (rt_lt total 0)) "Negative total model budget") (dv_min total work))))
(defn dvs_model (actor hypothesis events time parent)
  (let (mind (dv_get actor "mind") plan (dvs_sim_plan hypothesis) start (dv_find hypothesis "start_time" time)
        predicted false assumptions (dv_find hypothesis "assumptions" (rt_list)) features (dv_find hypothesis "features" (rt_list))
        remaining (dvs_sim_work_budget actor) total_budget (dv_find (dv_get actor "policy") "model_budget" 0) expanded 0 failures (rt_list) covered (rt_list) trace (rt_list)
        snapshots (rt_list) predictions (rt_list) assumption_records (rt_list) confidence (dv_unit (dv_find hypothesis "prior" 0.5))
        i 0 complete true last_at 0)
    (do (dv_domain mind "mind") (dv_require (rt_not (rt_lt remaining 0)) "Negative simulation budget")
      (dv_require (rt_not (rt_lt start 0)) "Negative model origin time") (set predicted (dvs_sim_mask_response actor (dvs_sim_mask mind plan start) plan))
      (if (rt_lt 0 (rt_count assumptions)) (dv_require (rt_lt confidence 1) "Hypothetical assumption cannot have certainty") false)
      (while (dv_and (rt_lt i (rt_count assumptions)) (rt_not (rt_lt remaining 1)))
        (let (assumption (rt_at assumptions i))
          (do (set remaining (rt_sub remaining 1)) (set expanded (rt_add expanded 1))
            (if (rt_eq (dv_get assumption "op") "equals")
              (let (ref (dv_get assumption "ref"))
                (if (dv_has_key (dv_get predicted "objects") (dv_get ref "object"))
                  (do (set predicted (dv_store predicted ref (dv_cell (dv_get assumption "value") confidence start (dv_get hypothesis "basis"))))
                    (rt_push assumption_records (dv_m3 "proposition" assumption "confidence" confidence "role" "hypothetical-only")))
                  (do (set complete false) (rt_push failures (dv_m2 "assumption" assumption "reason" "unknown-subject-local-object")))))
              (do (set complete false) (rt_push failures (dv_m2 "assumption" assumption "reason" "unsupported-assumption"))))
            (set i (rt_add i 1)))))
      (if (rt_lt i (rt_count assumptions)) (set complete false) false)
      (set i 0)
      (while (dv_and (rt_lt i (rt_count plan)) (rt_not (rt_lt remaining 1)))
        (let (step (rt_at plan i) name (dv_get (rt_at plan i) "law") at (dv_get (rt_at plan i) "at") adoptions (dv_get mind "adoptions"))
          (do (dv_require (rt_not (rt_lt at last_at)) "Model time cannot move backwards")
            (set remaining (rt_sub remaining 1)) (set expanded (rt_add expanded 1)) (set last_at at)
            (if (dv_has_key step "response")
              (let (response (dvs_sim_gated_response actor (dv_with predicted "domain" "mind") step (rt_add start at) remaining confidence) detail (dv_get response "detail"))
                (do (set predicted (dv_get response "world")) (set remaining (dv_get response "remaining"))
                  (set expanded (rt_add expanded (dv_get detail "expanded")))
                  (set detail (dv_with detail "choice_record_changes" (dv_get response "changes")))
                  (if (rt_eq (dv_get detail "status") "selected")
                    (let (bridge (dvs_sim_response_bridge actor predicted detail (rt_add start at) remaining confidence))
                      (do (set predicted (dv_get bridge "world")) (set remaining (dv_get bridge "remaining"))
                        (set expanded (rt_add expanded (dv_get bridge "expanded")))
                        (set detail (dv_with detail "bridge" bridge))
                        (if (rt_eq (dv_get bridge "status") "applied")
                          (let (changes (dv_get bridge "changes") j 0)
                            (while (rt_lt j (rt_count changes))
                              (do (if (dv_has covered (dv_get (rt_at changes j) "ref")) false (rt_push covered (dv_get (rt_at changes j) "ref"))) (set j (rt_add j 1)))))
                          (do (set complete false) (rt_push failures (dv_m2 "response" (dv_get step "response") "reason" (dv_get bridge "status")))))))
                    (if (dv_and (rt_eq (dv_get detail "status") "not-applicable") (dv_get step "optional")) false
                      (do (set complete false) (rt_push failures (dv_m2 "response" (dv_get step "response") "reason" (dv_get detail "reason"))))))
                  (rt_push trace (dv_m4 "step" i "at" at "stage" (dv_get step "stage") "response" detail))))
              (if (dv_has_key adoptions name)
              (let (adoption (dv_get adoptions name))
                (if (dv_and (dv_get adoption "active") (rt_eq (dv_get adoption "mode") "predict"))
                  (let (law (dv_get adoption "law") premise (dv_truth predicted (dv_get (dv_get adoption "law") "premise"))
                        inputs (dvs_sim_inputs predicted (dv_get (dv_get adoption "law") "premise"))
                        local_confidence (dv_min (dv_get adoption "confidence") (dv_min confidence (dv_premise_confidence predicted (dv_get (dv_get adoption "law") "premise")))) result false withheld (rt_list))
                    (do (set predicted (dv_with predicted "adoptions" (dv_with adoptions name (dv_with adoption "confidence" local_confidence))))
                      (set result (dv_predict (dv_with predicted "domain" "mind") name
                        (rt_cat (rt_cat "hypothetical-" (rt_show (rt_count events))) (rt_cat "-" (rt_show i))) (rt_add start at) (dv_get predicted "revision")))
                      (if (rt_eq premise "unknown")
                        (let (uncertain (dvs_sim_withhold predicted (dv_get law "effects")))
                          (do (set predicted (dv_get uncertain "world")) (set withheld (dv_get uncertain "refs")))) false)
                      (rt_push trace (dv_with (dv_with (dv_with (dv_with (dv_with (dv_with (dv_with (dv_with (dv_m4 "step" i "at" at "law" name "premise" premise)
                        "inputs" inputs) "status" (dv_get result "status")) "changes" (dv_get result "changes")) "basis" (dv_get adoption "basis"))
                        "stage" (dv_get step "stage")) "optional" (dv_get step "optional")) "withheld" withheld) "reason"
                        (if (rt_eq premise "false") (if (dv_get step "optional") "condition-false-not-applicable" "required-premise-false")
                          (if (rt_eq premise "unknown") "conditional-output-unknown" (dv_get result "status")))))
                      (if (rt_eq (dv_get result "status") "applied")
                        (let (changes (dv_get result "changes") j 0)
                          (do (set predicted (dv_get result "world"))
                            (while (rt_lt j (rt_count changes))
                              (do (if (dv_has covered (dv_get (rt_at changes j) "ref")) false (rt_push covered (dv_get (rt_at changes j) "ref"))) (set j (rt_add j 1))))))
                        (if (dv_and (rt_eq premise "false") (dv_get step "optional")) false
                          (do (set complete false) (rt_push failures (dv_m3 "law" name "reason" (dv_get result "status") "premise" premise)))))))
                  (do (set complete false) (rt_push failures (dv_m2 "law" name "reason" "not-adopted-predict")))))
              (do (set complete false) (rt_push failures (dv_m2 "law" name "reason" "unknown-law")))))
            (rt_push snapshots (dv_m4 "world" predicted "coverage" (dv_clone covered) "step" i "at" at))
            (set i (rt_add i 1)))))
      (if (dv_or (rt_eq (rt_count plan) 0) (rt_lt i (rt_count plan))) (set complete false) false)
      (set i 0)
      (while (rt_lt i (rt_count features))
        (do (rt_push predictions (dvs_sim_prediction (rt_at features i) (dvs_sim_snapshot snapshots predicted covered (rt_at features i)) start)) (set i (rt_add i 1))))
      (let (comparison (dvs_sim_comparisons mind predictions remaining) result false)
        (do (set result (dv_with (dv_with (dv_with (dv_with (dv_with (dv_with (dv_with comparison "expanded" (rt_add expanded (dv_get comparison "expanded")))
          "failures" failures) "coverage" covered) "assumptions" assumption_records) "predictions" predictions) "trace" trace) "predicted" predicted))
          (if (dv_and (rt_not complete) (rt_eq (dv_get result "status") "explained")) (set result (dv_with result "status" "unknown")) false)
          (set result (dv_with (dv_with (dv_with (dv_with (dv_with result "plan_complete" complete) "source_revision" (dv_get mind "revision"))
            "original_revision" (dv_get mind "revision")) "role" "internal-enumeration") "start_time" start))
          (set result (dv_with (dv_with result "calculation_unit" "one-assumption-predict-rule-context-binding-option-prediction-option-evaluation-response-dispatch-or-feature-comparison") "stop_reason" (if (rt_lt (dv_get result "remaining") 1) "budget-exhausted" "declared-plan-complete")))
          (set result (dv_with (dv_with result "work_remaining" (dv_get result "remaining")) "remaining" (rt_sub total_budget (dv_get result "expanded"))))
          (set result (dv_with (dv_with result "original_expanded" (dv_get result "expanded")) "total_expanded" (dv_get result "expanded")))
          (let (parents (dvs_cognitive_parents actor (dv_single parent)) paid (dv_find actor "model_paid_event" "") previous (dv_find actor "model_previous_event" ""))
            (do (if (dv_and (rt_not (rt_eq paid "")) (rt_not (dv_has parents paid))) (rt_push parents paid) false)
              (if (dv_and (rt_not (rt_eq previous "")) (rt_not (dv_has parents previous))) (rt_push parents previous) false)
              (dvs_event events "mind_simulation" (dv_get actor "id") time parents
                (dv_with (dv_m4 "mind_before" mind "predicted" predicted "hypothesis" hypothesis "result" result) "actor_before" actor)))) result)))))
; A fresh observation may refute an old paid prediction without replaying its hypothetical effects.
(defn dvs_model_recheck (actor model)
  (let (mind (dv_get actor "mind") comparison (dvs_sim_comparisons (dv_get actor "mind") (dv_get model "predictions")
          (dvs_sim_work_budget actor)) result (dv_clone model))
    (do (let (keys (dv_list3 "fit" "comparisons" "contradictions") i 0)
      (do (rt_push keys "remaining") (rt_push keys "expanded") (rt_push keys "probe_refs") (rt_push keys "status")
        (while (rt_lt i (rt_count keys)) (do (set result (dv_with result (rt_at keys i) (dv_get comparison (rt_at keys i)))) (set i (rt_add i 1))))))
      (if (dv_and (rt_not (dv_get model "plan_complete")) (rt_eq (dv_get result "status") "explained")) (set result (dv_with result "status" "unknown")) false)
      (set result (dv_with (dv_with result "work_remaining" (dv_get comparison "remaining")) "remaining" (rt_sub (dv_find (dv_get actor "policy") "model_budget" 0) (dv_get comparison "expanded"))))
      (set result (dv_with (dv_with result "total_expanded" (rt_add (dv_find model "total_expanded" (dv_get model "expanded")) (dv_get comparison "expanded"))) "stop_reason" (if (rt_lt (dv_get comparison "remaining") 1) "budget-exhausted" "observations-compared")))
      (dv_with (dv_with (dv_with result "source_revision" (dv_get mind "revision")) "paid_model_event" (dv_find model "paid_model_event" (dv_find model "event" ""))) "role" "new-observation-recheck"))))

(defn dvs_sim_response_unknown (world remaining reason)
  (dv_m4 "world" world "changes" (rt_list) "remaining" remaining "detail"
    (dv_m4 "status" "unknown" "reason" reason "expanded" 0 "committed" false)))
(defn dvs_sim_response (actor world stage time remaining confidence)
  (let (models (dv_find actor "response_models" (rt_list)) model_id (dv_get stage "model"))
    (if (rt_not (dv_has_key models model_id)) (dvs_sim_response_unknown world remaining "no-subject-local-response-model")
      (let (model (dv_with (dv_get models model_id) "confidence" (dv_min confidence (dv_find (dv_get models model_id) "confidence" 0))))
        (if (rt_not (dv_and (rt_eq (dv_find model "owner" "") (dv_get actor "id"))
          (dv_and (rt_lt 0 (rt_count (dv_find model "basis" (rt_list)))) (rt_lt 0 (dv_unit (dv_find model "confidence" 0))))))
          (dvs_sim_response_unknown world remaining "unavailable-response-model-basis")
          (let (local (dv_clone (dv_get model "world")) bindings (dv_find model "context" (rt_list))
                option_ids (dv_get stage "options") catalog (dv_get model "options") policy_id (dv_get model "policy_id")
                request_id (dv_get stage "request") requests (dv_get model "requests")
                required (rt_add (rt_count bindings) (rt_mul 2 (rt_count option_ids))))
            (do (dv_domain local "mind")
              (if (rt_lt remaining required) (dvs_sim_response_unknown world remaining "method-work-limit-before-response")
                (if (rt_not (dv_has_key requests request_id)) (dvs_sim_response_unknown world remaining "unknown-modeled-request")
                  (if (rt_not (dv_has_key (dv_find local "policies" (rt_list)) policy_id)) (dvs_sim_response_unknown world remaining "unknown-modeled-value-policy")
                    (let (accepted (dv_get (dv_get local "policies") policy_id))
                      (if (rt_not (dv_and (dv_get accepted "active") (rt_lt 0 (rt_count (dv_get accepted "basis")))))
                        (dvs_sim_response_unknown world remaining "unadopted-modeled-value-policy")
                        (let (request (dv_get requests request_id) options (rt_list) inputs (rt_list) option_traces (rt_list)
                              i 0 complete true expanded 0 chosen false prediction false response false next world changes (rt_list) reason "unknown-response-basis" response_confidence (dv_get model "confidence"))
                          (do (set local (dv_with (dv_with local "time" time) "seen" (rt_list)))
                            (while (rt_lt i (rt_count bindings))
                              (let (binding (rt_at bindings i) cell (dv_read world (dv_get (rt_at bindings i) "from")))
                                (do (set expanded (rt_add expanded 1)) (set remaining (rt_sub remaining 1))
                                  (rt_push inputs (dv_m3 "from" (dv_get binding "from") "to" (dv_get binding "to") "cell" cell))
                                  (if (dv_and (dv_uncontested cell) (rt_lt 0 (dv_get cell "confidence")))
                                    (set response_confidence (dv_min response_confidence (dv_get cell "confidence")))
                                    (do (set complete false) (set reason "unknown-required-response-context")))
                                  (if (dv_has_key (dv_get local "objects") (dv_get (dv_get binding "to") "object"))
                                    (set local (dv_store local (dv_get binding "to") (if (dv_uncontested cell)
                                      (dv_with cell "confidence" (dv_min (dv_get cell "confidence") (dv_get model "confidence"))) (dv_unknown))))
                                    (set complete false)) (set i (rt_add i 1)))))
                            (set i 0)
                            (while (rt_lt i (rt_count option_ids))
                              (let (option_id (rt_at option_ids i))
                                (do (set expanded (rt_add expanded 2)) (set remaining (rt_sub remaining 2))
                                  (if (dv_has_key catalog option_id)
                                    (let (descriptor (dv_get catalog option_id) name (dv_find (dv_get catalog option_id) "predict_law" "") result false legal (dv_truth local (dv_get (dv_get catalog option_id) "feasible")))
                                      (do (set prediction (dv_no_change_prediction local))
                                        (if (rt_eq legal "unknown") (set complete false) false)
                                        (if (rt_eq name "") false
                                          (if (dv_has_key (dv_get local "adoptions") name)
                                            (let (adoption (dv_get (dv_get local "adoptions") name))
                                              (if (dv_and (dv_get adoption "active") (rt_eq (dv_get adoption "mode") "predict"))
                                                (do (set result (dv_predict local name (rt_cat "response-option-" (rt_show i)) time (dv_get local "revision")))
                                                  (if (rt_eq (dv_get result "status") "applied") (set prediction (dv_get result "world"))
                                                    (if (rt_eq legal "false") false (set complete false))))
                                                (if (rt_eq legal "false") false (set complete false))))
                                            (if (rt_eq legal "false") false (set complete false))))
                                        (rt_push options (dv_response_option option_id (dv_get descriptor "intent") (dv_get descriptor "feasible") prediction (dv_get descriptor "effort") (dv_get descriptor "feature_weights")))
                                        (rt_push option_traces (dv_m4 "id" option_id "legal" legal "prediction_receipt" result "model_prediction" prediction))))
                                    (do (set complete false) (rt_push option_traces (dv_m2 "id" option_id "legal" "unknown-option"))))
                                  (set i (rt_add i 1)))))
                            (set response (dv_respond_adopted local request options policy_id))
                            (let (evaluated (dv_get response "evaluated") j 0 ties 0 best 0 found_best false)
                              (do (while (rt_lt j (rt_count evaluated))
                                (let (evaluation (rt_at (rt_at evaluated j) 1) score (dv_get (rt_at (rt_at evaluated j) 1) "score"))
                                  (do (if (dv_and (dv_get (dv_get evaluation "value") "complete")
                                    (rt_eq (rt_count (dv_get (dv_get evaluation "relationship_and_state") "unknown")) 0)) false (set complete false))
                                    (if (if found_best (rt_lt best score) true) (do (set best score) (set ties 1) (set found_best true)) (if (rt_eq best score) (set ties (rt_add ties 1)) false))
                                    (set j (rt_add j 1)))))
                                (if (rt_lt 1 ties) (do (if complete (set reason "modeled-response-tie") false) (set complete false)) false)))
                            (if (dv_and complete (rt_eq (dv_get response "status") "selected"))
                              (let (id (dv_get (dv_get response "choice") "id") choice_ref (dv_get model "choice_ref"))
                                (do (set chosen id) (set reason "selected-by-shared-response")
                                  (if (dv_has_key (dv_get next "objects") (dv_get choice_ref "object"))
                                    (let (before (dv_read next choice_ref) after (dv_cell id response_confidence time (dv_get model "basis")))
                                      (do (set next (dv_store next choice_ref after)) (rt_push changes (dv_m3 "ref" choice_ref "before" before "after" after))))
                                    (do (set complete false) (set reason "unknown-local-choice-record"))))) false)
                            (dv_m4 "world" next "changes" changes "remaining" remaining "detail"
                              (dv_with (dv_with (dv_with (dv_with (dv_with (dv_with (dv_with (dv_m4 "status" (if complete (dv_get response "status") "unknown") "reason" reason "expanded" expanded "committed" false)
                                "model" model_id) "model_basis" (dv_get model "basis")) "context_inputs" inputs) "option_predictions" option_traces)
                                "response" response) "selected" chosen) "bridge_law" (if (rt_eq chosen false) "" (dv_find (dv_get catalog chosen) "bridge_law" ""))))))))))))))))))
(defn dvs_sim_mask_response_option (world model option_id)
  (let (option (dv_find (dv_get model "options") option_id (rt_list)))
    (if (dv_has_key option "bridge_law")
      (let (name (dv_get option "bridge_law"))
        (if (dv_has_key (dv_get world "adoptions") name)
          (dv_get (dvs_sim_withhold world (dv_get (dv_get (dv_get (dv_get world "adoptions") name) "law") "effects")) "world") world)) world)))
(defn dvs_sim_mask_response_stage (actor world stage)
  (let (models (dv_find actor "response_models" (rt_list)) id (dv_get stage "model"))
    (if (dv_has_key models id)
      (let (model (dv_get models id) options (dv_get stage "options") i 0 copy world)
        (do (if (dv_has_key model "choice_ref")
          (if (dv_has_key (dv_get copy "objects") (dv_get (dv_get model "choice_ref") "object"))
            (set copy (dv_store copy (dv_get model "choice_ref") (dv_unknown))) false) false)
          (while (rt_lt i (rt_count options))
            (do (set copy (dvs_sim_mask_response_option copy model (rt_at options i))) (set i (rt_add i 1)))) copy)) world)))
(defn dvs_sim_mask_response (actor world plan)
  (let (copy world i 0)
    (do (while (rt_lt i (rt_count plan))
      (let (step (rt_at plan i))
        (do (if (dv_has_key step "response") (set copy (dvs_sim_mask_response_stage actor copy (dv_get step "response"))) false)
          (set i (rt_add i 1))))) copy)))
(defn dvs_sim_response_bridge (actor world detail time remaining confidence)
  (let (name (dv_get detail "bridge_law") adoptions (dv_get (dv_get actor "mind") "adoptions"))
    (if (dv_or (rt_eq name "") (rt_not (dv_has_key adoptions name)))
      (dv_with (dv_m4 "world" world "changes" (rt_list) "remaining" remaining "status" "unknown-response-bridge") "expanded" 0)
      (let (adoption (dv_get adoptions name) effects (dv_get (dv_get (dv_get adoptions name) "law") "effects"))
        (if (dv_or (rt_lt remaining 1) (rt_not (dv_and (dv_get adoption "active") (rt_eq (dv_get adoption "mode") "predict"))))
          (dv_with (dv_m4 "world" (dv_get (dvs_sim_withhold world effects) "world") "changes" (rt_list) "remaining" remaining "status" "unavailable-response-bridge") "expanded" 0)
          (let (local (dv_with (dv_with world "domain" "mind") "adoptions" (dv_with (dv_get world "adoptions") name
                  (dv_with adoption "confidence" (dv_min confidence (dv_min (dv_get adoption "confidence") (dv_premise_confidence world (dv_get (dv_get adoption "law") "premise")))))))
                result false)
            (do (set result (dv_predict local name (rt_cat "response-bridge-" (rt_show (dv_get world "revision"))) time (dv_get world "revision")))
              (dv_with (dv_with (dv_with result "world" (if (rt_eq (dv_get result "status") "applied") (dv_get result "world")
                (dv_get (dvs_sim_withhold world effects) "world"))) "remaining" (rt_sub remaining 1)) "expanded" 1))))))))
(defn dvs_sim_gated_response (actor world step time remaining confidence)
  (let (gate (dv_find step "available_when" (dv_true)) truth (dv_truth world (dv_find step "available_when" (dv_true))) result false)
    (do (set result (if (rt_eq truth "true") (dvs_sim_response actor world (dv_get step "response") time remaining confidence)
      (if (rt_eq truth "false")
        (dv_m4 "world" world "changes" (rt_list) "remaining" remaining "detail" (dv_m4 "status" "not-applicable" "reason" "request-gate-false" "expanded" 0 "committed" false))
        (dvs_sim_response_unknown (dvs_sim_mask_response_stage actor world (dv_get step "response")) remaining "request-gate-unknown"))))
      (dv_with result "detail" (dv_with (dv_with (dv_with (dv_get result "detail") "gate" gate) "gate_truth" truth) "gate_inputs" (dvs_sim_inputs world gate))))))

; Paid, evidence-relative symbolic exclusions. No domain is removed or hypothesis accepted.
(defn dvs_factor_proof_result (valid remaining confidence steps roots)
  (dv_with (dv_m4 "valid" valid "remaining" remaining "confidence" confidence "steps" steps) "source_events" roots))
(defn dvs_factor_merge (left right)
  (let (steps (dv_clone (dv_get left "steps")) roots (dv_clone (dv_get left "source_events")) i 0)
    (do (while (rt_lt i (rt_count (dv_get right "steps")))
      (do (rt_push steps (rt_at (dv_get right "steps") i)) (set i (rt_add i 1))))
      (set i 0) (while (rt_lt i (rt_count (dv_get right "source_events")))
        (do (if (dv_has roots (rt_at (dv_get right "source_events") i)) false (rt_push roots (rt_at (dv_get right "source_events") i))) (set i (rt_add i 1))))
      (dvs_factor_proof_result (dv_and (dv_get left "valid") (dv_get right "valid")) (dv_get right "remaining")
        (dv_min (dv_get left "confidence") (dv_get right "confidence")) steps roots))))
(defn dvs_factor_law_allowed (allowed law)
  (let (i 0 found false)
    (do (while (rt_lt i (rt_count allowed))
      (do (if (dv_and (rt_eq (dv_get (rt_at allowed i) "id") (dv_get law "name"))
        (rt_eq (dv_get (rt_at allowed i) "version") (dv_get law "version"))) (set found true) false) (set i (rt_add i 1)))) found)))
(defn dvs_factor_roots (actor mind ref events cutoff remaining allowed)
  (let (cell (dv_read mind ref) result (dvs_factor_proof_result false remaining 0 (rt_list) (rt_list)) i 0)
    (do (if (rt_not (rt_lt remaining 1))
      (do (set result (dvs_factor_proof_result false (rt_sub remaining 1) 0 (rt_list) (rt_list)))
        (if (dv_and (dv_uncontested cell) (dv_and (rt_lt 0 (dv_get cell "confidence"))
          (dv_and (rt_not (dv_find cell "estimated" false)) (rt_not (rt_eq (dv_find cell "source" "") "abduction")))))
          (while (dv_and (rt_lt i cutoff) (rt_not (dv_get result "valid")))
            (let (event (rt_at events i))
              (do (if (rt_eq (dv_get event "actor") (dv_get actor "id"))
                (let (kind (dv_get event "type") data (dv_get event "data"))
                  (do (if (dv_or (rt_eq kind "observation") (rt_eq kind "listener_parse"))
                    (if (dv_has_key data "mind_after")
                      (if (dv_same (dv_read (dv_get data "mind_after") ref) cell)
                        (let (observations (dv_find data "observations" (rt_list)) j 0 claims (dv_find cell "claims" (rt_list)) valid true confidence (dv_get cell "confidence") roots (rt_list) steps (rt_list))
                          (do (if (rt_eq (rt_count claims) 0) (set valid false) false)
                            (while (rt_lt j (rt_count claims))
                              (let (claim (rt_at claims j) source (dv_get (rt_at claims j) "source"))
                                (do (if (dv_and (dv_has observations claim)
                                  (dv_and (rt_eq (dv_get claim "subject") (dv_get actor "id"))
                                    (dv_and (dv_same (dv_get claim "ref") ref)
                                      (dv_and (dv_has (dv_get (dv_get data "mind_after") "seen") (dv_get claim "id"))
                                        (dv_or (rt_eq source "perception") (dv_or (rt_eq source "recall") (rt_eq source "testimony")))))))
                                  (set confidence (dv_min confidence (dv_get claim "trust"))) (set valid false))
                                  (set j (rt_add j 1)))))
                            (if (dv_and valid (rt_lt 0 confidence))
                              (do (rt_push roots (dv_get event "id"))
                                (rt_push steps (dv_with (dv_m4 "kind" "observation" "event" (dv_get event "id") "ref" ref "cell" cell) "observations" claims))
                                (set result (dvs_factor_proof_result true (dv_get result "remaining") confidence steps roots))) false))) false) false) false)
                    (if (rt_eq kind "inference")
                      (set result (dvs_factor_inference actor mind ref cell events i data event (dv_get result "remaining") allowed)) false))) false)
                (set i (rt_add i 1))))) false)) false) result)))
(defn dvs_factor_refs_proof (actor mind refs events cutoff remaining allowed)
  (let (result (dvs_factor_proof_result true remaining 1 (rt_list) (rt_list)) i 0)
    (do (while (dv_and (dv_get result "valid") (rt_lt i (rt_count refs)))
      (do (set result (dvs_factor_merge result (dvs_factor_roots actor mind (rt_at refs i) events cutoff (dv_get result "remaining") allowed)))
        (set i (rt_add i 1)))) result)))
(defn dvs_factor_inference (actor mind ref cell events index data event remaining allowed)
  (let (law (dv_get data "law") before (dv_get data "mind_before") receipt (dv_get data "receipt")
        current (dv_get (dv_get actor "mind") "adoptions") name (dv_get (dv_get data "law") "name")
        result (dvs_factor_proof_result false remaining 0 (rt_list) (rt_list)) changes (dv_find (dv_get data "receipt") "changes" (rt_list)) i 0 found false)
    (do (while (rt_lt i (rt_count changes))
      (do (if (dv_and (dv_same (dv_get (rt_at changes i) "ref") ref) (dv_same (dv_get (rt_at changes i) "after") cell)) (set found true) false)
        (set i (rt_add i 1))))
      (if (dv_and found (dv_and (rt_eq (dv_get receipt "status") "applied")
        (dv_and (dvs_factor_law_allowed allowed law) (dv_and (dv_has_key current name) (dv_has_key (dv_get before "adoptions") name)))))
        (let (adoption (dv_get current name))
          (if (dv_and (dv_same adoption (dv_get (dv_get before "adoptions") name))
            (dv_and (dv_get adoption "active") (dv_and (rt_eq (dv_get adoption "mode") "infer")
              (dv_and (dv_same law (dv_get adoption "law")) (rt_eq (dv_truth before (dv_get law "premise")) "true")))))
            (if (rt_lt remaining 1) result
              (let (replayed (dv_infer before name (dv_get receipt "event") (dv_get receipt "time") (dv_get before "revision")))
                (do (set result (dvs_factor_proof_result false (rt_sub remaining 1) 0 (rt_list) (rt_list)))
                  (if (dv_and (dv_same replayed receipt) (dv_same (dv_get data "mind_after") (dv_get receipt "world")))
                    (let (sources (dvs_factor_refs_proof actor before (dvs_sim_refs (dv_get law "premise")) events index (dv_get result "remaining") allowed))
                      (do (set result sources)
                        (if (dv_and (dv_get sources "valid") (rt_lt 0 (rt_count (dv_get sources "source_events"))))
                          (set result (dv_with (dv_with (dv_with sources "source_events" (dv_append (dv_get sources "source_events") (dv_get event "id"))) "confidence" (dv_min (dv_get cell "confidence") (dv_min (dv_get adoption "confidence") (dv_get sources "confidence"))))
                            "steps" (dv_append (dv_get sources "steps") (dv_with (dv_m4 "kind" "infer" "event" (dv_get event "id") "ref" ref "cell" cell)
                              "adoption" adoption)))) (set result (dv_with sources "valid" false))))) false)))) result)) false) result)))
(defn dvs_factor_domain (domains id)
  (let (i 0 result false)
    (do (while (rt_lt i (rt_count domains))
      (do (if (rt_eq (dv_get (rt_at domains i) "id") id) (set result (rt_at domains i)) false) (set i (rt_add i 1)))) result)))
(defn dvs_factor_schema (domains constraint)
  (let (assignments (dv_get constraint "assignments") scope (dv_get constraint "scope") versions (dv_get constraint "domain_versions")
        ids (rt_list) facts (rt_list) free (rt_list) valid true i 0 allids (rt_list) refs (rt_list))
    (do (if (dv_or (rt_eq (rt_count assignments) 0) (rt_eq (rt_count (dv_find constraint "basis" (rt_list))) 0)) (set valid false) false)
      (while (rt_lt i (rt_count domains))
        (let (domain (rt_at domains i) values (dv_get (rt_at domains i) "values") j 0 seen (rt_list))
          (do (if (dv_or (dv_has allids (dv_get domain "id")) (dv_has refs (dv_get domain "ref"))) (set valid false) false)
            (rt_push allids (dv_get domain "id")) (rt_push refs (dv_get domain "ref"))
            (if (dv_or (rt_eq (rt_count values) 0) (rt_not (rt_lt 0 (dv_get domain "version")))) (set valid false) false)
            (while (rt_lt j (rt_count values))
              (do (if (dv_has seen (rt_at values j)) (set valid false) false) (rt_push seen (rt_at values j)) (set j (rt_add j 1))))
            (set i (rt_add i 1)))))
      (set i 0) (while (rt_lt i (rt_count assignments))
        (let (assignment (rt_at assignments i) id (dv_get (rt_at assignments i) "variable") domain (dvs_factor_domain domains (dv_get (rt_at assignments i) "variable")))
          (do (if (dv_has ids id) (set valid false) false) (rt_push ids id)
            (if (rt_eq domain false) (set valid false)
              (do (if (dv_and (dv_has (dv_get domain "values") (dv_get assignment "value"))
                (rt_eq (dv_find versions id -1) (dv_get domain "version"))) false (set valid false))
                (rt_push facts (dv_fact (dv_get domain "ref") (dv_get assignment "value"))))) (set i (rt_add i 1)))))
      (if (rt_eq (rt_count scope) (rt_count ids)) false (set valid false))
      (set i 0) (while (rt_lt i (rt_count ids))
        (do (if (dv_has scope (rt_at ids i)) false (set valid false)) (set i (rt_add i 1))))
      (set i 0) (while (rt_lt i (rt_count scope))
        (do (if (dv_has ids (rt_at scope i)) false (set valid false)) (set i (rt_add i 1))))
      (if (rt_eq (rt_count facts) 1)
        (if (dv_same (dv_get constraint "condition") (rt_at facts 0)) false (set valid false))
        (if (dv_same (dv_get constraint "condition") (dv_all facts)) false (set valid false)))
      (set i 0) (while (rt_lt i (rt_count domains))
        (do (if (dv_has ids (dv_get (rt_at domains i) "id")) false (rt_push free (rt_at domains i))) (set i (rt_add i 1))))
      (dv_m3 "valid" valid "fixed" assignments "free_domains" free))))
(defn dvs_factor_scope_proof (domains fixed proof)
  (let (steps (dv_get proof "steps") i 0 valid true)
    (do (while (rt_lt i (rt_count steps))
      (let (step (rt_at steps i) j 0)
        (do (while (rt_lt j (rt_count domains))
          (let (domain (rt_at domains j) k 0 included false)
            (do (if (dv_same (dv_get step "ref") (dv_get domain "ref"))
              (do (while (rt_lt k (rt_count fixed))
                (do (if (rt_eq (dv_get (rt_at fixed k) "variable") (dv_get domain "id")) (set included true) false) (set k (rt_add k 1))))
                (if included false (set valid false))) false) (set j (rt_add j 1))))) (set i (rt_add i 1))))) valid)))
(defn dvs_factor_covers (certificate assignments)
  (let (fixed (dv_get (dv_get certificate "covered_assignments") "fixed") i 0 valid true)
    (do (while (rt_lt i (rt_count fixed))
      (do (if (dv_has assignments (rt_at fixed i)) false (set valid false)) (set i (rt_add i 1)))) valid)))
(defn dvs_factor_paid (actor events)
  (let (id (dv_find actor "model_paid_event" "") i 0 valid false)
    (do (while (rt_lt i (rt_count events))
      (let (event (rt_at events i))
        (do (if (dv_and (rt_eq (dv_get event "id") id) (dv_and (rt_eq (dv_get event "actor") (dv_get actor "id")) (rt_eq (dv_get event "type") "action_execution")))
          (let (data (dv_get event "data"))
            (if (dv_and (rt_eq (dv_get (dv_get data "action") "kind") "replay")
              (dv_and (rt_eq (dv_get (dv_get (dv_get data "receipt") "execution") "status") "applied")
                (rt_eq (dv_get (dv_get (dv_get (dv_get (dv_get data "receipt") "ledger") "receipts") (dv_get (dv_get (dv_get data "receipt") "receipt") "event")) "state") "settled"))) (set valid true) false)) false)
          (set i (rt_add i 1))))) valid)))
(defn dvs_factor_prune (actor events time parent)
  (let (policy (dv_get actor "policy") mind (dv_get actor "mind") domains (dv_find (dv_get actor "policy") "factor_domains" (rt_list))
        constraints (dv_find (dv_get actor "policy") "factor_constraints" (rt_list)) cap (dv_find (dv_get actor "policy") "prune_confidence_limit" 0)
        remaining (dvs_sim_work_budget actor) initial (dvs_sim_work_budget actor) certificates (rt_list) rejections (rt_list) i 0 result false paid (dvs_factor_paid actor events))
    (do (while (rt_lt i (rt_count constraints))
      (let (constraint (rt_at constraints i) reason "budget-exhausted" start remaining)
        (do (if (dv_and paid (dv_and (rt_lt 0 cap) (rt_lt cap 1)))
          (if (rt_lt remaining 1) false
            (let (schema (dvs_factor_schema domains constraint))
              (do (set remaining (rt_sub remaining 1)) (set reason "invalid-domain-or-coupled-condition")
                (if (dv_get schema "valid")
                  (let (condition (dv_truth mind (dv_get constraint "condition")) support (dv_truth mind (dv_get constraint "support")))
                    (do (set reason "unknown-or-not-contradicted")
                      (if (dv_and (rt_eq condition "false") (rt_eq support "true"))
                        (let (refs (dvs_sim_refs (dv_all (dv_pair (dv_get constraint "condition") (dv_get constraint "support"))))
                              proof (dvs_factor_refs_proof actor mind (dvs_sim_refs (dv_all (dv_pair (dv_get constraint "condition") (dv_get constraint "support")))) events (rt_count events) remaining (dv_get constraint "infer_laws")))
                          (do (set remaining (dv_get proof "remaining")) (set reason "unproven-or-inadmissible-source")
                            (if (dv_and (dv_get proof "valid") (dv_and (rt_lt 0 (rt_count (dv_get proof "source_events"))) (dvs_factor_scope_proof domains (dv_get schema "fixed") proof)))
                              (let (certificate (dv_with (dv_with (dv_with (dv_with (dv_with (dv_with (dv_with (dv_m4 "constraint" constraint "domains" domains "current_revision" (dv_get mind "revision") "source_chain" (dv_get proof "steps"))
                                  "source_event_ids" (dv_get proof "source_events")) "covered_assignments" (dv_m2 "fixed" (dv_get schema "fixed") "free_domains" (dv_get schema "free_domains")))
                                  "confidence" (dv_min cap (dv_get proof "confidence"))) "estimated" true) "paid_model_event" (dv_find actor "model_paid_event" ""))
                                  "paid_units" (rt_sub start remaining)) "results" (dv_m2 "condition" condition "support" support)))
                                (do (rt_push certificates certificate) (set reason "certified"))) false))) false))) false))))
          (set reason "unpaid-or-missing-confidence-policy"))
          (if (rt_eq reason "certified") false (rt_push rejections (dv_m3 "constraint" (dv_get constraint "id") "reason" reason "paid_units" (rt_sub start remaining))))
          (set i (rt_add i 1)))))
      (set result (dv_with (dv_with (dv_with (dv_m4 "certificates" certificates "rejections" rejections "expanded" (rt_sub initial remaining) "remaining" (rt_sub (dv_find policy "model_budget" 0) (rt_sub initial remaining)))
        "work_remaining" remaining) "current_revision" (dv_get mind "revision")) "actor_before" actor))
      (let (parents (dvs_cognitive_parents actor (dv_single parent)) j 0)
        (do (if (rt_eq (dv_find actor "model_paid_event" "") "") false (if (dv_has parents (dv_get actor "model_paid_event")) false (rt_push parents (dv_get actor "model_paid_event"))))
          (if (rt_eq (dv_find actor "model_previous_event" "") "") false (if (dv_has parents (dv_get actor "model_previous_event")) false (rt_push parents (dv_get actor "model_previous_event"))))
          (while (rt_lt j (rt_count certificates))
            (let (roots (dv_get (rt_at certificates j) "source_event_ids") k 0)
              (do (while (rt_lt k (rt_count roots)) (do (if (dv_has parents (rt_at roots k)) false (rt_push parents (rt_at roots k))) (set k (rt_add k 1)))) (set j (rt_add j 1)))))
          (dv_with result "event" (dvs_event events "factor_prune" (dv_get actor "id") time parents result)))))))

; Pure validation replays an existing paid certificate; it does not issue an exclusion.
(defn dvs_factor_certificate_parents (certificate parents)
  (let (ids (dv_get certificate "source_event_ids") i 0 valid true)
    (do (while (rt_lt i (rt_count ids))
      (do (if (dv_has parents (rt_at ids i)) false (set valid false)) (set i (rt_add i 1)))) valid)))
(defn dvs_factor_certificate_bound (actor certificate events)
  (let (i 0 valid false bare (dv_without certificate "event"))
    (do (while (rt_lt i (rt_count events))
      (let (event (rt_at events i))
        (do (if (dv_and (rt_eq (dv_get event "id") (dv_find certificate "event" ""))
          (dv_and (rt_eq (dv_get event "actor") (dv_get actor "id")) (rt_eq (dv_get event "type") "factor_prune")))
          (let (data (dv_get event "data"))
            (if (dv_and (dv_has (dv_get data "certificates") bare)
              (dv_and (rt_eq (dv_get (dv_get data "actor_before") "id") (dv_get actor "id"))
                (dv_and (rt_eq (dv_get (dv_get (dv_get data "actor_before") "mind") "revision") (dv_get certificate "current_revision"))
                  (dv_and (rt_eq (dv_find (dv_get data "actor_before") "model_paid_event" "") (dv_get certificate "paid_model_event"))
                    (dv_and (dv_has (dv_get event "parents") (dv_get certificate "paid_model_event")) (dvs_factor_certificate_parents certificate (dv_get event "parents"))))))) (set valid true) false)) false)
          (set i (rt_add i 1))))) valid)))
(defn dvs_factor_certificate_current (actor certificate events)
  (let (mind (dv_get actor "mind") policy (dv_get actor "policy") required (dv_list3 "constraint" "domains" "source_chain") i 0 valid true)
    (do (set required (dv_append required "source_event_ids")) (set required (dv_append required "current_revision"))
      (set required (dv_append required "covered_assignments")) (set required (dv_append required "confidence"))
      (set required (dv_append required "estimated")) (set required (dv_append required "paid_model_event"))
      (set required (dv_append required "paid_units")) (set required (dv_append required "results")) (set required (dv_append required "event"))
      (while (rt_lt i (rt_count required)) (do (if (dv_has_key certificate (rt_at required i)) false (set valid false)) (set i (rt_add i 1))))
      (if valid
        (let (domains (dv_find policy "factor_domains" (rt_list)) constraint (dv_get certificate "constraint") cap (dv_find policy "prune_confidence_limit" 0) units (dv_get certificate "paid_units"))
          (if (dv_and (rt_eq (dv_get mind "revision") (dv_get certificate "current_revision"))
            (dv_and (dv_get certificate "estimated") (dv_and (dv_same domains (dv_get certificate "domains"))
              (dv_and (dv_has (dv_find policy "factor_constraints" (rt_list)) constraint)
                (dv_and (rt_lt 0 cap) (dv_and (rt_lt cap 1) (dv_and (rt_lt 0 units)
                  (dv_and (dvs_factor_certificate_bound actor certificate events)
                    (dvs_factor_paid (dv_with actor "model_paid_event" (dv_get certificate "paid_model_event")) events)))))))))
            (let (schema (dvs_factor_schema domains constraint))
              (if (dv_and (dv_get schema "valid") (dv_and (rt_eq (dv_truth mind (dv_get constraint "condition")) "false") (rt_eq (dv_truth mind (dv_get constraint "support")) "true")))
                (let (proof (dvs_factor_refs_proof actor mind (dvs_sim_refs (dv_all (dv_pair (dv_get constraint "condition") (dv_get constraint "support")))) events (rt_count events) (rt_sub units 1) (dv_get constraint "infer_laws")))
                  (dv_and (dv_get proof "valid") (dv_and (rt_eq (dv_get proof "remaining") 0)
                    (dv_and (rt_lt 0 (rt_count (dv_get proof "source_events")))
                      (dv_and (dvs_factor_scope_proof domains (dv_get schema "fixed") proof)
                        (dv_and (dv_same (dv_get proof "steps") (dv_get certificate "source_chain"))
                          (dv_and (dv_same (dv_get proof "source_events") (dv_get certificate "source_event_ids"))
                            (dv_and (dv_same (dv_get certificate "results") (dv_m2 "condition" "false" "support" "true"))
                              (dv_and (dv_same (dv_get certificate "covered_assignments") (dv_m2 "fixed" (dv_get schema "fixed") "free_domains" (dv_get schema "free_domains")))
                                (rt_eq (dv_get certificate "confidence") (dv_min cap (dv_get proof "confidence")))))))))))) false)) false)) false))))
(defn dvs_factor_assignment_complete (domains assignments)
  (let (i 0 valid (dv_and (rt_lt 0 (rt_count domains)) (rt_eq (rt_count domains) (rt_count assignments))) ids (rt_list))
    (do (while (rt_lt i (rt_count assignments))
      (let (item (rt_at assignments i) id (dv_get (rt_at assignments i) "variable") domain (dvs_factor_domain domains (dv_get (rt_at assignments i) "variable")))
        (do (if (dv_has ids id) (set valid false) false) (rt_push ids id)
          (if (rt_eq domain false) (set valid false) (if (dv_has (dv_get domain "values") (dv_get item "value")) false (set valid false))) (set i (rt_add i 1))))) valid)))
(defn dvs_factor_assignment_key (domains assignments)
  (let (i 0 key (rt_list))
    (do (while (rt_lt i (rt_count domains))
      (let (domain (rt_at domains i) j 0)
        (do (while (rt_lt j (rt_count assignments))
          (do (if (rt_eq (dv_get domain "id") (dv_get (rt_at assignments j) "variable")) (rt_push key (dv_m2 "variable" (dv_get (rt_at assignments j) "variable") "value" (dv_get (rt_at assignments j) "value"))) false) (set j (rt_add j 1)))) (set i (rt_add i 1))))) key)))
(defn dvs_factor_catalog_complete (domains hypotheses)
  (let (product 1 i 0 ids (rt_list) refs (rt_list) keys (rt_list) valid (rt_lt 0 (rt_count domains)))
    (do (while (rt_lt i (rt_count domains))
      (let (domain (rt_at domains i) values (dv_get (rt_at domains i) "values") j 0 seen (rt_list))
        (do (if (dv_or (dv_has ids (dv_get domain "id")) (dv_has refs (dv_get domain "ref"))) (set valid false) false)
          (rt_push ids (dv_get domain "id")) (rt_push refs (dv_get domain "ref"))
          (if (dv_or (rt_eq (rt_count values) 0) (rt_not (rt_lt 0 (dv_get domain "version")))) (set valid false) false)
          (while (rt_lt j (rt_count values)) (do (if (dv_has seen (rt_at values j)) (set valid false) false) (rt_push seen (rt_at values j)) (set j (rt_add j 1))))
          (set product (rt_mul product (rt_count values))) (set i (rt_add i 1)))))
      (if (rt_eq product (rt_count hypotheses)) false (set valid false))
      (set i 0) (while (rt_lt i (rt_count hypotheses))
        (let (assignments (dv_find (rt_at hypotheses i) "variable_assignments" (rt_list)) key (dvs_factor_assignment_key domains (dv_find (rt_at hypotheses i) "variable_assignments" (rt_list))))
          (do (if (dvs_factor_assignment_complete domains assignments) false (set valid false))
            (if (dv_has keys key) (set valid false) false) (rt_push keys key) (set i (rt_add i 1))))) valid)))

(defn dvs_authority_speech_allowed (action physical subject)
  (let (contracts (dv_find physical "speech_contracts" (rt_list)) i 0 registered false allowed true)
    (do (while (rt_lt i (rt_count contracts))
      (let (contract (rt_at contracts i))
        (do (if (rt_eq (dv_get contract "subject") subject)
          (do (set registered true)
            (let (adoption (dv_find (dv_get physical "adoptions") (dv_get contract "law_id") false))
              (if (rt_eq adoption false) (set allowed false)
                (if (dv_and (dv_get adoption "active")
                  (dv_and (rt_eq (dv_get adoption "mode") "enforce")
                    (dv_and (rt_eq (dv_get (dv_get adoption "law") "version") (dv_get contract "version"))
                      (dv_and (dv_get contract "require_literal_truth") (rt_lt 0 (rt_count (dv_get contract "basis"))))))) false (set allowed false))))
            (if (dv_has_key action "authority_truth_gate")
              (let (gate (dv_get action "authority_truth_gate"))
                (if (dv_and (dv_find gate "required" false) (rt_eq (dv_find gate "contract_id" "") (dv_get contract "id"))) false (set allowed false))) false)
            (if (dv_has_key action "speech")
              (if (rt_eq (dv_truth physical (dv_get (dv_get action "speech") "literal_ast")) "true") false (set allowed false))
              (set allowed false))) false) (set i (rt_add i 1)))))
      (if (dv_and (rt_not registered) (dv_has_key action "authority_truth_gate"))
        (if (dv_find (dv_get action "authority_truth_gate") "required" false) (set allowed false) false) false) allowed)))
; Autonomous formal model session. Host geometry and input are outside this model.
(defn dvs_acceptance_law_ready (physical name)
  (if (dv_has_key (dv_get physical "adoptions") name)
    (let (adoption (dv_get (dv_get physical "adoptions") name) law (dv_get (dv_get (dv_get physical "adoptions") name) "law"))
      (if (dv_and (dv_get adoption "active") (dv_and (rt_eq (dv_get adoption "mode") "enforce")
        (rt_eq (dv_truth physical (dv_get law "premise")) "true")))
        (rt_eq (dv_get (dv_stage physical (dv_get law "effects") (dv_find physical "time" 0) (dv_get adoption "basis") (dv_get adoption "confidence")) "status") "ready") false)) false))
(defn dvs_answer (rules action physical mind bindings events)
  (let (i 0 found false literal "unknown" support "unknown" topic "unknown" complete "unknown" transition "" grants (rt_list) recipients (rt_list))
    (do (while (rt_lt i (rt_count rules))
      (let (rule (rt_at rules i))
        (do (if (rt_eq (dv_get rule "id") (dv_find action "answer_id" ""))
          (do (set found true) (set literal (dv_truth physical (if (dv_find rule "condition_from_answer" false)
              (dvs_physical_proposition (dv_get action "answer") bindings (dv_get mind "subject")) (dv_get rule "condition"))))
            (set support (dv_truth mind (dv_get rule "required_support"))) (set transition (dv_find rule "accepted_law" ""))
            (set topic (dv_truth physical (dv_find rule "question_match" (dv_m2 "op" "constant" "value" "unknown"))))
            (set complete (dv_truth mind (dv_find rule "answer_complete" (dv_m2 "op" "constant" "value" "unknown"))))
            (if (dv_find rule "require_argument" false) (if (dvs_public_argument_valid action rule events (dv_get mind "subject")) false (set complete "unknown")) false)
            (set grants (dv_find rule "accepted_public_grants" (rt_list))) (set recipients (dv_find rule "accepted_listeners" (rt_list)))) false) (set i (rt_add i 1)))))
      (let (law_ready (dvs_acceptance_law_ready physical transition) accepted false reason "accepted")
        (do (set reason (if (rt_not found) "undeclared-answer"
          (if (rt_not (rt_eq topic "true")) "unasked-topic"
            (if (rt_not (rt_eq literal "true")) "literal-not-established"
              (if (rt_not (rt_eq support "true")) "insufficient-source"
                (if (rt_not (rt_eq complete "true")) "incomplete-answer"
                  (if (rt_not law_ready) "protocol-transition-not-ready" "accepted")))))))
          (set accepted (rt_eq reason "accepted"))
          (dv_with (dv_with (dv_with (dv_with (dv_with (dv_with (dv_m4 "accepted" accepted "literal_truth" literal "epistemic_support" support "accepted_law" transition)
            "accepted_public_grants" grants) "accepted_listeners" recipients) "question_match" topic) "answer_complete" complete) "law_ready" law_ready) "reason" reason))))))
(defn dvs_run (story capability)
  (do (dv_require (rt_eq (dv_get story "format") "dv-session-v1") "Unsupported story data dialect")
    (let (physical (dv_clone (dv_get story "physical")) actors (dv_clone (dv_get story "actors"))
          events (rt_list) bindings (dv_get story "bindings") costs (dv_get story "cost_model")
          run_start (dv_find (dv_get story "physical") "time" 0) duration_budget (dv_find story "game_duration_budget" 0) horizon 0 duration_blocked false
          limit (dv_get story "max_actions") cursor 0 executed 0 idle 0 status "action-window-exhausted" initial (rt_list))
      (do (set horizon (rt_add run_start duration_budget)) (dv_require (rt_not (rt_lt duration_budget 0)) "Negative game duration budget")
        (set initial (dv_m2 "physical" physical "actors" actors))
        (let (i 0) (do (while (rt_lt i (rt_count actors))
          (let (actor (rt_at actors i))
              (do (if (dv_and (rt_eq capability "disabled") (rt_eq (dv_get actor "id") (dv_find story "capability_actor" "")))
              (set actor (dv_with actor "policy" (dv_with (dv_get actor "policy") "model_budget" 0))) false)
              (set actors (dvs_replace actors i (dv_with actor "ledger" (dv_action_cost_ledger (dv_get actor "id") (dv_get actor "balance")))))
              (set i (rt_add i 1)))))))
        (set initial (dv_m2 "physical" physical "actors" actors))
        (dvs_event events "session_start" "" (dv_find physical "time" 0) (rt_list) (dv_with (dv_m3 "initial" initial "capability" capability "source_refs" (dv_find story "source_refs" (rt_list))) "time_origin" (dv_m4 "run_start" run_start "duration_budget" duration_budget "horizon" horizon "unit" "minute")))
        (while (dv_and (rt_not (rt_lt horizon (dv_find physical "time" 0))) (dv_and (rt_lt executed limit) (rt_lt idle (rt_count actors))))
          (let (index cursor actor (rt_at actors cursor) parent (dv_get (rt_at events (rt_sub (rt_count events) 1)) "id") time (dv_find physical "time" 0))
            (do (set cursor (if (rt_lt (rt_add cursor 1) (rt_count actors)) (rt_add cursor 1) 0))
              (if (rt_not (rt_lt 0 (dv_find (dv_get actor "policy") "budget" 0))) (set idle (rt_add idle 1))
                (do (set actor (dv_with actor "policy" (dv_with (dv_get actor "policy") "remaining_game_time" (rt_sub horizon time))))
                  (set actor (dvs_ready (dvs_hypotheses (dvs_pragmatics_reconsider (dvs_reason actor events time parent) events time parent) events time parent) events time parent))
                  (set actor (dvs_capture_public_topics actor events time parent))
                  (set actor (dvs_materialize_arguments (dvs_arguments actor events time parent)))
                  (set actor (dvs_prepare_speech_choices actor events time parent))
                  (let (choice (dvs_choose actor bindings costs) action (dv_get choice "action"))
                    (do (set actor (dv_with actor "dependency_cache" (dv_get choice "dependency_cache")))
                      (set actor (dv_with actor "policy" (dv_with (dv_get actor "policy") "plan_budget"
                      (rt_sub (dv_find (dv_get actor "policy") "plan_budget" 0) (dv_get choice "plan_expansions")))))
                    (if (rt_eq action false)
                      (do (if (rt_lt 0 (dv_find choice "time_blocked" 0)) (set duration_blocked true) false)
                        (set idle (rt_add idle 1)) (set actors (dvs_replace actors index actor))
                        (dvs_event events "planning_stop" (dv_get actor "id") time (dv_single parent) (dv_without choice "dependency_cache")))
                      (let (id (dv_get actor "id") mind (dv_get actor "mind") model (dv_get costs (dv_get action "kind"))
                            action_event (rt_cat "action" (rt_show executed)) ledger (dv_get actor "ledger"))
                        (do
                          (set parent (dvs_event events "action_selected" id time (dvs_selection_parents actor action choice events parent)
                            (dv_with (dv_with (dv_m4 "action" action "mind_before" mind "score" (dv_get choice "score") "hypothesis" (dv_find actor "hypothesis" false)) "plan_expansions" (dv_get choice "plan_expansions")) "plans" (dv_get choice "plans"))))
                          (set parent (dvs_event events "planning_choice" id time (dv_single parent) (dv_without choice "dependency_cache")))
                          (let (bounds (dv_action_cost_bounds (dv_get model "minimum") (dv_get model "maximum")))
                            (if (dv_or (rt_lt horizon (rt_add time (dv_get (dv_get bounds "maximum") "time")))
                              (rt_lt horizon (rt_add time (dv_get (dv_get model "actual") "time"))))
                              (do (set duration_blocked true) (set idle (rt_add idle 1))
                                (dvs_event events "duration_budget_rejected" id time (dv_single parent)
                                  (dv_m4 "action" action "bounds" bounds "actual" (dv_get model "actual") "time_origin" (dv_m4 "run_start" run_start "duration_budget" duration_budget "horizon" horizon "unit" "minute"))))
                            (if (rt_not (dv_action_cost_le (dv_get bounds "maximum") (dv_get ledger "balances")))
                              (do (dvs_event events "resource_rejected" id time (dv_single parent) (dv_m2 "action" action "ledger" ledger)) (set idle (rt_add idle 1)))
                              (let (quote (dv_action_cost_quote ledger physical (dv_find action "law" (dv_get action "id")) action_event bounds)
                                    before physical result false)
                                (do
                                  (set parent (dvs_event events "cost_quote" id time (dv_single parent) quote))
                                  (set result (if (rt_not (dv_and (rt_eq (dv_truth physical (dv_find action "authority_precondition" (dv_get action "precondition"))) "true")
                                    (if (dv_has_key action "speech") (dvs_authority_speech_allowed action physical id) true)))
                                    (dv_action_cost_finish ledger physical quote (dv_get model "actual") "rejected")
                                    (if (rt_eq (dv_find action "law" "") "")
                                    (dv_action_cost_finish ledger physical quote (dv_get model "actual") "applied")
                                    (dv_action_cost_execute ledger physical quote (dv_get model "actual")))))
                                  (set physical (dv_get (dv_get result "execution") "world"))
                                  (set time (dv_find physical "time" time))
                                  (set actor (dv_with actor "ledger" (dv_get result "ledger")))
                                  (set parent (dvs_event events "action_execution" id time (dv_single parent)
                                    (dv_with (dv_with (dv_with (dv_with (dv_m4 "physical_before" before "physical_after" physical "receipt" result "action" action)
                                      "ledger_before" ledger) "ledger_after" (dv_get result "ledger")) "quote" quote) "actual" (dv_get model "actual"))))
                                  (rt_print (rt_json_stringify (dv_with (dv_m4 "event_id" parent "actor" id "action_id" (dv_get action "id") "game_time" time)
                                    "status" (dv_get (dv_get result "execution") "status"))))
                                  (let (observations (if (rt_eq (dv_get (dv_get result "execution") "status") "applied")
                                    (dvs_observation_source (dv_perceive physical mind bindings (dv_find action "grants" (rt_list)) action_event time) action) (rt_list))
                                        profile (dvs_observation_profile actor))
                                    (do (set actor (dv_with actor "mind" (dv_get (dv_update_mind mind observations (dv_get mind "revision") profile) "world")))
                                      (if (rt_lt 0 (rt_count observations))
                                        (set parent (dvs_event events "observation" id time (dvs_cognitive_parents actor (dv_single parent))
                                          (dv_with (dv_with (dv_with (dv_m4 "observations" observations "mind_before" mind "mind_after" (dv_get actor "mind") "action" action)
                                            "bindings" bindings) "grants" (dv_find action "grants" (rt_list))) "execution_id" action_event))) false)
                                      (if (rt_lt 0 (rt_count observations)) (set actor (dv_with actor "last_cognitive_event" parent)) false)))
                                  (if (dv_and (dv_has_key action "answer") (rt_eq (dv_get (dv_get result "execution") "status") "applied"))
                                    (let (judgment (dvs_answer (dv_find story "formal_answers" (rt_list)) action physical (dv_get actor "mind") bindings events))
                                      (do (set parent (dvs_event events "answer_submitted" id time (dv_single parent)
                                        (dv_m3 "action" action "mind" (dv_get actor "mind") "physical" physical)))
                                        (set parent (dvs_event events (if (dv_get judgment "accepted") "answer_accepted" "answer_rejected") id time (dv_single parent) judgment))
                                        (if (dv_and (dv_get judgment "accepted") (rt_not (rt_eq (dv_get judgment "accepted_law") "")))
                                          (let (transition (dv_execute physical (dv_get judgment "accepted_law") (rt_cat action_event "-accepted") time (dv_get physical "revision")))
                                            (if (rt_eq (dv_get transition "status") "applied")
                                              (do (set physical (dv_get transition "world"))
                                                (set parent (dvs_event events "question_transition" id time (dv_single parent) transition))
                                                (set actors (dvs_replace actors index actor))
                                                (set actors (dvs_public_grants actors index
                                                  (dv_with (dv_with (dv_with action "speech" (dv_m2 "channel" "formal-receipt" "literal_ast" (dv_true)))
                                                    "listeners" (dv_get judgment "accepted_listeners")) "public_grants" (dv_get judgment "accepted_public_grants"))
                                                  physical bindings events time parent (rt_cat action_event "-accepted")))
                                                (set actor (rt_at actors index))) false)) false))) false)
                                  (if (dv_and (rt_eq (dv_get action "kind") "replay") (rt_eq (dv_get (dv_get result "execution") "status") "applied"))
                                    (let (candidates (dv_find (dv_get actor "policy") "hypotheses" (rt_list)) k 0 simulations (dv_find actor "simulations" (rt_list)) coverages (rt_list) factor_rejections (rt_list))
                                      (do (set actor (dv_with_many actor (dv_m2 "model_paid_event" parent "policy" (dv_with (dv_get actor "policy") "model_work_remaining" (dv_find model "work_limit" 0)))))
                                        (if (rt_lt 0 (rt_count (dv_find (dv_get actor "policy") "factor_constraints" (rt_list))))
                                          (let (prune (dvs_factor_prune actor events time parent) certificates (rt_list) c 0)
                                            (do (while (rt_lt c (rt_count (dv_get prune "certificates")))
                                              (do (rt_push certificates (dv_with (rt_at (dv_get prune "certificates") c) "event" (dv_get prune "event"))) (set c (rt_add c 1))))
                                              (set actor (dv_with_many actor (dv_m4 "factor_certificates" certificates "model_previous_event" (dv_get prune "event") "last_cognitive_event" (dv_get prune "event")
                                                "policy" (dv_with_many (dv_get actor "policy") (dv_m2 "model_budget" (dv_get prune "remaining") "model_work_remaining" (dv_get prune "work_remaining")))))))) false)
                                        (while (rt_lt k (rt_count candidates))
                                        (let (candidate (rt_at candidates k) coverage_key (rt_cat (dv_find (rt_at candidates k) "question" (dv_find (rt_at candidates k) "topic" "")) (dv_find (rt_at candidates k) "group" "")))
                                          (do (if (dv_has_key coverages coverage_key) false (set coverages (dv_with coverages coverage_key (dvs_factor_coverage actor candidate events))))
                                            (if (dv_and (dvp_topic actor candidate) (dv_and (rt_lt 0 (rt_count (dv_find candidate "basis" (rt_list))))
                                            (rt_eq (dv_truth (dv_get actor "mind") (dv_find candidate "available_when" (dv_true))) "true")))
                                            (if (dvs_factor_covered candidate (dv_get (dv_get coverages coverage_key) "certificates")) (rt_push factor_rejections (dv_get candidate "id"))
                                            (let (cached (dv_find simulations (dv_get candidate "id") false) simulation false)
                                              (do (set simulation (if (rt_eq cached false) (dvs_model actor candidate events time parent)
                                                (let (recheck (dvs_model_recheck actor cached)) (do (dvs_event events "model_recheck" id time (dvs_model_parent_ids actor parent (dv_find cached "event" "")) (dv_m4 "actor_before" actor "model_before" cached "hypothesis" candidate "result" recheck)) recheck))))
                                              (do (set simulation (dv_with_many simulation (dv_m3 "validation_inputs" (dv_explanation_merge (dv_explanation_model_inputs (dv_get actor "mind") simulation)
                                                (dvs_model_observed_inputs simulation)) "source_adoptions" (dv_get (dv_get actor "mind") "adoptions") "source_response_models" (dv_find actor "response_models" (rt_list)))))
                                                (set simulations (dv_with simulations (dv_get candidate "id")
                                                (dv_with_many simulation (dv_m2 "event" (dv_get (rt_at events (rt_sub (rt_count events) 1)) "id") "source_revision" (dv_get (dv_get actor "mind") "revision")))))
                                            (set actor (dv_with_many actor (dv_m3 "model_previous_event" (dv_get (rt_at events (rt_sub (rt_count events) 1)) "id") "last_cognitive_event" (dv_get (rt_at events (rt_sub (rt_count events) 1)) "id")
                                              "policy" (dv_with_many (dv_get actor "policy") (dv_m2 "model_budget" (dv_get simulation "remaining") "model_work_remaining" (dv_get simulation "work_remaining"))))))
                                              )))) false) (set k (rt_add k 1)))))
                                        (set actor (dv_with_many actor (dv_m2 "simulations" simulations "factor_rejections" (dv_m2 "source_revision" (dv_get (dv_get actor "mind") "revision") "ids" factor_rejections)))))) false)
                                  (if (dv_has_key actor "location_ref")
                                    (let (cell (dv_read physical (dv_get actor "location_ref")))
                                      (if (dv_get cell "known") (set actor (dv_with actor "location" (dv_get cell "value"))) false)) false)
                                  (if (dv_has_key action "answer") (set actor (dv_with actor "answer_attempt_signatures" (dv_with (dv_find actor "answer_attempt_signatures" (rt_list)) (dv_get action "id") (dvp_input_signature actor action (dv_get choice "relevant_refs"))))) false)
                                  (if (rt_eq (dv_get action "kind") "replay") (set actor (dv_with actor "replay_attempt_signatures" (dv_with (dv_find actor "replay_attempt_signatures" (rt_list)) (dv_get action "id") (dvp_input_signature actor action (dv_get choice "relevant_refs"))))) false)
                                  (set actor (dv_with actor "attempts" (dv_with (dv_find actor "attempts" (rt_list)) (dv_get action "id") (dv_get (dv_get actor "mind") "revision"))))
                                  (set actor (dv_with_many actor (dv_m2 "used" (dv_append (dv_find actor "used" (rt_list)) (dv_get action "id"))
                                    "policy" (dv_with (dv_get actor "policy") "budget" (rt_sub (dv_get (dv_get actor "policy") "budget") 1)))))
                                  (set actors (dvs_replace actors index actor))
                                  (if (dv_and (dv_has_key action "speech") (rt_eq (dv_get (dv_get result "execution") "status") "applied"))
                                    (do (set actors (dvs_speech actors index action events time parent))
                                      (set actors (dvs_public_grants actors index action physical bindings events time parent action_event))) false)
                                  (set actor (rt_at actors index)) (set executed (rt_add executed 1)) (set idle 0)))))))))))))
              (set actors (dvs_replace actors index actor)))))
        (if (rt_not (rt_lt idle (rt_count actors))) (set status (if duration_blocked "budget-exhausted" "no-admissible-action-or-budget")) false)
        (if (rt_not (rt_lt (dv_find physical "time" 0) horizon)) (set status "budget-exhausted") false)
        (dvs_event events "session_stopped" "" (dv_find physical "time" 0) (dv_single (dv_get (rt_at events (rt_sub (rt_count events) 1)) "id")) (dv_m2 "reason" status "actions_executed" executed))
        (dv_with (dv_with (dv_with (dv_with (dv_m4 "events" events "initial" initial "final" (dv_m2 "physical" physical "actors" actors) "status" status)
          "time" (dv_find physical "time" 0)) "game_time_unit" "minute") "configuration"
          (dv_with (dv_with (dv_with (dv_m3 "cost_model" costs "formal_answers" (dv_find story "formal_answers" (rt_list)) "source_refs" (dv_find story "source_refs" (rt_list)))
            "time_origin" (dv_m4 "run_start" run_start "duration_budget" duration_budget "horizon" horizon "unit" "minute")) "report_labels" (dv_find story "report_labels" (rt_list))) "bindings" bindings))
          "scope" "DV formal model; no Godot host input or geometry")))))
(defn dvs_replace (items index value)
  (let (result (rt_list) i 0) (do (while (rt_lt i (rt_count items))
    (do (rt_push result (if (rt_eq i index) (dv_clone value) (dv_clone (rt_at items i)))) (set i (rt_add i 1)))) result)))
(defn dvs_main ()
  (let (story (rt_json_parse (rt_read (rt_arg 0))) capability (if (rt_lt 2 (rt_arg_count)) (rt_arg 2) "enabled"))
    (rt_write (rt_arg 1) (rt_json_stringify (dvs_run story capability)))))
(defn dvs_public_grants (actors speaker_index action physical bindings events time parent execution_id)
  (let (result actors speaker (rt_at actors speaker_index) listeners (dv_find action "listeners" (rt_list)) i 0)
    (do (while (rt_lt i (rt_count actors))
      (let (actor (rt_at result i) mind (dv_get (rt_at result i) "mind"))
        (do (if (dv_and (dv_has listeners (dv_get actor "id")) (dvs_speech_hearing speaker actor (dv_get action "speech")))
          (let (grants (dv_find action "public_grants" (rt_list)) observations (dv_perceive physical mind bindings (dv_find action "public_grants" (rt_list)) execution_id time))
            (if (rt_lt 0 (rt_count observations))
              (let (next (dv_get (dv_update_mind mind observations (dv_get mind "revision") (dvs_observation_profile actor)) "world") observation_event "")
                (do (set observation_event (dvs_event events "observation" (dv_get actor "id") time
                  (dvs_cognitive_parents actor (dvs_public_grant_parents events parent (dv_get actor "id")))
                  (dv_with_many (dv_m4 "observations" observations "mind_before" mind "mind_after" next "action" action)
                    (dv_m4 "bindings" bindings "grants" grants "execution_id" execution_id
                      "source_event" (dvs_public_literal_source events parent (dv_get actor "id"))))))
                  (set result (dvs_replace result i (dv_with_many actor (dv_m2 "mind" next "last_cognitive_event" observation_event)))))) false)) false)
          (set i (rt_add i 1))))) result)))
(defn dvs_observation_source (observations action)
  (let (result (rt_list) i 0 source (dv_find action "observation_source" "perception") origin (dv_find action "observation_origin" "direct") trust (dv_find action "observation_trust" 1))
    (do (dv_require (dv_has (dv_list3 "perception" "testimony" "recall") source) "Unknown observation source")
      (dv_unit trust)
      (while (rt_lt i (rt_count observations))
        (do (rt_push result (dv_with (dv_with (dv_with (rt_at observations i) "source" source) "origin" origin) "trust" trust)) (set i (rt_add i 1)))) result)))
(defn dvs_observation_profile (actor)
  (dv_observation_profile (dv_find (dv_get actor "policy") "observation_weights" (dv_m3 "perception" 1 "testimony" 1 "recall" 1))
    (dv_find (dv_get actor "policy") "observation_threshold" 0.5)))

; Glue between paid prediction evidence, explicit abduction and real submissions.
(defn dvs_argument_sources (events subject)
  (let (result (rt_list) i 0)
    (do (while (rt_lt i (rt_count events))
      (let (event (rt_at events i))
        (do (if (dv_and (rt_eq (dv_get event "actor") subject) (dv_or (rt_eq (dv_get event "type") "observation") (rt_eq (dv_get event "type") "listener_parse")))
          (let (observations (dv_get (dv_get event "data") "observations") j 0)
            (do (while (rt_lt j (rt_count observations))
              (do (rt_push result (dv_m2 "event_id" (dv_get event "id") "observation" (rt_at observations j))) (set j (rt_add j 1)))))) false)
          (set i (rt_add i 1))))) result)))
(defn dvs_capture_public_topics (actor events time parent)
  (let (bindings (dv_find (dv_get actor "policy") "topic_bindings" (rt_list)) heard (dv_find actor "heard_topics" (rt_list)) i 0)
    (do (while (rt_lt i (rt_count bindings))
      (let (binding (rt_at bindings i) topic (dv_get (rt_at bindings i) "topic"))
        (do (if (dv_and (rt_not (dv_has_key heard topic)) (rt_eq (dv_truth (dv_get actor "mind") (dv_get binding "heard_when")) "true"))
          (let (sources (dvs_support_parents (dv_get actor "mind") (dvs_sim_refs (dv_get binding "heard_when")) events (dv_get actor "id")))
            (if (rt_lt 0 (rt_count sources))
              (let (record (dv_with (dv_m3 "topic" topic "source_event_ids" sources "heard_when" (dv_get binding "heard_when")) "origin_speakers" (dvs_topic_origin_speakers events sources)))
                (do (dvs_event events "public_topic_heard" (dv_get actor "id") time (dv_explanation_merge (dv_single parent) sources) record)
                  (set heard (dv_with heard topic record)))) false)) false) (set i (rt_add i 1)))))
      (dvs_capture_heard_utterances (dv_with actor "heard_topics" heard) events))))
(defn dvs_topic_was_heard (actor topic)
  (dv_has_key (dv_find actor "heard_topics" (rt_list)) topic))
(defn dvs_argument_valid (actor)
  (let (argument (dv_find actor "argument" false))
    (if (rt_eq argument false) false
      (dv_and (dv_same (dv_find argument "adoptions" (rt_list)) (dv_get (dv_get actor "mind") "adoptions"))
        (dvs_topic_was_heard actor (dv_get argument "question_id"))))))
(defn dvs_argument_inputs_current (actor)
  (let (argument (dv_find actor "argument" false) valid true i 0)
    (if (rt_eq argument false) false
      (let (inputs (dv_get argument "inputs"))
        (do (while (rt_lt i (rt_count inputs))
          (let (input (rt_at inputs i))
            (do (if (dv_same (dv_get input "cell") (dv_read (dv_get actor "mind") (dv_get input "ref"))) false
              (let (changes (dv_get argument "changes") j 0 own_transaction false current (dv_read (dv_get actor "mind") (dv_get input "ref")))
                (do (while (rt_lt j (rt_count changes))
                  (let (change (rt_at changes j))
                    (do (if (dv_and (dv_same (dv_get change "ref") (dv_get input "ref"))
                      (dv_and (rt_eq (dv_find current "source" "") "abduction")
                        (dv_and (dv_has (dv_find current "basis" (rt_list)) (dv_get argument "id"))
                          (dv_same (dv_get current "value") (dv_get (dv_get change "after") "value")))))
                      (set own_transaction true) false) (set j (rt_add j 1)))))
                  (if own_transaction false (set valid false))))) (set i (rt_add i 1))))) valid)))))
(defn dvs_argument_revoke (actor events time parent)
  (let (argument (dv_get actor "argument") world (dv_get actor "mind") changes (dv_get (dv_get actor "argument") "changes") i 0 restored (rt_list)
    derivations (dv_find actor "inference_derivations" (rt_list)) contaminated (rt_list) remaining (dv_find (dv_get actor "policy") "reason_budget" 0) checked 0 blocked false descendants (rt_list) updated false)
    (do (while (rt_lt i (rt_count changes))
      (do (set contaminated (dvp_add_ref contaminated (dv_get (rt_at changes i) "ref"))) (set i (rt_add i 1))))
      (set i (rt_sub (rt_count derivations) 1))
      (while (dv_and (rt_not (rt_lt i 0)) (rt_not blocked))
        (let (derivation (rt_at derivations i) dependent false inputs (dv_get (rt_at derivations i) "inputs") j 0)
          (do (if (rt_lt remaining 1) (set blocked true)
            (do (set remaining (rt_sub remaining 1)) (set checked (rt_add checked 1))
              (while (rt_lt j (rt_count inputs))
                (do (if (dv_has contaminated (dv_get (rt_at inputs j) "ref")) (set dependent true) false) (set j (rt_add j 1)))) ))
            (if (dv_and (rt_not blocked) (dv_and dependent (dv_find derivation "valid" true)))
              (let (outputs (dv_get derivation "changes") k 0)
                (do (while (rt_lt k (rt_count outputs))
                  (let (change (rt_at outputs k) current (dv_read world (dv_get (rt_at outputs k) "ref")))
                    (do (if (dv_same current (dv_get change "after"))
                      (do (set world (dv_store world (dv_get change "ref") (dv_get change "before")))
                        (set contaminated (dvp_add_ref contaminated (dv_get change "ref"))) (rt_push restored change)) false)
                      (set k (rt_add k 1)))))
                  (rt_push descendants (dv_get derivation "event"))
                  (set derivations (dvs_replace derivations i (dv_with derivation "valid" false))))) false)
            (set i (rt_sub i 1)))))
      (set i 0)
      (if blocked false
        (while (rt_lt i (rt_count changes))
          (let (change (rt_at changes i) cell (dv_read world (dv_get (rt_at changes i) "ref")))
            (do (if (dv_and (rt_eq (dv_find cell "source" "") "abduction") (dv_has (dv_find cell "basis" (rt_list)) (dv_get argument "id")))
              (do (set world (dv_store world (dv_get change "ref") (dv_get change "before"))) (rt_push restored change)) false) (set i (rt_add i 1))))))
      (if (rt_lt 0 (rt_count restored)) (set world (dv_with world "revision" (rt_add (dv_get world "revision") 1))) false)
      (set updated (dv_with (dv_with (dv_with (dv_with (dv_with (dv_with actor "mind" world) "argument" (if blocked argument false)) "ready_hypothesis" false)
        "inference_derivations" derivations) "cognition_blocked" blocked) "policy" (dv_with (dv_get actor "policy") "reason_budget" remaining)))
      (set updated (dv_with updated "last_cognitive_event" (rt_cat "e" (rt_show (rt_count events)))))
      (dvs_event events (if blocked "model_argument_revocation_pending" "model_argument_revoked") (dv_get actor "id") time
        (dvs_cognitive_parents actor (dv_explanation_merge (dv_pair parent (dv_get argument "id")) descendants))
        (dv_with (dv_with (dv_with (dv_with (dv_m4 "argument" argument "mind_before" (dv_get actor "mind") "mind_after" world "restored" restored) "checked" checked) "remaining" remaining) "actor_before" actor) "actor_after" updated))
      updated)))
(defn dvs_factor_coverage (actor hypothesis events)
  (let (candidates (dv_find (dv_get actor "policy") "hypotheses" (rt_list)) catalog (rt_list) certificates (dv_find actor "factor_certificates" (rt_list)) verified (rt_list) i 0)
    (do (while (rt_lt i (rt_count candidates))
      (let (candidate (rt_at candidates i))
        (do (if (dv_and (dvp_topic actor candidate) (rt_eq (dv_find candidate "group" "") (dv_find hypothesis "group" ""))) (rt_push catalog candidate) false) (set i (rt_add i 1)))))
      (if (dvs_factor_catalog_complete (dv_find (dv_get actor "policy") "factor_domains" (rt_list)) catalog)
        (do (set i 0) (while (rt_lt i (rt_count certificates))
          (do (if (dvs_factor_certificate_current actor (rt_at certificates i) events) (rt_push verified (rt_at certificates i)) false) (set i (rt_add i 1))))) false)
      (dv_m2 "catalog" catalog "certificates" verified))))
(defn dvs_factor_covered (candidate certificates)
  (let (i 0 covered false assignments (dv_find candidate "variable_assignments" (rt_list)))
    (do (while (rt_lt i (rt_count certificates))
      (do (if (dvs_factor_covers (rt_at certificates i) assignments) (set covered true) false) (set i (rt_add i 1)))) covered)))
(defn dvs_factor_argument (result coverage)
  (let (argument (dv_get result "argument") certificates (dv_get coverage "certificates") i 0 events (rt_list) sources (rt_list) inputs (rt_list))
    (do (while (rt_lt i (rt_count certificates))
      (let (certificate (rt_at certificates i) chain (dv_get (rt_at certificates i) "source_chain") j 0)
        (do (set events (dv_explanation_merge events (dv_single (dv_get certificate "event"))))
          (set sources (dv_explanation_merge sources (dv_get certificate "source_event_ids")))
          (while (rt_lt j (rt_count chain))
            (do (rt_push inputs (dv_m2 "ref" (dv_get (rt_at chain j) "ref") "cell" (dv_get (rt_at chain j) "cell"))) (set j (rt_add j 1)))) (set i (rt_add i 1)))))
      (set argument (dv_with (dv_with (dv_with (dv_with argument "factor_coverage" coverage)
        "competitor_events" (dv_explanation_merge (dv_get argument "competitor_events") events))
        "source_event_ids" (dv_explanation_merge (dv_get argument "source_event_ids") sources)) "inputs" (dv_explanation_merge (dv_get argument "inputs") inputs)))
      (dv_with result "argument" argument))))
(defn dvs_arguments (actor events time parent)
  (do (if (rt_eq (dv_find actor "argument" false) false) false
    (if (dv_and (dvs_argument_valid actor) (dvs_argument_inputs_current actor)) false (set actor (dvs_argument_revoke actor events time parent))))
    (if (dv_and (dvs_argument_valid actor) (dvs_argument_inputs_current actor)) actor
      (let (hypothesis (dv_find actor "hypothesis" false))
        (if (if (rt_eq hypothesis false) true
          (rt_not (dv_and (rt_lt 0 (rt_count (dv_find hypothesis "claim_slots" (rt_list))))
            (dv_and (rt_lt 0 (rt_count (dv_find hypothesis "features" (rt_list))))
              (dv_and (rt_lt 0 (rt_count (dvs_sim_plan hypothesis)))
                (dv_has_key (dv_find (dv_find actor "simulations" (rt_list)) (dv_get hypothesis "id") (rt_list)) "event")))))) actor
          (let (model (dvs_cached_model actor hypothesis) candidates (dv_find (dv_get actor "policy") "hypotheses" (rt_list)) i 0 competitors (rt_list)
            coverage (dvs_factor_coverage actor hypothesis events)
            slots (dv_find hypothesis "claim_slots" (rt_list)) policy (dv_find (dv_get actor "policy") "abduction" (rt_list))
            signature (dv_m4 "model" (dv_find (dvs_cached_model actor hypothesis) "event" "") "revision" (dv_get (dv_get actor "mind") "revision") "slots" (dv_find hypothesis "claim_slots" (rt_list)) "policy" (dv_find (dv_get actor "policy") "abduction" (rt_list))))
            (if (dv_same signature (dv_find actor "argument_attempt" false)) actor
              (do (if (dvs_factor_covered hypothesis (dv_get coverage "certificates"))
                (set model (dv_m2 "status" "certificate-refuted" "fit" -1000000)) false)
                (while (rt_lt i (rt_count candidates))
                (let (candidate (rt_at candidates i))
                  (do (if (dv_and (dvp_topic actor candidate) (dv_and (rt_not (rt_eq (dv_get candidate "id") (dv_get hypothesis "id")))
                    (dv_and (rt_eq (dv_find candidate "group" "") (dv_find hypothesis "group" "")) (rt_eq (dv_truth (dv_get actor "mind") (dv_find candidate "available_when" (dv_true))) "true"))))
                    (if (dvs_factor_covered candidate (dv_get coverage "certificates")) false (rt_push competitors (dvs_cached_model actor candidate))) false) (set i (rt_add i 1)))))
                (let (certificates (dv_get coverage "certificates") c 0)
                  (while (rt_lt c (rt_count certificates))
                    (do (set policy (dv_with policy "confidence_cap" (dv_min (dv_find policy "confidence_cap" 0) (dv_get (rt_at certificates c) "confidence")))) (set c (rt_add c 1)))))
                (let (result (dvs_factor_argument (dv_accept_explanation (dv_get actor "mind") model competitors slots (dvs_argument_sources events (dv_get actor "id")) policy
                  (dv_find (dv_get actor "policy") "reason_budget" 0) time (rt_cat "e" (rt_show (rt_count events)))) coverage) parents (dvs_cognitive_parents actor (dv_single parent)))
                  (do (if (dv_has_key model "event") (set parents (dv_explanation_merge parents (dv_single (dv_get model "event")))) false)
                    (set parents (dv_explanation_merge parents (dv_get (dv_get result "argument") "source_event_ids")))
                    (set parents (dv_explanation_merge parents (dv_get (dv_get result "argument") "competitor_events")))
                    (set actor (dv_with actor "last_cognitive_event" (dvs_event events (if (dv_get result "accepted") "model_argument_accepted" "model_argument_unavailable") (dv_get actor "id") time parents
                      (dv_m4 "actor_before" actor "hypothesis" hypothesis "competitors" competitors "result" result))))
                    (set actor (dv_with (dv_with actor "argument_attempt" signature) "policy" (dv_with (dv_get actor "policy") "reason_budget" (dv_get result "remaining"))))
                    (if (dv_get result "accepted")
                      (dv_with (dv_with actor "mind" (dv_get result "world")) "argument"
                        (dv_with (dv_with (dv_with (dv_get result "argument") "adoptions" (dv_get (dv_get actor "mind") "adoptions")) "question_id" (dv_find hypothesis "question" (dv_find hypothesis "topic" ""))) "hypothesis_id" (dv_get hypothesis "id"))) actor)))))))))))
(defn dvs_argument_action (actor action)
  (if (dv_has_key action "argument_slots")
    (if (dv_and (dvs_argument_valid actor) (dvs_argument_inputs_current actor))
      (let (argument (dv_get actor "argument") requested (dv_get action "argument_slots") claims (dv_get (dv_get actor "argument") "claims") i 0 propositions (rt_list) transmitted (rt_list) valid true)
        (do (if (rt_eq (dv_find action "argument_question" (dv_get argument "question_id")) (dv_get argument "question_id")) false (set valid false))
          (while (rt_lt i (rt_count requested))
          (let (slot_id (rt_at requested i) j 0 found false)
            (do (while (rt_lt j (rt_count claims))
              (let (claim (rt_at claims j))
                (do (if (rt_eq slot_id (dv_get claim "slot_id"))
                  (do (set found true) (rt_push propositions (dv_fact (dv_get claim "ref") (dv_get claim "value"))) (rt_push transmitted claim)) false) (set j (rt_add j 1)))))
              (if found false (set valid false)) (set i (rt_add i 1)))))
          (if (rt_eq (rt_count requested) 0) (set valid false) false)
          (if (dv_find action "speech_from_argument" false)
            (let (proposal (dv_with (dv_with (dv_with (dv_m4 "argument_id" (dv_get argument "id") "id" (dv_get argument "id") "estimated" true "confidence" (dv_get argument "confidence"))
              "claims" transmitted) "source_event_ids" (dv_get argument "source_event_ids")) "model_event" (dv_get argument "model_event")))
              (dv_with (dv_with (dv_with (dv_with (dv_without action "answer") "speech"
                (dv_with (dv_with (dv_find action "speech" (rt_list)) "literal_ast" (dv_all propositions)) "proposal" (dv_with proposal "reassessment_sources" (dvs_argument_reassessment_sources actor action argument))))
                  "proposal" (dv_with proposal "reassessment_sources" (dvs_argument_reassessment_sources actor action argument))) "argument" argument) "argument_available" valid))
            (dv_with (dv_with (dv_with action "answer" (dv_all propositions)) "argument" argument) "argument_available" valid))))
      (dv_with action "argument_available" false)) action))
(defn dvs_materialize_arguments (actor)
  (let (actions (dv_get actor "actions") i 0 result (rt_list))
    (do (while (rt_lt i (rt_count actions))
      (do (rt_push result (dvs_argument_action actor (rt_at actions i))) (set i (rt_add i 1)))) (dv_with actor "actions" result))))

(defn dvs_support_parents (mind refs events subject)
  (let (parents (rt_list) i 0)
    (do (while (rt_lt i (rt_count refs))
      (let (ref (rt_at refs i) cell (dv_read mind (rt_at refs i)) j 0)
        (do (while (rt_lt j (rt_count events))
          (let (event (rt_at events j) data (dv_get (rt_at events j) "data") k 0)
            (do (if (rt_eq (dv_get event "actor") subject)
              (do (if (dv_or (rt_eq (dv_get event "type") "observation") (rt_eq (dv_get event "type") "listener_parse"))
                (let (observations (dv_get data "observations"))
                  (do (while (rt_lt k (rt_count observations))
                    (let (observation (rt_at observations k))
                      (do (if (dv_and (dv_same (dv_get observation "ref") ref) (dv_has (dv_find cell "claims" (rt_list)) observation))
                        (set parents (dv_explanation_merge parents (dv_single (dv_get event "id")))) false) (set k (rt_add k 1))))))) false)
                (if (rt_eq (dv_get event "type") "inference")
                  (let (changes (dv_get (dv_get data "receipt") "changes") n 0)
                    (do (while (rt_lt n (rt_count changes))
                      (let (change (rt_at changes n))
                        (do (if (dv_and (dv_same (dv_get change "ref") ref) (dv_same (dv_get change "after") cell))
                          (set parents (dv_explanation_merge parents (dv_single (dv_get event "id")))) false) (set n (rt_add n 1))))))) false)
                (if (rt_eq (dv_get event "type") "model_argument_accepted")
                  (if (dv_has (dv_find cell "basis" (rt_list)) (dv_get event "id")) (set parents (dv_explanation_merge parents (dv_single (dv_get event "id")))) false) false)) false)
              (set j (rt_add j 1))))) (set i (rt_add i 1))))) parents)))
(defn dvs_selection_parents (actor action choice events parent)
  (let (refs (dv_get choice "relevant_refs") parents (dvs_cognitive_parents actor (dv_single parent)))
    (do (set refs (dvp_merge_refs refs (dvs_sim_refs (dv_get action "precondition"))))
      (if (dv_has_key action "answer") (set refs (dvp_merge_refs refs (dvs_sim_refs (dv_get action "answer")))) false)
      (if (dv_has_key actor "question_ref") (set refs (dvp_add_ref refs (dv_get actor "question_ref"))) false)
      (set parents (dv_explanation_merge parents (dvs_support_parents (dv_get actor "mind") refs events (dv_get actor "id"))))
      (if (rt_eq (dv_find actor "hypothesis_event" "") "") false (set parents (dv_explanation_merge parents (dv_single (dv_get actor "hypothesis_event")))))
      (if (dv_has_key action "speech")
        (let (prediction (dv_find (dv_find actor "speech_choice_values" (rt_list)) (dv_get action "id") (rt_list)))
          (set parents (dv_explanation_merge parents (dv_find prediction "prediction_events" (rt_list))))) false)
      (if (dv_has_key action "argument") (set parents (dv_explanation_merge parents (dv_single (dv_get (dv_get action "argument") "id")))) false) parents)))
(defn dvs_model_parent_ids (actor parent prior)
  (let (result (dvs_cognitive_parents actor (dv_single parent)))
    (do (if (rt_eq (dv_find actor "model_paid_event" "") "") false (set result (dv_explanation_merge result (dv_single (dv_get actor "model_paid_event")))))
      (if (rt_eq (dv_find actor "model_previous_event" "") "") false (set result (dv_explanation_merge result (dv_single (dv_get actor "model_previous_event")))))
      (if (rt_eq prior "") false (set result (dv_explanation_merge result (dv_single prior)))) result)))

(defn dvs_public_grant_parents (events parent subject)
  (let (result (dv_single parent) literal "" i 0)
    (do (while (rt_lt i (rt_count events))
      (let (event (rt_at events i))
        (do (if (rt_eq (dv_get event "type") "speech_literal")
          (if (dv_has (dv_get event "parents") parent) (set literal (dv_get event "id")) false) false) (set i (rt_add i 1)))))
      (if (rt_eq literal "") false
        (do (set result (dv_explanation_merge result (dv_single literal))) (set i 0)
          (while (rt_lt i (rt_count events))
            (let (event (rt_at events i))
              (do (if (dv_and (rt_eq (dv_get event "type") "listener_parse") (rt_eq (dv_get event "actor") subject))
                (if (rt_eq (dv_find (dv_get event "data") "source_event" "") literal)
                  (set result (dv_explanation_merge result (dv_single (dv_get event "id")))) false) false) (set i (rt_add i 1))))))) result)))
(defn dvs_physical_proposition (proposition bindings subject)
  (let (op (dv_get proposition "op"))
    (if (rt_eq op "constant") proposition
      (if (rt_eq op "not") (dv_not (dvs_physical_proposition (dv_get proposition "item") bindings subject))
        (if (rt_eq op "all")
          (let (items (dv_get proposition "items") i 0 mapped (rt_list))
            (do (while (rt_lt i (rt_count items))
              (do (rt_push mapped (dvs_physical_proposition (rt_at items i) bindings subject)) (set i (rt_add i 1)))) (dv_all mapped)))
          (let (ref (dv_get proposition "ref") i 0 physical "")
            (do (while (rt_lt i (rt_count bindings))
              (let (binding (rt_at bindings i))
                (do (if (dv_and (rt_eq (dv_get binding "subject") subject) (rt_eq (dv_get binding "local") (dv_get ref "object")))
                  (set physical (dv_get binding "physical")) false) (set i (rt_add i 1)))))
              (if (rt_eq physical "") (dv_m2 "op" "constant" "value" "unknown") (dv_with proposition "ref" (dv_ref physical (dv_get ref "facet") (dv_get ref "field")))))))))))

(defn dvs_refresh_derivations (actor events time parent)
  (let (derivations (dv_find actor "inference_derivations" (rt_list)) world (dv_get actor "mind") i (rt_sub (rt_count (dv_find actor "inference_derivations" (rt_list))) 1)
    contaminated (rt_list) restored (rt_list) parents (dvs_cognitive_parents actor (dv_single parent)) remaining (dv_find (dv_get actor "policy") "reason_budget" 0) checked 0 blocked false updated false)
    (do (while (dv_and (rt_not (rt_lt i 0)) (rt_not blocked))
      (let (derivation (rt_at derivations i) inputs (dv_get (rt_at derivations i) "inputs") stale false j 0)
        (do (if (dv_find derivation "valid" true)
          (do (if (dv_same (dv_get derivation "adoption")
            (dv_find (dv_get world "adoptions") (dv_get (dv_get (dv_get derivation "adoption") "law") "name") false)) false (set stale true))
            (while (rt_lt j (rt_count inputs))
            (let (input (rt_at inputs j))
              (do (if (dv_or (dv_has contaminated (dv_get input "ref"))
                (rt_not (dv_same (dvs_reason_cell (dv_get input "cell")) (dvs_reason_cell (dv_read world (dv_get input "ref"))))))
                (set stale true) false) (set j (rt_add j 1)))))
            (if stale
              (if (rt_lt remaining 1) (set blocked true)
                (let (changes (dv_get derivation "changes") k 0)
                  (do (set remaining (rt_sub remaining 1)) (set checked (rt_add checked 1))
                    (set parents (dv_explanation_merge parents (dvs_support_parents (dv_get actor "mind") (dvs_sim_refs (dv_get (dv_get (dv_get derivation "adoption") "law") "premise")) events (dv_get actor "id"))))
                    (while (rt_lt k (rt_count changes))
                      (let (change (rt_at changes k))
                        (do (if (dv_same (dv_read world (dv_get change "ref")) (dv_get change "after"))
                          (do (set world (dv_store world (dv_get change "ref") (dv_get change "before")))
                            (set contaminated (dvp_add_ref contaminated (dv_get change "ref"))) (rt_push restored change)) false)
                          (set k (rt_add k 1)))))
                    (set parents (dv_explanation_merge parents (dv_single (dv_get derivation "event"))))
                    (set derivations (dvs_replace derivations i (dv_with derivation "valid" false)))))) false)) false)
          (set i (rt_sub i 1)))))
      (if (rt_lt 0 (rt_count restored)) (set world (dv_with world "revision" (rt_add (dv_get world "revision") 1))) false)
      (set updated (dv_with (dv_with (dv_with (dv_with actor "mind" world) "inference_derivations" derivations) "cognition_blocked" blocked)
        "policy" (dv_with (dv_get actor "policy") "reason_budget" remaining)))
      (if (dv_or blocked (rt_lt 0 checked))
        (set updated (dv_with updated "last_cognitive_event" (rt_cat "e" (rt_show (rt_count events))))) false)
      (if (dv_or blocked (rt_lt 0 checked))
        (set parent (dvs_event events "inference_dependencies_invalidated" (dv_get actor "id") time parents
          (dv_with (dv_with (dv_with (dv_with (dv_m4 "mind_before" (dv_get actor "mind") "mind_after" world "restored" restored "checked" checked) "budget_blocked" blocked) "remaining" remaining) "actor_before" actor) "actor_after" updated))) false)
      (if (dv_and (rt_not blocked) (rt_lt 0 checked)) (dvs_refresh_derivations updated events time parent) updated))))

(defn dvs_model_observed_inputs (model)
  (let (comparisons (dv_find model "comparisons" (rt_list)) result (rt_list) i 0)
    (do (while (rt_lt i (rt_count comparisons))
      (do (set result (dv_explanation_merge result (dv_find (rt_at comparisons i) "observed_cells" (rt_list)))) (set i (rt_add i 1)))) result)))

(defn dvs_public_model_paid (events id subject)
  (let (i 0 valid false)
    (do (while (rt_lt i (rt_count events))
      (let (event (rt_at events i))
        (do (if (dv_and (rt_eq (dv_get event "id") id)
          (dv_and (rt_eq (dv_get event "actor") subject)
            (dv_or (rt_eq (dv_get event "type") "mind_simulation") (rt_eq (dv_get event "type") "model_recheck"))))
          (let (parents (dv_get event "parents") j 0 result (dv_get (dv_get event "data") "result"))
            (do (while (rt_lt j (rt_count events))
              (let (paid (rt_at events j))
                (do (if (dv_and (dv_has parents (dv_get paid "id"))
                  (dv_and (rt_eq (dv_get paid "actor") subject) (rt_eq (dv_get paid "type") "action_execution")))
                  (let (data (dv_get paid "data"))
                    (if (dv_and (rt_eq (dv_find (dv_find data "action" (rt_list)) "kind" "") "replay")
                      (dv_and (rt_eq (dv_get (dv_get (dv_get data "receipt") "execution") "status") "applied")
                        (dv_and (rt_eq (dv_find result "status" "") "explained") (dv_find result "plan_complete" false))))
                      (set valid true) false)) false) (set j (rt_add j 1))))))) false) (set i (rt_add i 1))))) valid)))
(defn dvs_public_argument_valid (action rule events subject)
  (let (argument (dv_find action "argument" false) valid false i 0)
    (if (rt_eq argument false) false
      (if (dv_has_key argument "id") (do (while (rt_lt i (rt_count events))
        (let (event (rt_at events i))
          (do (if (dv_and (rt_eq (dv_get event "id") (dv_get argument "id"))
            (dv_and (rt_eq (dv_get event "actor") subject) (rt_eq (dv_get event "type") "model_argument_accepted")))
            (let (original (dv_get (dv_get (dv_get event "data") "result") "argument")
              public (dv_without (dv_without (dv_without argument "question_id") "hypothesis_id") "adoptions"))
              (if (dv_same original public) (set valid true) false)) false) (set i (rt_add i 1)))))
        (if valid (if (dvs_public_model_paid events (dv_get argument "model_event") subject) false (set valid false)) false)
        (if valid
          (let (required (dv_find rule "required_argument_slots" (dv_find action "argument_slots" (rt_list))) claims (dv_get argument "claims") j 0 propositions (rt_list))
            (do (if (dv_and (rt_lt 0 (rt_count required)) (dv_and (dv_get argument "estimated")
              (dv_and (rt_lt 0 (dv_get argument "confidence")) (dv_and (rt_lt (dv_get argument "confidence") 1)
                (dv_and (rt_not (rt_eq (dv_get argument "model_event") "")) (rt_lt 0 (rt_count (dv_get argument "source_event_ids")))))))) false (set valid false))
              (while (rt_lt j (rt_count required))
                (let (slot (rt_at required j) k 0 found false)
                  (do (while (rt_lt k (rt_count claims))
                    (let (claim (rt_at claims k))
                      (do (if (rt_eq (dv_get claim "slot_id") slot)
                        (do (set found true) (rt_push propositions (dv_fact (dv_get claim "ref") (dv_get claim "value")))) false) (set k (rt_add k 1)))))
                    (if found false (set valid false)) (set j (rt_add j 1)))))
              (if (dv_same (dv_all propositions) (dv_get action "answer")) false (set valid false)))) false) valid) false))))

(defn dvs_factor_candidate_rejected (actor candidate)
  (let (rejections (dv_find actor "factor_rejections" (dv_m2 "source_revision" -1 "ids" (rt_list))))
    (dv_and (rt_eq (dv_get rejections "source_revision") (dv_get (dv_get actor "mind") "revision")) (dv_has (dv_get rejections "ids") (dv_get candidate "id")))))

; Only actual personal reception may bind a later proposal to an old utterance.
(defn dvs_capture_heard_utterances (actor events)
  (let (heard (dv_find actor "heard_utterances" (rt_list)) i 0)
    (do (while (rt_lt i (rt_count events))
      (let (event (rt_at events i))
        (do (if (dv_and (rt_eq (dv_get event "actor") (dv_get actor "id")) (rt_eq (dv_get event "type") "listener_parse"))
          (let (data (dv_get event "data") source (dv_get (dv_get event "data") "source_event") j 0)
            (do (while (rt_lt j (rt_count events))
              (let (literal (rt_at events j))
                (do (if (dv_and (dv_has (dv_get event "parents") source) (dv_and (rt_eq (dv_get literal "id") source) (rt_eq (dv_get literal "type") "speech_literal")))
                  (if (rt_eq (dv_get literal "actor") (dv_get actor "id")) false
                    (set heard (dv_with heard source (dv_with (dv_m4 "source_event" source "parse_event" (dv_get event "id")
                      "speaker" (dv_get literal "actor") "scope" (dv_find (dv_get data "speech") "scope" "")) "refs" (dvs_sim_refs (dv_get data "literal")))))) false)
                  (set j (rt_add j 1))))))) false) (set i (rt_add i 1))))) (dv_with actor "heard_utterances" heard))))
(defn dvs_topic_origin_speakers (events sources)
  (let (pending (dv_clone sources) visited (rt_list) result (rt_list) i 0)
    (do (while (rt_lt i (rt_count pending))
      (let (id (rt_at pending i) j 0)
        (do (if (dv_has visited id) false
          (do (rt_push visited id)
            (while (rt_lt j (rt_count events))
              (let (event (rt_at events j))
                (do (if (rt_eq (dv_get event "id") id)
                  (do (if (dv_or (rt_eq (dv_get event "type") "observation") (rt_eq (dv_get event "type") "listener_parse"))
                      (let (source (dv_find (dv_get event "data") "source_event" ""))
                        (if (dv_and (rt_not (rt_eq source "")) (dv_has (dv_get event "parents") source))
                          (set pending (dv_explanation_merge pending (dv_single source))) false))
                      (if (rt_eq (dv_get event "type") "public_topic_heard")
                        (set pending (dv_explanation_merge pending (dv_find (dv_get event "data") "source_event_ids" (rt_list)))) false))
                    (if (rt_eq (dv_get event "type") "speech_literal")
                      (set result (dv_explanation_merge result (dv_single (dv_get event "actor")))) false)) false)
                  (set j (rt_add j 1))))))) (set i (rt_add i 1))))) result)))
(defn dvs_argument_reassessment_sources (actor action argument)
