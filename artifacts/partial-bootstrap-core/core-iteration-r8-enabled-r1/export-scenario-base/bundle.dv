  (dv_all (dv_pair (c1_at actor "hall") (dv_fact (dv_ref "question" "state" "current") "identity")))
  (c1_at actor "hall") "" (rt_list) (c1_source "godot_csharp/scenes/Awakening/Script/story/第一章/可习得命题.story" 101 "V1_0")) "answer" (dv_fact (c1_knowledge "su_room") true)) "answer_id" "V1_0"))

(defn c1_hypothesis_V1_0 ()
