(defn c1_visible_E10 () "罐里的酵种还活着，冒着细泡。\n罐壁上一层摞一层干结的旧面痕，数不清。")

(defn c1_inspect_E11 (actor)
 (c1_once (c1_action (rt_cat actor ".inspect.E11") "inspect"
  (c1_at actor "R05") (c1_at actor "R05") ""
  (dv_single (c1_knowledge "shelf_old")) (c1_source "godot_csharp/scenes/Awakening/Script/story/第一章/可习得命题.story" 79 "E11"))))

(defn c1_visible_E11 () "书架积着灰。灰上留着几块干净的长方形，边缘整齐——这里原先摆过东西，摆了很久。\n架沿上有半枚手印，压在灰上。")

