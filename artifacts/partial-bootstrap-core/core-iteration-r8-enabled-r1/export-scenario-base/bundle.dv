(defn c1_list_15 (p0 p1 p2 p3 p4 p5 p6 p7 p8 p9 p10 p11 p12 p13 p14) (let (list (rt_list)) (do (rt_push list p0) (rt_push list p1) (rt_push list p2) (rt_push list p3) (rt_push list p4) (rt_push list p5) (rt_push list p6) (rt_push list p7) (rt_push list p8) (rt_push list p9) (rt_push list p10) (rt_push list p11) (rt_push list p12) (rt_push list p13) (rt_push list p14) list)))

