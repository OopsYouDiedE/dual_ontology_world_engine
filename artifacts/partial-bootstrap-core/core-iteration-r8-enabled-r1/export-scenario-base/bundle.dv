(defn c1_physical_cognition ()
 (let (fields (c1_materials) conclusions (c1_authority_conclusions) i 0)
  (do (while (rt_lt i (rt_count conclusions))
   (do (set fields (dv_with fields (rt_at (rt_at conclusions i) 0) (rt_at (rt_at conclusions i) 1))) (set i (rt_add i 1))))
   (c1_state_object "cognition" fields))))
; These authority conclusions are frozen authored history, never grants or mind initial facts.
; In particular familiar is a source scenario truth; the person's inference remains evidence-weighted.
(defn c1_position (actor room) (c1_state_object actor (dv_single (dv_pair "location" (dv_field room)))))
