(defn c1_visible_E12 () "衣架上挂着你的深棕长风衣。\n口袋里：一支石墨笔，一把折叠放大镜，几只证物袋。\n放大镜是黄铜圆框，带一截短柄。")

(defn c1_infer_rules () (c1_list_20 (c1_infer_0 "cognition") (c1_infer_1 "cognition") (c1_infer_2 "cognition") (c1_infer_3 "cognition") (c1_infer_4 "cognition") (c1_infer_5 "cognition") (c1_infer_6 "cognition") (c1_infer_7 "cognition") (c1_infer_8 "cognition") (c1_infer_9 "cognition") (c1_infer_10 "cognition") (c1_infer_11 "cognition") (c1_infer_12 "cognition") (c1_infer_13 "cognition") (c1_infer_14 "cognition") (c1_infer_15 "cognition") (c1_infer_16 "cognition") (c1_infer_17 "cognition") (c1_infer_18 "cognition") (c1_infer_19 "cognition")))

(defn c1_adopt_inferences (mind)
 (let (rules (c1_infer_rules) result mind i 0)
  (do (while (rt_lt i (rt_count rules))
   (do (set result (dv_adopt result (rt_at rules i) "infer" 0.85 (dv_single (c1_source "godot_csharp/scenes/Awakening/Script/story/第一章/可习得命题.story" 2 "推知关系")))) (set i (rt_add i 1)))) result)))

(defn c1_move_name (actor origin target) (rt_cat (rt_cat (rt_cat actor ".move.") origin) (rt_cat "." target)))
(defn c1_move_action (actor origin target)
 (let (name (c1_move_name actor origin target))
  (dv_with (c1_action name "move" (c1_at actor origin) (c1_at actor origin) name
   (dv_single (dv_ref actor "state" "location"))
   (c1_source "godot_csharp/scenes/Awakening/Script/story/第一章/实体登记.story" 19 "重演通路"))
   "predict_law" name)))
(defn c1_add_move_methods (world actor mode)
 (let (edges (c1_edges) result world i 0)
  (do (while (rt_lt i (rt_count edges))
   (let (edge (rt_at edges i) a (rt_at (rt_at edges i) 0) b (rt_at (rt_at edges i) 1))
    (do (set result (dv_adopt result (c1_method (c1_move_name actor a b) (c1_move actor a b)) mode 1
      (dv_single (c1_source "godot_csharp/scenes/Awakening/Script/story/第一章/实体登记.story" 19 "重演通路"))))
     (set result (dv_adopt result (c1_method (c1_move_name actor b a) (c1_move actor b a)) mode 1
      (dv_single (c1_source "godot_csharp/scenes/Awakening/Script/story/第一章/实体登记.story" 19 "重演通路"))))
     (set i (rt_add i 1))))) result)))
(defn c1_move_actions (actor)
 (let (edges (c1_edges) result (rt_list) i 0)
  (do (while (rt_lt i (rt_count edges))
   (let (a (rt_at (rt_at edges i) 0) b (rt_at (rt_at edges i) 1))
    (do (rt_push result (c1_move_action actor a b)) (rt_push result (c1_move_action actor b a)) (set i (rt_add i 1))))) result)))


(defn c1_statement (atom) (dv_fact (c1_knowledge atom) true))

(defn c1_answer_me (actor)
 (dv_with (dv_with (c1_action (rt_cat actor ".answer.me") "answer"
  (dv_all (dv_pair (c1_at actor "hall") (dv_fact (dv_ref "question" "state" "current") "identity")))
  (c1_at actor "hall") "" (rt_list) (c1_source "godot_csharp/scenes/Awakening/Script/story/第一章/可习得命题.story" 11 "me")) "answer" (dv_fact (c1_knowledge "me") true)) "answer_id" "me"))

(defn c1_hypothesis_me ()
 (dv_with (dv_with (dv_with (dv_m4 "id" "me" "proposition" (dv_fact (c1_knowledge "me") true) "prior" 0.5 "basis" (dv_single (c1_source "godot_csharp/scenes/Awakening/Script/story/第一章/可习得命题.story" 11 "me")))
   "available_when" (dv_fact (dv_ref "question" "state" "current") "identity")) "assumptions" (dv_single (dv_fact (c1_knowledge "me") true))) "group" "identity"))

