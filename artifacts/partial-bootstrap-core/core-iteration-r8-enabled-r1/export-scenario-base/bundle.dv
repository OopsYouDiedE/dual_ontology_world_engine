; 热点与布局.story:340-349, 房间名; room adjacency is supplied by instance adoption.
; Only directed edges declared in content setup may be adopted. No global teleport law.
(axiom c1_move 1 (actor origin target)
  (dv_fact (dv_ref actor "state" "location") origin)
  (dv_single (dv_assign (dv_ref actor "state" "location") target)))

; 场面/01_开场.story:28, s3_broadcast.019; opening advances the public protocol only.
(axiom c1_opening_emit 1 (question)
  (dv_fact (dv_ref question "state" "stage") "opening")
  (dv_single (dv_assign (dv_ref question "state" "stage") "prompt")))

; 场面/07_答辩.story:8, answer_q1.001; dispatching a question does not answer it.
(axiom c1_question_emit 1 (question)
  (dv_fact (dv_ref question "state" "stage") "prompt")
  (dv_pair (dv_assign (dv_ref question "state" "current") "identity")
           (dv_assign (dv_ref question "state" "stage") "identity")))

; 场面/07_答辩.story:12/25/34/43, answer_ok1/2/3/4; formal acceptance gates execution.
; This scheduling law has no authority to decide literal truth or support sufficiency.
(axiom c1_question_accept 1 (question current next)
  (dv_all (dv_pair (dv_fact (dv_ref question "state" "current") current)
                   (dv_fact (dv_ref question "state" "stage") current)))
  (dv_pair (dv_assign (dv_ref question "state" "current") next)
           (dv_assign (dv_ref question "state" "stage") next)))

; 可习得命题.story:74-88: helper testimony is received through a co-located action.
; Concrete testimony and its evidential source are supplied by content, not this law.
(axiom c1_meeting 1 (requester speaker room)
  (dv_all (dv_pair (dv_fact (dv_ref requester "state" "location") room)
                   (dv_fact (dv_ref speaker "state" "location") room)))
  (rt_list))

; 场面/05_声路与交谈.story:13, sound_test.003; explicit formal action marker.
; This marker does not simulate acoustic bands or infer unheard sound contents.
(axiom c1_sound_trial 1 (actor ritual room)
  (dv_fact (dv_ref actor "state" "location") room)
  (dv_single (dv_assign (dv_ref ritual "state" "sound_trial_done") true)))

; Shared defeasible rule. The caller adopts it openly into each person's policy.
; Provenance: design §4.2/§4.7 and the user's explicit 2026-10-12 pragmatic choice.
; Each speaker/listener's opening .003 supplies their own empty school recall.
; Initial school-memory absence is not a physical duration fact.
(defn c1_short_stay_rule (knowledge question memory basis)
  (dv_with (dv_with (dv_with (dv_with (dv_with (dv_with (dv_with
    (dv_m4 "id" "short_stay" "cue" "short_stay"
      "premise" (dv_all (dv_pair
        (dv_fact (dv_ref question "state" "awake_scope") true)
        (dv_fact (dv_ref memory "state" "empty_school_recall") true)))
      "proposition" (dv_fact (dv_ref knowledge "state" "short_stay") true))
    "prior" 0.6) "basis" basis) "source_scope" "awake_self") "target_scope" "body_history")
    "scope_bridge" (dv_m2 "op" "constant" "value" "unknown"))
    "available_when" (dv_true))
    "withdraw_when" (dv_not (dv_all (dv_list3
      (dv_not (dv_fact (dv_ref knowledge "state" "familiar") true))
      (dv_not (dv_fact (dv_ref knowledge "state" "long_residence_traces") true))
      (dv_not (dv_fact (dv_ref knowledge "state" "replay_reason_complete") true)))))))

; The speaker's own memory-object handling and audible-channel knowledge are basis.
; No constructor argument is a real listener mind or a real listener policy.
; Scope-check capability is an uncertain estimate, never asserted as listener fact.
(defn c1_opening_listener_model (listener scope_check_estimate basis)
  (let (mind (dv_world (rt_cat "opening-listener-model-" listener) "mind" listener)
        assumption (dv_m3 "kind" "provisional-model-assumption" "scope_reference_check" scope_check_estimate "basis" basis))
    (do
      (dv_require (rt_lt 0 (rt_count basis)) "Listener model needs speaker-owned handling/channel basis")
      (set mind (dv_add_object mind (dv_object "question" "perceived" (dv_single (dv_pair "state" (rt_list))))))
      (set mind (dv_add_object mind (dv_object "cognition" "perceived" (dv_single (dv_pair "state" (rt_list))))))
      (set mind (dv_add_object mind (dv_object "memory" "perceived" (dv_single (dv_pair "state"
        (dv_single (dv_pair "empty_school_recall" (dv_cell true 0.6 0 (dv_single (dv_m2 "model_source" "speaker-owned-memory-handling" "basis" basis))))))))))
      (dv_with (dv_with (dv_with (dv_m4 "mind" mind
        "policy" (dv_m3 "scope_reference_check" scope_check_estimate "implicature_threshold" 0.5
          "implicature_bridges" (dv_single (c1_short_stay_rule "cognition" "question" "memory" basis)))
        "basis" basis "model_status" "provisional") "assumptions" (dv_single assumption))
        "uncertainty_cost" 1) "domain" "speaker-owned-prediction-model"))))

; Native chapter authorship: named worlds, characters, actions and structured speech.
; Old .story files are read-only provenance. This module never parses their serialized format.
(defn c1_source (path line id) (dv_m3 "path" path "line" line "id" id))
(defn c1_knowledge (atom) (dv_ref "cognition" "state" atom))
(defn c1_at (actor room) (dv_fact (dv_ref actor "state" "location") room))
(defn c1_local_object (id) (dv_object id "perceived" (dv_m2 "state" (rt_list) "identity" (rt_list))))
(defn c1_state_object (id fields) (dv_object id "physical" (dv_m2 "state" fields "identity" (rt_list))))
(defn c1_action (id kind known physical law grants source)
 (dv_with (dv_with (dv_with (dv_m4 "id" id "kind" kind "precondition" known "authority_precondition" physical)
  "law" law) "grants" grants) "source_refs" (dv_single source)))
(defn c1_public_methods (actions)
 (let (result (rt_list) n 0)
  (do (while (rt_lt n (rt_count actions))
   (do (rt_push result (c1_public_method (rt_at actions n))) (set n (rt_add n 1)))) result)))
(defn c1_public_method (action)
 (let (method (dv_with (dv_with action "purpose_refs" (dv_get action "grants")) "purpose_basis" (dv_get action "source_refs"))
       kind (dv_get action "kind"))
  (if (rt_eq kind "answer")
   (dv_with method "topic" (c1_answer_topic (dv_get action "answer_id")))
   (if (dv_or (rt_eq kind "move") (rt_eq kind "replay")) (dv_with method "repeatable" true) method))))
(defn c1_answer_topic (id)
 (if (rt_eq id "me") "identity"
  (if (dv_or (rt_eq id "V3_0") (rt_eq id "V3_1")) "voice_source"
   (if (dv_or (rt_eq id "V4_0") (rt_eq id "V4_1")) "words"
    (if (rt_eq id "trust") "trust" "auxiliary")))))
(defn c1_once (action) (dv_with action "once" true))
(defn c1_observe_as (action source origin trust)
 (dv_with (dv_with (dv_with action "observation_source" source) "observation_origin" origin) "observation_trust" trust))
(defn c1_method (name law) (dv_instance name law))
(defn c1_vector (time) (dv_m3 "time" time "computation" 1 "stamina" 0))
(defn c1_cost (time source) (dv_with (dv_m3 "minimum" (c1_vector time) "maximum" (c1_vector time) "actual" (c1_vector time)) "source_refs" (dv_single source)))


(defn c1_list_4 (p0 p1 p2 p3) (let (list (rt_list)) (do (rt_push list p0) (rt_push list p1) (rt_push list p2) (rt_push list p3) list)))

