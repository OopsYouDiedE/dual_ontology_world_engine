 (dv_pair "hall" "pantry") (dv_pair "hall" "foyer")))


(defn c1_inspect_E1 (actor)
 (c1_once (c1_action (rt_cat actor ".inspect.E1") "inspect"
  (c1_at actor "foyer") (c1_at actor "foyer") ""
  (dv_single (c1_knowledge "bolt_down")) (c1_source "godot_csharp/scenes/Awakening/Script/story/第一章/可习得命题.story" 69 "E1"))))

(defn c1_visible_E1 () "门内侧的插闩落在闩槽里。\n门外侧另有一道横闩，从这一侧拉不动。\n门上的猫眼，玻璃外侧糊满烟灰，看出去一片黑。\n门内侧压着一张泛黄的旧纸，题头是导师的《事故隔离规程》，角上盖着褪色的红印；纸色和笔迹都不同于新抄的《学园守则》。\n旧纸写着：泄漏后，各寝区的隔离门从外侧落闩。查明本区事故经过，由当值者向铜口陈述前，不得开启。\n末行另写：急病者可经铜口呼叫转移。")

(defn c1_inspect_E2 (actor)
 (c1_once (c1_action (rt_cat actor ".inspect.E2") "inspect"
  (c1_at actor "foyer") (c1_at actor "foyer") ""
  (dv_single (c1_knowledge "ash_wedge")) (c1_source "godot_csharp/scenes/Awakening/Script/story/第一章/可习得命题.story" 70 "E2"))))

(defn c1_visible_E2 () "门内地面铺着一片扇形的灰，窄端贴着门缝，向门厅里散开。\n东南墙角躺着一枚木楔：上面一层灰，底面干净。楔尖有新的磨痕。\n门底边有一道擦痕。")

(defn c1_inspect_E3 (actor)
 (c1_once (c1_action (rt_cat actor ".inspect.E3") "inspect"
  (c1_at actor "foyer") (c1_at actor "foyer") ""
  (dv_single (c1_knowledge "boots_toward_bolt")) (c1_source "godot_csharp/scenes/Awakening/Script/story/第一章/可习得命题.story" 71 "E3"))))

(defn c1_visible_E3 () "灰上有一枚马球靴印，踩得很清楚。\n鞋尖朝着门侧的插闩。\n鞋跟一端被什么东西压过。")

(defn c1_inspect_E4 (actor)
 (c1_once (c1_action (rt_cat actor ".inspect.E4") "inspect"
  (c1_at actor "foyer") (c1_at actor "foyer") ""
  (dv_single (c1_knowledge "cloth_after_boots")) (c1_source "godot_csharp/scenes/Awakening/Script/story/第一章/可习得命题.story" 72 "E4"))))

(defn c1_visible_E4 () "一条拧过的湿抹布，沿门底压成一条直线，正好贴着闭合的门。\n布的一端压住了靴印的鞋跟边缘。")

(defn c1_inspect_E5 (actor)
 (c1_once (c1_action (rt_cat actor ".inspect.E5") "inspect"
  (c1_at actor "foyer") (c1_at actor "foyer") ""
  (dv_single (c1_knowledge "fork_dent")) (c1_source "godot_csharp/scenes/Awakening/Script/story/第一章/可习得命题.story" 73 "E5"))))

(defn c1_visible_E5 () "地上一把纯银音叉，柄上刻着“S.L.”。\n门框齐肩高的地方，有一个很小的凹痕。")

(defn c1_inspect_E6 (actor)
 (c1_once (c1_action (rt_cat actor ".inspect.E6") "inspect"
  (c1_at actor "R08") (c1_at actor "R08") ""
  (dv_pair (c1_knowledge "score_partial") (c1_knowledge "score_in_room")) (c1_source "godot_csharp/scenes/Awakening/Script/story/第一章/可习得命题.story" 74 "E6"))))

(defn c1_visible_E6 () "一页手写乐谱，只有一小节。\n前两拍是弱音，各记着一个问号；后两拍重读，字是“开门”。同样的一小节记了两遍。\n旁注：“门外？”\n下方换了一种墨迹：“他们关了门。”")

(defn c1_inspect_E7 (actor)
 (c1_once (c1_action (rt_cat actor ".inspect.E7") "inspect"
  (c1_at actor "hall") (c1_at actor "hall") ""
  (dv_single (c1_knowledge "slate_marks")) (c1_source "godot_csharp/scenes/Awakening/Script/story/第一章/可习得命题.story" 75 "E7"))))

(defn c1_visible_E7 () "一块小石板，粉笔速记两行。\n第一行：G：⊥门 ✕开 ◎\n第二行：一个小小的放大镜图样，后面是“⊥✓”。")

(defn c1_inspect_E8 (actor)
 (c1_once (c1_action (rt_cat actor ".inspect.E8") "inspect"
  (c1_at actor "hall") (c1_at actor "hall") ""
  (dv_single (c1_knowledge "pipe_layout")) (c1_source "godot_csharp/scenes/Awakening/Script/story/第一章/可习得命题.story" 76 "E8"))))

(defn c1_visible_E8 () "铜口嵌在活动厅北墙上，下方铜牌刻着一个符号：◎。\n一根铜管从铜口后面出来：一路沿北墙向西，穿墙进门厅，贴着墙下到隔离门的门框；另一路向东，钻进活动厅与 R-08 之间的墙里。\n那道墙上与门框北侧各有一个管接头，一碰就晃——接口松了。")

(defn c1_inspect_E9 (actor)
 (c1_once (c1_action (rt_cat actor ".inspect.E9") "inspect"
  (c1_at actor "pantry") (c1_at actor "pantry") ""
  (dv_single (c1_knowledge "cups_preferences")) (c1_source "godot_csharp/scenes/Awakening/Script/story/第一章/可习得命题.story" 77 "E9"))))

(defn c1_visible_E9 () "水槽里四只用过的杯子，各不相同：\n一只青瓷小杯，杯底没有糖渍；\n一只刻着 H 的凹痕锡杯，杯底一层厚糖渍；\n一只缺口白杯；\n一只粗瓷大杯。")

(defn c1_inspect_E10 (actor)
 (c1_once (c1_action (rt_cat actor ".inspect.E10") "inspect"
  (c1_at actor "pantry") (c1_at actor "pantry") ""
