// Native first-chapter content for the three other dormitory groups.
// Personal perception, authority history, fallible hypotheses, literal answer and motive hypotheses
// occupy separate fields. No .story loader, answer grants, forced adoption or fixed route.
// This module does not give these people the living-wing broadcast.
// Prior strengths from old authorship remain provenance, not new personality weights.
// c1_other_group_extend installs content; source catalog data alone never completes an action.

fn c1_other_people():
    var result = []
    rt_push(result, {"id": "quer", "name": "雀儿", "group": "contract", "desire": "一个不会赶她走的地方", "initial_surface": "门。门闩在外面。", "material_surface": "袋子还在，口扎得死紧。我的结。", "intention_surface": "先看看那道门闩。", "memory_surface": "怎么来的？上船，然后……不知道。", "memory_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 47, "opening_quer.003"), "initial_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 46, "opening_quer.002"), "material_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 48, "opening_quer.004"), "desire_source": c1_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/07_雀儿.story", 10, "quer.desire")})
    rt_push(result, {"id": "lucian", "name": "卢西安", "group": "contract", "desire": "言灵的完美韵律", "initial_surface": "嘴边有一句诗，念到一半，韵脚找不着了。", "material_surface": "桌上的笔记是我的字，比平时潦草。", "intention_surface": "先找那个韵。", "memory_surface": "上船之后呢？也找不着了。", "memory_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 31, "opening_lucian.003"), "initial_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 30, "opening_lucian.002"), "material_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 32, "opening_lucian.004"), "desire_source": c1_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/05_卢西安.story", 10, "lucian.desire")})
    rt_push(result, {"id": "ward", "name": "沃德", "group": "contract", "desire": "成为定规则的人", "initial_surface": "纸。笔。都在桌上。", "material_surface": "笔尖是新削的。", "intention_surface": "从现在开始记。", "memory_surface": "上船以后的事，一个字也没有记下。这不像我。", "memory_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 55, "opening_ward.003"), "initial_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 54, "opening_ward.002"), "material_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 56, "opening_ward.004"), "desire_source": c1_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/08_沃德.story", 10, "ward.desire")})
    rt_push(result, {"id": "gu", "name": "顾平章", "group": "contract", "desire": "读通古代铭文", "initial_surface": "老花镜搁在枕边，镜片上溅了一点墨。", "material_surface": "枕边这摞拓片，是哪里的碑？", "intention_surface": "先把镜片擦干净。", "memory_surface": "老朽记得上了船。再往后，就记不起了。", "memory_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 39, "opening_gu.003"), "initial_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 38, "opening_gu.002"), "material_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 40, "opening_gu.004"), "desire_source": c1_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/06_顾平章.story", 10, "gu.desire")})
    rt_push(result, {"id": "ruan", "name": "阮清月", "group": "astral", "desire": "赢下与恶魔的对局", "initial_surface": "枕边一枚黑子，凉的。", "material_surface": "桌上一盘棋下到中盘。轮到黑走。我记不起这一手要下在哪。", "intention_surface": "先不下。", "memory_surface": "上船，然后是一段空白。", "memory_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 71, "opening_ruan.003"), "initial_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 70, "opening_ruan.002"), "material_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 72, "opening_ruan.004"), "desire_source": c1_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/10_阮清越.story", 10, "ruan.desire")})
    rt_push(result, {"id": "elena", "name": "伊莲娜", "group": "astral", "desire": "治好脚踝，查明仪式真相", "initial_surface": "左脚踝缠着绷带。一动，疼得眼前发白。", "material_surface": "脚尖自己绷了一下，像要起步。", "intention_surface": "别站。再躺一会儿。", "memory_surface": "我是怎么伤的？只记得上船。", "memory_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 79, "opening_elena.003"), "initial_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 78, "opening_elena.002"), "material_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 80, "opening_elena.004"), "desire_source": c1_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/11_伊莲娜.story", 10, "elena.desire")})
    rt_push(result, {"id": "selma", "name": "赛尔玛", "group": "astral", "desire": "为源质这一新物种定名", "initial_surface": "窗台上一盆苗，没见过，叶背亮得像抹了油。", "material_surface": "本子上画着这片叶子，编号那一栏空着。我画的，我没编。", "intention_surface": "查看叶子和本子。", "memory_surface": "船靠岸了吗？想不起来。", "memory_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 63, "opening_selma.003"), "initial_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 62, "opening_selma.002"), "material_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 64, "opening_selma.004"), "desire_source": c1_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/09_赛尔玛.story", 10, "selma.desire")})
    rt_push(result, {"id": "moran", "name": "莫兰", "group": "astral", "desire": "看见更多的以太色层", "initial_surface": "窗光是灰的。灰底下，还有一层很淡的绿。", "material_surface": "速写本摊着，炭笔滚在手边。", "intention_surface": "那层绿要散了。", "memory_surface": "船……之后是白的。", "memory_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 87, "opening_moran.003"), "initial_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 86, "opening_moran.002"), "material_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 88, "opening_moran.004"), "desire_source": c1_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/12_莫兰.story", 10, "moran.desire")})
    rt_push(result, {"id": "mora", "name": "茉拉", "group": "logistics", "desire": "不再失去病人", "initial_surface": "药包。……在。", "material_surface": "围裙兜里有半卷绷带。", "intention_surface": "外面有人咳嗽。", "memory_surface": "上船以后的事，想不起来。", "memory_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 119, "opening_mora.003"), "initial_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 118, "opening_mora.002"), "material_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 120, "opening_mora.004"), "desire_source": c1_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/16_茉拉.story", 10, "mora.desire")})
    rt_push(result, {"id": "bertrand", "name": "贝尔特朗", "group": "logistics", "desire": "护住平民同伴", "initial_surface": "手先摸到床边的提灯。灯油还有半截。", "material_surface": "左肩的皮垫磨亮了。那是托枪的地方，可枪不在。", "intention_surface": "门外有动静。", "memory_surface": "上船。然后就是这间屋子。中间缺了一段。", "memory_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 103, "opening_bertrand.003"), "initial_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 102, "opening_bertrand.002"), "material_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 104, "opening_bertrand.004"), "desire_source": c1_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/14_贝尔特朗.story", 10, "bertrand.desire")})
    rt_push(result, {"id": "veronica", "name": "维罗妮卡", "group": "logistics", "desire": "独立研究，证明理化能解释一切", "initial_surface": "一股试剂味，很淡，像是乙醚挥发过。", "material_surface": "器具都在架上，摆得比我习惯的还整齐。谁替我摆的？", "intention_surface": "先查瓶签。", "memory_surface": "最后记得的事：上船。之后的，一件也想不起来。", "memory_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 95, "opening_veronica.003"), "initial_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 94, "opening_veronica.002"), "material_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 96, "opening_veronica.004"), "desire_source": c1_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/13_维罗妮卡.story", 10, "veronica.desire")})
    rt_push(result, {"id": "margaret", "name": "玛格丽特", "group": "logistics", "desire": "亲手建成、被人承认", "initial_surface": "天花板的梁是斜搭的。这跨度，搭得有点悬。", "material_surface": "卷尺和铅垂还挂在腰上，睡觉都没解。", "intention_surface": "先看看这屋子承不承得住。", "memory_surface": "我记得上船。之后的事，一点也想不起来。", "memory_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 111, "opening_margaret.003"), "initial_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 110, "opening_margaret.002"), "material_source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 112, "opening_margaret.004"), "desire_source": c1_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/15_玛格丽特.story", 10, "margaret.desire")})
    return result

fn c1_other_person(id):
    var rows = c1_other_people()
    var i = 0
    while (i < rt_count(rows)):
        if (rows[i].id == id):
            return rows[i]
        i = (i + 1)
    dv_require(false, "Unknown chapter-one other-group actor")
    return false

fn c1_other_case(group):
    if (group == "contract"):
        return {"id": "contract", "room": "dorm.contract", "zone": "甲区", "prompt": "名录库的柜锁，是谁打开的？", "options": ["quer", "ward", "gu", "lucian"], "reason_options": ["authorized_transfer", "theft"], "reason_surfaces": ["受命转移文书", "私自行窃"], "authority_actor": "quer", "authority_reason": "authorized_transfer", "earliest_exit_minute": 540, "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 9, "文契"), "outside_evidence_surface": "规程页的红墨批注“授钥：雀”，锁芯与钥匙齿都没有撬痕", "outside_evidence_scope": "chapter2-only-not-installed"}
    if (group == "astral"):
        return {"id": "astral", "room": "dorm.astral", "zone": "丙区", "prompt": "是谁让一个人留在了沉静室里？", "options": ["ruan", "selma", "moran"], "reason_options": ["self_preservation", "requested_closure"], "reason_surfaces": ["阮清月弃人自保", "伊莲娜示意关门"], "authority_actor": "ruan", "authority_reason": "requested_closure", "earliest_exit_minute": 1800, "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 28, "星仪"), "outside_evidence_surface": "莫兰撕下的那页速写：伊莲娜在门内抬手示意；沉静室门内的步位标线一道不乱", "outside_evidence_scope": "chapter2-only-not-installed"}
    if (group == "logistics"):
        return {"id": "logistics", "room": "dorm.logistics", "zone": "丁区", "prompt": "白塔柜里那瓶试剂，是谁取走的？", "options": ["veronica", "mora", "bertrand", "margaret"], "reason_options": ["experiment", "wound_cleaning"], "reason_surfaces": ["拿人做实验", "清洗伤口"], "authority_actor": "veronica", "authority_reason": "wound_cleaning", "earliest_exit_minute": 2130, "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 45, "后勤"), "outside_evidence_surface": "贝尔特朗前臂的新疤，试剂瓶残量与清洗用量吻合", "outside_evidence_scope": "chapter2-only-not-installed"}
    dv_require(false, "Unknown chapter-one dormitory group")
    return false

fn c1_other_traces(group):
    var result = []
    if (group == "contract"):
        rt_push(result, {"id": "wet_rubbing", "surface": "顾平章的拓片墨迹未干。", "excluded_actor": "gu", "needs_actual_witness": false, "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 18, "拓片墨未干")})
    if (group == "contract"):
        rt_push(result, {"id": "continuous_manuscript", "surface": "卢西安的手稿写满三页，墨迹连贯。", "excluded_actor": "lucian", "needs_actual_witness": false, "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 19, "手稿写满三页")})
    if (group == "contract"):
        rt_push(result, {"id": "lock_checklist", "surface": "沃德的柜锁清单上压着笔痕，写的是记录。", "excluded_actor": "ward", "needs_actual_witness": false, "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 20, "清单上的笔痕")})
    if (group == "astral"):
        rt_push(result, {"id": "continuous_specimen_notes", "surface": "赛尔玛的标本笔记一条接一条，时刻连着。", "excluded_actor": "selma", "needs_actual_witness": false, "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 37, "标本笔记不断")})
    if (group == "astral"):
        rt_push(result, {"id": "remaining_sketches", "surface": "莫兰的速写本撕掉了一页，剩下的都是共鸣厅里的人，没有门。", "excluded_actor": "moran", "needs_actual_witness": false, "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 38, "速写本缺页")})
    if (group == "logistics"):
        rt_push(result, {"id": "sealed_medicine", "surface": "茉拉药包的封条完好。", "excluded_actor": "mora", "needs_actual_witness": false, "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 54, "药包封条完好")})
    if (group == "logistics"):
        rt_push(result, {"id": "lamp_and_no_reagent", "surface": "玛格丽特的提灯灯油耗了一半，手上没有试剂味。", "excluded_actor": "margaret", "needs_actual_witness": false, "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 55, "提灯油耗一半")})
    if (group == "logistics"):
        rt_push(result, {"id": "matching_lamps", "surface": "两盏提灯的灯油耗相同。", "excluded_actor": "bertrand", "needs_actual_witness": true, "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 56, "两盏灯互证")})
    return result

fn c1_other_ref(group, field):
    return dv_ref(rt_cat("case.", group), "state", field)

fn c1_other_claim(group, field):
    return dv_fact(c1_other_ref(group, field), true)

fn c1_other_identity(group, actor):
    return c1_other_claim(group, rt_cat("answer.", actor))

// These old-source trace/actor associations are defeasible personal hypotheses.
// No inference law writes an exclusion or an answer merely from ink, a drawing,
// a seal, smell, or equal lamp consumption. Contrary personal evidence revises
// them through the shared hypothesis selector.
fn c1_other_exclusion_hypotheses(id):
    let person = c1_other_person(id)
    let spec = c1_other_case(person.group)
    let traces = c1_other_traces(person.group)
    var result = []
    var i = 0
    while i < rt_count(traces):
        let trace = traces[i]
        let observed = c1_other_claim(person.group, rt_cat("trace.", trace.id))
        let proposition = dv_not(c1_other_identity(person.group, trace.excluded_actor))
        var available = dv_all(dv_pair(c1_other_claim(person.group, "open"), observed))
        if trace.needs_actual_witness:
            available = dv_all(dv_pair(available, c1_other_claim(person.group, "mutual_witness_received")))
        rt_push(result, {"id": rt_cat(rt_cat(id, ".exclusion."), trace.id), "question": rt_cat(person.group, ".identity"), "group": rt_cat(person.group, ".identity"), "proposition": proposition, "prior": 0.5, "available_when": available, "basis": [trace.source], "kind": "fallible-trace-heuristic", "observed_premise": observed, "scope": "present-material-to-past-activity", "missing_support": "independent-event-time-or-personal-witness", "established": false})
        i = i + 1
    return result

axiom c1_other_question_open(group):
    var effects = dv_pair(dv_assign(c1_other_ref(group, "open"), true), dv_assign(c1_other_ref(group, "current"), rt_cat(group, ".identity")))
    var people = c1_other_people()
    var i = 0
    while (i < rt_count(people)):
        if (people[i].group == group):
            rt_push(effects, dv_assign(dv_ref(rt_cat("personal.", people[i].id), "state", "current"), rt_cat(group, ".identity")))
        i = (i + 1)
    return dv_axiom(rt_cat("c1_other_question_open.", group), 1, dv_fact(c1_other_ref(group, "open"), false), effects)

axiom c1_other_accept(group, actor):
    return dv_axiom(rt_cat(rt_cat("c1_other_accept.", group), rt_cat(".", actor)), 1, c1_other_claim(group, "open"), dv_list3(dv_assign(c1_other_ref(group, rt_cat("receipt.", actor)), true), dv_assign(c1_other_ref(group, rt_cat("level.", actor)), 1), dv_assign(dv_ref(rt_cat("personal.", actor), "state", "current"), rt_cat(group, ".reason"))))

// Clock is a real session-owned field, supplied by the calling integration.
// No constructor sets it to the deadline or advances it to manufacture release.
axiom c1_other_release(group, clock_ref):
    var people = c1_other_people()
    var required = dv_pair(dv_at_least(clock_ref, c1_other_case(group).earliest_exit_minute), dv_fact(c1_other_access_ref(group), true))
    var i = 0
    while (i < rt_count(people)):
        if (people[i].group == group):
            rt_push(required, c1_other_claim(group, rt_cat("receipt.", people[i].id)))
        i = (i + 1)
    return dv_axiom(rt_cat("c1_other_release.", group), 1, dv_all(required), dv_single(dv_assign(c1_other_ref(group, "outer_latch_released"), true)))

fn c1_other_open_action(group, speaker):
    var spec = c1_other_case(group)
    var action = c1_once(c1_action(rt_cat("other.question.", group), "question", c1_at(speaker, "hall"), dv_all(dv_pair(c1_at(speaker, "hall"), dv_fact(c1_other_ref(group, "open"), false))), rt_cat("other.open.", group), [], spec.source))
    var speech = dv_with_many(c1_speech(dv_true(), spec.source, "group-question-not-an-asserted-answer"), {"surface": rt_cat("铜口里传来声音：", spec.prompt), "utterance_type": "question", "channel": rt_cat("copper.", group)})
    var listeners = []
    var grants = dv_pair(c1_other_ref(group, "open"), c1_other_ref(group, "current"))
    var people = c1_other_people()
    var i = 0
    while (i < rt_count(people)):
        if (people[i].group == group):
            rt_push(listeners, people[i].id)
            rt_push(grants, dv_ref(rt_cat("personal.", people[i].id), "state", "current"))
        i = (i + 1)
    return dv_with(dv_with(dv_with(dv_with(action, "speech", speech), "listeners", listeners), "public_grants", grants), "purpose_refs", dv_single(c1_other_ref(group, "open")))

fn c1_other_inspections(id):
    var person = c1_other_person(id)
    var spec = c1_other_case(person.group)
    var rows = c1_other_traces(person.group)
    var result = []
    var i = 0
    while (i < rt_count(rows)):
        var row = rows[i]
        var ref = c1_other_ref(person.group, rt_cat("trace.", row.id))
        var action = c1_once(c1_action(rt_cat(rt_cat(id, ".inspect."), row.id), "inspect", c1_at(id, spec.room), c1_at(id, spec.room), "", dv_single(ref), row.source))
        rt_push(result, dv_with(action, "surface", row.surface))
        i = (i + 1)
    var own_ref = dv_ref(rt_cat("personal.", id), "state", "material_detail")
    rt_push(result, dv_with(c1_once(c1_action(rt_cat(id, ".inspect.own-material"), "inspect", c1_at(id, spec.room), c1_at(id, spec.room), "", dv_single(own_ref), person.material_source)), "surface", person.material_surface))
    return result

fn c1_other_answer_actions(id):
    var person = c1_other_person(id)
    var spec = c1_other_case(person.group)
    var result = []
    var i = 0
    while (i < rt_count(spec.options)):
        var option = spec.options[i]
        var answer = c1_other_identity(person.group, option)
        var action_id = rt_cat(rt_cat(rt_cat(id, ".answer."), person.group), rt_cat(".", option))
        var known = dv_all(dv_list3(c1_at(id, spec.room), c1_other_claim(person.group, "open"), answer))
        var action = c1_action(action_id, "answer", known, known, "", [], spec.source)
        var speech = dv_with(c1_speech(answer, spec.source, "literal-actor-only-not-motive"), "surface", rt_cat(c1_other_person(option).name, "。我依据的是我们在这里核对过的痕迹。"))
        rt_push(result, dv_with_many(action, {"answer": answer, "answer_id": action_id, "topic": rt_cat(person.group, ".identity"), "speech": dv_with(speech, "channel", rt_cat("copper.", person.group)), "listeners": dv_single("demon"), "authority_precondition": dv_all(dv_list3(c1_at(id, spec.room), c1_other_claim(person.group, "open"), c1_at("demon", "hall"))), "purpose_refs": dv_single(c1_other_ref(person.group, rt_cat("receipt.", id)))}))
        i = (i + 1)
    return result

fn c1_other_formal_answers():
    var people = c1_other_people()
    var result = []
    var i = 0
    while (i < rt_count(people)):
        var person = people[i]
        var spec = c1_other_case(person.group)
        var j = 0
        while (j < rt_count(spec.options)):
            var option = spec.options[j]
            var literal = c1_other_identity(person.group, option)
            var id = rt_cat(rt_cat(rt_cat(person.id, ".answer."), person.group), rt_cat(".", option))
            rt_push(result, {"id": id, "stage": rt_cat(person.group, ".identity"), "condition": literal, "required_support": literal, "question_match": c1_other_claim(person.group, "open"), "answer_complete": literal, "require_argument": false, "accepted_law": rt_cat(rt_cat("other.accept.", person.group), rt_cat(".", person.id)), "progress_ref": c1_other_ref(person.group, rt_cat("level.", person.id)), "completion_ref": c1_other_ref(person.group, rt_cat("receipt.", person.id)), "accepted_listeners": dv_single(person.id), "accepted_public_grants": dv_list3(c1_other_ref(person.group, rt_cat("receipt.", person.id)), c1_other_ref(person.group, rt_cat("level.", person.id)), dv_ref(rt_cat("personal.", person.id), "state", "current")), "source_refs": dv_single(spec.source)})
            j = (j + 1)
        i = (i + 1)
    return result

fn c1_other_preconception(id):
    if (id == "ward"):
        return {"preferred": "theft", "source_strength": 3, "basis": dv_single(c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 22, "ward.preconception")), "kind": "authored-preconception-not-evidence"}
    if (id == "gu"):
        return {"preferred": "theft", "source_strength": 1, "basis": dv_single(c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 23, "gu.preconception")), "kind": "authored-preconception-not-evidence"}
    if (id == "lucian"):
        return {"preferred": "authorized_transfer", "source_strength": 1, "basis": dv_single(c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 24, "lucian.preconception")), "kind": "authored-preconception-not-evidence"}
    if (id == "elena"):
        return {"preferred": "self_preservation", "source_strength": 3, "basis": dv_single(c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 40, "elena.preconception")), "kind": "authored-preconception-not-evidence"}
    if (id == "selma"):
        return {"preferred": "self_preservation", "source_strength": 1, "basis": dv_single(c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 41, "selma.preconception")), "kind": "authored-preconception-not-evidence"}
    if (id == "mora"):
        return {"preferred": "experiment", "source_strength": 3, "basis": dv_single(c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 58, "mora.preconception")), "kind": "authored-preconception-not-evidence"}
    if (id == "bertrand"):
        return {"preferred": "experiment", "source_strength": 1, "basis": dv_single(c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 59, "bertrand.preconception")), "kind": "authored-preconception-not-evidence"}
    return false

fn c1_other_reason_hypotheses(id):
    var person = c1_other_person(id)
    var spec = c1_other_case(person.group)
    var bias = c1_other_preconception(id)
    var options = spec.reason_options
    var ordered = []
    var i = 0
    if (not (bias == false)):
        rt_push(ordered, bias.preferred)
    while (i < rt_count(options)):
        if (not dv_has(ordered, options[i])):
            rt_push(ordered, options[i])
        i = (i + 1)
    var result = []
    i = 0
    while (i < rt_count(ordered)):
        var option = ordered[i]
        var basis = dv_single(spec.source)
        if (not (bias == false)):
            if (bias.preferred == option):
                basis = bias.basis
        var proposition = c1_other_claim(person.group, rt_cat("reason.", option))
        rt_push(result, {"id": rt_cat(rt_cat(person.group, ".reason."), option), "question": rt_cat(person.group, ".reason"), "group": rt_cat(person.group, ".reason"), "proposition": proposition, "assumptions": dv_single(proposition), "prior": 0.5, "available_when": c1_other_claim(person.group, rt_cat("receipt.", id)), "basis": basis, "interpretation_scope": "motive-separate-from-accepted-literal-actor", "source_preconception": bias})
        i = (i + 1)
    return result

fn c1_other_mind(id):
    var person = c1_other_person(id)
    var spec = c1_other_case(person.group)
    var mind = dv_with(dv_world(rt_cat("mind.", id), "mind", id), "time", 480)
    mind = dv_add_object(mind, c1_position(id, spec.room))
    mind = dv_add_object(mind, c1_local_object(rt_cat("case.", person.group)))
    var people = c1_other_people()
    var peer_index = 0
    while (peer_index < rt_count(people)):
        if (people[peer_index].group == person.group):
            mind = dv_add_object(mind, c1_local_object(rt_cat("personal.", people[peer_index].id)))
        peer_index = (peer_index + 1)
    mind = dv_add_object(mind, c1_state_object("memory", dv_single(dv_pair("empty_school_recall", dv_with(dv_field(true), "basis", dv_single(person.memory_source))))))
    mind = dv_store(mind, dv_ref(rt_cat("personal.", id), "state", "initial_surface"), dv_with(dv_field(person.initial_surface), "basis", dv_single(person.initial_source)))
    return mind

fn c1_other_policy(id):
    var person = c1_other_person(id)
    var spec = c1_other_case(person.group)
    var goals = []
    var i = 0
    while (i < rt_count(spec.options)):
        rt_push(goals, {"kind": "know", "question": rt_cat(person.group, ".identity"), "ref": c1_other_ref(person.group, rt_cat("answer.", spec.options[i])), "available_when": c1_other_claim(person.group, "open"), "basis": dv_single(spec.source)})
        i = (i + 1)
    rt_push(goals, {"kind": "know", "question": rt_cat(person.group, ".identity"), "ref": c1_other_ref(person.group, rt_cat("receipt.", id)), "available_when": c1_other_claim(person.group, "open"), "basis": dv_single(spec.source)})
    rt_push(goals, {"kind": "know", "question": "own_material", "ref": dv_ref(rt_cat("personal.", id), "state", "material_detail"), "basis": dv_pair(person.material_source, person.desire_source)})
    var hypotheses = c1_other_exclusion_hypotheses(id)
    var reasons = c1_other_reason_hypotheses(id)
    i = 0
    while (i < rt_count(reasons)):
        rt_push(hypotheses, reasons[i])
        i = (i + 1)
    return dv_with_many(c1_player_policy(), {"hypotheses": hypotheses, "goals": goals, "desire": {"surface": person.desire, "basis": dv_single(person.desire_source), "fulfillment": "not-asserted"}, "notice_co_presence": true, "topic_bindings": dv_pair({"topic": "own_material", "heard_when": dv_true(), "completed_when": dv_not(dv_true()), "basis": dv_single(person.material_source)}, {"topic": rt_cat(person.group, ".reason"), "heard_when": c1_other_claim(person.group, rt_cat("receipt.", id)), "completed_when": dv_not(dv_true()), "basis": dv_single(spec.source)})})

fn c1_other_character(id):
    var person = c1_other_person(id)
    var actions = c1_other_inspections(id)
    var answers = c1_other_answer_actions(id)
    var i = 0
    while (i < rt_count(answers)):
        rt_push(actions, answers[i])
        i = (i + 1)
    var replies = c1_other_personal_replies(id)
    i = 0
    while (i < rt_count(replies)):
        rt_push(actions, replies[i])
        i = (i + 1)
    return {"id": id, "mind": c1_other_mind(id), "actions": actions, "policy": c1_other_policy(id), "balance": {"time": 100000, "computation": 100000, "stamina": 100000}, "location_ref": dv_ref(id, "state", "location"), "location": c1_other_case(person.group).room, "question_ref": dv_ref(rt_cat("personal.", id), "state", "current"), "dossier": person}

fn c1_other_groups_actors():
    var result = []
    var people = c1_other_people()
    var i = 0
    while (i < rt_count(people)):
        rt_push(result, c1_other_character(people[i].id))
        i = (i + 1)
    return result

// Real physical authored traces and literal history; invisible answer fields are never grants.
fn c1_other_group_extend(world, group):
    var spec = c1_other_case(group)
    var fields = {"open": dv_field(false), "current": dv_field(""), "outer_latch_released": dv_field(false)}
    var i = 0
    while (i < rt_count(spec.options)):
        fields = dv_with(fields, rt_cat("answer.", spec.options[i]), dv_field((spec.options[i] == spec.authority_actor)))
        i = (i + 1)
    i = 0
    while (i < rt_count(spec.reason_options)):
        fields = dv_with(fields, rt_cat("reason.", spec.reason_options[i]), dv_field((spec.reason_options[i] == spec.authority_reason)))
        i = (i + 1)
    var traces = c1_other_traces(group)
    i = 0
    while (i < rt_count(traces)):
        fields = dv_with(fields, rt_cat("trace.", traces[i].id), dv_field(true))
        i = (i + 1)
    var people = c1_other_people()
    i = 0
    var result = world
    while (i < rt_count(people)):
        var person = people[i]
        if (person.group == group):
            fields = dv_with(fields, rt_cat("receipt.", person.id), dv_field(false))
            fields = dv_with(fields, rt_cat("level.", person.id), dv_field(0))
            result = dv_add_object(result, c1_position(person.id, spec.room))
            result = dv_add_object(result, c1_state_object(rt_cat("personal.", person.id), {"material_detail": dv_field(person.material_surface), "current": dv_field("")}))
            result = dv_adopt(result, c1_method(rt_cat(rt_cat("other.accept.", group), rt_cat(".", person.id)), c1_other_accept(group, person.id)), "enforce", 1, dv_single(spec.source))
        i = (i + 1)
    result = dv_add_object(result, c1_state_object(rt_cat("case.", group), fields))
    return dv_adopt(result, c1_method(rt_cat("other.open.", group), c1_other_question_open(group)), "enforce", 1, dv_single(spec.source))

fn c1_other_groups_physical(world):
    return c1_other_group_extend(c1_other_group_extend(c1_other_group_extend(world, "contract"), "astral"), "logistics")

fn c1_other_groups_bindings():
    var people = c1_other_people()
    var result = []
    var i = 0
    while (i < rt_count(people)):
        var person = people[i]
        rt_push(result, dv_binding(person.id, person.id, person.id))
        rt_push(result, dv_binding(rt_cat("case.", person.group), rt_cat("case.", person.group), person.id))
        var j = 0
        while (j < rt_count(people)):
            if (people[j].group == person.group):
                rt_push(result, dv_binding(rt_cat("personal.", people[j].id), rt_cat("personal.", people[j].id), person.id))
            j = (j + 1)
        i = (i + 1)
    return result

fn c1_other_groups_question_actions(speaker):
    return dv_list3(c1_other_open_action("contract", speaker), c1_other_open_action("astral", speaker), c1_other_open_action("logistics", speaker))

fn c1_other_groups_release_laws(clock_ref):
    return dv_list3(c1_other_release("contract", clock_ref), c1_other_release("astral", clock_ref), c1_other_release("logistics", clock_ref))

// Personal reports quote the actor's own inspected material. They do not turn a
// handwritten page, lamp oil or familiar knot into a recovered night's memory.
fn c1_other_personal_replies(id):
    var person = c1_other_person(id)
    var ref = dv_ref(rt_cat("personal.", id), "state", "material_detail")
    var known = dv_fact(ref, person.material_surface)
    var people = c1_other_people()
    var result = []
    var i = 0
    while (i < rt_count(people)):
        var other = people[i]
        if dv_and((other.group == person.group), (not (other.id == id))):
            var action = c1_action(rt_cat(rt_cat(id, ".reply.own-material."), other.id), "talk", known, c1_at(id, c1_other_case(person.group).room), "", [], person.material_source)
            var speech = dv_with(c1_speech(known, person.material_source, "personally-inspected-material-not-night-witness"), "surface", person.material_surface)
            rt_push(result, dv_with_many(action, {"speech": speech, "listeners": dv_single(other.id), "offer_to": other.id, "response_topic": rt_cat("own_material.", id)}))
        i = (i + 1)
    return result

fn c1_other_release_action(group, speaker, clock_ref):
    var law = c1_other_release(group, clock_ref)
    var room = c1_other_case(group).room
    return dv_with(c1_action(rt_cat("other.release.", group), "other_release", dv_all(dv_pair(c1_at(speaker, room), law.premise)), dv_all(dv_pair(c1_at(speaker, room), law.premise)), rt_cat("other.release.", group), dv_single(c1_other_ref(group, "outer_latch_released")), c1_other_case(group).source), "surface", "外闩抬起。")

fn c1_other_departure_source(id):
    if (id == "lucian"):
        return {"target": "Living", "surface": "在起居厅听见乙区门里有人说话，靠在对面墙上等着", "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 8, "lucian.departure"), "source_duration": 12}
    if (id == "gu"):
        return {"target": "Living", "surface": "在起居厅北台的书架前，把认得的书脊一行行抄下来", "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 11, "gu.departure"), "source_duration": 12}
    if (id == "quer"):
        return {"target": "Living", "surface": "蹲在乙区门外看那道外闩，只看不碰", "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 14, "quer.departure"), "source_duration": 12}
    if (id == "ward"):
        return {"target": "Living", "surface": "在起居厅公告板前读规程，把本组已经核对的条款重新排清", "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 17, "ward.departure"), "source_duration": 12}
    if (id == "selma"):
        return {"target": "Greenhouse", "surface": "离开丙区到温室查看标本，把寝区观察与新环境分开记", "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 20, "selma.departure"), "source_duration": 12}
    if (id == "ruan"):
        return {"target": "Hall", "surface": "到中央厅收起棋子，核对自己能确认的物品数目", "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 23, "ruan.departure"), "source_duration": 12}
    if (id == "elena"):
        return {"target": "Hall", "surface": "离开丙区后在中央厅坐下，避开伤脚久站", "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 26, "elena.departure"), "source_duration": 12}
    if (id == "moran"):
        return {"target": "Hall", "surface": "到中央厅观察窗光，翻看刚才画出的色层", "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 29, "moran.departure"), "source_duration": 12}
    if (id == "veronica"):
        return {"target": "Logistics", "surface": "离开丁区到后勤院查看公用器具，暂不取用未知试剂", "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 32, "veronica.departure"), "source_duration": 12}
    if (id == "bertrand"):
        return {"target": "Hall", "surface": "从丁区出来巡看中央厅的通路，给后来的人留出门口", "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 35, "bertrand.departure"), "source_duration": 12}
    if (id == "margaret"):
        return {"target": "Hall", "surface": "走到中央厅把真正看见的门外尺寸补进草图", "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 38, "margaret.departure"), "source_duration": 12}
    if (id == "mora"):
        return {"target": "Clinic", "surface": "离开丁区到诊疗所清点可用敷料，预备有人求助", "source": c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 41, "mora.departure"), "source_duration": 12}
    dv_require(false, "Unknown chapter-one departure actor")
    return false

// Source-directed departure remains optional and requires actual opened-latch observation.
// The caller installs this law in physical/enforce and this person's mind/predict.
axiom c1_other_depart(id):
    var person = c1_other_person(id)
    var source = c1_other_departure_source(id)
    var premise = dv_all(dv_list3(c1_at(id, c1_other_case(person.group).room), c1_other_claim(person.group, "outer_latch_released"), dv_fact(c1_other_access_ref(person.group), true)))
    return dv_axiom(rt_cat("c1_other_depart.", id), 1, premise, dv_single(dv_assign(dv_ref(id, "state", "location"), c1_other_threshold(person.group))))

fn c1_other_departure_actions(id):
    var person = c1_other_person(id)
    var room = c1_other_case(person.group).room
    var source = c1_other_departure_source(id)
    var ref = c1_other_ref(person.group, "outer_latch_released")
    var inspect = dv_with(c1_action(rt_cat(id, ".inspect.outer-latch"), "inspect", c1_at(id, room), c1_at(id, room), "", dv_pair(ref, c1_other_access_ref(person.group)), source.source), "repeatable", true)
    var premise = dv_all(dv_list3(c1_at(id, room), dv_fact(ref, true), dv_fact(c1_other_access_ref(person.group), true)))
    var depart = dv_with_many(c1_action(rt_cat(id, ".leave-dormitory"), "other_departure", premise, premise, rt_cat("other.depart.", id), dv_single(dv_ref(id, "state", "location")), source.source), {"predict_law": rt_cat("other.depart.", id), "surface": rt_cat(c1_other_person(id).name, "离开寝区。"), "next_observation_surface": "跨过门槛，来到本寝区的门外。", "later_intention_surface": source.surface})
    depart = dv_with(depart, "personal_choice", {"group": "leave-open-dormitory", "requires": premise, "prohibits": dv_not(dv_true()), "promotes": ["leave_confinement"], "sacrifices": [], "basis": dv_single(person.initial_source)})
    return dv_pair(inspect, depart)

fn c1_other_groups_costs():
    var costs = c1_costs()
    rt_push(costs, dv_pair("other_departure", c1_cost(12, c1_other_departure_source("quer").source)))
    return costs

fn c1_other_group_listeners(group, except):
    var result = []
    var people = c1_other_people()
    var i = 0
    while i < rt_count(people):
        let person = people[i]
        if dv_and(person.group == group, person.id != except):
            rt_push(result, person.id)
        i = i + 1
    return result

fn c1_other_wake_action(id):
    let person = c1_other_person(id)
    let room = c1_other_case(person.group).room
    let literal = dv_fact(dv_ref(rt_cat("personal.", id), "state", "initial_surface"), person.initial_surface)
    let action = c1_once(c1_action(rt_cat(id, ".wake-and-introduce"), "talk", dv_all(dv_pair(c1_at(id, room), literal)), c1_at(id, room), "", [], person.initial_source))
    let text = rt_cat(person.initial_surface, rt_cat("\n", c1_other_introduction(id)))
    return dv_with_many(action, {"speech": dv_with(c1_speech(literal, person.initial_source, "own-current-perception"), "surface", text), "listeners": c1_other_group_listeners(person.group, id), "surface": text})

fn c1_other_trace_conversations(id):
    let person = c1_other_person(id)
    let spec = c1_other_case(person.group)
    let peers = c1_other_group_listeners(person.group, id)
    let traces = c1_other_traces(person.group)
    var result = []
    var i = 0
    while i < rt_count(peers):
        let peer = peers[i]
        var j = 0
        while j < rt_count(traces):
            let trace = traces[j]
            let topic = rt_cat(rt_cat(person.group, ".trace."), trace.id)
            let ref = c1_other_ref(person.group, rt_cat("trace.", trace.id))
            let literal = dv_fact(ref, true)
            let prefix = rt_cat(rt_cat(id, ".material."), rt_cat(peer, rt_cat(".", trace.id)))
            let request = dv_with_many(c1_speech(dv_true(), trace.source, "request-personal-observation"), {"surface": rt_cat(c1_other_person(peer).name, "，这件东西你查看过吗？把你看到的告诉我。"), "utterance_type": "question", "request": {"target": peer, "topic": topic}})
            rt_push(result, dv_with_many(c1_action(rt_cat(prefix, ".ask"), "talk", c1_at(id, spec.room), c1_at(id, spec.room), "", [], trace.source), {"speech": request, "listeners": dv_single(peer), "purpose_refs": dv_single(ref)}))
            let report = dv_with(c1_speech(literal, trace.source, "personally-observed-trace-not-night-witness"), "surface", trace.surface)
            rt_push(result, dv_with_many(c1_action(rt_cat(prefix, ".report"), "talk", dv_all(dv_pair(c1_at(id, spec.room), literal)), c1_at(id, spec.room), "", [], trace.source), {"speech": report, "listeners": dv_single(peer), "offer_to": peer, "response_topic": topic, "purpose_refs": dv_single(ref)}))
            j = j + 1
        i = i + 1
    return result

fn c1_other_desire_action(id):
    let person = c1_other_person(id)
    let room = c1_other_case(person.group).room
    let ref = dv_ref(rt_cat("personal.", id), "state", "material_detail")
    let action = c1_once(c1_action(rt_cat(id, ".follow-own-interest"), "inspect", c1_at(id, room), c1_at(id, room), "", dv_single(ref), person.material_source))
    return dv_with_many(action, {"surface": rt_cat(person.intention_surface, rt_cat("\n", person.material_surface)), "purpose_refs": dv_single(ref), "motive_basis": dv_single(person.desire_source)})

// Install the actual residents, their private rules and objects, copper channels,
// scoped formal questions, and answer transitions. Release/departure needs the
// campaign's real clock and access graph; this constructor never advances either.
fn c1_other_groups_install_scene(scene):
    var world = c1_other_groups_physical(scene.physical)
    let release_laws = c1_other_groups_release_laws(c1_other_clock_ref())
    var release_index = 0
    while release_index < rt_count(release_laws):
        let group = ["contract", "astral", "logistics"][release_index]
        world = dv_adopt(world, c1_method(rt_cat("other.release.", group), release_laws[release_index]), "enforce", 1, dv_single(c1_other_case(group).source))
        release_index = release_index + 1
    var actors = dv_clone(scene.actors)
    var bindings = dv_clone(scene.bindings)
    var answers = dv_clone(scene.formal_answers)
    let people = c1_other_people()
    var i = 0
    while i < rt_count(people):
        let person = people[i]
        let object = rt_cat("personal.", person.id)
        world = dv_store(world, dv_ref(object, "state", "initial_surface"), dv_field(person.initial_surface))
        var actor = c1_other_character(person.id)
        let depart_method = c1_method(rt_cat("other.depart.", person.id), c1_other_depart(person.id))
        world = dv_adopt(world, depart_method, "enforce", 1, dv_single(person.initial_source))
        var own_mind = dv_add_object(actor.mind, c1_local_object("campaign.access"))
        own_mind = dv_adopt(own_mind, depart_method, "predict", 1, dv_single(person.initial_source))
        actor = dv_with_many(actor, {"mind": own_mind, "policy": dv_with_many(actor.policy, {"value_order": ["leave_confinement", "pursue_desire"], "value_basis": dv_single(person.initial_source)})})
        rt_push(bindings, dv_binding("campaign.access", "campaign.access", person.id))
        var actions = []
        rt_push(actions, c1_other_wake_action(person.id))
        rt_push(actions, c1_other_desire_action(person.id))
        var j = 0
        while j < rt_count(actor.actions):
            if actor.actions[j].id != rt_cat(person.id, ".inspect.own-material"):
                rt_push(actions, actor.actions[j])
            j = j + 1
        let departure_actions = c1_other_departure_actions(person.id)
        j = 0
        while j < rt_count(departure_actions):
            rt_push(actions, departure_actions[j])
            j = j + 1
        rt_push(actions, c1_other_handoff_action(person.id))
        let conversations = c1_other_trace_conversations(person.id)
        j = 0
        while j < rt_count(conversations):
            rt_push(actions, conversations[j])
            j = j + 1
        let channel = rt_cat("copper.", person.group)
        let ready = c1_at(person.id, c1_other_case(person.group).room)
        actor = dv_with_many(actor, {"actions": actions, "hearing_grants": [{"speaker": "demon", "channel": channel, "available_when": ready, "sender_locations": ["hall"], "listener_locations": [c1_other_case(person.group).room], "basis": [c1_other_case(person.group).source]}], "request_channels": [{"target": "demon", "channel": channel, "available_when": ready, "basis": [c1_other_case(person.group).source]}]})
        rt_push(actors, actor)
        i = i + 1
    let local_bindings = c1_other_groups_bindings()
    i = 0
    while i < rt_count(local_bindings):
        rt_push(bindings, local_bindings[i])
        i = i + 1
    let formal = c1_other_formal_answers()
    i = 0
    while i < rt_count(formal):
        rt_push(answers, formal[i])
        i = i + 1
    var installed_actors = []
    i = 0
    while i < rt_count(actors):
        if actors[i].id == "demon":
            var demon = actors[i]
            var mind = demon.mind
            var actions = dv_clone(demon.actions)
            var hearing = dv_clone(dv_find(demon, "hearing_grants", []))
            var g = 0
            let groups = ["contract", "astral", "logistics"]
            while g < rt_count(groups):
                let group = groups[g]
                let spec = c1_other_case(group)
                mind = dv_add_object(mind, c1_state_object(rt_cat("case.", group), {"open": dv_field(false)}))
                mind = dv_adopt(mind, c1_method(rt_cat("other.open.", group), c1_other_question_open(group)), "predict", 1, dv_single(spec.source))
                rt_push(bindings, dv_binding(rt_cat("case.", group), rt_cat("case.", group), "demon"))
                let listeners = c1_other_group_listeners(group, "")
                var k = 0
                while k < rt_count(listeners):
                    rt_push(hearing, {"speaker": listeners[k], "channel": rt_cat("copper.", group), "available_when": c1_at("demon", "hall"), "sender_locations": [spec.room], "listener_locations": ["hall"], "basis": [spec.source]})
                    mind = dv_add_object(mind, c1_local_object(rt_cat("personal.", listeners[k])))
                    k = k + 1
                rt_push(actions, c1_other_open_action(group, "demon"))
                g = g + 1
            rt_push(installed_actors, dv_with_many(demon, {"mind": mind, "actions": actions, "hearing_grants": hearing}))
        else:
            rt_push(installed_actors, actors[i])
        i = i + 1
    return dv_with_many(scene, {"physical": world, "actors": installed_actors, "bindings": bindings, "formal_answers": answers, "cost_model": dv_append(scene.cost_model, dv_pair("other_departure", c1_cost(2, c1_source("godot_csharp/scenes/Awakening/Script/story/剧情时长.story", 37, "走动：2"))))})

fn c1_other_introduction(id):
    if id == "quer":
        return "叫我雀儿就行。别站门前——让我看一眼那道闩。"
    if id == "lucian":
        return "卢西安。名字还记得，半句诗也还记得；偏偏缺了我们怎么到这儿来的那一段。"
    if id == "ward":
        return "沃德。先说姓名，再说各自记得的最后一件事。不要混在一起。"
    if id == "gu":
        return "顾平章。容老朽擦擦眼镜。纸上的东西还在，人却想不起来，真是怪事。"
    if id == "ruan":
        return "阮清月。那盘棋先别碰。我们还不知道谁摆的，也不知道轮到谁。"
    if id == "elena":
        return "伊莲娜。别拉我起来……脚踝疼。你们谁知道这里是什么地方？"
    if id == "selma":
        return "赛尔玛。请别动窗台上的苗。我得先弄清楚本子上哪些是我记的。"
    if id == "moran":
        return "莫兰。等一等，那层绿马上要散了。你们说，我听着。"
    if id == "mora":
        return "茉拉。刚才谁在咳嗽？先让我看看，再说别的。"
    if id == "bertrand":
        return "贝尔特朗。门外有动静。先别挤过去，给彼此留条退路。"
    if id == "veronica":
        return "维罗妮卡。谁动过这排器具？不知道也直说，别替别人猜。"
    return "玛格丽特。先别都靠那面墙。这根梁的搭法，我得再看一遍。"

fn c1_other_clock_ref():
    return dv_ref("campaign.clock", "state", "minute")

fn c1_other_access_ref(group):
    return dv_ref("campaign.access", "state", group)

fn c1_other_threshold(group):
    return rt_cat("threshold.", group)

fn c1_other_handoff_text(id):
    if id == "ward":
        return "开锁的人已经核对了。出去以后，那把钥匙的来路还得写清楚。"
    if id == "quer":
        return "我答了。你还要把我堵在这儿？门开了，让开一点。"
    if id == "lucian":
        return "名字答对了，缘由还空着呢。沃德，留一行空白总比填错强。"
    if id == "gu":
        return "门开了。先莫争，外面若有文书，读过再说。"
    if id == "elena":
        return "我慢一点。阮清月……出去以后，你也别先走。"
    if id == "ruan":
        return "我在这儿。你先扶住门框，等站稳了再迈那一步。"
    if id == "selma":
        return "我的本子带上了。门内查到的，跟出去以后查到的，分开记。"
    if id == "moran":
        return "外面的光不一样。等我站到门边再画，别挡着伊莲娜。"
    if id == "mora":
        return "人先出去。试剂的事还没说清；有谁不舒服，别瞒着。"
    if id == "veronica":
        return "取走一瓶东西和拿它做了什么，是两件事。先把原瓶找到。"
    if id == "bertrand":
        return "我站门边。一个一个过去，先看落脚的地方。"
    return "门框没歪。慢慢过，别拿身体去撞那道闩。"

fn c1_other_handoff_action(id):
    let person = c1_other_person(id)
    let receipt = c1_other_claim(person.group, rt_cat("receipt.", id))
    let ready = dv_all(dv_pair(c1_at(id, c1_other_threshold(person.group)), receipt))
    let text = c1_other_handoff_text(id)
    return dv_with_many(c1_once(c1_action(rt_cat(id, ".doorway-handoff"), "talk", ready, c1_at(id, c1_other_threshold(person.group)), "", [], person.initial_source)), {"speech": dv_with(c1_speech(receipt, person.initial_source, "own-answer-receipt-and-next-intention"), "surface", text), "listeners": c1_other_group_listeners(person.group, id), "surface": text})
