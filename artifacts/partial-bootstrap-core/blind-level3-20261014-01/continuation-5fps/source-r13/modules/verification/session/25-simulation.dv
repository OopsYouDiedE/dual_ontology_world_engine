        i = (i + 1)
    i = 0
    while (i < rt_count(right.source_events)):
        if dv_has(roots, right.source_events[i]):
            false
        else:
            rt_push(roots, right.source_events[i])
        i = (i + 1)
    return dvs_factor_proof_result(dv_and(left.valid, right.valid), right.remaining, dv_min(left.confidence, right.confidence), steps, roots)

