diff --git a/language_core/verification/session/15-action-planning.dv b/language_core/verification/session/15-action-planning.dv
index bc386f8a..0ed92f25 100644
--- a/language_core/verification/session/15-action-planning.dv
+++ b/language_core/verification/session/15-action-planning.dv
@@ -741,15 +741,36 @@ fn dvp_achievement_value(actor, action):
         i = i + 1
     return value
 
+// Received timestamps establish freshness, without treating the received claims as true.
+fn dvp_latest_received_time(mind):
+    var time = dv_find(mind, "time", 0)
+    let history = dv_find(mind, "history", [])
+    var i = 0
+    while i < rt_count(history):
+        let entry = history[i]
+        if dv_find(entry, "kind", "") == "observation-batch":
+            let observations = dv_find(entry, "observations", [])
+            var j = 0
+            while j < rt_count(observations):
+                time = dv_max(time, observations[j].time)
+                j = j + 1
+        i = i + 1
+    return time
+
 // Goal metadata requests a current observation until the owner's own stop fact is known.
 fn dvp_refresh_current_evidence(actor, goals):
     var result = []
+    var received_time = dv_find(actor.mind, "time", 0)
+    var scanned = false
     var i = 0
     while i < rt_count(goals):
         var goal = goals[i]
         if dv_find(goal, "kind", "") == "evidence" and dv_has_key(goal, "refresh_until"):
             if dv_truth(actor.mind, goal.refresh_until) != "true":
-                goal = dv_with(goal, "minimum_time", actor.mind.time)
+                if not scanned:
+                    received_time = dvp_latest_received_time(actor.mind)
+                    scanned = true
+                goal = dv_with(goal, "minimum_time", received_time)
         rt_push(result, goal)
         i = i + 1
     return result
