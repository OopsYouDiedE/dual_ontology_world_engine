+// Initialization-only builder: owned_adoptions is a private clone, never a world field.
+fn dv_adopt_into(domain, owned_adoptions, law, mode, confidence, basis):
+    let adoption = dv_checked_adoption(domain, owned_adoptions, law, mode, confidence, basis)
+    rt_push(owned_adoptions, dv_pair(law.name, adoption))
+    return true
+
+fn dv_finish_owned_adoptions(world, owned_adoptions):
+    let previous_count = rt_count(world.adoptions)
+    dv_require(previous_count <= rt_count(owned_adoptions), "Adoption builder removed inherited entries")
+    var i = 0
+    while i < previous_count:
+        dv_require(dv_same(world.adoptions[i], owned_adoptions[i]), "Adoption builder changed inherited entries")
+        i = i + 1
+    if previous_count == rt_count(owned_adoptions):
