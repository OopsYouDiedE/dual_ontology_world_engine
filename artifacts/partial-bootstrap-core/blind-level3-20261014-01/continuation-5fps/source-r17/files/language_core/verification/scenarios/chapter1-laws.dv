axiom c1_question_accept(question, stage):
    return dv_axiom("c1_question_accept", 1, dv_fact(dv_ref(question, "state", rt_cat("open_", stage)), true), dv_pair(dv_assign(dv_ref(question, "state", rt_cat("solved_", stage)), true), dv_assign(dv_ref(question, "state", "last_accepted"), stage)))

axiom c1_meeting(requester, speaker, room):
    return dv_axiom("c1_meeting", 1, dv_all(dv_pair(dv_fact(dv_ref(requester, "state", "location"), room), dv_fact(dv_ref(speaker, "state", "location"), room))), [])

axiom c1_sound_trial(actor, ritual, room):
