// Native chapter authorship: named worlds, characters, actions and structured speech.
// Old .story files are read-only provenance. This module never parses their serialized format.
// These authority conclusions are frozen authored history, never grants or mind initial facts.
// In particular familiar is a source scenario truth; the person's inference remains evidence-weighted.
// Truth, personally supported claim, topic relevance and actual shown evidence are independent axes.
// In particular a true location or a bare trust/familiarity claim does not answer the current question.
// Preserve both original lawful showings: E8 plus executed trial, or the E5 hollow-frame evidence.
// E9/E10/E11/E7 remain alternative showings; the reason must still be personally supported.
// Speech candidates share the one actual opening transition. Every fragment uses original words.

fn c1_source(path, line, id):
    return {"path": path, "line": line, "id": id}

fn c1_knowledge(atom):
    return dv_ref("cognition", "state", atom)

fn c1_at(actor, room):
    return dv_fact(dv_ref(actor, "state", "location"), room)

fn c1_local_object(id):
    return dv_object(id, "perceived", {"state": [], "identity": []})

fn c1_state_object(id, fields):
    return dv_object(id, "physical", {"state": fields, "identity": []})

fn c1_action(id, kind, known, physical, law, grants, source):
    return dv_with(dv_with(dv_with({"id": id, "kind": kind, "precondition": known, "authority_precondition": physical}, "law", law), "grants", grants), "source_refs", dv_single(source))

fn c1_public_methods(actions):
    var result = []
    var n = 0
    while (n < rt_count(actions)):
        rt_push(result, c1_public_method(actions[n]))
        n = (n + 1)
    return result

fn c1_public_method(action):
    var method = dv_with(dv_with(action, "purpose_refs", dv_find(action, "purpose_refs", action.grants)), "purpose_basis", action.source_refs)
    var kind = action.kind
    if (kind == "answer"):
        return dv_with(method, "topic", c1_answer_topic(action.answer_id))
    else:
        if dv_or((kind == "move"), (kind == "replay")):
            return dv_with(method, "repeatable", true)
        else:
            return method

fn c1_answer_topic(id):
    if (id == "me"):
        return "identity"
    else:
        if dv_or((id == "V3_0"), (id == "V3_1")):
            return "voice_source"
        else:
            if dv_or((id == "V4_0"), (id == "V4_1")):
                return "words"
            else:
                if (id == "trust"):
                    return "trust"
                else:
                    return "auxiliary"

fn c1_once(action):
    return dv_with(action, "once", true)

fn c1_observe_as(action, source, origin, trust):
    var result = dv_with(dv_with(dv_with(action, "observation_source", source), "observation_origin", origin), "observation_trust", trust)
    if dv_and((source == "testimony"), (not (origin == "demon"))):
        return c1_personal_request(result, origin)
    else:
        return result

fn c1_query_basis(atom):
    if dv_or((atom == "slate_code"), dv_or((atom == "slate_person"), (atom == "recalled_copper"))):
        return c1_statement("slate_marks")
    else:
        if (atom == "frame_hollow"):
            return c1_statement("fork_dent")
        else:
            if (atom == "cups_known"):
                return c1_statement("cups_preferences")
            else:
                if dv_or((atom == "starter_kept"), (atom == "recalled_names")):
                    return c1_statement("starter_layers")
                else:
                    if (atom == "heads_lost"):
                        return dv_fact(dv_ref("ritual", "state", "sound_trial_done"), true)
                    else:
                        return dv_true()

fn c1_personal_request(action, target):
    var scope = action.grants
    var atom = action.grants[0].field
    var speech = dv_with(dv_with(c1_speech(dv_true(), "请把你辨认出的内容说给我听。", "professional-request"), "utterance_type", "question"), "request", {"target": target, "topic": action.grants[0].field})
    return dv_with(dv_with(dv_with(dv_with(dv_with(dv_with(action, "grants", []), "purpose_refs", scope), "precondition", c1_query_basis(atom)), "authority_precondition", dv_true()), "speech", speech), "listeners", dv_single(target))

fn c1_method(name, law):
    return dv_instance(name, law)

fn c1_vector(time):
    return {"time": time, "computation": 1, "stamina": 0}

fn c1_cost(time, source):
    return dv_with({"minimum": c1_vector(time), "maximum": c1_vector(time), "actual": c1_vector(time)}, "source_refs", dv_single(source))

fn c1_list_4(p0, p1, p2, p3):
    var list = []
    rt_push(list, p0)
    rt_push(list, p1)
    rt_push(list, p2)
    rt_push(list, p3)
    return list

