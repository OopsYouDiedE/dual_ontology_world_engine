fn c1_requested_replies(actor):
    if (actor == "huo"):
        return dv_pair(c1_professional_reply(actor, "slate_code", "⊥，闩。✕，禁止。✕开，不许开。", c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/03_协助.story", 27, "help_E7.003")), c1_professional_reply(actor, "slate_person", "小图代人，我习惯这样——画他手里常拿的家伙。⊥✓，闩好了。", c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/03_协助.story", 29, "help_E7.005")))
    else:
        if (actor == "shen"):
            return dv_pair(c1_professional_reply(actor, "cups_known", "给人倒茶我向来不问，看一眼就知道放几勺。", c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/03_协助.story", 36, "help_E9.003")), c1_professional_reply(actor, "starter_kept", "是我喂的。续种，刮壁，盖布——这手法我认得。", c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/03_协助.story", 43, "help_E10.002")))
        else:
            return dv_pair(c1_professional_reply(actor, "frame_hollow", "不一样。门框后面是空的。贴着一根管子。", c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/03_协助.story", 12, "help_E5.004")), c1_professional_reply(actor, "heads_lost", "从管子里出来的声音，跟人当面说话不一样。发闷，字头容易丢。", c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/05_声路与交谈.story", 19, "sound_test.007")))

