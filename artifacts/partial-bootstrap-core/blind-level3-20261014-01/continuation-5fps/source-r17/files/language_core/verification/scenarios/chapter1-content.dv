fn c1_question_text(stage):
    if (stage == "prompt"):
        return "门是谁闩上的？闩门之时，此人可曾听见门外的呼喊？"
    else:
        if (stage == "voice_source"):
            return "门外，有人呼喊吗？"
        else:
            if (stage == "words"):
                return "他喊的是什么？"
            else:
                return "闩门的人，为何不听门边那位女士的？"

fn c1_person_policy(id):
    let policy = c1_base_person_policy(id)
    var bindings = policy.topic_bindings
    let stages = ["identity", "voice_source", "words", "trust"]
    var i = 0
    while (i < rt_count(stages)):
        let stage = stages[i]
        rt_push(bindings, {"topic": stage, "heard_when": dv_fact(dv_ref("question", "state", rt_cat("open_", stage)), true), "completed_when": dv_not(dv_true()), "basis": [c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/07_答辩.story", 3, "answer_open.002")]})
        i = i + 1
    return dv_with(policy, "topic_bindings", bindings)
