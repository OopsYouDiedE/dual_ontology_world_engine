fn c1_hypotheses():
    var items = c1_raw_hypotheses()
    var result = []
    var n = 0
    while (n < rt_count(items)):
        var item = items[n]
        rt_push(result, dv_with(item, "question", c1_answer_topic(item.id)))
        n = (n + 1)
    return result

