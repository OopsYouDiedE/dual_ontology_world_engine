    world = dv_adopt(world, c1_method("demon.question", c1_question_emit("question")), "enforce", 1, dv_single(c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/01_开场.story", 46, "s5_question.004")))
    world = dv_adopt(world, c1_method("demon.original_question", c1_original_question_open("question")), "enforce", 1, dv_single(c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/07_答辩.story", 16, "answer_q2.001")))
    world = dv_adopt(world, c1_method("accept.original_q2_complete", c1_original_question_accept("question")), "enforce", 1, dv_single(c1_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/07_答辩.story", 3, "answer_open.002")))
    world = c1_adopt_protocol(world)
    return c1_register_speech_contract(world)

