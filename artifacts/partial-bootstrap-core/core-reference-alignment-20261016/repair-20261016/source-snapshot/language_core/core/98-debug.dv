// Read-only event projection. Filtering affects reports, never scheduling or knowledge.
fn dv_debug_event(event):
    let data = event.data
    let raw_action = dv_find(data, "action", [])
    var action = []
    var action_id = dv_find(data, "action_id", "")
    if dv_record_like(raw_action):
        action = raw_action
        action_id = dv_find(action, "id", action_id)
    else:
        if raw_action != false:
            action_id = rt_show(raw_action)
    var detail = []
    let fields = ["due", "until", "waiting", "duration", "status", "reason", "score", "plan_expansions", "plan_cache_hit", "reused_plan_expansions", "stop", "root_best", "best_after_successor_layer", "completed_layers", "actual", "observations", "judgment", "accepted", "literal_truth", "epistemic_support", "source_event", "execution_id", "chapter", "movement"]
    var i = 0
    while i < rt_count(fields):
        if dv_has_key(data, fields[i]):
            rt_push(detail, dv_pair(fields[i], dv_get(data, fields[i])))
        i = i + 1
    if event.type == "action_execution":
        detail = dv_with(detail, "status", data.receipt.execution.status)
    return dv_clone({"event_id": event.id, "type": event.type, "actor": event.actor, "game_time": event.time, "parents": event.parents, "action_id": action_id, "action_kind": dv_find(action, "kind", ""), "label": dv_find(action, "label", dv_find(action, "surface", "")), "purpose_sources": dv_find(action, "purpose_basis", []), "detail": detail})

fn dv_debug_events(events, start, config):
    dv_require(0 <= start and start <= rt_count(events), "Invalid debug event cursor")
    let actors = dv_find(config, "actors", [])
    let kinds = dv_find(config, "event_types", [])
    var result = []
    var i = start
    while i < rt_count(events):
        let event = events[i]
        if (rt_count(actors) == 0 or event.actor == "" or dv_has(actors, event.actor)) and (rt_count(kinds) == 0 or dv_has(kinds, event.type)):
            rt_push(result, dv_debug_event(event))
        i = i + 1
    return {"from": start, "next": rt_count(events), "events": result, "scope": "independent debug projection; full snapshots remain in live session; file completeness is reported separately"}
