; Independent native content draft. Load after chapter1-content.dv.
; No production installation, world update, grants, answers, routes, weights or actor choices.
; Runtime event requirements below are author review descriptors, not invented state cells.
; Each candidate may be offered only after its personal/public requirements actually occur.
; Questions request an account; they do not assert the requested answer.
; A source reference describes provenance, never a substitute for actual perception or showing.

(defn c1_latest_draft_source (file line id)
 (c1_source (rt_cat "godot_csharp/scenes/Awakening/Script/story/第一章/场面/" file) line id))
(defn c1_latest_draft_record (id speaker kind surface basis)
 (dv_with (dv_with (dv_with (dv_m4 "id" id "speaker" speaker "kind" kind "surface" surface)
  "source_refs" basis) "status" "uninstalled-content-candidate") "grants" (rt_list)))
(defn c1_latest_draft_requires (record personal events)
 (dv_with (dv_with record "required_personal_support" personal) "required_actual_events" events))
(defn c1_latest_draft_short_stay_support ()
 (dv_pair (dv_fact (c1_knowledge "short_stay") true)
  (dv_fact (dv_ref "memory" "state" "empty_school_recall") true)))
(defn c1_latest_draft_counter_events ()
 (dv_pair "speaker-actually-adopted-short_stay-before-counterargument"
  "speaker-actually-heard-detective-counterargument-about-earlier-familiarity"))
(defn c1_latest_draft_opening_events ()
 (dv_single "speaker-actually-heard-opening-and-adopted-short_stay"))

; The existing lawful opening's literal AST remains unchanged. The reward material is
; only a proposed showing, not an assertion that a showing occurred in the current DV scene.
; Before runtime use, execute the actual reward inspection and preserve its public record.
(defn c1_latest_draft_demon ()
 (dv_with (dv_with (dv_with
  (c1_latest_draft_record "draft.demon.opening-with-relevant-looking-material" "demon" "present"
   "诸位初涉斯地，记忆有缺，并非伤病，请勿惊惶。诸位的报偿，就在铜口下方的领取柜里，各有名签。请亲手核验。"
   (dv_list3
    (c1_latest_draft_source "01_开场.story" 28 "s3_broadcast.019")
    (c1_latest_draft_source "01_开场.story" 29 "s4_rewards.004")
    (c1_latest_draft_source "01_开场.story" 30 "s3_broadcast.020")))
  "literal_speech_template" (dv_get (c1_raw_opening_action) "speech"))
  "proposed_shown_source_refs" (dv_pair
   (c1_latest_draft_source "01_开场.story" 30 "s3_broadcast.020")
   (c1_latest_draft_source "01_开场.story" 31 "s3_broadcast.021")))
  "support_limit" "报偿的存在与亲手核验不能证明身体在此地停留多久；不得授予 short_stay。"))

; Huo: terse, asks what a material actually records, verifies tools and seeks the drawing.
(defn c1_latest_draft_huo_evidence ()
 (c1_latest_draft_requires
  (c1_latest_draft_record "draft.huo.offer-basis" "huo" "offer-evidence"
   "上船以后的事，没了。试件我刮过。那张图，我得找。……我先按刚来这里办。"
   (dv_list3
    (c1_latest_draft_source "10_开场独白.story" 7 "opening_huo.003")
    (c1_latest_draft_source "01_开场.story" 30 "s3_broadcast.020")
    (c1_latest_draft_source "01_开场.story" 40 "s4_rewards.023")))
  (c1_latest_draft_short_stay_support)
  (dv_pair "huo-actually-inspected-reward-test-piece" "huo-actually-heard-opening-and-adopted-short_stay")))
(defn c1_latest_draft_huo_challenge ()
 (c1_latest_draft_requires
  (c1_latest_draft_record "draft.huo.challenge-support" "huo" "challenge"
   "杯子，罐子。……哪一处写了我在这里多久？拿来，我看。"
   (dv_pair
    (c1_latest_draft_source "05_声路与交谈.story" 67 "talk_huo_menu.017")
    (c1_latest_draft_source "03_协助.story" 25 "help_E7.001")))
  (dv_single (dv_fact (c1_knowledge "short_stay") true))
  (c1_latest_draft_counter_events)))
(defn c1_latest_draft_huo_clarify ()
 (c1_latest_draft_requires
  (c1_latest_draft_record "draft.huo.ask-scope" "huo" "request-clarification"
   "初涉。……从今早算，还是从上岛算？说清楚。"
   (dv_pair
    (c1_latest_draft_source "01_开场.story" 28 "s3_broadcast.019")
    (c1_latest_draft_source "05_声路与交谈.story" 68 "talk_huo_menu.018")))
  (rt_list) (dv_single "huo-actually-heard-dispute-about-opening-scope")))
(defn c1_latest_draft_huo_maintain ()
 (c1_latest_draft_requires
  (c1_latest_draft_record "draft.huo.maintain-adopted-view" "huo" "maintain"
   "你说早就认识。……我今早想起来的，只到上船。试件我验过。他的话，我先留着。哪一处对不上，再说。"
   (dv_list3
    (c1_latest_draft_source "10_开场独白.story" 7 "opening_huo.003")
    (c1_latest_draft_source "01_开场.story" 30 "s3_broadcast.020")
    (c1_latest_draft_source "05_声路与交谈.story" 67 "talk_huo_menu.017")))
  (dv_single (dv_fact (c1_knowledge "short_stay") true))
  (dv_list3 "speaker-actually-adopted-short_stay-before-counterargument"
   "speaker-actually-heard-detective-counterargument-about-earlier-familiarity"
   "huo-actually-inspected-reward-test-piece")))

; Shen: familiar practical diction, protects companions and recognizes hand habits.
(defn c1_latest_draft_shen_evidence ()
 (c1_latest_draft_requires
  (c1_latest_draft_record "draft.shen.offer-basis" "shen" "offer-evidence"
   "我就记得上船。钱是真的，我咬过。茶么，顺手就倒了。……我还是觉得，咱们才刚来。"
   (c1_list_4
    (c1_latest_draft_source "01_开场.story" 20 "s2_tea.016")
    (c1_latest_draft_source "01_开场.story" 30 "s3_broadcast.020")
    (c1_latest_draft_source "01_开场.story" 39 "s3_broadcast.022")
    (c1_latest_draft_source "01_开场.story" 23 "s2_tea.013")))
  (c1_latest_draft_short_stay_support)
  (dv_list3 "shen-actually-inspected-reward-silver" "shen-actually-served-tea"
   "shen-actually-heard-opening-and-adopted-short_stay")))
(defn c1_latest_draft_shen_challenge ()
 (c1_latest_draft_requires
  (c1_latest_draft_record "draft.shen.challenge-support" "shen" "challenge"
   "会给人倒茶，就算老相识了？我向来不问，手比脑子快。你得让我明白，这回为什么不一样。"
   (dv_pair
    (c1_latest_draft_source "03_协助.story" 36 "help_E9.003")
    (c1_latest_draft_source "05_声路与交谈.story" 108 "talk_shen_menu.004")))
  (dv_single (dv_fact (c1_knowledge "cups_known") true))
  (c1_latest_draft_counter_events)))
(defn c1_latest_draft_shen_clarify ()
 (c1_latest_draft_requires
  (c1_latest_draft_record "draft.shen.ask-scope" "shen" "request-clarification"
   "喂，你那句初涉，到底说的是今早醒过来，还是咱们上岛？别叫我们猜。"
   (dv_pair
    (c1_latest_draft_source "01_开场.story" 28 "s3_broadcast.019")
    (c1_latest_draft_source "04_低语与回想.story" 119 "recall_shown_shen.002")))
  (rt_list) (dv_single "shen-actually-heard-dispute-about-opening-scope")))
(defn c1_latest_draft_shen_maintain ()
 (c1_latest_draft_requires
  (c1_latest_draft_record "draft.shen.maintain-adopted-view" "shen" "maintain"
   "茶是我倒的，我认。可顺手就是顺手，我自己也纳闷。钱是真的，今早我又只记得上船。先别叫我把刚才认的全推了，你把中间那一段说给我听。"
   (c1_list_4
    (c1_latest_draft_source "01_开场.story" 20 "s2_tea.016")
    (c1_latest_draft_source "01_开场.story" 39 "s3_broadcast.022")
    (c1_latest_draft_source "05_声路与交谈.story" 108 "talk_shen_menu.004")
    (c1_latest_draft_source "05_声路与交谈.story" 109 "talk_shen_menu.005")))
  (dv_pair (dv_fact (c1_knowledge "short_stay") true) (dv_fact (c1_knowledge "cups_known") true))
  (dv_list3 "speaker-actually-adopted-short_stay-before-counterargument"
   "speaker-actually-heard-detective-counterargument-about-earlier-familiarity"
   "shen-actually-inspected-reward-silver")))

; Su: pauses, attends to a heard fragment, distinguishes handwriting from its time.
(defn c1_latest_draft_su_evidence ()
 (c1_latest_draft_requires
  (c1_latest_draft_record "draft.su.offer-basis" "su" "offer-evidence"
   "我最后记得的，是船上的汽笛。……柜边那个声音，我刚听过。初涉……我也以为，是刚到这里。"
   (dv_list3
    (c1_latest_draft_source "10_开场独白.story" 23 "opening_su.003")
    (c1_latest_draft_source "01_开场.story" 30 "s3_broadcast.020")
    (c1_latest_draft_source "01_开场.story" 28 "s3_broadcast.019")))
  (c1_latest_draft_short_stay_support)
  (dv_pair "su-actually-heard-reward-audition" "su-actually-heard-opening-and-adopted-short_stay")))
(defn c1_latest_draft_su_challenge ()
 (c1_latest_draft_requires
  (c1_latest_draft_record "draft.su.challenge-support" "su" "challenge"
   "……是我的字，不等于我知道哪一天写的。你说我们早就认识，哪一处能接上？"
   (dv_pair
    (c1_latest_draft_source "05_声路与交谈.story" 201 "talk_su_menu.011")
    (c1_latest_draft_source "05_声路与交谈.story" 216 "talk_su_menu.017")))
  (dv_single (dv_fact (c1_knowledge "score_partial") true))
  (dv_list3 "speaker-actually-adopted-short_stay-before-counterargument"
   "speaker-actually-heard-detective-counterargument-about-earlier-familiarity"
   "su-actually-recognized-her-score-handwriting")))
(defn c1_latest_draft_su_clarify ()
 (c1_latest_draft_requires
  (c1_latest_draft_record "draft.su.ask-scope" "su" "request-clarification"
   "……你说初涉。那个我，是今早醒来的我吗？再说一遍，别省掉前面。"
   (dv_pair
    (c1_latest_draft_source "01_开场.story" 28 "s3_broadcast.019")
    (c1_latest_draft_source "03_协助.story" 18 "help_E6.002")))
  (rt_list) (dv_single "su-actually-heard-dispute-about-opening-scope")))
(defn c1_latest_draft_su_maintain ()
 (c1_latest_draft_requires
  (c1_latest_draft_record "draft.su.maintain-adopted-view" "su" "maintain"
   "……汽笛之后，我今早什么也想不起。他说的声音，试听机里确实有。我听见初涉，就按刚来这里听了。你的那一段……让我再听一次。"
   (dv_list3
    (c1_latest_draft_source "10_开场独白.story" 23 "opening_su.003")
    (c1_latest_draft_source "01_开场.story" 30 "s3_broadcast.020")
    (c1_latest_draft_source "01_开场.story" 31 "s3_broadcast.021")))
  (dv_single (dv_fact (c1_knowledge "short_stay") true))
  (dv_list3 "speaker-actually-adopted-short_stay-before-counterargument"
   "speaker-actually-heard-detective-counterargument-about-earlier-familiarity"
   "su-actually-heard-reward-audition")))

(defn c1_latest_request_content_draft ()
 (dv_m4 "id" "chapter1-latest-request-content-draft" "status" "review-only-not-runtime-installed"
  "candidates" (c1_list_13 (c1_latest_draft_demon)
   (c1_latest_draft_huo_evidence) (c1_latest_draft_huo_challenge)
   (c1_latest_draft_huo_clarify) (c1_latest_draft_huo_maintain)
   (c1_latest_draft_shen_evidence) (c1_latest_draft_shen_challenge)
   (c1_latest_draft_shen_clarify) (c1_latest_draft_shen_maintain)
   (c1_latest_draft_su_evidence) (c1_latest_draft_su_challenge)
   (c1_latest_draft_su_clarify) (c1_latest_draft_su_maintain))
  "gaps" (c1_list_4
   "当前 DV 内容未展示领取柜核验；展示草稿不能冒充已执行的材料呈示。"
   "反证内容须绑定侦探实际形成并公开传达的论证；不得预写答案或未发生的接收。"
   "维护只能在本人仍实际采纳时成为可选行动；不得复写已撤回的信念来凑行为。"
   "四问在 15:00 前正式接受须用新会话记录确认；候选内容没有计时特权。")))
