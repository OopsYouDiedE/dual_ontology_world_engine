# Godot 4+ specific ignores
.godot/
/android/
.vs/
bin/
obj/
*.csproj.old
.coverage
__pycache__/
*.py[cod]
.pytest_cache/
tmp/
scratch/
artifacts/scratch/
.runtime/
# Local release packages; source and build instructions remain tracked.
artifacts/releases/
*.log
*.autosave
.mscbackup/
*.wav
# Runtime voice assets must ship with the project.
!assets/characters/voices/*.wav
assets/imported/
# Godot regenerates these from the tracked CSV and .csv.import files.
**/*.translation
# Legacy soundtrack exports; current exports go to artifacts/releases/soundtrack/.
/mcp/music_pipeline/Blessed Sleepers - *.mp3
/mcp/music_pipeline/Blessed Sleepers - *.mid
/mcp/music_pipeline/Blessed Sleepers - *.pdf
/mcp/music_pipeline/Blessed Sleepers - *.musicxml

runs/
artifacts/basic-ui-system/player-traces/*
!artifacts/basic-ui-system/player-traces/engine-full-output.jsonl
!artifacts/basic-ui-system/player-traces/ui-full-output.jsonl

# Reproducible Python environments and local compressed backups.
.venv/
artifacts/project-audit/*.zip
artifacts/project-audit/*.7z
artifacts/project-audit/*.rar

# Local transient status and editor save files.
*.tmp

# Test recordings and large profiling traces
*.nettrace
*.speedscope.json
*.mp4
**/startup.png
artifacts/**/frames/
**/trace.json


# Shallow layout: local caches and generated audition exports.
/artifacts/scratch/
/artifacts/restructure-20261029/RoomCraft.original.html
/tools/legacy/__pycache__/
!assets/characters/voices/*.wav
/assets/imported/
assets/localization/*.translation

# Local Godot standalone builds & GPU driver caches
env/
NVIDIA Corporation/

# Generated artifacts stay local; adopted authoring sources live under tools/.
/artifacts/*
!/artifacts/.gdignore

# Unpublished building previews generated from authoring sources.
/tools/building/candidates/lowpoly_chapters_v3/
/tools/building/candidates/lowpoly_hall/
