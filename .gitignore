# Godot 4+ specific ignores
.godot/
/android/
.vs/
bin/
obj/
*.uid
*.csproj.old
.coverage
__pycache__/
*.py[cod]
.pytest_cache/
tmp/
scratch/
# Local release packages; source and build instructions remain tracked.
artifacts/releases/
*.log
*.autosave
.mscbackup/
*.wav
# Runtime voice blips are preloaded by StoryDialogue.gd and must ship with the project.
!godot_csharp/ShareAsset/Internal/Characters/voices/*.wav
godot_csharp/imported_assets/
csharp/**/*.import

runs/
artifacts/basic-ui-system/player-traces/*
!artifacts/basic-ui-system/player-traces/engine-full-output.jsonl
!artifacts/basic-ui-system/player-traces/ui-full-output.jsonl

# Reproducible Python environments and local compressed backups.
.venv/
artifacts/project-audit/*.zip
artifacts/project-audit/*.7z
artifacts/project-audit/*.rar

# Local transient status and editor save files.
*.tmp

# Test recordings and large profiling traces
*.nettrace
*.speedscope.json
*.mp4
**/startup.png
artifacts/**/frames/

