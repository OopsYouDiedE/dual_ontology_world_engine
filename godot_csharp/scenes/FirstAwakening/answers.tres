[gd_resource type="Resource" script_class="FirstAwakeningAnswerCatalog" format=3]

[ext_resource type="Script" path="res://scenes/FirstAwakening/AnswerCatalog.gd" id="catalog"]

[resource]
script = ExtResource("catalog")
sections = [
{"slot": "opening_motive", "title_id": "FA_UI_253", "options": [
    {"value": "以窄缝供人逃离", "display_id": "FA_UI_256", "outcome": "reject_escape"},
    {"value": "内侧木楔抵挡外敌推门", "display_id": "FA_UI_257", "outcome": "reject_defense"},
    {"value": "撑开窄缝探听主楼险情", "display_id": "FA_UI_258", "requirements": {"evidence_all": ["trace"], "evidence_any": ["hinge", "weight"]}}
]},
{"slot": "closing_motive", "title_id": "FA_UI_254", "options": [
    {"value": "关门使主楼烟气留在生活翼", "display_id": "FA_UI_259", "outcome": "reject_betrayal"},
    {"value": "烟灰涌入后撤楔合门避险", "display_id": "FA_UI_260", "requirements": {"evidence_all": ["door", "trace"]}}
]},
{"slot": "cleanup_and_locks", "title_id": "FA_UI_255", "options": [
    {"value": "门外的人不跨门便伪造现场并操作双锁", "display_id": "FA_UI_261", "outcome": "reject_fifth_person"},
    {"value": "外侧单方锁死", "display_id": "FA_UI_073", "outcome": "reject_one_side"},
    {"value": "生活翼清理与内销，主楼侧另落外闩", "display_id": "FA_UI_262", "requirements": {"evidence_all": ["wash", "paper", "door", "slit"]}}
]}
]
