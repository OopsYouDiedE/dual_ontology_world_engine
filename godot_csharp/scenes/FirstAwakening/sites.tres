{"id": "room_1", "title": "R-06 门牌", "point": Vector2(512, 382), "description": "门牌标着R-06，只有编号，没有姓名；房门关闭，须由工程师陪同查看房间内部。", "diagram": "number", "reach": 48.0, "title_id": "FA_UI_007", "description_id": "FA_UI_215"},

