{"id": "bed_0", "title": "制式寝具", "point": Vector2(154, 174), "description": "制式床架与格纹被褥铺叠平整，床边只放着一双制式拖鞋，没有行李或散放的私人物件。椅背上的合身外衣袖口留着一抹三角形灰痕；我身上没有外伤，也没有被捆绑过的麻木感。", "diagram": "", "reach": 48.0, "title_id": "FA_UI_108", "description_id": "FA_UI_218"},

{"id": "bed_1", "title": "制式寝具", "point": Vector2(474, 174), "description": "制式床架与格纹被褥。床边放着一双制式拖鞋；没有行李、信件或散放的私人物件。", "diagram": "", "reach": 48.0, "title_id": "FA_UI_108", "description_id": "FA_UI_219"},

