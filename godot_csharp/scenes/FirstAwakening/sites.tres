script = ExtResource("catalog")

entries = [

{"id": "window_0", "title": "铁格雾窗", "point": Vector2(108, 104), "description": "铸铁格栅嵌在石制窗框内。窗外是浓厚白雾，看不清远处，也无法辨认道路。", "diagram": "window", "reach": 48.0, "title_id": "FA_UI_172", "description_id": "FA_UI_210"},

