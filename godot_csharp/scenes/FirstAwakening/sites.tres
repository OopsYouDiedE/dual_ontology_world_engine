{"id": "clock", "title": "发条机械钟", "point": Vector2(216, 104), "description": "秒针一格一格平稳跳动，机壳内传出轻微的滴答声。表盘上只有十二个罗马数字刻度，没有显示年份与日期的窗口。", "diagram": "clock", "reach": 48.0, "title_id": "FA_UI_056", "description_id": "FA_UI_142"},

{"id": "notebook", "title": "制式书桌", "point": Vector2(50, 184), "description": "制式书桌的桌面空着，抽屉里只有空白纸，没有行李或信件。", "diagram": "", "reach": 48.0, "title_id": "FA_UI_273", "description_id": "FA_UI_274"},

{"id": "drawer", "title": "书桌抽屉", "point": Vector2(92, 186), "description": "抽屉里只有空白纸，没有行李或信件。", "diagram": "", "reach": 48.0, "title_id": "FA_UI_275", "description_id": "FA_UI_276"},

{"id": "paper", "title": "废纸篓里的包纸", "point": Vector2(108, 202), "description": "练习纸内包着硬木楔。斜面沾灰，尖角有缺口，灰黑转印集中在纸内，外侧较干净。撕口可与公共练习册比对；它不能证明我的身份。", "diagram": "wedge", "reach": 48.0, "title_id": "FA_UI_277", "description_id": "FA_UI_278"},

{"id": "study", "title": "研习材料", "point": Vector2(320, 652), "description": "印制的制式测量与结构力学习题上，只有一人留下的新近笔迹，无法辨认书写者。第三页撕口可与废纸篓里的包楔纸比对。旁边放着直尺、带缺口的定位木条和带钉眼的方木。", "diagram": "study", "reach": 72.0, "title_id": "FA_UI_136", "description_id": "FA_UI_045"},

{"id": "tear", "title": "草稿册第三页撕口", "point": Vector2(346, 652), "description": "草稿册第三页缺失，断口与包楔纸的毛边、横线可比对。纸张内侧转印支持木楔受灰后才被包裹。", "diagram": "tear", "reach": 72.0, "title_id": "FA_UI_291", "description_id": "FA_UI_292"},

{"id": "box_mark", "title": "桌面压痕", "point": Vector2(368, 640), "description": "长桌角有一处新鲜压痕，边缘留着三点状凹痕。可与带脚钉的小物件底部比对；这是一次接触痕迹，不能说明此类物件常放在这里。", "diagram": "box", "reach": 72.0, "title_id": "FA_UI_118", "description_id": "FA_UI_117"},

{"id": "meeting", "title": "四人会议", "point": Vector2(320, 600), "description": "在长桌前召集同伴，检验关于房屋与隔离门的竞争假说。", "diagram": "", "reach": 62.0, "title_id": "FA_UI_063", "description_id": "FA_UI_068"},

{"id": "rations", "title": "分装口粮", "point": Vector2(968, 668), "description": "储食柜内摆着四份用油纸包裹的硬面包，切口整齐，旁边贴着便签：`每日口粮——丙型配给`。柜内空荡，没有多余的面粉或储备干粮。", "diagram": "rations", "reach": 48.0, "title_id": "FA_UI_047", "description_id": "FA_UI_065"},

{"id": "water", "title": "水阀", "point": Vector2(852, 580), "description": "拧开黄铜水阀，管道微震，落下一股清水。关上阀门后，管口滴下两滴便止住。管道向上通往顶部的独立水箱。", "diagram": "water", "reach": 48.0, "title_id": "FA_UI_124", "description_id": "FA_UI_097"},

{"id": "wash", "title": "洗盆与湿布", "point": Vector2(882, 580), "description": "洗盆已排空；内沿只留有刚洗布后形成的灰黑水位痕。粗麻布湿冷，纤维深处留着与门厅相近的黑灰，已被拧过并抖平挂在干燥沿。可比对这次清理经过，不能单凭整齐判定身份。", "diagram": "wash", "reach": 48.0, "title_id": "FA_UI_279", "description_id": "FA_UI_280"},

{"id": "cup", "title": "公共桌上的缺口杯与杯片", "point": Vector2(746, 664), "description": "公共桌上留有一块带釉的陶杯残片，旁边的杯口有相近的缺口。仅凭形状无法确定杯子属于谁，也不能指认经手者。", "diagram": "cup", "reach": 48.0, "title_id": "FA_UI_152", "description_id": "FA_UI_090"},

{"id": "hinge", "title": "门轴与石砌止口", "point": Vector2(604, 950), "description": "铁门的铰链轴心装在主楼一侧。门框四周凸出一圈花岗岩石砌止口，凸边朝着生活翼；门扇边缘贴在止口的主楼一侧，贴合处磨出了一圈亮痕。", "diagram": "hinge", "reach": 48.0, "title_id": "FA_UI_184", "description_id": "FA_UI_185"},

{"id": "weight", "title": "自闭配重", "point": Vector2(700, 950), "description": "钢绳穿过门框上方的定滑轮，一端连着门扇上部，另一端吊着一块铸铁重块。钢绳绷紧，重块离地约一掌高。", "diagram": "weight", "reach": 48.0, "title_id": "FA_UI_153", "description_id": "FA_UI_151"},

{"id": "door", "title": "隔离门与内销", "point": Vector2(644, 954), "description": "生活翼侧手动内销穿过固定座，销身有新刮痕。门底黑灰向生活翼散开，灰迹在门缝附近集中；喷入方向可检视，毒性与压力尚不能据此量定。", "diagram": "door", "reach": 48.0, "title_id": "FA_UI_293", "description_id": "FA_UI_294"},

{"id": "slit", "title": "检视盖窄孔", "point": Vector2(664, 952), "description": "掀开门板中央的生铁检视盖，透过狭窄缝隙望向主楼侧：一根粗重的铁制横闩稳稳落入两侧的铸铁卡座内。横闩位于门外，从生活翼这一侧无法触及。", "diagram": "bar", "reach": 48.0, "title_id": "FA_UI_120", "description_id": "FA_UI_167"},

{"id": "trace", "title": "门底窄缝与咬痕", "point": Vector2(628, 956), "description": "弧形磨痕最远约十厘米。门底有三角卷边与木纤维，地面灰迹缺出楔形干净区。撑楔窄缝不足以供成人直接通过，但不能据此断言门从未开大或无人想过逃生。", "diagram": "trace", "reach": 48.0, "title_id": "FA_UI_295", "description_id": "FA_UI_296"},

{"id": "stop", "title": "墙边的铁止挡座", "point": Vector2(532, 946), "description": "墙角立着一只沉重的铸铁地面止挡座，提手上沾着一点淡黄色的细粉。门厅中央有一圈与它底座大小相符的灰印；圈里的地面也被湿布擦过。", "diagram": "stop", "reach": 48.0, "title_id": "FA_UI_072", "description_id": "FA_UI_071"},

{"id": "floor_wipe", "title": "门厅擦拭痕", "point": Vector2(596, 930), "description": "几道由粗布擦拭拖拽出的泛白水渍横过地砖，水渍带有微弱的碱性气味，缝隙深处仍有残留黑灰。擦拭范围主要集中在从门前到走廊的走动通道上。", "diagram": "wipe", "reach": 48.0, "title_id": "FA_UI_179", "description_id": "FA_UI_046"},

{"id": "engineer", "title": "工程师", "point": Vector2(480, 416), "description": "工程师自称霍铎，记得招募信中许诺的工艺与图纸，却不记得如何进入生活翼。", "diagram": "", "reach": 48.0, "title_id": "FA_UI_085", "description_id": "FA_UI_028"},

{"id": "chef", "title": "厨师", "point": Vector2(983, 728), "description": "主厨自称沈鼎，记得招募时答应的报酬与自己的厨艺，也不记得如何进入生活翼。", "diagram": "", "reach": 48.0, "title_id": "FA_UI_052", "description_id": "FA_UI_077"},

{"id": "musician", "title": "音乐家", "point": Vector2(706, 944), "description": "音乐家自称苏泠，记得自己受邀求学与所求的声音，但想不起从登船到醒来之间的经历。", "diagram": "", "reach": 48.0, "title_id": "FA_UI_188", "description_id": "FA_UI_027"},

{"id": "transmitter", "title": "铜质传声口", "point": Vector2(498, 556), "description": "墙上固定铜口与拉柄。导线进入砌体，终点不可见。", "diagram": "transmitter", "reach": 48.0, "title_id": "FA_UI_174", "description_id": "FA_UI_070"},

{"id": "basin_ring", "title": "水盆灰痕", "point": Vector2(858, 580), "description": "水盆内壁留有刚洗布后形成的一圈灰黑水位痕，排水口有细小焦渣；水已放干。", "diagram": "wash", "reach": 48.0, "title_id": "FA_UI_281", "description_id": "FA_UI_282"},

{"id": "cloth_hang", "title": "湿布拧洗挂放", "point": Vector2(904, 580), "description": "湿布拧过又抖平，挂在水盆干燥沿，纤维内仍有灰。洗后归位是一种可解释的行为，不能单独指认经手者。", "diagram": "wash", "reach": 48.0, "title_id": "FA_UI_283", "description_id": "FA_UI_284"},

{"id": "cold_stove", "title": "冷灶与柴灰", "point": Vector2(1216, 574), "description": "铁灶冷凉，柴灰干燥，与门前黏附的黑垢形态不同。没有足够痕迹把门前烟灰归给这座灶。", "diagram": "", "reach": 48.0, "title_id": "FA_UI_285", "description_id": "FA_UI_286"},

{"id": "table_wedge", "title": "案脚与替代垫片", "point": Vector2(300, 688), "description": "案脚下垫着碎石片，其下方留有新鲜的木楔形压痕，可与纸篓里的硬木楔比对。", "diagram": "wedge", "reach": 48.0, "title_id": "FA_UI_287", "description_id": "FA_UI_288"},

{"id": "chair_marks", "title": "椅脚后撤痕", "point": Vector2(376, 700), "description": "四处椅脚刮痕向长桌外延伸，量具散落。能支持离席与取物，不能单凭刮痕断言四人同一瞬间起立。", "diagram": "study", "reach": 48.0, "title_id": "FA_UI_289", "description_id": "FA_UI_290"}

]
