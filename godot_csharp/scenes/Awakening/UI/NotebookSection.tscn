[gd_scene format=3]
[ext_resource type="Theme" path="res://scenes/Shared/UI/PaperTheme.tres" id="theme"]
[ext_resource type="Script" path="res://scenes/Awakening/UI/PagePreview.gd" id="preview"]

[node name="NotebookSection" type="VBoxContainer"]
offset_right = 932.0
size_flags_horizontal = 3
theme = ExtResource("theme")
script = ExtResource("preview")
theme_override_constants/separation = 10

[node name="Place" type="RichTextLabel" parent="."]
layout_mode = 2
size_flags_horizontal = 3
bbcode_enabled = true
fit_content = true
scroll_active = false
autowrap_mode = 3
theme_override_font_sizes/normal_font_size = 21
theme_override_font_sizes/bold_font_size = 21
theme_override_colors/default_color = Color(0.5411765, 0.2, 0.1411765, 1)
text = "[b]地点[/b]"

[node name="Grid" type="GridContainer" parent="."]
layout_mode = 2
columns = 3
theme_override_constants/h_separation = 10
theme_override_constants/v_separation = 8
