<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>Chapter1Script</AssemblyName>
    <StoryPython Condition="'$(StoryPython)' == ''">python</StoryPython>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Chapter1Expression.cs" />
    <Compile Include="Chapter1Knowledge.cs" />
    <Compile Include="Chapter1Strategies.cs" />
    <Compile Include="Chapter1Script.cs;Chapter1Session.cs;Chapter1SessionFlows.cs;Chapter1SessionProbe.cs;Chapter1Save.cs;Chapter1Data.cs;Chapter1Flows.cs;Chapter1Clock.cs;Chapter1Replay.cs;Chapter1Speech.cs;Chapter1Dialogue.cs;Chapter1Interaction.cs;Chapter1CompiledDialogue.cs;../Night/*.cs" />
    <EmbeddedResource Include="generated_awakening_content.json" LogicalName="Awakening.Content.json" />
    <EmbeddedResource Include="generated_awakening_layout.json" LogicalName="Awakening.Layout.json" />
    <EmbeddedResource Include="generated_chapter_01_world.json" LogicalName="Awakening.World.json" />
    <ProjectReference Include="../../Shared/Story/ChapterRuntime.csproj" />
  </ItemGroup>
  <Target Name="CheckGeneratedChapter1Story" BeforeTargets="BeforeBuild">
    <Exec Command="&quot;$(StoryPython)&quot; &quot;$(MSBuildThisFileDirectory)..\..\..\tools\compile_story.py&quot; --check"
          WorkingDirectory="$(MSBuildThisFileDirectory)" />
  </Target>
</Project>
