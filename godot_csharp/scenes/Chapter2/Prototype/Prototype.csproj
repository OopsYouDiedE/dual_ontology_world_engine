<Project Sdk="Microsoft.NET.Sdk">
  <!-- 第二章命令行入口与开发夹具；生产逻辑引用正式剧本程序集。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>DualOntologyWorldEngine.Chapter2.Prototype</RootNamespace>
    <AssemblyName>Chapter2Prototype</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs;Bots.cs;Checks.cs" />
    <ProjectReference Include="../Script/Chapter2Script.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../Shared/check/FixtureData.cs" Link="FixtureData.cs" />
    <EmbeddedResource Include="../../Shared/check/Fixtures/bots.json" LogicalName="Fixtures.bots.json" />
    <EmbeddedResource Include="../../Shared/check/Fixtures/chapter2-checks.json" LogicalName="Fixtures.chapter2-checks.json" />
    <EmbeddedResource Include="../../Shared/check/Fixtures/chapter2-program.json" LogicalName="Fixtures.chapter2-program.json" />
  </ItemGroup>
</Project>
