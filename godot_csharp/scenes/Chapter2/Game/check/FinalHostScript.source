using DualOntologyWorldEngine.Chapter2.Prototype;
using DualOntologyWorldEngine.Core;
public sealed class FinalHostScript : IWorldScript
{
    private DualOntologyWorldEngine.Story.ScriptCharacter guest = null!;
    public WorldScriptDefinition Define() => new() { Initialize = g => {
        guest = g.ScriptWorld.DefineCharacter("host-guest", "验证学员", g.Space[Place.Clinic],
            "res://ShareAsset/Internal/Characters/animation_v2/engineer.tres");
    }, Sequences = [new("clinic-choice", 2, Slot.Morning,
        [new StoryChoice("clinic-choice", "验证病房选择", [new("record", "记录当前房间", [
            new StoryEffect(P.Det, g => new Effect.Set(g.Det.Self, T.Insight, (int)g.Where(g.Det))),
            new StoryCoreEffect(_ => guest, _ => new Effect.Think(new Condition.Exists(guest.Self))),
            new StoryText("VALIDATION BEFORE IMAGE"),
            new StoryPresentation(StoryPresentationKind.Image, "res://ShareAsset/Internal/Props/Chapter2/rooms/clinic.png"),
            new StoryText("VALIDATION AFTER IMAGE"),
            new StoryPresentation(StoryPresentationKind.Image, "res://ShareAsset/Internal/Props/Chapter2/rooms/clinic.png"),
            new StoryText("VALIDATION AFTER SECOND IMAGE")])])], g => g.Where(g.Det) == Place.Clinic)] };
}
