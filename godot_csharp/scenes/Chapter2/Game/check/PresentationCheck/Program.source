using System.Text.Json.Nodes;
using DualOntologyWorldEngine.Chapter2.Prototype;

int checks = 0, failures = 0;
void Check(string label, Action action)
{
    checks++;
    try { action(); Console.WriteLine("PASS " + label); }
    catch (Exception error) { failures++; Console.WriteLine("FAIL " + label + ": " + error); }
}
void Assert(bool condition) { if (!condition) throw new Exception("Assertion failed"); }
void Reject(Action action, string message)
{
    try { action(); }
    catch (InvalidDataException error) { Assert(error.Message.Contains(message)); return; }
    throw new Exception("Expected an explicit binding error: " + message);
}
JsonObject Source() => JsonNode.Parse(Chapter2Design.Json)!.AsObject();
JsonObject Chapter(JsonObject root) => root["chapters"]![0]!.AsObject();
JsonObject Presentation(JsonObject root) => Chapter(root)["design"]!["presentation"]!.AsObject();
void BindInvestigation(Game game, string script) => typeof(Game).GetMethod("BindInvestigation",
    System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic)!
    .CreateDelegate<Action<string>>(game)(script);

Check("same world object references and ordered area membership", () =>
{
    var game = new Game();
    foreach (var binding in game.Things_.Values)
    {
        Assert(game.Things.Any(entity => ReferenceEquals(entity, binding.Thing)));
        Assert(ReferenceEquals(binding.Thing.Get<DualOntologyWorldEngine.Core.SpatialProperty>()!.Space, game.Space[binding.Place]));
    }
    foreach (var area in game.AreaThings)
        Assert(area.Value.ToHashSet().SetEquals(game.Things_.Where(item => item.Value.Place == area.Key).Select(item => item.Key)));
});
Check("map ID can change without changing its physical room", () =>
{
    var source = Source(); var maps = Presentation(source)["maps"]!.AsObject();
    var entry = maps.First(item => item.Value!["primary"]!.GetValue<bool>());
    var room = entry.Value!["room"]!.GetValue<string>()["world:room.".Length..];
    var value = entry.Value!.DeepClone(); maps.Remove(entry.Key); maps.Add("fixture_map_v2", value);
    var reader = new Chapter2Presentation(source.ToJsonString());
    Assert(reader.MapPlace("fixture_map_v2") == room && reader.PlaceMap(room) == "fixture_map_v2");
    Assert(reader.MapSpawn("fixture_map_v2") == value["spawn"]!.GetValue<string>());
    Reject(() => reader.MapPlace("absent"), "Missing map binding");
});
Check("portrait binding is authored and missing binding fails", () =>
{
    var source = Source();
    var actor = Chapter(source)["entities"]!.AsArray().First(item => item!["kind"]!.GetValue<string>() == "character")!;
    var id = actor["id"]!.GetValue<string>().Split('.')[^1];
    actor["properties"]!["sprite"]!["value"] = "fixture_portrait_v2";
    var presentation = new Chapter2Presentation(source.ToJsonString());
    Assert(presentation.Sprites[id] == "fixture_portrait_v2");
    Assert(presentation.Cast[actor["name"]!.GetValue<string>()] == "fixture_portrait_v2");
    actor["properties"]!.AsObject().Remove("sprite");
    Reject(() => new Chapter2Presentation(source.ToJsonString()), "Missing portrait binding");
});
Check("missing physical map binding fails", () =>
{
    var source = Source();
    Presentation(source)["maps"]!.AsObject().First().Value!["room"] = "world:room.Absent";
    Reject(() => new Chapter2Presentation(source.ToJsonString()), "Missing map room binding");
});
Check("investigation binding reads the supplied script", () =>
{
    var source = Source();
    var entry = Presentation(source)["investigation"]!.AsObject().First();
    var game = new Game();
    var oldLabel = entry.Value!["label"]!.GetValue<string>();
    var entity = game.Things_[oldLabel].Thing;
    entry.Value["label"] = "fixture_label_v2";
    BindInvestigation(game, source.ToJsonString());
    Assert(!game.Things_.ContainsKey(oldLabel));
    Assert(ReferenceEquals(game.Things_["fixture_label_v2"].Thing, entity));
});
Check("missing investigation identity fails explicitly", () =>
{
    var source = Source(); var investigation = Presentation(source)["investigation"]!.AsObject();
    var entry = investigation.First(); var spec = entry.Value!.DeepClone();
    investigation.Remove(entry.Key); investigation.Add("world:object.Absent", spec);
    Reject(() => BindInvestigation(new Game(), source.ToJsonString()), "Missing investigation entity");
});
Check("notebook image binding is independent of investigation eligibility", () =>
{
    var game = new Game();
    foreach (var board in game.Board.Values) _ = game.NotebookImage(board);
    var source = Source(); var images = Presentation(source)["notebook_images"]!.AsObject();
    images.Remove(images.First().Key);
    Reject(() => BindInvestigation(game, source.ToJsonString()), "Missing notebook image binding");
});
Check("nonspatial anchor exemption works for a neutral object identity", () =>
{
    var source = Source(); var chapter = Chapter(source); var entities = chapter["entities"]!.AsArray();
    var entity = entities.First(item => item!["kind"]!.GetValue<string>() == "object")!.DeepClone();
    entity["id"] = "object.NeutralFixture"; entity["name"] = "Fixture"; entity["aliases"] = new JsonArray();
    entity["properties"]!["space"]!["value"] = "world:room.Hall";
    entity["properties"]!["presentation_anchor"] = new JsonObject { ["type"] = "boolean", ["value"] = true };
    entities.Add(entity);
    var site = chapter["sites"]![0]!; site["room"] = "world:room.Logistics"; site["thing"] = "world:object.NeutralFixture";
    Assert(Chapter2AuthoredSites.ReadAll(source.ToJsonString()).First().Thing == "world:object.NeutralFixture");
    entity["properties"]!["presentation_anchor"]!["value"] = false;
    Reject(() => Chapter2AuthoredSites.ReadAll(source.ToJsonString()), "Site room differs");
});
Console.WriteLine($"Presentation: {checks} checks, {failures} failures");
return failures == 0 ? 0 : 1;
