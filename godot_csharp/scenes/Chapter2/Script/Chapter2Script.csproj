<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>DualOntologyWorldEngine.Chapter2.Prototype</RootNamespace>
    <AssemblyName>Chapter2Script</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StoryPython Condition="'$(StoryPython)' == ''">python</StoryPython>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Chapter2Script.cs" />
    <EmbeddedResource Include="generated_chapter_02.json" LogicalName="generated_chapter_02.json" />
    <Compile Include="../Prototype/*.cs" Exclude="../Prototype/Program.cs" />
    <ProjectReference Include="../../Shared/Story/ChapterRuntime.csproj" />
    <ProjectReference Include="../../../../csharp/DualOntologyWorldEngine.Core.csproj" />
  </ItemGroup>
  <Target Name="CheckUnifiedStory" BeforeTargets="BeforeBuild">
    <Exec Command="&quot;$(StoryPython)&quot; &quot;$(MSBuildThisFileDirectory)..\..\..\tools\compile_story.py&quot; --check"
          WorkingDirectory="$(MSBuildThisFileDirectory)" />
  </Target>
</Project>
