site(id="stock", map="granary", room=logistics, title="存粮", thing=granary)
site(id="empty_bowl", map="clinic", room=clinic, title="莫兰床边的碗", thing=bowl)
site(id="reagent", map="clinic", room=clinic, title="试剂柜", thing=medcab, lore="白漆试剂柜，标签写着“白塔”。有一格空着。\n茉拉把柜门关得很紧，不让人碰。")
site(id="central_notice", map="central_hall", room=hall, title="中央厅公告板", thing=board_hall)
site(id="mouthpiece", map="central_hall", room=hall, title="铜口", kind="tube", lore="铜牌上刻着一行字：\n入夜后，名录库中若有人以你之名唤你，勿应。")
site(id="relay", map="central_hall", room=hall, title="传声中继", lore="一根铜柱，管道从四面汇进来。\n要开名录库的门，这里得有人按拍子转发信号。")
site(id="watch_point", map="central_hall", room=hall, title="守夜点", kind="watch")
site(id="blackboard", map="lecture", room=lecture, title="黑板", thing=blackboard)
site(id="timetable", map="lecture", room=lecture, title="讲堂门外的公告", thing=board_lecture)
site(id="lock_core", map="archive", room=archive, title="名录库之门", thing=archive_door)
site(id="seal_boxes", map="archive", room=archive, title="封存匣", lore="门缝里看得见架子。十六只封存匣排在四座架上，每只贴着名字。\n你的名字也在其中一只上。")
site(id="name_warning", map="archive", room=archive, title="门边的铜牌", lore="铜牌上刻着一行字：\n入夜后，名录库中若有人以你之名唤你，勿应。")
site(id="red_ink", map="archive", room=archive, title="规程页的红墨批注", lore="文献规程页的页边，一行红墨批注：“授钥：雀。”字迹端正，是导师的手。\n库门锁芯与那把钥匙的齿上，都没有撬过的痕迹。")
site(id="watch_point", map="archive", room=archive, title="守夜点", kind="watch")
site(id="hall_notice", map="living_hall", room=dorm_life, title="起居厅公告板", thing=board_life)
site(id="fireplace", map="living_hall", room=dorm_life, title="壁炉", lore="壁炉还温着。炉台上摆着十六只杯子，样式都不一样。")
site(id="watch_point", map="living_hall", room=dorm_life, title="守夜点", kind="watch")
site(id="zone_rules", map="zone_yi", room=dorm_life, title="公告框（学园守则）", kind="school_rules", lore="一、封存之物，可凭对应之物寻回；寻回者，自负其果。\n二、饮水、炉火、照明照常供给；物资由诸位自行分配。\n三、外闩所封之处，余患未清，清后即启。\n四、我所立之规，皆张贴于此。")
site(id="bed", map="zone_yi", room=dorm_life, title="你的床（R-05）", kind="bed")
site(id="zone_rules", map="zone_jia", room=dorm_w, title="甲区公告", thing=board_w)
site(id="litter", map="zone_jia", room=dorm_w, title="雀儿房里的废纸篓", thing=litter_w)
site(id="zone_rules", map="zone_bing", room=dorm_s, title="丙区公告", thing=board_s)
site(id="zone_rules", map="zone_ding", room=dorm_l, title="丁区公告", thing=board_l)
site(id="step_marks", map="resonance", room=dorm_life, title="沉静室门内的步位标线", lore="门内地上的步位标线，一道不缺，一步也没有踩乱。")
site(id="silent_door", map="resonance", room=dorm_life, title="沉静室的门", lore="厚木门，内侧有一道浅浅的指痕。门是从外面关上的。")
site(id="valve", map="greenhouse", room=greenhouse, title="阀门", thing=valve, lore="温室的水压阀门。锈住了。")
site(id="gauge", map="greenhouse", room=greenhouse, title="压力表", thing=gauge, lore="压力表的指针贴着红线。没有人在修。")
site(id="oath_court", map="campus_s", room=oath, title="誓约庭", thing=stele, lore="铺石顺坡，设了几级台阶。站在这里，谁站在谁身边，一眼看得清。")
site(id="gate", map="campus_s", room=oath, title="门楼", lore="门楼外是去港口的路。沿海崖有一段塌了。")
site(id="drying_yard", map="campus_s", room=oath, title="晾晒场", lore="绳上晾着几件衬衫。地上是泥。")
site(id="spring", map="campus_s", room=oath, title="汲水泉", lore="泉水照常在流。")

