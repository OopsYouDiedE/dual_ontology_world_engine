chapter(id="chapter2", requires=["awakening"])

ui_text(
    replay_title="那一夜重演",
    replay_hint="设定第 2 日夜里的处境与人心，让那一夜重演一次。谁做了什么，由各人自己的认知推出。",
    finding_titles=["台账", "粮仓门闩", "诊疗所的碗", "甲区的废纸篓", "贝尔特朗夜巡所见"],
    confront_questions=[
        "台账上的缺口，有一份，是谁取的？为何取？",
        "其余的呢？",
        "夜里有人动过粮仓的门。",
        "那台账上，为何不见记录？",
    ],
    hungry="你饿得发虚。这个下午做不了要紧的事。（按 T 让它过去）",
    bed_early="还不到睡的时候。",
    watch_early="守夜点。入夜后，可以在这里守着。",
    meal_closed="配给台。午间和傍晚开粮。",
)

requests([
    {"label": "修粮仓的门闩", "job": "RepairLatch"},
    {"label": "去台账上补记", "job": "Inform"},
    {"label": "给饿着的人送一份口粮", "job": "FeedWeak"},
    {"label": "去诊疗所照看病人", "job": "Care"},
    {"label": "夜里守着名录库", "job": "GuardArchive"},
])

