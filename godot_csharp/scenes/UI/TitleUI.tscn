[sub_resource type="Shader" id="book_light_shader"]
code = "shader_type canvas_item;
// Smooth independent cover lighting. The background is a baked photographic layer.
uniform float flicker_intensity = 0.96;

void fragment() {
	vec4 base = texture(TEXTURE, UV) * COLOR;
	float falloff = exp(-distance(SCREEN_UV, vec2(0.04, 0.27)) * 1.4);
	vec3 light = mix(vec3(0.67, 0.69, 0.71), vec3(1.12, 1.05, 0.94), falloff * flicker_intensity);
	float grain = fract(sin(dot(floor(UV * vec2(580.0, 820.0)), vec2(12.9898, 78.233))) * 43758.5453);
	float ink = 1.0 - smoothstep(0.12, 0.5, dot(base.rgb, vec3(0.299, 0.587, 0.114)));
	base.rgb *= light * (1.0 + ink * (grain - 0.5) * 0.055);
	COLOR = base;
}
"

[sub_resource type="ShaderMaterial" id="book_light_material"]
