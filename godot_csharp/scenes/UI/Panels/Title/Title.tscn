[sub_resource type="Shader" id="book_light_shader"]
code = "shader_type canvas_item;
// 册子表面的灯光：按屏幕坐标乘上七级抖色的光照图（tools/build_ui_desk.py 生成）。
uniform sampler2D light : filter_nearest;

void fragment() {
	COLOR *= texture(light, SCREEN_UV);
}
"

