; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Dual Ontology World Engine"
run/main_scene="res://scenes/Host/Main.tscn"
config/features=PackedStringArray("4.6", "C#")

[autoload]

GameLocale="*res://scenes/Shared/Locale/LocaleSettings.gd"
GameAudio="*res://scenes/Shared/Audio/GameAudio.gd"
GameSettings="*res://scenes/Shared/Settings/GameSettings.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=992
window/size/window_width_override=1280
window/size/window_height_override=992
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="DualOntologyWorldEngine"

[editor_plugins]

enabled=PackedStringArray()

