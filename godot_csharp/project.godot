; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Dual Ontology World Engine"
run/main_scene="res://scenes/Title/Title.tscn"
config/features=PackedStringArray("4.6", "C#")

[autoload]

DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
GameLocale="*res://scenes/FirstAwakening/LocaleSettings.gd"

[dialogue_manager]

runtime/advanced/uses_dotnet=true

[display]

window/size/viewport_width=960
window/size/viewport_height=640
window/size/window_width_override=960
window/size/window_height_override=640
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="DualOntologyWorldEngine"

[editor_plugins]

enabled=PackedStringArray("res://addons/rpg_asset_adapter/plugin.cfg", "res://addons/dialogue_manager/plugin.cfg")

[internationalization]

locale/translations=PackedStringArray("res://scenes/FirstAwakening/i18n/first_awakening_ui.zh_CN.translation", "res://scenes/FirstAwakening/i18n/first_awakening_ui.en.translation", "res://scenes/FirstAwakening/i18n/first_awakening_ui.ja.translation", "res://scenes/FirstAwakening/i18n/en.po", "res://scenes/FirstAwakening/i18n/ja.po", "res://scenes/FirstAwakening/i18n/dialogue_names.zh_CN.translation", "res://scenes/FirstAwakening/i18n/dialogue_names.en.translation", "res://scenes/FirstAwakening/i18n/dialogue_names.ja.translation", "res://scenes/FirstAwakening/i18n/mind_ui.zh_CN.po", "res://scenes/FirstAwakening/i18n/mind_ui.en.po", "res://scenes/FirstAwakening/i18n/mind_ui.ja.po", "res://scenes/FirstAwakening/i18n/mind_language.zh_CN.translation", "res://scenes/FirstAwakening/i18n/mind_language.en.translation", "res://scenes/FirstAwakening/i18n/mind_language.ja.translation", "res://scenes/FirstAwakening/i18n/replay_ui.zh_CN.translation", "res://scenes/FirstAwakening/i18n/replay_ui.en.translation", "res://scenes/FirstAwakening/i18n/replay_ui.ja.translation")
locale/translations_pot_files=PackedStringArray("res://scenes/Awakening/awakening.dialogue")
locale/fallback="zh_CN"

[rendering]

environment/defaults/default_clear_color=Color(0.0901961, 0.12549, 0.14902, 1)
