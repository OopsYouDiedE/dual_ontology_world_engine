@page "/"
@implements IDisposable
<PageTitle>@I18n.T("AppTitle")</PageTitle>
<div class="zoo">
    <header>
        <div>
            <small>@I18n.T("Subtitle")</small>
            <h1>@I18n.T("MainHeading")</h1>
        </div>
        <div style="display:flex;align-items:center;gap:16px;">
            <div class="lang-selector">
                <label style="margin-right:6px;">🌐 @I18n.T("Language"):</label>
                <select value="@I18n.Current" @onchange="OnLanguageChanged">
                    <option value="@Lang.En">English</option>
                    <option value="@Lang.Ja">日本語</option>
                    <option value="@Lang.ZhHans">简体中文</option>
                    <option value="@Lang.ZhHant">繁體中文</option>
                </select>
            </div>
            <div class="clock">
                @I18n.TClock(W.Now) <small>@(W.Open ? I18n.T("OpenStatus") : I18n.T("ClosedStatus"))</small>
            </div>
        </div>
    </header>

    <nav class="sim-nav">
        <button @onclick="() => Advance(10)">@I18n.T("Adv10Min")</button>
        <button @onclick="() => Advance(60)">@I18n.T("Adv1Hour")</button>
        <button @onclick="Toggle">@(playing || busy ? I18n.T("Pause") : I18n.T("ContinuousRun"))</button>
        <button @onclick="() => Advance((Math.Floor(W.Now / 1440) + 1) * 1440 + 480 - W.Now)">@I18n.T("AdvNextDay")</button>
        <label>@I18n.T("InitialVisitors") <input type="number" min="0" max="500" @bind="visitors" /></label>
        <label>@I18n.T("Seed") <input type="number" @bind="seed" /></label>
        <button @onclick="Reset">@I18n.T("RebuildWorld")</button>
    </nav>

    <p class="status" role="status">@status</p>

    <!-- 4 个主 Tab 导航 -->
    <div class="tabs-nav">
        <button class="tab-btn @(activeTab == 0 ? "active" : "")" @onclick="() => activeTab = 0">
            @I18n.T("Tab1")
        </button>
        <button class="tab-btn @(activeTab == 1 ? "active" : "")" @onclick="() => activeTab = 1">
            @I18n.T("Tab2")
        </button>
        <button class="tab-btn @(activeTab == 2 ? "active" : "")" @onclick="() => activeTab = 2">
            @I18n.T("Tab3")
        </button>
        <button class="tab-btn @(activeTab == 3 ? "active" : "")" @onclick="() => activeTab = 3">
            @I18n.T("Tab4")
        </button>
    </div>

    @if (activeTab == 0)
    {
        <!-- Tab 1: 总体概览 -->
        <div class="tab-pane">
            <div class="metrics">
                <span>@I18n.T("CurrentVisitors") <b>@W.InPark</b></span>
                <span>@I18n.T("PeakVisitors") <b>@W.PeakVisitors</b></span>
                <span>@I18n.T("Escaped") <b>@W.People.Count(p => p.Outcome == "成功逃离")</b></span>
                <span>@I18n.T("ActiveRules") <b>@W.Rules.Clauses.Count</b></span>
                <span>@I18n.T("WalkingSpeed") <b>@I18n.T("SpeedUnit")</b></span>
            </div>

            <p class="outcome-summary">@string.Join("；", W.People.GroupBy(p => p.Outcome).Select(g => $"{I18n.TOutcome(g.Key)} {I18n.T("PeopleCount", g.Count())}"))</p>

            <details class="section-details">
                <summary>@I18n.T("CrossDayStats")</summary>
                <p>@string.Join("；", W.DailyAdmissions.Select(d => I18n.T("DayAdmission", d.Key + 1, d.Value)))</p>
                <p>@I18n.T("BlackStaff", W.Anomalies.BlackBirths)；@I18n.T("RedStaffReturn", W.People.Where(p => p.DutyRoom == "水母区").Sum(p => p.Returns))</p>
            </details>

            <details class="section-details" open>
                <summary>@I18n.T("ItsBehavior")</summary>
                <p>@I18n.T("ItsLocation")<b>@I18n.TRoom(W.Anomalies.ItsLocation)</b>；@I18n.T("ItsNextAction")@W.Anomalies.ItsIntention</p>
                <p>@W.Anomalies.ItsReason</p>
                <p>@I18n.T("ItsNextThink", W.Anomalies.NextAnomaly)</p>
                <details>
                    <summary>@I18n.T("ItsClassificationLog")</summary>
                    <div class="log" style="max-height:160px;">
                        @foreach (var line in W.Anomalies.Classifications.TakeLast(15))
                        {
                            <div>@line</div>
                        }
                    </div>
                </details>
            </details>

            <div class="overview-grid">
                <div>
                    <h2>@I18n.T("ParkSites") <small>@I18n.T("ObjectiveViewHint")</small></h2>
                    <div class="rooms">
                        @foreach (var room in W.Rooms.Values.Where(r => r.TrueName != "园外"))
                        {
                            <button class="room @(tracked?.Room == room ? "active" : "")" @onclick="() => SelectRoom(room)">
                                <strong>@I18n.TRoom(room.TrueName)</strong>
                                <span>@I18n.T("PeopleCount", W.People.Count(p => p.Room == room && p.Outcome == "在园"))</span>
                                <small>@(room.Value(Z.Danger) > 0 ? I18n.T("VisibleDanger") : "") @(room.Value(Z.Calm) > 0 ? I18n.T("CalmUtterance") : "")</small>
                            </button>
                        }
                    </div>
                </div>
                <div>
                    <h2>@I18n.T("EventLog") <small>@I18n.T("Recent30")</small></h2>
                    <div class="log" style="max-height: 480px;">
                        @foreach (var entry in W.Events.TakeLast(30).Reverse())
                        {
                            <div>@entry</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else if (activeTab == 1)
    {
        <!-- Tab 2: 检查总的规则和言灵 -->
        <div class="tab-pane">
            <div class="rules-grid">
                <div class="card">
                    <h2>@I18n.T("RuleMgmt") <small>@I18n.T("ControlledChinese")</small></h2>
                    <p>@I18n.T("RuleDesc")</p>
                    
                    <label>@I18n.T("SelectExistingRule")
                        <select class="wide" @onchange="LoadRule">
                            @foreach (var clause in W.Rules.Clauses.Values)
                            {
                                <option value="@clause.Key" selected="@(clause.Key == key)">
                                    @clause.Key · @(clause.Original.Length > 40 ? clause.Original[..40] + "…" : clause.Original)
                                </option>
                            }
                        </select>
                    </label>

                    <p class="original">@I18n.T("OriginalText")@W.Rules.Clauses.GetValueOrDefault(key)?.Original</p>
                    <label>@I18n.T("RuleCode")<input class="wide" aria-label="Rule Key" @bind="key" /></label>
                    <label>@I18n.T("RuleScript")<textarea aria-label="Rule Script" @bind="script" style="min-height:90px;"></textarea></label>

                    <div class="word-group">
                        <small>@I18n.T("ClickRuleSkeleton")</small>
                        <div class="chips">
                            <button type="button" class="chip" @onclick='() => SetScript("当 总是 时 优先 前往:入口 权重 200")'>@I18n.T("Skeleton1")</button>
                            <button type="button" class="chip" @onclick='() => SetScript("当 危险 时 优先 前往:狮子园区 权重 150")'>@I18n.T("Skeleton2")</button>
                            <button type="button" class="chip" @onclick='() => SetScript("当 兔区 时 禁止 喂兔子 权重 100")'>@I18n.T("Skeleton3")</button>
                            <button type="button" class="chip" @onclick='() => SetScript("当 迷路 时 优先 求助 权重 130")'>@I18n.T("Skeleton4")</button>
                        </div>
                        <small>@I18n.T("ClickCommonCond")</small>
                        <div class="chips">
                            @foreach (var fact in new[] { "总是", "危险", "兔区", "象区", "狮区", "馆内", "迷路", "成年", "有地图", "有纸", "有兔玩偶", "出逃兔子" })
                            {
                                <button type="button" class="chip sub" @onclick="() => AppendScript(fact)">@fact</button>
                            }
                        </div>
                        <small>@I18n.T("ClickCommonAction")</small>
                        <div class="chips">
                            @foreach (var act in new[] { "前往:入口", "前往:主步道", "前往:狮子园区", "前往:大象园区", "前往:饮料店", "前往:海洋馆", "前往:园外", "游览", "休息", "阅读", "撕地图", "喂兔子", "买兔玩偶", "换黑衣", "求助", "坚定人类" })
                            {
                                <button type="button" class="chip sub" @onclick="() => AppendScript(act)">@act</button>
                            }
                        </div>
                    </div>

                    <div class="actions">
                        <button @onclick="Publish">@I18n.T("SaveRule")</button>
                        <button @onclick="Broadcast">@I18n.T("SaveAndBroadcast")</button>
                        <button @onclick="Withdraw">@I18n.T("WithdrawAndBroadcast")</button>
                        <button @onclick="WithdrawLocal">@I18n.T("WithdrawLocalOnly")</button>
                    </div>

                    <p class="status-tip">@I18n.T("RuleRememberedTip", W.People.Count(p => p.Outcome == "在园" && p.Books.ContainsKey(key)))</p>
                    
                    <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin:10px 0;">
                        <label>@I18n.T("PersonAttitude")
                            <select @bind="acceptance">
                                @foreach (var a in Enum.GetValues<Truth>())
                                {
                                    <option value="@a">@(a == Truth.True ? I18n.T("TruthTrue") : a == Truth.False ? I18n.T("TruthFalse") : I18n.T("TruthUnknown"))</option>
                                }
                            </select>
                        </label>
                        <label>@I18n.T("UnderstandingLevel")
                            <input type="number" min="0" max="100" @bind="understanding" style="width:65px;" />%
                        </label>
                        <button @onclick="ChangeUnderstanding">@I18n.T("UpdateUnderstanding")</button>
                    </div>

                    <details>
                        <summary>@I18n.T("ViewRememberedClauses")</summary>
                        @if (tracked is {} reader)
                        {
                            <div class="books">
                                @foreach (var book in reader.Books.Values)
                                {
                                    <details>
                                        <summary>@book.Text.Key · @(book.Acceptance == Truth.True ? I18n.T("TruthTrue") : book.Acceptance == Truth.False ? I18n.T("TruthFalse") : I18n.T("TruthUnknown")) · @I18n.T("UnderstandingLevel") @book.Understanding%</summary>
                                        <p>@book.Text.Script</p>
                                    </details>
                                }
                            </div>
                        }
                    </details>
                </div>

                <div class="card">
                    <h2>@I18n.T("UtteranceMgmt") <small>@I18n.T("DirectIntervention")</small></h2>
                    <p>@I18n.T("UtteranceDesc")</p>
                    
                    <label>@I18n.T("UtteranceAst")
                        <textarea aria-label="Utterance AST" @bind="utterance" style="min-height:90px;"></textarea>
                    </label>

                    <div class="word-group">
                        <small>@I18n.T("ClickUtteranceTpl")</small>
                        <div class="chips">
                            <button type="button" class="chip" @onclick='() => SetUtterance("temporary_set($Scene, 树荫, 0, 15)")'>@I18n.T("Tpl1")</button>
                            <button type="button" class="chip" @onclick='() => SetUtterance("temporary_set($Scene, 危险, 1, 20)")'>@I18n.T("Tpl2")</button>
                            <button type="button" class="chip" @onclick='() => SetUtterance("temporary_set($Actor, 迷路, 1, 15)")'>@I18n.T("Tpl3")</button>
                        </div>
                    </div>

                    <div class="actions">
                        <button @onclick="Cast">@I18n.T("ParseAndCast")</button>
                        <small style="align-self:center;">@I18n.T("RemainingMana", tracked?.Body.Value(Z.Mana) ?? 0)</small>
                    </div>

                    <div style="margin-top: 16px; padding: 10px; background: #13201b; border-radius: 6px; border: 1px solid #2d4237;">
                        <strong>@I18n.T("RoomTempEffects")</strong>
                        <p style="margin:6px 0 0 0; color:#d1fae5;">
                            @string.Join("；", tracked?.Room?.Get<TemporaryStateProperty>()?.Active.Select(l => $"{l.Tag.Name}={l.Value} ({l.ExpiresAt:F1})") ?? [I18n.T("NoTempEffects")])
                        </p>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (activeTab == 2)
    {
        <!-- Tab 3: 脑内世界观察和编辑器 -->
        <div class="tab-pane">
            <div class="explain-bar">
                <strong>@I18n.T("MindMechanismExplain")</strong>
                <span>@I18n.T("MindMechanismText")</span>
            </div>

            <div class="person-selector-bar">
                <label><strong>@I18n.T("CurrentTrackedPerson")</strong></label>
                <select class="wide" @onchange="Pick" style="max-width: 450px;">
                    @foreach (var p in W.People)
                    {
                        <option value="@p.Body.TrueName" selected="@(p == tracked)">
                            @p.Body.TrueName · @I18n.TJob(p.Job) · @I18n.TOutcome(p.Outcome)
                        </option>
                    }
                </select>
            </div>

            @if (tracked is {} person)
            {
                <div class="mind-grid">
                    <!-- 左列：人物主客观状态透视与认知地图 -->
                    <div>
                        <div class="card">
                            <h2>@I18n.T("RealityVsMind") <small>@I18n.T("SubtitleRealityVsMind")</small></h2>
                            <div class="profile-box">
                                <div class="profile-col">
                                    <h3 class="col-title reality">@I18n.T("ObjectiveReality")</h3>
                                    <p>@I18n.T("TrueSpecies")<b>@person.TrueSpecies</b></p>
                                    <p>@I18n.T("BodyRabbit")<b>@person.Body.Value(Z.Rabbit)%</b></p>
                                    <p>@I18n.T("PhysLocation")<b>@I18n.TRoom(person.Room?.TrueName)</b></p>
                                    <p>@I18n.T("PaperProtection")<b>@(W.Anomalies.Paper(person) != null ? I18n.T("HasPaper") : I18n.T("NoPaper"))</b></p>
                                    <p>@I18n.T("ItsClassified")@(person.LastClassified < 0 ? I18n.T("NotClassified") : person.ItsClassification?.ToString() ?? I18n.T("Unclassifiable"))</p>
                                </div>
                                <div class="profile-col">
                                    <h3 class="col-title mind">@I18n.T("SubjectiveMind")</h3>
                                    <p>@I18n.T("HumanBelief")<b>@person.Self.Value(Z.Human)%</b></p>
                                    <p>@I18n.T("BelievedLocation")<b>@I18n.TRoom(person.Self.Parent?.Name)</b></p>
                                    <p>@I18n.T("OngoingAction")<b>@person.CurrentAction</b></p>
                                    <p>@I18n.T("LastResult")<b>@person.LastActionResult</b></p>
                                </div>
                            </div>

                            <!-- 认知调节与出口导航机制面板 -->
                            <div class="cog-panel" style="margin-top:14px;">
                                <div class="cog-header">
                                    <strong>@I18n.T("CognitionSliderTitle")</strong>
                                    <span class="cog-badge @(person.Self.Value(Z.Human) >= 50 ? "good" : "bad")">
                                        @(person.Self.Value(Z.Human))% · @(person.Self.Value(Z.Human) >= 50 ? I18n.T("CognitionClear") : I18n.T("CognitionBroken"))
                                    </span>
                                </div>
                                <div class="cog-controls">
                                    <input type="range" min="0" max="100" value="@(person.Self.Value(Z.Human))" @onchange="OnCognitionSliderChanged" />
                                    <button type="button" @onclick="() => SetClarity(100)">@I18n.T("SetClearBtn")</button>
                                    <button type="button" @onclick="() => SetClarity(30)">@I18n.T("SetLostBtn")</button>
                                </div>
                                <div class="cog-status @(person.Self.Value(Z.Human) >= 50 ? "good" : "bad")">
                                    <strong>@I18n.T("ExitPathfindingStatus")</strong>@(ZooMinds.Route(person.Soul.World, person.Self, "园外") != null ? I18n.T("ExitCanFind") : I18n.T("ExitCannotFind"))
                                    <small>@(person.Self.Value(Z.Human) >= 50 ? I18n.T("ExitDescClear") : I18n.T("ExitDescBroken"))</small>
                                </div>
                            </div>
                        </div>

                        <div class="card" style="margin-top: 16px;">
                            <h2>@I18n.T("ActualTravelLog")</h2>
                            <div class="log" style="max-height: 180px;">
                                @foreach (var travel in W.Travels.Where(t => t.Person == person.Body.TrueName).TakeLast(15).Reverse())
                                {
                                    <p style="margin:2px 0;">@travel.Time.ToString("F1")：@I18n.TRoom(travel.From) → @I18n.TRoom(travel.To)（@travel.Minutes @I18n.T("MinUnit")）</p>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- 右列：直观易懂的脑内世界干预编辑器 -->
                    <div>
                        <div class="card">
                            <h2>@I18n.T("MindInterventionTitle") <small>@I18n.T("MindInterventionSub")</small></h2>

                            <!-- 分类筛选器 -->
                            <div class="filter-bar">
                                <small style="display:block;margin-bottom:4px;color:#9cb5a6;">@I18n.T("SelectMemoryType")</small>
                                <div class="chips">
                                    <button type="button" class="chip @(mentalFilter == "All" ? "active" : "")" @onclick='() => SetMentalFilter("All")'>@I18n.T("AllMemories", person.Soul.World.Projections.Length)</button>
                                    <button type="button" class="chip @(mentalFilter == "Space" ? "active" : "")" @onclick='() => SetMentalFilter("Space")'>@I18n.T("FilterSpace")</button>
                                    <button type="button" class="chip @(mentalFilter == "Boundary" ? "active" : "")" @onclick='() => SetMentalFilter("Boundary")'>@I18n.T("FilterBoundary")</button>
                                    <button type="button" class="chip @(mentalFilter == "Body" ? "active" : "")" @onclick='() => SetMentalFilter("Body")'>@I18n.T("FilterBody")</button>
                                    <button type="button" class="chip @(mentalFilter == "Object" ? "active" : "")" @onclick='() => SetMentalFilter("Object")'>@I18n.T("FilterObject")</button>
                                    <button type="button" class="chip @(mentalFilter == "Concept" ? "active" : "")" @onclick='() => SetMentalFilter("Concept")'>@I18n.T("FilterConcept")</button>
                                </div>
                            </div>

                            <!-- 目标对象下拉列表 -->
                            <div style="margin: 12px 0;">
                                <label>@I18n.T("SelectMentalTarget")
                                    <select class="wide" aria-label="Mental Object" @onchange="SelectMental">
                                        @foreach (var item in FilteredProjections)
                                        {
                                            <option value="@item.index" selected="@(item.p == mental)">
                                                @item.p.Name · @item.p.Kind @(item.p.Existence != Truth.True ? $"[{item.p.Existence}]" : "")
                                            </option>
                                        }
                                    </select>
                                </label>
                            </div>

                            @if (mental is {} currentTarget)
                            {
                                <!-- 场景化一键干预动作卡片 -->
                                <div class="quick-intervene-box">
                                    <div style="display:flex;justify-content:space-between;align-items:center;">
                                        <strong style="color:#d9ecbc;">@I18n.T("CurrentSelected")@currentTarget.Name <small style="color:#8ea899;">(@currentTarget.Kind)</small></strong>
                                        <span class="badge @(currentTarget.Existence == Truth.True ? "good" : "bad")">
                                            @(currentTarget.Existence == Truth.True ? I18n.T("ExistsInMind") : currentTarget.Existence == Truth.False ? I18n.T("NotExistsInMind") : I18n.T("DoubtInMind"))
                                        </span>
                                    </div>

                                    <div class="intervention-actions">
                                        @if (currentTarget.Kind == ProjectionKind.Space)
                                        {
                                            <button type="button" class="action-btn warning" @onclick="QuickSetDanger">@I18n.T("ActionFakeDanger")</button>
                                            <button type="button" class="action-btn success" @onclick="QuickSetSafe">@I18n.T("ActionFakeSafe")</button>
                                        }
                                        else if (currentTarget.Kind == ProjectionKind.Boundary)
                                        {
                                            @if (currentTarget.Existence == Truth.True)
                                            {
                                                <button type="button" class="action-btn danger" @onclick="QuickBlockDoor">@I18n.T("ActionBlockDoor")</button>
                                            }
                                            else
                                            {
                                                <button type="button" class="action-btn success" @onclick="QuickUnblockDoor">@I18n.T("ActionUnblockDoor")</button>
                                            }
                                        }
                                        else if (currentTarget.Kind == ProjectionKind.Body)
                                        {
                                            <button type="button" class="action-btn warning" @onclick="QuickSetRabbitSelf">@I18n.T("ActionRabbitSuggest")</button>
                                            <button type="button" class="action-btn success" @onclick="QuickSetHumanSelf">@I18n.T("ActionHumanAffirm")</button>
                                        }
                                        <button type="button" class="action-btn" @onclick="ForgetMental">@I18n.T("ActionForget")</button>
                                        <button type="button" class="action-btn" @onclick="NewMental">@I18n.T("ActionCreateHallucination")</button>
                                    </div>
                                </div>

                                <!-- 高级底层属性编辑 -->
                                <details class="advanced-box" open>
                                    <summary>@I18n.T("AdvancedParams")</summary>
                                    <div style="margin-top:10px;">
                                        <div style="display:flex;gap:10px;margin-bottom:8px;">
                                            <label style="flex:2;">@I18n.T("ParamName")<input class="wide" @bind="mentalName" /></label>
                                            <label style="flex:1;">@I18n.T("ParamKind")
                                                <select class="wide" @bind="mentalKind">
                                                    @foreach (var k in Enum.GetValues<ProjectionKind>())
                                                    {
                                                        <option value="@k">@k</option>
                                                    }
                                                </select>
                                            </label>
                                            <label style="flex:1;">@I18n.T("ParamExistence")
                                                <select class="wide" @bind="mentalExistence">
                                                    @foreach (var t in Enum.GetValues<Truth>())
                                                    {
                                                        <option value="@t">@(t == Truth.True ? I18n.T("TruthTrue") : t == Truth.False ? I18n.T("TruthFalse") : I18n.T("TruthUnknown"))</option>
                                                    }
                                                </select>
                                            </label>
                                        </div>

                                        <label>@I18n.T("ParamParent")
                                            <select class="wide" @bind="mentalParentIndex">
                                                <option value="-1">@I18n.T("UnknownParent")</option>
                                                @foreach (var item in person.Soul.World.Projections.Select((v, i) => (v, i)).Where(item => item.v != mental))
                                                {
                                                    <option value="@item.i">@item.v.Name</option>
                                                }
                                            </select>
                                        </label>

                                        <label style="margin-top:8px;display:block;">@I18n.T("ParamTags")
                                            <textarea aria-label="Mental Tags" @bind="mentalTags" style="min-height:75px;"></textarea>
                                        </label>

                                        <div class="word-group">
                                            <small>@I18n.T("ClickAppendTag")</small>
                                            <div class="chips">
                                                <button type="button" class="chip" @onclick='() => AppendMentalTag("人类信念=100")'>人类信念=100</button>
                                                <button type="button" class="chip" @onclick='() => AppendMentalTag("人类信念=20")'>人类信念=20</button>
                                                <button type="button" class="chip" @onclick='() => AppendMentalTag("危险征兆=1")'>危险征兆=1</button>
                                                <button type="button" class="chip" @onclick='() => AppendMentalTag("身体兔化=80")'>身体兔化=80</button>
                                                <button type="button" class="chip" @onclick='() => AppendMentalTag("迷路=1")'>迷路=1</button>
                                                <button type="button" class="chip" @onclick='() => AppendMentalTag("树荫=1")'>树荫=1</button>
                                            </div>
                                        </div>

                                        <details style="margin:8px 0;">
                                            <summary>@I18n.T("EditTopology")</summary>
                                            <div style="display:flex;gap:8px;margin:8px 0;flex-wrap:wrap;">
                                                <input aria-label="Relation Name" @bind="relationName" placeholder="关系名" style="width:100px;" />
                                                <select @bind="relationOtherIndex">
                                                    @foreach (var item in person.Soul.World.Projections.Select((v, i) => (v, i)))
                                                    {
                                                        <option value="@item.i">@item.v.Name</option>
                                                    }
                                                </select>
                                                <select @bind="relationTruth">
                                                    @foreach (var t in Enum.GetValues<Truth>())
                                                    {
                                                        <option value="@t">@(t == Truth.True ? I18n.T("TruthTrue") : t == Truth.False ? I18n.T("TruthFalse") : I18n.T("TruthUnknown"))</option>
                                                    }
                                                </select>
                                                <button @onclick="SaveRelation">写入关系</button>
                                            </div>
                                        </details>

                                        <details style="margin:8px 0;">
                                            <summary>@I18n.T("WriteAstRule")</summary>
                                            <textarea aria-label="Mental Rule AST" @bind="mentalRule" style="min-height:60px;"></textarea>
                                            <button @onclick="SaveBelief" style="margin-top:6px;">@I18n.T("AcceptAst")</button>
                                        </details>

                                        <button @onclick="SaveMental" style="width:100%;margin-top:8px;background:#244434;font-weight:bold;padding:10px;">
                                            @I18n.T("SaveMentalBtn")
                                        </button>
                                    </div>
                                </details>
                            }

                            <!-- 决策与行动触发组 -->
                            <div class="actions" style="margin-top:16px;border-top:1px solid #283e33;padding-top:12px;">
                                <button @onclick="Preview">@I18n.T("PreviewDecision")</button>
                                <button @onclick="ActFromMind" style="border-color:#eab308;color:#fde047;font-weight:bold;">
                                    @I18n.T("ReplanAction")
                                </button>
                                <button @onclick="ObserveAgain">@I18n.T("ObserveAgain")</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else if (activeTab == 3)
    {
        <!-- Tab 4: 检查该人物的决策优先级和比较 -->
        <div class="tab-pane">
            <div class="person-selector-bar">
                <label><strong>@I18n.T("TargetPersonAnalyze")</strong></label>
                <select class="wide" @onchange="Pick" style="max-width: 450px;">
                    @foreach (var p in W.People)
                    {
                        <option value="@p.Body.TrueName" selected="@(p == tracked)">
                            @p.Body.TrueName · @I18n.TJob(p.Job) · @I18n.TOutcome(p.Outcome)
                        </option>
                    }
                </select>
            </div>

            @if (tracked is {} assessed)
            {
                <div class="card" style="margin-bottom:16px;">
                    <h2>@I18n.T("DecisionDiff") <small>@I18n.T("DecisionDiffSub")</small></h2>
                    <div class="compare">
                        <div>
                            <h3>@I18n.T("SnapshotBefore")</h3>
                            <pre>@beforeDecision</pre>
                        </div>
                        <div>
                            <h3>@I18n.T("SnapshotAfter")</h3>
                            <pre>@afterDecision</pre>
                        </div>
                    </div>
                </div>

                <div class="decisions-grid">
                    <div class="card">
                        <h2>@I18n.T("CandidateActions") <small>@I18n.T("ForbiddenIncluded")</small></h2>
                        <div class="log" style="max-height: 420px;">
                            @foreach (var row in assessed.Assessments)
                            {
                                <div style="padding:6px 0;">
                                    <strong>
                                        <span class="badge @(row.Forbidden ? "bad" : "good")">@(row.Forbidden ? I18n.T("Forbidden") : I18n.T("Available"))</span>
                                        @I18n.T("Score") @row.Decision.Score · @ZooWorld.Describe(row.Decision.Effect)
                                    </strong>
                                    <small style="display:block;margin-top:3px;color:#a8b7b0;">@I18n.T("Reasons")@string.Join("；", row.Reasons)</small>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="card">
                        <h2>@I18n.T("DecisionTrace") <small>@I18n.T("DecisionTraceSub")</small></h2>
                        <div class="trace" style="max-height: 200px;">
                            @foreach (var entry in assessed.DecisionTrace)
                            {
                                <div>@entry</div>
                            }
                            @if (assessed.DecisionTrace.Count == 0)
                            {
                                <p>@I18n.T("DefaultRoutineTip")</p>
                            }
                        </div>

                        <h2 style="margin-top:16px;">@I18n.T("ObservationHistory") <small>@I18n.T("MentalCountSub", assessed.Soul.World.Projections.Length)</small></h2>
                        <div class="log" style="max-height: 180px;">
                            @foreach (var observation in assessed.Soul.World.History.TakeLast(12).Reverse())
                            {
                                <div style="font-size:12px;">
                                    @observation.Time.ToString("F1") · @observation.Source · <b>@observation.Target.Name</b>
                                    <small style="display:block;opacity:0.8;">@observation.Details</small>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
.zoo{max-width:1500px;margin:auto;padding:24px;color:#d7e0e6;font:14px/1.6 system-ui;background:#101819}
.zoo header{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #43554d;padding-bottom:16px}
.zoo h1{font-size:28px;margin:4px 0}
.zoo small{color:#96b6a6;display:block}
.lang-selector{display:flex;align-items:center;background:#172620;padding:6px 12px;border-radius:6px;border:1px solid #334e40}
.lang-selector select{border:none;background:transparent;color:#d9ecbc;font-weight:bold;cursor:pointer;padding:2px 6px}
.clock{font-size:26px;color:#d9ecbc;text-align:right}
.clock small{font-size:13px}
.sim-nav{display:flex;gap:10px;flex-wrap:wrap;margin:16px 0;align-items:center}
.zoo button,.zoo select,.zoo input,.zoo textarea{background:#1a2827;color:#e5ece8;border:1px solid #53685f;border-radius:5px;padding:8px}
.zoo button{cursor:pointer}
.zoo button:hover{background:#31493b}
.zoo input[type=number]{width:65px}
.status{color:#eacb91;min-height:22px;margin:6px 0}

/* Tabs 导航条 */
.tabs-nav{display:flex;gap:8px;margin:18px 0 16px 0;border-bottom:2px solid #2d4237;padding-bottom:8px;overflow-x:auto}
.tab-btn{background:#14201b;color:#9cb5a6;border:1px solid #2d4237;border-bottom:none;padding:10px 18px;font-size:14px;font-weight:bold;border-radius:6px 6px 0 0;cursor:pointer;transition:all 0.15s ease;white-space:nowrap}
.tab-btn:hover{background:#1e3128;color:#e5ece8}
.tab-btn.active{background:#254133;color:#d9ecbc;border-color:#537562;border-bottom:3px solid #a6e3a1}
.tab-pane{animation:fadeIn 0.15s ease-in-out}
@@keyframes fadeIn{from{opacity:0;transform:translateY(3px)}to{opacity:1;transform:translateY(0)}}

/* 通用卡片与网格 */
.card{background:#15211c;border:1px solid #2e4438;border-radius:8px;padding:16px}
.overview-grid{display:grid;grid-template-columns:1.2fr 1fr;gap:20px;margin-top:16px}
.rules-grid{display:grid;grid-template-columns:1.2fr 1fr;gap:20px}
.mind-grid{display:grid;grid-template-columns:1fr 1.2fr;gap:20px}
.decisions-grid{display:grid;grid-template-columns:1.2fr 1fr;gap:20px}
.person-selector-bar{display:flex;align-items:center;gap:12px;background:#172620;padding:12px 16px;border-radius:8px;border:1px solid #334e40;margin-bottom:16px}

.metrics{display:flex;gap:24px;padding:16px;background:#20342a;border-radius:8px;flex-wrap:wrap}
.metrics b{font-size:20px;margin-left:8px}
.outcome-summary{margin:10px 0;color:#c5d8cb}
.section-details{background:#14201b;border:1px solid #2d4237;border-radius:6px;padding:10px 14px;margin:10px 0}
.section-details summary{cursor:pointer;font-weight:bold;color:#cde0b6}

.zoo h2{font-size:16px;margin:0 0 12px;color:#d9ecbc}
.zoo h2 small{font-size:12px;font-weight:400;color:#8ea899}
.rooms{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.room{text-align:left;min-height:70px}
.room span{display:block}
.room.active{border-color:#cbe9a7;background:#2a4130}
.wide{width:100%;box-sizing:border-box}
.zoo dl{display:grid;grid-template-columns:110px 1fr;gap:8px}
.zoo dd{margin:0;color:#e4edb5}
.zoo dt{color:#91a89a}
.trace,.log,.books{max-height:280px;overflow:auto;background:#111c17;padding:12px;border-left:2px solid #789468;border-radius:4px}
.trace div,.log div{padding:4px 0;border-bottom:1px solid #1f2f26}
.zoo textarea{width:100%;box-sizing:border-box;min-height:80px;margin-top:6px;font:13px/1.6 monospace}
.actions{display:flex;gap:8px;flex-wrap:wrap;margin:10px 0}
.compare{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.compare pre{white-space:pre-wrap;font:12px/1.6 monospace;max-height:240px;overflow:auto;background:#111c17;padding:10px;border-radius:4px}
.original{color:#a8b7b0;font-size:13px;margin:4px 0}
.status-tip{color:#9cb5a6;font-size:13px;margin:8px 0}

/* 认知面板 */
.cog-panel{background:#16241e;border:1px solid #375344;border-radius:8px;padding:12px;margin:14px 0}
.cog-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}
.cog-badge{font-size:12px;padding:3px 8px;border-radius:12px}
.cog-badge.good{background:#1e3c2b;color:#a8f0be;border:1px solid #2d6343}
.cog-badge.bad{background:#3d1a21;color:#fca5a5;border:1px solid #6e2735}
.cog-controls{display:flex;gap:10px;align-items:center}
.cog-controls input[type=range]{flex:1;cursor:pointer}
.cog-status{margin-top:10px;padding:8px 12px;border-radius:6px;font-size:13px}
.cog-status.good{background:#102219;border-left:3px solid #48bb78;color:#d1fae5}
.cog-status.bad{background:#261217;border-left:3px solid #f56565;color:#fecaca}
.cog-status small{display:block;margin-top:4px;opacity:0.85}

/* 快捷词组 Chips */
.word-group{margin:8px 0;background:#111d18;padding:8px 10px;border-radius:6px;border:1px solid #27392f}
.word-group small{color:#9cb5a6;display:block;margin:4px 0 3px}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.chip{background:#1c2d25;border:1px solid #446152;border-radius:4px;color:#d3e3db;padding:3px 7px;font-size:11px;cursor:pointer}
.chip:hover{background:#2c493a;border-color:#7eb196}
.chip.sub{background:#15221b;border-color:#314539;color:#b2c5bc}

.badge{font-size:11px;padding:2px 6px;border-radius:4px;margin-right:4px}
.badge.good{background:#1d3929;color:#a3e8b6}
.badge.bad{background:#3d1820;color:#f87171}

/* Tab 3 特化样式 */
.explain-bar{background:#14231d;border:1px solid #2e473a;border-radius:8px;padding:12px 16px;margin-bottom:16px;color:#c9ded3}
.explain-bar span{font-size:13px;margin-left:4px;color:#b2c5bc}
.profile-box{display:grid;grid-template-columns:1fr 1fr;gap:12px;background:#111c17;padding:12px;border-radius:6px;border:1px solid #283c31}
.profile-col p{margin:4px 0;font-size:13px;color:#d3e0d8}
.col-title{font-size:13px;margin:0 0 8px 0;padding-bottom:4px;border-bottom:1px solid #283c31}
.col-title.reality{color:#7ee787}
.col-title.mind{color:#79c0ff}
.filter-bar{background:#111c17;padding:8px 10px;border-radius:6px;border:1px solid #283c31;margin-bottom:10px}
.chip.active{background:#2c4f3d;color:#d9ecbc;border-color:#5a8a6f;font-weight:bold}
.quick-intervene-box{background:#12211a;border:1px solid #334e40;border-radius:6px;padding:12px;margin:12px 0}
.intervention-actions{display:flex;flex-direction:column;gap:6px;margin-top:10px}
.action-btn{background:#1c2e26;border:1px solid #3b5a4a;color:#d7e5de;padding:7px 12px;border-radius:5px;cursor:pointer;text-align:left;font-size:12px;transition:background 0.15s}
.action-btn:hover{background:#2b473a}
.action-btn.warning{border-left:3px solid #eab308;color:#fef08a}
.action-btn.danger{border-left:3px solid #ef4444;color:#fca5a5}
.action-btn.success{border-left:3px solid #22c55e;color:#bbf7d0}
.advanced-box{background:#101a15;border:1px solid #23352b;border-radius:6px;padding:10px;margin-top:12px}
.advanced-box summary{cursor:pointer;color:#9cb5a6;font-size:13px}

@@media(max-width:960px){
    .overview-grid,.rules-grid,.mind-grid,.decisions-grid{grid-template-columns:1fr}
    .profile-box{grid-template-columns:1fr}
    .rooms{grid-template-columns:repeat(2,1fr)}
}
</style>
@code {
    ZooSimulation simulation=null!;ZooWorld W=>simulation.World;Person? tracked;
    int seed=7,visitors=120;int activeTab=0;string key="Visitor.14",script="当 危险 时 优先 前往:狮子园区 权重 120",status="";
    string mentalFilter="All";
    void SetMentalFilter(string filter)
    {
        mentalFilter=filter;
        var first=FilteredProjections.FirstOrDefault();
        if(first.p!=null)LoadMental(first.p);
    }
    IEnumerable<(Projection p, int index)> FilteredProjections =>
        tracked==null?[]:tracked.Soul.World.Projections
            .Select((v,i)=>(p:v,index:i))
            .Where(item=>mentalFilter=="All"||item.p.Kind.ToString()==mentalFilter);

    void QuickSetDanger(){AppendMentalTag("危险征兆=1");SaveMental();}
    void QuickSetSafe()
    {
        var lines=(mentalTags??"").Split('\n',StringSplitOptions.RemoveEmptyEntries|StringSplitOptions.TrimEntries)
            .Where(l=>!l.StartsWith("危险征兆")&&!l.StartsWith("危险"));
        mentalTags=string.Join("\n",lines);
        AppendMentalTag("树荫=1");
        SaveMental();
    }
    void QuickBlockDoor(){mentalExistence=Truth.False;SaveMental();}
    void QuickUnblockDoor(){mentalExistence=Truth.True;SaveMental();}
    void QuickSetRabbitSelf(){AppendMentalTag("人类信念=10");SaveMental();}
    void QuickSetHumanSelf(){AppendMentalTag("人类信念=100");SaveMental();}
    void OnLanguageChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<Lang>(e.Value?.ToString(), out var l))
        {
            I18n.Current = l;
            status = I18n.T("WorldCreated");
            StateHasChanged();
        }
    }
    bool playing,disposed,busy;int generation;System.Threading.Timer? timer;
    protected override void OnInitialized()=>Reset();
    void Reset(){Stop();generation++;busy=false;simulation?.Dispose();try{simulation=new(seed,visitors,480,"standard");tracked=W.People.FirstOrDefault(p=>p.Job==Job.Visitor)??W.People[0];LoadMental(tracked.Self);beforeDecision="";afterDecision="";status=I18n.T("WorldCreated");}catch(Exception e){status=e.Message;}}
    async Task Advance(double minutes)
    {
        if(busy)return;busy=true;var current=generation;var world=W;var target=world.Now+minutes;
        try
        {
            while(!disposed&&current==generation&&world.Now<target)
            {
                world.Run(target,20);status=I18n.T("AdvancingTo", I18n.TClock(world.Now));
                StateHasChanged();await Task.Delay(1);
            }
            if(current==generation)status=I18n.T("AdvancedTo", I18n.TClock(world.Now));
        }
        catch(Exception e){Stop();status=e.Message;}
        finally{if(current==generation)busy=false;}
    }
    void Toggle(){if(playing||busy){Stop();return;}playing=true;timer=new(_=>InvokeAsync(async ()=>{if(disposed||!playing)return;await Advance(2);StateHasChanged();}),null,0,700);}
    void Stop(){playing=false;timer?.Dispose();timer=null;generation++;busy=false;}
    void SelectRoom(Essence room){tracked=W.People.Where(p=>p.Room==room&&p.Outcome=="在园").OrderBy(p=>p.Job!=Job.Visitor).FirstOrDefault()??tracked;if(tracked!=null)LoadMental(tracked.Self);}
    void Pick(ChangeEventArgs e){tracked=W.People.First(p=>p.Body.TrueName==e.Value?.ToString());LoadMental(tracked.Self);}
    void LoadRule(ChangeEventArgs e){key=e.Value!.ToString()!;script=W.Rules.Clauses[key].Script;}
    Projection? mental;
    string mentalName="",mentalTags="",relationName="通往",mentalRule="RULE true() => PREFER wait(5, inspect($Actor))";
    string utterance="temporary_set($Scene, 树荫, 0, 15)",beforeDecision="",afterDecision="";
    ProjectionKind mentalKind=ProjectionKind.Object;Truth mentalExistence=Truth.True,relationTruth=Truth.True;
    int mentalParentIndex=-1,relationOtherIndex;
    Truth acceptance=Truth.True;int understanding=100;
    void Compare(Action action){try{if(tracked!=null)beforeDecision=ZooExperiment.Snapshot(tracked);action();if(tracked!=null)afterDecision=ZooExperiment.Snapshot(tracked);}catch(Exception e){status=e.Message;}}
    void LoadMental(Projection p){mental=p;mentalName=p.Name;mentalKind=p.Kind;mentalExistence=p.Existence;mentalTags=string.Join("\n",p.Tags.Select(t=>$"{t.Key.Name}={t.Value}"));mentalParentIndex=p.Parent==null?-1:tracked!.Soul.World.Projections.IndexOf(p.Parent);}
    void SelectMental(ChangeEventArgs e){if(tracked!=null)LoadMental(tracked.Soul.World.Projections[int.Parse(e.Value!.ToString()!)]);}
    void NewMental(){mental=null;mentalName="幻觉对象";mentalKind=ProjectionKind.Object;mentalExistence=Truth.True;mentalTags="";mentalParentIndex=tracked!.Soul.World.Projections.IndexOf(tracked.Self.Parent!);}
    void SaveMental()=>Compare(()=>{if(tracked==null)return;mental=ZooExperiment.Edit(tracked,mental,mentalName,mentalKind,mentalExistence,mentalParentIndex<0?null:tracked.Soul.World.Projections[mentalParentIndex],mentalTags,W.Now);LoadMental(mental);status=I18n.T("StatusOnlyMindModified");});
    void ForgetMental()=>Compare(()=>{if(tracked==null||mental==null)return;ZooExperiment.Forget(tracked,mental,W.Now);LoadMental(tracked.Self);status=I18n.T("StatusForgotten");});
    void SaveRelation()=>Compare(()=>{if(tracked==null||mental==null)return;ZooExperiment.Relate(tracked,mental,new(relationName),tracked.Soul.World.Projections[relationOtherIndex],relationTruth,W.Now);status=I18n.T("StatusRelationSaved");});
    void SaveBelief()=>Compare(()=>{if(tracked==null||mental==null)return;ZooExperiment.SetBelief(tracked,mental,mentalRule,W.Now);status=I18n.T("StatusBeliefSaved");});
    void Preview(){if(tracked!=null)afterDecision=ZooExperiment.Snapshot(tracked);}
    void ActFromMind(){try{if(tracked!=null){W.Replan(tracked);status=I18n.T("StatusReplanDone");}}catch(Exception e){status=e.Message;}}
    void ObserveAgain()=>Compare(()=>{if(tracked!=null){W.Observe(tracked);LoadMental(tracked.Self);status=I18n.T("StatusObserved");}});
    void Publish()=>Compare(()=>{W.Rules.Publish(key,script,W.Rules.Clauses.GetValueOrDefault(key)?.Original??"新增文书");status=I18n.T("StatusRulePublished");});
    void Broadcast()=>Compare(()=>{W.Rules.Publish(key,script,W.Rules.Clauses.GetValueOrDefault(key)?.Original??"现场广播");W.Broadcast(key);status=I18n.T("StatusBroadcasted");});
    void Withdraw()=>Compare(()=>{var affected=W.Withdraw(key,true);status=I18n.T("StatusWithdrawn", affected);});
    void WithdrawLocal()=>Compare(()=>{W.Withdraw(key,false);status=I18n.T("StatusWithdrawLocal");});
    void Accept()=>Compare(()=>{if(tracked?.Books.ContainsKey(key)==true)ZooRules.Accept(tracked,key,Truth.True,W.Now);});
    void ChangeUnderstanding()=>Compare(()=>{if(tracked is not {} person||!person.Books.TryGetValue(key,out var book))throw new InvalidOperationException("此人尚未读到该文书。");person.Books[key]=book with{Understanding=Math.Clamp(understanding,0,100)};ZooRules.Accept(person,key,acceptance,W.Now);status=I18n.T("StatusUnderstandingChanged");});
    void Cast()=>Compare(()=>{if(tracked!=null){W.Anomalies.QueueUtterance(tracked,utterance);status=I18n.T("StatusCast");}});
    void SetClarity(int val)
    {
        if(tracked!=null)
        {
            Compare(()=>{
                ZooExperiment.SetCognitionAndMap(tracked,val,W.Now);
                LoadMental(tracked.Self);
                status=val<50?I18n.T("StatusCognitionDropped"):I18n.T("StatusCognitionRestored");
            });
        }
    }
    void OnCognitionSliderChanged(ChangeEventArgs e)
    {
        if(int.TryParse(e.Value?.ToString(),out var val))SetClarity(val);
    }
    void AppendScript(string text){script=string.IsNullOrWhiteSpace(script)?text:script+" "+text;}
    void SetScript(string text){script=text;}
    void AppendMentalTag(string tag){mentalTags=string.IsNullOrWhiteSpace(mentalTags)?tag:mentalTags+"\n"+tag;}
    void SetUtterance(string u){utterance=u;}
    public void Dispose(){disposed=true;Stop();simulation?.Dispose();}
}





