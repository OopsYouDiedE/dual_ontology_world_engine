@page "/"
@implements IDisposable
<PageTitle>动物园 · 认知与规则实验室</PageTitle>
<div class="zoo">
    <header><div><small>ESSENCE / PROJECTION · C# CORE</small><h1>动物园规则怪谈</h1></div><div class="clock">@Clock <small>@(W.Open ? "开放中 08:00—16:00" : "已闭园 · 停止入园")</small></div></header>
    <nav>
        <button @onclick="() => Advance(10)">推进 10 分钟</button><button @onclick="() => Advance(60)">推进 1 小时</button>
        <button @onclick="Toggle">@(playing?"暂停":"连续推演")</button>
        <select @bind="preset"><option value="standard">岗位与地图</option><option value="none">未读初始规则</option><option value="gate">采信门口告示</option><option value="all">全部冲突文书</option></select>
        <label>首批游客 <input type="number" min="0" max="500" @bind="visitors" /></label>
        <label>种子 <input type="number" @bind="seed" /></label><button @onclick="Reset">重建世界</button>
    </nav>
    <p class="status" role="status">@status</p>
    <div class="metrics"><span>当前游客 <b>@W.InPark</b></span><span>峰值游客 <b>@W.PeakVisitors</b></span><span>已逃离 <b>@W.People.Count(p=>p.Outcome=="成功逃离")</b></span><span>原文文书 <b>@W.Rules.Clauses.Count</b></span><span>步行 <b>60 米/分钟</b></span></div>
    <main>
        <section><h2>园区现场 <small>客观视角</small></h2>
            <div class="rooms">@foreach(var room in W.Rooms.Values.Where(r=>r.TrueName!="园外"))
            {<button class="room @(tracked?.Room==room?"active":"")" @onclick="()=>SelectRoom(room)"><strong>@room.TrueName</strong><span>@W.People.Count(p=>p.Room==room&&p.Outcome=="在园") 人</span><small>@(room.Value(Z.Danger)>0?"可见异常":"") @(room.Value(Z.Calm)>0?"言灵：安静":"")</small></button>}</div>
            <h2>人物</h2><select class="wide" @onchange="Pick">@foreach(var p in W.People){<option value="@p.Body.TrueName" selected="@(p==tracked)">@p.Body.TrueName · @p.Job · @p.Outcome</option>}</select>
            @if(tracked is {} person)
            {
                <dl><dt>真实物种</dt><dd>@person.TrueSpecies</dd><dt>本人认为</dt><dd>人类信念 @person.Self.Value(Z.Human) / 100</dd><dt>“它”认为</dt><dd>@(person.ItsClassification?.ToString()??"无法可靠分类")</dd><dt>身体兔化</dt><dd>@person.Body.Value(Z.Rabbit) / 100</dd><dt>实际位置</dt><dd>@person.Room?.TrueName</dd><dt>脑内位置</dt><dd>@person.Self.Parent?.Name</dd><dt>进行中行动</dt><dd>@person.CurrentAction</dd><dt>虚线纸</dt><dd>@(W.Anomalies.Paper(person)!=null?"持有撕下的纸片":"无分类保护")</dd></dl>
                <h2>认知干预</h2><p>通过 Core 认知变换提交观察输入，下一次决策使用新的自我理解。</p>
                <input type="range" min="0" max="100" @bind="human"/><span>@human</span><button @onclick="ChangeMind">改变人类信念</button>
                <h2>言灵 · 临时修改当前场景</h2><p>消耗一次施放机会，作用 15 分钟；到期按叠加顺序恢复。</p><button @onclick="Cast">“此处暂时安静”</button><small>剩余 @person.Body.Value(Z.Mana) 次</small>
            }
        </section>
        <section>
            <h2>脑内决策树 <small>观察 → 理解 → 空间条件 → 建议权重 → Core 选择</small></h2>
            @if(tracked is {} thinker)
            {
                <div class="trace">@foreach(var entry in thinker.DecisionTrace){<div>@entry</div>}@if(thinker.DecisionTrace.Count==0){<p>当前由日常游览、休息或岗位计划选择行动。</p>}</div>
                <details><summary>最近观察（@thinker.Soul.World.Projections.Length 个脑内对象）</summary>@foreach(var observation in thinker.Soul.World.History.TakeLast(12).Reverse()){<p>@observation.Time.ToString("F1") · @observation.Source · @observation.Target.Name <small>@observation.Details</small></p>}</details>
            }
            <h2>文书编辑</h2><p>受控中文会解析成 AST。修订后需要现场阅读或广播，人物才会知道新版本。广播不覆盖海洋馆和封闭宿舍。</p>
            <select class="wide" @onchange="LoadRule">@foreach(var clause in W.Rules.Clauses.Values){<option value="@clause.Key" selected="@(clause.Key==key)">@clause.Key · @(clause.Original.Length>45?clause.Original[..45]+"…":clause.Original)</option>}</select>
            <p class="original">@W.Rules.Clauses.GetValueOrDefault(key)?.Original</p>
            <input class="wide" aria-label="文书编号" @bind="key"/><textarea aria-label="受控规则文本" @bind="script"></textarea>
            <div class="actions"><button @onclick="Publish">保存文书</button><button @onclick="Broadcast">保存并广播</button><button @onclick="Withdraw">张贴撤回告示</button><button @onclick="Accept">当前人物重新采信</button></div>
            <details><summary>可用语法与词汇</summary><p>当 条件 时 优先 动作 权重 80；当 条件&amp;!另一条件 时 禁止 动作 权重 100</p><p>行为：前往:场景名、@string.Join("、",ZooMinds.Actions.Keys)</p><p>条件：@string.Join("、",ZooMinds.FactNames)</p></details>
            <h2>人物记住的版本</h2>
            @if(tracked is {} reader){<div class="books">@foreach(var book in reader.Books.Values){<details><summary>@book.Text.Key · @book.Acceptance · 理解 @book.Understanding%</summary><p>@book.Text.Script</p></details>}</div>}
            <h2>行动与机制记录</h2><div class="log">@foreach(var entry in W.Events.TakeLast(30).Reverse()){<div>@entry</div>}</div>
        </section>
    </main>
</div>
<style>
.zoo{max-width:1500px;margin:auto;padding:24px;color:#d7e0e6;font:14px/1.6 system-ui;background:#101819}.zoo header{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #43554d;padding-bottom:20px}.zoo h1{font-size:30px;margin:4px 0}.zoo small{color:#96b6a6;display:block}.clock{font-size:28px;color:#d9ecbc}.clock small{font-size:13px}.zoo nav,.actions{display:flex;gap:10px;flex-wrap:wrap;margin:20px 0}.zoo button,.zoo select,.zoo input,.zoo textarea{background:#1a2827;color:#e5ece8;border:1px solid #53685f;border-radius:5px;padding:9px}.zoo button{cursor:pointer}.zoo button:hover{background:#31493b}.zoo input[type=number]{width:65px}.metrics{display:flex;gap:28px;padding:18px;background:#20342a;border-radius:8px}.metrics b{font-size:20px;margin-left:8px}.zoo main{display:grid;grid-template-columns:1fr 1.2fr;gap:24px}.zoo section{min-width:0}.zoo h2{font-size:17px;margin:28px 0 14px;color:#d9ecbc}.zoo h2 small{font-size:12px;font-weight:400}.rooms{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.room{text-align:left;min-height:80px}.room span{display:block}.room.active{border-color:#cbe9a7;background:#2a4130}.wide{width:100%;box-sizing:border-box}.zoo dl{display:grid;grid-template-columns:110px 1fr;gap:8px}.zoo dd{margin:0;color:#e4edb5}.zoo dt{color:#91a89a}.trace,.log,.books{max-height:280px;overflow:auto;background:#14211d;padding:14px;border-left:2px solid #789468}.trace div,.log div{padding:4px;border-bottom:1px solid #25372d}.zoo textarea{width:100%;box-sizing:border-box;min-height:130px;margin-top:10px;font:14px/1.7 monospace}.zoo details{padding:8px;border-bottom:1px solid #35483d}.zoo summary{cursor:pointer}.original{color:#a8b7b0}.status{color:#eacb91;min-height:22px}.zoo p{overflow-wrap:anywhere}.zoo button:focus-visible{outline:2px solid #ebdf91}@@media(max-width:850px){.zoo main{grid-template-columns:1fr}.metrics{flex-wrap:wrap;gap:12px}.zoo{padding:12px}.zoo header{align-items:flex-start;gap:12px}.rooms{grid-template-columns:repeat(2,1fr)}}
</style>
@code {
    ZooSimulation simulation=null!;ZooWorld W=>simulation.World;Person? tracked;
    int seed=7,visitors=120,human=70;string preset="standard",key="Visitor.14",script="当 危险 时 优先 前往:狮子园区 权重 120",status="";
    bool playing,disposed,busy;int generation;System.Threading.Timer? timer;
    string Clock=>$"第{(int)W.Now/1440+1}天 {(int)W.Now%1440/60:D2}:{(int)W.Now%60:D2}";
    protected override void OnInitialized()=>Reset();
    void Reset(){Stop();generation++;busy=false;simulation?.Dispose();try{simulation=new(seed,visitors,480,preset);tracked=W.People.FirstOrDefault(p=>p.Job==Job.Visitor)??W.People[0];status="已创建世界；下一次行动从脑内世界选择。";}catch(Exception e){status=e.Message;}}
    async Task Advance(double minutes)
    {
        if(busy)return;busy=true;var current=generation;var world=W;var target=world.Now+minutes;
        try
        {
            while(!disposed&&current==generation&&world.Now<target)
            {
                world.Run(target,20);status=$"正在推进至目标时刻，当前 {Clock}。";
                StateHasChanged();await Task.Delay(1);
            }
            if(current==generation)status=$"已推进至 {Clock}。";
        }
        catch(Exception e){Stop();status=e.Message;}
        finally{if(current==generation)busy=false;}
    }
    void Toggle(){if(playing){Stop();return;}playing=true;timer=new(_=>InvokeAsync(async ()=>{if(disposed||!playing)return;await Advance(2);StateHasChanged();}),null,0,700);}
    void Stop(){playing=false;timer?.Dispose();timer=null;}
    void SelectRoom(Essence room){tracked=W.People.FirstOrDefault(p=>p.Room==room&&p.Outcome=="在园")??tracked;}
    void Pick(ChangeEventArgs e){tracked=W.People.First(p=>p.Body.TrueName==e.Value?.ToString());}
    void LoadRule(ChangeEventArgs e){key=e.Value!.ToString()!;script=W.Rules.Clauses[key].Script;}
    void Publish(){try{W.Rules.Publish(key,script,W.Rules.Clauses.GetValueOrDefault(key)?.Original??"新增现场文书");status="文本已通过解析并保存；尚未读到的人继续使用旧版本。";}catch(Exception e){status=e.Message;}}
    void Broadcast(){try{W.Rules.Publish(key,script,W.Rules.Clauses.GetValueOrDefault(key)?.Original??"现场广播");W.Broadcast(key);status="修订已通过广播进入听众的观察输入。";}catch(Exception e){status=e.Message;}}
    void Withdraw(){W.Rules.Remove(key);status="已张贴撤回告示；人物再次阅读该处文书后撤销旧建议。";}
    void Accept(){if(tracked?.Books.ContainsKey(key)==true){ZooRules.Accept(tracked,key,Truth.True,W.Now);status="人物已重新采信记忆中的版本。";}}
    void ChangeMind(){if(tracked!=null){W.Anomalies.Reconsider(tracked,human);status="认知变换已提交，身体物种保持独立。";}}
    void Cast(){try{if(tracked!=null)W.Anomalies.SayTemporary(tracked,Z.Calm,1,15);status="言灵已进入人物行动队列，完成当前行动后施放。";}catch(Exception e){status=e.Message;}}
    public void Dispose(){disposed=true;Stop();simulation?.Dispose();}
}



