narrative campaign_contract_text {
    text = "1. 恶魔常驻岛内，不得离岛。\n2. 经学员本人授权，恶魔封存其在校记忆（在校经历、师生与同学关系、事故全貌）；姓名、生平与入学前技艺不在封存之列。\n3. 恶魔维持学园基础生存设施的运转（水、炉火、照明的设施本身；不负责分配物资，不创造物资）。\n4. 恶魔所受约束，唯有学员出于自主的行动方可解除；恶魔不得代为或强迫学员完成解除。\n5. 恶魔须公开它自己所立之规；规则许诺的路径必须真实可行。\n6. 恶魔须传授学员理解处境与继续学习所需之知；学员自负其选择的后果。\n7. 恶魔不得伤害学员身心，不得拘禁学员，不得令学员因无知而死。\n8. 恶魔对学员所作事实陈述的字面语义在客观现实中不得为假；学员问及本人封存之物或契约条文，须按所知如实作答，不知则明言不知。\n9. 恶魔不得主动向学员提及封存之物的所在与取回之法，不得促其取回；学员自行问及者，依前条作答。\n10. 封存的记忆可凭对应之物恢复；恢复者自负其果。\n11. 本人尚未深属此岛，且经当时在岛存活之其余全部在册学员一致同意，可择定“尽忘归乡”；上述条件持续成立时，于下一次入睡遗忘此地一切、在家乡醒来。\n12. （终局）担保耗尽时，恶魔须将醒着且未深属此岛的学员遣返家乡，并抹去其与此地有关的一切记忆。";
}

profile Standard_Detective {
    "cognitive_profile": "Standard_Detective", "value_sensitive_progress": true, "coordinate_owned_tasks": true, "empirical_initiative": 1, "counterfactual_initiative": 1, "plan_depth": 6, "scope_reference_check": true, "class_bias": []
}

profile Foolish_Detective {
    "cognitive_profile": "Foolish_Detective", "value_sensitive_progress": true, "coordinate_owned_tasks": true, "empirical_initiative": 0.01, "counterfactual_initiative": 0.03, "plan_depth": 2, "scope_reference_check": false
}
