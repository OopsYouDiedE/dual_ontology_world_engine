// Runtime DV content. Parsed and validated by C#; never self-hosted.
schema "dv-script-v1";

item coat {
    name = "风衣";
    group = "chapter1";
    kind = "physical";
    map_kind = "object";
    visible_fields = ["name", "location"];
    facets = { state = { worn_by = ""; }; identity = { owner = "detective"; }; };
}

item lens {
    name = "黄铜放大镜";
    group = "chapter1";
    kind = "physical";
    map_kind = "object";
    visible_fields = ["name", "location"];
    facets = { state = {  }; identity = { kind = "physical"; }; };
}

item graphite_pencil {
    name = "石墨笔";
    group = "chapter1";
    kind = "physical";
    map_kind = "object";
    visible_fields = ["name", "location"];
    facets = { state = {  }; identity = { kind = "physical"; }; };
}

item evidence_bags {
    name = "证物袋";
    group = "chapter1";
    kind = "physical";
    map_kind = "object";
    visible_fields = ["name", "location"];
    facets = { state = {  }; identity = { kind = "physical"; }; };
}

// A rule is an executable condition/effect declaration, not embedded C#.
rule c1_latch_contact_law {
    version = 1;
    premise = all(
        eq(ref("detective", "state", "location"), "foyer"),
        eq(ref("ritual", "state", "present_latch_contact.detective"), false)
    );
    effects = [assign(ref("ritual", "state", "present_latch_contact.detective"), true)];
}

character detective {
    name = "侦探";
    autonomy = {
        commodity_needs = { hunger = 75; safety = 80; social = 70; cognition = 60; obsession = 65; };
        autonomy_weights = {"hunger": 0.9, "safety": 1.1, "social": 1.0, "cognition": 1.4, "obsession": 1.2};
        action_weights = { inspect = { need = "cognition"; scale = 0.05; }; talk = { need = "social"; scale = 0.05; }; help = { need = "safety"; scale = 0.05; }; };
        implicit_habits = [
            {"id": "habit.cuff_rub", "trigger": "R05", "kind": "inspect", "bonus": 0.15, "surface": "右手袖口磨得发亮——写字时总拿那儿蹭桌沿。"},
            {"id": "habit.magnifier_check", "trigger": "hall", "kind": "inspect", "bonus": 0.15, "surface": "习惯性摸向风衣口袋里的黄铜放大镜。"}
        ];
    };

    personality = { group = "living"; domain = "investigation"; station_roles = []; value_order = ["evidence", "safety", "patient_priority", "records"]; };
    obeys = [];
}

