            valid = dv_and(valid, (dv_find(before.policy, "reason_budget", -1) == v_reason_budget_before(trace, first, start)))
            valid = dv_and(valid, dv_same(before.mind, parse.data.mind_after))
            var local_1 = false
            if valid:
                local_1 = "supported"
            else:
                local_1 = "violated"
            status = local_1
            reason = "逐步重演本人提案采纳后的付费桥接复核、理由预算及解释前后状态；撤销不写入相反命题"
            if dv_and(v_reception_verified(trace, parse.id), (dv_find(decision, "status", "") == "accepted")):
                false
            else:
                status = "insufficient_evidence"
                reason = "缺少实际接收并由本人策略采纳的提案来源，不能将收到冒充采纳"
