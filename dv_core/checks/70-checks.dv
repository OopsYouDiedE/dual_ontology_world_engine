                    complete = "unknown"
            accepted = dv_and(dv_and((literal == "true"), (support == "true")), dv_and((match == "true"), dv_and((complete == "true"), (executable == "true"))))
            if dv_has_key(data, "personal_accepted_answers"):
                var stage = dv_find(e.data, "stage", "")
