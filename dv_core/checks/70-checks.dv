        if dv_and(dv_uncontested(cell), dv_and((0 < cell.confidence), dv_and((not dv_find(cell, "estimated", false)), (not (dv_find(cell, "source", "") == "abduction"))))):
            while dv_and((i < cutoff), (not result.valid)):
                var event = events[i]
                if (event.actor == actor.id):
                    var kind = event.type
                    var data = event.data
                    if dv_or((kind == "observation"), (kind == "listener_parse")):
                        if dv_has_key(data, "mind_after"):
                            if dv_same(dv_read(data.mind_after, ref), cell):
                                var observations = dv_find(data, "observations", [])
                                var j = 0
                                var claims = dv_find(cell, "claims", [])
                                var valid = true
                                var confidence = cell.confidence
                                var roots = []
                                var steps = []
                                if (rt_count(claims) == 0):
