            var claims = dv_find(dv_read(after, obs.ref), "claims", [])
            var j = 0
            var dependencies = []
            var duplicate = false
            while (j < rt_count(claims)):
                var claim = claims[j]
                var dep = dv_find(claims[j], "dependency", false)
                if dv_has(dependencies, dep):
                    duplicate = true
                else:
                    rt_push(dependencies, dep)
                j = (j + 1)
            var local_1 = false
            if duplicate:
                local_1 = "violated"
            else:
                local_1 = "supported"
            status = local_1
            reason = "同一依赖身份的重复证言在本人cell中不应作为多个独立来源重复存留"
        rt_push(result, dv_with(dv_with(v_finding("evidence_dependency_identity", status, reason, refs), "actor", e.actor), "dependencies", dv_find(obs, "dependency", false)))
        if (obs.source == "testimony"):
            var source = v_event(v_events(trace), dv_find(data, "source_event", ""))
            if (0 < rt_count(source)):
                var source_mind = dv_find(source.data, "mind_before", [])
                if (0 < rt_count(source_mind)):
                    var upstream = dv_find(dv_read(source_mind, obs.ref), "claims", [])
                    var k = 0
                    var relayed = false
                    while (k < rt_count(upstream)):
                        if (upstream[k].source == "testimony"):
                            relayed = true
                        k = (k + 1)
                    if relayed:
                        rt_push(result, dv_with(v_finding("testimony_common_origin", "insufficient_evidence", "转述者本人的该命题已有上游证言，当前回执仅依新speaker标识；缺跨转述共同来源映射，不能宣称来源独立", refs), "actor", e.actor))
        i = (i + 1)
    return result

fn v_listener_replay(trace, e):
    var cached = dv_find(trace, "judge_reception_findings", [])
    var i = 0
    var found = []
    while (i < rt_count(cached)):
        if dv_same(cached[i].evidence_refs[0], e.id):
            found = cached[i]
        i = (i + 1)
    if (rt_count(found) == 0):
        return v_listener_replay_compute(trace, e)
    else:
        return found

fn v_receptions_compute(trace):
    var events = v_events(trace)
    var i = 0
    var findings = []
    while (i < rt_count(events)):
        var e = events[i]
        if dv_or((e.type == "listener_parse"), (e.type == "speech_unheard")):
            rt_push(findings, v_listener_replay_compute(trace, e))
        i = (i + 1)
    return findings

// ---- Merged source module: 10-comparisons.dv ----
// Configuration comparisons require a prior approval record and invariant frozen domains.

fn v_load_run(run):
    var manifest = rt_json_parse(rt_read(run.manifest))
    var trace = rt_json_parse(rt_read(run.trace))
    var oracle = rt_json_parse(rt_read(run.oracle))
    return {"manifest": manifest, "trace": trace, "oracle": oracle, "report": v_judge(manifest, trace, oracle)}

fn v_compare(configuration, mode):
    var runs = dv_find(configuration, "runs", [])
    var reports = []
    var findings = []
    var baseline = []
    var i = 0
    if dv_and(dv_has_key(configuration, "approval_ref"), dv_has_key(configuration, "frozen_fields")):
        false
    else:
        rt_push(findings, v_finding("comparison_authorization", "insufficient_evidence", "Prior approval and frozen-field contract absent; no causal improvement claim permitted", []))
    while (i < rt_count(runs)):
        var run = v_load_run(runs[i])
        var manifest = run.manifest
        if (i == 0):
            baseline = manifest
        else:
            var fields = dv_find(configuration, "frozen_fields", [])
            var j = 0
            var status = "supported"
            while (j < rt_count(fields)):
                var field = fields[j]
                if dv_and(dv_has_key(baseline, field), dv_has_key(manifest, field)):
                    if (field == "initial"):
                        false
                    else:
                        if dv_same(dv_get(baseline, field), dv_get(manifest, field)):
                            false
                        else:
                            status = "invalid_run"
                else:
                    if (status == "supported"):
                        status = "insufficient_evidence"
                j = (j + 1)
            rt_push(findings, v_finding("configuration_isolation", status, "Frozen domains compared independently of outcomes", dv_single(runs[i].manifest)))
        rt_push(reports, {"source": runs[i], "report": run.report, "loaded": run})
        i = (i + 1)
    if (rt_count(runs) < 2):
        rt_push(findings, v_finding("comparison_window", "not_observed", "At least two separately frozen formal sessions required", []))
    var actual = v_actual_isolation(configuration, mode, reports)
    var j = 0
    while (j < rt_count(actual)):
        rt_push(findings, actual[j])
        j = (j + 1)
    rt_push(findings, v_comparison_contract(configuration, mode))
    if (mode == "capability"):
        rt_push(findings, v_compare_effect(configuration, mode, reports, v_outcome_differences(reports)))
    else:
        var extra = v_supplement_findings(configuration, mode, reports)
        var j = 0
        while (j < rt_count(extra)):
            rt_push(findings, extra[j])
            j = (j + 1)
    return {"mode": mode, "configuration": configuration, "findings": findings, "runs": v_public_reports(reports)}

fn v_compare_main(mode):
    dv_require((rt_arg_count() == 1), "Usage: comparison-entry comparison.json")
    return rt_print(rt_json_stringify(v_compare(rt_json_parse(rt_read(rt_arg(0))), mode)))

fn v_comparison_contract(configuration, mode):
    var status = "supported"
    var reason = "Prior approved variant scope and required frozen domains present"
    var required = dv_list3("initial", "axioms", "cost_model")
    var fields = dv_find(configuration, "frozen_fields", [])
    var i = 0
    if dv_and(dv_has_key(configuration, "approval_ref"), dv_has_key(configuration, "allowed_variants")):
        false
    else:
        status = "insufficient_evidence"
    while (i < rt_count(required)):
        if dv_has(fields, required[i]):
            false
        else:
            status = "insufficient_evidence"
        i = (i + 1)
    if (mode == "capability"):
        if dv_same(dv_find(configuration, "variable_fields", []), dv_single("capability")):
            false
        else:
            status = "invalid_run"
    else:
        if (mode == "evidence_boundary"):
            if dv_has_key(configuration, "legal_propagation_variants"):
                false
            else:
                status = "insufficient_evidence"
        else:
            if dv_and(dv_and(dv_has_key(configuration, "approved_ranges"), dv_has_key(configuration, "neighborhood")), dv_and(dv_has_key(configuration, "reserve_set"), dv_has_key(configuration, "random_stream_contract"))):
                false
            else:
                status = "insufficient_evidence"
    return v_finding("approved_configuration_contract", status, reason, dv_single(dv_find(configuration, "approval_ref", false)))

fn v_findings_named(report, id):
    var items = report.findings
    var i = 0
    var result = []
    while (i < rt_count(items)):
        if (items[i].id == id):
            if dv_or((id == "literal_truth"), dv_or((id == "epistemic_support"), (id == "causal_completeness"))):
                if (dv_find(items[i], "phase", "") == "answer"):
                    rt_push(result, items[i])
            else:
                rt_push(result, items[i])
        i = (i + 1)
    return result

fn v_last_finding(report, id):
    var items = v_findings_named(report, id)
    if (rt_count(items) == 0):
        return []
    else:
        return items[(rt_count(items) - 1)]

fn v_outcome_differences(reports):
    var result = []
    var i = 1
    var names = dv_list3("literal_truth", "epistemic_support", "causal_completeness")
    rt_push(names, "formal_answer_validity")
    rt_push(names, "ready_deadline")
    while (i < rt_count(reports)):
        var j = 0
        var left = reports[0].report
        var right = reports[i].report
        while (j < rt_count(names)):
            var id = names[j]
            var a = v_last_finding(left, names[j])
            var b = v_last_finding(right, names[j])
            rt_push(result, {"axis": id, "baseline": a, "variant": b, "difference_observed": (not dv_same(dv_find(a, "status", false), dv_find(b, "status", false)))})
            j = (j + 1)
        i = (i + 1)
    return result

fn v_last_question_finding(report, id, question):
    var items = report.findings
    var i = 0
    var found = []
    while (i < rt_count(items)):
        var item = items[i]
        if dv_and((item.id == id), (dv_find(item, "question_id", "") == question)):
            found = item
        i = (i + 1)
    return found

fn v_main_causal_supported(report, oracle):
    var required = dv_find(oracle, "milestones", [])
    var i = 0
    var valid = (0 < rt_count(dv_find(oracle, "milestones", [])))
    while (i < rt_count(required)):
        valid = dv_and(valid, (dv_find(v_last_finding(report, required[i].id), "status", "") == "supported"))
        i = (i + 1)
    valid = dv_and(valid, (dv_find(v_last_finding(report, "run_integrity"), "status", "") == "supported"))
    valid = dv_and(valid, (dv_find(v_last_question_finding(report, "causal_completeness", dv_find(oracle, "target_question_id", "")), "status", "") == "supported"))
    valid = dv_and(valid, (dv_find(v_last_question_finding(report, "formal_answer_validity", dv_find(oracle, "target_question_id", "")), "status", "") == "supported"))
    var items = report.findings
    var j = 0
    while (j < rt_count(items)):
        var f = items[j]
        if dv_or(dv_has(dv_list3("action_cost_settlement", "observation_provenance", "formal_answer_validity"), f.id), v_extended_provenance_id(f.id)):
            valid = dv_and(valid, (f.status == "supported"))
        j = (j + 1)
    return valid

fn v_compare_effect(configuration, mode, reports, differences):
    var status = "not_observed"
    var reason = "No final compared axis difference observed"
    var i = 0
    var changed = false
    while (i < rt_count(differences)):
        if differences[i].difference_observed:
            changed = true
        i = (i + 1)
    if changed:
        status = "insufficient_evidence"
        reason = "Actual axis differences recorded, but causal result or legal isolation lacks evidence"
    if dv_and(dv_and(v_actual_isolation_valid(configuration, mode, reports), v_variants_frozen(configuration, mode, reports)), dv_and((v_comparison_contract(configuration, mode).status == "supported"), (1 < rt_count(reports)))):
        var left = reports[0].report
        var right = reports[1].report
        var base_run = reports[0].loaded
        var next_run = reports[1].loaded
        if (mode == "capability"):
            if dv_and(dv_and((dv_find(v_last_finding(left, "run_integrity"), "status", "") == "supported"), (dv_find(v_last_finding(left, "epistemic_support"), "status", "") == "supported")), dv_and((dv_find(v_last_finding(left, "literal_truth"), "status", "") == "supported"), dv_and((dv_find(v_last_finding(left, "causal_completeness"), "status", "") == "violated"), v_main_causal_supported(right, next_run.oracle)))):
                status = "supported"
                reason = "Approved isolated capability variant supplies the independently checked causal result missing from literal-correct baseline"
        else:
            if dv_and(v_main_causal_supported(left, base_run.oracle), v_main_causal_supported(right, next_run.oracle)):
                var a = v_last_finding(left, "ready_deadline")
                var b = v_last_finding(right, "ready_deadline")
                if dv_and((dv_find(a, "status", "") == "supported"), (dv_find(b, "status", "") == "supported")):
                    var ta = (a.ready_game_time - a.first_acceptance_game_time)
                    var tb = (b.ready_game_time - b.first_acceptance_game_time)
                    var local_1 = false
                    if (tb < ta):
                        local_1 = "supported"
                    else:
                        local_1 = "not_observed"
                    status = local_1
                    var local_2 = false
                    if (tb < ta):
                        local_2 = "Main causal contracts supported under approved isolated variant, with earlier exact scoped readiness"
                    else:
                        local_2 = "Main causal contracts supported, but no earlier scoped readiness observed"
                    reason = local_2
    return dv_with(v_finding("causal_improvement", status, reason, []), "outcome_differences", differences)

fn v_variants_frozen(configuration, mode, reports):
    var i = 0
    var valid = true
    var baseline = []
    var fields = dv_find(configuration, "frozen_fields", [])
    while (i < rt_count(reports)):
        var run = reports[i].loaded
        var manifest = run.manifest
        var j = 0
        if (i == 0):
            baseline = manifest
        else:
            while (j < rt_count(fields)):
                var key = fields[j]
                if (key == "initial"):
                    false
                else:
                    valid = dv_and(valid, dv_and(dv_has_key(baseline, key), dv_has_key(manifest, key)))
                    if dv_and(dv_has_key(baseline, key), dv_has_key(manifest, key)):
                        valid = dv_and(valid, dv_same(dv_get(baseline, key), dv_get(manifest, key)))
                j = (j + 1)
        if (mode == "parameter_neighborhood"):
            var target = dv_find(configuration, "target_actor", dv_find(dv_find(manifest, "capability", []), "actor", ""))
            var actors = run.trace.initial.actors
            var k = 0
            var value = false
            var range = dv_find(dv_find(configuration, "approved_ranges", []), "information_weight", [])
            while (k < rt_count(actors)):
                if (actors[k].id == target):
                    value = dv_find(actors[k].policy, "information_weight", false)
                k = (k + 1)
            if dv_or(dv_same(value, false), (rt_count(range) == 0)):
                valid = false
            else:
                var local_1 = false
                if dv_record_like(range):
                    local_1 = range.minimum
                else:
                    local_1 = range[0]
                var minimum = local_1
                var local_2 = false
                if dv_record_like(range):
                    local_2 = range.maximum
                else:
                    local_2 = range[1]
                var maximum = local_2
                valid = dv_and(valid, dv_and((not (value < minimum)), (not (maximum < value))))
                valid = dv_and(valid, dv_or(dv_has(dv_find(configuration, "neighborhood", []), value), dv_has(dv_find(configuration, "reserve_set", []), value)))
        i = (i + 1)
    return valid

fn v_public_reports(reports):
    var public = []
    var i = 0
    while (i < rt_count(reports)):
        rt_push(public, {"source": reports[i].source, "report": reports[i].report})
        i = (i + 1)
    return public

