fn v_prune_factor_proof_result(valid, remaining, confidence, steps, roots):
    return dv_with({"valid": valid, "remaining": remaining, "confidence": confidence, "steps": steps}, "source_events", roots)

fn v_prune_factor_merge(left, right):
    var steps = dv_clone(left.steps)
    var roots = dv_clone(left.source_events)
    var i = 0
    while (i < rt_count(right.steps)):
        rt_push(steps, right.steps[i])
        i = (i + 1)
    i = 0
    while (i < rt_count(right.source_events)):
        if dv_has(roots, right.source_events[i]):
            false
        else:
            rt_push(roots, right.source_events[i])
        i = (i + 1)
    return v_prune_factor_proof_result(dv_and(left.valid, right.valid), right.remaining, dv_min(left.confidence, right.confidence), steps, roots)

