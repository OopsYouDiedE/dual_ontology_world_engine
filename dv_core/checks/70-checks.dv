    if dv_and((-1 < topic_index), (0 < rt_count(binding))):
        if dv_and(dv_same(binding.heard_when, dv_find(topic, "heard_when", false)), dv_same(v_retract_support_parents(mind, v_model_sim_refs(binding.heard_when), v_event_prefix(events, topic_index), speaker), dv_find(topic, "source_event_ids", []))):
            false
        else:
            topic = []
    else:
        topic = []
    var origins = v_proposal_origin_speakers(events, dv_find(topic, "source_event_ids", []))
