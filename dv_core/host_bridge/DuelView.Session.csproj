<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UseSharedCompilation>false</UseSharedCompilation>
    <DvPython Condition="'$(DvPython)' == ''">python</DvPython>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="DVProgram.cs" />
    <ProjectReference Include="../base/DuelView.Core.csproj" />
    <Compile Include="obj/dv/DVProgram.cs" />
  </ItemGroup>
  <Target Name="GenerateDvSession" BeforeTargets="CoreCompile">
    <Exec Command="&quot;$(DvPython)&quot; &quot;$(MSBuildProjectDirectory)/../../mcp/build/build_session.py&quot; --partition --out &quot;$(MSBuildProjectDirectory)/obj/dv&quot;" />
    <ItemGroup>
      <Compile Include="$(MSBuildProjectDirectory)/obj/dv/modules/*.g.cs" />
    </ItemGroup>
  </Target>
</Project>
