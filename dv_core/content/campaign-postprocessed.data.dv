// ChapterTwo.cs / c2_work_purpose
data post.c2_work_purpose.0002 {
    value = "核对载荷并操作千斤顶，持续保持抬升。";
}

// ChapterTwo.cs / c2_work_purpose
data post.c2_work_purpose.0003 {
    value = "拆验锁具，记录实际痕迹。";
}

// ChapterTwo.cs / c2_work_purpose
data post.c2_work_purpose.0004 {
    value = "查找并出示各自实际持有的散页，核对清册与授权上下文。";
}

// ChapterTwo.cs / c2_work_purpose
data post.c2_work_purpose.0005 {
    value = "自行判断写生机会，记录实际观察与身体感受。";
}

// ChapterTwo.cs / c2_work_purpose
data post.c2_work_purpose.0006 {
    value = "打开日志抽屉，实际取出记录。";
}

// ChapterTwo.cs / c2_work_purpose
data post.c2_work_purpose.0007 {
    value = "出示本人旧疤，与已经取出的记录现场核对。";
}

// ChapterTwo.cs / c2_work_purpose
data post.c2_work_purpose.0008 {
    value = "在药柜准许取用后，与协作者实际核对材料和配制药剂。";
}

// ChapterTwo.cs / c2_work_purpose
data post.c2_work_purpose.0009 {
    value = "核对代管依据与现场记录，办理钥匙交接。";
}

// ChapterTwo.cs / c2_work_purpose
data post.c2_work_purpose.0010 {
