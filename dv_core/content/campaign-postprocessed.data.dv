// ChapterOne.cs / c1_other_introduction
data post.c1_other_introduction.0001 {
    value = "叫我雀儿就行。别站门前——让我看一眼那道闩。";
}

// ChapterOne.cs / c1_other_introduction
data post.c1_other_introduction.0002 {
    value = "卢西安。名字还记得，半句诗也还记得；偏偏缺了我们怎么到这儿来的那一段。";
}

// ChapterOne.cs / c1_other_introduction
data post.c1_other_introduction.0003 {
    value = "沃德。先说姓名，再说各自记得的最后一件事。不要混在一起。";
}

// ChapterOne.cs / c1_other_introduction
data post.c1_other_introduction.0004 {
    value = "顾平章。容老朽擦擦眼镜。纸上的东西还在，人却想不起来，真是怪事。";
}

// ChapterOne.cs / c1_other_introduction
data post.c1_other_introduction.0005 {
    value = "阮清月。那盘棋先别碰。我们还不知道谁摆的，也不知道轮到谁。";
}

// ChapterOne.cs / c1_other_introduction
data post.c1_other_introduction.0006 {
    value = "伊莲娜。别拉我起来……脚踝疼。你们谁知道这里是什么地方？";
}

// ChapterOne.cs / c1_other_introduction
data post.c1_other_introduction.0007 {
    value = "赛尔玛。请别动窗台上的苗。我得先弄清楚本子上哪些是我记的。";
}

// ChapterOne.cs / c1_other_introduction
data post.c1_other_introduction.0008 {
    value = "莫兰。等一等，那层绿马上要散了。你们说，我听着。";
}

// ChapterOne.cs / c1_other_introduction
data post.c1_other_introduction.0009 {
    value = "茉拉。刚才谁在咳嗽？先让我看看，再说别的。";
}

// ChapterOne.cs / c1_other_introduction
data post.c1_other_introduction.0010 {
    value = "贝尔特朗。门外有动静。先别挤过去，给彼此留条退路。";
}

// ChapterOne.cs / c1_other_introduction
data post.c1_other_introduction.0011 {
    value = "维罗妮卡。谁动过这排器具？不知道也直说，别替别人猜。";
}

// ChapterOne.cs / c1_other_introduction
data post.c1_other_introduction.0012 {
    value = "玛格丽特。先别都靠那面墙。这根梁的搭法，我得再看一遍。";
}

// ChapterOne.cs / c1_other_handoff_text
data post.c1_other_handoff_text.0001 {
    value = "开锁的人已经核对了。出去以后，那把钥匙的来路还得写清楚。";
}

// ChapterOne.cs / c1_other_handoff_text
data post.c1_other_handoff_text.0002 {
    value = "我答了。你还要把我堵在这儿？门开了，让开一点。";
}

// ChapterOne.cs / c1_other_handoff_text
data post.c1_other_handoff_text.0003 {
    value = "名字答对了，缘由还空着呢。沃德，留一行空白总比填错强。";
}

// ChapterOne.cs / c1_other_handoff_text
data post.c1_other_handoff_text.0004 {
    value = "门开了。先莫争，外面若有文书，读过再说。";
}

// ChapterOne.cs / c1_other_handoff_text
data post.c1_other_handoff_text.0005 {
    value = "我慢一点。阮清月……出去以后，你也别先走。";
}

// ChapterOne.cs / c1_other_handoff_text
data post.c1_other_handoff_text.0006 {
    value = "我在这儿。你先扶住门框，等站稳了再迈那一步。";
}

// ChapterOne.cs / c1_other_handoff_text
data post.c1_other_handoff_text.0007 {
    value = "我的本子带上了。门内查到的，跟出去以后查到的，分开记。";
}

// ChapterOne.cs / c1_other_handoff_text
data post.c1_other_handoff_text.0008 {
    value = "外面的光不一样。等我站到门边再画，别挡着伊莲娜。";
}

// ChapterOne.cs / c1_other_handoff_text
data post.c1_other_handoff_text.0009 {
    value = "人先出去。试剂的事还没说清；有谁不舒服，别瞒着。";
}

// ChapterOne.cs / c1_other_handoff_text
data post.c1_other_handoff_text.0010 {
    value = "取走一瓶东西和拿它做了什么，是两件事。先把原瓶找到。";
}

// ChapterOne.cs / c1_other_handoff_text
data post.c1_other_handoff_text.0011 {
    value = "我站门边。一个一个过去，先看落脚的地方。";
}

// ChapterOne.cs / c1_other_handoff_text
data post.c1_other_handoff_text.0012 {
    value = "门框没歪。慢慢过，别拿身体去撞那道闩。";
}

