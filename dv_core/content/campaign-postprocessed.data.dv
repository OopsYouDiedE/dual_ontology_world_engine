// ChapterOne.cs / c1_op_wake_lines
data post.c1_op_wake_lines.0001 {
    value = "我记得的最后一件事，是上船。";
}

// ChapterOne.cs / c1_op_wake_lines
data post.c1_op_wake_lines.0002 {
    value = "冰冷的地面抵着肩背。我在门边撑起身，先检查自己能否活动。";
}

// ChapterOne.cs / c1_op_wake_lines
data post.c1_op_wake_lines.0003 {
    value = "门闩和地上的痕迹都在眼前。先逐一查看，再判断发生了什么。";
}

// ChapterOne.cs / c1_op_wake_lines
data post.c1_op_wake_lines.0004 {
    value = "……";
}

// ChapterOne.cs / c1_op_wake_lines
data post.c1_op_wake_lines.0005 {
    value = "手先去摸床沿。床板是榫接的，没用一颗钉子。";
}

// ChapterOne.cs / c1_op_wake_lines
data post.c1_op_wake_lines.0006 {
    value = "上船以后的事，没了。";
}

// ChapterOne.cs / c1_op_wake_lines
data post.c1_op_wake_lines.0007 {
    value = "挂钩上缠着机油布。顺时针，三圈半。我缠的。";
}

// ChapterOne.cs / c1_op_wake_lines
data post.c1_op_wake_lines.0008 {
    value = "起来。";
}

// ChapterOne.cs / c1_op_wake_lines
data post.c1_op_wake_lines.0009 {
    value = "哎哟，这胳膊。酸得跟揉了半宿面似的。";
}

// ChapterOne.cs / c1_op_wake_lines
data post.c1_op_wake_lines.0010 {
    value = "昨儿……昨儿干啥了？就记得上了条船。";
}

// ChapterOne.cs / c1_op_wake_lines
data post.c1_op_wake_lines.0011 {
    value = "桌上那块磨刀石，中间都磨出槽了。谁这么舍得用。";
}

// ChapterOne.cs / c1_op_wake_lines
data post.c1_op_wake_lines.0012 {
    value = "先找口水喝。";
}

// ChapterOne.cs / c1_op_wake_lines
data post.c1_op_wake_lines.0013 {
    value = "墙里有一个很低的音，一直没断。";
}

// ChapterOne.cs / c1_op_wake_lines
data post.c1_op_wake_lines.0014 {
    value = "最后记得的，是船上的汽笛。";
}

// ChapterOne.cs / c1_op_wake_lines
data post.c1_op_wake_lines.0015 {
    value = "手指在被面上敲。四四拍。不知道敲了多久。";
}

// ChapterOne.cs / c1_op_wake_lines
data post.c1_op_wake_lines.0016 {
    value = "……那个音还在。";
}

