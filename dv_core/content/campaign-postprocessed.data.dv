schema "dv-script-v1";

// Authored text and identities restored after one-time legacy lowering.
// Pure data; C# accesses these immutable scalar values with Authored(id).

// CampaignFlow.cs / c1_player_display_build
data post.c1_player_display_build.0001 {
    value = "trust";
}

// ChapterOne.cs / c1_visible_E1
data post.c1_visible_E1.0001 {
    value = "隔离门在乙区这一侧。门闩落在闩槽里，门缝和门框留有灰与磨损。另一侧的状态还需从可接近的位置核查。";
}

// ChapterOne.cs / c1_visible_E2
data post.c1_visible_E2.0001 {
    value = "门内地面铺着一片扇形的灰，窄端贴着门缝，向门厅里散开。\n东南墙角躺着一枚木楔：上面一层灰，底面干净。楔尖有新的磨痕。\n门底边有一道擦痕。";
}

// ChapterOne.cs / c1_visible_E3
data post.c1_visible_E3.0001 {
    value = "灰上有一枚马球靴印，踩得很清楚。\n鞋尖朝着门侧的插闩。\n鞋跟一端被什么东西压过。";
}

// ChapterOne.cs / c1_visible_E4
data post.c1_visible_E4.0001 {
    value = "一条拧过的湿抹布，沿门底压成一条直线，正好贴着闭合的门。\n布的一端压住了靴印的鞋跟边缘。";
}

// ChapterOne.cs / c1_visible_E5
data post.c1_visible_E5.0001 {
    value = "地上一把纯银音叉，柄上刻着“S.L.”。\n门框齐肩高的地方，有一个很小的凹痕。";
}

// ChapterOne.cs / c1_visible_E6
data post.c1_visible_E6.0001 {
    value = "一页手写乐谱，只有一小节。\n前两拍是弱音，各记着一个问号；后两拍重读，字是“开门”。同样的一小节记了两遍。\n旁注：“门外？”\n下方换了一种墨迹：“他们关了门。”这句话的作者与写入时间均未确认，不能视为苏泠当时的记录。";
}

// ChapterOne.cs / c1_visible_E7
data post.c1_visible_E7.0001 {
    value = "长桌上放着一块值守石板。板面刻有门框中的横线、门内双点和被叉去的向外箭头。背面有编号。符号的含义还需与操作图例和真实锁位对照。";
}

// ChapterOne.cs / c1_visible_E8
data post.c1_visible_E8.0001 {
    value = "铜口嵌在活动厅北墙上，下方铜牌刻着一个符号：◎。\n一根铜管从铜口后面出来：一路沿北墙向西，穿墙进门厅，贴着墙下到隔离门的门框；另一路向东，钻进活动厅与 R-08 之间的墙里。\n那道墙上与门框北侧各有一个管接头，一碰就晃——接口松了。";
}

// ChapterOne.cs / c1_visible_E9
data post.c1_visible_E9.0001 {
    value = "水槽里四只用过的杯子，各不相同：\n一只青瓷小杯，杯底没有糖渍；\n一只刻着 H 的凹痕锡杯，杯底一层厚糖渍；\n一只缺口白杯；\n一只粗瓷大杯。";
}

// ChapterOne.cs / c1_visible_E10
data post.c1_visible_E10.0001 {
    value = "罐里的酵种还活着，冒着细泡。\n罐壁上一层摞一层干结的旧面痕，数不清。";
}

// ChapterOne.cs / c1_visible_E11
data post.c1_visible_E11.0001 {
    value = "书架积着灰。灰上留着几块干净的长方形，边缘整齐——这里原先摆过东西。单凭灰痕，还看不出摆了多久。\n架沿上有半枚手印，压在灰上。";
}

// ChapterOne.cs / c1_visible_E12
data post.c1_visible_E12.0001 {
    value = "一件深棕长风衣。\n口袋里：一支石墨笔，一把折叠放大镜，几只证物袋。\n放大镜是黄铜圆框，带一截短柄。";
}

