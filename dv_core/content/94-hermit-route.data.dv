schema "dv-script-v1";
data "space.hermit_route" { value = {
  "schema": "island-route-override-v1",
  "decision_date": "2026-10-29",
  "basis": "user: tower-top suspension bridge reaches mountain and hermit gate opens only at sufficiently high source essence",
  "source_north_route_sha256": "a46d954305360345d236b88e5f51cf4315a84c287cb64e5afe09541947ceaa7c",
  "preserve_island_area_km2": 4.28,
  "hermit_gate_activation_front_z_m": 63.6,
  "threshold_status": "provisional authored design parameter, not a user-specified number",
  "threshold_basis": "Existing 3F absolute floor Z63.6; above 2F Z56.4 and 7.6m below the lowest new bridge deck Z71.2. This is source eligibility, not a promise of safe air.",
  "source_front_ref": {
    "object": "island.climate",
    "facet": "state",
    "field": "lowland_front_z"
  },
  "gate_open_ref": {
    "object": "island.climate",
    "facet": "state",
    "field": "hermit_gate_open"
  },
  "admission_condition": {
    "all": [
      {
        "ref": "island.climate.hermit_gate_open",
        "equals": true
      },
      {
        "ref": "island.climate.lowland_front_z",
        "at_least": 63.6
      }
    ]
  },
  "access_contract": {
    "route": "M stair -> 4F west door -> direct suspension bridge -> mountain hermit gate -> gated R12 ascent -> R12B -> H-A gate",
    "ordinary_lower_R12_connection": false,
    "early_chapters": "Observe the tower-side gate and mountain exterior. No entry into the hermitage before activation.",
    "late_process_status": "Chapters 3-6 altitude-front progression is not implemented. No concentration or clock value is substituted for front altitude."
  },
