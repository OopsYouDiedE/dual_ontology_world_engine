  "operation": {
    "ordinary_access": "既有M梯到4F后即可进入新廊；不需进入名录库，不需祭坛钥匙。主楼至R12在终章之前也可到达，最终祭坛门槛仅由火山口浮式末段实现。",
    "bridge_closed_when": "internal_C>=60 OR wind_mps>=22 OR cable_broken OR deck_roll_deg>=6 OR liquid_depth_on_deck>=0.45 OR both_fans_failed_for_1200s",
    "closure_effect": "拒绝新增进入；已在桥上者仍能沿较近端撤离。面罩只保护角色，不解除桥门联锁。",
    "reopen_when": "内部C<35、风<14m/s连续60s且净积液<0.15m，维护员端闸复位4s；日20撤防锁死后不复开。",
    "daily_operation_end": "第19日18:00停止新批次进入，第19日18:10清桥并撤防；第20日从半山基地继续，不从主楼重新出发。",
    "positive_pressure_Pa": 30,
    "fans": [
      {
        "flow_m3_per_min": 30,
        "count": 2,
        "filtered_inlet_C": 5
      }
    ],
    "external_leak_m3_per_min": 4,
    "enclosed_volume_m3": 1994.7465,
    "internal_C_model": "V dCi/dt =60*(5-Ci)+4*(Co-Ci)，t以分钟计；Co≤100时平衡Ci≤10.9375",
    "initial_C": 5,
    "normal_internal_C_upper_bound": 10.9375,
    "two_fans_failure_backup_seconds": 1200,
    "backup": "两台风机各独立10kWh蓄电池，单机1.5kW；第19日13:00前换满，两台共同可维持正压至18:10。断电时保压阀及气瓶只保证20分钟撤回。",
    "lowland_front_semantics": "L域Z60/90/120为气态前沿与凝积区包络，不是全球静水面；本线以内部Ci、桥面实际液深和结构状态判定。不得用面罩绕开已闭锁的门。",
    "later_altar_threshold_reference": "shared_final_approach.json；Wv>=409.90且入水浮桥对接高度满足门槽，稳态Wv410双向通行。",
    "external_C_keyframes": [
      {
        "day": 19,
        "time": "08:00:00",
        "C": 20
      },
      {
        "day": 19,
        "time": "15:00:00",
