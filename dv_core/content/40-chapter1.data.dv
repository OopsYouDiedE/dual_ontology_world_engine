}

// c1_other_people_build — original source line 2822
data m40.c1_other_people_build.literal_0062 {
    value = "ruan";
}

// c1_other_people_build — original source line 2822
data m40.c1_other_people_build.literal_0063 {
    value = "检视桌上的棋局";
}

// c1_other_people_build — original source line 2822
data m40.c1_other_people_build.literal_0064 {
    value = "阮清月";
}

// c1_other_people_build — original source line 2822
data m40.c1_other_people_build.literal_0065 {
    value = "赢下与恶魔的对局";
}

// c1_other_people_build — original source line 2822
data m40.c1_other_people_build.literal_0066 {
    value = "枕边一枚黑子，凉的。";
}

// c1_other_people_build — original source line 2822
data m40.c1_other_people_build.literal_0067 {
    value = "桌上一盘棋下到中盘。轮到黑走。我记不起这一手要下在哪。";
}

// c1_other_people_build — original source line 2822
data m40.c1_other_people_build.literal_0068 {
    value = "先不下。";
}

// c1_other_people_build — original source line 2822
data m40.c1_other_people_build.literal_0069 {
    value = "上船，然后是一段空白。";
}

// c1_other_people_build — original source line 2822
data m40.c1_other_people_build.literal_0070 {
    value = "opening_ruan.003";
}

// c1_other_people_build — original source line 2822
data m40.c1_other_people_build.literal_0071 {
    value = "opening_ruan.002";
}

// c1_other_people_build — original source line 2822
