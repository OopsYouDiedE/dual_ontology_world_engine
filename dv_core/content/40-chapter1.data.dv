    value = "检视器具和瓶签";
}

// c1_other_people_build — original source line 2828
data m40.c1_other_people_build.literal_0148 {
    value = "维罗妮卡";
}

// c1_other_people_build — original source line 2828
data m40.c1_other_people_build.literal_0149 {
    value = "独立研究，证明理化能解释一切";
}

// c1_other_people_build — original source line 2828
data m40.c1_other_people_build.literal_0150 {
    value = "一股试剂味，很淡，像是乙醚挥发过。";
}

// c1_other_people_build — original source line 2828
data m40.c1_other_people_build.literal_0151 {
    value = "器具都在架上，摆得比我习惯的还整齐。谁替我摆的？";
}

// c1_other_people_build — original source line 2828
data m40.c1_other_people_build.literal_0152 {
    value = "先查瓶签。";
}

// c1_other_people_build — original source line 2828
data m40.c1_other_people_build.literal_0153 {
    value = "最后记得的事：上船。之后的，一件也想不起来。";
}

