// c1_other_people_build — original source line 2827
data m40.c1_other_people_build.literal_0134 {
    value = "检视左肩的皮垫";
}

// c1_other_people_build — original source line 2827
data m40.c1_other_people_build.literal_0135 {
    value = "贝尔特朗";
}

// c1_other_people_build — original source line 2827
data m40.c1_other_people_build.literal_0136 {
    value = "护住平民同伴";
}

// c1_other_people_build — original source line 2827
data m40.c1_other_people_build.literal_0137 {
    value = "手先摸到床边的提灯。灯油还有半截。";
}

// c1_other_people_build — original source line 2827
data m40.c1_other_people_build.literal_0138 {
    value = "左肩的皮垫磨亮了。那是托枪的地方，可枪不在。";
}

// c1_other_people_build — original source line 2827
