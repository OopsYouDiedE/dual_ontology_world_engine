    value = "lucian.desire";
}

// c1_other_people_build — original source line 2820
data m40.c1_other_people_build.literal_0031 {
    value = "ward";
}

// c1_other_people_build — original source line 2820
data m40.c1_other_people_build.literal_0032 {
    value = "检视纸笔";
}

// c1_other_people_build — original source line 2820
data m40.c1_other_people_build.literal_0033 {
    value = "沃德";
}

// c1_other_people_build — original source line 2820
data m40.c1_other_people_build.literal_0034 {
    value = "成为定规则的人";
}

// c1_other_people_build — original source line 2820
data m40.c1_other_people_build.literal_0035 {
    value = "纸。笔。都在桌上。";
}

// c1_other_people_build — original source line 2820
data m40.c1_other_people_build.literal_0036 {
    value = "笔尖是新削的。";
}

// c1_other_people_build — original source line 2820
data m40.c1_other_people_build.literal_0037 {
    value = "从现在开始记。";
}

// c1_other_people_build — original source line 2820
data m40.c1_other_people_build.literal_0038 {
    value = "上船以后的事，一个字也没有记下。这不像我。";
}

// c1_other_people_build — original source line 2820
data m40.c1_other_people_build.literal_0039 {
    value = 55;
}

// c1_other_people_build — original source line 2820
