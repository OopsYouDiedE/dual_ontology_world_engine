    value = "quer.desire";
}

// c1_other_people_build — original source line 2819
data m40.c1_other_people_build.literal_0017 {
    value = "lucian";
}

// c1_other_people_build — original source line 2819
data m40.c1_other_people_build.literal_0018 {
    value = "检视桌上的手稿";
}

// c1_other_people_build — original source line 2819
data m40.c1_other_people_build.literal_0019 {
    value = "卢西安";
}

// c1_other_people_build — original source line 2819
data m40.c1_other_people_build.literal_0020 {
    value = "言灵的完美韵律";
}

// c1_other_people_build — original source line 2819
data m40.c1_other_people_build.literal_0021 {
    value = "嘴边有一句诗，念到一半，韵脚找不着了。";
}

// c1_other_people_build — original source line 2819
data m40.c1_other_people_build.literal_0022 {
    value = "桌上的笔记是我的字，比平时潦草。";
}

// c1_other_people_build — original source line 2819
data m40.c1_other_people_build.literal_0023 {
    value = "先找那个韵。";
}

// c1_other_people_build — original source line 2819
data m40.c1_other_people_build.literal_0024 {
    value = "上船之后呢？也找不着了。";
}

// c1_other_people_build — original source line 2819
data m40.c1_other_people_build.literal_0025 {
    value = "opening_lucian.003";
}

// c1_other_people_build — original source line 2819
data m40.c1_other_people_build.literal_0026 {
    value = "opening_lucian.002";
}

// c1_other_people_build — original source line 2819
data m40.c1_other_people_build.literal_0027 {
    value = 32;
}

// c1_other_people_build — original source line 2819
