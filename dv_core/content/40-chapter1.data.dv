    value = "opening_ruan.004";
}

// c1_other_people_build — original source line 2822
data m40.c1_other_people_build.literal_0073 {
    value = "godot_csharp/scenes/Awakening/Script/story/生态/人物/10_阮清越.story";
}

// c1_other_people_build — original source line 2822
data m40.c1_other_people_build.literal_0074 {
    value = "ruan.desire";
}

// c1_other_people_build — original source line 2823
data m40.c1_other_people_build.literal_0075 {
    value = "elena";
}

// c1_other_people_build — original source line 2823
data m40.c1_other_people_build.literal_0076 {
    value = "查看自己的脚踝";
}

// c1_other_people_build — original source line 2823
data m40.c1_other_people_build.literal_0077 {
    value = "伊莲娜";
}

// c1_other_people_build — original source line 2823
data m40.c1_other_people_build.literal_0078 {
    value = "治好脚踝，查明仪式真相";
}

// c1_other_people_build — original source line 2823
data m40.c1_other_people_build.literal_0079 {
    value = "左脚踝缠着绷带。一动，疼得眼前发白。";
}

// c1_other_people_build — original source line 2823
data m40.c1_other_people_build.literal_0080 {
    value = "脚尖自己绷了一下，像要起步。";
}

// c1_other_people_build — original source line 2823
data m40.c1_other_people_build.literal_0081 {
    value = "别站。再躺一会儿。";
}

// c1_other_people_build — original source line 2823
data m40.c1_other_people_build.literal_0082 {
    value = "我是怎么伤的？只记得上船。";
}

// c1_other_people_build — original source line 2823
data m40.c1_other_people_build.literal_0083 {
    value = "opening_elena.003";
}

// c1_other_people_build — original source line 2823
