}

// c1_other_people_build — original source line 2821
data m40.c1_other_people_build.literal_0047 {
    value = "gu";
}

// c1_other_people_build — original source line 2821
data m40.c1_other_people_build.literal_0048 {
    value = "检视枕边的拓片";
}

// c1_other_people_build — original source line 2821
data m40.c1_other_people_build.literal_0049 {
    value = "顾平章";
}

// c1_other_people_build — original source line 2821
data m40.c1_other_people_build.literal_0050 {
    value = "读通古代铭文";
}

// c1_other_people_build — original source line 2821
data m40.c1_other_people_build.literal_0051 {
    value = "老花镜搁在枕边，镜片上溅了一点墨。";
}

// c1_other_people_build — original source line 2821
data m40.c1_other_people_build.literal_0052 {
    value = "枕边这摞拓片，是哪里的碑？";
}

// c1_other_people_build — original source line 2821
data m40.c1_other_people_build.literal_0053 {
    value = "先把镜片擦干净。";
}

// c1_other_people_build — original source line 2821
data m40.c1_other_people_build.literal_0054 {
    value = "老朽记得上了船。再往后，就记不起了。";
}

// c1_other_people_build — original source line 2821
data m40.c1_other_people_build.literal_0055 {
    value = "opening_gu.003";
}

// c1_other_people_build — original source line 2821
data m40.c1_other_people_build.literal_0056 {
    value = 38;
}

// c1_other_people_build — original source line 2821
data m40.c1_other_people_build.literal_0057 {
    value = "opening_gu.002";
}

// c1_other_people_build — original source line 2821
data m40.c1_other_people_build.literal_0058 {
    value = 40;
}

// c1_other_people_build — original source line 2821
data m40.c1_other_people_build.literal_0059 {
    value = "opening_gu.004";
}

