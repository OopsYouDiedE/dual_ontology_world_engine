data m40.c1_public_answer_speech.pairs {
    value = [["V3_0", "V3_1", "voice-source", "声音来自铜口，经管道传来。", "声音就在门外。"], ["V4_0", "V4_1", "original-words", "霍铎的速记解释为闩门禁开。这是他的记录，不足以还原昨夜每一个字。", "原话是开门救人。"], ["V6_1", "V6_0", "familiarity", "我们原本相熟。", "我们原本不相熟。"]];
