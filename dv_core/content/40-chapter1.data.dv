// c1_other_resident_truth_surface — original source line 3531
data m40.c1_other_resident_truth_surface.return_0002 {
    value = "来问的同伴把封口与毛边递给雀儿。她盯着火漆，想起有人将钥匙和文书交到她掌中，叮嘱她取出内柜物件并藏妥。她承认藏入壁炉砖槽；这不是她自行决定的偷窃。";
}

