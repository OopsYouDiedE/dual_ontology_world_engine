// c1_requested_replies — original source line 1092
data m40.c1_requested_replies.literal_0005 {
    value = "小图代人，我习惯这样——画他手里常拿的家伙。⊥✓，闩好了。";
}

// c1_requested_replies — original source line 1092
data m40.c1_requested_replies.literal_0006 {
    value = 29;
}

// c1_requested_replies — original source line 1095
data m40.c1_requested_replies.literal_0007 {
    value = "阿泠的茶不放糖，老霍的放两勺，那位喝清茶不放奶。阿泠……这称呼怎么脱口就来了。";
}

// c1_requested_replies — original source line 1095
data m40.c1_requested_replies.literal_0008 {
    value = "青瓷杯底没有糖渍，刻 H 的锡杯底有糖渍。我还不能确认这些杯子一直由谁使用。我会备茶、做饭，但登岛后的经历我记不起来。";
}

// c1_requested_replies — original source line 1095
data m40.c1_requested_replies.literal_0009 {
    value = 36;
}

// c1_requested_replies — original source line 1095
data m40.c1_requested_replies.literal_0010 {
    value = "是我喂的。续种，刮壁，盖布——这手法我认得。";
