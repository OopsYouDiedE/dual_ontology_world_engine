data m40.c1_other_resident_truth_surface.return {
    value = "来问的同伴对照火漆指模、封口和纸片毛边：封缄曾由同一只手压合，红墨残纸是从完整文书新撕下的。它说明有人交接，不能独自补出授权者。";
