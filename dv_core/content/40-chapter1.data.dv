    value = "elena.desire";
}

// c1_other_people_build — original source line 2824
data m40.c1_other_people_build.literal_0088 {
    value = "selma";
}

// c1_other_people_build — original source line 2824
data m40.c1_other_people_build.literal_0089 {
    value = "对照窗台的苗与笔记";
}

// c1_other_people_build — original source line 2824
data m40.c1_other_people_build.literal_0090 {
    value = "赛尔玛";
}

// c1_other_people_build — original source line 2824
data m40.c1_other_people_build.literal_0091 {
    value = "为源质这一新物种定名";
}

// c1_other_people_build — original source line 2824
data m40.c1_other_people_build.literal_0092 {
    value = "窗台上一盆苗，没见过，叶背亮得像抹了油。";
}

// c1_other_people_build — original source line 2824
data m40.c1_other_people_build.literal_0093 {
    value = "本子上画着这片叶子，编号那一栏空着。我画的，我没编。";
}

// c1_other_people_build — original source line 2824
data m40.c1_other_people_build.literal_0094 {
    value = "查看叶子和本子。";
}

// c1_other_people_build — original source line 2824
data m40.c1_other_people_build.literal_0095 {
    value = "船靠岸了吗？想不起来。";
}

