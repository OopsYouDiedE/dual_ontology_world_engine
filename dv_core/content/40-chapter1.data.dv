// c1_public_answer_speech — original source line 1616
data m40.c1_public_answer_speech.surface {
    value = "鞋底纹路和灰痕相合，鞋尖朝向插闩。这支持我曾到门前并操作门闩；它不能独自证明动机或我听见了什么。";
}

// c1_public_answer_speech — original source line 1618
data m40.c1_public_answer_speech.literal {
    value = "触闩时我想起自己听从了霍铎。那是熟悉感，不是恢复了同窗记忆；我不能据此证明他的判断正确。";
}

// c1_public_answer_speech — original source line 1619
