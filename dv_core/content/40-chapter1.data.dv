// c1_answer_conflict_response — original source line 1643
data m40.c1_answer_conflict_response.surface {
    value = "你刚才的答辩和现在说的互相矛盾。我不能只因你说得笃定就跟着你。";
}

// c1_answer_conflict_response — original source line 1645
data m40.c1_answer_conflict_response.literal {
    value = "你刚才明明那样说，现在又换了说法。别把我们当作可以随你推论摆弄的人。那是同伴的呼喊，也是人的性命。";
}

