// c1_deep_resonance_action — original source line 1599
data m40.c1_deep_resonance_action.surface {
    value = "苏泠闭上眼，沿着乐谱里缺失的声音继续追索。门边有人喊开门；她想让那人进来。她睁开眼，脸色发白。";
}

// c1_deep_resonance_action — original source line 1602
data m40.c1_deep_resonance_action.literal {
    value = "粉笔灰沾了霍铎一手。他没有松开石板，继续追索那声音：铜口里很清楚，‘等我下一次通知。’他叫我守铜口。……他再也没有来。";
}

// c1_deep_resonance_action — original source line 1605
data m40.c1_deep_resonance_action.literal_0002 {
    value = "沈鼎的拇指沿着罐壁上一层层干面痕继续摸索。阿泠的茶不放糖，老霍的放两勺，那位清茶不放奶。阿泠……这称呼怎么脱口就来了。";
}

