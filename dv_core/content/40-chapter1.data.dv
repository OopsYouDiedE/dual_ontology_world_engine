// c1f_rows — original source line 6235
data m40.c1f_rows.literal_0018 {
    value = "承认黑板上的诗";
}

// c1f_rows — original source line 6235
data m40.c1f_rows.literal_0019 {
    value = "是我写的。我想把听到的契约、名字和期限编进诗里，好让自己记住，也试试看谁愿意谈这些事。这是我的猜想，不是代管者的预言；诗中关于破封的说法还没有证据。";
}

