    value = "moran";
}

// c1_other_people_build — original source line 2825
data m40.c1_other_people_build.literal_0105 {
    value = "检视速写本和炭笔";
}

// c1_other_people_build — original source line 2825
data m40.c1_other_people_build.literal_0106 {
    value = "莫兰";
}

// c1_other_people_build — original source line 2825
data m40.c1_other_people_build.literal_0107 {
    value = "看见更多的以太色层";
}

// c1_other_people_build — original source line 2825
data m40.c1_other_people_build.literal_0108 {
    value = "窗光是灰的。灰底下，还有一层很淡的绿。";
}

// c1_other_people_build — original source line 2825
data m40.c1_other_people_build.literal_0109 {
    value = "速写本摊着，炭笔滚在手边。";
}

// c1_other_people_build — original source line 2825
data m40.c1_other_people_build.literal_0110 {
    value = "那层绿要散了。";
}

// c1_other_people_build — original source line 2825
data m40.c1_other_people_build.literal_0111 {
    value = "船……之后是白的。";
}

