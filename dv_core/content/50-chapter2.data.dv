// c2_runtime_contracts — original source line 2326
data m50.c2_runtime_contracts.literal_0013 {
    value = {"inputs":["actual-exposure","observed-fever","actual-care","terminal-exposure"],"revision_20261022":{"initial_condition":"Su's pre-existing erosion disease, not a preset injury","chronic":"active disease held 4320 minutes causes severe weakness; another 720 untreated minutes causes motor impairment and serious-injury history","acute":"actual exposure >=8 with coma or stone stupor, or Bertrand's actual rescue exposure, starts respiratory failure; 120 continuous untreated minutes can be fatal outside the declared safe interior","serious_injury":"actual motor impairment preventing independent movement, or actual respiratory failure; fever alone is insufficient"},"anti_erosion":{"source":"Actual joint materials check and Veronica mixing at white_tower_safe, with custody and restriction conditions; yield is declared in m50.c2_resources.parameters.","receipt":"Actual applied mixing/pickup/administration receipts expose resource changes; stock + Mora carried + used equals prepared doses.","quantity":"One initial material batch; a completed actual mix consumes the batch and creates three labelled doses. Each pickup transfers one dose from stock to Mora; each actual administration consumes one carried dose. No refill by date.","scope":"successful administration halts the new disease/respiratory progression and clears current weakness, motor impairment and respiratory failure; retains serious-injury history, coma, established stone stupor, exposure and death; never revival; finite chapter-two new-medicine stock, one dose per untreated actual patient contact; old half-dose branch is not represented by these new-medicine counters."},"constraint":"never-use-third-day-illness-or-fourth-night-death-as-an-assignment","stable_stupor":{"participants":["moran","bertrand"],"requires":"alive, actual exposure >=8, untreated respiratory failure held 120 minutes, and actual arrival in the declared safe interior; Bertrand also requires actual rescue_exposed","result":"irreversible stone_stupor and coma, serious-injury history retained, current respiratory_failure stopped; no death reset, revival, or recovery of autonomy","continued_danger":"continued unsafe exposure can remain fatal; a safe survivor is not converted to death solely because the calendar reached the fifth morning","parameters":"reuse existing exposure threshold 8 and respiratory duration 120; no new numerical clinical parameter"}};
}

