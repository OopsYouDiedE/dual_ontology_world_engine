// c2d_demon_rebuke_rows — original source line 4695
data m50.c2d_demon_rebuke_rows.literal_0002 {
    value = "intervened";
}

// c2d_demon_rebuke_rows — original source line 4696
data m50.c2d_demon_rebuke_rows.mora_text {
    value = "我反对把同伴的生命当作与恶魔谈判的筹码。它是否介入、介入后发生了什么，都要逐项核对，不能把托付生命当作理所当然。";
}

// c2d_demon_rebuke_rows — original source line 4697
data m50.c2d_demon_rebuke_rows.literal_0003 {
    value = "mora.c2.dialogue.demon_rebuke";
}

// c2d_demon_rebuke_rows — original source line 4697
data m50.c2d_demon_rebuke_rows.literal_0004 {
    value = "追问安全信息的遗漏";
}

// c2d_demon_rebuke_rows — original source line 4698
data m50.c2d_demon_rebuke_rows.literal_0005 {
    value = "demon_rebuked";
}

// c2d_demon_rebuke_rows — original source line 4700
data m50.c2d_demon_rebuke_rows.elena_text {
    value = "你在走钢丝，侦探。我不信任向深渊代管者求助的选择。作出承诺前，你想清楚自己能担下什么了吗？";
}

// c2d_demon_rebuke_rows — original source line 4701
data m50.c2d_demon_rebuke_rows.literal_0006 {
    value = "elena.c2.dialogue.demon_rebuke";
}

// c2d_demon_rebuke_rows — original source line 4701
data m50.c2d_demon_rebuke_rows.literal_0007 {
    value = "质疑沉静室事件的说明";
}

// c2d_demon_rebuke_rows — original source line 4702
data m50.c2d_demon_rebuke_rows.literal_0008 {
    value = { "location" = "quiet_room"; "participants" = ["detective"]; "mode" = "all-present"; };
}

// c2d_demon_rebuke_rows — original source line 4704
data m50.c2d_demon_rebuke_rows.ruan_text {
    value = "我反对这种引狼入室的劫争。借它的力量之后，条件、代价与能够制衡它的手段，你准备怎样逐项交代？";
}

// c2d_demon_rebuke_rows — original source line 4705
data m50.c2d_demon_rebuke_rows.literal_0009 {
    value = "ruan.c2.dialogue.demon_rebuke";
}

// c2d_demon_rebuke_rows — original source line 4705
data m50.c2d_demon_rebuke_rows.literal_0010 {
    value = "追问契约的履行";
}

// c2d_demon_rebuke_rows — original source line 4706
data m50.c2d_demon_rebuke_rows.literal_0011 {
    value = { "location" = "central_hall"; "participants" = ["detective"]; "mode" = "all-present"; };
}

// c2d_demon_trial_dialogues — original source line 4712
data m50.c2d_demon_trial_dialogues.literal {
    value = "修罗侦探路线：恶魔真话背刺与大公审";
}

// c2d_demon_trial_dialogues — original source line 4716
data m50.c2d_demon_trial_dialogues.literal_0002 {
    value = "我实际听到侦探对莫兰说：『";
}

// c2d_demon_trial_dialogues — original source line 4716
data m50.c2d_demon_trial_dialogues.literal_0003 {
    value = "』。这句话与后来的选择、执行和伤亡，仍须逐项核对。";
}

// c2d_demon_trial_dialogues — original source line 4717
data m50.c2d_demon_trial_dialogues.literal_0004 {
    value = "demon.c2.truth_betrayal";
}

// c2d_demon_trial_dialogues — original source line 4717
data m50.c2d_demon_trial_dialogues.literal_0005 {
    value = "陈述有关侦探的证言";
}

// c2d_demon_trial_dialogues — original source line 4718
data m50.c2d_demon_trial_dialogues.literal_0006 {
    value = { "location" = "central_hall"; "participants" = ["ruan", "ward", "mora"]; "mode" = "at-least-one-present"; };
}

// c2d_demon_trial_dialogues — original source line 4718
data m50.c2d_demon_trial_dialogues.literal_0007 {
    value = "demon_truth_betrayal";
}

// c2d_demon_trial_dialogues — original source line 4720
data m50.c2d_demon_trial_dialogues.ruan_trial_text {
    value = "先核对侦探实际说过的话，再核对莫兰自己的选择、实际动线和伤情。不能仅凭言语与伤亡的先后，就把借刀杀人的推断当作定案事实。";
}

// c2d_demon_trial_dialogues — original source line 4722
data m50.c2d_demon_trial_dialogues.literal_0008 {
    value = "ruan.c2.trial.indict";
}

// c2d_demon_trial_dialogues — original source line 4722
data m50.c2d_demon_trial_dialogues.literal_0009 {
    value = "提出对侦探的指控";
}

// c2d_demon_trial_dialogues — original source line 4723
data m50.c2d_demon_trial_dialogues.literal_0010 {
    value = { "speaker" = "demon"; "action_id" = "demon.c2.truth_betrayal"; };
}

// c2d_demon_trial_dialogues — original source line 4723
data m50.c2d_demon_trial_dialogues.literal_0011 {
    value = "trial_indicted";
}

// c2d_demon_trial_dialogues — original source line 4726
data m50.c2d_demon_trial_dialogues.mora_trial_text {
    value = "我在现场确认莫兰已经死亡。死亡原因、言语是否影响了他的选择、又怎样造成死亡，还须另有证据。";
}

