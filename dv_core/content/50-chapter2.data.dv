    value = "传声与机械";
}

// c2d_curriculum — original source line 4529
data m50.c2d_curriculum.literal_0007 {
    value = "传声管两端都能传声。先核对通路与盖片，发话、复述分开进行；同时说话会互相遮盖。管口附近的话也可能传到另一端。";
}

