data m50.c2d_curriculum.literal_0002 {
    value = "守则读法";
}

// c2d_curriculum — original source line 4528
data m50.c2d_curriculum.literal_0003 {
    value = "入夜之后，诸位留于室内。已开放的封闭连廊也须核对密封、通风和现场读数。源质计在户外仪器阵入口，先在安全侧学会读数，再定路线。低洼、夜间与无风时易积灰，风止或地震后停行复测。读数不明时，留在已确认安全处，呼叫协助。";
}

// c2d_curriculum — original source line 4528
data m50.c2d_curriculum.literal_0004 {
    value = "最低限度安全教学";
}

// c2d_curriculum — original source line 4529
