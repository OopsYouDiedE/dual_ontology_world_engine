    value = "trial_witnessed";
}

// c2d_demon_trial_dialogues — original source line 4730
data m50.c2d_demon_trial_dialogues.ward_trial_text {
    value = "我听到了现场死亡的证言。言论原始记录、本人选择、实际动线与死因仍须分别核对；这些证言尚不足以认定侦探有罪，不能据此直接监禁或剥夺配给。";
