    value = "提出尽忘归乡的协商";
}

// c2h_rows — original source line 5395
data m50.c2h_rows.literal_0002 {
    value = "我提议按契约第六条协商全体尽忘归乡。仍在岛且存活的每位在册学员须在神智清醒时亲自同意，包括我自己；听见提议不算同意。全票公决后，须全员下一次自然入眠且无人撤回，才可安全遣返；现在的协商不是归乡已经成立。";
}

// c2h_rows — original source line 5396
