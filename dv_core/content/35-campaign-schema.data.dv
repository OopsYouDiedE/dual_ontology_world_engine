// sims_brush_off_rows — original source line 378
data m35.sims_brush_off_rows.literal_0018 {
    value = "随口搪塞甲区寝室的琐事";
}

// sims_brush_off_rows — original source line 379
data m35.sims_brush_off_rows.literal_0019 {
    value = "嗨，关在屋里闷都闷死了，无非是翻翻旧物、拌几句嘴，我就顺手拿钢丝把门挑开出来透透气呗！里头那些鸡毛蒜皮的事，有什么好细说的。";
}

