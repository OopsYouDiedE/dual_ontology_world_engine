// sims_brush_off_rows — original source line 388
data m35.sims_brush_off_rows.literal_0022 {
    value = "冷淡敷衍甲区室内的问答";
}

// sims_brush_off_rows — original source line 389
data m35.sims_brush_off_rows.literal_0023 {
    value = "不过是按铜口定下的规矩报了个名字、递了句答复罢了。内室那些杂乱口角，不提也罢。";
}

