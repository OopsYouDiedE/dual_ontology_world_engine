// sims_brush_off_rows — original source line 359
data m35.sims_brush_off_rows.literal_0008 {
    value = "方才代管者已在铜口交代过了：丙区西夹道尚有源质余气，门内人并不知情，依《契约》第五条暂不开闸；丁区有人高烧清创，从内侧拧死了死锁与传声止音阀。等明日散尽余气再说吧。";
}

