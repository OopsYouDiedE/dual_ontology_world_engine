  "navigation_cut_rules": [
    {
      "when": "public B1 h>=0.05",
      "cut": [
        "UC-MW-DG",
        "UC-ME-DG",
        "UC-MW-D0",
        "UC-ME-D0"
      ],
      "keep": "2F→independent dry stair→B1 airlock→tunnel"
    },
    {
      "when": "external ground water Z>=48.15",
      "cut": [
        "UC-MW-D-1F",
        "UC-ME-D-1F"
      ],
      "keep": "2F and B1 tunnel-side access"
    },
    {
      "when": "tunnel internal h>=0.45 or tunnel C>=60 or external ground water Z>51.8 or underground wet_service_seconds>=1200 or both ventilation drives failed",
      "cut": [
        "UC-MW-DU",
        "UC-ME-DU"
      ],
      "keep": "2F escape from both dry shafts",
      "scope": "deny new entry; keep directional evacuation for people already in tunnel"
    },
    {
      "when": "airlock h>=0.05 or C>20",
      "cut": [
        "UC-MW-DS-B1",
        "UC-ME-DS-B1"
      ],
      "manual_override": "紧急逃生杆可从前室侧操作；外闸先机械闭合；放行时将室内水/气真实传播到梯芯，不清零"
    }
  ],
