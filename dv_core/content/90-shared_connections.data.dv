      {
        "old": "主楼到各馆只走地面路。",
        "new": "学院平时使用地面路；3F吊桥网与B1水密地下网分别承担高位与封闭转移。"
      },
      {
        "old": "公共联系优先采用沿地面道路、院落和分段连廊。",
        "new": "公共联系采用地面道路、3F高桥网和独立干井接入的B1水密通道三套图。"
      },
      {
        "old": "无地下暗道与跨建筑传声管。",
        "new": "仅列明的地下水密转移通道属于人物通路；跨建筑传声管仍不生成。"
      },
      {
        "old": "四科研馆无B1人行密道、无统一2F桥。",
        "new": "文契院和白塔院经两条独立水密通道接入主楼；高桥按各馆真实标高及坡道接入，层号不等同于绝对高程。"
      }
    ],
