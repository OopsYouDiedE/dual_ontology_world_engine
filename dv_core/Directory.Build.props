<Project>
  <!-- Keep generated outputs out of the maintained source tree. -->
  <PropertyGroup>
    <BaseOutputPath>$(MSBuildThisFileDirectory)../.runtime/build/bin/$(MSBuildProjectName)/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)../.runtime/build/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/obj/**;**/bin/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
