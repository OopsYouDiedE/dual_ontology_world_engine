fn dvs_argument_sources(events, actor):
    actor = dvs_update_support_events(actor, events)
    let subject = actor.id
    events = actor.support_events
    var result = []
    var i = 0
    while (i < rt_count(events)):
        var event = events[i]
        if dv_and((event.actor == subject), dv_or((event.type == "observation"), (event.type == "listener_parse"))):
            var observations = event.data.observations
            var j = 0
            while (j < rt_count(observations)):
                rt_push(result, {"event_id": event.id, "observation": observations[j]})
                j = (j + 1)
        i = (i + 1)
    return result

fn dvs_capture_public_topics(actor, events, time, parent):
    var bindings = dv_find(actor.policy, "topic_bindings", [])
    var heard = dv_find(actor, "heard_topics", [])
    var i = 0
    while (i < rt_count(bindings)):
        var binding = bindings[i]
        var topic = bindings[i].topic
        if dv_and((not dv_has_key(heard, topic)), (dv_truth(actor.mind, binding.heard_when) == "true")):
            var sources = dvs_support_parents(actor.mind, dvs_sim_refs(binding.heard_when), events, actor)
            if (0 < rt_count(sources)):
                var record = dv_with({"topic": topic, "source_event_ids": sources, "heard_when": binding.heard_when}, "origin_speakers", dvs_topic_origin_speakers(events, sources))
                dvs_event(events, "public_topic_heard", actor.id, time, dv_explanation_merge(dv_single(parent), sources), record)
                heard = dv_with(heard, topic, record)
        i = (i + 1)
    return dvs_capture_heard_utterances(dv_with(actor, "heard_topics", heard), events)

fn dvs_argument_revoke(actor, events, time, parent):
    var argument = actor.argument
    var world = actor.mind
    var changes = actor.argument.changes
    var i = 0
    var restored = []
    var derivations = dv_find(actor, "inference_derivations", [])
    var contaminated = []
    var remaining = dv_find(actor.policy, "reason_budget", 0)
    var checked = 0
    var blocked = false
    var descendants = []
    var updated = false
    while (i < rt_count(changes)):
        contaminated = dvp_add_ref(contaminated, changes[i].ref)
        i = (i + 1)
    i = (rt_count(derivations) - 1)
    while dv_and((not (i < 0)), (not blocked)):
        var derivation = derivations[i]
        var dependent = false
        var inputs = derivations[i].inputs
        var j = 0
        if (remaining < 1):
            blocked = true
        else:
            remaining = (remaining - 1)
            checked = (checked + 1)
            while (j < rt_count(inputs)):
                if dv_has(contaminated, inputs[j].ref):
                    dependent = true
                j = (j + 1)
        if dv_and((not blocked), dv_and(dependent, dv_find(derivation, "valid", true))):
            var outputs = derivation.changes
            var k = 0
            while (k < rt_count(outputs)):
                var change = outputs[k]
                var current = dv_read(world, outputs[k].ref)
                if dv_same(current, change.after):
                    world = dv_store(world, change.ref, change.before)
                    contaminated = dvp_add_ref(contaminated, change.ref)
                    rt_push(restored, change)
                k = (k + 1)
            rt_push(descendants, derivation.event)
            derivations = dvs_replace(derivations, i, dv_with(derivation, "valid", false))
        i = (i - 1)
    i = 0
    if blocked:
        false
    else:
        while (i < rt_count(changes)):
            var change = changes[i]
            var cell = dv_read(world, changes[i].ref)
            if dv_and((dv_find(cell, "source", "") == "abduction"), dv_has(dv_find(cell, "basis", []), argument.id)):
                world = dv_store(world, change.ref, change.before)
                rt_push(restored, change)
            i = (i + 1)
    if (0 < rt_count(restored)):
        world = dv_with(world, "revision", (world.revision + 1))
    var local_1 = false
    if blocked:
        local_1 = argument
    else:
        local_1 = false
    updated = dv_with_many(actor, {"mind": world, "argument": local_1, "argument_revocation_pending": blocked, "ready_hypothesis": false, "inference_derivations": derivations, "cognition_blocked": blocked, "policy": dv_with(actor.policy, "reason_budget", remaining)})
    updated = dv_with(updated, "last_cognitive_event", rt_cat("e", rt_show(rt_count(events))))
    var local_2 = false
    if blocked:
        local_2 = "model_argument_revocation_pending"
    else:
        local_2 = "model_argument_revoked"
    dvs_event_prepared(events, local_2, actor.id, time, dvs_cognitive_parents(actor, dv_explanation_merge(dv_pair(parent, argument.id), descendants)), dv_with_many({"argument": argument, "mind_revision_before": actor.mind.revision, "mind_revision_after": world.revision, "restored": restored}, {"checked": checked, "remaining": remaining, "actor_id": actor.id, "actor_before": dv_without(actor, "simulations"), "actor_after": dv_without(updated, "simulations"), "mind_before": actor.mind, "mind_after": world}))
    return updated

fn dvs_factor_argument(result, coverage):
    var argument = result.argument
    var certificates = coverage.certificates
    var i = 0
    var events = []
    var sources = []
    var inputs = []
    while (i < rt_count(certificates)):
        var certificate = certificates[i]
        var chain = certificates[i].source_chain
        var j = 0
        events = dv_explanation_merge(events, dv_single(certificate.event))
        sources = dv_explanation_merge(sources, certificate.source_event_ids)
        while (j < rt_count(chain)):
            rt_push(inputs, {"ref": chain[j].ref, "cell": chain[j].cell})
            j = (j + 1)
        i = (i + 1)
    argument = dv_with_many(argument, {"factor_coverage": coverage, "competitor_events": dv_explanation_merge(argument.competitor_events, events), "source_event_ids": dv_explanation_merge(argument.source_event_ids, sources), "inputs": dv_explanation_merge(argument.inputs, inputs)})
    return dv_with(result, "argument", argument)

fn dvs_capture_heard_utterances(actor, events):
    events = rt_snapshot(events)
    var heard = dv_find(actor, "heard_utterances", [])
    var i = dv_find(actor, "heard_utterances_cursor", 0)
    let total = rt_count(events)
    if i == total and dv_has_key(actor, "heard_utterances"):
        return actor
    while (i < total):
        var event = events[i]
        if dv_and((event.actor == actor.id), (event.type == "listener_parse")):
            var data = event.data
            var source = data.source_event
            var existing = dv_find(heard, source, false)
            if existing == false or existing.parse_event != event.id:
                let literal = dvs_find_event_by_id(events, source)
                if literal != false and dv_has(event.parents, source) and literal.actor != actor.id:
                    heard = dv_with(heard, source, dv_with({"source_event": source, "parse_event": event.id, "speaker": literal.actor, "scope": dv_find(data.speech, "scope", "")}, "refs", dvs_sim_refs(data.literal)))
        i = (i + 1)
    return dv_with_many(actor, {"heard_utterances": heard, "heard_utterances_cursor": total})

fn dvs_topic_origin_speakers(events, sources):
    var pending = dv_clone(sources)
    var visited = []
    var result = []
    var i = 0
    while (i < rt_count(pending)):
        var id = pending[i]
        if dv_has(visited, id):
            false
        else:
            rt_push(visited, id)
            let event = dvs_find_event_by_id(events, id)
            if (event != false):
                if dv_or((event.type == "observation"), (event.type == "listener_parse")):
                    var source = dv_find(event.data, "source_event", "")
                    if dv_and((not (source == "")), dv_has(event.parents, source)):
                        pending = dv_explanation_merge(pending, dv_single(source))
                else:
                    if (event.type == "public_topic_heard"):
                        pending = dv_explanation_merge(pending, dv_find(event.data, "source_event_ids", []))
                if (event.type == "speech_literal"):
                    result = dv_explanation_merge(result, dv_single(event.actor))
        i = (i + 1)
    return result

fn dvs_topic_was_heard(actor, topic):
    return dv_has_key(dv_find(actor, "heard_topics", []), topic)

fn dvs_argument_valid(actor):
    var argument = dv_find(actor, "argument", false)
    if argument == false or not dv_record_like(argument):
        return false
    else:
        let topic = dv_find(argument, "question_id", "")
        return topic != "" and dv_and(dv_same(dv_find(argument, "adoptions", []), actor.mind.adoptions), dvs_topic_was_heard(actor, topic))

fn dvs_argument_inputs_current(actor):
    var argument = dv_find(actor, "argument", false)
    var valid = true
    var i = 0
    if argument == false or not dv_has_key(argument, "inputs") or not dv_has_key(argument, "changes"):
        return false
    else:
        var inputs = argument.inputs
        while (i < rt_count(inputs)):
            var input = inputs[i]
            if dv_same(input.cell, dv_read(actor.mind, input.ref)):
                false
            else:
                var changes = argument.changes
                var j = 0
                var own_transaction = false
                var current = dv_read(actor.mind, input.ref)
                while (j < rt_count(changes)):
                    var change = changes[j]
                    if dv_and(dv_same(change.ref, input.ref), dv_and((dv_find(current, "source", "") == "abduction"), dv_and(dv_has(dv_find(current, "basis", []), argument.id), dv_same(current.value, change.after.value)))):
                        own_transaction = true
                    j = (j + 1)
                if own_transaction:
                    false
                else:
                    valid = false
            i = (i + 1)
        return valid

fn dvs_action_requires_argument(action):
    return dv_find(action, "speech_from_argument", false) or dv_has_key(action, "argument_slots")

fn dvs_refresh_argument(actor, events, time, parent):
    if dv_find(actor, "argument", false) != false:
        if dv_find(actor, "argument_revocation_pending", false) or not dvs_argument_valid(actor) or not dvs_argument_inputs_current(actor):
            return dvs_argument_revoke(actor, events, time, parent)
    return actor

// Resolve a real replay's question before factor proofs or models read the mind.
// A different admitted question must not inherit the old argument's own writes.
fn dvs_prepare_replay_argument(actor, action, events, time, parent):
    actor = dvs_refresh_argument(actor, events, time, parent)
    var question = ""
    let argument = dv_find(actor, "argument", false)
    var previous = ""
    if argument != false:
        previous = dv_find(argument, "question_id", "")
    let manual = dv_find(action, "replay_hypothesis_id", "")
    let candidates = dv_find(actor.policy, "hypotheses", [])
    var i = 0
    while i < rt_count(candidates):
        let candidate = candidates[i]
        let topic = dv_find(candidate, "question", dv_find(candidate, "topic", ""))
        if topic != "" and 0 < rt_count(dv_find(candidate, "claim_slots", [])) and (manual == "" or manual == candidate.id):
            if dvs_replay_candidate_available(actor, candidate) and (manual == "" or dvs_manual_candidate_available(actor, candidate)):
                if question == "" or (question == previous and topic != previous):
                    question = topic
        i = i + 1
    if not dv_find(actor, "cognition_blocked", false) and argument != false and question != "" and question != previous:
        let requested = dvs_event(events, "model_argument_question_changed", actor.id, time, dvs_cognitive_parents(actor, [parent, argument.id]), {"previous_question": previous, "question": question, "argument_id": argument.id, "mind_revision": actor.mind.revision})
        actor = dvs_argument_revoke(actor, events, time, requested)
    return {"actor": actor, "question": question}

// One acceptance pass over models actually computed by this paid replay.
// dv_accept_explanation owns all claims and defeasible writes; this glue only
// supplies actual sources, verified exclusions and the owner's remaining budget.
fn dvs_accept_paid_arguments(actor, replayed, question_id, events, time, parent):
    if dv_find(dv_find(actor.mind, "CognitionFilter", []), "anterograde", false):
        return actor
    actor = dvs_refresh_argument(actor, events, time, parent)
    if dv_find(actor, "cognition_blocked", false):
        return actor
    if dvs_argument_valid(actor) and dvs_argument_inputs_current(actor) and dv_find(actor.argument, "question_id", "") == question_id:
        return actor
    // Withdrawal belongs before model reads. Never repair it here by accepting
    // a model that could have consumed an earlier argument's defeasible writes.
    if dv_find(actor, "argument", false) != false:
        return actor
    actor = dvs_capture_public_topics(dvs_update_support_events(actor, events), events, time, parent)
    let sources = dvs_argument_sources(events, actor)
    let candidates = dv_find(actor.policy, "hypotheses", [])
    var i = 0
    while i < rt_count(replayed):
        let hypothesis = replayed[i]
        let question = dv_find(hypothesis, "question", dv_find(hypothesis, "topic", ""))
        let model = dvs_cached_model(actor, hypothesis)
        let model_event = dvs_find_event_by_id(events, dv_find(model, "event", ""))
        let slots = dv_find(hypothesis, "claim_slots", [])
        if question != "" and question == question_id and dvs_topic_was_heard(actor, question) and 0 < rt_count(slots) and dv_explanation_model_complete(model, "explained", actor.mind.revision) and dvs_public_model_paid(events, dv_find(model, "event", ""), actor.id):
            // A cached model from an older replay is not a newly computed candidate.
            if model_event != false and dv_has(model_event.parents, dv_find(actor, "model_paid_event", "")):
                let coverage = dvs_factor_coverage(actor, hypothesis, events)
                if not dvs_factor_covered(hypothesis, coverage.certificates):
                    var competitors = []
                    var j = 0
                    while j < rt_count(candidates):
                        let other = candidates[j]
                        if other.id != hypothesis.id and dv_find(other, "group", "") == dv_find(hypothesis, "group", "") and dvp_topic(actor, other) and dv_truth(actor.mind, dv_find(other, "available_when", dv_true())) == "true":
                            if not dvs_factor_covered(other, coverage.certificates):
                                var comparison = dvs_cached_model(actor, other)
                                if not dvs_model_paid_result(events, dv_find(comparison, "event", ""), actor.id, "inconsistent"):
                                    comparison = {"status": "unpaid-or-unresolved-competitor", "source_revision": actor.mind.revision}
                                rt_push(competitors, comparison)
                        j = j + 1
                    var policy = dv_find(actor.policy, "abduction", [])
                    j = 0
                    while j < rt_count(coverage.certificates):
                        policy = dv_with(policy, "confidence_cap", dv_min(dv_find(policy, "confidence_cap", 0), coverage.certificates[j].confidence))
                        j = j + 1
                    let result = dvs_factor_argument(dv_accept_explanation(actor.mind, model, competitors, slots, sources, policy, dv_find(actor.policy, "reason_budget", 0), time, rt_cat("e", rt_show(rt_count(events)))), coverage)
                    var parents = dvs_cognitive_parents(actor, [parent, model.event])
                    parents = dv_explanation_merge(parents, result.argument.source_event_ids)
                    parents = dv_explanation_merge(parents, result.argument.competitor_events)
                    var kind = "model_argument_unavailable"
                    if result.accepted:
                        kind = "model_argument_accepted"
                    let accepted_event = dvs_event(events, kind, actor.id, time, parents, {"actor_id": actor.id, "actor_revision": actor.mind.revision, "hypothesis": hypothesis, "competitors": competitors, "result": result})
                    actor = dv_with_many(actor, {"last_cognitive_event": accepted_event, "policy": dv_with(actor.policy, "reason_budget", result.remaining)})
                    if result.accepted:
                        return dv_with_many(actor, {"mind": result.world, "argument": dv_with_many(result.argument, {"adoptions": actor.mind.adoptions, "question_id": question, "hypothesis_id": hypothesis.id})})
        i = i + 1
    return actor

// Read only the owner's existing accepted argument. No model run, acceptance,
// new belief or predicted listener state is produced by action materialization.
fn dvs_argument_action_claims(actor, action):
    if not dvs_argument_valid(actor) or not dvs_argument_inputs_current(actor):
        return false
    let argument = actor.argument
    if dv_find(argument, "question_id", "") == "" or dv_find(action, "argument_question", argument.question_id) != argument.question_id:
        return false
    let requested = dv_find(action, "argument_slots", [])
    if rt_count(requested) == 0:
        return false
    let claims = dv_find(argument, "claims", [])
    var result = []
    var used = []
    var i = 0
    while i < rt_count(requested):
        let slot = requested[i]
        if dv_has(used, slot):
            return false
        rt_push(used, slot)
        var found = false
        var j = 0
        while j < rt_count(claims):
            if dv_find(claims[j], "slot_id", "") == slot:
                if found != false or not dv_has_key(claims[j], "ref") or not dv_has_key(claims[j], "value"):
                    return false
                found = claims[j]
            j = j + 1
        if found == false:
            return false
        rt_push(result, found)
        i = i + 1
    return result

fn dvs_argument_claim_proposition(claims):
    var propositions = []
    var i = 0
    while i < rt_count(claims):
        rt_push(propositions, dv_fact(claims[i].ref, claims[i].value))
        i = i + 1
    return dv_all(propositions)

fn dvs_argument_reassessment_sources(actor, action, argument):
    let heard = dv_find(actor, "heard_utterances", [])
    let scope = dv_find(action, "reassessment_source_scope", "")
    let topic = dv_find(dv_find(actor, "heard_topics", []), argument.question_id, [])
    var result = []
    var i = 0
    while i < rt_count(heard):
        let record = heard[i][1]
        if scope != "" and scope == record.scope and dv_has(dv_find(topic, "origin_speakers", []), record.speaker):
            result = dv_explanation_merge(result, dv_single(record.source_event))
        i = i + 1
    return result

fn dvs_argument_proposal(actor, action, claims):
    let argument = actor.argument
    return {"argument_id": argument.id, "id": argument.id, "estimated": argument.estimated, "confidence": argument.confidence, "claims": claims, "source_event_ids": argument.source_event_ids, "model_event": argument.model_event, "reassessment_sources": dvs_argument_reassessment_sources(actor, action, argument)}

// Content supplies wording; only the accepted argument supplies slot values.
// This surface is the same actually spoken text for believers and dissenters.
fn dvs_argument_surface(action, claims):
    let declaration = dv_find(action, "argument_surface", false)
    if declaration == false:
        return dv_find(dv_find(action, "argument_speech_template", dv_find(action, "speech", [])), "surface", "")
    var text = declaration.template
    let bindings = dv_find(declaration, "bindings", [])
    var i = 0
    while i < rt_count(bindings):
        let binding = bindings[i]
        var found = false
        var j = 0
        while j < rt_count(claims):
            if claims[j].slot_id == binding.slot:
                found = claims[j]
            j = j + 1
        if found == false:
            return false
        let value = rt_show(found.value)
        let labels = dv_find(binding, "labels", [])
        if not dv_has_key(labels, value):
            return false
        text = dvs_present_replace(text, rt_cat("{", rt_cat(binding.name, "}")), dv_get(labels, value))
        i = i + 1
    return text

fn dvs_argument_action_current(actor, action):
    if not dvs_action_requires_argument(action):
        return true
    if not dv_find(action, "argument_available", false) or not dv_same(dv_find(action, "argument", false), dv_find(actor, "argument", false)):
        return false
    let claims = dvs_argument_action_claims(actor, action)
    if claims == false:
        return false
    let proposition = dvs_argument_claim_proposition(claims)
    if dv_find(action, "speech_from_argument", false):
        let speech = dv_find(action, "speech", [])
        let proposal = dvs_argument_proposal(actor, action, claims)
        let surface = dvs_argument_surface(action, claims)
        return surface != false and dv_same(dv_find(action, "surface", ""), surface) and dv_same(dv_find(speech, "surface", ""), surface) and dv_same(dv_find(speech, "literal_ast", false), proposition) and dv_same(dv_find(speech, "proposal", false), proposal) and dv_same(dv_find(action, "proposal", false), proposal)
    return dv_same(dv_find(action, "answer", false), proposition)

fn dvs_argument_action_evidence(actor, action, events):
    if not dvs_action_requires_argument(action):
        return true
    if not dvs_argument_action_current(actor, action):
        return false
    let proof = dv_with(action, "answer", dvs_argument_claim_proposition(dvs_argument_action_claims(actor, action)))
    return dvs_public_argument_valid(proof, [], events, actor.id)

fn dvs_argument_action(actor, action, events):
    if not dvs_action_requires_argument(action):
        return action
    // Invalidate old materialized fields while retaining authored speech metadata.
    var result = dv_with(dv_without(dv_without(action, "argument"), "proposal"), "argument_available", false)
    result = dv_without(result, "answer")
    if dv_find(action, "speech_from_argument", false):
        let template = dv_without(dv_without(dv_find(action, "argument_speech_template", dv_find(action, "speech", [])), "literal_ast"), "proposal")
        result = dv_without(result, "speech")
        result = dv_without(result, "surface")
        if 0 < rt_count(template):
            result = dv_with(result, "argument_speech_template", template)
    let claims = dvs_argument_action_claims(actor, action)
    if claims == false:
        return result
    let proposition = dvs_argument_claim_proposition(claims)
    let proof = dv_with_many(result, {"argument": actor.argument, "answer": proposition})
    if not dvs_public_argument_valid(proof, [], events, actor.id):
        return result
    result = dv_with_many(result, {"argument": actor.argument, "argument_available": true})
    if dv_find(action, "speech_from_argument", false):
        let proposal = dvs_argument_proposal(actor, action, claims)
        let surface = dvs_argument_surface(result, claims)
        if surface == false or surface == "":
            return dv_with(result, "argument_available", false)
        return dv_with_many(result, {"surface": surface, "speech": dv_with_many(dv_find(result, "argument_speech_template", []), {"literal_ast": proposition, "proposal": proposal, "surface": surface}), "proposal": proposal})
    return dv_with(result, "answer", proposition)

fn dvs_materialize_arguments(actor, events):
    var actions = actor.actions
    var changed = false
    var i = 0
    while i < rt_count(actions):
        if dvs_action_requires_argument(actions[i]):
            let action = dvs_argument_action(actor, actions[i], events)
            if not dv_same(action, actions[i]):
                actions = dvs_replace(actions, i, action)
                changed = true
        i = i + 1
    if not changed:
        return actor
    return dv_with(actor, "actions", actions)

fn dvs_factor_coverage(actor, hypothesis, events):
    var candidates = dv_find(actor.policy, "hypotheses", [])
    var catalog = []
    var certificates = dv_find(actor, "factor_certificates", [])
    var verified = []
    var i = 0
    while (i < rt_count(candidates)):
        var candidate = candidates[i]
        if dv_and(dvp_topic(actor, candidate), (dv_find(candidate, "group", "") == dv_find(hypothesis, "group", ""))):
            rt_push(catalog, candidate)
        i = (i + 1)
    if dvs_factor_catalog_complete(dv_find(actor.policy, "factor_domains", []), catalog):
        i = 0
        while (i < rt_count(certificates)):
            if dvs_factor_certificate_current(actor, certificates[i], events):
                rt_push(verified, certificates[i])
            i = (i + 1)
    return {"catalog": catalog, "certificates": verified}

fn dvs_factor_covered(candidate, certificates):
    var i = 0
    var covered = false
    var assignments = dv_find(candidate, "variable_assignments", [])
    while (i < rt_count(certificates)):
        if dvs_factor_covers(certificates[i], assignments):
            covered = true
        i = (i + 1)
    return covered

fn dvs_update_support_events(actor, events):
    events = rt_snapshot(events)
    var support = dv_find(actor, "support_events", [])
    var cursor = dv_find(actor, "support_events_cursor", 0)
    let total = rt_count(events)
    if cursor == total:
        return actor
    let subject = actor.id
    let index_key = ["support-compact-index-v1", subject]
    let cached_index = rt_memo_get(support, index_key)
    var index = false
    if cached_index[0]:
        index = cached_index[1]
    var added = false
    while cursor < total:
        let event = events[cursor]
        if event.actor == subject:
            let type = event.type
            if type == "observation" or type == "listener_parse" or type == "inference" or type == "model_argument_accepted":
                if index != false:
                    index = dvs_support_compact_add(index, event, rt_count(support), subject)
                rt_push(support, event)
                added = true
        cursor = cursor + 1
    if added and index != false:
        rt_memo_put(support, index_key, index)
    return dv_with_many(actor, {"support_events": support, "support_events_cursor": total})

fn dvs_subject_support_events(events, subject):
    var result = []
    var j = 0
    let total = rt_count(events)
    while (j < total):
        let event = events[j]
        if (event.actor == subject):
            let type = event.type
            if dv_or((type == "observation"), dv_or((type == "listener_parse"), dv_or((type == "inference"), (type == "model_argument_accepted")))):
                rt_push(result, event)
        j = j + 1
    return result

// Index only candidate events; final claim/cell/basis matching remains below.
fn dvs_support_ref_key(subject, ref):
    let key = ["dvs_support_ref_key", subject]
    let cached = rt_memo_get(ref, key)
    if cached[0]:
        return cached[1]
    return rt_memo_put(ref, key, rt_json_stringify([ref.type, ref.object, ref.facet, ref.field, dv_find(ref, "subject", subject)]))

// Only fields consumed by parent matching enter this pure index. Original
// support events stay intact for proofs, replay and audit. Append work extends
// the same index instead of rescanning all earlier mind snapshots.
fn dvs_support_compact_add(index, event, position, subject):
    var refs = index.refs
    var accepted = index.accepted
    if event.type == "observation" or event.type == "listener_parse":
        let observations = event.data.observations
        var i = 0
        while i < rt_count(observations):
            let observation = observations[i]
            let key = dvs_support_ref_key(subject, observation.ref)
            var entries = dv_find(refs, key, [])
            rt_push(entries, {"position": position, "event": event.id, "kind": "observation", "observation": observation})
            refs = dv_with(refs, key, entries)
            i = i + 1
    if event.type == "inference":
        let changes = event.data.receipt.changes
        var i = 0
        while i < rt_count(changes):
            let change = changes[i]
            let key = dvs_support_ref_key(subject, change.ref)
            var entries = dv_find(refs, key, [])
            rt_push(entries, {"position": position, "event": event.id, "kind": "inference", "ref": change.ref, "after": change.after})
            refs = dv_with(refs, key, entries)
            i = i + 1
    if event.type == "model_argument_accepted":
        rt_push(accepted, {"position": position, "event": event.id})
    return {"refs": refs, "accepted": accepted}

fn dvs_support_compact_index(events, subject):
    let key = ["support-compact-index-v1", subject]
    let cached = rt_memo_get(events, key)
    if cached[0]:
        return cached[1]
    var index = {"refs": [], "accepted": []}
    var i = 0
    while i < rt_count(events):
        index = dvs_support_compact_add(index, events[i], i, subject)
        i = i + 1
    return rt_memo_put(events, key, index)

fn dvs_support_cell_parents(cell, ref, subject, entries, accepted):
    let key = ["support-cell-parents-v1", ref, subject, entries, accepted]
    let cached = rt_memo_get(cell, key)
    if cached[0]:
        return cached[1]
    let claims = dv_find(cell, "claims", [])
    let basis = dv_find(cell, "basis", [])
    var parents = []
    var i = 0
    var j = 0
    while i < rt_count(entries) or j < rt_count(accepted):
        var from_entry = j >= rt_count(accepted)
        if i < rt_count(entries) and j < rt_count(accepted):
            from_entry = entries[i].position < accepted[j].position
        var parent = ""
        if from_entry:
            let entry = entries[i]
            if entry.kind == "observation":
                if dv_same_local_ref(subject, entry.observation.ref, ref) and dv_has(claims, entry.observation):
                    parent = entry.event
            else:
                if dv_same(entry.ref, ref) and dv_same(entry.after, cell):
                    parent = entry.event
            i = i + 1
        else:
            if dv_has(basis, accepted[j].event):
                parent = accepted[j].event
            j = j + 1
        if parent != "" and not dv_has(parents, parent):
            rt_push(parents, parent)
    return rt_memo_put(cell, key, parents)

fn dvs_support_event_index(events, subject):
    let key = ["support-event-index", subject]
    let cached = rt_memo_get(events, key)
    if cached[0]:
        return cached[1]
    var index = []
    var accepted = []
    var i = 0
    while i < rt_count(events):
        let event = events[i]
        var refs = []
        if event.type == "observation" or event.type == "listener_parse":
            let observations = event.data.observations
            var j = 0
            while j < rt_count(observations):
                rt_push(refs, observations[j].ref)
                j = j + 1
        if event.type == "inference":
            let changes = event.data.receipt.changes
            var j = 0
            while j < rt_count(changes):
                rt_push(refs, changes[j].ref)
                j = j + 1
        if event.type == "model_argument_accepted":
            rt_push(accepted, i)
        var j = 0
        while j < rt_count(refs):
            let ref_key = dvs_support_ref_key(subject, refs[j])
            var positions = dv_find(index, ref_key, [])
            if not dv_has(positions, i):
                rt_push(positions, i)
                let slot = rt_record_index(index, ref_key)
                if slot < 0:
                    rt_push(index, dv_pair(ref_key, positions))
                else:
                    rt_replace(index, slot, dv_pair(ref_key, positions))
            j = j + 1
        i = i + 1
    return rt_memo_put(events, key, {"refs": index, "accepted": accepted})

fn dvs_support_parents(mind, refs, events, subject_or_actor):
    var subject = subject_or_actor
    var cand_events = []
    if dv_record_like(subject_or_actor):
        subject = subject_or_actor.id
        cand_events = dv_find(subject_or_actor, "support_events", [])
        if rt_count(cand_events) == 0:
            cand_events = dvs_subject_support_events(events, subject)
    else:
        cand_events = dvs_subject_support_events(events, subject)
    let support_index = dvs_support_compact_index(cand_events, subject)
    var parents = []
    var i = 0
    while (i < rt_count(refs)):
        var ref = refs[i]
        var cell = dv_read(mind, ref)
        let entries = dv_find(support_index.refs, dvs_support_ref_key(subject, ref), [])
        let supported = dvs_support_cell_parents(cell, ref, subject, entries, support_index.accepted)
        var j = 0
        while j < rt_count(supported):
            if not dv_has(parents, supported[j]):
                rt_push(parents, supported[j])
            j = (j + 1)
        i = (i + 1)
    return parents

fn dvs_selection_parents(actor, action, choice, events, parent):
    var refs = choice.relevant_refs
    var parents = dvs_cognitive_parents(actor, dv_single(parent))
    refs = dvp_merge_refs(refs, dvs_sim_refs(action.precondition))
    refs = dvp_merge_refs(refs, dvp_owner_requirement_refs(action))
    if dv_has_key(action, "answer"):
        refs = dvp_merge_refs(refs, dvs_sim_refs(action.answer))
    if dv_has_key(actor, "question_ref"):
        refs = dvp_add_ref(refs, actor.question_ref)
    parents = dv_explanation_merge(parents, dvs_support_parents(actor.mind, refs, events, actor))
    if (dv_find(actor, "hypothesis_event", "") == ""):
        false
    else:
        parents = dv_explanation_merge(parents, dv_single(actor.hypothesis_event))
    if dv_has_key(action, "argument"):
        parents = dv_explanation_merge(parents, dv_single(action.argument.id))
    return parents

fn dvs_model_parent_ids(actor, parent, prior):
    var result = dvs_cognitive_parents(actor, dv_single(parent))
    if (dv_find(actor, "model_paid_event", "") == ""):
        false
    else:
        result = dv_explanation_merge(result, dv_single(actor.model_paid_event))
    if (dv_find(actor, "model_previous_event", "") == ""):
        false
    else:
        result = dv_explanation_merge(result, dv_single(actor.model_previous_event))
    if (prior == ""):
        false
    else:
        result = dv_explanation_merge(result, dv_single(prior))
    return result

fn dvs_public_grant_parents(events, parent, subject):
    var result = dv_single(parent)
    var literal = ""
    var i = rt_count(events) - 1
    while (i >= 0 and literal == ""):
        var event = events[i]
        if (event.type == "speech_literal"):
            if dv_has(event.parents, parent):
                literal = event.id
        i = i - 1
    if (literal == ""):
        false
    else:
        result = dv_explanation_merge(result, dv_single(literal))
        i = rt_count(events) - 1
        var found_parse = false
        while (i >= 0 and not found_parse):
            var event = events[i]
            if dv_and((event.type == "listener_parse"), (event.actor == subject)):
                if (dv_find(event.data, "source_event", "") == literal):
                    result = dv_explanation_merge(result, dv_single(event.id))
                    found_parse = true
            i = i - 1
    return result

fn dvs_physical_proposition(proposition, bindings, subject):
    var op = proposition.op
    if (op == "constant"):
        return proposition
    else:
        if (op == "not"):
            return dv_not(dvs_physical_proposition(proposition.item, bindings, subject))
        else:
            if (op == "all"):
                var items = proposition.items
                var i = 0
                var mapped = []
                while (i < rt_count(items)):
                    rt_push(mapped, dvs_physical_proposition(items[i], bindings, subject))
                    i = (i + 1)
                return dv_all(mapped)
            else:
                var ref = proposition.ref
                var i = 0
                var physical = ""
                while (i < rt_count(bindings)):
                    var binding = bindings[i]
                    if dv_and((binding.subject == subject), (binding.local == ref.object)):
                        physical = binding.physical
                    i = (i + 1)
                if (physical == ""):
                    return {"op": "constant", "value": "unknown"}
                else:
                    return dv_with(proposition, "ref", dv_ref(physical, ref.facet, ref.field))

fn dvs_refresh_derivations(actor, events, time, parent):
    var derivations = dv_find(actor, "inference_derivations", [])
    var world = actor.mind
    var i = (rt_count(dv_find(actor, "inference_derivations", [])) - 1)
    var contaminated = []
    var restored = []
    var parents = dvs_cognitive_parents(actor, dv_single(parent))
    var remaining = dv_find(actor.policy, "reason_budget", 0)
    var checked = 0
    var blocked = false
    var updated = false
    while dv_and((not (i < 0)), (not blocked)):
        var derivation = derivations[i]
        var inputs = derivations[i].inputs
        var stale = false
        var j = 0
        if dv_find(derivation, "valid", true):
            if dv_same(derivation.adoption, dv_find(world.adoptions, derivation.adoption.law.name, false)):
                false
            else:
                stale = true
            while (j < rt_count(inputs)):
                var input = inputs[j]
                if dv_or(dv_has(contaminated, input.ref), (not dv_same(dvs_reason_cell(input.cell), dvs_reason_cell(dv_read(world, input.ref))))):
                    stale = true
                j = (j + 1)
            if stale:
                if (remaining < 1):
                    blocked = true
                else:
                    var changes = derivation.changes
                    var k = 0
                    remaining = (remaining - 1)
                    checked = (checked + 1)
                    parents = dv_explanation_merge(parents, dvs_support_parents(actor.mind, dvs_sim_refs(derivation.adoption.law.premise), events, actor))
                    while (k < rt_count(changes)):
                        var change = changes[k]
                        if dv_same(dv_read(world, change.ref), change.after):
                            world = dv_store(world, change.ref, change.before)
                            contaminated = dvp_add_ref(contaminated, change.ref)
                            rt_push(restored, change)
                        k = (k + 1)
                    parents = dv_explanation_merge(parents, dv_single(derivation.event))
                    derivations = dvs_replace(derivations, i, dv_with(derivation, "valid", false))
        i = (i - 1)
    if (0 < rt_count(restored)):
        world = dv_with(world, "revision", (world.revision + 1))
    updated = dv_with_many(actor, {"mind": world, "inference_derivations": derivations, "cognition_blocked": blocked, "policy": dv_with(actor.policy, "reason_budget", remaining)})
    if dv_or(blocked, (0 < checked)):
        updated = dv_with(updated, "last_cognitive_event", rt_cat("e", rt_show(rt_count(events))))
    if dv_or(blocked, (0 < checked)):
        parent = dvs_event_prepared(events, "inference_dependencies_invalidated", actor.id, time, parents, dv_with_many({"mind_revision_before": actor.mind.revision, "mind_revision_after": world.revision, "restored": restored, "checked": checked}, {"budget_blocked": blocked, "remaining": remaining, "actor_id": actor.id, "actor_before": dv_without(actor, "simulations"), "actor_after": dv_without(updated, "simulations"), "mind_before": actor.mind, "mind_after": world}))
    if dv_and((not blocked), (0 < checked)):
        return dvs_refresh_derivations(updated, events, time, parent)
    else:
        return updated

fn dvs_model_observed_inputs(model):
    var comparisons = dv_find(model, "comparisons", [])
    var result = []
    var i = 0
    while (i < rt_count(comparisons)):
        result = dv_explanation_merge(result, dv_find(comparisons[i], "observed_cells", []))
        i = (i + 1)
    return result

fn dvs_model_paid_result(events, id, subject, status):
    let event = dvs_find_event_by_id(events, id)
    if event != false and event.actor == subject and event.type == "model_probe_reuse":
        let source = dv_find(event.data, "source_event", "")
        let original = dvs_find_event_by_id(events, source)
        if original == false or original.actor != subject or original.type != "mind_simulation" or not dv_has(event.parents, source):
            return false
        var reused = event.data.result
        var computed = original.data.result
        let accounting = ["expanded", "total_expanded", "remaining", "work_remaining", "reused_work", "reused_from_event"]
        var i = 0
        while i < rt_count(accounting):
            reused = dv_without(reused, accounting[i])
            computed = dv_without(computed, accounting[i])
            i = i + 1
        if not dv_same(reused, computed):
            return false
        return dvs_model_paid_result(events, source, subject, status)
    if (event != false and event.actor == subject and dv_or((event.type == "mind_simulation"), (event.type == "model_recheck"))):
        let parents = event.parents
        let result = event.data.result
        var j = 0
        while (j < rt_count(parents)):
            let paid = dvs_find_event_by_id(events, parents[j])
            if (paid != false and paid.actor == subject and paid.type == "action_execution"):
                let data = paid.data
                if dv_and((dv_find(dv_find(data, "action", []), "kind", "") == "replay"), dv_and((data.receipt.execution.status == "applied"), dv_and((dv_find(result, "status", "") == status), dv_find(result, "plan_complete", false)))):
                    return true
            j = j + 1
    return false

fn dvs_public_model_paid(events, id, subject):
    return dvs_model_paid_result(events, id, subject, "explained")

fn dvs_public_argument_valid(action, rule, events, subject):
    var argument = dv_find(action, "argument", false)
    if (argument == false):
        return false
    if (not dv_has_key(argument, "id")):
        return false
    let event = dvs_find_event_by_id(events, argument.id)
    if (event == false or event.actor != subject or event.type != "model_argument_accepted"):
        return false
    var original = event.data.result.argument
    var public = dv_without(dv_without(dv_without(argument, "question_id"), "hypothesis_id"), "adoptions")
    if (not dv_same(original, public)):
        return false
    if dv_find(argument, "question_id", "") == "" or dv_find(action, "argument_question", argument.question_id) != argument.question_id:
        return false
    if (not dvs_public_model_paid(events, argument.model_event, subject)):
        return false
    var required = dv_find(rule, "required_argument_slots", dv_find(action, "argument_slots", []))
    var claims = argument.claims
    var j = 0
    var propositions = []
    if (not dv_and((0 < rt_count(required)), dv_and(argument.estimated, dv_and((0 < argument.confidence), dv_and((argument.confidence < 1), dv_and((not (argument.model_event == "")), (0 < rt_count(argument.source_event_ids)))))))):
        return false
    while (j < rt_count(required)):
        var slot = required[j]
        var k = 0
        var found = false
        while (k < rt_count(claims)):
            var claim = claims[k]
            if (claim.slot_id == slot):
                found = true
                rt_push(propositions, dv_fact(claim.ref, claim.value))
            k = (k + 1)
        if (not found):
            return false
        j = (j + 1)
    return dv_same(dv_all(propositions), action.answer)

fn dvs_factor_candidate_rejected(actor, candidate):
    var rejections = dv_find(actor, "factor_rejections", {"source_revision": -1, "ids": []})
    return dv_and((rejections.source_revision == actor.mind.revision), dv_has(rejections.ids, candidate.id))

fn dvs_public_literal_source(events, parent, subject):
    var literal = ""
    var i = rt_count(events) - 1
    while (i >= 0 and literal == ""):
        var event = events[i]
        if (event.type == "speech_literal"):
            if dv_has(event.parents, parent):
                literal = event.id
        i = i - 1
    if (literal == ""):
        return ""
    var result = ""
    i = rt_count(events) - 1
    while (i >= 0 and result == ""):
        var event = events[i]
        if dv_and((event.type == "listener_parse"), (event.actor == subject)):
            if dv_and((dv_find(event.data, "source_event", "") == literal), dv_has(event.parents, literal)):
                result = literal
        i = i - 1
    return result


// Autonomous formal model session. Host geometry and input are outside this model.

fn dvs_authority_speech_allowed(action, physical, subject):
    var contracts = dv_find(physical, "speech_contracts", [])
    var i = 0
    var registered = false
    var allowed = true
    while (i < rt_count(contracts)):
        var contract = contracts[i]
        if (contract.subject == subject):
            registered = true
            var adoption = dv_find(physical.adoptions, contract.law_id, false)
            if (adoption == false):
                allowed = false
            else:
                if dv_and(adoption.active, dv_and((adoption.mode == "enforce"), dv_and((adoption.law.version == contract.version), dv_and(contract.require_literal_truth, (0 < rt_count(contract.basis)))))):
                    false
                else:
                    allowed = false
            if dv_has_key(action, "authority_truth_gate"):
                var gate = action.authority_truth_gate
                if dv_and(dv_find(gate, "required", false), (dv_find(gate, "contract_id", "") == contract.id)):
                    false
                else:
                    allowed = false
            if dv_has_key(action, "speech"):
                if (dv_truth(physical, action.speech.literal_ast) == "true"):
                    false
                else:
                    allowed = false
            else:
                allowed = false
        i = (i + 1)
    if dv_and((not registered), dv_has_key(action, "authority_truth_gate")):
        if dv_find(action.authority_truth_gate, "required", false):
            allowed = false
    return allowed

fn dvs_acceptance_law_ready(physical, name):
    if dv_has_key(physical.adoptions, name):
        var adoption = dv_get(physical.adoptions, name)
        var law = dv_get(physical.adoptions, name).law
        if dv_and(adoption.active, dv_and((adoption.mode == "enforce"), (dv_truth(physical, law.premise) == "true"))):
            return (dv_stage(physical, law.effects, dv_find(physical, "time", 0), adoption.basis, adoption.confidence).status == "ready")
        else:
            return false
    else:
        return false

fn dvs_answer(rules, action, physical, mind, bindings, events):
    var i = 0
    var found = false
    var literal = "unknown"
    var support = "unknown"
    var topic = "unknown"
    var complete = "unknown"
    var transition = ""
    var grants = []
    var recipients = []
    var require_arg = false
    var target_stage = ""
    var progress_ref = false
    var completion_ref = false
    while (i < rt_count(rules)):
        var rule = rules[i]
        if (rule.id == dv_find(action, "answer_id", "")):
            found = true
            var local_1 = false
            if dv_find(rule, "condition_from_answer", false):
                local_1 = dvs_physical_proposition(action.answer, bindings, mind.subject)
            else:
                local_1 = rule.condition
            literal = dv_truth(physical, local_1)
            support = dv_truth(mind, rule.required_support)
            transition = dv_find(rule, "accepted_law", "")
            topic = dv_truth(physical, dv_find(rule, "question_match", {"op": "constant", "value": "unknown"}))
            complete = dv_truth(mind, dv_find(rule, "answer_complete", {"op": "constant", "value": "unknown"}))
            require_arg = dv_find(rule, "require_argument", false)
            target_stage = dv_find(rule, "stage", dv_find(action, "topic", "auxiliary"))
            progress_ref = dv_find(rule, "progress_ref", false)
            completion_ref = dv_find(rule, "completion_ref", false)
            if require_arg:
                if dvs_public_argument_valid(action, rule, events, mind.subject):
                    false
                else:
                    complete = "unknown"
            grants = dv_find(rule, "accepted_public_grants", [])
            recipients = dv_find(rule, "accepted_listeners", [])
        i = (i + 1)
    var law_ready = dvs_acceptance_law_ready(physical, transition)
    var accepted = false
    var reason = "accepted"
    var truth_level = 0
    var local_3 = false
    if (not found):
        local_3 = "undeclared-answer"
    else:
        if (not (topic == "true")):
            local_3 = "unasked-topic"
        else:
            if (not (literal == "true")):
                local_3 = "literal-not-established"
            else:
                if (not (support == "true")):
                    local_3 = "insufficient-source"
                else:
                    if (not (complete == "true")):
                        local_3 = "incomplete-answer"
                    else:
                        if (not law_ready):
                            local_3 = "protocol-transition-not-ready"
                        else:
                            local_3 = "accepted"
    reason = local_3
    accepted = (reason == "accepted")
    var local_4 = false
    if accepted:
        if dv_has_key(action, "argument"):
            local_4 = 2
        else:
            if require_arg:
                local_4 = 2
            else:
                local_4 = 1
    else:
        local_4 = 0
    truth_level = local_4
    var judgment = dv_with_many({"accepted": accepted, "literal_truth": literal, "epistemic_support": support, "accepted_law": transition}, {"accepted_public_grants": grants, "accepted_listeners": recipients, "question_match": topic, "answer_complete": complete, "law_ready": law_ready, "reason": reason, "truth_level": truth_level, "stage": target_stage})
    return dv_with_many(judgment, {"progress_ref": progress_ref, "completion_ref": completion_ref})

fn dvs_session_open(story, capability):
    dv_require((story.format == "dv-session-v1"), "Unsupported story data dialect")
    var physical = dvs_simulation_open(story, dv_clone(story.physical))
    var actors = dv_clone(story.actors)
    var events = []
    var bindings = story.bindings
    var costs = story.cost_model
    var run_start = dv_find(story.physical, "time", 0)
    var duration_budget = dv_find(story, "game_duration_budget", 0)
    var horizon = 0
    var duration_blocked = false
    var limit = story.max_actions
    var cursor = 0
    var executed = 0
    var idle = 0
    var status = "action-window-exhausted"
    var initial = []
    horizon = (run_start + duration_budget)
    dv_require((not (duration_budget < 0)), "Negative game duration budget")
    initial = {"physical": physical, "actors": actors}
    var i = 0
    while (i < rt_count(actors)):
        var actor = dvs_initialize_cognition(actors[i], dv_find(story, "opening_seed", 0), i)
        if dv_and((capability == "disabled"), (actor.id == dv_find(story, "capability_actor", ""))):
            actor = dv_with(actor, "policy", dv_with(actor.policy, "model_budget", 0))
        actors = dvs_replace(actors, i, dv_with(actor, "ledger", dv_action_cost_ledger(actor.id, actor.balance)))
        i = (i + 1)
    initial = {"physical": physical, "actors": actors}
    dvs_event_prepared(events, "session_start", "", dv_find(physical, "time", 0), [], dv_with({"initial": initial, "capability": capability, "source_refs": dv_find(story, "source_refs", [])}, "time_origin", {"run_start": run_start, "duration_budget": duration_budget, "horizon": horizon, "unit": "minute"}))
    return {"story": story, "physical": physical, "actors": actors, "events": events, "bindings": bindings, "costs": costs, "run_start": run_start, "duration_budget": duration_budget, "horizon": horizon, "duration_blocked": duration_blocked, "limit": limit, "cursor": cursor, "executed": executed, "idle": idle, "status": status, "initial": initial}

fn dvs_session_active(state):
    let time = dv_find(state.physical, "time", 0)
    if state.horizon < time or not (state.executed < state.limit):
        return false
    if time == state.horizon:
        // Finish work already chosen within the duration, but do not open
        // another decision after the observation window has ended.
        if dv_find(state, "pending", false) != false:
            return true
        var i = 0
        while i < rt_count(state.actors):
            let queued = dv_find(state.actors[i], "scheduled_action", false)
            if queued != false:
                if queued.due <= time:
                    return true
            i = i + 1
        return false
    // The declared simulation clock remains live while current actors yield.
    // The scheduler advances its next boundary up to the finite horizon.
    if dv_has_key(state.physical, "simulation"):
        return true
    return state.idle < rt_count(state.actors) or 0 < dvs_scheduled_count(state.actors)

// Each owner keeps one chosen action while its declared duration elapses.
fn dvs_scheduled_count(actors):
    var count = 0
    var i = 0
    while i < rt_count(actors):
        if dv_find(actors[i], "scheduled_action", false) != false:
            count = count + 1
        i = i + 1
    return count

// Only content-declared waiting activities may stop before their chosen duration.
// An answer, movement or other ordinary action never enters this path.
fn dvs_interruptible_wait(action):
    if not dv_find(action, "interruptible", false) or dv_find(action, "activity", "") != "wait":
        return false
    let kind = action.kind
    return kind == "wait" or (5 <= rt_length(kind) and rt_slice(kind, 0, 5) == "wait.")

fn dvs_validate_interruptible_wait(action, model):
    dv_require(dvs_interruptible_wait(action), "Interruptible action must be an explicit wait activity")
    dv_require(not dv_has_key(action, "answer") and not dv_has_key(action, "speech") and not dv_has_key(action, "travel"), "Interruptible wait cannot contain another action")
    dv_require(model.minimum.time == 0 and 0 < model.actual.time, "Interruptible wait requires a zero time lower bound and positive duration")
    return true

// These events already passed actual hearing or observation admission. Remote
// actions and private physical changes are not wake signals for this subject.
fn dvs_wait_input_events(actor, events, cursor):
    events = rt_snapshot(events)
    var sources = []
    var i = cursor
    while i < rt_count(events):
        let event = events[i]
        if event.actor == actor.id and dv_has(["speech_received_pending", "listener_parse", "observation", "co_presence", "room_perception"], event.type):
            rt_push(sources, event.id)
        i = i + 1
    return sources

fn dvs_interrupt_waits(state):
    state = rt_snapshot(state)
    var actors = state.actors
    var events = false
    var changed = false
    let time = state.physical.time
    var i = 0
    while i < rt_count(actors):
        var actor = actors[i]
        let original = dv_find(actor, "scheduled_action", false)
        if original != false:
            if time < original.due and dvs_interruptible_wait(original.action) and dv_has_key(original, "wait_watch"):
                var queued = original
                let watch = queued.wait_watch
                var source_events = state.events
                if events != false:
                    source_events = events
                var sources = dvs_wait_input_events(actor, source_events, watch.event_cursor)
                let heard = dv_find(actor, "pending_heard", [])
                var h = 0
                while h < rt_count(heard):
                    if not dv_has(sources, heard[h].source):
                        rt_push(sources, heard[h].source)
                    h = h + 1
                let contact = dvs_idle_contact_input(actor, state.physical, actors)
                let visible_change = not dv_same(contact, watch.contact)
                if visible_change:
                    if events == false:
                        events = dv_clone(state.events)
                    let start = rt_count(events)
                    actor = dvs_notice_peers(actor, state.physical, actors, state.bindings, events, time, queued.parent)
                    actor = dvs_notice_visible_objects(actor, state.physical, state.bindings, events, time, queued.parent)
                    sources = dv_explanation_merge(sources, dvs_wait_input_events(actor, events, start))
                if visible_change or 0 < rt_count(sources):
                    if events == false:
                        events = dv_clone(state.events)
                    let elapsed = time - queued.start
                    dv_require(0 <= elapsed and elapsed < queued.model.actual.time, "Invalid interrupted wait duration")
                    let interruption = {"reason": "activity-interrupted", "failure_class": "activity-interrupted", "action_id": queued.action.id, "start": queued.start, "planned_due": queued.due, "time": time, "elapsed": elapsed, "source_events": sources, "visible_change": visible_change}
                    let interrupted = dvs_event(events, "wait_interrupted", actor.id, time, dv_explanation_merge([queued.parent], sources), interruption)
                    // The declared variable-duration quote still charges every
                    // non-time component. The complete wait law must not run.
                    let model = dv_with(queued.model, "actual", dv_with(queued.model.actual, "time", elapsed))
                    queued = dv_with_many(queued, {"model": model, "due": time, "parent": interrupted, "activity_interruption": dv_with(interruption, "event", interrupted)})
                else:
                    // Consume only an unrelated event suffix; no idle decision
                    // or fictional observation is emitted while waiting.
                    if watch.event_cursor != rt_count(source_events):
                        queued = dv_with(queued, "wait_watch", dv_with(watch, "event_cursor", rt_count(source_events)))
                if not dv_same(queued, original):
                    actors = dvs_replace(actors, i, dv_with(actor, "scheduled_action", queued))
                    changed = true
        i = i + 1
    if not changed:
        return state
    var updates = {"actors": actors}
    if events != false:
        updates = dv_with(updates, "events", events)
    return dvs_owned_state_update(state, updates)

fn dvs_interrupted_wait_due(actors, time):
    var i = 0
    while i < rt_count(actors):
        let queued = dv_find(actors[i], "scheduled_action", false)
        if queued != false:
            if queued.due <= time and dv_find(queued, "activity_interruption", false) != false:
                return i
        i = i + 1
    return -1

fn dvs_dispatch_due(state, index):
    state = rt_snapshot(state)
    let updated_actor = dvs_erosion_update(state.actors[index], state.physical, state.physical.time)
    if not dvs_actor_can_act(updated_actor):
        let cancelled = dv_with(updated_actor, "scheduled_action", false)
        return dvs_owned_state_update(state, {"actors": dvs_replace(state.actors, index, cancelled), "cursor": index, "idle": 0})
    let queued = updated_actor.scheduled_action
    let time = state.physical.time
    // This dispatch owns the only mutable event root; prior event subtrees stay
    // immutable. A frozen host state is otherwise consumed as a read-only value.
    var events = dv_clone(state.events)
    let actor = dvs_drain_received_speech(dv_with(updated_actor, "scheduled_action", false), events, time)
    var action = queued.action
    if not dvs_argument_action_evidence(actor, action, events):
        dvs_event(events, "action_cancelled", actor.id, time, [queued.parent], {"action_id": action.id, "reason": "argument-no-longer-current", "scheduled_start": queued.start, "due": queued.due, "charged": false})
        return dvs_owned_state_update(state, {"actors": dvs_replace(state.actors, index, actor), "events": events, "cursor": index, "idle": 0})
    var preparation_parent = queued.parent
    if dvs_action_requires_argument(action):
        action = dv_with_many(action, {"argument_evidence_revision": actor.mind.revision, "argument_evidence_time": time, "argument_evidence_mind_time": actor.mind.time})
        preparation_parent = dvs_event(events, "argument_evidence_prepared", actor.id, time, dvs_cognitive_parents(actor, [queued.parent, actor.argument.id]), {"action_id": action.id, "argument_id": actor.argument.id, "argument_evidence_revision": actor.mind.revision, "argument_evidence_time": time, "argument_evidence_mind_time": actor.mind.time, "physical_revision": state.physical.revision, "source_event_ids": actor.argument.source_event_ids, "contract": "prepared-evidence-before-own-completion-observations"})
    let bounds = dv_action_cost_bounds(queued.model.minimum, queued.model.maximum)
    let event = rt_cat("action", rt_show(state.executed))
    var quote = dv_with(dv_action_cost_quote(actor.ledger, state.physical, dv_find(action, "law", action.id), event, bounds), "scheduled_start", queued.start)
    let interruption = dv_find(queued, "activity_interruption", false)
    if interruption != false:
        quote = dv_with(quote, "activity_interruption", interruption)
    let parent = dvs_event(events, "cost_quote", actor.id, time, [preparation_parent], quote)
    var pending = {"index": index, "actor": actor, "parent": parent, "time": time, "action": action, "id": actor.id, "mind": actor.mind, "model": queued.model, "action_event": event, "ledger": actor.ledger, "quote": quote, "choice": queued.choice, "activity_interruption": interruption}
    if dvs_action_requires_argument(action):
        pending = dv_with(pending, "argument_evidence_world", state.physical)
    return dvs_owned_state_update(state, {"actors": dvs_replace(state.actors, index, actor), "events": events, "pending": pending, "idle": 0})

// Scan eligibility without running cognition. Ties preserve cyclic actor order.
// Pure declaration analysis only. `now` must describe this clock's own domain;
// it does not synchronize a mind clock or establish cognition's full dependency set.
// Non-clock reads are stable only while the caller separately retains their inputs.
fn dvs_known_clock_boundary(condition, clock, now, limit):
    return dv_time_boundary(condition, clock, now, limit, "invalidate")

// Complete owned state except administrative scan/dispatch cursors. Their
// append-only event inputs are checked separately; no mind or budget is removed.
fn dvs_idle_subject_input(actor, costs):
    actor = rt_snapshot(actor)
    costs = rt_snapshot(costs)
    var policy = actor.policy
    var maximum = 0
    var i = 0
    while i < rt_count(costs):
        maximum = dv_max(maximum, costs[i][1].maximum.time)
        i = i + 1
    let bound = maximum
    if dv_has_key(policy, "remaining_game_time") and bound <= policy.remaining_game_time:
        policy = dv_with(policy, "remaining_game_time", bound)
    var result = []
    i = 0
    while i < rt_count(actor):
        let entry = actor[i]
        let key = entry[0]
        if not dv_has(["idle_guard", "decision_time", "decision_revision", "support_events_cursor", "heard_utterances_cursor", "cognition_reused", "cognition_stop", "reason_reused", "last_reason_report"], key):
            if key == "policy":
                rt_push(result, dv_pair(key, policy))
            else:
                rt_push(result, entry)
        i = i + 1
    return result

fn dvs_idle_story_input(story):
    story = rt_snapshot(story)
    var result = []
    var i = 0
    while i < rt_count(story):
        if not dv_has(["background_scan_cursor", "background_waiting_cursor"], story[i][0]):
            rt_push(result, story[i])
        i = i + 1
    return result

// The environment clock advances independently. Preserve every other physical
// field, including unknown extension fields; only clock bookkeeping is projected.
fn dvs_idle_contact_input(actor, physical, actors):
    if not dv_find(actor.policy, "notice_co_presence", false) and not dv_find(actor.policy, "notice_visible_objects", false):
        return false
    var context = []
    if dv_find(actor.policy, "notice_co_presence", false):
        context = dvs_visible_context(actor, physical, actors)
    return {"context": context, "objects": dvs_visible_objects(actor, physical), "position": dv_read(physical, actor.location_ref), "visible": dv_truth(physical, dv_find(actor.policy, "visual_identity_when", dv_true()))}

// Pending input or a blocked pass keeps the actor awake.
// Approximate waiting records only an examined current state, never a full
// cognition fixed point. Actual new input and the declared clock wake it.
fn dvs_idle_can_wait(actor):
    return rt_count(dv_find(actor, "pending_heard", [])) == 0 and not dv_find(actor, "cognition_blocked", false)

fn dvs_idle_events_stable(events, actor, guard):
    return guard.event_cursor <= rt_count(events) and dvs_owned_events_stable(events, actor, guard.event_cursor)

fn dvs_idle_guard_matches(actor, state):
    let guard = dv_find(actor, "idle_guard", false)
    if guard == false or not (state.physical.time < guard.until) or state.physical.time < guard.time:
        return false
    if not dvs_idle_can_wait(actor) or not dvs_idle_events_stable(state.events, actor, guard):
        return false
    if not dv_same(dvs_idle_subject_input(actor, state.costs), guard.subject):
        return false
    if not dv_same(state.bindings, guard.bindings) or not dv_same(state.costs, guard.costs) or not dv_same(dvs_idle_story_input(state.story), guard.story):
        return false
    return dv_same(dvs_idle_contact_input(actor, state.physical, state.actors), guard.contact)

fn dvs_idle_inputs_changed(actor, state):
    let guard = dv_find(actor, "idle_guard", false)
    if guard == false:
        return false
    if not dv_same(dvs_idle_subject_input(actor, state.costs), guard.subject) or not dvs_idle_events_stable(state.events, actor, guard):
        return true
    if not dv_same(state.bindings, guard.bindings) or not dv_same(state.costs, guard.costs) or not dv_same(dvs_idle_story_input(state.story), guard.story):
        return true
    return not dv_same(dvs_idle_contact_input(actor, state.physical, state.actors), guard.contact)

// Collect every declared condition, including cognitive, normative and model
// prerequisites. This is a time invalidation index, never a truth assignment.
fn dvs_declared_conditions(value):
    if not rt_is_list(value):
        return []
    if dv_record_like(value):
        if dv_has_key(value, "op"):
            if not dv_has(["assign", "increment"], value.op):
                return [value]
    var conditions = []
    var i = 0
    while i < rt_count(value):
        let nested = dvs_declared_conditions(value[i])
        var j = 0
        while j < rt_count(nested):
            rt_push(conditions, nested[j])
            j = j + 1
        i = i + 1
    return conditions

// Internal read-only declaration index. The caller supplies a fully frozen
// declaration graph; recursive children therefore keep immutable identities.
// Cache keys include each complete subtree, never selected policy fields.
fn dvs_declared_conditions_cached(value):
    if not rt_is_list(value):
        return []
    let key = ["dvs-declared-conditions-subtree-v1"]
    let cached = dvs_declaration_cache_get(value, key)
    if cached[0]:
        return cached[1]
    var conditions = []
    if dv_record_like(value):
        if dv_has_key(value, "op"):
            if not dv_has(["assign", "increment"], value.op):
                return dvs_declaration_cache_put(value, key, [value])
    var i = 0
    while i < rt_count(value):
        let nested = dvs_declared_conditions_cached(value[i])
        var j = 0
        while j < rt_count(nested):
            rt_push(conditions, nested[j])
            j = j + 1
        i = i + 1
    return dvs_declaration_cache_put(value, key, conditions)

fn dvs_idle_window_boundary(actor, story, now, limit):
    let clock = dv_find(story, "clock_ref", false)
    let key = ["dvs_idle_declared_conditions", actor.policy, actor.mind.adoptions]
    let cached = dvs_declaration_cache_get(actor.actions, key)
    var conditions = []
    if cached[0]:
        conditions = cached[1]
    else:
        if dv_find(actor.policy, "opt_declcache", false):
            // The existing outer memo already depends on this entire graph.
            // Freeze the same declarations for subtree identity reuse; no
            // condition is evaluated by this read-only declaration index.
            let declarations = rt_snapshot([actor.actions, actor.policy, actor.mind.adoptions])
            conditions = dvs_declared_conditions_cached(declarations)
        else:
            conditions = dvs_declared_conditions([actor.actions, actor.policy, actor.mind.adoptions])
        dvs_declaration_cache_put(actor.actions, key, conditions)
    var boundary = dvs_known_clock_boundary(dv_all(conditions), clock, now, limit)
    let duties = dvs_obligation_actions(actor.actions)
    var duty_index = 0
    while duty_index < rt_count(duties):
        let due = dv_find(duties[duty_index], "obligation_due", 0)
        if now < due and due < boundary.next and not dv_has(dv_find(actor, "completed_actions", []), duties[duty_index].id):
            boundary = dv_with(boundary, "next", due)
        duty_index = duty_index + 1
    // Listener models compare current time with recorded observation ages.
    // An unsupported time dependency keeps the ordinary minute recheck.
    if dvs_has_active_communication_goal(actor):
        return {"complete": false, "next": dv_min(boundary.next, dv_min(limit, now + 1))}
    return boundary

fn dvs_schedule(state):
    state = dvs_simulation_sync(state)
    state = rt_snapshot(state)
    var updated = state.actors
    var erosion_index = 0
    var any_eroded = false
    while erosion_index < rt_count(updated):
        let original = updated[erosion_index]
        let eroded = dvs_erosion_update(original, state.physical, state.physical.time)
        if not dv_same(eroded, original):
            updated = dvs_replace(updated, erosion_index, eroded)
            any_eroded = true
        erosion_index = erosion_index + 1
    if any_eroded:
        state = rt_snapshot(dvs_owned_state_update(state, {"actors": updated}))
    state = rt_snapshot(dvs_interrupt_waits(state))
    updated = state.actors
    var current = state
    var due_index = -1
    var due_time = state.horizon + 1
    var wake_index = -1
    var wake_time = state.horizon + 1
    var event_wake_index = -1
    var event_wake_time = state.horizon + 1
    if dv_has_key(state.physical, "simulation"):
        event_wake_time = dv_min(state.physical.simulation.last_macro + 15, state.horizon)
        event_wake_index = state.cursor
        wake_time = event_wake_time
        wake_index = state.cursor
    var ready_index = -1
    var obligation_index = -1
    var obligation_time = state.horizon + 1
    var offset = 0
    var index = state.cursor
    while offset < rt_count(state.actors):
        let actor = state.actors[index]
        let queued = dv_find(actor, "scheduled_action", false)
        if not dvs_actor_can_act(actor):
            if queued != false:
                updated = dvs_replace(updated, index, dv_with(actor, "scheduled_action", false))
                state = rt_snapshot(dvs_owned_state_update(state, {"actors": updated}))
        else:
            if queued != false:
                if queued.due < due_time:
                    due_time = queued.due
                    due_index = index
            else:
                if state.physical.time < state.horizon and 0 < dv_find(actor.policy, "budget", 0) and dvs_simulation_actor_ready(actor, state):
                    let duty = dvs_due_obligation(actor, state.physical.time, state.costs)
                    if duty != false:
                        let due = dv_find(duty, "obligation_due", 0)
                        if due < obligation_time:
                            obligation_index = index
                            obligation_time = due
                // No-action is not a permanent property of a mind revision:
                // time, local arrivals and content goals can create a new opportunity.
                if state.physical.time < state.horizon and ready_index < 0 and 0 < dv_find(actor.policy, "budget", 0) and dvs_simulation_actor_ready(actor, state) and (dv_find(actor, "decision_time", -1) != state.physical.time or dv_find(actor, "decision_revision", -1) != actor.mind.revision or 0 < rt_count(dv_find(actor, "pending_heard", [])) or dvs_idle_inputs_changed(actor, state)):
                    if dvs_idle_guard_matches(actor, state):
                        let guard = actor.idle_guard
                        // No decision or world change occurs while an activity is unchanged.
                        // Keep its original stop proof and consume only the examined suffix.
                        let advanced = dv_with_many(guard, {"event_cursor": rt_count(state.events), "event_anchor": state.events[rt_count(state.events) - 1]})
                        let sleeping = dv_with_many(actor, {"decision_time": state.physical.time, "decision_revision": actor.mind.revision, "idle_guard": advanced})
                        updated = dvs_replace(updated, index, sleeping)
                        state = rt_snapshot(dvs_owned_state_update(state, {"actors": updated, "idle": state.idle + 1}))
                    else:
                        ready_index = index
                let wake_guard = dv_find(actor, "idle_guard", false)
                if wake_guard != false:
                    if state.physical.time < wake_guard.until and wake_guard.until < wake_time:
                        wake_index = index
                        wake_time = wake_guard.until
                    if dv_find(wake_guard, "declared_time_boundary", false) and state.physical.time < wake_guard.until and wake_guard.until < event_wake_time:
                        event_wake_index = index
                        event_wake_time = wake_guard.until
        index = index + 1
        if index == rt_count(state.actors):
            index = 0
        offset = offset + 1
    if due_index >= 0 and due_time <= state.physical.time:
        return dvs_dispatch_due(state, due_index)
    if obligation_index >= 0:
        return dvs_owned_state_update(state, {"cursor": obligation_index})
    if ready_index >= 0:
        return dvs_owned_state_update(state, {"cursor": ready_index})
    if due_index < 0 and event_wake_index >= 0 and state.physical.time < event_wake_time and event_wake_time <= state.horizon:
        var physical = state.physical
        var events = dv_clone(state.events)
        let parent = dvs_event(events, "action_wait", "", physical.time, [], {"until": event_wake_time, "waiting": 0, "reason": "declared-subject-time-boundary"})
        while physical.time < event_wake_time:
            let next_time = dvs_environment_next_time(physical, state.story, event_wake_time)
            physical = dvs_environment(dv_with(physical, "time", next_time), state.story, events, parent)
        return dvs_owned_state_update(state, {"physical": physical, "events": events, "cursor": event_wake_index, "idle": 0})
    if due_index >= 0:
        var physical = state.physical
        var events = dv_clone(state.events)
        let until = dv_min(due_time, wake_time)
        let parent = dvs_event(events, "action_wait", "", physical.time, [], {"until": until, "waiting": dvs_scheduled_count(state.actors)})
        // Visit authored clock boundaries and any unsettled process cascade.
        current = dvs_owned_state_update(state, {"events": events, "idle": 0})
        while physical.time < until:
            var next_time = dvs_environment_next_time(physical, state.story, until)
            if until < next_time:
                next_time = until
            physical = dvs_environment(dv_with(physical, "time", next_time), state.story, events, parent)
            current = dvs_interrupt_waits(dvs_owned_state_update(current, {"physical": physical, "events": events}))
            let interrupted = dvs_interrupted_wait_due(current.actors, physical.time)
            if interrupted >= 0:
                return dvs_dispatch_due(current, interrupted)
        if until < due_time:
            return dvs_owned_state_update(current, {"cursor": wake_index})
        return dvs_dispatch_due(current, due_index)
    return dvs_owned_state_update(state, {"idle": rt_count(state.actors)})

fn dvs_debug_phase(story, actor, time, phase):
    rt_phase(phase, actor)
    if dv_find(story, "debug_phase_progress", false):
        rt_print(rt_json_stringify({"type": "engine_phase", "actor": actor, "game_time": time, "phase": phase}))
    return true

fn dvs_prepare_actor(state):
    // A clock boundary may return the scan cursor of an actor still in flight.
    // Preserve that queue; the outer scheduler must dispatch its actual due time.
    if dv_find(state.actors[state.cursor], "scheduled_action", false) != false:
        return state
    state = dvs_simulation_sync(state)
    state = rt_snapshot(state)
    let story = state.story
    var physical = state.physical
    var actors = state.actors
    var events = dv_clone(state.events)
    var bindings = state.bindings
    var costs = state.costs
    var run_start = state.run_start
    var duration_budget = state.duration_budget
    var horizon = state.horizon
    var duration_blocked = state.duration_blocked
    var limit = state.limit
    var cursor = state.cursor
    var executed = state.executed
    var idle = state.idle
    var status = state.status
    var initial = state.initial
    var index = cursor
    var actor = dv_with_many(actors[cursor], {"idle_guard": false, "decision_time": physical.time})
    if dv_has_key(physical, "simulation"):
        actor = dv_with_many(actor, {"simulation_decision_macro": physical.simulation.macro_count, "simulation_decision_nearby": physical.simulation.last_nearby_second})
    var parent = events[(rt_count(events) - 1)].id
    var time = dv_find(physical, "time", 0)
    var local_1 = false
    if ((cursor + 1) < rt_count(actors)):
        local_1 = (cursor + 1)
    else:
        local_1 = 0
    cursor = local_1
    if (not dvs_actor_can_act(actor) or not (0 < dv_find(actor.policy, "budget", 0))):
        idle = (idle + 1)
    else:
        if dv_find(state, "player_selection", "") == "":
            actor = dv_with(actor, "policy", dv_with(actor.policy, "remaining_game_time", horizon - time))
            actor = dvs_update_support_events(actor, events)
            dvs_debug_phase(story, actor.id, time, "cognition-start")
            actor = dvs_drain_received_speech(actor, events, time)
            actor = dvs_notice_peers(actor, physical, actors, bindings, events, time, parent)
            actor = dvs_notice_visible_objects(actor, physical, bindings, events, time, parent)
            actor = dvs_prepare_cognition(actor, events, time, parent)
            dvs_debug_phase(story, actor.id, time, "cognition-end")
        actor = dvs_materialize_arguments(actor, events)
        var choice = false
        if dv_find(state, "player_actor", "") == actor.id:
            let selection = dv_find(state, "player_selection", "")
            if selection == "":
                let options = dvs_player_options(actor)
                if 0 < rt_count(options):
                    // Remember only opportunities already admitted for this
                    // subject; saved map knowledge can reuse those route IDs.
                    var offered = dv_find(actor, "offered_actions", [])
                    var option_index = 0
                    while option_index < rt_count(options):
                        let option = options[option_index]
                        if not dv_has(offered, option.id):
                            offered = dv_append(offered, option.id)
                        option_index = option_index + 1
                    actor = dv_with(actor, "offered_actions", offered)
                    actors = dvs_replace(actors, index, actor)
                    return dvs_control_state(state, actors, events, index, dv_find(state, "player_actor", ""), "", true)
            if selection == "":
                choice = {"action": false, "score": 0, "plan_expansions": 0, "plans": []}
            else:
                choice = dvs_player_choice(actor, selection)
        else:
            dvs_debug_phase(story, actor.id, time, "choice-start")
            rt_phase("decision-compute-start", actor.id)
            choice = dvs_choose(actor, bindings, costs)
            rt_phase("decision-compute-end", actor.id)
            dvs_debug_phase(story, actor.id, time, "choice-end")
        choice = dv_with_many(choice, {"cognition_reused": dv_find(actor, "cognition_reused", false), "reason_reused": dv_find(actor, "reason_reused", false), "cognition_stop": dv_find(actor, "cognition_stop", "ordinary-cognition-pass"), "evaluated_at_game_time": time, "mind_revision": actor.mind.revision})
        var action = choice.action
        actor = dv_with(actor, "decision_revision", actor.mind.revision)
        if (action == false):
            if (0 < dv_find(choice, "time_blocked", 0)):
                duration_blocked = true
            idle = (idle + 1)
            let stop = dvs_choice_event(events, "planning_stop", actor.id, time, dv_single(parent), choice)
            if dv_find(state, "player_actor", "") != actor.id and dv_find(choice, "time_blocked", 0) == 0 and dvs_idle_can_wait(actor):
                let boundary = dvs_idle_window_boundary(actor, story, time, horizon)
                if time < boundary.next:
                    let guard = {"time": time, "until": boundary.next, "source_stop": stop, "proof": "approximate-yield", "time_analysis_complete": boundary.complete, "declared_time_boundary": boundary.complete and boundary.next < horizon, "subject": dvs_idle_subject_input(actor, costs), "contact": dvs_idle_contact_input(actor, physical, actors), "bindings": bindings, "costs": costs, "story": dvs_idle_story_input(story), "event_cursor": rt_count(events), "event_anchor": events[rt_count(events) - 1]}
                    actor = dv_with(actor, "idle_guard", rt_snapshot(guard))
        else:
            action = dv_with(action, "label", dvs_action_label(actor, action))
            var id = actor.id
            var mind = actor.mind
            var model = dv_get(costs, action.kind)
            var action_event = rt_cat("action", rt_show(executed))
            var ledger = actor.ledger
            rt_phase("selection-evidence-start", id)
            let selection_parents = dvs_selection_parents(actor, action, choice, events, parent)
            rt_phase("selection-evidence-end", id)
            rt_phase("decision-record-start", id)
            parent = dvs_event_prepared(events, "action_selected", id, time, selection_parents, dv_with_many({"action": action, "revision_before": mind.revision, "score": choice.score, "hypothesis": dv_find(actor, "hypothesis", false)}, {"plan_expansions": choice.plan_expansions, "plans": choice.plans, "selected_path": dv_find(choice, "selected_path", []), "planning_stop": dv_find(choice, "stop", "manual-choice"), "planning_strategy": dv_find(choice, "strategy", "manual-choice"), "planning_approximation": dv_find(choice, "approximation", false), "planning_work": dv_find(choice, "planning_work", []), "owned_decision": dvs_owned_decision_selection(actor, action)}))
            parent = dvs_choice_event(events, "planning_choice", id, time, dv_single(parent), choice)
            var bounds = dv_action_cost_bounds(model.minimum, model.maximum)
            if dv_or((horizon < (time + bounds.maximum.time)), (horizon < (time + model.actual.time))):
                duration_blocked = true
                idle = (idle + 1)
                dvs_event(events, "duration_budget_rejected", id, time, dv_single(parent), {"action": action, "bounds": bounds, "actual": model.actual, "time_origin": {"run_start": run_start, "duration_budget": duration_budget, "horizon": horizon, "unit": "minute"}})
            else:
                if (not dv_action_cost_le(bounds.maximum, ledger.balances)):
                    dvs_event(events, "resource_rejected", id, time, dv_single(parent), {"action": action, "ledger": ledger})
                    idle = (idle + 1)
                else:
                    var queued = {"action": action, "choice": {"relevant_refs": choice.relevant_refs, "selected_path": dv_find(choice, "selected_path", [])}, "model": model, "start": time, "due": time + model.actual.time, "parent": parent}
                    if dv_find(action, "interruptible", false):
                        dvs_validate_interruptible_wait(action, model)
                        queued = dv_with(queued, "wait_watch", {"contact": dvs_idle_contact_input(actor, physical, actors), "event_cursor": rt_count(events)})
                    actor = dv_with(actor, "scheduled_action", queued)
                    dvs_event(events, "action_scheduled", id, time, [parent], {"action_id": action.id, "due": queued.due, "duration": model.actual.time})
                    idle = 0
            rt_phase("decision-record-end", id)

    actors = dvs_replace(actors, index, actor)
    return {"player_actor": dv_find(state, "player_actor", ""), "story": story, "physical": physical, "actors": actors, "events": events, "bindings": bindings, "costs": costs, "run_start": run_start, "duration_budget": duration_budget, "horizon": horizon, "duration_blocked": duration_blocked, "limit": limit, "cursor": cursor, "executed": executed, "idle": idle, "status": status, "initial": initial, "awaiting_player": false, "player_selection": ""}

fn dvs_session_complete_commit(state, receipt):
    state = rt_snapshot(state)
    let story = state.story
    var physical = state.physical
    var actors = state.actors
    var events = dv_clone(state.events)
    var bindings = state.bindings
    var costs = state.costs
    var run_start = state.run_start
    var duration_budget = state.duration_budget
    var horizon = state.horizon
    var duration_blocked = state.duration_blocked
    var limit = state.limit
    var cursor = state.cursor
    var executed = state.executed
    var idle = state.idle
    var status = state.status
    var initial = state.initial
    let pending = state.pending
    var index = pending.index
    var actor = pending.actor
    var parent = pending.parent
    var time = pending.time
    var action = pending.action
    var id = pending.id
    var mind = pending.mind
    var model = pending.model
    var action_event = pending.action_event
    var ledger = pending.ledger
    var quote = pending.quote
    let choice = pending.choice
    let interruption = dv_find(pending, "activity_interruption", false)
    dv_require(receipt.action_event == action_event, "Completion belongs to another action")
    // Due dispatch already checked the same owned evidence before any quote.
    // A corrupt/stale submitted payload must fail before fee or world effects.
    if dvs_action_requires_argument(action):
        dv_require(dv_same(actors[index], actor) and dv_same(physical, dv_find(pending, "argument_evidence_world", false)), "Argument execution state changed after Prepare")
        dv_require(dv_same(mind, actor.mind) and dv_find(action, "argument_evidence_revision", -1) == actor.mind.revision and dv_find(action, "argument_evidence_time", -1) == time and dv_find(action, "argument_evidence_mind_time", -1) == actor.mind.time, "Prepared argument evidence boundary mismatch")
    dv_require(dvs_argument_action_evidence(actor, action, events), "Prepared argument no longer has current paid evidence")
    // This execution uses the checked Prepare snapshot. Its own subsequent cost,
    // clock and observations cannot retroactively cancel the submitted speech;
    // the next cognition preparation refreshes/revokes its old argument instead.
    var before = physical
    var result = false
    dv_require(receipt.actual.time == pending.model.actual.time, "Scheduled receipt duration differs from declared duration")
    model = dv_with(model, "actual", receipt.actual)
    parent = dvs_event(events, "host_completion", id, time, dv_single(parent), receipt)
    var local_2 = false
    var local_3 = false
    if dv_has_key(action, "speech"):
        local_3 = dv_and(dvs_authority_speech_allowed(action, physical, id), (dvs_speech_truth(actor.mind, action.speech) == "true"))
    else:
        local_3 = true
    if local_3 and dvs_owned_decision_completion_selection(actor, action, events, parent) == false:
        local_3 = false
    if interruption != false:
        dv_require(dvs_interruptible_wait(action) and dv_same(dv_find(quote, "activity_interruption", false), interruption), "Interrupted wait quote mismatch")
        dv_require(interruption.elapsed == model.actual.time and quote.scheduled_start + model.actual.time == interruption.time and interruption.time == time, "Interrupted wait elapsed time mismatch")
        // The host still supplies the real receipt, but the chosen full wait did
        // not finish. Settle elapsed time without executing its full-duration law.
        local_2 = dv_action_cost_finish(ledger, physical, quote, model.actual, "rejected")
    else:
        if dv_or((not (receipt.outcome == "applied")), (not dv_and((dv_truth(physical, dv_find(action, "authority_precondition", action.precondition)) == "true"), local_3))):
            local_2 = dv_action_cost_finish(ledger, physical, quote, model.actual, "rejected")
        else:
            if (dv_find(action, "law", "") == ""):
                local_2 = dv_action_cost_finish(ledger, physical, quote, model.actual, "applied")
            else:
                local_2 = dv_action_cost_execute(ledger, physical, quote, model.actual)
    result = local_2
    if result.execution.status != "applied":
        var failure_class = dvs_manual_contact_failure(action, receipt, id)
        var reason = result.execution.status
        if interruption != false:
            failure_class = "activity-interrupted"
            reason = "activity-interrupted"
        if failure_class != "":
            reason = failure_class
        // These are engine classifications, never a serialized private premise.
        result = dv_with(result, "execution", dv_with_many(result.execution, {"failure_class": failure_class, "reason": reason}))
    physical = result.execution.world
    time = dv_find(physical, "time", time)
    actor = dv_with(actor, "ledger", result.ledger)
    parent = dvs_event_prepared(events, "action_execution", id, time, dv_single(parent), dv_with_many({"revision_before": before.revision, "revision_after": physical.revision, "physical_before": before, "physical_after": physical, "receipt": result, "action": action}, {"ledger_before": ledger, "ledger_after": result.ledger, "quote": quote, "actual": model.actual}))
    let execution_event = parent
    physical = dvs_environment(physical, story, events, parent)
    if (result.execution.status == "applied"):
        actor = dvs_record_request(dvs_finish_reply(dv_with(actor, "last_action_event", parent), action), action)
    rt_print(rt_json_stringify(dv_with({"event_id": parent, "actor": id, "action_id": action.id, "game_time": time}, "status", result.execution.status)))
    var local_4 = false
    var observation_grants = []
    if (result.execution.status == "applied"):
        observation_grants = dv_find(action, "grants", [])
    else:
        // Only the formal adapter's logical position establishes this site.
        // Native geometry may already have reached the destination while the
        // rejected DV transition retains its origin; that origin proves no contact.
        if dv_find(receipt, "executor", "") == "formal-model" and receipt.outcome == "applied" and dv_truth(physical, dv_find(action, "failure_observe_when", dv_not(dv_true()))) == "true":
            observation_grants = dv_find(action, "failure_grants", [])
    local_4 = dvs_observation_source(dv_perceive(physical, mind, bindings, observation_grants, action_event, time), action)
    var observations = dvs_receipt_clock_observations(story, mind, bindings, local_4, action_event, execution_event, result.execution.time)
    var profile = dvs_observation_profile(actor)
    let observed_mind = dv_update_mind(mind, observations, mind.revision, profile).world
    actor = dv_with(actor, "mind", dv_with(observed_mind, "time", dv_max(dv_find(observed_mind, "time", 0), result.execution.time)))
    if (0 < rt_count(observations)):
        parent = dvs_event_prepared(events, "observation", id, time, dvs_cognitive_parents(actor, dv_single(parent)), dv_with_many({"observations": observations, "revision_before": mind.revision, "revision_after": actor.mind.revision, "mind_before": mind, "mind_after": actor.mind, "action": action}, {"bindings": bindings, "grants": observation_grants, "execution_id": action_event}))
    if (0 < rt_count(observations)):
        actor = dv_with(actor, "last_cognitive_event", parent)
    actor = dvs_complete_cognitive_effects(actor, action, result.execution.status == "applied", events, execution_event, time)
    actor = dvs_complete_norm(actor, action, result.execution.status == "applied", events, time, execution_event, parent)
    actor = dvs_complete_advice(actor, action, result.execution.status == "applied", events, time, execution_event)
    actor = dvs_complete_owned_decision(actor, action, result.execution.status == "applied", events, execution_event, time)
    actor = dvs_complete_player_influences(actor, action, before, physical, result.execution.status == "applied", events, execution_event, time)
    if dv_and(dv_has_key(action, "answer"), (result.execution.status == "applied")):
        var judgment = dvs_answer(dv_find(story, "formal_answers", []), action, physical, actor.mind, bindings, events)
        var stage = ""
        var new_level = 0
        var current_level_cell = false
        var current_level = 0
        var is_higher = false
        parent = dvs_event(events, "answer_submitted", id, time, dv_single(parent), {"action": action, "mind_revision": actor.mind.revision, "physical_revision": physical.revision, "mind": actor.mind, "physical": physical, "personal_accepted_answers": dv_find(actor, "accepted_answers", [])})
        stage = judgment.stage
        new_level = judgment.truth_level
        current_level_cell = dv_unknown()
        if (not (judgment.progress_ref == false)):
            current_level_cell = dv_read(physical, judgment.progress_ref)
        var local_5 = false
        if current_level_cell.known:
            local_5 = current_level_cell.value
        else:
            local_5 = 0
        current_level = local_5
        is_higher = (dv_find(dv_find(actor, "accepted_answers", []), stage, 0) < new_level)
        if dv_and(judgment.accepted, (not is_higher)):
            judgment = dv_with_many(judgment, {"accepted": false, "reason": "already-accepted-personal-answer"})
        else:
            judgment = dv_with(judgment, "accepted", dv_and(judgment.accepted, is_higher))
        var local_6 = false
        if judgment.accepted:
            local_6 = "answer_accepted"
        else:
            local_6 = "answer_rejected"
        parent = dvs_event(events, local_6, id, time, dv_single(parent), judgment)
        if dv_and(judgment.accepted, (not (judgment.accepted_law == ""))):
            var transition = dv_execute(physical, judgment.accepted_law, rt_cat(action_event, "-accepted"), time, physical.revision)
            if (transition.status == "applied"):
                physical = transition.world
                var local_7 = false
                if (current_level < new_level):
                    local_7 = new_level
                else:
                    local_7 = current_level
                physical = dv_store(physical, judgment.progress_ref, dv_field(local_7))
                physical = dv_store(physical, judgment.completion_ref, dv_field(true))
                actor = dv_with(actor, "accepted_answers", dv_with(dv_find(actor, "accepted_answers", []), stage, new_level))
                parent = dvs_event(events, "question_transition", id, time, dv_single(parent), transition)
                actors = dvs_replace(actors, index, actor)
                actors = dvs_public_grants(actors, index, dv_with_many(action, {"speech": {"channel": "formal-receipt", "literal_ast": dv_true()}, "listeners": judgment.accepted_listeners, "public_grants": judgment.accepted_public_grants}), physical, bindings, events, time, parent, rt_cat(action_event, "-accepted"))
                actor = actors[index]
    var replay_question = ""
    if action.kind == "replay" and result.execution.status == "applied":
        let preparation = dvs_prepare_replay_argument(actor, action, events, time, parent)
        actor = preparation.actor
        replay_question = preparation.question
        if dv_find(actor, "cognition_blocked", false):
            dvs_event(events, "replay_deferred", id, time, dvs_cognitive_parents(actor, [parent]), {"action_id": action.id, "reason": "argument-revocation-pending", "question": replay_question, "reason_budget": dv_find(actor.policy, "reason_budget", 0)})
    if action.kind == "replay" and result.execution.status == "applied" and not dv_find(actor, "cognition_blocked", false) and not dvs_replay_has_available_candidate(actor):
        dvs_event(events, "replay_deferred", id, time, [parent], {"action_id": action.id, "reason": "no-executable-plan-with-known-external-inputs", "model_budget": dv_find(actor.policy, "model_budget", 0)})
    if action.kind == "replay" and result.execution.status == "applied" and not dv_find(actor, "cognition_blocked", false) and dvs_replay_has_available_candidate(actor):
        var candidates = dv_find(actor.policy, "hypotheses", [])
        let manual_id = dv_find(action, "replay_hypothesis_id", "")
        if manual_id != "":
            let selected = dvs_manual_candidate(actor, manual_id)
            candidates = []
            // Complete may occur after a queued wait; never reuse stale admission.
            if selected != false:
                candidates = [selected]
                actor = dv_with(actor, "last_manual_replay", manual_id)
            else:
                dvs_event(events, "manual_replay_unavailable", id, time, [parent], {"action_id": action.id, "hypothesis_id": manual_id, "reason": "subject-admission-changed"})
        var k = 0
        actor = dv_with(actor, "model_probe_cache", [])
        var replayed = []
        var simulations = dv_find(actor, "simulations", [])
        var coverages = []
        var factor_rejections = []
        // Clock/perception observations may have advanced parent since execution.
        // Payment must name the actual successful replay receipt, not its observation.
        actor = dv_with_many(actor, {"model_paid_event": execution_event, "policy": dv_with(actor.policy, "model_work_remaining", dv_find(model, "work_limit", 0))})
        // Paid constraint proofs still exclude competitors. Selecting one model
        // must not make evidence-backed formal answers require exhaustive replay.
        if (0 < rt_count(dv_find(actor.policy, "factor_constraints", []))):
            var prune = dvs_factor_prune(actor, events, time, parent)
            var certificates = []
            var c = 0
            while (c < rt_count(prune.certificates)):
                rt_push(certificates, dv_with(prune.certificates[c], "event", prune.event))
                c = (c + 1)
            actor = dv_with_many(actor, {"factor_certificates": certificates, "model_previous_event": prune.event, "last_cognitive_event": prune.event, "policy": dv_with_many(actor.policy, {"model_budget": prune.remaining, "model_work_remaining": prune.work_remaining})})
        while (k < rt_count(candidates)):
            var candidate = candidates[k]
            var coverage_key = rt_cat(dv_find(candidates[k], "question", dv_find(candidates[k], "topic", "")), dv_find(candidates[k], "group", ""))
            if dv_has_key(coverages, coverage_key):
                false
            else:
                coverages = dv_with(coverages, coverage_key, dvs_factor_coverage(actor, candidate, events))
            if dvs_replay_candidate_available(actor, candidate):
                if dvs_factor_covered(candidate, dv_get(coverages, coverage_key).certificates):
                    rt_push(factor_rejections, candidate.id)
                else:
                    if (dvs_sim_work_budget(actor) < 1):
                        k = rt_count(candidates)
                    else:
                        var cached = dv_find(simulations, candidate.id, false)
                        var simulation = false
                        var local_8 = false
                        if not dvs_model_recheck_eligible(actor, candidate, cached, time):
                            local_8 = dvs_model(actor, candidate, events, time, parent)
                        else:
                            var recheck = dvs_model_recheck(actor, cached)
                            dvs_event(events, "model_recheck", id, time, dvs_model_parent_ids(actor, parent, dv_find(cached, "event", "")), {"actor_before": dv_without(actor, "simulations"), "actor_id": actor.id, "actor_revision": actor.mind.revision, "model_before": cached, "hypothesis": candidate, "result": recheck})
                            local_8 = recheck
                        simulation = local_8
                        actor = dv_with(actor, "model_probe_cache", dv_find(simulation, "model_probe_cache", actor.model_probe_cache))
                        simulation = dv_without(simulation, "model_probe_cache")
                        simulation = dv_with_many(simulation, {"validation_inputs": dv_explanation_merge(dv_explanation_model_inputs(actor.mind, simulation), dvs_model_observed_inputs(simulation)), "source_adoptions": actor.mind.adoptions, "source_response_models": dv_find(actor, "response_models", [])})
                        simulation = dv_with_many(simulation, {"source_mind_time": actor.mind.time, "source_hypothesis": candidate, "source_replay_depth": dv_find(actor.policy, "Replay_Depth", rt_count(dvs_sim_plan(candidate)))})
                        simulations = dv_with(simulations, candidate.id, dv_with_many(simulation, {"event": events[(rt_count(events) - 1)].id, "source_revision": actor.mind.revision}))
                        actor = dv_with_many(actor, {"model_previous_event": events[(rt_count(events) - 1)].id, "last_cognitive_event": events[(rt_count(events) - 1)].id, "policy": dv_with_many(actor.policy, {"model_budget": simulation.remaining, "model_work_remaining": simulation.work_remaining})})
                        rt_push(replayed, candidate)
            k = (k + 1)
        actor = dv_without(dv_with(actor, "simulations", simulations), "model_probe_cache")
        if manual_id == "":
            actor = dv_with(actor, "factor_rejections", {"source_revision": actor.mind.revision, "ids": factor_rejections})
        actor = dvs_accept_paid_arguments(actor, replayed, replay_question, events, time, parent)
        actor = dvs_materialize_arguments(actor, events)
    if dv_has_key(actor, "location_ref"):
        var cell = dv_read(physical, actor.location_ref)
        if cell.known:
            actor = dv_with(actor, "location", cell.value)
    if dv_has_key(action, "answer"):
        actor = dv_with(actor, "answer_attempt_signatures", dv_with(dv_find(actor, "answer_attempt_signatures", []), action.id, dvp_input_signature(actor, action, choice.relevant_refs)))
    if (action.kind == "replay"):
        actor = dv_with(actor, "replay_attempt_signatures", dv_with(dv_find(actor, "replay_attempt_signatures", []), dvs_replay_attempt_key(action), dvs_replay_input_signature(actor, action, choice.relevant_refs)))
        if result.execution.status == "applied" and id == dv_find(state, "player_actor", ""):
            actor = dv_with(actor, "manual_replay_refresh", true)
    if action.kind == "inspect" and result.execution.status == "applied":
        actor = dv_with(actor, "inspection_attempt_signatures", dv_with(dv_find(actor, "inspection_attempt_signatures", []), action.id, dvp_inspection_signature(actor, action, actor.mind)))
    var retry = false
    if result.execution.status != "applied" and id == dv_find(state, "player_actor", ""):
        let failure_class = dvs_manual_contact_failure(action, receipt, id)
        if failure_class != "":
            retry = {"failure_class": failure_class, "action_event": action_event, "source_signature": dvp_rejected_signature(actor, action, actor.mind)}
    actor = dv_with(actor, "manual_contact_retries", dv_with(dv_find(actor, "manual_contact_retries", []), action.id, retry))
    if result.execution.status != "applied" and interruption == false:
        actor = dv_with(actor, "rejected_attempt_signatures", dv_with(dv_find(actor, "rejected_attempt_signatures", []), action.id, dvp_rejected_signature(actor, action, actor.mind)))
    else:
        actor = dv_with(actor, "rejected_attempt_signatures", dv_with(dv_find(actor, "rejected_attempt_signatures", []), action.id, false))
    actor = dv_with(actor, "attempts", dv_with(dv_find(actor, "attempts", []), action.id, actor.mind.revision))
    if result.execution.status == "applied":
        actor = dv_with(actor, "completed_actions", dv_append(dv_find(actor, "completed_actions", []), action.id))
        if action.kind == "move" and dv_has_key(action, "travel"):
            let position = dv_read(actor.mind, actor.location_ref)
            if dv_uncontested(position) and position.value == action.travel.to:
                var visited = dv_find(actor, "visited_locations", [])
                if not dv_has(visited, action.travel.from):
                    visited = dv_append(visited, action.travel.from)
                if not dv_has(visited, action.travel.to):
                    visited = dv_append(visited, action.travel.to)
                actor = dv_with(actor, "visited_locations", visited)
    actor = dv_with_many(actor, {"used": dv_append(dv_find(actor, "used", []), action.id), "policy": dv_with(actor.policy, "budget", (actor.policy.budget - 1))})
    actors = dvs_replace(actors, index, actor)
    if dv_and(dv_has_key(action, "public_observers"), (result.execution.status == "applied")):
        actors = dvs_visible_action_grants(actors, index, action, before, physical, bindings, events, time, parent, action_event)
    if dv_and(dv_has_key(action, "speech"), (result.execution.status == "applied")):
        // This actual execution boundary supplies player identity, never a forecast.
        var actual_player = ""
        if id == dv_find(state, "player_actor", ""):
            actual_player = id
        var control = "autonomous"
        if actual_player != "":
            control = "player"
        action = dv_with(action, "speech", dv_with_many(action.speech, {"actual_player_actor": actual_player, "actual_influence_actor": id, "actual_influence_control": control, "actual_literal_truth": dv_truth(physical, action.speech.literal_ast)}))
        actors = dvs_speech_owned(actors, index, action, events, time, parent, physical)
        actors = dvs_public_grants(actors, index, action, physical, bindings, events, time, parent, action_event)
    if result.execution.status == "applied" and action.kind == "move":
        actors = dvs_notice_movement_witnesses(actors, index, before, physical, bindings, events, time, execution_event)
    actor = actors[index]
    // A real receipt is also an opportunity to look at the actual nearby scene.
    // Rejection itself proves nothing about an absent person's destination.
    actor = dvs_notice_peers(actor, physical, actors, bindings, events, time, execution_event)
    actor = dvs_notice_visible_objects(actor, physical, bindings, events, time, execution_event)
    executed = (executed + 1)
    idle = 0
    actors = dvs_replace(actors, index, actor)
    return {"player_actor": dv_find(state, "player_actor", ""), "story": story, "physical": physical, "actors": actors, "events": events, "bindings": bindings, "costs": costs, "run_start": run_start, "duration_budget": duration_budget, "horizon": horizon, "duration_blocked": duration_blocked, "limit": limit, "cursor": cursor, "executed": executed, "idle": idle, "status": status, "initial": initial, "awaiting_player": false, "player_selection": ""}

fn dvs_session_status(state):
    var status = state.status
    if state.idle >= rt_count(state.actors):
        status = "no-admissible-action-or-budget"
        if state.duration_blocked:
            status = "budget-exhausted"
    if state.horizon <= state.physical.time:
        status = "budget-exhausted"
    if dvs_session_active(state):
        status = "active"
    if 0 < rt_count(state.events):
        let last = state.events[rt_count(state.events) - 1]
        if last.type == "session_stopped":
            status = last.data.reason
    return status

fn dvs_trace_snapshot(state):
    let story = state.story
    let physical = state.physical
    let actors = state.actors
    let events = state.events
    let costs = state.costs
    let bindings = state.bindings
    let initial = state.initial
    let run_start = state.run_start
    let duration_budget = state.duration_budget
    let horizon = state.horizon
    let status = dvs_session_status(state)
    return {"events": events, "initial": initial, "final": {"physical": physical, "actors": actors}, "status": status, "time": dv_find(physical, "time", 0), "game_time_unit": "minute", "configuration": {"cost_model": costs, "formal_answers": dv_find(story, "formal_answers", []), "source_refs": dv_find(story, "source_refs", []), "time_origin": {"run_start": run_start, "duration_budget": duration_budget, "horizon": horizon, "unit": "minute"}, "report_labels": dv_find(story, "report_labels", []), "bindings": bindings}, "scope": dv_find(story, "execution_scope", "DV formal model; no Godot host input or geometry")}

fn dvs_session_close(state):
    state = rt_snapshot(state)
    var events = dv_clone(state.events)
    if rt_count(events) == 0 or events[rt_count(events) - 1].type != "session_stopped":
        let parent = events[rt_count(events) - 1].id
        var status = dvs_session_status(state)
        if status == "active":
            status = "host-closed-during-active-session"
        dvs_event(events, "session_stopped", "", state.physical.time, [parent], {"reason": status, "actions_executed": state.executed})
        rt_print(rt_json_stringify({"type": "session_stopped", "status": status, "game_time": state.physical.time}))
    return dvs_trace_snapshot(dvs_owned_state_update(state, {"events": events}))

// A real, settled action reports its completion time to its own actor.
// No other physical fields or inactive actors are synchronized.
fn dvs_receipt_clock_observations(story, mind, bindings, observations, action_event, execution_event, time):
    let clock = dv_find(story, "clock_ref", false)
    if clock == false:
        return observations
    let local = dv_local(bindings, clock.object, mind.subject)
    if local == "":
        return observations
    let ref = dv_scoped_ref(mind.subject, local, clock.facet, clock.field)
    let prior = dv_read(mind, ref)
    if not prior.known or not rt_is_numeric_value(prior.value):
        return observations
    let receipt = dv_observation(dv_list3(action_event, mind.subject, ref), mind.subject, ref, time, "perception", "execution-receipt", time, 1, dv_pair(execution_event, ref))
    var result = []
    var replaced = false
    var i = 0
    while i < rt_count(observations):
        if dv_same_local_ref(mind.subject, observations[i].ref, ref):
            if not replaced:
                rt_push(result, receipt)
                replaced = true
        else:
            rt_push(result, observations[i])
        i = i + 1
    if not replaced:
        rt_push(result, receipt)
    return result

fn dvs_replace(items, index, value):
    // Domain states are persistent values. Freeze the old root so replacing one
    // actor does not eagerly thaw every unrelated actor through generic reads.
    return rt_list_with_index(rt_snapshot(items), index, value)

fn dvs_public_grants(actors, speaker_index, action, physical, bindings, events, time, parent, execution_id):
    var result = actors
    var speaker = actors[speaker_index]
    var listeners = dv_find(action, "listeners", [])
    var grants = dv_find(action, "public_grants", [])
    if rt_count(listeners) == 0 or rt_count(grants) == 0:
        return actors
    let projection = dvs_public_projection_inputs(events, execution_id)
    dv_require(not projection.repeated, "Repeated public grant projection")
    dvs_event(events, "public_grants_projection", speaker.id, time, dv_single(parent), {"execution_id": execution_id, "action_id": action.id, "already_projected": projection.sources})
    var i = 0
    while (i < rt_count(actors)):
        var actor = result[i]
        var mind = result[i].mind
        if dv_and(dv_has(listeners, actor.id), dvs_speech_hearing(speaker, actor, action.speech, physical)):
            var grants = dv_find(action, "public_grants", [])
            var projected = dv_perceive(physical, mind, bindings, dv_find(action, "public_grants", []), execution_id, time)
            var observations = dvs_public_filter_projected(projected, dv_find(projection.by_subject, actor.id, []))
            if (0 < rt_count(observations)):
                var actual_grants = []
                var g = 0
                while g < rt_count(grants):
                    let local_ref = dv_scoped_ref(actor.id, dv_local(bindings, grants[g].object, actor.id), grants[g].facet, grants[g].field)
                    var o = 0
                    var included = false
                    while o < rt_count(observations):
                        if dv_same(local_ref, observations[o].ref):
                            included = true
                        o = o + 1
                    if included:
                        rt_push(actual_grants, grants[g])
                    g = g + 1
                var next = dv_update_mind(mind, observations, mind.revision, dvs_observation_profile(actor)).world
                var observation_event = ""
                observation_event = dvs_event_prepared(events, "observation", actor.id, time, dvs_cognitive_parents(actor, dvs_public_grant_parents(events, parent, actor.id)), dv_with_many({"observations": observations, "revision_before": mind.revision, "revision_after": next.revision, "mind_before": mind, "mind_after": next, "action": action}, {"bindings": bindings, "grants": actual_grants, "declared_grants": grants, "execution_id": execution_id, "source_event": dvs_public_literal_source(events, parent, actor.id)}))
                result = dvs_replace(result, i, dv_with_many(actor, {"mind": next, "last_cognitive_event": observation_event}))
        i = (i + 1)
    return result

// Union authorizations within one real execution, using published observations
// as evidence of contact. Never filter the mind's generic seen list: unrelated
// or repeated invocations must still fail their normal duplicate checks.
fn dvs_public_projection_inputs(events, execution_id):
    events = rt_snapshot(events)
    var by_subject = []
    var sources = []
    var repeated = false
    var i = rt_count(events) - 1
    var scanning = true
    while i >= 0 and scanning:
        let event = events[i]
        if event.type == "public_grants_projection":
            if dv_same(event.data.execution_id, execution_id):
                repeated = true
        if event.type == "observation" and dv_same(dv_find(event.data, "execution_id", false), execution_id):
            let observations = dv_find(event.data, "observations", [])
            var j = 0
            var existing = dv_find(by_subject, event.actor, [])
            while j < rt_count(observations):
                rt_push(existing, observations[j].id)
                rt_push(sources, {"event": event.id, "subject": event.actor, "ref": observations[j].ref, "observation_id": observations[j].id})
                j = j + 1
            by_subject = dv_with(by_subject, event.actor, existing)
        if event.type == "action_execution":
            scanning = false
        i = i - 1
    return {"by_subject": by_subject, "sources": sources, "repeated": repeated}

fn dvs_public_filter_projected(projected, existing):
    var result = []
    var i = 0
    while i < rt_count(projected):
        if not dv_has(existing, projected[i].id):
            rt_push(result, projected[i])
        i = i + 1
    return result

fn dvs_observation_source(observations, action):
    var result = []
    var i = 0
    var source = dv_find(action, "observation_source", "perception")
    var origin = dv_find(action, "observation_origin", "direct")
    var trust = dv_find(action, "observation_trust", 1)
    dv_require(dv_has(dv_list3("perception", "testimony", "recall"), source), "Unknown observation source")
    dv_unit(trust)
    while (i < rt_count(observations)):
        let observation = observations[i]
        var mapped = dv_with_many(observation, {"source": source, "origin": origin, "trust": trust})
        let overrides = dv_find(action, "grant_observation_sources", [])
        var j = 0
        while (j < rt_count(overrides)):
            let entry = overrides[j]
            if dv_same_local_ref(observation.subject, entry.ref, observation.ref):
                mapped = dv_with_many(mapped, {"source": entry.source, "origin": entry.origin, "trust": entry.trust})
            j = j + 1
        rt_push(result, mapped)
        i = (i + 1)
    return result

fn dvs_observation_profile(actor):
    return dv_observation_profile(dv_find(actor.policy, "observation_weights", {"perception": 1, "testimony": 1, "recall": 1}), dv_find(actor.policy, "observation_threshold", 0.5))

// Linear host-state transfer only. The caller relinquishes the previous state.
// Keep persistent world/mind/prediction updates on their independent-copy APIs.
fn dvs_owned_state_update(state, updates):
    var result = []
    var keys = []
    var i = 0
    while i < rt_count(state):
        let key = state[i][0]
        rt_push(result, dv_pair(key, dv_find(updates, key, state[i][1])))
        rt_push(keys, key)
        i = i + 1
    i = 0
    while i < rt_count(updates):
        let key = updates[i][0]
        if not dv_has(keys, key):
            rt_push(result, dv_pair(key, updates[i][1]))
            rt_push(keys, key)
        i = i + 1
    return result

// ---- Merged source module: 32-environment.dv ----
// Physical processes read physical conditions. They never publish private knowledge.
fn dvs_dirty_environment_index(world, processes):
    let key = ["dirty-environment-index-v1", world.adoptions]
    let cached = rt_memo_get(processes, key)
    if cached[0]:
        return cached[1]
    var index = []
    var i = 0
    while i < rt_count(processes):
        let law = dv_get(world.adoptions, processes[i].law).law
        var refs = dvs_dirty_refs(law.premise)
        var j = 0
        while j < rt_count(law.effects):
            let effect = law.effects[j]
            dv_require(effect.op == "assign" or effect.op == "increment", rt_cat("Unindexed effect operator: ", effect.op))
            refs = dvp_merge_refs(refs, [effect.ref])
            j = j + 1
        // Validate every dependency's subject even before it is dirtied.
        j = 0
        while j < rt_count(refs):
            let subject = dv_find(refs[j], "subject", "")
            dv_require(subject == "" or subject == world.subject, "Cross-subject reference access")
            j = j + 1
        rt_push(index, {"law": processes[i].law, "refs": refs})
        i = i + 1
    return rt_memo_put(processes, key, rt_snapshot(index))

fn dvs_dirty_verify_skipped(world, processes, first, until, time):
    var i = first
    while i < until:
        let adoption = dv_get(world.adoptions, processes[i].law)
        if adoption.active and adoption.mode == "enforce" and dv_truth_uncached(world, adoption.law.premise) == "true":
            let staged = dv_stage(world, adoption.law.effects, time, adoption.basis, adoption.confidence)
            dv_require(staged.status != "ready" or not dvs_reason_changes(staged.changes), rt_cat("Dirty queue omitted rule: ", adoption.law.name))
        i = i + 1
    return true

fn dvs_environment(physical, story, events, parent):
    let dirty_config = dv_find(story, "run_config", [])
    let readview = dv_find(dv_find(story, "run_config", []), "opt_readview", false)
    var world = dvs_simulation_environment(physical, story, events, parent)
    let time = dv_find(world, "time", 0)
    let clock = dv_find(story, "clock_ref", false)
    if clock != false:
        world = dv_store(world, clock, dv_cell(time, 1, time, [parent]))
    var processes = dvs_simulation_unmanaged_processes(world, dv_find(story, "world_processes", []))
    if readview:
        world = rt_snapshot(world)
        processes = rt_snapshot(processes)
    let dirty = dv_find(dirty_config, "opt_dirty", false)
    var dependency_index = []
    var verify = false
    if dirty:
        processes = rt_snapshot(processes)
        dependency_index = dvs_dirty_environment_index(world, processes)
        let verify_every = dv_find(dirty_config, "opt_dirty_verify", 0)
        if 0 < verify_every:
            let tick_key = ["dirty-environment-verify-tick"]
            let tick = rt_memo_get(processes, tick_key)
            var calls = 1
            if tick[0]:
                calls = tick[1] + 1
            if calls >= verify_every:
                verify = true
                calls = 0
            rt_memo_put(processes, tick_key, calls)
    var i = 0
    if dirty:
        i = rt_dirty_next(world, dependency_index, -1)
        if verify:
            dvs_dirty_verify_skipped(world, processes, 0, i, time)
    while i < rt_count(processes):
        let process = processes[i]
        let adoption = dv_get(world.adoptions, process.law)
        if adoption.active and adoption.mode == "enforce" and dvs_dirty_truth(world, adoption.law.premise, dirty_config, adoption.law.name) == "true":
            let staged = dv_stage(world, adoption.law.effects, time, adoption.basis, adoption.confidence)
            var changed = false
            var j = 0
            while j < rt_count(staged.changes):
                let change = staged.changes[j]
                if not dv_same(dvs_reason_value(change.before), dvs_reason_value(change.after)):
                    changed = true
                j = j + 1
            if staged.status == "ready" and changed:
                let id = rt_cat("environment-", rt_show(rt_count(events)))
                let before = world
                let execution = dv_execute(world, process.law, id, time, world.revision)
                world = execution.world
                if execution.status == "applied" and dv_find(process, "once", false):
                    world = dv_suspend(world, process.law)
                if readview:
                    world = rt_snapshot(world)
                parent = dvs_event(events, "physical_process", "", time, [parent], {"process": process, "revision_before": before.revision, "revision_after": world.revision, "suspended": not dv_get(world.adoptions, process.law).active, "execution": dv_without(execution, "world")})
        let previous = i
        if dirty:
            i = rt_dirty_next(world, dependency_index, previous)
            if verify:
                dvs_dirty_verify_skipped(world, processes, previous + 1, i, time)
        else:
            i = i + 1
    return world

// Match the old minute lattice, including a fractional action completion.
fn dvs_environment_boundary(condition, clock, now, due):
    return dv_time_boundary(condition, clock, now, due, "minute").next

// A process that can still change the world requires another ordinary minute.
// This retains repeated increments, conflicting writes and ordered cascades.
// Analyze clock structure once per immutable declaration. Minute sampling is
// an explicit classification for equality/ambiguous clock identity, matching
// dv_time_boundary; unknown language operators are errors, not scan fallbacks.
fn dvs_dirty_clock_plan(condition, clock):
    let key = ["dirty-clock-plan-v2", clock]
    let cached = rt_memo_get(condition, key)
    if cached[0]:
        return cached[1]
    let op = condition.op
    var minute = false
    var thresholds = []
    var aged = []
    if op == "held_for":
        dv_require(dv_condition_inputs(condition).complete, "Invalid held-for clock declaration")
        return rt_memo_put(condition, key, {"minute": false, "thresholds": [], "aged": [condition]})
    if op == "constant":
        dv_require(dv_has(["true", "false", "unknown"], condition.value), "Invalid constant clock condition")
    else:
        if op == "not":
            let child = dvs_dirty_clock_plan(condition.item, clock)
            minute = child.minute
            thresholds = child.thresholds
            aged = child.aged
        else:
            if op == "all":
                var i = 0
                while i < rt_count(condition.items):
                    let child = dvs_dirty_clock_plan(condition.items[i], clock)
                    minute = minute or child.minute
                    aged = dvp_merge_refs(aged, child.aged)
                    var j = 0
                    while j < rt_count(child.thresholds):
                        if not dv_has(thresholds, child.thresholds[j]):
                            rt_push(thresholds, child.thresholds[j])
                        j = j + 1
                    i = i + 1
            else:
                dv_require(op == "equals" or op == "at_least", rt_cat("Unindexed clock operator: ", op))
                dv_require(dv_condition_inputs(condition).complete, "Invalid clock dependency declaration")
                if clock != false:
                    let relation = dv_time_ref_relation(condition.ref, clock)
                    if relation == "unknown":
                        minute = true
                    else:
                        if relation == "same":
                            if op == "at_least" and rt_is_numeric_value(condition.value):
                                rt_push(thresholds, condition.value)
                            else:
                                minute = true
    return rt_memo_put(condition, key, {"minute": minute, "thresholds": thresholds, "aged": aged})

fn dvs_dirty_clock_boundary(world, processes, clock, now, due):
    let key = ["dirty-world-clock-plan-v2", world.adoptions, clock]
    let cached = rt_memo_get(processes, key)
    var plan = false
    if cached[0]:
        plan = cached[1]
    else:
        var minute = false
        var thresholds = []
        var aged = []
        var i = 0
        while i < rt_count(processes):
            let adoption = dv_get(world.adoptions, processes[i].law)
            if adoption.active and adoption.mode == "enforce":
                let child = dvs_dirty_clock_plan(adoption.law.premise, clock)
                minute = minute or child.minute
                aged = dvp_merge_refs(aged, child.aged)
                var j = 0
                while j < rt_count(child.thresholds):
                    if not dv_has(thresholds, child.thresholds[j]):
                        rt_push(thresholds, child.thresholds[j])
                    j = j + 1
            i = i + 1
        plan = rt_memo_put(processes, key, {"minute": minute, "thresholds": thresholds, "aged": aged})
    if due < now:
        return due
    var next = due
    if plan.minute:
        next = dv_min(next, now + 1)
    var i = 0
    while i < rt_count(plan.thresholds):
        let threshold = plan.thresholds[i]
        if now < threshold and threshold <= due:
            let delta = threshold - now
            var steps = 1
            while steps < delta:
                steps = steps + 1
            next = dv_min(next, now + steps)
        i = i + 1
    i = 0
    while i < rt_count(plan.aged):
        let condition = dv_time_materialize(world, plan.aged[i])
        next = dv_min(next, dv_time_boundary(condition, clock, now, due, "minute").next)
        i = i + 1
    return next

// Debug-only reference keeps the original scan and its first live-process return.
// Invoke only at an explicitly requested opt_dirty_verify sample.
fn dvs_environment_reference_next_time(world, processes, clock, now, due):
    var next = due
    var i = 0
    while i < rt_count(processes):
        let adoption = dv_get(world.adoptions, processes[i].law)
        if adoption.active and adoption.mode == "enforce":
            next = dv_min(next, dvs_environment_boundary(dv_time_materialize(world, adoption.law.premise), clock, now, due))
            if dv_truth_uncached(world, adoption.law.premise) == "true":
                let staged = dv_stage(world, adoption.law.effects, now, adoption.basis, adoption.confidence)
                var j = 0
                while j < rt_count(staged.changes):
                    let change = staged.changes[j]
                    if dv_same(change.ref, clock) or not dv_same(dvs_reason_value(change.before), dvs_reason_value(change.after)):
                        return dv_min(due, now + 1)
                    j = j + 1
        i = i + 1
    return next

fn dvs_environment_next_time(world, story, due):
    let readview = dv_find(dv_find(story, "run_config", []), "opt_readview", false)
    if readview:
        world = rt_snapshot(world)
    let clock = dv_find(story, "clock_ref", false)
    let now = world.time
    var next = due
    var processes = dvs_simulation_unmanaged_processes(world, dv_find(story, "world_processes", []))
    if readview:
        processes = rt_snapshot(processes)
    let dirty_config = dv_find(story, "run_config", [])
    let dirty = dv_find(dirty_config, "opt_dirty", false)
    var verify_clock = false
    var original_next = due
    if dirty:
        processes = rt_snapshot(processes)
        next = dvs_dirty_clock_boundary(world, processes, clock, now, due)
        let every = dv_find(dirty_config, "opt_dirty_verify", 0)
        if 0 < every:
            let key = ["dirty-clock-verify-tick"]
            let previous = rt_memo_get(processes, key)
            var calls = 1
            if previous[0]:
                calls = previous[1] + 1
            if calls >= every:
                verify_clock = true
                calls = 0
            rt_memo_put(processes, key, calls)
    if verify_clock:
        original_next = dvs_environment_reference_next_time(world, processes, clock, now, due)
    var i = 0
    while i < rt_count(processes):
        let adoption = dv_get(world.adoptions, processes[i].law)
        if adoption.active and adoption.mode == "enforce":
            if not dirty:
                next = dv_min(next, dvs_environment_boundary(dv_time_materialize(world, adoption.law.premise), clock, now, due))
            if dv_truth(world, adoption.law.premise) == "true":
                let staged = dv_stage(world, adoption.law.effects, now, adoption.basis, adoption.confidence)
                var j = 0
                while j < rt_count(staged.changes):
                    let change = staged.changes[j]
                    if dv_same(change.ref, clock) or not dv_same(dvs_reason_value(change.before), dvs_reason_value(change.after)):
                        let immediate = dv_min(due, now + 1)
                        if verify_clock:
                            dv_require(immediate == original_next, "Dirty clock live-process boundary differs from reference scan")
                        return dvs_simulation_next_time(world, immediate)
                    j = j + 1
        i = i + 1
    if verify_clock:
        dv_require(next == original_next, "Dirty clock boundary differs from complete declaration scan")
    return dvs_simulation_next_time(world, next)

// ---- Merged source module: 40-host.dv ----
// Host commands contain an action and its execution contract, never a mind or oracle.
// Only inert visible prose uses this representation. IDs, semantic speech AST,
// action labels and scoring inputs remain in their existing representations.
// Parts are captured at construction; rendering never reads a later mind.
fn dvs_surface_parts(parts):
    if rt_lazyinternal_enabled():
        return rt_snapshot({"format": "surface-parts-v1", "parts": parts})
    return dvs_render_surface({"format": "surface-parts-v1", "parts": parts})

fn dvs_render_surface(surface):
    if rt_is_text(surface):
        return surface
    dv_require(dv_find(surface, "format", "") == "surface-parts-v1", "Unknown visible surface representation")
    var rendered = []
    var i = 0
    while i < rt_count(surface.parts):
        rt_push(rendered, dvs_render_surface(surface.parts[i]))
        i = i + 1
    return rt_text_join(rendered)

fn dvs_present_replace(text, token, value):
    var result = ""
    var i = 0
    while i < rt_length(text):
        if i + rt_length(token) <= rt_length(text) and rt_slice(text, i, rt_length(token)) == token:
            result = rt_cat(result, value)
            i = i + rt_length(token)
        else:
            result = rt_cat(result, rt_chr(text, i))
            i = i + 1
    return result

fn dvs_present_lines(state, viewer, presentation):
    if rt_count(dv_find(presentation, "lines", [])) == 0:
        return []
    var mind = false
    var i = 0
    while i < rt_count(state.actors):
        if state.actors[i].id == viewer:
            mind = state.actors[i].mind
        i = i + 1
    var result = []
    if mind == false:
        return result
    let lines = dv_find(presentation, "lines", [])
    i = 0
    while i < rt_count(lines):
        let line = lines[i]
        var visible = dv_truth(mind, dv_find(line, "when", dv_true())) == "true"
        var text = line.template
        let bindings = dv_find(line, "bindings", [])
        var j = 0
        while visible and j < rt_count(bindings):
            let binding = bindings[j]
            let cell = dv_read(mind, binding.ref)
            if dv_uncontested(cell):
                let value = rt_show(cell.value)
                let labels = dv_find(binding, "labels", [])
                var display = dv_find(labels, value, value)
                if 0 < rt_count(labels) and not dv_has_key(labels, value) and dv_has_key(binding, "unmapped_fallback"):
                    display = binding.unmapped_fallback
                if dv_find(binding, "format", "") == "game-clock" and rt_is_numeric_value(cell.value):
                    let minute = rt_floor(cell.value)
                    let day = rt_floor(minute / 1440)
                    let daytime = minute - day * 1440
                    let hour = rt_floor(daytime / 60)
                    let rest = daytime - hour * 60
                    var clock_minute = rt_show(rest)
                    if rest < 10:
                        clock_minute = rt_cat("0", clock_minute)
                    display = rt_cat("第", rt_cat(rt_show(day + 1), rt_cat("日 ", rt_cat(rt_show(hour), rt_cat(":", clock_minute)))))
                text = dvs_present_replace(text, rt_cat("{", rt_cat(binding.name, "}")), display)
            else:
                if dv_has_key(binding, "fallback") and rt_is_text(binding.fallback):
                    text = dvs_present_replace(text, rt_cat("{", rt_cat(binding.name, "}")), binding.fallback)
                else:
                    visible = false
            j = j + 1
        if visible:
            rt_push(result, text)
        i = i + 1
    return result

fn dvs_session_intent(state):
    let pending = dv_find(state, "pending", false)
    if pending == false:
        if dv_find(state, "awaiting_player", false):
            return {"status": "awaiting_input", "active": true, "game_time": state.physical.time, "options": dvs_player_options(state.actors[state.cursor])}
        return {"status": "idle", "active": dvs_session_active(state), "game_time": state.physical.time}
    return {"status": "prepared", "actor": pending.id, "action_event": pending.action_event, "action": pending.action, "bounds": pending.quote.bounds, "execution_cost": pending.model.actual, "game_time": pending.time, "activity_interruption": dv_find(pending, "activity_interruption", false)}

fn dvs_session_presentation(state, viewer):
    state = rt_snapshot(state)
    var i = rt_count(state.events) - 1
    var perceived = false
    var heard = false
    var judgment = false
    while 0 <= i:
        let event = state.events[i]
        if event.actor == viewer and (event.type == "answer_accepted" or event.type == "answer_rejected"):
            judgment = {"status": event.type, "event_id": event.id, "game_time": event.time, "reason": dv_find(event.data, "reason", ""), "stage": dv_find(event.data, "stage", "")}
        if event.actor == viewer and (event.type == "listener_parse" or event.type == "observation"):
            perceived = true
        if event.actor == viewer and (event.type == "listener_parse" or event.type == "speech_received_pending"):
            heard = true
        if event.type == "action_execution":
            let action = event.data.action
            let execution = event.data.receipt.execution
            let applied = execution.status == "applied"
            let visible = event.actor == viewer or (heard or (perceived and not dv_has_key(action, "speech")))
            var surface = ""
            var presentation = []
            if applied and visible:
                surface = dvs_render_surface(dv_find(action, "surface", dv_find(dv_find(action, "speech", []), "surface", "")))
                presentation = dv_find(action, "presentation", [])
            if not applied and event.actor == viewer:
                presentation = dv_find(action, "failure_presentation", [])
            var voice = "narration"
            if dv_has_key(action, "speech"):
                voice = "dialogue"
            let surface_voice = dv_find(presentation, "surface_voice", voice)
            voice = dv_find(presentation, "voice", voice)
            var travel = []
            if applied and visible:
                travel = dv_find(action, "travel", [])
            return {"status": execution.status, "failure_class": dv_find(execution, "failure_class", ""), "reason": dv_find(execution, "reason", ""), "actor": event.actor, "speaker": dv_find(presentation, "actor", event.actor), "action_id": action.id, "action_kind": action.kind, "execution_event": event.id, "source_refs": dv_find(action, "source_refs", []), "voice": voice, "surface_voice": surface_voice, "presentation_kind": dv_find(presentation, "kind", ""), "game_time": event.time, "visible": applied and visible, "surface": surface, "lines": dvs_present_lines(state, viewer, presentation), "travel": travel, "judgment": judgment}
        i = i - 1
    return {"status": "idle", "game_time": state.physical.time}

// Human choice uses the same subject-local admission and the same prepared receipt.
fn dvs_set_player(state, actor):
    dv_require(dv_find(state, "pending", false) == false, "Cannot change controller during execution")
    var found = actor == ""
    var i = 0
    while i < rt_count(state.actors):
        if state.actors[i].id == actor:
            found = true
        i = i + 1
    dv_require(found, "Unknown player actor")
    return dvs_control_state(state, state.actors, state.events, state.cursor, actor, "", false)

fn dvs_control_state(state, actors, events, cursor, player, selection, waiting):
    return dvs_owned_state_update(state, {"actors": actors, "events": events, "cursor": cursor, "player_actor": player, "player_selection": selection, "awaiting_player": waiting})

// Manual envelopes are transient input; permanent action identity is unchanged.
fn dvs_manual_selection(selection):
    if rt_is_text(selection):
        return {"action_id": selection, "hypothesis_id": ""}
    dv_require(rt_is_list(selection), "Player selection must be an action ID or data envelope")
    dv_require(rt_is_text(dv_find(selection, "action_id", false)), "Player action ID must be text")
    dv_require(rt_is_text(dv_find(selection, "hypothesis_id", "")), "Player hypothesis ID must be text")
    return selection

// Admission and paid Complete use the same subject-local candidate conditions.
fn dvs_replay_candidate_available(actor, candidate):
    return dvp_topic(actor, candidate) and 0 < rt_count(dv_find(candidate, "basis", [])) and dv_truth(actor.mind, dv_find(candidate, "available_when", dv_true())) == "true" and 0 < rt_count(dvs_sim_plan(candidate)) and dvs_replay_inputs_known(actor.mind, candidate)

// External receipts are read from this owner only. False is a known value;
// assumptions and predicted outputs never satisfy missing external inputs.
fn dvs_replay_inputs_known(mind, candidate):
    let refs = dv_find(candidate, "external_inputs", [])
    var i = 0
    while i < rt_count(refs):
        if not dv_uncontested(dv_read(mind, refs[i])):
            return false
        i = i + 1
    return true

fn dvs_replay_has_available_candidate(actor):
    let candidates = dv_find(actor.policy, "hypotheses", [])
    // A factor-only replay has no candidate catalog to enable. Keep its existing
    // paid constraint path; a populated catalog must have an enabled candidate.
    if rt_count(candidates) == 0:
        return 0 < rt_count(dv_find(actor.policy, "factor_constraints", []))
    let key = ["dvs_replay_has_available_candidate", actor.id, candidates, dv_has_key(actor, "question_ref"), dv_find(actor, "question_ref", false), dv_find(actor.policy, "topic_bindings", []), dv_find(actor, "heard_topics", [])]
    let cached = dvs_plan_cache_get(actor.mind, key)
    if cached[0]:
        return cached[1]
    var i = 0
    while i < rt_count(candidates):
        if dvs_replay_candidate_available(actor, candidates[i]):
            return dvs_plan_cache_put(actor.mind, key, true)
        i = i + 1
    return dvs_plan_cache_put(actor.mind, key, false)

fn dvs_manual_candidate_available(actor, candidate):
    return dvs_replay_candidate_available(actor, candidate) and dv_truth(actor.mind, dv_find(candidate, "manual_available_when", dv_true())) == "true"

fn dvs_manual_candidate(actor, id):
    let candidates = dv_find(actor.policy, "hypotheses", [])
    var i = 0
    while i < rt_count(candidates):
        let candidate = candidates[i]
        if candidate.id == id:
            if dvs_manual_candidate_available(actor, candidate):
                return candidate
            return false
        i = i + 1
    return false

fn dvs_replay_attempt_key(action):
    let id = dv_find(action, "replay_hypothesis_id", "")
    if id == "":
        return action.id
    return rt_json_stringify([action.id, id])

fn dvs_replay_input_signature(actor, action, refs):
    let original = dvp_input_signature(actor, action, refs)
    if dv_find(action, "replay_hypothesis_id", "") == "":
        return original
    return dv_with_many(original, {"hypothesis_id": action.replay_hypothesis_id, "subject_revision": actor.mind.revision})

fn dvs_manual_action(actor, selection):
    let input = dvs_manual_selection(selection)
    var action = dvp_find_action(actor.actions, input.action_id)
    dv_require(action != false, "Unknown player action")
    let hypothesis = dv_find(input, "hypothesis_id", "")
    if action.kind == "replay":
        dv_require(hypothesis != "", "Choose a hypothesis before replay")
        dv_require(dvs_manual_candidate(actor, hypothesis) != false, "Hypothesis is no longer available to this subject")
        action = dv_with(action, "replay_hypothesis_id", hypothesis)
    else:
        dv_require(hypothesis == "", "Hypotheses apply only to replay")
    return action

// Labels describe intent. Optional parts read only the acting subject's own fields.
// Result prose and speech are published by Complete, never offered as a label.
fn dvs_action_label(actor, action):
    var label = dv_find(action, "label", "（未记录标签）")
    let parts = dv_find(action, "label_parts", [])
    if 0 < rt_count(parts):
        label = ""
        var i = 0
        while i < rt_count(parts):
            let part = parts[i]
            var text = dv_find(part, "text", dv_find(part, "fallback", ""))
            if dv_has_key(part, "ref"):
                let value = dv_read(actor.mind, part.ref)
                if dv_uncontested(value) and rt_is_text(value.value):
                    text = value.value
            label = rt_cat(label, text)
            i = i + 1
    if label == "":
        return "（未记录标签）"
    return label

fn dvs_player_options(actor):
    if dv_find(actor, "scheduled_action", false) != false:
        return []
    var result = []
    let view = dv_with(actor, "manual_input", true)
    let refs = dvp_goal_refs(actor)
    var i = 0
    while i < rt_count(actor.actions):
        let action = actor.actions[i]
        if dvp_eligible(view, action, actor.mind, refs):
            let label = dvs_action_label(actor, action)
            if label != "":
                rt_push(result, {"id": action.id, "label": label, "available": true})
        i = i + 1
    return result

fn dvs_select_player(state, id):
    dv_require(dv_find(state, "awaiting_player", false), "Player input is not currently requested")
    let actor = state.actors[state.cursor]
    dv_require(dv_find(actor, "scheduled_action", false) == false, "Player already has a scheduled action")
    let action = dvs_manual_action(actor, id)
    let view = dv_with(actor, "manual_input", true)
    dv_require(dvp_eligible(view, action, actor.mind, dvp_goal_refs(actor)), "Player action is no longer available")
    return dvs_control_state(state, state.actors, state.events, state.cursor, dv_find(state, "player_actor", ""), id, false)

fn dvs_player_choice(actor, id):
    let action = dvs_manual_action(actor, id)
    let view = dv_with(actor, "manual_input", true)
    dv_require(dvp_eligible(view, action, actor.mind, dvp_goal_refs(actor)), "Player action failed subject admission")
    return {"action": action, "score": 0, "plan_expansions": 0, "plans": [], "relevant_refs": dvp_goal_refs(actor), "controller": "player"}

// Approximate production simulation. Declarations belong to campaign content;
// this kernel owns masks, cadence, bounded choice and the single entity lock.
fn dvs_simulation_open(story, world):
    let config = dv_find(story, "simulation", [])
    let identities = dv_find(config, "identities", [])
    var occupied = 0
    var names = []
    var i = 0
    while i < rt_count(identities):
        let identity = identities[i]
        let bit = dv_mask_bit(identity.index)
        dv_require(not dv_mask_has(occupied, identity.index) and not dv_has(names, identity.actor), "Simulation identity index or actor duplicated")
        occupied = occupied + bit
        names = dv_append(names, identity.actor)
        i = i + 1
    let time = dv_find(world, "time", 0)
    return dv_with(world, "simulation", {"version": "approximate-v1", "approximation": true, "config": config, "last_macro": rt_floor(time / 15) * 15, "last_nearby_second": -1, "visible_rooms": [], "nearby_rooms": [], "RealityFacts": [], "DemonEntityLock": false, "macro_count": 0, "nearby_count": 0, "daily_count": 0})

fn dvs_simulation_actor_index(actors, id):
    var i = 0
    while i < rt_count(actors):
        if actors[i].id == id:
            return i
        i = i + 1
    return -1

fn dvs_simulation_fact(facts, id):
    var i = 0
    while i < rt_count(facts):
        if facts[i].id == id:
            return facts[i]
        i = i + 1
    return false

fn dvs_simulation_facts(world, actors, bindings):
    let simulation = world.simulation
    let config = simulation.config
    let declarations = dv_find(config, "facts", [])
    let identities = dv_find(config, "identities", [])
    var facts = []
    var i = 0
    while i < rt_count(declarations):
        let declaration = declarations[i]
        let reality = dv_read(world, declaration.ref)
        var known = 0
        var j = 0
        while j < rt_count(identities):
            let identity = identities[j]
            let index = dvs_simulation_actor_index(actors, identity.actor)
            if index >= 0:
                let local = dv_local(bindings, declaration.ref.object, identity.actor)
                if local != "":
                    let cell = dv_read(actors[index].mind, dv_scoped_ref(identity.actor, local, declaration.ref.facet, declaration.ref.field))
                    let projected = dv_project_value(reality.value, bindings, identity.actor)
                    if dv_uncontested(reality) and dv_uncontested(cell) and projected.known and dv_same(projected.value, cell.value):
                        known = known + dv_mask_bit(identity.index)
            j = j + 1
        rt_push(facts, dv_reality_fact(declaration.id, declaration.ref, reality, known))
        i = i + 1
    return dv_with(world, "simulation", dv_with(simulation, "RealityFacts", facts))

fn dvs_simulation_danger(config, id):
    let dangers = dv_find(config, "dangers", [])
    var i = 0
    while i < rt_count(dangers):
        if dangers[i].id == id:
            return dangers[i]
        i = i + 1
    return false

fn dvs_simulation_lock(world, events):
    var simulation = world.simulation
    let config = simulation.config
    let demon = dv_find(config, "demon", false)
    if demon == false:
        return world
    var lock = simulation.DemonEntityLock
    if lock != false:
        let danger = dvs_simulation_danger(config, lock.danger)
        // Public knowledge does not end a continuing emergency. Only its
        // declared end condition releases the one physical entity.
        if danger == false or dv_truth(world, danger.when) == "false" or dv_truth(world, dv_find(demon, "release_when", dv_not(dv_true()))) == "true":
            dvs_event(events, "simulation_demon_released", demon.actor, world.time, [], {"lock": lock, "approximation": true})
            lock = false
    if lock == false:
        let dangers = dv_find(config, "dangers", [])
        var i = 0
        while i < rt_count(dangers) and lock == false:
            let danger = dangers[i]
            let fact = dvs_simulation_fact(simulation.RealityFacts, danger.fact_id)
            if fact != false and dv_truth(world, danger.when) == "true":
                let victims = dv_mask_without(dv_mask_and(danger.affected_mask, 65535), fact.KnownByMask)
                if victims != 0:
                    lock = {"actor": demon.actor, "danger": danger.id, "room": danger.room, "victims": victims, "acquired_at": world.time, "protecting": false}
                    dvs_event(events, "simulation_demon_reserved", demon.actor, world.time, [], {"lock": lock, "approximation": true, "movement": false})
            i = i + 1
    return dv_with(world, "simulation", dv_with(simulation, "DemonEntityLock", lock))

fn dvs_simulation_sync(state):
    if not dv_has_key(state.physical, "simulation"):
        return state
    var actors = state.actors
    var simulation = state.physical.simulation
    let latest_config = dv_find(state.story, "simulation", simulation.config)
    simulation = dv_with(simulation, "config", latest_config)
    state = dvs_owned_state_update(state, {"physical": dv_with(state.physical, "simulation", simulation)})
    let filters = dv_find(simulation.config, "filters", [])
    var i = 0
    while i < rt_count(actors):
        var actor = actors[i]
        var j = 0
        while j < rt_count(filters):
            if filters[j].actor == actor.id:
                actor = dv_with(actor, "mind", dv_with(actor.mind, "CognitionFilter", filters[j]))
            j = j + 1
        actor = dv_with(actor, "simulation_priority_action", "")
        var schedules = []
        if not dvs_simulation_onstage(actor, state):
            let declarations = dv_find(simulation.config, "offscreen_schedules", [])
            j = 0
            while j < rt_count(declarations):
                if declarations[j].actor == actor.id:
                    rt_push(schedules, declarations[j])
                j = j + 1
        actor = dv_with(actor, "policy", dv_with(actor.policy, "offscreen_schedules", schedules))
        if dv_find(actor, "simulation_decision_macro", -1) != simulation.macro_count:
            actor = dv_with(actor, "idle_guard", false)
        if dv_find(actor, "simulation_decision_nearby", -1) < simulation.last_nearby_second and dv_has_key(actor, "location_ref"):
            let position = dv_read(state.physical, actor.location_ref)
            if dv_uncontested(position) and dv_has(simulation.nearby_rooms, dvs_simulation_room(simulation.config, position.value)):
                actor = dv_with_many(actor, {"idle_guard": false, "decision_time": -1})
        actors = dvs_replace(actors, i, actor)
        i = i + 1
    var events = dv_clone(state.events)
    let world = dvs_simulation_lock(dvs_simulation_facts(state.physical, actors, state.bindings), events)
    let lock = world.simulation.DemonEntityLock
    let declared_demon = dv_find(world.simulation.config, "demon", false)
    if declared_demon != false:
        let owner_index = dvs_simulation_actor_index(actors, declared_demon.actor)
        if owner_index >= 0:
            actors = dvs_replace(actors, owner_index, dv_with(actors[owner_index], "simulation_entity_lock", lock))
    if lock != false:
        let demon = world.simulation.config.demon
        let index = dvs_simulation_actor_index(actors, demon.actor)
        if index >= 0:
            let location = dv_read(world, demon.location_ref)
            var requested = ""
            if dv_uncontested(location) and location.value == lock.room and dv_truth(world, dv_find(demon, "presence_when", dv_true())) == "true":
                if not lock.protecting:
                    requested = demon.protect_action_id
            else:
                let routes = dv_find(demon, "travel_actions", [])
                i = 0
                while i < rt_count(routes):
                    if routes[i].room == lock.room:
                        requested = routes[i].action_id
                    i = i + 1
            actors = dvs_replace(actors, index, dv_with(actors[index], "simulation_priority_action", requested))
    return dvs_owned_state_update(state, {"actors": actors, "physical": world, "events": events})

fn dvs_simulation_next_time(world, due):
    if dv_has_key(world, "simulation"):
        return dv_min(due, world.simulation.last_macro + 15)
    return due

fn dvs_simulation_room(config, location):
    let locations = dv_find(config, "locations", [])
    var i = 0
    while i < rt_count(locations):
        if locations[i].location == location:
            return locations[i].room
        i = i + 1
    return location

fn dvs_simulation_onstage(actor, state):
    if actor.id == dv_find(state, "player_actor", ""):
        return true
    if not dv_has_key(actor, "location_ref"):
        return false
    let position = dv_read(state.physical, actor.location_ref)
    if not dv_uncontested(position):
        return false
    if dv_has(state.physical.simulation.visible_rooms, dvs_simulation_room(state.physical.simulation.config, position.value)):
        return true
    let viewer = dv_find(state.story, "host_viewer", dv_find(state, "player_actor", ""))
    let index = dvs_simulation_actor_index(state.actors, viewer)
    if index >= 0 and dv_has_key(state.actors[index], "location_ref"):
        let viewing = dv_read(state.physical, state.actors[index].location_ref)
        return dv_uncontested(viewing) and viewing.value == position.value
    return false

fn dvs_simulation_actor_ready(actor, state):
    if not dv_has_key(state.physical, "simulation"):
        return true
    if dvs_simulation_onstage(actor, state) or dv_find(actor, "simulation_priority_action", "") != "":
        return true
    // Actual new knowledge or an unprocessed hearing wakes the owner without
    // waiting for the ambient offscreen cadence. An unchanged input still sleeps.
    if 0 < rt_count(dv_find(actor, "pending_heard", [])) or dv_find(actor, "decision_revision", -1) != actor.mind.revision:
        return true
    let simulation = state.physical.simulation
    if dv_find(actor, "simulation_decision_macro", -1) != simulation.macro_count:
        return true
    if dv_has_key(actor, "location_ref"):
        let position = dv_read(state.physical, actor.location_ref)
        if dv_uncontested(position) and dv_has(simulation.nearby_rooms, dvs_simulation_room(simulation.config, position.value)):
            return dv_find(actor, "simulation_decision_nearby", -1) < simulation.last_nearby_second
    return false

// Sims 4-style commodity + implicit habit evaluation strictly over the actor's
// own subjective mind (Dual-Layer Cognition: never reads physical reality).
fn dvs_sims_autonomy_score(actor, action):
    let profile = dv_find(actor.policy, "sims_autonomy", false)
    if profile == false:
        return 0
    var bonus = 0
    var room = ""
    if dv_has_key(actor, "location_ref"):
        let pos = dv_read(actor.mind, actor.location_ref)
        if dv_uncontested(pos) and rt_is_text(pos.value):
            room = pos.value
    let habits = dv_find(profile, "implicit_habits", [])
    var i = 0
    while i < rt_count(habits):
        let habit = habits[i]
        if dv_find(habit, "trigger", "") == room and dv_find(habit, "kind", "") == action.kind:
            bonus = bonus + dv_find(habit, "bonus", 0)
        i = i + 1
    let weights = dv_find(profile, "autonomy_weights", [])
    if action.kind == "inspect":
        bonus = bonus + 0.05 * dv_find(weights, "cognition", 1)
    if action.kind == "talk":
        bonus = bonus + 0.05 * dv_find(weights, "social", 1)
    if action.kind == "help":
        bonus = bonus + 0.05 * dv_find(weights, "safety", 1)
    return bonus

fn dvs_pending_achieve_goals(actor):
    var goals = dv_find(actor.policy, "goals", [])
    var result = []
    var i = 0
    while i < rt_count(goals):
        let goal = goals[i]
        if dv_find(goal, "kind", "") == "achieve" and dvp_topic(actor, goal) and dv_truth(actor.mind, dv_find(goal, "available_when", dv_true())) == "true" and dv_truth(actor.mind, goal.proposition) != "true":
            rt_push(result, goal)
        i = i + 1
    return result

// Read-only route qualification substitutes only the declared origin room.
// All remaining guards are evaluated in this subject's current mind.
fn dvs_navigation_guard(condition, location, room):
    let op = dv_find(condition, "op", "")
    if op == "equals" and dv_same(dv_find(condition, "ref", false), location):
        if dv_find(condition, "value", "") == room:
            return dv_true()
        return dv_not(dv_true())
    if op == "not":
        return dv_not(dvs_navigation_guard(condition.item, location, room))
    if op == "all":
        var items = []
        var i = 0
        while i < rt_count(condition.items):
            rt_push(items, dvs_navigation_guard(condition.items[i], location, room))
            i = i + 1
        return dv_all(items)
    return condition

fn dvs_navigation_distance(actor, origin, target):
    if origin == target:
        return 0
    let key = ["declared-navigation-distance-v1", actor.actions, actor.location_ref, origin, target]
    let cached = dvs_plan_cache_get(actor.mind, key)
    if cached[0]:
        return cached[1]
    var rooms = [origin]
    var distances = [0]
    var cursor = 0
    while cursor < rt_count(rooms):
        let room = rooms[cursor]
        var i = 0
        while i < rt_count(actor.actions):
            let edge = actor.actions[i]
            if edge.kind == "move" and dv_has_key(edge, "travel") and edge.travel.from == room and edge.travel.to != room and 0 < rt_count(dv_find(edge, "source_refs", [])):
                let guard = dvs_navigation_guard(edge.precondition, actor.location_ref, room)
                if dv_truth(actor.mind, guard) == "true" and not dv_has(rooms, edge.travel.to):
                    let distance = distances[cursor] + 1
                    if edge.travel.to == target:
                        return dvs_plan_cache_put(actor.mind, key, distance)
                    rt_push(rooms, edge.travel.to)
                    rt_push(distances, distance)
            i = i + 1
        cursor = cursor + 1
    return dvs_plan_cache_put(actor.mind, key, -1)

fn dvs_goal_navigation_score(actor, action, pending_achieve):
    if action.kind != "move" or not dv_has_key(action, "travel") or not dv_has_key(actor, "location_ref"):
        return 0
    if rt_count(dv_find(action, "source_refs", [])) == 0:
        return 0
    var target_rooms = []
    var i = 0
    while i < rt_count(pending_achieve):
        let room = dvp_extract_required_room(pending_achieve[i].proposition, actor.location_ref)
        if room != "" and not dv_has(target_rooms, room):
            rt_push(target_rooms, room)
        i = i + 1
    let actions = dv_find(actor, "actions", [])
    i = 0
    while i < rt_count(actions):
        let other = actions[i]
        if other.kind != "move" and (dvp_communication_progress(actor, other) or 0 < dvp_achievement_pending_work(actor, other, pending_achieve).value or (dv_has_key(other, "response_topic") and 0 < rt_count(dvs_pending_request(actor, other)))):
            let req_room = dvp_extract_required_room(other.precondition, actor.location_ref)
            if req_room != "" and not dv_has(target_rooms, req_room):
                // Bind only the declared own-location selector for a routing
                // question. All other current admission rules are unchanged:
                // spent methods, actual requests and personal constraints still
                // pass through the one eligibility entry, not a second policy.
                let guarded = dv_with(other, "precondition", dvs_navigation_guard(other.precondition, actor.location_ref, req_room))
                if dvp_eligible(actor, guarded, actor.mind, dvp_goal_refs(actor)):
                    rt_push(target_rooms, req_room)
        i = i + 1
    if rt_count(target_rooms) == 0:
        return 0
    let position = dv_read(actor.mind, actor.location_ref)
    if not dv_uncontested(position) or position.value != action.travel.from:
        return 0
    let dest = action.travel.to
    var score = 0
    i = 0
    while i < rt_count(target_rooms):
        let before = dvs_navigation_distance(actor, position.value, target_rooms[i])
        let after = dvs_navigation_distance(actor, dest, target_rooms[i])
        if before > 0 and after >= 0 and after < before:
            var progress = 1.25
            if after == 0:
                progress = 1.5
            score = dv_max(score, progress)
        i = i + 1
    return score

// Selection and explicit observer scoring share this exact current-state value.
// The result contains no hypothetical successor, listener state or search reward.
fn dvs_current_action_score(actor, action, bindings, relevant, actual):
    let declared = dv_find(action, "simulation_utility", 0)
    var information = 0
    let scope = dvp_scope(actor, action, bindings)
    var i = 0
    while i < rt_count(scope):
        if not dv_uncontested(dv_read(actor.mind, scope[i])) and dv_has(relevant, scope[i]):
            information = information + dv_find(actor.policy, "information_weight", 1)
        i = i + 1
    let private = dvp_private_execution_utility(actor, action, actor.mind)
    let owner = dvp_owner_utility(actor, action, actor.mind).value
    let pending_achieve = dvs_pending_achieve_goals(actor)
    let achieve_work = dvp_achievement_pending_work(actor, action, pending_achieve).value * 2
    var comm_work = 0
    if dvp_communication_progress(actor, action):
        comm_work = 2
    // A move that already completes a declared achievement receives that value
    // once. Route shaping belongs to intermediate steps toward an unmet goal.
    var nav_work = 0
    if achieve_work == 0:
        nav_work = dvs_goal_navigation_score(actor, action, pending_achieve)
    var personal = 0
    if dv_has_key(action, "personal_choice"):
        personal = dvp_personal_motivation(actor, action)
    var answer = 0
    if dv_has_key(action, "answer"):
        answer = dvp_answer_reward(actor, action, actor.mind)
    var response = 0
    if dv_has_key(action, "response_topic") and 0 < rt_count(dvs_pending_request(actor, action)):
        response = 2
    // Exploration uses only the owner's declared movement and actual history.
    // It predicts neither destination contents nor a future observation.
    var exploration = 0
    // A purposeful route already has navigation value. Do not double-reward
    // its novelty above an immediately executable declared achievement.
    if action.kind == "move" and dv_has_key(action, "travel") and nav_work == 0 and not dv_has(dv_find(actor, "completed_actions", []), action.id):
        if not dv_has(dv_find(actor, "visited_locations", []), action.travel.to):
            exploration = dv_find(actor.policy, "exploration_utility", 1)
    let time = dv_find(actor, "decision_time", actor.mind.time)
    let daytime = time - rt_floor(time / 1440) * 1440
    let schedules = dv_find(actor.policy, "offscreen_schedules", [])
    var schedule_value = 0
    i = 0
    while i < rt_count(schedules):
        let schedule = schedules[i]
        if schedule.action_id == action.id and schedule.from <= daytime and daytime < schedule.to:
            schedule_value = schedule_value + schedule.utility
        i = i + 1
    let sims_autonomy = dvs_sims_autonomy_score(actor, action)
    let sims_effective = sims_autonomy * dv_find(actor.policy, "sims_autonomy_scale", 0)
    let progress = declared + private + owner + achieve_work + comm_work + nav_work + personal + answer + response + exploration + schedule_value + sims_effective
    let value = information + progress
    let penalty = actual.time * dv_find(actor.policy, "time_cost", 0.01)
    return {"action_value": value, "information_component": information, "progress_component": progress, "time_penalty": penalty, "total": value - penalty, "components": {"declared": declared, "private": private, "owner": owner, "achieve": achieve_work, "communicate": comm_work, "navigate": nav_work, "personal": personal, "answer": answer, "response": response, "exploration": exploration, "schedule": schedule_value, "sims_autonomy": sims_autonomy}, "scope": "subject-current-immediate", "formula": "action_value - time_penalty", "strategy": "approximate-v1", "approximation": true}

fn dvs_simulation_room_index(rooms, id):
    var i = 0
    while i < rt_count(rooms):
        if rooms[i].id == id:
            return i
        i = i + 1
    return -1

fn dvs_simulation_diffuse(world, config, events, parent, time):
    let rooms = dv_find(config, "rooms", [])
    let edges = dv_find(config, "edges", [])
    var amounts = []
    var concentrations = []
    var outgoing = []
    var boundaries = []
    var i = 0
    while i < rt_count(rooms):
        let room = rooms[i]
        let concentration = dv_read(world, room.concentration_ref)
        let volume = dv_find(room, "volume", 1)
        dv_require(dv_uncontested(concentration) and 0 <= concentration.value and 0 < volume, "Diffusion requires known nonnegative concentration and positive volume")
        dv_unit(dv_find(room, "settling", 0))
        var boundary = -1
        let conditions = dv_find(room, "boundaries", [])
        var c = 0
        while c < rt_count(conditions):
            if dv_truth(world, conditions[c].when) == "true":
                boundary = conditions[c].value
            c = c + 1
        var current = concentration.value
        if 0 <= boundary:
            current = boundary
        rt_push(boundaries, boundary)
        rt_push(amounts, current * volume)
        rt_push(concentrations, current)
        rt_push(outgoing, 0)
        i = i + 1
    var flows = []
    i = 0
    while i < rt_count(edges):
        let edge = edges[i]
        let a = dvs_simulation_room_index(rooms, edge.from)
        let b = dvs_simulation_room_index(rooms, edge.to)
        dv_require(a >= 0 and b >= 0 and a != b, "Diffusion edge references invalid rooms")
        var opening = dv_find(edge, "opening", 0)
        if dv_has_key(edge, "open_when"):
            if dv_truth(world, edge.open_when) == "true":
                opening = dv_find(edge, "open_value", 1)
            else:
                opening = dv_find(edge, "closed_value", 0)
        if dv_has_key(edge, "opening_ref"):
            let gate = dv_read(world, edge.opening_ref)
            dv_require(dv_uncontested(gate), "Diffusion opening is unknown")
            opening = gate.value
        dv_unit(opening)
        let conductance = dv_find(edge, "conductance", 0)
        var wind = dv_find(edge, "wind", 0)
        if dv_has_key(edge, "wind_when") and dv_truth(world, edge.wind_when) != "true":
            wind = 0
        let downward = dv_find(edge, "downward", 0)
        dv_require(0 <= conductance and -1 <= wind and wind <= 1 and 0 <= downward, "Invalid diffusion transport coefficient")
        let height = rooms[a].height - rooms[b].height
        let down_a = dv_max(0, height) * downward
        let down_b = dv_max(0, 0 - height) * downward
        let raw = opening * conductance * ((concentrations[a] - concentrations[b]) + dv_max(0, wind) * concentrations[a] - dv_max(0, 0 - wind) * concentrations[b] + down_a * concentrations[a] - down_b * concentrations[b])
        var source = a
        var target = b
        var amount = raw
        if raw < 0:
            source = b
            target = a
            amount = 0 - raw
        outgoing = dvs_replace(outgoing, source, outgoing[source] + amount)
        rt_push(flows, {"source": source, "target": target, "amount": amount})
        i = i + 1
    // Compute every edge from the same old concentration, then proportionally
    // cap total source outflow. This conserves transported mass without negatives.
    var next = dv_clone(amounts)
    i = 0
    while i < rt_count(flows):
        let flow = flows[i]
        var scale = 1
        if amounts[flow.source] < outgoing[flow.source]:
            scale = amounts[flow.source] / outgoing[flow.source]
        let amount = flow.amount * scale
        next = dvs_replace(next, flow.source, next[flow.source] - amount)
        next = dvs_replace(next, flow.target, next[flow.target] + amount)
        i = i + 1
    var changes = []
    var concentrations_changed = false
    i = 0
    while i < rt_count(rooms):
        let room = rooms[i]
        let settled = dv_max(0, next[i]) * (1 - dv_find(room, "settling", 0))
        var value = settled / dv_find(room, "volume", 1)
        if 0 <= boundaries[i]:
            value = boundaries[i]
        let previous = dv_read(world, room.concentration_ref).value
        let boundary_exchange = (concentrations[i] - previous) * dv_find(room, "volume", 1) + value * dv_find(room, "volume", 1) - settled
        if value != previous:
            world = dv_store(world, room.concentration_ref, dv_cell(value, 1, time, [parent]))
            concentrations_changed = true
        if value != previous or boundary_exchange != 0 or dv_max(0, next[i]) != settled:
            rt_push(changes, {"room": room.id, "before": previous, "after": value, "boundary_exchange": boundary_exchange, "settled_mass": dv_max(0, next[i]) - settled})
        i = i + 1
    if concentrations_changed:
        world = dv_with(world, "revision", world.revision + 1)
    dvs_event(events, "simulation_macro", "", time, [parent], {"changes": changes, "period_minutes": 15, "approximation": true, "model": "synchronous-room-graph", "precision_certificate": false})
    return world

// A settlement is a small declared linear calculation over one authoritative
// snapshot. Bind every input into the premise, then use the ordinary adopted
// law evaluator; unknown inputs never become zero or a successful settlement.
fn dvs_simulation_calculated_rule(world, rule, time):
    var premise = [dv_find(rule, "when", dv_true())]
    var effects = dv_clone(dv_find(rule, "effects", []))
    let calculations = dv_find(rule, "calculations", [])
    var i = 0
    while i < rt_count(calculations):
        let calculation = calculations[i]
        var value = dv_find(calculation, "constant", 0)
        if dv_find(calculation, "clock", false):
            value = time
        if dv_has_key(calculation, "modulo"):
            dv_require(0 < calculation.modulo, "Settlement modulus must be positive")
            value = value - rt_floor(value / calculation.modulo) * calculation.modulo
        let terms = dv_find(calculation, "terms", [])
        var j = 0
        while j < rt_count(terms):
            let term = terms[j]
            let when = dv_find(term, "when", dv_true())
            let truth = dv_truth(world, when)
            if truth != "true" and truth != "false":
                return {"ready": false, "reason": "unknown-term-condition", "ref": calculation.ref}
            if truth == "true":
                rt_push(premise, when)
                if dv_has_key(term, "ref"):
                    let cell = dv_read(world, term.ref)
                    if not dv_uncontested(cell) or not rt_is_numeric_value(cell.value):
                        return {"ready": false, "reason": "unknown-numeric-input", "ref": term.ref}
                    rt_push(premise, dv_fact(term.ref, cell.value))
                    value = value + cell.value * dv_find(term, "factor", 1)
                else:
                    value = value + term.constant
            else:
                rt_push(premise, dv_not(when))
            j = j + 1
        if dv_has_key(calculation, "minimum"):
            value = dv_max(calculation.minimum, value)
        if dv_has_key(calculation, "maximum"):
            value = dv_min(calculation.maximum, value)
        rt_push(effects, {"op": dv_find(calculation, "op", "assign"), "ref": calculation.ref, "value": value})
        i = i + 1
    return {"ready": true, "law": dv_axiom(rule.law, 1, dv_all(premise), effects)}

fn dvs_simulation_execute_rule(world, rule, events, parent, time, kind):
    if dv_truth(world, dv_find(rule, "when", dv_true())) != "true":
        return world
    if dv_has_key(rule, "calculations"):
        let calculated = dvs_simulation_calculated_rule(world, rule, time)
        if not calculated.ready:
            dvs_event(events, kind, "", time, [parent], {"id": rule.id, "status": "unresolved-input", "detail": calculated, "approximation": true})
            return world
        let basis = dv_find(rule, "basis", [parent])
        if dv_has_key(world.adoptions, rule.law):
            let previous = dv_get(world.adoptions, rule.law)
            // Repeated zero-dose or unchanged safety rules still execute and
            // record their receipt, but do not invent a fresh adoption history.
            if not previous.active or previous.mode != "enforce" or previous.confidence != 1 or not dv_same(previous.law, calculated.law) or not dv_same(previous.basis, basis):
                world = dv_reconsider(world, calculated.law, "enforce", 1, basis)
        else:
            world = dv_adopt(world, calculated.law, "enforce", 1, basis)
    let execution = dv_execute(world, rule.law, rt_cat(kind, rt_cat("-", rt_show(rt_count(events)))), time, world.revision)
    dvs_event(events, kind, "", time, [parent], {"id": rule.id, "category": dv_find(rule, "category", ""), "execution": dv_without(execution, "world"), "approximation": true})
    return execution.world

fn dvs_simulation_daily(world, config, events, parent, time):
    let rules = dv_find(config, "daily_rules", [])
    let daytime = time - rt_floor(time / 1440) * 1440
    var i = 0
    while i < rt_count(rules):
        let rule = rules[i]
        dv_require(rule.at == 360 or rule.at == 1080, "Daily rules must use 06:00 or 18:00")
        if rule.at == daytime:
            world = dvs_simulation_execute_rule(world, rule, events, parent, time, "simulation_daily")
            world = dv_with(world, "simulation", dv_with(world.simulation, "daily_count", world.simulation.daily_count + 1))
        i = i + 1
    return world

fn dvs_simulation_unmanaged_processes(world, processes):
    if not dv_has_key(world, "simulation"):
        return processes
    var daily = dv_clone(dv_find(world.simulation.config, "daily_rules", []))
    let macro = dv_find(world.simulation.config, "macro_rules", [])
    var m = 0
    while m < rt_count(macro):
        rt_push(daily, macro[m])
        m = m + 1
    if rt_count(daily) == 0:
        return processes
    var result = []
    var i = 0
    while i < rt_count(processes):
        var managed = false
        var j = 0
        while j < rt_count(daily):
            if daily[j].law == processes[i].law:
                managed = true
            j = j + 1
        if not managed:
            rt_push(result, processes[i])
        i = i + 1
    return result

fn dvs_simulation_environment(world, story, events, parent):
    if not dv_has_key(world, "simulation"):
        return world
    let time = world.time
    let config = world.simulation.config
    var next = world.simulation.last_macro + 15
    while next <= time:
        world = dv_with(world, "time", next)
        let clock = dv_find(story, "clock_ref", false)
        if clock != false:
            world = dv_store(world, clock, dv_cell(next, 1, next, [parent]))
        let macro_rules = dv_find(config, "macro_rules", [])
        var m = 0
        while m < rt_count(macro_rules):
            if dv_find(macro_rules[m], "before_diffusion", false):
                world = dvs_simulation_execute_rule(world, macro_rules[m], events, parent, next, "simulation_environment_effect")
            m = m + 1
        world = dvs_simulation_diffuse(world, config, events, parent, next)
        m = 0
        while m < rt_count(macro_rules):
            if not dv_find(macro_rules[m], "before_diffusion", false):
                world = dvs_simulation_execute_rule(world, macro_rules[m], events, parent, next, "simulation_environment_effect")
            m = m + 1
        world = dvs_simulation_daily(world, config, events, parent, next)
        world = dv_with(world, "simulation", dv_with_many(world.simulation, {"last_macro": next, "macro_count": world.simulation.macro_count + 1}))
        next = next + 15
    return dv_with(world, "time", time)

fn dvs_session_complete(state, receipt):
    let pending = state.pending
    let original_mind = pending.actor.mind
    let previous_successes = rt_count(dv_find(pending.actor, "completed_actions", []))
    var result = dvs_session_complete_commit(state, receipt)
    var actors = result.actors
    var actor = actors[pending.index]
    if dv_find(dv_find(original_mind, "CognitionFilter", []), "anterograde", false):
        // Body, accounting, successful world effects and other witnesses remain;
        // this subject does not acquire a memory from its own completion.
        actor = dv_with(actor, "mind", original_mind)
        actors = dvs_replace(actors, pending.index, actor)
    result = dvs_owned_state_update(result, {"actors": actors})
    if rt_count(dv_find(actor, "completed_actions", [])) > previous_successes:
        result = dvs_simulation_protect_complete(result, pending)
    return dvs_simulation_sync(result)

fn dvs_simulation_protect_complete(state, pending):
    if not dv_has_key(state.physical, "simulation"):
        return state
    var world = state.physical
    let lock = world.simulation.DemonEntityLock
    let demon = dv_find(world.simulation.config, "demon", false)
    if lock == false or demon == false or pending.id != demon.actor or pending.action.id != demon.protect_action_id:
        return state
    let location = dv_read(world, demon.location_ref)
    if not dv_uncontested(location) or location.value != lock.room:
        return state
    let danger = dvs_simulation_danger(world.simulation.config, lock.danger)
    if danger == false or dv_truth(world, danger.when) != "true":
        return state
    let fact = dvs_simulation_fact(world.simulation.RealityFacts, danger.fact_id)
    if fact == false:
        return state
    var actors = state.actors
    var events = dv_clone(state.events)
    let event = dvs_event(events, "simulation_demon_protection", demon.actor, world.time, [], {"danger": danger.id, "room": lock.room, "action_event": pending.action_event, "approximation": true})
    var i = 0
    while i < rt_count(actors):
        var actor = actors[i]
        if dv_has_key(actor, "location_ref"):
            let position = dv_read(world, actor.location_ref)
            if dv_uncontested(position) and position.value == lock.room and dvs_auditory_access(actor, world):
                let observations = dv_cognition_observations(actor.mind, dv_perceive(world, actor.mind, state.bindings, [fact.ref], event, world.time))
                actor = dv_with(actor, "mind", dv_update_mind(actor.mind, observations, actor.mind.revision, dvs_observation_profile(actor)).world)
                if 0 < rt_count(observations):
                    dvs_event(events, "simulation_public_warning", actor.id, world.time, [event], {"observations": observations, "danger": danger.id, "source": demon.actor})
                actors = dvs_replace(actors, i, actor)
        i = i + 1
    world = dv_with(world, "simulation", dv_with(world.simulation, "DemonEntityLock", dv_with(lock, "protecting", true)))
    return dvs_owned_state_update(state, {"actors": actors, "physical": world, "events": events})

// Host-only 1 Hz boundary: seconds are monotonic host time, never game minutes.
// Frame physics remains in the host. This call does not settle pending actions.
fn dvs_simulation_pulse(state, seconds, visible_rooms):
    dv_require(0 <= seconds, "Negative host simulation clock")
    if not dv_has_key(state.physical, "simulation"):
        return state
    var simulation = state.physical.simulation
    let tick = rt_floor(seconds)
    dv_require(simulation.last_nearby_second <= tick, "Host simulation clock moved backwards")
    if simulation.last_nearby_second == tick:
        return state
    var mapped = []
    var v = 0
    while v < rt_count(visible_rooms):
        let room = dvs_simulation_room(simulation.config, visible_rooms[v])
        if not dv_has(mapped, room):
            rt_push(mapped, room)
        v = v + 1
    visible_rooms = mapped
    var nearby = visible_rooms
    let edges = dv_find(simulation.config, "edges", [])
    var i = 0
    while i < rt_count(edges):
        let edge = edges[i]
        if dv_has(visible_rooms, edge.from) and not dv_has(nearby, edge.to):
            nearby = dv_append(nearby, edge.to)
        if dv_has(visible_rooms, edge.to) and not dv_has(nearby, edge.from):
            nearby = dv_append(nearby, edge.from)
        i = i + 1
    let changed = not dv_same(simulation.visible_rooms, visible_rooms) or not dv_same(simulation.nearby_rooms, nearby)
    simulation = dv_with_many(simulation, {"last_nearby_second": tick, "visible_rooms": visible_rooms, "nearby_rooms": nearby, "nearby_count": simulation.nearby_count + 1})
    var events = dv_clone(state.events)
    if changed:
        dvs_event(events, "simulation_nearby_scope", "", state.physical.time, [], {"host_second": tick, "rooms": nearby, "approximation": true})
    return dvs_simulation_sync(dvs_owned_state_update(state, {"physical": dv_with(state.physical, "simulation", simulation), "events": events, "idle": 0}))
