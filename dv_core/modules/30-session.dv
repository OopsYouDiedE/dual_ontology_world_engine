#include 20-core.dv

// Named reuse groups preserve the original memo keys and computations.
// Off returns a miss and never populates that group's memo partitions.
fn dvs_plan_cache_get(owner, key):
    if not rt_memo_group_enabled("plan"):
        return [false, false]
    return rt_memo_get(owner, key)

fn dvs_plan_cache_put(owner, key, value):
    if rt_memo_group_enabled("plan"):
        return rt_memo_put(owner, key, value)
    return value

fn dvs_declaration_cache_get(owner, key):
    if not rt_memo_group_enabled("declaration"):
        return [false, false]
    return rt_memo_get(owner, key)

fn dvs_declaration_cache_put(owner, key, value):
    if rt_memo_group_enabled("declaration"):
        return rt_memo_put(owner, key, value)
    return value

// The selector receives only one actor snapshot. No authority or oracle argument.

fn dvs_event(events, kind, actor, time, parents, data):
    var id = rt_cat("e", rt_show(rt_count(events)))
    let frozen_event = rt_snapshot({"id": id, "type": kind, "actor": actor, "time": time, "parents": parents, "data": dvs_event_storage(kind, data)})
    rt_raw_event(frozen_event)
    rt_push(events, frozen_event)
    return id

// Keep the historical states consumed by actual factor proofs. All other full
// before/after payloads are audit-only; IDs, receipts and observations are intact.
fn dvs_event_storage(kind, data):
    if rt_audit_mode():
        return data
    var keep = []
    if kind == "inference":
        keep = ["mind_before", "mind_after"]
    if kind == "observation" or kind == "listener_parse":
        keep = ["mind_after"]
    if kind == "factor_prune":
        keep = ["actor_before"]
    var result = []
    var index = 0
    while index < rt_count(data):
        let entry = data[index]
        if not dv_has(["mind_before", "mind_after", "physical_before", "physical_after", "actor_before", "actor_after"], entry[0]) or dv_has(keep, entry[0]):
            if kind == "action_execution" and entry[0] == "receipt":
                // Ordinary play retains settlement, changes and source identity.
                // The nested execution world otherwise keeps every physical
                // history prefix alive despite removing physical_before/after.
                let execution = entry[1].execution
                let world = execution.world
                let reference = rt_raw_ref(world)
                if reference != false:
                    // This is an actual prior DAG node, not a summary standing in
                    // for missing evidence. Without a recorder keep the full value.
                    let cut = {"world": world.id, "revision": world.revision, "time": dv_find(world, "time", 0), "raw_ref": reference, "storage": "raw-dag-world-reference"}
                    let compact = dv_with(dv_without(execution, "world"), "world_cut", cut)
                    rt_push(result, dv_pair("receipt", dv_with(entry[1], "execution", compact)))
                else:
                    rt_push(result, entry)
            else:
                rt_push(result, entry)
        index = index + 1
    return result

fn dvs_find_event_by_id(events, id):
    events = rt_snapshot(events)
    if (rt_length(id) > 1 and rt_chr(id, 0) == "e"):
        let num_str = rt_slice(id, 1, rt_length(id) - 1)
        if rt_is_number(num_str):
            let idx = rt_number(num_str)
            if (0 <= idx and idx < rt_count(events)):
                let candidate = events[idx]
                if (candidate.id == id):
                    return candidate
    var i = rt_count(events) - 1
    while (i >= 0):
        let event = events[i]
        if (event.id == id):
            return event
        i = i - 1
    return false

fn dvs_cognitive_parents(actor, parents):
    var previous = dv_find(actor, "last_cognitive_event", "")
    if (previous == ""):
        return parents
    else:
        return dv_explanation_merge(parents, dv_single(previous))

fn dvs_reason_cell(cell):
    return dv_without(cell, "time")

fn dvs_reason_value(cell):
    return {"known": cell.known, "value": cell.value, "confidence": cell.confidence, "conflicted": cell.conflicted}

fn dvs_reason_premises(mind, proposition):
    var op = proposition.op
    if op == "held_for":
        // Duration depends on both the value's last write and the explicit
        // clock. Ordinary value-only inference signatures still omit time.
        return {"proposition": proposition, "support": dv_read(mind, proposition.ref), "clock": dv_read(mind, proposition.clock)}
    if (op == "constant"):
        return proposition
    else:
        if (op == "not"):
            return dvs_reason_premises(mind, proposition.item)
        else:
            if (op == "all"):
                var items = proposition.items
                var result = []
                var i = 0
                while (i < rt_count(items)):
                    rt_push(result, dvs_reason_premises(mind, items[i]))
                    i = (i + 1)
                return result
            else:
                return {"proposition": proposition, "support": dvs_reason_cell(dv_read(mind, proposition.ref))}

fn dvs_reason_signature(mind, adoption):
    var law = adoption.law
    var effects = adoption.law.effects
    var outputs = []
    var i = 0
    while (i < rt_count(effects)):
        var cell = dv_read(mind, effects[i].ref)
        rt_push(outputs, {"known": cell.known, "value": cell.value, "confidence": cell.confidence, "conflicted": cell.conflicted})
        i = (i + 1)
    return dv_with({"law": law, "confidence": adoption.confidence, "basis": adoption.basis, "premises": dvs_reason_premises(mind, law.premise)}, "outputs", outputs)

fn dvs_reason_changes(changes):
    var i = 0
    var changed = false
    while (i < rt_count(changes)):
        var change = changes[i]
        if dv_same(dvs_reason_value(change.before), dvs_reason_value(change.after)):
            false
        else:
            changed = true
        i = (i + 1)
    return changed

fn dvs_reason_monotone_satisfied(mind, effects):
    var e = 0
    let n = rt_count(effects)
    while e < n:
        let eff = effects[e]
        if dv_find(eff, "op", "") != "assign":
            return false
        let cell = dv_read(mind, eff.ref)
        if not cell.known or cell.value != eff.value or cell.confidence < 1:
            return false
        e = e + 1
    return true

// Static declaration dependency extraction: unsupported operators fail closed.
// Memo entries are owned by the immutable condition, not by a mutable world.
fn dvs_dirty_refs(condition):
    let cached = rt_memo_get(condition, ["dirty-declaration-refs-v1"])
    if cached[0]:
        return cached[1]
    let op = condition.op
    var refs = []
    if op == "held_for":
        let declared = dv_condition_inputs(condition)
        dv_require(declared.complete, "Invalid held-for dependency declaration")
        return rt_memo_put(condition, ["dirty-declaration-refs-v1"], declared.reads)
    if op == "equals" or op == "at_least":
        rt_push(refs, condition.ref)
    else:
        if op == "not":
            refs = dvs_dirty_refs(condition.item)
        else:
            if op == "all":
                var i = 0
                while i < rt_count(condition.items):
                    refs = dvp_merge_refs(refs, dvs_dirty_refs(condition.items[i]))
                    i = i + 1
            else:
                dv_require(op == "constant", rt_cat("Unindexed condition operator: ", op))
    return rt_memo_put(condition, ["dirty-declaration-refs-v1"], refs)

fn dvs_dirty_inputs(world, refs):
    var result = [world.subject]
    var i = 0
    while i < rt_count(refs):
        // Full cells include unknown/conflict, provenance and confidence changes.
        rt_push(result, [dv_has_key(world.objects, refs[i].object), dv_read(world, refs[i])])
        i = i + 1
    return result

fn dvs_dirty_truth(world, condition, config, name):
    if not dv_find(config, "opt_dirty", false):
        return dv_truth(world, condition)
    condition = rt_snapshot(condition)
    let inputs = dvs_dirty_inputs(world, dvs_dirty_refs(condition))
    let key = ["dirty-truth-last-v1", world.subject]
    let cached = rt_memo_get(condition, key)
    var calls = 1
    if cached[0]:
        calls = cached[1].calls + 1
        if dv_same(inputs, cached[1].inputs):
            let every = dv_find(config, "opt_dirty_verify", 0)
            if 0 < every and calls >= every:
                dv_require(dv_same(cached[1].truth, dv_truth_uncached(world, condition)), rt_cat("Dirty dependency mismatch: ", name))
                calls = 0
            rt_memo_put(condition, key, dv_with(cached[1], "calls", calls))
            return cached[1].truth
    let truth = dv_truth(world, condition)
    rt_memo_put(condition, key, {"inputs": inputs, "truth": truth, "calls": calls})
    return truth

// No-effect world processes need not stage again until one of their complete
// premise/output dependencies changes. Increment outputs are dependencies too.
fn dvs_dirty_reason_index(actor):
    let mind = actor.mind
    let adoptions = rt_snapshot(mind.adoptions)
    let key = ["dirty-reason-index-v2", mind.subject, dv_find(actor, "inference_signatures", []), dv_find(mind, "profile", [])]
    let cached = rt_memo_get(adoptions, key)
    if cached[0]:
        return cached[1]
    var result = []
    var i = 0
    while i < rt_count(adoptions):
        let entry = adoptions[i]
        var refs = []
        // Keep original positions without interpreting unrelated declarations.
        if entry[1].active and entry[1].mode == "infer":
            let law = entry[1].law
            refs = dvs_dirty_refs(law.premise)
            var j = 0
            while j < rt_count(law.effects):
                let effect = law.effects[j]
                dv_require(effect.op == "assign" or effect.op == "increment", rt_cat("Unindexed inference effect: ", effect.op))
                refs = dvp_merge_refs(refs, [effect.ref])
                j = j + 1
            j = 0
            while j < rt_count(refs):
                let subject = dv_find(refs[j], "subject", "")
                dv_require(subject == "" or subject == mind.subject, "Cross-subject reference access")
                j = j + 1
        rt_push(result, {"law": entry[0], "refs": refs})
        i = i + 1
    return rt_memo_put(adoptions, key, rt_snapshot(result))

fn dvs_dirty_verify_reason(mind, adoptions, signatures, first, until, time):
    var i = first
    while i < until:
        let entry = adoptions[i]
        let law = entry[1].law
        if entry[1].active and entry[1].mode == "infer":
            var skip = false
            if dv_find(signatures, entry[0], false) != false and dvs_reason_monotone_satisfied(mind, law.effects):
                skip = true
            if not skip and dv_truth_uncached(mind, law.premise) == "true":
                let signature = dvs_reason_signature(mind, entry[1])
                if not dv_same(dv_find(signatures, entry[0], false), signature):
                    let stage = dv_stage(mind, law.effects, time, entry[1].basis, entry[1].confidence)
                    // Alternative-basis receipts also consume budget and emit an
                    // event. Therefore every ready stage must have been queued.
                    dv_require(stage.status != "ready", rt_cat("Dirty inference omitted rule: ", law.name))
        i = i + 1
    return true

fn dvs_reason_run(actor, events, time, parent):
    var mind = actor.mind
    var policy = actor.policy
    var budget = dv_find(policy, "reason_budget", 0)
    var count = 0
    var changed = false
    var signatures = dv_find(actor, "inference_signatures", [])
    var derivations = dv_find(actor, "inference_derivations", [])
    let dirty = dv_find(policy, "opt_dirty", false)
    var dependency_index = []
    var verify = false
    if dirty and 0 < budget:
        dependency_index = dvs_dirty_reason_index(actor)
        let every = dv_find(policy, "opt_dirty_verify", 0)
        if 0 < every:
            let key = ["dirty-reason-verify-tick"]
            let previous = rt_memo_get(dependency_index, key)
            var calls = 1
            if previous[0]:
                calls = previous[1] + 1
            if calls >= every:
                verify = true
                calls = 0
            rt_memo_put(dependency_index, key, calls)
    if count < budget:
        var adoptions = mind.adoptions
        var i = 0
        if dirty:
            i = rt_dirty_next(mind, dependency_index, -1)
            if verify:
                dvs_dirty_verify_reason(mind, adoptions, signatures, 0, i, time)
        changed = false
        while dv_and((i < rt_count(adoptions)), (count < budget)):
            var entry = adoptions[i]
            var law = entry[1].law
            if dv_and(entry[1].active, (entry[1].mode == "infer")):
                var skip = false
                if dv_find(signatures, entry[0], false) != false and dvs_reason_monotone_satisfied(mind, law.effects):
                    skip = true
                if not skip and (dvs_dirty_truth(mind, law.premise, policy, law.name) == "true"):
                    let sig = dvs_reason_signature(mind, entry[1])
                    if not dv_same(dv_find(signatures, entry[0], false), sig):
                        var stage = dv_stage(mind, law.effects, time, entry[1].basis, entry[1].confidence)
                        if dv_and((stage.status == "ready"), dvs_reason_changes(stage.changes)):
                            var before = mind
                            var result = dv_infer(mind, entry[0], rt_cat("infer", rt_show(rt_count(events))), time, mind.revision)
                            mind = result.world
                            changed = true
                            count = (count + 1)
                            signatures = dv_with(signatures, entry[0], sig)
                            var event = dvs_event(events, "inference", actor.id, time, dv_explanation_merge(dvs_cognitive_parents(actor, dv_single(parent)), dvs_support_parents(before, dvs_sim_refs(law.premise), events, actor)), {"mind_before": before, "mind_after": mind, "law": law, "receipt": result})
                            actor = dv_with(actor, "last_cognitive_event", event)
                            rt_push(derivations, dv_with({"event": event, "adoption": entry[1], "inputs": dvs_sim_inputs(before, law.premise), "changes": result.changes}, "valid", true))
                        else:
                            if (stage.status == "ready"):
                                count = (count + 1)
                                signatures = dv_with(signatures, entry[0], sig)
                                dvs_event(events, "inference_alternative_basis", actor.id, time, dvs_cognitive_parents(actor, dv_single(parent)), {"law": law, "basis": entry[1].basis, "premises": dvs_reason_premises(mind, law.premise), "mind_revision": mind.revision})
            let previous = i
            if dirty:
                // Do not remove a queued candidate when this call cannot spend
                // another inference step; it belongs to the next budget window.
                if count < budget:
                    i = rt_dirty_next(mind, dependency_index, previous)
                    if verify:
                        dvs_dirty_verify_reason(mind, adoptions, signatures, previous + 1, i, time)
            else:
                i = i + 1
    var local_1 = false
    if (count < budget):
        local_1 = "no-new-effective-conclusion"
    else:
        local_1 = "budget-exhausted"
    if changed and count < budget:
        local_1 = "approximate-single-pass"
    let report = {"steps": count, "remaining": budget - count, "stop": local_1, "mind_revision": mind.revision, "approximation": true}
    if count > 0 or not dv_same(report, dv_find(actor, "last_reason_report", false)):
        actor = dv_with_many(actor, {"last_cognitive_event": dvs_event(events, "reason_stop", actor.id, time, dvs_cognitive_parents(actor, dv_single(parent)), report), "last_reason_report": report})
    return dv_with_many(actor, {"mind": mind, "inference_derivations": derivations, "inference_signatures": signatures, "policy": dv_with(policy, "reason_budget", (budget - count))})

fn dvs_cached_model(actor, hypothesis):
    var model = dv_find(dv_find(actor, "simulations", []), hypothesis.id, {"fit": 0, "status": "not-simulated"})
    if dv_or((dv_find(model, "source_revision", -1) == actor.mind.revision), dv_and(dv_explanation_model_current(actor.mind, model), dv_same(dv_find(model, "source_response_models", false), dv_find(actor, "response_models", [])))):
        return dv_with(model, "validated_by_inputs", true)
    else:
        if dv_and(dvs_argument_valid(actor), dvs_argument_inputs_current(actor)):
            var argument = actor.argument
            if dv_and((dv_find(model, "source_revision", -1) == argument.source_revision), dv_or((dv_find(model, "event", "") == argument.model_event), dv_has(argument.competitor_events, dv_find(model, "event", "")))):
                return dv_with(model, "validated_by_argument", argument.id)
            else:
                return {"fit": 0, "status": "stale-or-unavailable", "source_revision": dv_find(model, "source_revision", -1)}
        else:
            return {"fit": 0, "status": "stale-or-unavailable", "source_revision": dv_find(model, "source_revision", -1)}

fn dvs_working_explanation(actor, hypothesis):
    if dvs_factor_candidate_rejected(actor, hypothesis):
        return false
    return dv_and(dvp_topic(actor, hypothesis), dv_and((0 < rt_count(dv_find(hypothesis, "features", []))), dv_and((0 < rt_count(dvs_sim_plan(hypothesis))), dv_and((0 < rt_count(dv_find(hypothesis, "basis", []))), dv_and((dv_truth(actor.mind, dv_find(hypothesis, "available_when", dv_true())) == "true"), (not (dv_truth(actor.mind, hypothesis.proposition) == "false")))))))

fn dvs_obligation_actions(actions):
    let key = ["dvs-obligation-actions-v1"]
    let cached = dvs_declaration_cache_get(actions, key)
    if cached[0]:
        return cached[1]
    var result = []
    var i = 0
    while i < rt_count(actions):
        if dv_find(actions[i], "obligation", false):
            rt_push(result, actions[i])
        i = i + 1
    return dvs_declaration_cache_put(actions, key, result)

fn dvs_scan_obligations(actor, now, costs):
    let actions = dvs_obligation_actions(actor.actions)
    var best = false
    var earliest = now + 1
    var considered = 0
    var admitted = 0
    var i = 0
    while i < rt_count(actions):
        let action = actions[i]
        let due = dv_find(action, "obligation_due", 0)
        if due <= now and due < earliest:
            considered = considered + 1
            let relevant = dvs_sim_refs(action.precondition)
            if dvp_eligible(actor, action, actor.mind, relevant):
                admitted = admitted + 1
                let model = dv_get(costs, action.kind)
                if dv_action_cost_le(model.maximum, actor.ledger.balances):
                    if not dv_has_key(actor.policy, "remaining_game_time") or model.maximum.time <= actor.policy.remaining_game_time:
                        best = action
                        earliest = due
        i = i + 1
    return {"action": best, "considered": considered, "admitted": admitted}

fn dvs_due_obligation(actor, now, costs):
    return dvs_scan_obligations(actor, now, costs).action

fn dvs_obligation_choice(actor, costs):
    let scanned = dvs_scan_obligations(actor, dv_find(actor, "decision_time", actor.mind.time), costs)
    let action = scanned.action
    if action == false:
        return false
    let refs = dvs_sim_refs(action.precondition)
    let reason = "declared-obligation-due"
    let work = {"cache_hit": false, "candidates_considered": scanned.considered, "admission_checks": scanned.considered, "eligible_evaluations": scanned.admitted, "forecasts": 0, "forecast_reuses": 0, "expanded_nodes": 0, "candidate_paths": 1, "skipped_expansion": true, "stop_reason": reason, "candidate_order": "declared-obligation", "candidate_order_scans": 0, "candidate_order_reuses": 0}
    let plan = {"path": [action.id], "score": 0, "relevant_refs": refs, "score_scope": "declared-obligation", "mind_revision": actor.mind.revision, "evaluated_at_game_time": dv_find(actor, "decision_time", actor.mind.time)}
    return {"action": action, "score": 0, "plan_expansions": 0, "plans": [plan], "selected_path": [action.id], "relevant_refs": refs, "stop": reason, "strategy": "declared-obligation-v1", "approximation": false, "time_blocked": 0, "dependency_expansions": 0, "planning_work": work}

// Scan current owned candidates in declaration order with one shared score.
fn dvs_choose(actor, bindings, costs):
    if dv_find(actor, "simulation_priority_action", "") == "":
        let duty = dvs_obligation_choice(actor, costs)
        if duty != false:
            return dv_with_many(duty, {"strategy": "approximate-v1", "approximation": true, "stop": "current-owned-obligation"})
    let relevant = dvp_goal_refs(actor)
    var selected = false
    var best = 0
    var plans = []
    var evaluated = 0
    var considered = 0
    var time_blocked = 0
    let priority = dv_find(actor, "simulation_priority_action", "")
    let time = dv_find(actor, "decision_time", actor.mind.time)
    var i = 0
    while i < rt_count(actor.actions):
        let action = actor.actions[i]
        considered = considered + 1
        if dvp_eligible(actor, action, actor.mind, relevant):
            let model = dv_get(costs, action.kind)
            if dv_find(actor.policy, "remaining_game_time", model.maximum.time) < model.maximum.time:
                time_blocked = time_blocked + 1
            else:
                if dv_action_cost_le(model.maximum, actor.ledger.balances):
                    evaluated = evaluated + 1
                    let scored = dvs_current_action_score(actor, action, bindings, relevant, model.actual)
                    let score = scored.total
                    rt_push(plans, {"path": [action.id], "score": score, "value": {"value": scored.action_value, "current_score": scored}, "mind_revision": actor.mind.revision, "evaluated_at_game_time": time, "score_scope": "current-owned-utility", "prediction_basis": []})
                    if best < score or (priority != "" and action.id == priority):
                        if selected == false or selected.id != priority:
                            selected = action
                            best = score
        i = i + 1
    var path = []
    if selected != false:
        path = [selected.id]
    return {"action": selected, "score": best, "plan_expansions": 0, "dependency_expansions": 0, "plans": plans, "selected_path": path, "relevant_refs": relevant, "strategy": "approximate-v1", "approximation": true, "stop": "current-candidates-scanned", "time_blocked": time_blocked, "planning_work": {"candidates_considered": considered, "eligible_evaluations": evaluated, "admission_checks": considered, "expanded_nodes": 0, "forecasts": 0, "skipped_expansion": true, "stop_reason": "current-candidates-scanned"}}

fn dvs_current_appraisals(actor, events, time, parent):
    let declarations = dv_find(actor.policy, "current_appraisals", [])
    if rt_count(declarations) == 0:
        return actor
    dv_domain(actor.mind, "mind")
    dv_require(actor.mind.subject == actor.id, "Appraisal mind must belong to its evaluator")
    var inputs_by_id = dv_find(actor, "current_appraisal_inputs", [])
    var mind = actor.mind
    var cognitive = dv_find(actor, "last_cognitive_event", parent)
    var i = 0
    while i < rt_count(declarations):
        let declaration = declarations[i]
        let ref = declaration.ref
        dv_require(dv_find(ref, "subject", "") == actor.id and ref.facet == "appraisal", "Current appraisal must be explicitly owned and scoped to appraisal facet")
        dv_require(0 < rt_count(declaration.basis), "Current appraisal needs a declared personal basis")
        let refs = dvs_sim_refs(declaration.when)
        var inputs = []
        var j = 0
        while j < rt_count(refs):
            dv_require(dv_find(refs[j], "subject", actor.id) == actor.id, "Cross-subject appraisal input")
            dv_require(not dv_same_local_ref(actor.id, refs[j], ref), "Current appraisal cannot depend on itself")
            rt_push(inputs, {"ref": refs[j], "cell": dv_read(mind, refs[j])})
            j = j + 1
        let hypothesis = dv_find(actor, "hypothesis", false)
        var hypothesis_id = ""
        if hypothesis != false:
            hypothesis_id = hypothesis.id
        let required = dv_find(declaration, "hypothesis_id", hypothesis_id)
        let hypothesis_event = dv_find(actor, "hypothesis_event", "")
        let signature = {"inputs": inputs, "hypothesis_id": hypothesis_id, "declaration": declaration}
        if not dv_same(signature, dv_find(inputs_by_id, declaration.id, false)):
            var truth = dv_truth(mind, declaration.when)
            if hypothesis_id != required:
                truth = "false"
            var next = dv_unknown()
            if truth == "true":
                next = dv_cell(declaration.value, 1, time, declaration.basis)
            if truth == "false":
                next = dv_cell(declaration.otherwise, 1, time, declaration.basis)
            next = dv_with_many(next, {"time": time, "evaluation_kind": "current-private-appraisal", "evaluation_id": declaration.id, "input_signature": signature})
            let before = dv_read(mind, ref)
            let changed = before.known != next.known or not dv_same(before.value, next.value) or dv_find(before, "conflicted", false)
            // Source refresh is a new current evaluation even if its value
            // agrees. The signature excludes mere hypothesis-event reissuance.
            mind = dv_with(dv_store(mind, ref, next), "revision", mind.revision + 1)
            var parents = dvs_support_parents(actor.mind, refs, events, actor)
            parents = dv_explanation_merge(parents, [cognitive])
            if hypothesis_event != "":
                parents = dv_explanation_merge(parents, [hypothesis_event])
            cognitive = dvs_event(events, "private_appraisal_updated", actor.id, time, parents, {"id": declaration.id, "ref": ref, "before": before, "after": next, "value_changed": changed, "condition_truth": truth, "inputs": inputs, "hypothesis_event": hypothesis_event, "meaning": "replaceable-personal-evaluation-not-world-fact"})
            inputs_by_id = dv_with(inputs_by_id, declaration.id, signature)
        i = i + 1
    return dv_with_many(actor, {"mind": mind, "current_appraisal_inputs": inputs_by_id, "last_cognitive_event": cognitive})

fn dvs_reason(actor, events, time, parent):
    var refreshed = dvs_refresh_derivations(actor, events, time, parent)
    if dv_find(refreshed, "cognition_blocked", false):
        return refreshed
    else:
        return dvs_reason_run(refreshed, events, time, parent)

// Fresh prepared data and borrowed data share the same immutable evidence boundary.
fn dvs_event_prepared(events, kind, actor, time, parents, data):
    return dvs_event(events, kind, actor, time, parents, data)

// The event boundary immediately freezes this read-only projection. Borrow
// unchanged fields here instead of cloning a whole choice before freezing it.
fn dvs_choice_event(events, kind, actor, time, parents, choice):
    return dvs_event(events, kind, actor, time, parents, choice)

fn dvs_owned_events_stable(events, actor, cursor):
    events = rt_snapshot(events)
    var i = cursor
    while i < rt_count(events):
        if events[i].actor == actor.id:
            if not dv_has(["planning_stop", "planning_stop_reused", "planning_yield", "action_wait"], events[i].type):
                return false
        i = i + 1
    return true

fn dvs_has_active_communication_goal(actor):
    let goals = dv_find(actor.policy, "communication_goals", [])
    var i = 0
    while i < rt_count(goals):
        let goal = goals[i]
        if 0 < rt_count(dv_find(goal, "basis", [])) and dv_truth(actor.mind, dv_find(goal, "available_when", dv_true())) == "true":
            return true
        i = i + 1
    return false

fn dvs_prepare_cognition(actor, events, time, parent):
    if dv_find(dv_find(actor.mind, "CognitionFilter", []), "anterograde", false):
        return dv_with_many(actor, {"cognition_stop": "anterograde-no-new-memory", "cognition_reused": false, "reason_reused": false})
    actor = dvs_refresh_argument(actor, events, time, parent)
    if dv_find(actor, "argument", false) != false and dv_find(actor, "cognition_blocked", false):
        return dv_with_many(actor, {"cognition_stop": "argument-revocation-budget", "cognition_reused": false, "reason_reused": false})
    // Preserve actual inference sources and invalidation in one declaration pass.
    actor = dvs_reason(actor, events, time, parent)
    actor = dvs_current_appraisals(actor, events, time, parent)
    actor = dvs_update_support_events(actor, events)
    actor = dvs_capture_public_topics(actor, events, time, parent)
    actor = dvs_refresh_argument(actor, events, time, parent)
    return dv_with_many(actor, {"cognition_stop": "approximate-single-pass", "cognition_mode": "approximate-v1", "cognition_reused": false, "reason_reused": false})

fn dvp_personal_ready(mind, choice):
    return (0 < rt_count(dv_find(choice, "basis", [])) and dv_truth(mind, choice.requires) == "true" and dv_truth(mind, choice.prohibits) == "false")

fn dvp_personal_impact(choice, value):
    var impact = 0
    if dv_has(choice.promotes, value):
        impact = impact + 1
    if dv_has(choice.sacrifices, value):
        impact = impact - 1
    return impact

fn dvp_personal_better(order, left, right):
    var i = 0
    while (i < rt_count(order)):
        let a = dvp_personal_impact(left, order[i])
        let b = dvp_personal_impact(right, order[i])
        if (a != b):
            return b < a
        i = i + 1
    return false

fn dvp_received_speech_matches(receipts, requirement):
    dv_require(dv_record_like(requirement), "Received speech requirement must be a record")
    var i = 0
    while i < rt_count(receipts):
        let receipt = receipts[i]
        if receipt.speaker == requirement.speaker and receipt.action_id == requirement.action_id and receipt.parse_event != "" and receipt.source_event != "":
            return true
        i = i + 1
    return false

fn dvp_owner_requirements(actor, action, mind):
    if not dvs_actor_can_act(actor):
        return false
    if not dvp_owned_decision_ready(actor, action, mind):
        return false
    if not dvs_advice_decision_ready(actor, action, mind):
        return false
    let resonance = dv_find(action, "resonance", false)
    if resonance != false:
        dv_require(dv_record_like(resonance), "Resonance must be a record")
        if not dv_find(resonance, "passive", false):
            if not (0 < dvp_resonance_utility(actor, action, mind)):
                return false
    let night_call = dv_find(action, "night_call_requirement", false)
    if night_call != false:
        dv_require(dv_record_like(night_call), "Night call requirement must be a record")
        if not dv_find(actor, "night_call_eligible", false) or rt_count(dv_find(night_call, "basis", [])) == 0 or dv_truth(mind, night_call.night_when) != "true":
            return false
    let conflict = dv_find(action, "received_claim_conflict", false)
    if conflict != false:
        dv_require(dv_record_like(conflict), "Received claim conflict must be a record")
        let conflicts = dv_find(actor, "observed_claim_conflicts", [])
        var found_conflict = false
        var conflict_index = 0
        while conflict_index < rt_count(conflicts):
            let evidence = conflicts[conflict_index]
            dv_require(dv_record_like(evidence), "Observed claim conflict must be a record")
            if evidence.key == conflict.key and evidence.speaker == conflict.speaker:
                if dv_find(evidence, "source_event", "") != "" and dv_find(evidence, "previous_source", "") != "" and dv_find(evidence, "parse_event", "") != "" and 0 < rt_count(dv_find(evidence, "basis", [])):
                    found_conflict = true
            conflict_index = conflict_index + 1
        if not found_conflict:
            return false
    let opportunity = dv_find(action, "opportunity_requirement", false)
    if opportunity != false:
        dv_require(dv_record_like(opportunity), "Opportunity requirement must be a record")
        dv_require(dv_has(["all-present", "at-least-one-present", "none-present"], opportunity.mode), "Unknown opportunity mode")
        let own = dv_read(mind, actor.location_ref)
        if not dv_uncontested(own) or own.value != opportunity.location:
            return false
        let context = dv_find(actor, "visible_context", [])
        var present = 0
        var i = 0
        while i < rt_count(opportunity.participants):
            let id = opportunity.participants[i]
            let peer = dv_find(context, id, false)
            if id == actor.id:
                present = present + 1
            else:
                if peer != false:
                    if peer.location == opportunity.location:
                        present = present + 1
            i = i + 1
        if opportunity.mode == "all-present" and present != rt_count(opportunity.participants):
            return false
        if opportunity.mode == "at-least-one-present" and present == 0:
            return false
        if opportunity.mode == "none-present":
            // An empty projected list at an unvisited destination is not an observation.
            if present != 0 or not dv_find(actor, "visible_context_clear", false) or dv_find(actor, "visible_context_location", false) != own.value:
                return false
    let heard = dv_find(action, "received_speech_requirement", false)
    if heard != false:
        dv_require(dv_record_like(heard), "Received speech requirement must be a record")
        let receipts = dv_find(actor, "received_speeches", [])
        var found = false
        if dv_has_key(heard, "any_of"):
            dv_require(rt_is_list(heard.any_of), "Received speech any_of must be a list")
            var i = 0
            while i < rt_count(heard.any_of):
                if dvp_received_speech_matches(receipts, heard.any_of[i]):
                    found = true
                i = i + 1
        else:
            found = dvp_received_speech_matches(receipts, heard)
        if not found:
            return false
    if dv_find(action, "response_once", false) and dv_has(dv_find(actor, "completed_actions", []), action.id):
        return false
    let superseded = dv_find(action, "suppress_after_received_speech", false)
    if superseded != false:
        dv_require(dv_record_like(superseded), "Suppressing speech requirement must be a record")
        if dvp_received_speech_matches(dv_find(actor, "received_speeches", []), superseded):
            return false
    let completed = dv_find(action, "completed_action_requirement", false)
    if completed != false:
        dv_require(dv_record_like(completed), "Completed action requirement must be a record")
        if not dv_has(dv_find(actor, "completed_actions", []), completed.action_id):
            return false
    let desire = dv_find(action, "desire_requirement", false)
    if desire != false:
        dv_require(dv_record_like(desire), "Desire requirement must be a record")
        if desire.subject != actor.id:
            return false
        let desires = dv_find(actor.policy, "desires", [])
        var found = false
        var i = 0
        while i < rt_count(desires):
            if desires[i].id == desire.desire_id and 0 < rt_count(dv_find(desires[i], "basis", [])):
                found = true
            i = i + 1
        if not found:
            return false
    return true

fn dvp_eligible(actor, action, mind, relevant):
    if (not dvp_eligible_base(actor, action, mind, relevant)):
        return false
    return dvp_eligible_after_base(actor, action, mind, relevant)

fn dvp_owner_interpretation_ready(actor, action):
    let attitude = dv_find(action, "owner_interpretation_requirement", false)
    if attitude != false:
        dv_require(dv_record_like(attitude), "Owner interpretation requirement must be a record")
        let interpretation = dv_find(dv_find(actor, "interpretations", []), attitude.interpretation_id, false)
        if interpretation == false:
            return false
        dv_require(dv_record_like(interpretation), "Owner interpretation must be a record")
        if attitude.subject != actor.id or interpretation.status != attitude.required_status or dv_find(interpretation, "source_event", "") == "":
            return false
    return true

// This single-owner gate is deliberately nonrecursive; group comparison calls it
// for each alternative without re-entering the alternative's whole choice group.
fn dvp_personal_admissible(actor, action, mind):
    if not dv_has_key(action, "personal_choice"):
        return true
    let choice = action.personal_choice
    if not dvp_personal_ready(mind, choice):
        return false
    let order = dv_find(actor.policy, "value_order", [])
    if rt_count(order) == 0 or rt_count(dv_find(actor.policy, "value_basis", [])) == 0:
        return false
    if dv_find(choice, "require_positive", false):
        var i = 0
        var first = 0
        while i < rt_count(order) and first == 0:
            first = dvp_personal_impact(choice, order[i])
            i = i + 1
        if first <= 0:
            return false
    return true

fn dvp_eligible_after_base(actor, action, mind, relevant):
    if not dvp_owner_requirements(actor, action, mind):
        return false
    if not dvp_normative_ready(actor, action, mind):
        return false
    if not dvp_owner_interpretation_ready(actor, action):
        return false
    if (not dv_has_key(action, "personal_choice")):
        return true
    let choice = action.personal_choice
    if not dvp_personal_admissible(actor, action, mind):
        return false
    let order = dv_find(actor.policy, "value_order", [])
    var alternatives = actor.actions
    if dv_has_key(actor, "planning_choice_groups"):
        alternatives = dv_find(actor.planning_choice_groups, choice.group, [])
    var i = 0
    while (i < rt_count(alternatives)):
        let other = alternatives[i]
        if (other.id != action.id and dv_has_key(other, "personal_choice")):
            if (other.personal_choice.group == choice.group and dvp_personal_admissible(actor, other, mind)):
                if (dvp_eligible_base(actor, other, mind, relevant) and dvp_owner_requirements(actor, other, mind) and dvp_normative_ready(actor, other, mind) and dvp_owner_interpretation_ready(actor, other) and dvp_personal_better(order, other.personal_choice, choice)):
                    return false
        i = i + 1
    return true

// Norms affect this owner's choice; they never become physical prohibitions.
fn dvp_normative_ready(actor, action, mind):
    let decision = dv_find(action, "norm_decision", false)
    if decision != false:
        dv_require(dv_record_like(decision), "Norm decision must be a record")
        let proposal = dv_find(dv_find(actor, "norm_proposals", []), decision.id, false)
        if proposal == false:
            return false
        dv_require(dv_record_like(proposal), "Received norm proposal must be a record")
        if dv_find(proposal, "source_event", "") == "" or dv_find(proposal, "parse_event", "") == "" or not dv_same(proposal.norm, decision.norm):
            return false
    // An unsupervised act is valued by its owner, independently of a public pledge.
    let private = dv_find(action, "private_execution", false)
    if private != false:
        dv_require(dv_record_like(private), "Private execution must be a record")
        if rt_count(dv_find(private, "basis", [])) == 0 or dv_truth(mind, private.requires) != "true":
            return false
        if dvp_private_execution_utility(actor, action, mind) <= 0:
            return false
    let method = dv_find(action, "normative_method", "")
    if method == "":
        return true
    let rules = dv_find(actor.policy, "norm_rules", [])
    let order = dv_find(actor.policy, "value_order", [])
    let choice = dv_find(action, "personal_choice", {"promotes": [], "sacrifices": []})
    var matched = false
    var applicable = []
    var i = 0
    while i < rt_count(rules):
        let rule = rules[i]
        if method != "" and rule.method == method and 0 < rt_count(rule.basis) and dv_truth(mind, rule.available_when) == "true":
            rt_push(applicable, rule)
            matched = true
        i = i + 1
    if not matched:
        return true
    i = 0
    while i < rt_count(order):
        var impact = dvp_personal_impact(choice, order[i])
        var j = 0
        while j < rt_count(applicable):
            let rule = applicable[j]
            let value = dvp_personal_impact({"promotes": dv_find(rule, "promotes", []), "sacrifices": dv_find(rule, "sacrifices", [])}, order[i])
            if rule.mode == "forbid":
                impact = impact - value
            else:
                impact = impact + value
            j = j + 1
        if impact != 0:
            return 0 < impact
        i = i + 1
    return true

// All numeric inputs are explicit owner declarations or uncontested owner knowledge.
fn dvp_owned_quantity(actor, mind, declaration):
    if rt_is_numeric_value(declaration):
        return declaration
    if declaration == false:
        return 0
    dv_require(dv_record_like(declaration), "Owned quantity must be a number or record")
    if dv_has_key(declaration, "speaker"):
        return dvs_speaker_trust(actor.policy, declaration.speaker)
    if dv_has_key(declaration, "policy_key"):
        let quantity = dv_find(actor.policy, declaration.policy_key, 0)
        dv_require(rt_is_numeric_value(quantity), "Owned policy quantity must be numeric")
        return quantity
    dv_require(dv_has_key(declaration, "ref"), "Owned quantity needs policy_key or ref")
    dv_require(dv_record_like(declaration.ref), "Owned quantity ref must be a record")
    let cell = dv_read(mind, declaration.ref)
    if dv_uncontested(cell) and rt_is_numeric_value(cell.value):
        return cell.value
    return 0

fn dvp_owner_utility(actor, action, mind):
    let declaration = dv_find(action, "owner_utility", false)
    if declaration == false:
        return {"value": 0, "terms": []}
    dv_require(dv_record_like(declaration), "Owner utility must be a record")
    if rt_count(dv_find(declaration, "basis", [])) == 0 or dv_truth(mind, declaration.requires) != "true":
        return {"value": 0, "terms": []}
    var value = 0
    var inputs = []
    var i = 0
    while i < rt_count(declaration.terms):
        let term = declaration.terms[i]
        dv_require(rt_is_numeric_value(term.weight), "Owner utility weight must be numeric")
        let quantity = dvp_owned_quantity(actor, mind, term.quantity)
        let contribution = quantity * term.weight
        value = value + contribution
        rt_push(inputs, {"declaration": term.quantity, "quantity": quantity, "weight": term.weight, "contribution": contribution})
        i = i + 1
    return {"value": value, "terms": inputs, "basis": declaration.basis}

fn dvp_private_execution_utility(actor, action, mind):
    let private = dv_find(action, "private_execution", false)
    if private == false:
        return 0
    dv_require(dv_record_like(private), "Private execution must be a record")
    if rt_count(dv_find(private, "basis", [])) == 0 or dv_truth(mind, private.requires) != "true":
        return 0
    let multiplier = dv_find(actor.policy, "private_execution_benefit_multiplier", 1)
    dv_require(rt_is_numeric_value(multiplier), "Private benefit multiplier must be numeric")
    dv_require(0 <= multiplier, "Private benefit multiplier must be nonnegative")
    return dvp_owned_quantity(actor, mind, private.benefit) * multiplier - dvp_owned_quantity(actor, mind, private.resource_cost)

fn dvp_resonance_utility(actor, action, mind):
    let r = action.resonance
    dv_require(dv_record_like(r), "Resonance must be a record")
    if rt_count(dv_find(r, "basis", [])) == 0 or dv_truth(mind, dv_find(r, "requires", dv_true())) != "true":
        return 0
    let retrieved = dv_find(r, "retrieved_when", false)
    if retrieved != false and dv_truth(mind, retrieved) == "true":
        return 0
    let drive = dvp_owned_quantity(actor, mind, r.drive)
    let relevance = dvp_owned_quantity(actor, mind, r.relevance)
    let bonus = dvp_owned_quantity(actor, mind, r.truth_bonus)
    let caution = dvp_owned_quantity(actor, mind, r.caution)
    let risk = dvp_owned_quantity(actor, mind, r.perceived_risk)
    return drive * relevance + bonus - caution - risk

// Keep owner-only utility inputs in the planning dependency signature and slice.
fn dvp_owner_requirement_refs(action):
    var refs = []
    let utility = dv_find(action, "owner_utility", false)
    if utility != false:
        refs = dvp_merge_refs(refs, dvs_sim_refs(utility.requires))
        var ui = 0
        while ui < rt_count(utility.terms):
            let quantity = utility.terms[ui].quantity
            if quantity != false and not rt_is_numeric_value(quantity):
                if dv_has_key(quantity, "ref"):
                    refs = dvp_add_ref(refs, quantity.ref)
            ui = ui + 1
    let private = dv_find(action, "private_execution", false)
    if private != false:
        dv_require(dv_record_like(private), "Private execution must be a record")
        refs = dvp_merge_refs(refs, dvs_sim_refs(private.requires))
        let quantities = [private.benefit, private.resource_cost]
        var pi = 0
        while pi < rt_count(quantities):
            let quantity = quantities[pi]
            if quantity != false and not rt_is_numeric_value(quantity):
                dv_require(dv_record_like(quantity), "Owned quantity must be a number or record")
                if not dv_has_key(quantity, "policy_key") and not dv_has_key(quantity, "speaker"):
                    dv_require(dv_has_key(quantity, "ref"), "Owned quantity needs policy_key or ref")
                    dv_require(dv_record_like(quantity.ref), "Owned quantity ref must be a record")
                    refs = dvp_add_ref(refs, quantity.ref)
            pi = pi + 1
    let r = dv_find(action, "resonance", false)
    if r != false:
        dv_require(dv_record_like(r), "Resonance must be a record")
        if not dv_find(r, "passive", false):
            refs = dvp_merge_refs(refs, dvs_sim_refs(dv_find(r, "requires", dv_true())))
            let retrieved = dv_find(r, "retrieved_when", false)
            if retrieved != false:
                refs = dvp_merge_refs(refs, dvs_sim_refs(retrieved))
            let quantities = [r.drive, r.relevance, r.truth_bonus, r.caution, r.perceived_risk]
            var i = 0
            while i < rt_count(quantities):
                let quantity = quantities[i]
                if quantity != false and not rt_is_numeric_value(quantity):
                    dv_require(dv_record_like(quantity), "Owned quantity must be a number or record")
                    if not dv_has_key(quantity, "policy_key") and not dv_has_key(quantity, "speaker"):
                        dv_require(dv_has_key(quantity, "ref"), "Owned quantity needs policy_key or ref")
                        dv_require(dv_record_like(quantity.ref), "Owned quantity ref must be a record")
                        refs = dvp_add_ref(refs, quantity.ref)
                i = i + 1
    let night = dv_find(action, "night_call_requirement", false)
    if night != false:
        dv_require(dv_record_like(night), "Night call requirement must be a record")
        refs = dvp_merge_refs(refs, dvs_sim_refs(night.night_when))
    let decision = dv_find(action, "owned_decision", false)
    if decision != false:
        refs = dvp_merge_refs(refs, dv_find(decision, "context_refs", []))
    return refs

fn dvs_actor_can_act(actor):
    let stage = dv_find(actor, "erosion_stage", "early")
    return stage != "terminal" and stage != "death" and not dv_find(actor, "incapacitated", false)

// A reproducible integer stream; samples are selected only from declared options.
fn dvs_cognitive_seed_next(seed):
    let n = seed * 48271 + 1
    return n - rt_floor(n / 2147483647) * 2147483647

fn dvs_initialize_cognition(actor, seed, ordinal):
    dv_require(0 <= seed and rt_floor(seed) == seed, "Opening seed must be a nonnegative integer")
    let declaration = dv_find(actor, "cognitive_initialization", false)
    if declaration == false:
        if dv_has_key(actor, "erosion"):
            return dv_with(actor, "first_day_mind", actor.mind)
        return actor
    dv_require(rt_count(dv_find(declaration, "basis", [])) > 0, "Cognitive initialization needs declared provenance")
    var stream = dvs_cognitive_seed_next(seed + ordinal)
    var policy = actor.policy
    let samples = dv_find(declaration, "samples", [])
    var selected = []
    var i = 0
    while i < rt_count(samples):
        let sample = samples[i]
        dv_require(0 < rt_count(dv_find(sample, "basis", [])), "Cognitive sample needs provenance")
        let options = sample.options
        dv_require(0 < rt_count(options), "Empty cognitive sample domain")
        stream = dvs_cognitive_seed_next(stream)
        let index = stream - rt_floor(stream / rt_count(options)) * rt_count(options)
        policy = dv_with(policy, sample.key, options[index])
        selected = dv_with(selected, sample.key, options[index])
        i = i + 1
    policy = dv_with_many(policy, dv_find(declaration, "profile", []))
    return dv_with_many(actor, {"policy": policy, "cognitive_seed": seed, "cognitive_samples": selected, "first_day_mind": actor.mind})

// Erosion is content-defined exposure/threshold data, with an explicit first-day snapshot.
fn dvs_erosion_update(actor, physical, time):
    let erosion = dv_find(actor, "erosion", false)
    if erosion == false:
        return actor
    var incapacitated = false
    if dv_has_key(erosion, "incapacity_when"):
        incapacitated = dv_truth(physical, erosion.incapacity_when) == "true"
    let exposure_cell = dv_read(physical, erosion.physical_ref)
    var exposure = 0
    if dv_uncontested(exposure_cell) and rt_is_numeric_value(exposure_cell.value):
        exposure = exposure_cell.value
    exposure = exposure * (1 + dv_find(actor, "resonance_coupling", 0) * dv_find(erosion, "coupling_factor", 0))
    let stages = ["early", "middle", "late", "terminal", "death"]
    var rank = dv_find(actor, "erosion_rank", 0)
    var i = 0
    while i < rt_count(erosion.thresholds):
        let threshold = erosion.thresholds[i]
        if threshold.at <= exposure and rank < threshold.rank:
            if not dv_has_key(threshold, "when") or dv_truth(physical, threshold.when) == "true":
                rank = threshold.rank
        i = i + 1
    dv_require(0 <= rank and rank < rt_count(stages), "Invalid erosion stage")
    let memory_period = dv_find(erosion, "memory_period", 1440)
    dv_require(0 < memory_period, "Erosion memory period must be positive")
    let memory_epoch = rt_floor(time / memory_period)
    let truncate_memory = 2 <= rank and (not dv_find(actor, "erosion_memory_truncated", false) or dv_find(actor, "erosion_memory_epoch", -1) != memory_epoch)
    let incapacity_changed = dv_has_key(erosion, "incapacity_when") and (not dv_has_key(actor, "incapacitated") or dv_find(actor, "incapacitated", false) != incapacitated)
    if dv_find(actor, "erosion_rank", -1) == rank and dv_find(actor, "erosion_stage", "") == stages[rank] and not incapacity_changed and not truncate_memory:
        return actor
    var result = dv_with_many(actor, {"erosion_rank": rank, "erosion_stage": stages[rank]})
    if dv_has_key(erosion, "incapacity_when"):
        result = dv_with(result, "incapacitated", incapacitated)
    if truncate_memory:
        dv_require(dv_has_key(actor, "first_day_mind"), "Late erosion needs declared first-day memory snapshot")
        let old = actor.mind
        let memory = dv_with_many(actor.first_day_mind, {"time": time, "revision": old.revision + 1})
        result = dv_with_many(result, {"mind": memory, "erosion_memory_truncated": true, "erosion_memory_epoch": memory_epoch, "simulations": [], "interpretations": [], "response_models": [], "proposals": [], "received_speeches": [], "received_advice": [], "owned_decisions": [], "pending_heard": [], "observed_public_claims": [], "observed_claim_conflicts": [], "pending_player_influences": []})
    return result

// Only the actual audible reception path invokes this, never speaker forecasts.
fn dvs_receive_public_claim(listener, speech, speaker, source, parse_event):
    let claim = dv_find(speech, "public_claim", false)
    if claim == false:
        return listener
    dv_require(0 < rt_count(dv_find(claim, "basis", [])), "Public claim needs content provenance")
    let history = dv_find(listener, "observed_public_claims", [])
    var conflicts = dv_find(listener, "observed_claim_conflicts", [])
    var i = 0
    while i < rt_count(history):
        let prior = history[i]
        if prior.speaker == speaker and prior.key == claim.key and dv_has(dv_find(claim, "conflicts_with", []), prior.value):
            conflicts = dv_append(conflicts, {"speaker": speaker, "key": claim.key, "previous_source": prior.source_event, "source_event": source, "parse_event": parse_event, "basis": claim.basis})
        i = i + 1
    let received = {"speaker": speaker, "key": claim.key, "value": claim.value, "source_event": source, "parse_event": parse_event}
    return dv_with_many(listener, {"observed_public_claims": dv_append(history, received), "observed_claim_conflicts": conflicts})

fn dvs_recorded_event_position(events, id):
    events = rt_snapshot(events)
    var i = rt_count(events) - 1
    while i >= 0:
        if events[i].id == id:
            return i
        i = i - 1
    return -1

// Follow only the actual execution's host/quote/planning chain. Cognitive
// ancestors can contain an older selection of the same action and are not used.
fn dvs_action_selection_evidence(events, actor, action, execution_event):
    var cursor = execution_event
    var seen = []
    while cursor != "" and not dv_has(seen, cursor):
        rt_push(seen, cursor)
        let current = dvs_find_event_by_id(events, cursor)
        if current == false or current.actor != actor.id:
            return false
        if current.type == "action_selected":
            if dv_find(dv_find(current.data, "action", []), "id", "") == action.id:
                return {"event": current.id, "position": dvs_recorded_event_position(events, current.id), "time": current.time}
            return false
        if not dv_has(["action_execution", "host_completion", "cost_quote", "planning_choice", "action_scheduled"], current.type) or rt_count(current.parents) != 1:
            return false
        cursor = current.parents[0]
    return false

fn dvs_heard_before_selection(events, actor, action, execution_event, parse_event, source_event):
    let selection = dvs_action_selection_evidence(events, actor, action, execution_event)
    let parsed = dvs_find_event_by_id(events, parse_event)
    if selection == false or parsed == false:
        return false
    if parsed.type != "listener_parse" or parsed.actor != actor.id or dv_find(parsed.data, "source_event", "") != source_event:
        return false
    let position = dvs_recorded_event_position(events, parse_event)
    if position < 0 or selection.position <= position:
        return false
    return selection

// A decision keeps its semantic inputs separate from evidence provenance. A
// repeated inspection of the same value does not create a new decision context.
fn dvs_owned_decision_request(actor, topic):
    let requests = dv_find(actor, "received_requests", [])
    var latest = false
    var i = 0
    while i < rt_count(requests):
        let receipt = requests[i]
        if receipt.topic == topic and dv_find(receipt, "source_event", "") != "" and dv_find(receipt, "parse_event", "") != "":
            latest = receipt
        i = i + 1
    return latest

fn dvs_owned_decision_inputs(actor, decision, mind):
    dv_require(dv_record_like(decision), "Owned decision must be a record")
    dv_require(dv_find(decision, "id", "") != "" and dv_find(decision, "stance", "") != "", "Owned decision needs identity and stance")
    dv_require(rt_count(dv_find(decision, "basis", [])) > 0, "Owned decision needs declared provenance")
    let refs = dv_find(decision, "context_refs", [])
    let topics = dv_find(decision, "request_topics", [])
    dv_require(rt_is_list(refs) and rt_is_list(topics), "Owned decision references and request topics must be lists")
    var values = []
    var sources = []
    var requests = []
    var request_sources = []
    var i = 0
    while i < rt_count(refs):
        let ref = refs[i]
        dv_require(dv_record_like(ref) and dv_find(ref, "type", "") == "ref", "Owned decision context needs field references")
        let subject = dv_find(ref, "subject", actor.id)
        dv_require(subject == "" or subject == actor.id, "Owned decision context must belong to this subject")
        let local = dv_scoped_ref(actor.id, ref.object, ref.facet, ref.field)
        let cell = dv_read(mind, local)
        rt_push(values, {"ref": local, "known": cell.known, "conflicted": cell.conflicted, "value": cell.value})
        rt_push(sources, {"ref": local, "cell": cell})
        i = i + 1
    i = 0
    while i < rt_count(topics):
        let topic = topics[i]
        let receipt = dvs_owned_decision_request(actor, topic)
        var identity = false
        if receipt != false:
            identity = {"requester": receipt.requester, "source_event": receipt.source_event, "parse_event": receipt.parse_event}
        rt_push(requests, {"topic": topic, "receipt": identity})
        rt_push(request_sources, {"topic": topic, "receipt": receipt})
        i = i + 1
    let policy_keys = dv_find(decision, "context_policy_keys", [])
    dv_require(rt_is_list(policy_keys), "Owned decision policy keys must be a list")
    var policy_values = []
    i = 0
    while i < rt_count(policy_keys):
        rt_push(policy_values, {"key": policy_keys[i], "value": dv_find(actor.policy, policy_keys[i], false)})
        i = i + 1
    return {"context": {"values": values, "requests": requests, "policy_values": policy_values}, "sources": {"fields": sources, "requests": request_sources, "policy_values": policy_values}}

fn dvs_owned_decision_context(actor, decision, mind):
    return dvs_owned_decision_inputs(actor, decision, mind).context

fn dvp_owned_decision_ready(actor, action, mind):
    let decision = dv_find(action, "owned_decision", false)
    if decision == false:
        return true
    let context = dvs_owned_decision_context(actor, decision, mind)
    let previous = dv_find(dv_find(actor, "owned_decisions", []), decision.id, false)
    return previous == false or not dv_same(previous.context, context)

// Stored only in the real action_selected event; forecasts never call this.
fn dvs_owned_decision_selection(actor, action):
    let decision = dv_find(action, "owned_decision", false)
    if decision == false:
        return false
    return dv_with(dvs_owned_decision_inputs(actor, decision, actor.mind), "declaration", decision)

// Also used before publishing actual effects, so a changed queued decision is
// rejected rather than recorded as if it had been selected under the new input.
fn dvs_owned_decision_completion_selection(actor, action, events, parent):
    let decision = dv_find(action, "owned_decision", false)
    if decision == false:
        return true
    if not dvp_owned_decision_ready(actor, action, actor.mind):
        return false
    let selection = dvs_action_selection_evidence(events, actor, action, parent)
    if selection == false:
        return false
    let selected_event = dvs_find_event_by_id(events, selection.event)
    let snapshot = dv_find(selected_event.data, "owned_decision", false)
    if snapshot == false or not dv_same(snapshot.declaration, decision) or not dv_same(snapshot.context, dvs_owned_decision_context(actor, decision, actor.mind)):
        return false
    let requests = snapshot.sources.requests
    var i = 0
    while i < rt_count(requests):
        let receipt = requests[i].receipt
        if receipt != false:
            let source = dvs_find_event_by_id(events, receipt.source_event)
            if source == false or source.type != "speech_literal" or source.actor != receipt.requester:
                return false
            let request = dv_find(dv_find(source.data, "speech", []), "request", false)
            if request == false or request.target != actor.id or request.topic != requests[i].topic or not dv_same(request, receipt.request):
                return false
            if dvs_heard_before_selection(events, actor, action, parent, receipt.parse_event, receipt.source_event) == false:
                return false
            let parsed = dvs_find_event_by_id(events, receipt.parse_event)
            if not dv_has(parsed.parents, receipt.source_event) or dvs_recorded_event_position(events, receipt.parse_event) <= dvs_recorded_event_position(events, receipt.source_event):
                return false
        i = i + 1
    return dv_with(snapshot, "selection_event", selection.event)

// Called only by actual Complete. Passive flashbacks do not acquire paid coupling.
fn dvs_complete_cognitive_effects(actor, action, success, events, event, time):
    if not success:
        return actor
    var result = actor
    let r = dv_find(action, "resonance", false)
    if r != false:
        dv_require(dv_record_like(r), "Resonance must be a record")
    if r != false and not dv_find(r, "passive", false):
        let retrieved = dv_find(r, "retrieved_when", {"op": "constant", "value": "false"})
        if dv_truth(actor.mind, retrieved) == "true":
            let coupling = dv_find(actor, "resonance_coupling", 0) + dv_find(r, "coupling", 0)
            var policy = actor.policy
            var trust = dv_find(policy, "speaker_trust", [])
            let changes = dv_find(r, "trust_changes", [])
            var i = 0
            while i < rt_count(changes):
                let change = changes[i]
                trust = dv_with(trust, change.subject, dv_unit(dv_min(1, dv_max(0, dv_find(trust, change.subject, 0.5) + change.delta))))
                i = i + 1
            policy = dv_with(policy, "speaker_trust", trust)
            result = dv_with_many(result, {"resonance_coupling": coupling, "night_call_eligible": dv_find(actor, "night_call_eligible", false) or dv_find(r, "night_call", false), "policy": policy, "resonance_receipts": dv_append(dv_find(actor, "resonance_receipts", []), {"event": event, "time": time, "action": action.id, "coupling": coupling})})
    let influence = dv_find(action, "influence_consequence", false)
    if influence != false:
        if 0 < rt_count(dv_find(influence, "basis", [])) and dv_truth(actor.mind, influence.consequence_when) == "true":
            let heard = dv_find(actor, "received_speeches", [])
            var i = 0
            while i < rt_count(heard):
                let speech = heard[i]
                if speech.speaker == influence.speaker and speech.action_id == influence.action_id:
                    let selection = dvs_heard_before_selection(events, actor, action, event, speech.parse_event, speech.source_event)
                    if selection != false:
                        result = dv_with(result, "influence_consequences", dv_append(dv_find(result, "influence_consequences", []), {"speech_event": speech.source_event, "parse_event": speech.parse_event, "selection_event": selection.event, "execution_event": event, "action": action.id, "time": time, "basis": influence.basis, "record_kind": "post-advice-matching-behavior", "causal_attribution": "not-established", "consequence_transition": "not-assessed"}))
                i = i + 1
    return result

// An explicit speech declaration records intent only after actual emission
// and audible parsing. No forecast enters this provenance ledger.
fn dvs_receive_player_influence(listener, speech, speaker, source, parse_event):
    let manipulation = dv_find(speech, "manipulation", false)
    if manipulation == false or dv_find(speech, "actual_influence_actor", dv_find(speech, "actual_player_actor", "")) != speaker or dv_find(speech, "actual_literal_truth", "unknown") != "true":
        return listener
    if not dv_has(dv_find(manipulation, "targets", []), listener.id) or rt_count(dv_find(manipulation, "basis", [])) == 0:
        return listener
    let receipt = {"player": speaker, "control": dv_find(speech, "actual_influence_control", "player"), "target": listener.id, "method": manipulation.method, "speech_event": source, "parse_event": parse_event, "declaration": manipulation}
    return dv_with(listener, "pending_player_influences", dv_append(dv_find(listener, "pending_player_influences", []), receipt))

// Advice is a received recommendation, never a granted fact or an action order.
fn dvs_receive_advice(listener, speech, speaker, source, parse_event, literal):
    let proposal = dv_find(speech, "advice", false)
    if proposal == false:
        return listener
    if not dv_has(dv_find(proposal, "targets", []), listener.id) or rt_count(dv_find(proposal, "basis", [])) == 0:
        return listener
    dv_require(dv_has_key(proposal, "id") and dv_has_key(proposal, "position"), "Advice needs an identity and a recommendation position")
    let receipt = {"id": proposal.id, "speaker": speaker, "source_event": source, "parse_event": parse_event, "literal": literal, "proposal": proposal, "meaning": "recommendation-received-not-adopted-or-executed"}
    return dv_with_many(listener, {"received_advice": dv_with(dv_find(listener, "received_advice", []), proposal.id, receipt), "advice_receipts": dv_append(dv_find(listener, "advice_receipts", []), receipt)})

// Reuse the owner's existing action motivation/risk formula, without changing its
// inputs, granting a forecast or attaching resonance to the response action.
fn dvs_advice_assessment(actor, receipt, action_id, mind):
    if not dv_has(dv_find(receipt.proposal, "proposed_action_ids", []), action_id):
        return false
    let target = dvp_find_action(actor.actions, action_id)
    if target == false:
        return false
    let resonance = dv_find(target, "resonance", false)
    if resonance == false:
        let choice = dv_find(target, "personal_choice", false)
        let order = dv_find(actor.policy, "value_order", [])
        if choice == false or rt_count(order) == 0 or rt_count(dv_find(actor.policy, "value_basis", [])) == 0:
            return false
        let ready = dv_truth(mind, target.precondition) == "true" and dvp_personal_ready(mind, choice) and dvp_normative_ready(actor, target, mind)
        var impact = 0
        var i = 0
        while i < rt_count(order) and impact == 0:
            impact = dvp_personal_impact(choice, order[i])
            i = i + 1
        var accepted = false
        if receipt.proposal.position == "consider":
            accepted = ready and impact > 0
        if receipt.proposal.position == "avoid":
            accepted = ready and impact <= 0
        if receipt.proposal.position == "owner-decides":
            accepted = ready
        return {"accepted": accepted, "target_action": action_id, "assessment_kind": "existing-owner-ordinal-values", "first_impact": impact, "requires_truth": dv_truth(mind, target.precondition), "basis": dv_find(actor.policy, "value_basis", []), "value_order": order, "choice": choice, "meaning": "owner-assessment-only; acceptance-does-not-execute-or-reweight-target"}
    if dv_find(resonance, "passive", false):
        return false
    let requires = dv_find(resonance, "requires", dv_true())
    let ready = dv_truth(mind, requires) == "true" and 0 < rt_count(dv_find(resonance, "basis", []))
    let utility = dvp_resonance_utility(actor, target, mind)
    var accepted = false
    if receipt.proposal.position == "consider":
        accepted = ready and utility > 0
    if receipt.proposal.position == "avoid":
        accepted = ready and utility <= 0
    if receipt.proposal.position == "owner-decides":
        accepted = ready
    return {"accepted": accepted, "target_action": action_id, "assessment_kind": "existing-owner-resonance-utility", "utility": utility, "requires_truth": dv_truth(mind, requires), "basis": resonance.basis, "inputs": {"drive": dvp_owned_quantity(actor, mind, resonance.drive), "relevance": dvp_owned_quantity(actor, mind, resonance.relevance), "truth_bonus": dvp_owned_quantity(actor, mind, resonance.truth_bonus), "caution": dvp_owned_quantity(actor, mind, resonance.caution), "perceived_risk": dvp_owned_quantity(actor, mind, resonance.perceived_risk)}, "meaning": "owner-assessment-only; acceptance-does-not-execute-or-reweight-target"}

fn dvs_advice_decision_ready(actor, action, mind):
    let decision = dv_find(action, "advice_decision", false)
    if decision == false:
        return true
    let receipt = dv_find(dv_find(actor, "received_advice", []), decision.advice_id, false)
    if receipt == false or receipt.source_event == "" or receipt.parse_event == "":
        return false
    let stance = dv_find(dv_find(actor, "advice_stances", []), decision.advice_id, false)
    if stance != false and dv_find(stance, "parse_event", "") == receipt.parse_event:
        return false
    let assessment = dvs_advice_assessment(actor, receipt, decision.assessment_action_id, mind)
    return assessment != false and assessment.accepted == decision.accepted

// A declared behavioral effect must actually execute and its physical consequence
// must become true. Intent, interpretation and prediction do not count as outcome.
fn dvs_complete_player_influences(actor, action, before, after, success, events, event, time):
    if not success:
        return actor
    let pending = dv_find(actor, "pending_player_influences", [])
    if rt_count(pending) == 0:
        return actor
    var retained = []
    var history = dv_find(actor, "player_influence_history", [])
    var i = 0
    while i < rt_count(pending):
        let influence = pending[i]
        let declaration = influence.declaration
        var completed = false
        let selection = dvs_heard_before_selection(events, actor, action, event, influence.parse_event, influence.speech_event)
        if selection != false and dv_has(dv_find(declaration, "action_ids", []), action.id):
            let prior = dv_truth(before, declaration.consequence_when)
            let actual = dv_truth(after, declaration.consequence_when)
            if prior != "true" and actual == "true":
                var stance = dv_find(dv_find(actor, "advice_stances", []), dv_find(declaration, "advice_id", ""), false)
                if stance != false:
                    let stance_position = dvs_recorded_event_position(events, stance.event)
                    if stance.parse_event != influence.parse_event or stance_position < 0 or selection.position <= stance_position:
                        stance = false
                history = dv_append(history, {"player": influence.player, "control": dv_find(influence, "control", "player"), "target": actor.id, "method": influence.method, "speech_event": influence.speech_event, "parse_event": influence.parse_event, "selection_event": selection.event, "execution_event": event, "action": action.id, "time": time, "consequence": declaration.consequence_when, "before": prior, "after": actual, "basis": declaration.basis, "advice_stance_before_selection": stance, "record_kind": "post-advice-matching-behavior", "causal_attribution": "not-established"})
                completed = true
        if not completed:
            rt_push(retained, influence)
        i = i + 1
    return dv_with_many(actor, {"pending_player_influences": retained, "player_influence_history": history})

// ---- Merged source module: 18-requests.dv ----
// Requests are received speech; replies remain the other subject's paid action.

fn dvs_pending_request(actor, action):
    var topic = dv_find(action, "response_topic", "")
    var requests = dv_find(actor, "received_requests", [])
    var answered = dv_find(actor, "answered_requests", [])
    var result = []
    var i = 0
    while dv_and((rt_count(result) == 0), (i < rt_count(requests))):
        var request = requests[i]
        if dv_and((request.topic == topic), (not dv_has(answered, request.parse_event))):
            var matches = dv_find(action, "response_requester", request.requester) == request.requester
            let request_action = dv_find(action, "response_request_action", "")
            if request_action != "":
                matches = false
                let receipts = dv_find(actor, "received_speeches", [])
                var receipt_index = 0
                while receipt_index < rt_count(receipts):
                    let receipt = receipts[receipt_index]
                    if receipt.parse_event == request.parse_event and receipt.speaker == request.requester and receipt.action_id == request_action and dv_find(action, "response_requester", request.requester) == request.requester:
                        matches = true
                    receipt_index = receipt_index + 1
            if matches:
                result = request
        i = (i + 1)
    return result

fn dvs_receive_request(actor, speech, parse_event, source, speaker):
    var request = dv_find(speech, "request", false)
    if (request == false):
        return actor
    else:
        if (request.target == actor.id):
            return dv_with(actor, "received_requests", dv_append(dv_find(actor, "received_requests", []), dv_with_many({"topic": request.topic, "parse_event": parse_event, "source_event": source}, {"requester": speaker, "request": request})))
        else:
            return actor

fn dvs_finish_reply(actor, action):
    var request = dvs_pending_request(actor, action)
    if (0 < rt_count(request)):
        return dv_with(actor, "answered_requests", dv_append(dv_find(actor, "answered_requests", []), request.parse_event))
    else:
        return actor

fn dvs_record_request(actor, action):
    var request = dv_find(dv_find(action, "speech", []), "request", false)
    if (request == false):
        return actor
    else:
        return dv_with(actor, "request_contexts", dv_with(dv_find(actor, "request_contexts", []), action.id, dvs_request_context(actor, action, request.target)))

fn dvs_request_inputs(mind, proposition):
    let refs = dvs_sim_refs(proposition)
    var inputs = []
    var i = 0
    while i < rt_count(refs):
        let cell = dv_read(mind, refs[i])
        rt_push(inputs, {"ref": refs[i], "known": dv_find(cell, "known", false), "value": dv_find(cell, "value", false), "conflicted": dv_find(cell, "conflicted", false)})
        i = i + 1
    return {"inputs": inputs, "truth": dv_truth(mind, proposition)}

fn dvs_request_context(actor, action, target):
    let topic = dv_find(dv_find(dv_find(action, "speech", []), "request", []), "topic", dv_find(action, "response_topic", ""))
    let visible = dv_find(dv_find(actor, "visible_context", []), target, false)
    if (visible != false):
        return {"target": target, "topic": topic, "location": visible.location, "presence_event": dv_find(actor, "visible_context_event", ""), "inputs": dvs_request_inputs(actor.mind, action.precondition)}
    let transport = dv_find(action, "request_transport", false)
    if (transport == false):
        return false
    let channels = dv_find(actor, "request_channels", [])
    var i = 0
    while (i < rt_count(channels)):
        let channel = channels[i]
        if (channel.target == target and channel.channel == transport.channel and 0 < rt_count(channel.basis)):
            if (dv_truth(actor.mind, channel.available_when) == "true"):
                return {"target": target, "topic": topic, "channel": channel.channel, "basis": channel.basis, "inputs": dvs_request_inputs(actor.mind, action.precondition), "channel_inputs": dvs_request_inputs(actor.mind, channel.available_when)}
        i = i + 1
    return false

fn dvs_visible_context(actor, physical, actors):
    actor = rt_snapshot(actor)
    physical = rt_snapshot(physical)
    actors = rt_snapshot(actors)
    var result = []
    if dv_truth(physical, dv_find(actor.policy, "visual_identity_when", dv_true())) != "true":
        return result
    var own = dv_read(physical, actor.location_ref)
    var i = 0
    while (i < rt_count(actors)):
        var other = actors[i]
        var position = dv_read(physical, actors[i].location_ref)
        if not dv_cognition_hidden(actor.mind, other.id) and (other.id != actor.id) and dv_uncontested(own) and dv_uncontested(position) and dv_same(own.value, position.value):
            if dv_truth(physical, dv_find(other, "observable_presence_when", dv_true())) == "true":
                result = dv_with(result, other.id, {"location": position.value})
        i = (i + 1)
    return result

// A clear room can contradict a remembered presence, but cannot reveal the
// missing person's new location. Conditional visibility is not exhaustive:
// keep those memories unchanged rather than treating concealment as absence.
fn dvs_absent_peer_locations(actor, actors, bindings, context, location, clear):
    var result = []
    if not clear:
        return result
    let observed = dv_project_value(location, bindings, actor.id)
    if not observed.known:
        return result
    var i = 0
    while i < rt_count(actors):
        let peer = actors[i]
        if peer.id != actor.id and dv_find(context, peer.id, false) == false and dv_same(dv_find(peer, "observable_presence_when", dv_true()), dv_true()):
            let projected = dv_project_value(peer.location_ref, bindings, actor.id)
            if projected.known:
                let before = dv_read(actor.mind, projected.value)
                if dv_uncontested(before) and dv_same(before.value, observed.value):
                    rt_push(result, {"ref": projected.value, "before": before})
        i = i + 1
    return result

fn dvs_notice_peers(actor, physical, actors, bindings, events, time, parent):
    if dv_find(actor.policy, "notice_co_presence", false):
        var context = dvs_visible_context(actor, physical, actors)
        var old = dv_find(actor, "visible_context", [])
        let position = dv_read(physical, actor.location_ref)
        var location = false
        if dv_uncontested(position):
            location = position.value
        let clear = location != false and dv_truth(physical, dv_find(actor.policy, "visual_identity_when", dv_true())) == "true"
        let absent = dvs_absent_peer_locations(actor, actors, bindings, context, location, clear)
        if rt_count(absent) == 0 and dv_same(context, old) and dv_find(actor, "visible_context_location", false) == location and dv_find(actor, "visible_context_clear", false) == clear:
            return actor
        else:
            var event = dvs_event(events, "co_presence", actor.id, time, dvs_cognitive_parents(actor, dv_single(parent)), {"context_before": old, "context_after": context, "location_ref": actor.location_ref, "observed_location": location, "visibility_available": clear})
            var grants = []
            var i = 0
            while i < rt_count(actors):
                let peer = actors[i]
                let now = dv_find(context, peer.id, false)
                let previous = dv_find(old, peer.id, false)
                if now != false and (previous == false or previous.location != now.location):
                    rt_push(grants, peer.location_ref)
                i = i + 1
            var mind = actor.mind
            if 0 < rt_count(grants):
                let observations = dv_perceive(physical, actor.mind, bindings, grants, event, time)
                if 0 < rt_count(observations):
                    let next = dv_update_mind(mind, observations, mind.revision, dvs_observation_profile(actor)).world
                    event = dvs_event_prepared(events, "observation", actor.id, time, dv_single(event), {"observations": observations, "revision_before": mind.revision, "revision_after": next.revision, "bindings": bindings, "grants": grants, "execution_id": event})
                    mind = next
            if 0 < rt_count(absent):
                let revision = mind.revision
                event = dvs_event(events, "presence_memory_retracted", actor.id, time, dvs_cognitive_parents(actor, [event]), {"retracted": absent, "observed_location": location, "revision_before": revision, "revision_after": revision + 1, "scope": "clear-room-absence-new-location-unknown"})
                var j = 0
                while j < rt_count(absent):
                    let unknown = dv_with_many(dv_unknown(), {"time": time, "basis": [event]})
                    mind = dv_store(mind, absent[j].ref, unknown)
                    j = j + 1
                mind = dv_with_many(mind, {"revision": revision + 1, "time": dv_max(dv_find(mind, "time", 0), time)})
            return dv_with_many(actor, {"visible_context": context, "visible_context_location": location, "visible_context_clear": clear, "visible_context_event": event, "mind": mind, "last_cognitive_event": event})
    else:
        return actor

// Content explicitly declares which neutral state fields can be seen from
// the same room. A container's children are not in that room, and identities,
// contents and inspection evidence are absent unless separately declared.
fn dvs_visible_object_catalog(objects):
    objects = rt_snapshot(objects)
    let key = ["visible-object-catalog-v1"]
    let cached = dvs_declaration_cache_get(objects, key)
    if cached[0]:
        return cached[1]
    var rooms = []
    var i = 0
    while i < rt_count(objects):
        let object = objects[i][1]
        let fields = dv_find(object, "visible_fields", [])
        if 0 < rt_count(fields):
            let state = dv_find(object.facets, "state", [])
            let location = dv_find(state, "location", dv_unknown())
            if dv_uncontested(location) and rt_is_text(location.value):
                var visible = []
                var j = 0
                while j < rt_count(fields):
                    let cell = dv_find(state, fields[j], dv_unknown())
                    if dv_uncontested(cell):
                        rt_push(visible, dv_pair(fields[j], cell))
                    j = j + 1
                let room = dv_find(rooms, location.value, [])
                rooms = dv_with(rooms, location.value, dv_with(room, object.id, visible))
        i = i + 1
    return dvs_declaration_cache_put(objects, key, rooms)

fn dvs_visible_objects(actor, physical):
    if not dv_find(actor.policy, "notice_visible_objects", false):
        return []
    if dv_truth(physical, dv_find(actor.policy, "visual_identity_when", dv_true())) != "true":
        return []
    let own = dv_read(physical, actor.location_ref)
    if not dv_uncontested(own) or not rt_is_text(own.value):
        return []
    let visible = dv_find(dvs_visible_object_catalog(physical.objects), own.value, [])
    var filtered = []
    var i = 0
    while i < rt_count(visible):
        if not dv_cognition_hidden(actor.mind, visible[i][0]):
            rt_push(filtered, visible[i])
        i = i + 1
    return filtered

fn dvs_notice_visible_objects(actor, physical, bindings, events, time, parent):
    if not dv_find(actor.policy, "notice_visible_objects", false):
        return actor
    let context = dvs_visible_objects(actor, physical)
    let previous = dv_find(actor, "visible_objects", [])
    if dv_same(context, previous):
        return actor
    var grants = []
    var i = 0
    while i < rt_count(context):
        let object = context[i]
        let old_fields = dv_find(previous, object[0], [])
        var j = 0
        while j < rt_count(object[1]):
            let field = object[1][j]
            if not dv_same(field[1], dv_find(old_fields, field[0], false)):
                rt_push(grants, dv_ref(object[0], "state", field[0]))
            j = j + 1
        i = i + 1
    var event = dvs_event(events, "room_perception", actor.id, time, dvs_cognitive_parents(actor, [parent]), {"visible_before": previous, "visible_after": context, "grants": grants, "scope": "actual-same-room-visible-fields"})
    var mind = actor.mind
    if 0 < rt_count(grants):
        let observations = dv_perceive(physical, mind, bindings, grants, event, time)
        if 0 < rt_count(observations):
            let next = dv_update_mind(mind, observations, mind.revision, dvs_observation_profile(actor)).world
            event = dvs_event_prepared(events, "observation", actor.id, time, [event], {"observations": observations, "revision_before": mind.revision, "revision_after": next.revision, "bindings": bindings, "grants": grants, "execution_id": event})
            mind = next
    return dv_with_many(actor, {"visible_objects": context, "mind": mind, "last_cognitive_event": event})

fn dvs_notice_movement_witnesses(actors, moving_index, before, physical, bindings, events, time, parent):
    let mover = actors[moving_index]
    if not dv_has_key(mover, "location_ref"):
        return actors
    let origin = dv_read(before, mover.location_ref)
    let destination = dv_read(physical, mover.location_ref)
    if not dv_uncontested(origin) or not dv_uncontested(destination) or origin.value == destination.value:
        return actors
    var result = actors
    var i = 0
    while i < rt_count(result):
        if i != moving_index and dv_has_key(result[i], "location_ref"):
            let position = dv_read(physical, result[i].location_ref)
            if dv_uncontested(position) and (position.value == origin.value or position.value == destination.value):
                result = dvs_replace(result, i, dvs_notice_peers(result[i], physical, result, bindings, events, time, parent))
        i = i + 1
    return result

fn dvs_visible_action_grants(actors, speaker_index, action, before, physical, bindings, events, time, parent, execution_id):
    var listeners = dv_find(action, "public_observers", [])
    var grants = dv_find(action, "visual_grants", dv_find(action, "public_grants", []))
    if rt_count(listeners) == 0 or rt_count(grants) == 0:
        return actors
    var speaker = actors[speaker_index]
    var result = actors
    var i = 0
    var own = dv_read(physical, actors[speaker_index].location_ref)
    var origin = dv_read(before, actors[speaker_index].location_ref)
    while (i < rt_count(actors)):
        var actor = result[i]
        if (i != speaker_index) and dv_has(listeners, actor.id):
            var position = dv_read(physical, actor.location_ref)
            var position_before = dv_read(before, actor.location_ref)
            var present_after = dv_and(dv_uncontested(own), dv_and(dv_uncontested(position), dv_same(own.value, position.value)))
            var present_at_departure = action.kind == "move" and dv_and(dv_uncontested(origin), dv_and(dv_uncontested(position_before), dv_same(origin.value, position_before.value)))
            if dv_or(present_after, present_at_departure) and (dv_truth(physical, dv_find(actor.policy, "visual_identity_when", dv_true())) == "true"):
                var mind = actor.mind
                var observations = dv_perceive(physical, actor.mind, bindings, grants, execution_id, time)
                if (0 < rt_count(observations)):
                    var next = dv_update_mind(mind, observations, mind.revision, dvs_observation_profile(actor)).world
                    var event = dvs_event_prepared(events, "observation", actor.id, time, dvs_cognitive_parents(actor, dv_single(parent)), dv_with_many({"observations": observations, "revision_before": mind.revision, "revision_after": next.revision, "action": action}, {"bindings": bindings, "grants": grants, "execution_id": execution_id}))
                    result = dvs_replace(result, i, dv_with_many(actor, {"mind": next, "last_cognitive_event": event}))
        i = (i + 1)
    return result


// Planning retains cognition and revision; append-only audit logs are not decision inputs.
fn dvp_question(actor):
    if dv_has_key(actor, "question_ref"):
        var cell = dv_read(actor.mind, actor.question_ref)
        if dv_uncontested(cell):
            return cell.value
        else:
            return ""
    else:
        return ""

fn dvp_topic(actor, item):
    if dv_find(item, "scope", "") == "personal" and 0 < rt_count(dv_find(item, "basis", [])):
        return true
    var topic = dv_find(item, "question", dv_find(item, "topic", ""))
    var question = dvp_question(actor)
    var bindings = dv_find(actor.policy, "topic_bindings", [])
    // Preserve the original item/question/binding read order before caching.
    // The full mind plus all external inputs determines this pure Bool.
    let mind = dv_find(actor, "mind", false)
    if not rt_is_list(mind):
        return dvp_topic_scan(actor, topic, question, bindings)
    let key = ["dvp_topic", item, dv_has_key(actor, "question_ref"), dv_find(actor, "question_ref", false), bindings, dv_find(actor, "heard_topics", [])]
    let cached = dvs_plan_cache_get(mind, key)
    if cached[0]:
        return cached[1]
    return dvs_plan_cache_put(mind, key, dvp_topic_scan(actor, topic, question, bindings))

fn dvp_topic_scan(actor, topic, question, bindings):
    var i = 0
    var active = false
    if dv_and((not (question == "")), (topic == question)):
        active = true
    while (i < rt_count(bindings)):
        var binding = bindings[i]
        if dv_and((binding.topic == topic), dv_and((0 < rt_count(dv_find(binding, "basis", []))), dv_and(dv_or(dvs_topic_was_heard(actor, topic), (dv_truth(actor.mind, binding.heard_when) == "true")), (not (dv_truth(actor.mind, binding.completed_when) == "true"))))):
            active = true
        i = (i + 1)
    return active

fn dvp_add_ref(refs, ref):
    if dv_has(refs, ref):
        return refs
    else:
        return dv_append(refs, ref)

fn dvp_merge_refs(refs, extra):
    var result = refs
    var i = 0
    while (i < rt_count(extra)):
        result = dvp_add_ref(result, extra[i])
        i = (i + 1)
    return result

fn dvp_unmet_refs(mind, proposition, include_known):
    var op = proposition.op
    if (op == "constant"):
        return []
    else:
        if (op == "not"):
            return dvp_unmet_refs(mind, proposition.item, include_known)
        else:
            if (op == "all"):
                var items = proposition.items
                var result = []
                var i = 0
                while (i < rt_count(items)):
                    result = dvp_merge_refs(result, dvp_unmet_refs(mind, items[i], include_known))
                    i = (i + 1)
                return result
            else:
                if dv_or(include_known, (not (dv_truth(mind, proposition) == "true"))):
                    if op == "held_for":
                        return [proposition.ref, proposition.clock]
                    return dv_single(proposition.ref)
                else:
                    return []

fn dvp_goal_refs(actor):
    var goals = dv_find(actor.policy, "goals", [])
    var mind = actor.mind
    var refs = []
    var i = 0
    while (i < rt_count(goals)):
        var goal = goals[i]
        if dv_and(dvp_topic(actor, goal), (dv_truth(actor.mind, dv_find(goal, "available_when", dv_true())) == "true")):
            if dv_has_key(goal, "ref"):
                if dv_find(goal, "kind", "know") != "evidence" or dvp_evidence_due(actor, goal):
                    refs = dvp_add_ref(refs, goal.ref)
            else:
                if dv_has_key(goal, "proposition"):
                    refs = dvp_merge_refs(refs, dvp_unmet_refs(mind, goal.proposition, true))
        i = (i + 1)
    return refs

fn dvp_scope(actor, action, bindings):
    let key = ["dvp-owned-action-scope-v1", actor.id, bindings]
    let cached = dvs_plan_cache_get(action, key)
    if cached[0]:
        return cached[1]
    var declared = dv_find(action, "purpose_refs", [])
    var grants = dv_find(action, "grants", [])
    var refs = declared
    var i = 0
    while (i < rt_count(grants)):
        var ref = grants[i]
        if dv_has_key(ref, "object"):
            var local = dv_local(bindings, ref.object, actor.id)
            if (local == ""):
                false
            else:
                refs = dvp_add_ref(refs, dv_ref(local, ref.facet, ref.field))
        i = (i + 1)
    return dvs_plan_cache_put(action, key, refs)

fn dvp_answer_reward(actor, action, mind):
    if dv_find(action, "answer_form", "complete-answer") == "supporting-statement":
        return 0
    if dv_has_key(action, "answer"):
        if (dv_truth(mind, action.answer) == "true"):
            return 1.0
        else:
            if dv_and(dv_has_key(actor, "argument"), (dv_find(dv_find(actor, "argument", []), "question", "") == dv_find(action, "argument_question", ""))):
                return 1.0
            else:
                var hypothesis = dv_find(actor, "hypothesis", false)
                if (hypothesis == false):
                    return 0
                else:
                    if dv_same(hypothesis.proposition, action.answer):
                        return dv_find(hypothesis, "prior", 0.5)
                    else:
                        return 0
    else:
        return 0

fn dvp_input_signature(actor, action, refs):
    var mind = actor.mind
    var inputs = []
    var i = 0
    var local_1 = false
    if dv_has_key(action, "answer"):
        local_1 = dvs_sim_refs(action.answer)
    else:
        local_1 = []
    var selected = dvp_merge_refs(refs, local_1)
    if dv_has_key(action, "support"):
        selected = dvp_merge_refs(selected, dvs_sim_refs(action.support))
    while (i < rt_count(selected)):
        rt_push(inputs, {"ref": selected[i], "cell": dvs_reason_cell(dv_read(mind, selected[i]))})
        i = (i + 1)
    return dv_with({"question": dvp_question(actor), "claim": dv_find(action, "answer", false), "inputs": inputs}, "reward", dvp_answer_reward(actor, action, mind))

fn dvp_answer_relevant(actor, action):
    if dv_has_key(action, "topic"):
        return dvp_topic(actor, action)
    else:
        var refs = dvs_sim_refs(action.answer)
        var goals = dvp_goal_refs(actor)
        var i = 0
        var found = false
        while (i < rt_count(refs)):
            if dv_has(goals, refs[i]):
                found = true
            i = (i + 1)
        return found

fn dvp_answer_attempt_allowed(prev_sig, cur_sig):
    if (prev_sig == false):
        return true
    else:
        if (not dv_same(prev_sig.inputs, cur_sig.inputs)):
            return true
        else:
            if (not dv_same(prev_sig.claim, cur_sig.claim)):
                return true
            else:
                if (not dv_same(prev_sig.question, cur_sig.question)):
                    return true
                else:
                    var r1 = dv_find(prev_sig, "reward", 0)
                    var r2 = dv_find(cur_sig, "reward", 0)
                    var local_1 = false
                    if (r1 < r2):
                        local_1 = (r2 - r1)
                    else:
                        local_1 = (r1 - r2)
                    var diff = local_1
                    return (not (diff < 0.2))

fn dvp_inspection_signature(actor, action, mind):
    let refs = dvp_merge_refs(dv_find(action, "grants", []), dvs_sim_refs(action.precondition))
    var inputs = []
    var i = 0
    while i < rt_count(refs):
        let cell = dv_read(mind, refs[i])
        rt_push(inputs, {"ref": refs[i], "known": cell.known, "value": cell.value, "conflicted": cell.conflicted})
        i = i + 1
    let evidence = dvp_inspection_freshness(actor, mind)
    var freshness = []
    i = 0
    while i < rt_count(refs):
        let entries = dv_find(evidence, dv_ref_lookup_key(refs[i]), [])
        var j = 0
        while j < rt_count(entries):
            rt_push(freshness, entries[j])
            j = j + 1
        i = i + 1
    return {"inputs": inputs, "freshness": freshness}

// Only personally known execution inputs release a rejected attempt. Numeric
// thresholds retain their truth, so an advancing clock alone cannot retry them.
fn dvp_rejected_condition_signature(mind, proposition):
    if proposition.op == "all":
        var items = []
        var i = 0
        while i < rt_count(proposition.items):
            rt_push(items, dvp_rejected_condition_signature(mind, proposition.items[i]))
            i = i + 1
        return items
    if proposition.op == "not":
        return dvp_rejected_condition_signature(mind, proposition.item)
    if proposition.op == "equals":
        let cell = dv_read(mind, proposition.ref)
        return {"ref": proposition.ref, "known": cell.known, "value": cell.value, "conflicted": cell.conflicted}
    return {"condition": proposition, "truth": dv_truth(mind, proposition)}

fn dvp_rejected_signature(actor, action, mind):
    let adoption = dv_find(mind.adoptions, dv_find(action, "predict_law", ""), false)
    var prediction = false
    if adoption != false:
        prediction = {"active": adoption.active, "mode": adoption.mode, "law": adoption.law, "inputs": dvp_rejected_condition_signature(mind, adoption.law.premise)}
    var location = false
    if dv_has_key(actor, "location_ref"):
        let cell = dv_read(mind, actor.location_ref)
        location = {"known": cell.known, "value": cell.value, "conflicted": cell.conflicted}
    var opportunity = false
    if dv_has_key(action, "opportunity_requirement"):
        opportunity = {"context": dv_find(actor, "visible_context", []), "observed_location": dv_find(actor, "visible_context_location", false), "visibility_available": dv_find(actor, "visible_context_clear", false)}
    var request_context = false
    let request = dv_find(dv_find(action, "speech", []), "request", false)
    if request != false:
        request_context = dvs_request_context(dvp_actor_view(actor, mind), action, request.target)
    return {"precondition": dvp_rejected_condition_signature(mind, action.precondition), "prediction": prediction, "location": location, "opportunity": opportunity, "request_context": request_context}

// A control retry token comes from a rejected native contact receipt or a
// verified source-side cancellation with exactly equal start/end positions.
// It never grants facts, bypasses subject admission, or changes AI retry guards.
// The host attests only a real, identity-checked manual cancellation in the
// source room. This authorizes a fresh input attempt, never a target success.
fn dvs_manual_continuous_cancel(action, receipt, subject):
    let field = dv_find(receipt, "field", [])
    let proof = dv_find(field, "continuous_cancel", false)
    if proof == false or not dv_record_like(proof):
        return false
    if dv_find(proof, "version", "") != "source-cancel-v1" or not dv_find(proof, "identity_verified", false):
        return false
    if action.kind != "move" or dv_has_key(dv_find(action, "travel", []), "station"):
        return false
    let travel = dv_find(action, "travel", [])
    if dv_find(travel, "from", "") == "" or dv_find(travel, "to", "") == "" or travel.from == travel.to:
        return false
    if dv_find(field, "kind", "") != "daily" or dv_find(field, "status", "") != "blocked" or not dv_find(field, "continuous_walk", false):
        return false
    if dv_find(field, "reason", "") != "released" or dv_find(proof, "reason", "") != "released":
        return false
    if dv_find(field, "who", "") != subject or dv_find(field, "action", "") != action.id or dv_find(proof, "actor", "") != subject or dv_find(proof, "action", "") != action.id or dv_find(proof, "action_event", "") != receipt.action_event:
        return false
    let request = dv_find(field, "request_id", "")
    let serial = dv_find(field, "serial", false)
    if request == "" or request != dv_find(proof, "request_id", "") or not rt_is_numeric_value(serial) or serial <= 0 or not dv_same(serial, dv_find(proof, "serial", false)):
        return false
    let from_room = dv_find(proof, "from_room", "")
    let to_room = dv_find(proof, "to_room", "")
    let map = dv_find(proof, "map", "")
    if from_room == "" or to_room == "" or from_room == to_room or map == "" or dv_find(field, "source_room", "") != from_room or dv_find(field, "room", "") != from_room or dv_find(field, "source_map", "") != map or dv_find(field, "map", "") != map:
        return false
    if not dv_same(dv_find(field, "transitions", false), []) or not dv_same(dv_find(proof, "transitions", false), []):
        return false
    let fields = ["source_position", "actual_position"]
    var i = 0
    while i < rt_count(fields):
        let position = dv_find(field, fields[i], false)
        if not rt_is_list(position) or rt_count(position) != 2 or not dv_same(position, dv_find(proof, fields[i], false)):
            return false
        if not rt_is_numeric_value(position[0]) or not rt_is_numeric_value(position[1]):
            return false
        i = i + 1
    if not dv_same(field.source_position, field.actual_position):
        return false
    let source_geometry = dv_find(field, "source_geometry", "")
    if not dv_has(["interior", "source-side-doorway"], source_geometry) or dv_find(proof, "source_geometry", "") != source_geometry:
        return false
    return true

fn dvs_manual_contact_failure(action, receipt, subject):
    if dv_find(receipt, "executor", "") != "godot" or dv_find(receipt, "outcome", "") != "rejected":
        return ""
    if dvs_manual_continuous_cancel(action, receipt, subject):
        return "native-continuous-source-cancel"
    let field = dv_find(receipt, "field", [])
    if dv_find(field, "executor", "") == "dv-world" and dv_find(field, "contact", true) == false:
        let site = dv_find(field, "site", "")
        if site != "" and site != "self":
            return "contact-out-of-reach"
    if dv_find(field, "kind", "") != "daily" or dv_find(field, "status", "") != "blocked" or dv_find(field, "who", "") != subject or dv_find(field, "action", "") != action.id or dv_find(field, "reason", "") != "":
        return ""
    let proof = ["station", "approach_point", "station_point", "station_radius", "arrival_tolerance", "actual_position", "arrival_error"]
    var i = 0
    while i < rt_count(proof):
        if not dv_has_key(field, proof[i]):
            return ""
        i = i + 1
    return "native-motion-blocked"

fn dvp_eligible_base(actor, action, mind, relevant):
    // Rebuilt autonomous calendar waits are not stable manual choices.
    // Manual controllers use their explicitly declared wait intentions.
    if dv_find(actor, "manual_input", false) and dv_find(action, "known_opportunity_wait", false):
        return false
    let unknown_refs = dv_find(action, "unknown_refs", [])
    var unknown_index = 0
    while unknown_index < rt_count(unknown_refs):
        if dv_uncontested(dv_read(mind, unknown_refs[unknown_index])):
            return false
        unknown_index = unknown_index + 1
    let entity_lock = dv_find(actor, "simulation_entity_lock", false)
    if dv_find(action, "requires_entity_reservation", false) and entity_lock == false:
        return false
    if entity_lock != false and dv_find(entity_lock, "protecting", false) and not dv_find(action, "entity_hold_compatible", false):
        return false
    if dvs_action_requires_argument(action):
        if not dvs_argument_action_current(dvp_actor_view(actor, mind), action):
            return false
    if dv_find(action, "manual_only", false) and not dv_find(actor, "manual_input", false):
        return false
    var id = action.id
    // Success limits and attempt history are deliberately separate.
    var used = dv_find(actor, "completed_actions", [])
    // These branches end in exactly the same success-limit rejection. Avoid
    // rereading all premises and inspection evidence for a spent single-use
    // method; answers, speech and replay retain their separate retry rules.
    if not dv_has_key(action, "answer") and not dv_has_key(action, "speech") and action.kind != "replay":
        if dv_has(used, id) and (dv_find(action, "once", false) or not dv_find(action, "repeatable", false)):
            return false
    let retry = dv_find(dv_find(actor, "manual_contact_retries", []), id, false)
    let explicit_contact_retry = dv_find(actor, "manual_input", false) and retry != false and (dv_find(retry, "failure_class", "") != "native-continuous-source-cancel" or dv_same(dv_find(retry, "source_signature", false), dvp_rejected_signature(actor, action, mind)))
    let rejected = dv_find(dv_find(actor, "rejected_attempt_signatures", []), id, false)
    if rejected != false:
        if dv_same(rejected, dvp_rejected_signature(actor, action, mind)) and not explicit_contact_retry:
            return false
    if dv_and((not dv_find(actor, "cognition_blocked", false)), dv_and(dv_find(action, "argument_available", true), (dvs_dirty_truth(mind, action.precondition, actor.policy, action.id) == "true"))):
        if action.kind == "inspect":
            let inspection_actor = dvp_actor_view(actor, mind)
            if dv_same(dv_find(dv_find(actor, "inspection_attempt_signatures", []), id, false), dvp_inspection_signature(inspection_actor, action, mind)):
                if not (dv_find(actor, "manual_input", false) and dv_find(action, "manual_reinspect", false)):
                    return false
        if dv_has_key(action, "answer"):
            var local_1 = false
            if dv_has_key(action, "argument"):
                local_1 = 2
            else:
                local_1 = 1
            if dv_and(dvp_answer_relevant(actor, action), (dv_find(dv_find(actor, "accepted_answers", []), dv_find(action, "topic", ""), 0) < local_1)):
                var speech_ready = true
                if dv_has_key(action, "speech"):
                    speech_ready = (dvs_speech_truth(actor.mind, action.speech) == "true")
                return dv_and(speech_ready, dv_and((not (dv_truth(actor.mind, action.answer) == "false")), dvp_answer_attempt_allowed(dv_find(dv_find(actor, "answer_attempt_signatures", []), id, false), dvp_input_signature(actor, action, relevant))))
            else:
                return false
        else:
            if dv_has_key(action, "speech"):
                var local_2 = false
                if dv_has_key(action, "response_topic"):
                    var request = dvs_pending_request(actor, action)
                    if (0 < rt_count(request)):
                        local_2 = (dvs_request_context(actor, action, request.requester) != false)
                    else:
                        local_2 = not dv_find(action, "requires_actual_request", false) and dv_and((not dv_has(used, id)), dv_or(dv_has_key(dv_find(actor, "visible_context", []), dv_find(action, "offer_to", "")), dv_find(action, "opportunity_requirement", false) != false and dvp_communication_progress(actor, action)))
                else:
                    if dv_has_key(action.speech, "request"):
                        var context = dvs_request_context(actor, action, action.speech.request.target)
                        local_2 = dv_and((not (context == false)), (not dv_same(context, dv_find(dv_find(actor, "request_contexts", []), id, false))))
                    else:
                        local_2 = not dv_has(used, id) or (dv_find(action, "repeatable", false) and not dv_find(action, "once", false) and not dv_find(action, "response_once", false))
                return dv_and((dvs_speech_truth(actor.mind, action.speech) == "true"), local_2)
            else:
                if (action.kind == "replay"):
                    return 0 < dv_find(actor.policy, "model_budget", 0) and dvs_replay_has_available_candidate(dvp_actor_view(actor, mind)) and (not dv_same(dv_find(dv_find(actor, "replay_attempt_signatures", []), dvs_replay_attempt_key(action), false), dvs_replay_input_signature(actor, action, relevant)))
                else:
                    if dv_find(action, "once", false):
                        return (not dv_has(used, id))
                    else:
                        if dv_find(action, "repeatable", false):
                            return true
                        else:
                            return (not dv_has(used, id))
    else:
        return false

fn dvp_source_supported_since(cell, source, minimum_time):
    var claims = dv_find(cell, "claims", [])
    var i = 0
    var found = false
    while (i < rt_count(claims)):
        var claim = claims[i]
        if dv_and((claim.source == source), dv_same(claim.value, cell.value)) and minimum_time <= dv_find(claim, "time", 0):
            found = true
        i = (i + 1)
    return found

// A receipt required no earlier than a future instant cannot be earned by
// inspecting now. Keep the requirement pending until the real owner's clock
// reaches it; hypothetical writes never advance this evidence boundary.
fn dvp_evidence_due(actor, goal):
    let origin = dv_find(actor, "planning_evidence_mind", actor.mind)
    return dv_find(goal, "minimum_time", 0) <= dv_find(origin, "time", 0)

fn dvp_needs_evidence(actor, ref):
    var goals = dv_find(actor.policy, "goals", [])
    var i = 0
    var needed = false
    while (i < rt_count(goals)):
        var goal = goals[i]
        if dv_and(dvp_topic(actor, goal), (dv_truth(actor.mind, dv_find(goal, "available_when", dv_true())) == "true")):
            if (dv_find(goal, "kind", "know") == "evidence") and dvp_evidence_due(actor, goal):
                if dv_has_key(goal, "ref"):
                    if dv_same(goal.ref, ref):
                        var cell = dv_read(actor.mind, ref)
                        if dvp_source_supported_since(cell, dv_find(goal, "source", "perception"), dv_find(goal, "minimum_time", 0)):
                            false
                        else:
                            needed = true
        i = (i + 1)
    return needed

fn dvp_owned_task_ready(actor, goals):
    if not dv_find(actor.policy, "coordinate_owned_tasks", false):
        return false
    var i = 0
    while i < rt_count(goals):
        let goal = goals[i]
        if dv_find(goal, "scope", "") == "personal" and 0 < rt_count(dv_find(goal, "basis", [])) and dv_truth(actor.mind, dv_find(goal, "available_when", dv_true())) == "true":
            let kind = dv_find(goal, "kind", "")
            var pending = false
            if kind == "achieve" and dv_find(goal, "navigation_commitment", false):
                pending = dv_truth(actor.mind, goal.proposition) != "true"
            if kind == "evidence" and dv_has_key(goal, "ref") and dvp_evidence_due(actor, goal):
                pending = not dvp_source_supported_since(dv_read(actor.mind, goal.ref), dv_find(goal, "source", "perception"), dv_find(goal, "minimum_time", 0))
            if pending:
                var a = 0
                while a < rt_count(actor.actions):
                    let action = actor.actions[a]
                    let practical = kind == "evidence" and dv_find(action, "inquiry_purpose", "") == "practical-access" and dv_has(dv_find(action, "grants", []), goal.ref)
                    if (kind == "achieve" or practical) and dvp_eligible(actor, action, actor.mind, []) and dvp_personal_motivation(actor, action) >= 0:
                        if practical:
                            return true
                        if kind == "achieve":
                            let work = dvp_achievement_pending_work(actor, action, [goal])
                            if work.value > 0:
                                return true
                    a = a + 1
        i = i + 1
    return false

fn dvp_personal_motivation(actor, action):
    if not dv_has_key(action, "personal_choice"):
        return 0
    if not dv_find(actor.policy, "value_sensitive_progress", false):
        return 1
    let order = dv_find(actor.policy, "value_order", [])
    var i = 0
    while i < rt_count(order):
        let impact = dvp_personal_impact(action.personal_choice, order[i])
        if impact != 0:
            return impact
        i = i + 1
    return 0

// Initiative scales only the owner's anticipated informational benefit. Actual
// observations, legal actions, answers and physical effects remain unchanged.
fn dvp_extract_required_room(prop, loc_ref):
    if not dv_record_like(prop):
        return ""
    let op = dv_find(prop, "op", "")
    if op == "equals":
        let ref = dv_find(prop, "ref", false)
        if ref != false and dv_same(ref, loc_ref):
            let val = dv_find(prop, "value", "")
            if not dv_record_like(val):
                return val
    if op == "all":
        let items = dv_find(prop, "items", [])
        var i = 0
        let n = rt_count(items)
        while i < n:
            let r = dvp_extract_required_room(items[i], loc_ref)
            if r != "":
                return r
            i = i + 1
    return ""

fn dvp_find_action(actions, id):
    let key = ["dvp-find-action", id]
    let cached = dvs_declaration_cache_get(actions, key)
    if cached[0]:
        return cached[1]
    var i = 0
    var result = false
    while (i < rt_count(actions)):
        if (actions[i].id == id):
            result = actions[i]
        i = (i + 1)
    return dvs_declaration_cache_put(actions, key, result)

// A forecast may discard old co-presence but never discover a peer at a new
// location. The search carries this filtered record forward, so returning to a
// previous room does not restore a context discarded earlier on that branch.
fn dvp_view_visible_context(actor, mind):
    var result = []
    if not dv_has_key(actor, "location_ref"):
        return result
    let own = dv_read(mind, actor.location_ref)
    if not dv_uncontested(own):
        return result
    let previous = dv_find(actor, "visible_context", [])
    var i = 0
    while i < rt_count(previous):
        let entry = previous[i]
        if dv_find(entry[1], "location", false) == own.value:
            rt_push(result, entry)
        i = i + 1
    return result

fn dvp_actor_view(actor, mind):
    actor = rt_snapshot(actor)
    var result = []
    var i = 0
    while (i < rt_count(actor)):
        var entry = actor[i]
        var local_1 = false
        if (entry[0] == "mind"):
            local_1 = dv_pair("mind", mind)
        else:
            if entry[0] == "visible_context":
                local_1 = dv_pair("visible_context", dvp_view_visible_context(actor, mind))
            else:
                local_1 = entry
        rt_push(result, local_1)
        i = (i + 1)
    if dv_find(mind, "domain", "") == "prediction" and not dv_has_key(actor, "planning_evidence_mind"):
        result = dv_with(result, "planning_evidence_mind", actor.mind)
    return result

fn dvp_communication_progress(actor, action):
    var goals = dv_find(actor.policy, "goals", [])
    var i = 0
    var value = false
    while (i < rt_count(goals)):
        var goal = goals[i]
        if (dv_find(goal, "kind", "") == "communicate"):
            if dv_and((dv_find(goal, "method_id", "") == action.id), dv_and((0 < rt_count(dv_find(goal, "basis", []))), (dv_truth(actor.mind, dv_find(goal, "available_when", {"op": "constant", "value": "true"})) == "true"))):
                if dv_and(dv_find(goal, "requires_argument", false), dv_find(action, "speech_from_argument", false)):
                    if dv_find(action, "argument_available", false):
                        value = true
                if not dv_find(goal, "requires_argument", false):
                    value = true
        i = (i + 1)
    return value

fn dvp_achievement_pending_work(actor, action, pending):
    var i = 0
    if rt_count(pending) == 0:
        return {"value": 0, "forecasts": 0, "forecast_reuses": 0}
    let name = dv_find(action, "predict_law", "")
    let adoption = dv_find(actor.mind.adoptions, name, false)
    if adoption == false:
        return {"value": 0, "forecasts": 0, "forecast_reuses": 0}
    if not adoption.active or adoption.mode != "predict":
        return {"value": 0, "forecasts": 0, "forecast_reuses": 0}
    var relevant = false
    i = 0
    while i < rt_count(pending) and not relevant:
        var refs = []
        if dv_has_key(pending[i], "planning_refs"):
            refs = pending[i].planning_refs
        else:
            refs = dvs_sim_refs(pending[i].proposition)
        var j = 0
        while j < rt_count(adoption.law.effects) and not relevant:
            var r = 0
            while r < rt_count(refs):
                if dv_same_local_ref(actor.id, adoption.law.effects[j].ref, refs[r]):
                    relevant = true
                r = r + 1
            j = j + 1
        i = i + 1
    if not relevant:
        return {"value": 0, "forecasts": 0, "forecast_reuses": 0}
    let prediction = dvp_forecast(actor.mind, name)
    var forecasts = 1
    var reuses = 0
    if dv_find(prediction, "planning_cache_hit", false):
        forecasts = 0
        reuses = 1
    if prediction.status != "applied":
        return {"value": 0, "forecasts": forecasts, "forecast_reuses": reuses}
    var value = 0
    i = 0
    while i < rt_count(pending):
        if dv_truth(prediction.world, pending[i].proposition) == "true":
            value = value + dv_find(pending[i], "weight", 1)
        i = i + 1
    return {"value": value, "forecasts": forecasts, "forecast_reuses": reuses}

// Only declared relevant received references can refresh an evidence requirement.
fn dvp_refresh_current_evidence(actor, goals):
    var result = []
    var i = 0
    while i < rt_count(goals):
        var goal = goals[i]
        if dv_find(goal, "kind", "") == "evidence" and dv_has_key(goal, "refresh_until"):
            if dv_truth(actor.mind, goal.refresh_until) != "true":
                if dv_has_key(goal, "refresh_refs"):
                    var relevant_time = dv_find(goal, "minimum_time", 0)
                    var r = 0
                    while r < rt_count(goal.refresh_refs):
                        let cell = dv_read(actor.mind, goal.refresh_refs[r])
                        if cell.known:
                            relevant_time = dv_max(relevant_time, dv_find(cell, "time", 0))
                        r = r + 1
                    goal = dv_with(goal, "minimum_time", relevant_time)
        rt_push(result, goal)
        i = i + 1
    return result

// Pure prediction only; this cache never writes actual action or evidence events.
fn dvp_forecast(mind, name):
    let key = ["dvp_forecast", name]
    let cached = dvs_plan_cache_get(mind, key)
    if cached[0]:
        return dv_with(cached[1], "planning_cache_hit", true)
    let result = dv_predict(dv_with_many(mind, {"domain": "mind", "history": [], "seen": []}), name, rt_cat("planning-forecast-", rt_show(mind.revision)), dv_find(mind, "time", 0), mind.revision)
    dvs_plan_cache_put(mind, key, result)
    return dv_with(result, "planning_cache_hit", false)

// Catalog-only filtering; dynamic eligibility is still checked on the node mind.
fn dvp_inspection_freshness(actor, mind):
    let declared = dv_find(actor.policy, "goals", [])
    let key = ["dvp_inspection_freshness-ref-key-v1", declared]
    let cached = dvs_plan_cache_get(mind, key)
    if cached[0]:
        return cached[1]
    let goals = dvp_refresh_current_evidence(dvp_actor_view(actor, mind), declared)
    var index = []
    var i = 0
    while i < rt_count(goals):
        let goal = goals[i]
        if dv_find(goal, "kind", "") == "evidence" and dv_has_key(goal, "ref"):
            let name = dv_ref_lookup_key(goal.ref)
            let entries = dv_append(dv_find(index, name, []), {"ref": goal.ref, "minimum_time": dv_find(goal, "minimum_time", 0), "available": dv_truth(mind, dv_find(goal, "available_when", dv_true())), "due": dvp_evidence_due(actor, goal)})
            // Private construction; publish only the complete independent index.
            let owned_entries = dv_clone(entries)
            let position = rt_record_index(index, name)
            let pair = [name, owned_entries]
            if 0 <= position:
                rt_replace(index, position, pair)
            else:
                rt_push(index, pair)
        i = i + 1
    return dvs_plan_cache_put(mind, key, index)


// Structured speech: authority is checked by execution, cognition by each owner.
// Only positive equals atoms support testimony cells. Other ASTs remain speech records.
// A received estimated proposal is a public record before any personal adoption.
// Only an owner's declared policy can authorize its bounded testimony support.
// Speech exposes cue identity only. Conclusions and priors belong to local rules.
// Model reception is hypothetical testimony into a private copied prediction world.
// Neither the model nor its alternatives is sourced from another actor's real mind.
// A complete candidate layer is quoted before any prediction is evaluated.
// Work draws only from the existing total model budget, never replay-work allowance.
// Reassessment consumes personal reasoning and withdraws only a scoped interpretation.
// New personal evidence can defeat an earlier interpretation without new speech.
// This operation never writes observations or negates the interpreted proposition.

fn dvs_speech_cognitive_parents(parents, previous):
    if dv_or((previous == ""), dv_has(parents, previous)):
        return parents
    else:
        return dv_append(parents, previous)

fn dvs_speech_ast_nodes(ast):
    var op = ast.op
    var count = 1
    if (op == "not"):
        count = (count + dvs_speech_ast_nodes(ast.item))
    else:
        if (op == "all"):
            var items = ast.items
            var i = 0
            while (i < rt_count(items)):
                count = (count + dvs_speech_ast_nodes(items[i]))
                i = (i + 1)
    return count

fn dvs_speech_map(mind, proposition, bindings):
    var op = proposition.op
    if (op == "constant"):
        return proposition
    else:
        if (op == "all"):
            var mapped = []
            var i = 0
            var items = proposition.items
            while (i < rt_count(items)):
                rt_push(mapped, dvs_speech_map(mind, items[i], bindings))
                i = (i + 1)
            return dv_all(mapped)
        else:
            if (op == "not"):
                return dv_not(dvs_speech_map(mind, proposition.item, bindings))
            else:
                var ref = proposition.ref
                var local = dv_local(bindings, ref.object, mind.subject)
                if (local == ""):
                    if dv_has_key(mind.objects, ref.object):
                        return proposition
                    else:
                        return {"op": "constant", "value": "unknown"}
                else:
                    return dv_with(proposition, "ref", dv_ref(local, ref.facet, ref.field))

fn dvs_speech_truth(mind, speech):
    return dv_truth(mind, dvs_speech_map(mind, speech.literal_ast, dv_find(speech, "referents", [])))

fn dvs_speech_presuppositions(mind, speech):
    var items = dv_find(speech, "presuppositions", [])
    var bindings = dv_find(speech, "referents", [])
    var i = 0
    var result = []
    while (i < rt_count(items)):
        var proposition = dvs_speech_map(mind, items[i], bindings)
        rt_push(result, {"proposition": proposition, "truth": dv_truth(mind, proposition)})
        i = (i + 1)
    return result

fn dvs_emission_location(speaker, speech, physical):
    let ref = dv_find(speech, "emission_location_ref", speaker.location_ref)
    let cell = dv_read(physical, ref)
    if dv_uncontested(cell):
        return cell.value
    return ""

fn dvs_auditory_access(actor, physical):
    return dv_truth(physical, dv_find(actor, "auditory_access_when", dv_true())) == "true"

fn dvs_speech_hearing(speaker, listener, speech, physical):
    if not dvs_auditory_access(listener, physical):
        return false
    var source = speaker.id
    var channel = dv_find(speech, "channel", "")
    var source_location = dvs_emission_location(speaker, speech, physical)
    let target_cell = dv_read(physical, listener.location_ref)
    var target_location = ""
    if dv_uncontested(target_cell):
        target_location = target_cell.value
    var grants = dv_find(listener, "hearing_grants", [])
    if (source_location != "") and dv_same(source_location, target_location):
        return true
    var heard = false
    var i = 0
    while (i < rt_count(grants)):
        var grant = grants[i]
        if dv_and((grant.speaker == source), (grant.channel == channel)):
            let sender_locations = dv_find(grant, "sender_locations", [])
            let listener_locations = dv_find(grant, "listener_locations", [])
            var reception = target_location
            if dv_has_key(grant, "reception_location_ref"):
                let endpoint = dv_read(physical, grant.reception_location_ref)
                reception = ""
                if dv_uncontested(endpoint):
                    reception = endpoint.value
            if (dv_truth(listener.mind, dv_find(grant, "available_when", dv_true())) == "true") and dv_truth(physical, dv_find(grant, "authority_when", dv_true())) == "true":
                if source_location != "" and reception != "" and ((rt_count(sender_locations) == 0 or dv_has(sender_locations, source_location)) and (rt_count(listener_locations) == 0 or dv_has(listener_locations, reception))):
                    heard = true
        i = (i + 1)
    return heard

fn dvs_speech_observations(mind, proposition, source, origin, time, trust):
    var op = proposition.op
    var observations = []
    if (op == "all"):
        var items = proposition.items
        var i = 0
        while (i < rt_count(items)):
            var part = dvs_speech_observations(mind, items[i], source, origin, time, trust)
            var j = 0
            while (j < rt_count(part)):
                if dv_has(observations, part[j]):
                    false
                else:
                    rt_push(observations, part[j])
                j = (j + 1)
            i = (i + 1)
    else:
        if (op == "equals"):
            var ref = proposition.ref
            rt_push(observations, dv_observation(dv_list3(source, mind.subject, ref), mind.subject, ref, proposition.value, "testimony", origin, time, trust, dv_pair(origin, ref)))
    return observations

fn dvs_speaker_trust(policy, speaker):
    var trust = dv_find(dv_find(policy, "speaker_trust", []), speaker, 0.5)
    let biases = dv_find(policy, "class_bias", [])
    var i = 0
    while i < rt_count(biases):
        let bias = biases[i]
        if 0 < rt_count(dv_find(bias, "basis", [])) and dv_has(bias.speakers, speaker):
            trust = trust + bias.delta
        i = i + 1
    return dv_min(1, dv_max(0, trust))

fn dvs_speech_proposal_decision(mind, policy, speech, trust):
    var proposal = dv_find(speech, "proposal", false)
    var status = "ordinary"
    var reason = "ordinary-testimony"
    var confidence = trust
    var units = 0
    var acceptance = dv_find(policy, "proposal_acceptance", false)
    if (proposal == false):
        false
    else:
        var claims = dv_find(proposal, "claims", [])
        var local_1 = false
        if (acceptance == false):
            local_1 = []
        else:
            local_1 = dv_find(acceptance, "required_slots", [])
        var required = local_1
        var propositions = []
        var allowed = true
        var i = 0
        var available = "unknown"
        status = "retained"
        reason = "missing-personal-proposal-policy"
        units = 1
        confidence = dv_min(trust, dv_find(proposal, "confidence", 0))
        while (i < rt_count(claims)):
            var claim = claims[i]
            rt_push(propositions, dv_fact(claim.ref, claim.value))
            units = (units + 1)
            i = (i + 1)
        i = 0
        while (i < rt_count(required)):
            var j = 0
            var found = false
            while (j < rt_count(claims)):
                if (required[i] == claims[j].slot_id):
                    found = true
                units = (units + 1)
                j = (j + 1)
            if found:
                false
            else:
                allowed = false
            i = (i + 1)
        if (acceptance == false):
            false
        else:
            available = dv_truth(mind, dvs_speech_map(mind, dv_find(acceptance, "available_when", dv_true()), dv_find(speech, "referents", [])))
            units = (units + (2 * dvs_speech_ast_nodes(dv_find(acceptance, "available_when", dv_true()))))
            reason = "personal-proposal-policy-withheld"
            if dv_find(acceptance, "enabled", false):
                false
            else:
                allowed = false
            if (0 < rt_count(dv_find(acceptance, "basis", []))):
                false
            else:
                allowed = false
            if (available == "true"):
                false
            else:
                allowed = false
            if (0 < rt_count(required)):
                false
            else:
                allowed = false
            if (0 < rt_count(claims)):
                false
            else:
                allowed = false
            if dv_find(proposal, "estimated", false):
                false
            else:
                allowed = false
            if (dv_find(proposal, "argument_id", "") == ""):
                allowed = false
            if dv_and((0 < dv_find(proposal, "confidence", 0)), (dv_find(proposal, "confidence", 0) < 1)):
                false
            else:
                allowed = false
            if (0 < rt_count(dv_find(proposal, "source_event_ids", []))):
                false
            else:
                allowed = false
            if (dv_find(proposal, "model_event", "") == ""):
                allowed = false
            if dv_same(dv_all(propositions), speech.literal_ast):
                false
            else:
                allowed = false
            if (confidence < dv_find(acceptance, "confidence_threshold", 0.5)):
                allowed = false
            if allowed:
                status = "accepted"
                reason = "personal-bounded-proposal-adoption"
    var local_2 = false
    if (acceptance == false):
        local_2 = []
    else:
        local_2 = dv_find(acceptance, "basis", [])
    return dv_with_many({"status": status, "reason": reason, "confidence_cap": confidence, "proposal": proposal}, {"policy_basis": local_2, "calculation_units": units})

fn dvs_speech_received_observations(mind, parsed, source, speaker, time, decision):
    if (decision.status == "retained"):
        return []
    else:
        var items = dvs_speech_observations(mind, parsed, source, speaker, time, decision.confidence_cap)
        var i = 0
        var result = []
        while (i < rt_count(items)):
            var local_1 = false
            if (decision.status == "ordinary"):
                local_1 = items[i]
            else:
                local_1 = dv_with_many(items[i], {"estimated": true, "proposal_source": decision.proposal})
            rt_push(result, local_1)
            i = (i + 1)
        return result

fn dvs_speech_candidates(policy, speech):
    var cues = dv_find(speech, "implicature_candidates", [])
    var rules = dv_find(policy, "implicature_bridges", [])
    var result = []
    var ids = []
    var local_ids = []
    var i = 0
    while (i < rt_count(rules)):
        var rule = rules[i]
        var id = rules[i].id
        var required = dv_find(rules[i], "cue", "")
        var j = 0
        var matched = false
        rt_push(local_ids, id)
        if (required == ""):
            matched = true
        while (j < rt_count(cues)):
            if (cues[j].id == required):
                matched = true
            j = (j + 1)
        if matched:
            rt_push(result, {"id": id, "rule_source": dv_find(rule, "basis", []), "utterance_scope": dv_find(speech, "scope", "")})
            rt_push(ids, id)
        i = (i + 1)
    i = 0
    while (i < rt_count(cues)):
        var cue_id = cues[i].id
        if dv_or(dv_has(ids, cue_id), dv_has(local_ids, cue_id)):
            false
        else:
            rt_push(result, {"id": cue_id, "rule_source": [], "utterance_scope": dv_find(speech, "scope", "")})
            rt_push(ids, cue_id)
        i = (i + 1)
    return result

mapping dvs_listener_mapping(mind, policy, bindings):
    input Percept
    output InterpretationSet
    using dvs_speech_interpret(mind, policy, bindings)

fn dvs_speech_interpret(mind, policy, bindings, candidate):
    var bridges = dv_find(policy, "implicature_bridges", [])
    var i = 0
    var bridge = false
    var proposition = {"op": "constant", "value": "unknown"}
    var available = dv_true()
    var threshold = dv_max(dv_find(policy, "implicature_threshold", 0.5), dv_find(policy, "Implicature_Resistance", 0))
    var confidence = 0
    var adoption = {degree: 0, level: "held"}
    var basis = []
    var status = "rejected"
    var missing = "missing-bridge"
    var scope_check = []
    var withdrawal_evidence = false
    var work = 0
    while (i < rt_count(bridges)):
        var item = bridges[i]
        if (item.id == candidate.id):
            dv_require((bridge == false), "Ambiguous interpretation bridge")
            bridge = item
        i = (i + 1)
    if (bridge == false):
        false
    else:
        var premise = dvs_speech_map(mind, bridge.premise, bindings)
        var bridge_basis = dv_find(bridge, "basis", [])
        var withdrawal = dvs_speech_map(mind, dv_find(bridge, "withdraw_when", dv_not(dv_true())), bindings)
        var scope_ast = dvs_speech_map(mind, dv_find(bridge, "scope_bridge", {"op": "constant", "value": "unknown"}), bindings)
        proposition = dvs_speech_map(mind, bridge.proposition, bindings)
        available = dvs_speech_map(mind, dv_find(bridge, "available_when", dv_true()), bindings)
        confidence = dv_unit(dv_find(bridge, "prior", 0.5))
        basis = bridge_basis
        work = (1 + (2 * ((dvs_speech_ast_nodes(premise) + dvs_speech_ast_nodes(proposition)) + (dvs_speech_ast_nodes(available) + (dvs_speech_ast_nodes(withdrawal) + dvs_speech_ast_nodes(scope_ast))))))
        var literal_scope = dv_find(candidate, "utterance_scope", dv_find(bridge, "source_scope", ""))
        var interpreted_scope = dv_find(bridge, "target_scope", dv_find(bridge, "source_scope", ""))
        var scope_truth = dv_truth(mind, scope_ast)
        var withdraw_truth = dv_truth(mind, withdrawal)
        withdrawal_evidence = {"condition": withdrawal, "truth": withdraw_truth, "inputs": dvs_sim_inputs(mind, withdrawal), "scope": "owner-known-cells-only"}
        var available_truth = dv_truth(mind, available)
        var premise_truth = dv_truth(mind, premise)
        var proposition_truth = dv_truth(mind, proposition)
        scope_check = dv_with({"literal_scope": literal_scope, "interpretation_scope": interpreted_scope, "bridge_truth": scope_truth, "check_enabled": dv_find(policy, "scope_reference_check", false)}, "gap", dv_and((not (literal_scope == interpreted_scope)), (not (scope_truth == "true"))))
        if (withdraw_truth == "true"):
            status = "withdrawn"
            missing = "explicit-withdrawal-evidence"
        else:
            if (not (available_truth == "true")):
                missing = "availability-not-known"
            else:
                if (rt_count(bridge_basis) == 0):
                    missing = "bridge-without-source"
                else:
                    if (not (premise_truth == "true")):
                        missing = "bridge-premise-not-known"
                    else:
                        if (rt_count(basis) == 0):
                            missing = "candidate-without-source"
                        else:
                            if (proposition_truth == "false"):
                                missing = "contrary-evidence"
                            else:
                                adoption = dv_threshold_acceptance(confidence, threshold)
                                if adoption.level != "accepted":
                                    missing = "below-policy-threshold"
                                else:
                                    status = "accepted"
                                    missing = ""
        if dv_and((status == "accepted"), dv_and(scope_check.check_enabled, scope_check.gap)):
            status = "retained"
            adoption = dv_threshold_acceptance(0, threshold)
            missing = "scope-reference-bridge-not-supported"
        basis = dv_append(basis, {"bridge": bridge.id, "basis": bridge_basis})
    return dv_with_many({"id": candidate.id, "proposition": proposition, "status": status, "confidence": confidence}, {"basis": basis, "missing_bridge": missing, "scope_check": scope_check, "withdrawal_evidence": withdrawal_evidence, "kind": "defeasible-interpretation", "calculation_units": work, "acceptance": adoption})

fn dvs_social_atomic_class(speech):
    let special = ["proposal", "request", "public_claim", "manipulation", "advice", "norm_proposal"]
    var i = 0
    while i < rt_count(special):
        if dv_find(speech, special[i], false) != false:
            return rt_cat("formal-", special[i])
        i = i + 1
    return "ordinary-testimony"

// A speaker-owned model whose candidate IDs cannot contribute to any active
// communication goal need not simulate its entire listener world. This proves
// zero contribution to the existing score; it never predicts listener success.
fn dvs_proposal_reassess(actor, decision, events, time, parent):
    var rule = dv_find(actor.policy, "proposal_reassessment", false)
    var proposal = decision.proposal
    var interpretations = dv_find(actor, "interpretations", [])
    var remaining = dv_find(actor.policy, "reason_budget", 0)
    var last = dv_find(actor, "last_interpretation_event", "")
    var cognitive = dv_find(actor, "last_cognitive_event", "")
    var seen = dv_find(actor, "reassessed_proposals", [])
    var local_1 = false
    if (decision.proposal == false):
        local_1 = ""
    else:
        local_1 = dv_find(decision.proposal, "argument_id", "")
    var proposal_id = local_1
    if dv_and((decision.status == "accepted"), (not dv_has(seen, proposal_id))):
        if (rule == false):
            false
        else:
            if dv_and(dv_find(rule, "enabled", false), (0 < rt_count(dv_find(rule, "basis", [])))):
                var targets = dv_find(rule, "interpretation_ids", [])
                var required = dv_find(rule, "required_slots", [])
                var claims = dv_find(proposal, "claims", [])
                var complete = true
                var i = 0
                if (rt_count(required) == 0):
                    complete = false
                while (i < rt_count(required)):
                    var j = 0
                    var found = false
                    while (j < rt_count(claims)):
                        if (required[i] == claims[j].slot_id):
                            found = true
                        j = (j + 1)
                    if found:
                        false
                    else:
                        complete = false
                    i = (i + 1)
                i = 0
                while (i < rt_count(targets)):
                    var id = targets[i]
                    var old = dv_find(interpretations, targets[i], false)
                    var status = "insufficient-origin"
                    var charged = 0
                    var before = dv_with_many(actor, {"interpretations": interpretations, "policy": dv_with(actor.policy, "reason_budget", remaining), "last_interpretation_event": last, "last_cognitive_event": cognitive})
                    if (old == false):
                        status = "no-personal-interpretation"
                    else:
                        var scope = dv_find(old, "scope_check", [])
                        var source = dv_find(old, "source_event", "")
                        if (old.status == "accepted"):
                            false
                        else:
                            status = "no-prior-accepted-interpretation"
                        if dv_and(complete, dv_and((old.status == "accepted"), dv_and(dv_has(dv_find(proposal, "reassessment_sources", []), source), dv_and((dv_find(scope, "literal_scope", "") == dv_find(rule, "source_scope", "")), (dv_find(scope, "interpretation_scope", "") == dv_find(rule, "target_scope", "")))))):
                            if (remaining < 1):
                                status = "reason-budget-exhausted"
                            else:
                                remaining = (remaining - 1)
                                charged = 1
                                var candidate = {"id": id, "utterance_scope": dv_find(scope, "literal_scope", "")}
                                var revised = (dvs_listener_mapping(actor.mind, actor.policy, dv_find(old, "referents", [])) × {"id": id, "utterance_scope": dv_find(scope, "literal_scope", "")})
                                if (revised.scope_check.bridge_truth == "unknown"):
                                    status = "withdrawn"
                                    interpretations = dv_with(interpretations, id, dv_with_many(old, {"status": "withdrawn", "withdrawal_reason": "paid-scope-bridge-unsupported", "proposal_event": parent}))
                                else:
                                    status = "retained-supported-bridge"
                    var after = dv_with_many(actor, {"interpretations": interpretations, "policy": dv_with(actor.policy, "reason_budget", remaining), "last_interpretation_event": rt_cat("e", rt_show(rt_count(events))), "last_cognitive_event": rt_cat("e", rt_show(rt_count(events)))})
                    var local_2 = false
                    if (status == "withdrawn"):
                        local_2 = "implicature_withdrawn"
                    else:
                        local_2 = "proposal_scope_reassessment"
                    var local_3 = false
                    if (last == ""):
                        var local_4 = false
                        if (old == false):
                            local_4 = ""
                        else:
                            local_4 = dv_find(old, "source_event", "")
                        local_3 = dv_pair(parent, local_4)
                    else:
                        var local_5 = false
                        if (old == false):
                            local_5 = ""
                        else:
                            local_5 = dv_find(old, "source_event", "")
                        local_3 = dv_list3(parent, local_5, last)
                    var local_6 = false
                    if (old == false):
                        local_6 = ""
                    else:
                        local_6 = dv_find(old, "source_event", "")
                    last = dvs_event_prepared(events, local_2, actor.id, time, dvs_speech_cognitive_parents(local_3, cognitive), dv_with_many({"status": status, "actor_before": dv_without(before, "simulations"), "actor_after": dv_without(after, "simulations"), "charged_units": charged}, {"mind_before": actor.mind, "mind_after": actor.mind, "interpretations_before": dv_find(before, "interpretations", []), "interpretations_after": interpretations, "source_event": local_6, "proposal": proposal}))
                    cognitive = last
                    i = (i + 1)
                seen = dv_append(seen, proposal_id)
    return dv_with_many(actor, {"interpretations": interpretations, "policy": dv_with(actor.policy, "reason_budget", remaining), "last_interpretation_event": last, "reassessed_proposals": seen, "last_cognitive_event": cognitive})

// A norm receipt records understood content and provenance, never personal assent.
fn dvs_receive_norm(actor, norm, source, parse_event, events, time):
    let receipt = {"norm": norm, "source_event": source, "parse_event": parse_event, "received_time": time}
    let before = dv_find(actor, "norm_proposals", [])
    let after = dv_with(before, norm.id, receipt)
    let event = dvs_event_prepared(events, "norm_receipt", actor.id, time, dv_pair(source, parse_event), {"receipt": receipt, "proposals_before": before, "proposals_after": after})
    return dv_with_many(actor, {"norm_proposals": after, "last_cognitive_event": event})

// Only the actual owner's successfully completed decision changes personal rules.
fn dvs_complete_norm(actor, action, applied, events, time, execution_event, observation_event):
    if not applied:
        return actor
    let read_receipt = dv_find(action, "norm_receipt", false)
    if read_receipt != false:
        if observation_event != execution_event and dv_truth(actor.mind, read_receipt.content) == "true":
            actor = dvs_receive_norm(actor, read_receipt.norm, execution_event, observation_event, events, time)
    let decision = dv_find(action, "norm_decision", false)
    if decision == false:
        return actor
    let receipt = dv_find(dv_find(actor, "norm_proposals", []), decision.id, false)
    dv_require(receipt != false, "Norm decision needs an owner's actual content receipt")
    dv_require(dv_same(receipt.norm, decision.norm) and receipt.source_event != "" and receipt.parse_event != "", "Norm decision receipt must match understood content")
    let before = dv_find(actor.policy, "norm_rules", [])
    var rules = []
    var i = 0
    while i < rt_count(before):
        if before[i].id != decision.id:
            rt_push(rules, before[i])
        i = i + 1
    if decision.accepted:
        let norm = receipt.norm
        rt_push(rules, {"id": norm.id, "method": norm.method, "mode": norm.mode, "promotes": norm.promotes, "sacrifices": norm.sacrifices, "basis": [norm.source, receipt.source_event, receipt.parse_event, execution_event], "available_when": dv_true()})
    let stance = {"accepted": decision.accepted, "norm": receipt.norm, "source_event": receipt.source_event, "parse_event": receipt.parse_event, "execution_event": execution_event, "observation_event": observation_event}
    let stances = dv_with(dv_find(actor, "norm_stances", []), decision.id, stance)
    let event = dvs_event_prepared(events, "norm_decision", actor.id, time, [execution_event, observation_event, receipt.source_event, receipt.parse_event], {"decision": stance, "value_order": dv_find(actor.policy, "value_order", []), "personal_choice": dv_find(action, "personal_choice", []), "rules_before": before, "rules_after": rules})
    return dv_with_many(actor, {"policy": dv_with(actor.policy, "norm_rules", rules), "norm_stances": stances, "last_cognitive_event": event})

fn dvs_receive_scheduled_speech(listener, message, events, time):
    let speech = message.speech
    let literal = speech.literal_ast
    let bindings = dv_find(speech, "referents", [])
    let source = message.source
    let speaker_id = message.speaker
    let action_id = message.action_id
    let audibility = message.audibility
    var before = listener.mind
    var parsed = dvs_speech_map(before, literal, bindings)
    var policy = listener.policy
    var trust = dvs_speaker_trust(listener.policy, speaker_id)
    var decision = dvs_speech_proposal_decision(before, policy, speech, trust)
    var candidates_actual = dvs_speech_candidates(policy, speech)
    var after = before
    var profile = dv_observation_profile({"perception": 1, "testimony": 1, "recall": 1}, dv_find(listener.policy, "observation_threshold", 0.5))
    let observations = dvs_speech_received_observations(before, parsed, source, speaker_id, message.received_time, decision)
    if 0 < rt_count(observations):
        after = dv_update_mind(before, observations, before.revision, profile).world
    let social_class = dvs_social_atomic_class(speech)
    // proposal_reassess only acts on this receipt's accepted decision; it does
    // not scan older proposals. Existing interpretations are reconsidered by
    // the unchanged dvs_pragmatics_reconsider in the next cognitive cycle.
    // Keep the decision gate explicit, so a future new proposal decision kind
    // cannot accidentally enter the no-op contraction based on shape alone.
    if dv_find(listener.policy, "opt_blackbox", true) and social_class == "ordinary-testimony" and decision.status == "ordinary" and decision.proposal == false and rt_count(candidates_actual) == 0:
        let receipt = dvs_event_prepared(events, "listener_parse", listener.id, time, dvs_speech_cognitive_parents(dv_single(source), dv_find(listener, "last_cognitive_event", "")), dv_with_many({"mind_before": before, "mind_after": after, "literal": parsed, "observations": observations}, {"source_event": source, "speech": speech, "presuppositions": dvs_speech_presuppositions(before, speech), "audibility": audibility, "observation_profile": profile, "proposal_decision": decision, "social_mode": "atomic-ordinary-testimony", "charged_execution_units": 0, "charge_owner": "original-action-complete"}))
        return dv_with_many(listener, {"mind": after, "received_speeches": dv_append(dv_find(listener, "received_speeches", []), {"speaker": speaker_id, "action_id": action_id, "parse_event": receipt, "source_event": source}), "interpretations": dv_find(listener, "interpretations", []), "last_interpretation_event": dv_find(listener, "last_interpretation_event", ""), "proposals": dv_find(listener, "proposals", []), "last_cognitive_event": receipt, "policy": dv_with(listener.policy, "reason_budget", dv_find(listener.policy, "reason_budget", 0)), "reassessed_proposals": dv_find(listener, "reassessed_proposals", [])})
    var interpretations = dv_find(listener, "interpretations", [])
    var last_interpretation = dv_find(listener, "last_interpretation_event", "")
    var n = 0
    var parse_event = false
    var proposal_event = false
    if (decision.status == "ordinary"):
        false
    else:
        proposal_event = dvs_event_prepared(events, "proposal_receipt", listener.id, time, dvs_speech_cognitive_parents(dv_single(source), dv_find(listener, "last_cognitive_event", "")), dv_with_many(decision, {"source_event": source, "mind_before": before, "mind_after": before}))
        proposal_event = dvs_event_prepared(events, "proposal_adoption", listener.id, time, dv_pair(source, proposal_event), dv_with_many(decision, {"source_event": source, "mind_before": before, "mind_after": after}))
    var local_2 = false
    if (proposal_event == false):
        local_2 = dv_single(source)
    else:
        local_2 = dv_pair(source, proposal_event)
    parse_event = dvs_event_prepared(events, "listener_parse", listener.id, time, dvs_speech_cognitive_parents(local_2, dv_find(listener, "last_cognitive_event", "")), dv_with_many({"mind_before": before, "mind_after": after, "literal": parsed, "observations": observations}, {"source_event": source, "speech": speech, "presuppositions": dvs_speech_presuppositions(before, speech), "audibility": audibility, "observation_profile": profile, "proposal_decision": decision, "social_mode": "formal-reception", "social_reason": social_class, "interpretation_candidates": rt_count(candidates_actual)}))
    listener = dvs_receive_request(listener, speech, parse_event, source, speaker_id)
    listener = dv_with(listener, "received_speeches", dv_append(dv_find(listener, "received_speeches", []), {"speaker": speaker_id, "action_id": action_id, "parse_event": parse_event, "source_event": source}))
    listener = dvs_receive_public_claim(listener, speech, speaker_id, source, parse_event)
    listener = dvs_receive_player_influence(listener, speech, speaker_id, source, parse_event)
    listener = dvs_receive_advice(listener, speech, speaker_id, source, parse_event, parsed)
    while (n < rt_count(candidates_actual)):
        var candidate = candidates_actual[n]
        var interpretation = (dvs_listener_mapping(after, policy, bindings) × candidates_actual[n])
        var interpretations_before = dv_clone(interpretations)
        interpretation = dv_with_many(interpretation, {"source_event": source, "referents": bindings})
        var local_3 = false
        if dv_has_key(interpretations, candidate.id):
            local_3 = (dv_get(interpretations, candidate.id).status == "accepted")
        else:
            local_3 = false
        if dv_and((interpretation.status == "withdrawn"), (not local_3)):
            interpretation = dv_with(interpretation, "status", "rejected")
        interpretations = dv_with(interpretations, candidate.id, interpretation)
        var local_4 = false
        if (interpretation.status == "withdrawn"):
            local_4 = "implicature_withdrawn"
        else:
            local_4 = "implicature"
        var local_5 = false
        if (last_interpretation == ""):
            local_5 = dv_pair(source, parse_event)
        else:
            local_5 = dv_list3(source, parse_event, last_interpretation)
        last_interpretation = dvs_event_prepared(events, local_4, listener.id, time, local_5, dv_with_many(interpretation, {"source_event": source, "mind_before": after, "mind_after": after, "interpretations_before": interpretations_before, "interpretations_after": interpretations}))
        n = (n + 1)
    var local_6 = false
    if (decision.status == "ordinary"):
        local_6 = dv_find(listener, "proposals", [])
    else:
        local_6 = dv_append(dv_find(listener, "proposals", []), dv_with(decision, "source_event", source))
    listener = dvs_proposal_reassess(dv_with_many(listener, {"mind": after, "interpretations": interpretations, "last_interpretation_event": last_interpretation, "proposals": local_6, "last_cognitive_event": parse_event}), decision, events, time, parse_event)
    let norm = dv_find(speech, "norm_proposal", false)
    if norm != false and dv_same(parsed, literal) and dv_truth(after, parsed) == "true":
        listener = dvs_receive_norm(listener, norm, source, parse_event, events, time)
    return listener

fn dvs_drain_received_speech(actor, events, time):
    let messages = dv_find(actor, "pending_heard", [])
    var current = actor
    if 0 < rt_count(messages):
        current = dv_with(actor, "pending_heard", [])
    var i = 0
    while i < rt_count(messages):
        current = dvs_receive_scheduled_speech(current, messages[i], events, time)
        i = i + 1
    return current

fn dvs_speech_owned(actors, speaker_index, action, events, time, parent, physical):
    var speaker = actors[speaker_index]
    var speech = action.speech
    var speaker_mind = speaker.mind
    var bindings = dv_find(speech, "referents", [])
    var literal = speech.literal_ast
    var claim = dvs_speech_map(speaker_mind, literal, bindings)
    var listeners = dv_find(action, "listeners", [])
    var next = actors
    var i = 0
    var source = false
    var visited = []
    source = dvs_event_prepared(events, "speech_literal", speaker.id, time, dvs_speech_cognitive_parents(dv_single(parent), dv_find(speaker, "last_cognitive_event", "")), dv_with({"literal": literal, "claim": claim, "mind_before": speaker_mind, "speech": speech}, "speaker_truth", dv_truth(speaker_mind, claim)))
    if (not (dv_truth(speaker_mind, claim) == "true")):
        dvs_event(events, "speech_rejected", speaker.id, time, dv_single(source), {"reason": "speaker-truth-not-supported", "source_event": source})
    else:
        while (i < rt_count(listeners)):
            var listener_id = listeners[i]
            var j = 0
            var target_index = -1
            dv_require((not dv_has(visited, listener_id)), "Repeated speech listener")
            rt_push(visited, listener_id)
            while (j < rt_count(next)):
                if (next[j].id == listener_id):
                    target_index = j
                j = (j + 1)
            if (target_index < 0):
                dvs_event(events, "speech_unheard", listener_id, time, dv_single(source), {"reason": "unknown-listener", "source_event": source})
            else:
                var listener = next[target_index]
                if (not dvs_speech_hearing(speaker, listener, speech, physical)):
                    dvs_event(events, "speech_unheard", listener_id, time, dv_single(source), {"reason": "no-audibility-grant", "source_event": source})
                else:
                    let message = {"speech": speech, "source": source, "speaker": speaker.id, "action_id": action.id, "received_time": time, "audibility": {"speaker_location": dvs_emission_location(speaker, speech, physical), "listener_location": dv_find(listener, "location", ""), "hearing_grants": dv_find(listener, "hearing_grants", [])}}
                    if dv_find(listener, "scheduled_action", false) != false:
                        next = dvs_replace(next, target_index, dv_with(listener, "pending_heard", dv_append(dv_find(listener, "pending_heard", []), message)))
                        dvs_event(events, "speech_received_pending", listener.id, time, [source], {"source_event": source, "audibility": message.audibility})
                    else:
                        next = dvs_replace(next, target_index, dvs_receive_scheduled_speech(listener, message, events, time))
            i = (i + 1)
    return next

fn dvs_complete_owned_decision(actor, action, success, events, execution_event, time):
    let decision = dv_find(action, "owned_decision", false)
    if not success or decision == false:
        return actor
    let snapshot = dvs_owned_decision_completion_selection(actor, action, events, execution_event)
    let execution = dvs_find_event_by_id(events, execution_event)
    if snapshot == false or execution == false or execution.type != "action_execution" or execution.actor != actor.id:
        dvs_event(events, "owned_decision_unavailable", actor.id, time, [execution_event], {"decision": decision, "reason": "current-context-or-actual-selection-unavailable"})
        return actor
    if execution.data.receipt.execution.status != "applied":
        return actor
    let inputs = dvs_owned_decision_inputs(actor, decision, actor.mind)
    let previous = dv_find(dv_find(actor, "owned_decisions", []), decision.id, false)
    var previous_event = ""
    if previous != false:
        previous_event = dv_find(previous, "event", "")
    let receipt = {"id": decision.id, "stance": decision.stance, "context": inputs.context, "basis": decision.basis, "declaration": decision, "selection_sources": snapshot.sources, "completion_sources": inputs.sources, "selection_event": snapshot.selection_event, "execution_event": execution_event, "previous_event": previous_event, "time": time, "meaning": "actual-owner-decision-not-performance-or-outcome"}
    var parents = [execution_event, snapshot.selection_event]
    var i = 0
    while i < rt_count(snapshot.sources.requests):
        let request = snapshot.sources.requests[i].receipt
        if request != false:
            parents = dv_explanation_merge(parents, [request.source_event, request.parse_event])
        i = i + 1
    let event = dvs_event(events, "owned_decision", actor.id, time, parents, receipt)
    let recorded = dv_with(receipt, "event", event)
    return dv_with_many(actor, {"owned_decisions": dv_with(dv_find(actor, "owned_decisions", []), decision.id, recorded), "owned_decision_history": dv_append(dv_find(actor, "owned_decision_history", []), recorded), "last_cognitive_event": event})

fn dvs_complete_advice(actor, action, success, events, time, execution_event):
    let decision = dv_find(action, "advice_decision", false)
    if not success or decision == false:
        return actor
    if not dvs_advice_decision_ready(actor, action, actor.mind):
        dvs_event(events, "advice_decision_unavailable", actor.id, time, [execution_event], {"decision": decision, "reason": "receipt-or-owner-assessment-unavailable-at-complete"})
        return actor
    let receipt = dv_get(dv_find(actor, "received_advice", []), decision.advice_id)
    let selection = dvs_heard_before_selection(events, actor, action, execution_event, receipt.parse_event, receipt.source_event)
    if selection == false:
        dvs_event(events, "advice_decision_unavailable", actor.id, time, [execution_event, receipt.source_event, receipt.parse_event], {"decision": decision, "reason": "advice-not-before-decision-selection"})
        return actor
    let assessment = dvs_advice_assessment(actor, receipt, decision.assessment_action_id, actor.mind)
    var status = "declined"
    if decision.accepted:
        status = "accepted-for-consideration"
    let stance = {"advice_id": decision.advice_id, "accepted": decision.accepted, "status": status, "source_event": receipt.source_event, "parse_event": receipt.parse_event, "selection_event": selection.event, "execution_event": execution_event, "assessment": assessment, "time": time, "meaning": "owner-stance-not-target-execution-or-causal-proof"}
    let event = dvs_event(events, "advice_decision", actor.id, time, [execution_event, receipt.source_event, receipt.parse_event], stance)
    return dv_with_many(actor, {"advice_stances": dv_with(dv_find(actor, "advice_stances", []), decision.advice_id, dv_with(stance, "event", event)), "last_cognitive_event": event})

fn dvs_sim_refs(proposition):
    var op = proposition.op
    if op == "held_for":
        return [proposition.ref, proposition.clock]
    if dv_or((op == "equals"), (op == "at_least")):
        return dv_single(proposition.ref)
    else:
        if (op == "not"):
            return dvs_sim_refs(proposition.item)
        else:
            if (op == "all"):
                var items = proposition.items
                var refs = []
                var i = 0
                while (i < rt_count(items)):
                    var nested = dvs_sim_refs(items[i])
                    var j = 0
                    while (j < rt_count(nested)):
                        if dv_has(refs, nested[j]):
                            false
                        else:
                            rt_push(refs, nested[j])
                        j = (j + 1)
                    i = (i + 1)
                return refs
            else:
                return []

fn dvs_sim_plan(hypothesis):
    let key = ["compiled-model-plan", dv_has_key(hypothesis, "timeline"), dv_find(hypothesis, "predict_laws", [])]
    let timeline = dv_find(hypothesis, "timeline", [])
    let cached = dvs_declaration_cache_get(timeline, key)
    if cached[0]:
        return cached[1]
    return dvs_declaration_cache_put(timeline, key, dvs_sim_plan_build(hypothesis))

fn dvs_sim_plan_build(hypothesis):
    var timeline = dv_find(hypothesis, "timeline", [])
    var plan = []
    var i = 0
    if dv_has_key(hypothesis, "timeline"):
        while (i < rt_count(timeline)):
            var stage = timeline[i]
            var j = 0
            if dv_has_key(stage, "dispatch"):
                rt_push(plan, {"law": "", "at": stage.at, "optional": true, "stage": i, "dispatch": stage.dispatch})
            else:
                if dv_has_key(stage, "response"):
                    rt_push(plan, dv_with_many({"law": "", "at": stage.at, "optional": dv_find(stage, "optional", false), "stage": i}, {"response": stage.response, "available_when": dv_find(stage, "available_when", dv_true())}))
                else:
                    var local_1 = false
                    if dv_has_key(stage, "laws"):
                        local_1 = stage.laws
                    else:
                        local_1 = dv_single(stage.law)
                    var laws = local_1
                    dv_require((0 < rt_count(laws)), "Empty model event stage")
                    while (j < rt_count(laws)):
                        rt_push(plan, {"law": laws[j], "at": stage.at, "optional": dv_find(stage, "optional", false), "stage": i})
                        j = (j + 1)
            i = (i + 1)
    else:
        var laws = dv_find(hypothesis, "predict_laws", [])
        while (i < rt_count(laws)):
            rt_push(plan, {"law": laws[i], "at": 0, "optional": false, "stage": i})
            i = (i + 1)
    return plan

fn dvs_sim_withhold(world, effects):
    var copy = world
    var refs = []
    var i = 0
    while (i < rt_count(effects)):
        var ref = effects[i].ref
        if dv_has_key(copy.objects, ref.object):
            copy = dv_store(copy, ref, dv_unknown())
            rt_push(refs, ref)
        i = (i + 1)
    return {"world": copy, "refs": refs}

fn dvs_sim_feature(feature):
    if dv_has_key(feature, "proposition"):
        return feature.proposition
    else:
        return feature

fn dvs_sim_mask_plan(plan):
    var result = []
    var i = 0
    while (i < rt_count(plan)):
        let step = plan[i]
        if dv_has_key(step, "dispatch"):
            var j = 0
            while (j < rt_count(step.dispatch.laws)):
                rt_push(result, {"law": step.dispatch.laws[j]})
                j = j + 1
        else:
            rt_push(result, step)
        i = i + 1
    return result

fn dvs_sim_mask(mind, source_plan, start):
    let plan = dvs_sim_mask_plan(source_plan)
    var copy = dv_with_many(mind, {"time": start, "seen": [], "history": []})
    var i = 0
    while (i < rt_count(plan)):
        var name = plan[i].law
        var adoptions = mind.adoptions
        if dv_has_key(adoptions, name):
            var adoption = dv_get(adoptions, name)
            var j = 0
            var effects = dv_get(adoptions, name).law.effects
            if dv_and(adoption.active, (adoption.mode == "predict")):
                while (j < rt_count(effects)):
                    var ref = effects[j].ref
                    if dv_has_key(copy.objects, ref.object):
                        copy = dv_store(copy, ref, dv_unknown())
                    j = (j + 1)
        i = (i + 1)
    return copy

fn dvs_sim_inputs(world, proposition):
    var refs = dvs_sim_refs(proposition)
    var i = 0
    var inputs = []
    while (i < rt_count(refs)):
        rt_push(inputs, {"ref": refs[i], "cell": dv_read(world, refs[i])})
        i = (i + 1)
    return inputs

fn dvs_sim_snapshot(snapshots, final, covered, feature):
    if dv_has_key(feature, "at"):
        var i = 0
        var selected = {"world": final, "coverage": [], "step": -1}
        var found = false
        var at = feature.at
        dv_require((not (at < 0)), "Negative model feature time")
        while (i < rt_count(snapshots)):
            var snapshot = snapshots[i]
            if (at == snapshot.at):
                selected = snapshot
                found = true
            i = (i + 1)
        if found:
            return selected
        else:
            return {"world": final, "coverage": [], "step": -1}
    else:
        return {"world": final, "coverage": covered, "step": (rt_count(snapshots) - 1)}

fn dvs_sim_prediction(feature, snapshot, start):
    var proposition = dvs_sim_feature(feature)
    var refs = dvs_sim_refs(dvs_sim_feature(feature))
    var world = snapshot.world
    var coverage = snapshot.coverage
    var i = 0
    var cells = []
    var valid = true
    var confidence = 1
    if (rt_count(refs) == 0):
        valid = false
    while (i < rt_count(refs)):
        var ref = refs[i]
        var cell = dv_read(world, refs[i])
        rt_push(cells, {"ref": ref, "cell": cell})
        if dv_and(dv_has(coverage, ref), dv_uncontested(cell)):
            confidence = dv_min(confidence, cell.confidence)
        else:
            valid = false
        i = (i + 1)
    var local_1 = false
    if valid:
        local_1 = dv_truth(world, proposition)
    else:
        local_1 = "unknown"
    var local_2 = false
    if valid:
        local_2 = confidence
    else:
        local_2 = 0
    return dv_with_many({"feature": feature, "proposition": proposition, "prediction": local_1, "cells": cells}, {"covered": valid, "confidence": local_2, "source_step": dv_find(snapshot, "step", -1)})

fn dvs_sim_compare(mind, prediction):
    var feature = prediction.feature
    var proposition = prediction.proposition
    var refs = dvs_sim_refs(dv_find(prediction.feature, "observation", prediction.proposition))
    var observation = dv_truth(mind, dv_find(prediction.feature, "observation", prediction.proposition))
    var certainty = prediction.confidence
    var available = true
    var temporal_mismatch = false
    var i = 0
    var observed = []
    while (i < rt_count(refs)):
        var cell = dv_read(mind, refs[i])
        rt_push(observed, {"ref": refs[i], "cell": cell})
        if dv_uncontested(cell):
            certainty = dv_min(certainty, cell.confidence)
        else:
            available = false
        i = (i + 1)
    if dv_has_key(feature, "occurrence_ref"):
        var occurrence = dv_read(mind, feature.occurrence_ref)
        rt_push(observed, {"ref": feature.occurrence_ref, "cell": occurrence})
        if dv_uncontested(occurrence):
            certainty = dv_min(certainty, occurrence.confidence)
            if dv_same(occurrence.value, feature.occurrence_time):
                false
            else:
                temporal_mismatch = true
        else:
            available = false
    var resolved = dv_and(available, dv_and(prediction.covered, dv_and((0 < certainty), dv_and((not (observation == "unknown")), (not (prediction.prediction == "unknown"))))))
    var local_1 = false
    if available:
        local_1 = observation
    else:
        local_1 = "unknown"
    var local_2 = false
    if resolved:
        local_2 = certainty
    else:
        local_2 = 0
    var local_3 = false
    if resolved:
        if dv_and((not temporal_mismatch), (observation == prediction.prediction)):
            local_3 = "match"
        else:
            local_3 = "contradiction"
    else:
        local_3 = "unknown"
    return dv_with_many({"feature": feature, "prediction": prediction.prediction, "observation": local_1, "covered": prediction.covered}, {"confidence": local_2, "observed_cells": observed, "result": local_3})

fn dvs_sim_comparisons(mind, predictions, budget):
    var remaining = budget
    var expanded = 0
    var i = 0
    var fit = 0
    var comparisons = []
    var contradictions = []
    var complete = true
    var probes = []
    dv_require((not (budget < 0)), "Negative simulation comparison budget")
    while dv_and((i < rt_count(predictions)), (not (remaining < 1))):
        var prediction = predictions[i]
        var comparison = dvs_sim_compare(mind, predictions[i])
        var j = 0
        var refs = dvs_sim_refs(predictions[i].proposition)
        remaining = (remaining - 1)
        expanded = (expanded + 1)
        rt_push(comparisons, comparison)
        if (comparison.result == "match"):
            fit = (fit + comparison.confidence)
        else:
            if (comparison.result == "contradiction"):
                rt_push(contradictions, comparison)
            else:
                complete = false
                while (j < rt_count(refs)):
                    if dv_has(probes, refs[j]):
                        false
                    else:
                        rt_push(probes, refs[j])
                    j = (j + 1)
        i = (i + 1)
    if dv_or((rt_count(predictions) == 0), (i < rt_count(predictions))):
        complete = false
    var local_1 = false
    if (0 < rt_count(contradictions)):
        local_1 = -1000000
    else:
        local_1 = fit
    var local_2 = false
    if (0 < rt_count(contradictions)):
        local_2 = "inconsistent"
    else:
        if complete:
            local_2 = "explained"
        else:
            local_2 = "unknown"
    return dv_with_many({"fit": local_1, "comparisons": comparisons, "contradictions": contradictions, "remaining": remaining}, {"expanded": expanded, "probe_refs": probes, "status": local_2})

fn dvs_sim_work_budget(actor):
    var policy = actor.policy
    var total = dv_find(actor.policy, "model_budget", 0)
    var work = dv_find(actor.policy, "model_work_remaining", dv_find(actor.policy, "model_work_limit", dv_find(actor.policy, "model_budget", 0)))
    dv_require((not (work < 0)), "Negative method work limit")
    dv_require((not (total < 0)), "Negative total model budget")
    return dv_min(total, work)

fn dvs_model_execute(actor, hypothesis, events, time, parent):
    var mind = actor.mind
    var plan = dvs_sim_plan(hypothesis)
    var start = dv_find(hypothesis, "start_time", time)
    var predicted = false
    var assumptions = dv_find(hypothesis, "assumptions", [])
    var features = dv_find(hypothesis, "features", [])
    var remaining = dvs_sim_work_budget(actor)
    var total_budget = dv_find(actor.policy, "model_budget", 0)
    var expanded = 0
    var failures = []
    var covered = []
    var trace = []
    var snapshots = []
    var predictions = []
    var assumption_records = []
    var confidence = dv_unit(dv_find(hypothesis, "prior", 0.5))
    var i = 0
    var complete = true
    // Replay depth bounds ordered causal stages, independently of action-plan depth.
    let replay_limit = dv_find(actor.policy, "Replay_Depth", rt_count(plan))
    dv_require(0 <= replay_limit and rt_floor(replay_limit) == replay_limit, "Replay depth must be a nonnegative integer")
    var replay_stages = 0
    var replay_stage = -1
    var replay_limited = false
    var last_at = 0
    dv_domain(mind, "mind")
    dv_require((not (remaining < 0)), "Negative simulation budget")
    dv_require((not (start < 0)), "Negative model origin time")
    let mask_plan = dv_find(hypothesis, "mask_plan", plan)
    predicted = dvs_sim_mask_response(actor, dvs_sim_mask(mind, mask_plan, start), mask_plan)
    if (0 < rt_count(assumptions)):
        dv_require((confidence < 1), "Hypothetical assumption cannot have certainty")
    while dv_and((i < rt_count(assumptions)), (not (remaining < 1))):
        var assumption = assumptions[i]
        remaining = (remaining - 1)
        expanded = (expanded + 1)
        if (assumption.op == "equals"):
            var ref = assumption.ref
            if dv_has_key(predicted.objects, ref.object):
                predicted = dv_store(predicted, ref, dv_cell(assumption.value, confidence, start, hypothesis.basis))
                rt_push(assumption_records, {"proposition": assumption, "confidence": confidence, "role": "hypothetical-only"})
            else:
                complete = false
                rt_push(failures, {"assumption": assumption, "reason": "unknown-subject-local-object"})
        else:
            complete = false
            rt_push(failures, {"assumption": assumption, "reason": "unsupported-assumption"})
        i = (i + 1)
    if (i < rt_count(assumptions)):
        complete = false
    i = 0
    while i < rt_count(plan) and 0 < remaining and (plan[i].stage == replay_stage or replay_stages < replay_limit):
        var step = plan[i]
        if step.stage != replay_stage:
            replay_stage = step.stage
            replay_stages = replay_stages + 1
        var name = plan[i].law
        var at = plan[i].at
        var adoptions = mind.adoptions
        dv_require((not (at < last_at)), "Model time cannot move backwards")
        remaining = (remaining - 1)
        expanded = (expanded + 1)
        last_at = at
        if dv_has_key(step, "response"):
            var response = dvs_sim_gated_response(actor, dv_with(predicted, "domain", "mind"), step, (start + at), remaining, confidence)
            var detail = response.detail
            predicted = response.world
            remaining = response.remaining
            expanded = (expanded + detail.expanded)
            detail = dv_with(detail, "choice_record_changes", response.changes)
            if (detail.status == "selected"):
                var bridge = dvs_sim_response_bridge(actor, predicted, detail, (start + at), remaining, confidence)
                predicted = bridge.world
                remaining = bridge.remaining
                expanded = (expanded + bridge.expanded)
                detail = dv_with(detail, "bridge", bridge)
                if (bridge.status == "applied"):
                    var changes = bridge.changes
                    var j = 0
                    while (j < rt_count(changes)):
                        if dv_has(covered, changes[j].ref):
                            false
                        else:
                            rt_push(covered, changes[j].ref)
                        j = (j + 1)
                else:
                    complete = false
                    rt_push(failures, {"response": step.response, "reason": bridge.status})
            else:
                if dv_and((detail.status == "not-applicable"), step.optional):
                    false
                else:
                    complete = false
                    rt_push(failures, {"response": step.response, "reason": detail.reason})
            rt_push(trace, {"step": i, "at": at, "stage": step.stage, "response": detail})
        else:
            var selected_steps = [step]
            if dv_has_key(step, "dispatch"):
                let dispatch = dvs_sim_dispatch(mind, predicted, step)
                selected_steps = dispatch.steps
                rt_push(trace, {"step": i, "at": at, "stage": step.stage, "status": "indexed-dispatch", "indexed": dispatch.indexed, "inputs": dispatch.inputs, "excluded": dispatch.excluded, "changes": []})
            var selected_index = 0
            while (selected_index < rt_count(selected_steps) and (not dv_has_key(step, "dispatch") or 0 < remaining)):
                if dv_has_key(step, "dispatch"):
                    remaining = remaining - 1
                    expanded = expanded + 1
                let execution = dvs_sim_rule(predicted, covered, selected_steps[selected_index], mind, confidence, start, i, rt_count(events), selected_index)
                predicted = execution.world
                covered = execution.coverage
                complete = complete and execution.complete
                var entry_index = 0
                while (entry_index < rt_count(execution.trace)):
                    rt_push(trace, execution.trace[entry_index])
                    entry_index = entry_index + 1
                entry_index = 0
                while (entry_index < rt_count(execution.failures)):
                    rt_push(failures, execution.failures[entry_index])
                    entry_index = entry_index + 1
                selected_index = selected_index + 1
            if (selected_index < rt_count(selected_steps)):
                complete = false
        rt_push(snapshots, {"world": predicted, "coverage": dv_clone(covered), "step": i, "at": at})
        i = (i + 1)
    if i < rt_count(plan):
        replay_limited = plan[i].stage != replay_stage and replay_limit <= replay_stages
    if dv_or((rt_count(plan) == 0), (i < rt_count(plan))):
        complete = false
    i = 0
    while (i < rt_count(features)):
        rt_push(predictions, dvs_sim_prediction(features[i], dvs_sim_snapshot(snapshots, predicted, covered, features[i]), start))
        i = (i + 1)
    var comparison = dvs_sim_comparisons(mind, predictions, remaining)
    var result = dv_with_many(comparison, {"expanded": (expanded + comparison.expanded), "failures": failures, "coverage": covered, "assumptions": assumption_records, "predictions": predictions, "trace": trace})
    result = dv_with(result, "predicted", predicted)
    if dv_and((not complete), (result.status == "explained")):
        result = dv_with(result, "status", "unknown")
    result = dv_with_many(result, {"plan_complete": complete, "source_revision": mind.revision, "original_revision": mind.revision, "role": "internal-enumeration", "start_time": start})
    var local_2 = false
    if (result.remaining < 1):
        local_2 = "budget-exhausted"
    else:
        if rt_count(plan) == 0:
            local_2 = "no-declared-plan"
        else:
            if complete:
                local_2 = "declared-plan-complete"
            else:
                local_2 = "declared-plan-incomplete"
    result = dv_with_many(result, {"calculation_unit": "one-assumption-predict-rule-indexed-dispatch-context-binding-option-prediction-option-evaluation-response-dispatch-or-feature-comparison", "stop_reason": local_2})
    if replay_limited:
        result = dv_with(result, "stop_reason", "replay-depth-exhausted")
    result = dv_with_many(result, {"replay_depth_limit": replay_limit, "replay_stages_expanded": replay_stages, "replay_depth_exhausted": replay_limited})
    result = dv_with_many(result, {"work_remaining": result.remaining, "remaining": (total_budget - result.expanded)})
    result = dv_with_many(result, {"original_expanded": result.expanded, "total_expanded": result.expanded})
    var parents = dvs_cognitive_parents(actor, dv_single(parent))
    var paid = dv_find(actor, "model_paid_event", "")
    var previous = dv_find(actor, "model_previous_event", "")
    if dv_and((not (paid == "")), (not dv_has(parents, paid))):
        rt_push(parents, paid)
    if dv_and((not (previous == "")), (not dv_has(parents, previous))):
        rt_push(parents, previous)
    dvs_event(events, "mind_simulation", actor.id, time, parents, {"mind_revision": mind.revision, "hypothesis": hypothesis, "result": result, "actor_before": dv_without(actor, "simulations"), "actor_id": actor.id})
    return result

// Recomparison only reuses a completed prediction under the identical source context.
// Missing metadata, partial plans and changed inputs require a new paid model run.
fn dvs_model_recheck_eligible(actor, hypothesis, model, time):
    if model == false:
        return false
    if dv_find(dv_find(model, "evaluation_scope", []), "kind", "") == "causal-refutation":
        return false
    let required = ["plan_complete", "failures", "source_revision", "source_mind_time", "source_hypothesis", "source_adoptions", "source_response_models", "source_replay_depth", "start_time"]
    var i = 0
    while i < rt_count(required):
        if not dv_has_key(model, required[i]):
            return false
        i = i + 1
    if not model.plan_complete or rt_count(model.failures) != 0:
        return false
    if model.source_revision != actor.mind.revision or model.source_mind_time != actor.mind.time:
        return false
    if not dv_same(model.source_hypothesis, hypothesis):
        return false
    if not dv_same(model.source_adoptions, actor.mind.adoptions):
        return false
    if not dv_same(model.source_response_models, dv_find(actor, "response_models", [])):
        return false
    let depth = dv_find(actor.policy, "Replay_Depth", rt_count(dvs_sim_plan(hypothesis)))
    if model.source_replay_depth != depth:
        return false
    return model.start_time == dv_find(hypothesis, "start_time", time)

fn dvs_model_recheck(actor, model):
    var mind = actor.mind
    var comparison = dvs_sim_comparisons(actor.mind, model.predictions, dvs_sim_work_budget(actor))
    var result = dv_clone(model)
    var keys = dv_list3("fit", "comparisons", "contradictions")
    var i = 0
    rt_push(keys, "remaining")
    rt_push(keys, "expanded")
    rt_push(keys, "probe_refs")
    rt_push(keys, "status")
    while (i < rt_count(keys)):
        result = dv_with(result, keys[i], dv_get(comparison, keys[i]))
        i = (i + 1)
    if dv_and((not model.plan_complete), (result.status == "explained")):
        result = dv_with(result, "status", "unknown")
    result = dv_with_many(result, {"work_remaining": comparison.remaining, "remaining": (dv_find(actor.policy, "model_budget", 0) - comparison.expanded)})
    var local_1 = false
    if (comparison.remaining < 1):
        local_1 = "budget-exhausted"
    else:
        local_1 = "observations-compared"
    result = dv_with_many(result, {"total_expanded": (dv_find(model, "total_expanded", model.expanded) + comparison.expanded), "stop_reason": local_1})
    if dv_find(model, "replay_depth_exhausted", false):
        result = dv_with(result, "stop_reason", "replay-depth-exhausted")
    return dv_with_many(result, {"source_revision": mind.revision, "paid_model_event": dv_find(model, "paid_model_event", dv_find(model, "event", "")), "role": "new-observation-recheck"})

fn dvs_sim_response_unknown(world, remaining, reason):
    return {"world": world, "changes": [], "remaining": remaining, "detail": {"status": "unknown", "reason": reason, "expanded": 0, "committed": false}}

fn dvs_sim_response(actor, world, stage, time, remaining, confidence):
    var models = dv_find(actor, "response_models", [])
    var model_id = stage.model
    if (not dv_has_key(models, model_id)):
        return dvs_sim_response_unknown(world, remaining, "no-subject-local-response-model")
    else:
        var model = dv_with(dv_get(models, model_id), "confidence", dv_min(confidence, dv_find(dv_get(models, model_id), "confidence", 0)))
        if (not dv_and((dv_find(model, "owner", "") == actor.id), dv_and((0 < rt_count(dv_find(model, "basis", []))), (0 < dv_unit(dv_find(model, "confidence", 0)))))):
            return dvs_sim_response_unknown(world, remaining, "unavailable-response-model-basis")
        else:
            var local = dv_clone(model.world)
            var bindings = dv_find(model, "context", [])
            var option_ids = stage.options
            var catalog = model.options
            var policy_id = model.policy_id
            var request_id = stage.request
            var requests = model.requests
            var required = (rt_count(bindings) + (2 * rt_count(option_ids)))
            dv_domain(local, "mind")
            if (remaining < required):
                return dvs_sim_response_unknown(world, remaining, "method-work-limit-before-response")
            else:
                if (not dv_has_key(requests, request_id)):
                    return dvs_sim_response_unknown(world, remaining, "unknown-modeled-request")
                else:
                    if (not dv_has_key(dv_find(local, "policies", []), policy_id)):
                        return dvs_sim_response_unknown(world, remaining, "unknown-modeled-value-policy")
                    else:
                        var accepted = dv_get(local.policies, policy_id)
                        if (not dv_and(accepted.active, (0 < rt_count(accepted.basis)))):
                            return dvs_sim_response_unknown(world, remaining, "unadopted-modeled-value-policy")
                        else:
                            var request = dv_get(requests, request_id)
                            var options = []
                            var inputs = []
                            var option_traces = []
                            var i = 0
                            var complete = true
                            var expanded = 0
                            var chosen = false
                            var prediction = false
                            var response = false
                            var next = world
                            var changes = []
                            var reason = "unknown-response-basis"
                            var response_confidence = model.confidence
                            local = dv_with_many(local, {"time": time, "seen": []})
                            while (i < rt_count(bindings)):
                                var binding = bindings[i]
                                var cell = dv_read(world, bindings[i].from)
                                expanded = (expanded + 1)
                                remaining = (remaining - 1)
                                rt_push(inputs, {"from": binding.from, "to": binding.to, "cell": cell})
                                if dv_and(dv_uncontested(cell), (0 < cell.confidence)):
                                    response_confidence = dv_min(response_confidence, cell.confidence)
                                // Bind unknowns without rejecting independent options. Their own
                                // feasibility, predict premises and value reads decide completeness.
                                if dv_has_key(local.objects, binding.to.object):
                                    var local_1 = false
                                    if dv_uncontested(cell):
                                        local_1 = dv_with(cell, "confidence", dv_min(cell.confidence, model.confidence))
                                    else:
                                        local_1 = dv_unknown()
                                    local = dv_store(local, binding.to, local_1)
                                else:
                                    complete = false
                                i = (i + 1)
                            i = 0
                            while (i < rt_count(option_ids)):
                                var option_id = option_ids[i]
                                expanded = (expanded + 2)
                                remaining = (remaining - 2)
                                if dv_has_key(catalog, option_id):
                                    var descriptor = dv_get(catalog, option_id)
                                    var name = dv_find(dv_get(catalog, option_id), "predict_law", "")
                                    var result = false
                                    var legal = dv_truth(local, dv_get(catalog, option_id).feasible)
                                    prediction = dv_no_change_prediction(local)
                                    if (legal == "unknown"):
                                        complete = false
                                        reason = "unknown-required-response-context"
                                    if (name == ""):
                                        false
                                    else:
                                        if dv_has_key(local.adoptions, name):
                                            var adoption = dv_get(local.adoptions, name)
                                            if dv_and(adoption.active, (adoption.mode == "predict")):
                                                result = dv_predict(local, name, rt_cat("response-option-", rt_show(i)), time, local.revision)
                                                if (result.status == "applied"):
                                                    prediction = result.world
                                                else:
                                                    if (legal == "false"):
                                                        false
                                                    else:
                                                        complete = false
                                                        if dv_truth(local, adoption.law.premise) == "unknown":
                                                            reason = "unknown-required-response-context"
                                                        else:
                                                            reason = "response-option-prediction-failed"
                                            else:
                                                if (legal == "false"):
                                                    false
                                                else:
                                                    complete = false
                                        else:
                                            if (legal == "false"):
                                                false
                                            else:
                                                complete = false
                                    rt_push(options, dv_response_option(option_id, descriptor.intent, descriptor.feasible, prediction, descriptor.effort, descriptor.feature_weights))
                                    rt_push(option_traces, {"id": option_id, "legal": legal, "prediction_receipt": result, "model_prediction": prediction})
                                else:
                                    complete = false
                                    rt_push(option_traces, {"id": option_id, "legal": "unknown-option"})
                                i = (i + 1)
                            response = dv_respond_adopted(local, request, options, policy_id)
                            var evaluated = response.evaluated
                            var j = 0
                            var ties = 0
                            var best = 0
                            var found_best = false
                            while (j < rt_count(evaluated)):
                                var evaluation = evaluated[j][1]
                                var score = evaluated[j][1].score
                                if dv_and(evaluation.value.complete, (rt_count(evaluation.relationship_and_state.unknown) == 0)):
                                    false
                                else:
                                    complete = false
                                var local_2 = false
                                if found_best:
                                    local_2 = (best < score)
                                else:
                                    local_2 = true
                                if local_2:
                                    best = score
                                    ties = 1
                                    found_best = true
                                else:
                                    if (best == score):
                                        ties = (ties + 1)
                                j = (j + 1)
                            if (1 < ties):
                                if complete:
                                    reason = "modeled-response-tie"
                                complete = false
                            if dv_and(complete, (response.status == "selected")):
                                var id = response.choice.id
                                var choice_ref = model.choice_ref
                                chosen = id
                                reason = "selected-by-shared-response"
                                if dv_has_key(next.objects, choice_ref.object):
                                    var before = dv_read(next, choice_ref)
                                    var after = dv_cell(id, response_confidence, time, model.basis)
                                    next = dv_store(next, choice_ref, after)
                                    rt_push(changes, {"ref": choice_ref, "before": before, "after": after})
                                else:
                                    complete = false
                                    reason = "unknown-local-choice-record"
                            var local_3 = false
                            if complete:
                                local_3 = response.status
                            else:
                                local_3 = "unknown"
                            var local_4 = false
                            if (chosen == false):
                                local_4 = ""
                            else:
                                local_4 = dv_find(dv_get(catalog, chosen), "bridge_law", "")
                            return {"world": next, "changes": changes, "remaining": remaining, "detail": dv_with_many({"status": local_3, "reason": reason, "expanded": expanded, "committed": false}, {"model": model_id, "model_basis": model.basis, "context_inputs": inputs, "option_predictions": option_traces, "response": response, "selected": chosen, "bridge_law": local_4})}

fn dvs_sim_mask_response_option(world, model, option_id):
    var option = dv_find(model.options, option_id, [])
    if dv_has_key(option, "bridge_law"):
        var name = option.bridge_law
        if dv_has_key(world.adoptions, name):
            return dvs_sim_withhold(world, dv_get(world.adoptions, name).law.effects).world
        else:
            return world
    else:
        return world

fn dvs_sim_mask_response_stage(actor, world, stage):
    var models = dv_find(actor, "response_models", [])
    var id = stage.model
    if dv_has_key(models, id):
        var model = dv_get(models, id)
        var options = stage.options
        var i = 0
        var copy = world
        if dv_has_key(model, "choice_ref"):
            if dv_has_key(copy.objects, model.choice_ref.object):
                copy = dv_store(copy, model.choice_ref, dv_unknown())
        while (i < rt_count(options)):
            copy = dvs_sim_mask_response_option(copy, model, options[i])
            i = (i + 1)
        return copy
    else:
        return world

fn dvs_sim_mask_response(actor, world, plan):
    var copy = world
    var i = 0
    while (i < rt_count(plan)):
        var step = plan[i]
        if dv_has_key(step, "response"):
            copy = dvs_sim_mask_response_stage(actor, copy, step.response)
        i = (i + 1)
    return copy

fn dvs_sim_response_bridge(actor, world, detail, time, remaining, confidence):
    var name = detail.bridge_law
    var adoptions = actor.mind.adoptions
    if dv_or((name == ""), (not dv_has_key(adoptions, name))):
        return dv_with({"world": world, "changes": [], "remaining": remaining, "status": "unknown-response-bridge"}, "expanded", 0)
    else:
        var adoption = dv_get(adoptions, name)
        var effects = dv_get(adoptions, name).law.effects
        if dv_or((remaining < 1), (not dv_and(adoption.active, (adoption.mode == "predict")))):
            return dv_with({"world": dvs_sim_withhold(world, effects).world, "changes": [], "remaining": remaining, "status": "unavailable-response-bridge"}, "expanded", 0)
        else:
            var local = dv_with_many(world, {"domain": "mind", "adoptions": dv_with(world.adoptions, name, dv_with(adoption, "confidence", dv_min(confidence, dv_min(adoption.confidence, dv_premise_confidence(world, adoption.law.premise)))))})
            var result = false
            result = dv_predict(local, name, rt_cat("response-bridge-", rt_show(world.revision)), time, world.revision)
            var local_1 = false
            if (result.status == "applied"):
                local_1 = result.world
            else:
                local_1 = dvs_sim_withhold(world, effects).world
            return dv_with_many(result, {"world": local_1, "remaining": (remaining - 1), "expanded": 1})

fn dvs_sim_gated_response(actor, world, step, time, remaining, confidence):
    var gate = dv_find(step, "available_when", dv_true())
    var truth = dv_truth(world, dv_find(step, "available_when", dv_true()))
    var result = false
    var local_1 = false
    if (truth == "true"):
        local_1 = dvs_sim_response(actor, world, step.response, time, remaining, confidence)
    else:
        if (truth == "false"):
            local_1 = {"world": world, "changes": [], "remaining": remaining, "detail": {"status": "not-applicable", "reason": "request-gate-false", "expanded": 0, "committed": false}}
        else:
            local_1 = dvs_sim_response_unknown(dvs_sim_mask_response_stage(actor, world, step.response), remaining, "request-gate-unknown")
    result = local_1
    return dv_with(result, "detail", dv_with_many(result.detail, {"gate": gate, "gate_truth": truth, "gate_inputs": dvs_sim_inputs(world, gate)}))

fn dvs_factor_proof_result(valid, remaining, confidence, steps, roots):
    return dv_with({"valid": valid, "remaining": remaining, "confidence": confidence, "steps": steps}, "source_events", roots)

fn dvs_factor_merge(left, right):
    var steps = dv_clone(left.steps)
    var roots = dv_clone(left.source_events)
    var i = 0
    while (i < rt_count(right.steps)):
        rt_push(steps, right.steps[i])
        i = (i + 1)
    i = 0
    while (i < rt_count(right.source_events)):
        if dv_has(roots, right.source_events[i]):
            false
        else:
            rt_push(roots, right.source_events[i])
        i = (i + 1)
    return dvs_factor_proof_result(dv_and(left.valid, right.valid), right.remaining, dv_min(left.confidence, right.confidence), steps, roots)

fn dvs_factor_law_allowed(allowed, law):
    var i = 0
    var found = false
    while (i < rt_count(allowed)):
        if dv_and((allowed[i].id == law.name), (allowed[i].version == law.version)):
            found = true
        i = (i + 1)
    return found

fn dvs_factor_roots(actor, mind, ref, events, cutoff, remaining, allowed):
    var cell = dv_read(mind, ref)
    var result = dvs_factor_proof_result(false, remaining, 0, [], [])
    if (not (remaining < 1)):
        result = dvs_factor_proof_result(false, (remaining - 1), 0, [], [])
        if dv_and(dv_uncontested(cell), dv_and((0 < cell.confidence), dv_and((not dv_find(cell, "estimated", false)), (not (dv_find(cell, "source", "") == "abduction"))))):
            // The same ordered receipt candidates are shared by recursive proof
            // reads. Exact claim, cell, law, cutoff and budget checks remain below.
            let support_index = dvs_support_event_index(events, actor.id)
            let positions = dv_find(support_index.refs, dvs_support_ref_key(actor.id, ref), [])
            var candidate_index = 0
            while dv_and((candidate_index < rt_count(positions)), (not result.valid)):
                let i = positions[candidate_index]
                if cutoff <= i:
                    return result
                var event = events[i]
                if (event.actor == actor.id):
                    var kind = event.type
                    var data = event.data
                    if dv_or((kind == "observation"), (kind == "listener_parse")):
                        if dv_has_key(data, "mind_after"):
                            if dv_same(dv_read(data.mind_after, ref), cell):
                                var observations = dv_find(data, "observations", [])
                                var j = 0
                                var claims = dv_find(cell, "claims", [])
                                var valid = true
                                var confidence = cell.confidence
                                var roots = []
                                var steps = []
                                if (rt_count(claims) == 0):
                                    valid = false
                                while (j < rt_count(claims)):
                                    var claim = claims[j]
                                    var source = claims[j].source
                                    if dv_and(dv_has(observations, claim), dv_and((claim.subject == actor.id), dv_and(dv_same_local_ref(actor.id, claim.ref, ref), dv_and(dv_has(data.mind_after.seen, claim.id), dv_or((source == "perception"), dv_or((source == "recall"), (source == "testimony"))))))):
                                        confidence = dv_min(confidence, claim.trust)
                                    else:
                                        valid = false
                                    j = (j + 1)
                                if dv_and(valid, (0 < confidence)):
                                    rt_push(roots, event.id)
                                    rt_push(steps, dv_with({"kind": "observation", "event": event.id, "ref": ref, "cell": cell}, "observations", claims))
                                    result = dvs_factor_proof_result(true, result.remaining, confidence, steps, roots)
                    if (kind == "inference"):
                        result = dvs_factor_inference(actor, mind, ref, cell, events, i, data, event, result.remaining, allowed)
                candidate_index = candidate_index + 1
    return result

fn dvs_factor_refs_proof(actor, mind, refs, events, cutoff, remaining, allowed):
    var result = dvs_factor_proof_result(true, remaining, 1, [], [])
    var i = 0
    while dv_and(result.valid, (i < rt_count(refs))):
        result = dvs_factor_merge(result, dvs_factor_roots(actor, mind, refs[i], events, cutoff, result.remaining, allowed))
        i = (i + 1)
    return result

fn dvs_factor_inference(actor, mind, ref, cell, events, index, data, event, remaining, allowed):
    var law = data.law
    var before = data.mind_before
    var receipt = data.receipt
    var current = actor.mind.adoptions
    var name = data.law.name
    var result = dvs_factor_proof_result(false, remaining, 0, [], [])
    var changes = dv_find(data.receipt, "changes", [])
    var i = 0
    var found = false
    while (i < rt_count(changes)):
        if dv_and(dv_same(changes[i].ref, ref), dv_same(changes[i].after, cell)):
            found = true
        i = (i + 1)
    if dv_and(found, dv_and((receipt.status == "applied"), dv_and(dvs_factor_law_allowed(allowed, law), dv_and(dv_has_key(current, name), dv_has_key(before.adoptions, name))))):
        var adoption = dv_get(current, name)
        if dv_and(dv_same(adoption, dv_get(before.adoptions, name)), dv_and(adoption.active, dv_and((adoption.mode == "infer"), dv_and(dv_same(law, adoption.law), (dv_truth(before, law.premise) == "true"))))):
            if (remaining < 1):
                false
            else:
                var replayed = dv_infer(before, name, receipt.event, receipt.time, before.revision)
                result = dvs_factor_proof_result(false, (remaining - 1), 0, [], [])
                if dv_and(dv_same(replayed, receipt), dv_same(data.mind_after, receipt.world)):
                    var sources = dvs_factor_refs_proof(actor, before, dvs_sim_refs(law.premise), events, index, result.remaining, allowed)
                    result = sources
                    if dv_and(sources.valid, (0 < rt_count(sources.source_events))):
                        result = dv_with_many(sources, {"source_events": dv_append(sources.source_events, event.id), "confidence": dv_min(cell.confidence, dv_min(adoption.confidence, sources.confidence)), "steps": dv_append(sources.steps, dv_with({"kind": "infer", "event": event.id, "ref": ref, "cell": cell}, "adoption", adoption))})
                    else:
                        result = dv_with(sources, "valid", false)
    return result

fn dvs_factor_domain(domains, id):
    var i = 0
    var result = false
    while (i < rt_count(domains)):
        if (domains[i].id == id):
            result = domains[i]
        i = (i + 1)
    return result

fn dvs_factor_schema(domains, constraint):
    var assignments = constraint.assignments
    var scope = constraint.scope
    var versions = constraint.domain_versions
    var ids = []
    var facts = []
    var free = []
    var valid = true
    var i = 0
    var allids = []
    var refs = []
    if dv_or((rt_count(assignments) == 0), (rt_count(dv_find(constraint, "basis", [])) == 0)):
        valid = false
    while (i < rt_count(domains)):
        var domain = domains[i]
        var values = domains[i].values
        var j = 0
        var seen = []
        if dv_or(dv_has(allids, domain.id), dv_has(refs, domain.ref)):
            valid = false
        rt_push(allids, domain.id)
        rt_push(refs, domain.ref)
        if dv_or((rt_count(values) == 0), (not (0 < domain.version))):
            valid = false
        while (j < rt_count(values)):
            if dv_has(seen, values[j]):
                valid = false
            rt_push(seen, values[j])
            j = (j + 1)
        i = (i + 1)
    i = 0
    while (i < rt_count(assignments)):
        var assignment = assignments[i]
        var id = assignments[i].variable
        var domain = dvs_factor_domain(domains, assignments[i].variable)
        if dv_has(ids, id):
            valid = false
        rt_push(ids, id)
        if (domain == false):
            valid = false
        else:
            if dv_and(dv_has(domain.values, assignment.value), (dv_find(versions, id, -1) == domain.version)):
                false
            else:
                valid = false
            rt_push(facts, dv_fact(domain.ref, assignment.value))
        i = (i + 1)
    if (rt_count(scope) == rt_count(ids)):
        false
    else:
        valid = false
    i = 0
    while (i < rt_count(ids)):
        if dv_has(scope, ids[i]):
            false
        else:
            valid = false
        i = (i + 1)
    i = 0
    while (i < rt_count(scope)):
        if dv_has(ids, scope[i]):
            false
        else:
            valid = false
        i = (i + 1)
    if (rt_count(facts) == 1):
        if dv_same(constraint.condition, facts[0]):
            false
        else:
            valid = false
    else:
        if dv_same(constraint.condition, dv_all(facts)):
            false
        else:
            valid = false
    i = 0
    while (i < rt_count(domains)):
        if dv_has(ids, domains[i].id):
            false
        else:
            rt_push(free, domains[i])
        i = (i + 1)
    return {"valid": valid, "fixed": assignments, "free_domains": free}

fn dvs_factor_scope_proof(domains, fixed, proof):
    var steps = proof.steps
    var i = 0
    var valid = true
    while (i < rt_count(steps)):
        var step = steps[i]
        var j = 0
        while (j < rt_count(domains)):
            var domain = domains[j]
            var k = 0
            var included = false
            if dv_same(step.ref, domain.ref):
                while (k < rt_count(fixed)):
                    if (fixed[k].variable == domain.id):
                        included = true
                    k = (k + 1)
                if included:
                    false
                else:
                    valid = false
            j = (j + 1)
        i = (i + 1)
    return valid

fn dvs_factor_covers(certificate, assignments):
    var fixed = certificate.covered_assignments.fixed
    var i = 0
    var valid = true
    while (i < rt_count(fixed)):
        if dv_has(assignments, fixed[i]):
            false
        else:
            valid = false
        i = (i + 1)
    return valid

fn dvs_factor_paid(actor, events):
    var id = dv_find(actor, "model_paid_event", "")
    if id == "":
        return false
    let event = dvs_find_event_by_id(events, id)
    if event == false:
        return false
    if dv_and((event.id == id), dv_and((event.actor == actor.id), (event.type == "action_execution"))):
        var data = event.data
        if dv_and((data.action.kind == "replay"), dv_and((data.receipt.execution.status == "applied"), (dv_get(data.receipt.ledger.receipts, data.receipt.receipt.event).state == "settled"))):
            return true
    return false

fn dvs_factor_prune(actor, events, time, parent):
    var policy = actor.policy
    var mind = actor.mind
    var domains = dv_find(actor.policy, "factor_domains", [])
    var constraints = dv_find(actor.policy, "factor_constraints", [])
    var cap = dv_find(actor.policy, "prune_confidence_limit", 0)
    var remaining = dvs_sim_work_budget(actor)
    var initial = dvs_sim_work_budget(actor)
    var certificates = []
    var rejections = []
    var i = 0
    var result = false
