        dv_adopt_into(domain, owned_adoptions, campaign_method("moran.c2.casualty.fatal_dust", c2_moran_acute_collapse_law()), mode, 1, [c2_source("docs/design-standard.md", 0, "莫兰吸入致死量微粒休克昏死兼容别名")])
