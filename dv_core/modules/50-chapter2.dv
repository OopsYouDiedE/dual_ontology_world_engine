    rt_push(rows, c2daily_say("su", "su.c2.stethoscope-ask", "living_hall", ding, "请求试用听诊器", "茉拉，听诊器可以让我试试吗？", ["mora"]))
    rt_push(rows, c2daily_after(c2daily_say("mora", "mora.c2.stethoscope-consent", "living_hall", ding, "同意并说明听诊器用法", "可以，先擦净耳件；我在旁边教你听，听到什么再说什么。", ["su"]), "su", "su.c2.stethoscope-ask"))
