    rt_push(rows, c2daily_say("selma", "selma.c2.refractive-index", "lecture", lesson, "讨论源质的折射率", "它的折射率随浓度怎么变？看见颜色，能推到哪一步？", ["demon"]))
    rt_push(rows, c2daily_say("ward", "ward.c2.rule-two", "lecture", lesson, "询问守则第二条的权限", "守则第二条的权限边界，应当逐项说清。执行规则的权限从哪里来？", ["demon"]))
    rt_push(rows, c2daily_after(c2daily_say("ruan", "ruan.c2.rule-four", "lecture", lesson, "询问守则第四条的范围", "第四条说“我所立之规，皆张贴于此”。是否意味着尚有非你所立之规？", ["demon"]), "demon", "demon.c2.school-rule4"))
    let rule = dv_fact(c2d_ref("school_rule4"), "我所立之规，皆张贴于此。")
    rt_push(rows, c2d_row("demon", "demon.c2.school-rule4", "lecture", lesson, rule, "重申守则第四条", "第四条：我所立之规，皆张贴于此。", campaign_approved("school-rule-four-actual-teaching")))
    let noon = dv_all([campaign_window(2, 720, 810), dv_fact(c2daily_ref("meal_prepared"), true)])
    let table1 = ["detective", "huo", "shen", "quer"]
