    rt_push(rows, c2daily_say("shen", "shen.c2.lunch-egg", "living_hall", noon, "谈论午餐与烹饪", "荷包蛋要护着边儿下锅。今天先把烩菜、热汤和面饼吃热乎。", table1))
    rt_push(rows, c2daily_say("gu", "gu.c2.lunch-order", "living_hall", noon, "讨论旧籍中的秩序", "秩序二字，旧籍各有用法。先辨时代与出处，再议今日怎样用。", table2))
    rt_push(rows, c2daily_say("lucian", "lucian.c2.lunch-portrait", "living_hall", noon, "讨论群像画法", "这四桌若写进诗里，不能只写十六张脸；莫兰，你会先画谁的手？", table3))
    rt_push(rows, c2daily_say("ruan", "ruan.c2.lunch-rations", "living_hall", noon, "核算口粮份数", "九十九份，每日十六人两餐，九十九除以三十二，是三天余三份。账要跟着真正拿走的份数走。", table4))
    let notes_window = c2daily_notes_window()
    rt_push(rows, c2daily_say("ruan", "ruan.c2.discuss-supplement", "central_hall", dv_all([notes_window, dv_fact(c2daily_ref("draft_notes"), true)]), "讨论补记栏草案", "我起草的补记栏在这里：夜间急需记下取用者、份数、用途，次日一起核对。请逐条议。", ["ward"]))
