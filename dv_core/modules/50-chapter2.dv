fn c2_shura_actions(actor):
    var result = []
    let source = campaign_source("docs/design-standard.md", 0, "修罗侦探路线：密室监禁与火山口终极升格仪式")
    if actor == "detective":
        let id = "detective.c2.intercom.manipulate"
        let pre = dv_all([campaign_at("detective", "living_hall"), dv_fact(campaign_ref("c2.trial", "detective_imprisoned"), true), dv_fact(campaign_ref("c2.trial", "intercom_reversed"), false)])
        let effects = [dv_assign(campaign_ref("c2.trial", "intercom_reversed"), true)]
        let grants = [campaign_ref("c2.trial", "intercom_reversed")]
        let act = campaign_surface_action(id, "talk", pre, pre, id, grants, "用传声管与看守交涉", "被监禁的侦探使用铜口传声管，向门外看守讲述片面真话挑拨矛盾，诱使看守擅离职守或开启门锁。", source)
        rt_push(result, dv_with_many(act, {"effects": effects, "repeatable": false, "public_observers": campaign_people(), "public_grants": grants}))
    if actor == "detective":
        let id = "detective.c2.ascension.execute"
        let pre = dv_all([campaign_at("detective", "living_hall"), c2_all_companions_fallen()])
        let effects = [dv_assign(campaign_ref("c2.ascension", "godhood_achieved"), true)]
        let grants = [campaign_ref("c2.ascension", "godhood_achieved")]
        let act = campaign_surface_action(id, "experiment", pre, pre, id, grants, "举行升格仪式", "收齐十五人源质印记旧物与铭文，在火山口深处举行升格仪式，全员献祭突破契约遣返限制，同化为超越契约的新神明。", source)
        rt_push(result, dv_with_many(act, {"effects": effects, "repeatable": false, "public_observers": ["detective", "demon"], "public_grants": grants}))
    return result

fn c2_actor_actions(actor):
    var result = c2_inspections(actor)
    let edges = c2_edges()
    var i = 0
    while i < rt_count(edges):
        let edge = edges[i]
        rt_push(result, c2_move_action(actor, edge.from, edge.to, edge.gate))
        rt_push(result, c2_move_action(actor, edge.to, edge.from, edge.gate))
        i = i + 1
    let rows = [c2i_evening_actions(actor), c2i_record_actions(actor), c2_supply_actions(actor), c2_special_actions(actor), c2_corridor_actions(actor), c2i_actions(actor), c2_safety_actions(actor), c2m_actions(actor), c2_foolish_duty_actions(actor), c2_hero_actions(actor), c2_casualty_actions(actor), c2_anti_erosion_actions(actor), c2_unconventional_actions(actor), c2_dead_hand_actions(actor), c2_shura_actions(actor)]
    i = 0
    while i < rt_count(rows):
        var j = 0
        while j < rt_count(rows[i]):
            rt_push(result, rows[i][j])
            j = j + 1
        i = i + 1
    let norms = c2_norms()
    i = 0
    while i < rt_count(norms):
        let actions = c2_norm_actions(actor, norms[i])
        var j = 0
        while j < rt_count(actions):
            rt_push(result, actions[j])
            j = j + 1
        i = i + 1
    let observations = c2_compact_observations(actor)
    i = 0
    while i < rt_count(observations):
        rt_push(result, observations[i])
        i = i + 1
    rt_push(result, dv_with(campaign_surface_action(rt_cat(actor, ".c2.inspect.self"), "inspect", dv_true(), c2_alive(actor), "", c2_self_grants(actor), "检查随身口粮与待办事项", "看看手里的口粮，想想还有什么事没办。", campaign_person_source(actor)), "repeatable", true))
    var prepared = []
    i = 0
    while i < rt_count(result):
        var action = dv_with_many(result[i], {"precondition": dv_all([result[i].precondition, c2_can_act(actor)]), "authority_precondition": dv_all([result[i].authority_precondition, c2_can_act(actor)])})
        if dv_find(result[i], "law", "") != "":
            action = dv_with(action, "predict_law", action.law)
        rt_push(prepared, action)
        i = i + 1
    return campaign_public_methods(prepared)

// One observation identity per scope. Weather retains the original sight locations.
fn c2_compact_observations(actor):
    let clock = campaign_surface_action(rt_cat(actor, ".c2.inspect.clock"), "inspect", dv_true(), dv_true(), "", [campaign_clock()], "查看时钟", "看了一眼时间。", campaign_approved("campaign-clock-is-actually-observed"))
    let places = ["hall", "living_hall", "central_hall", "logistics", "oath_court"]
    var conditions = []
    var i = 0
    while i < rt_count(places):
        rt_push(conditions, campaign_at(actor, places[i]))
        i = i + 1
    let visible = dv_not(dv_all(c2_negated_conditions(conditions)))
    let fields = ["ash_falling", "wind", "daylight", "earthquake_recent", "environment_epoch"]
    let weather = campaign_surface_action(rt_cat(actor, ".c2.inspect.weather"), "inspect", visible, visible, "", [campaign_ref("c2.weather", "ash_falling"), campaign_ref("c2.weather", "wind"), campaign_ref("c2.weather", "daylight"), campaign_ref("c2.weather", "earthquake_recent"), campaign_ref("c2.weather", "environment_epoch")], "观察廊外天色与风", "望向廊外，看看天色和风，留意现场震动。", campaign_approved("visible-actual-weather-not-other-peoples-exposure"))
    return [dv_with(clock, "repeatable", true), dv_with_many(weather, {"repeatable": true, "presentation": c2_inspection_presentation(actor, "c2.weather", fields)})]

fn c2_self_grants(actor):
    let fields = c2_initial_body(actor).facets.state
    var grants = []
    var i = 0
    while i < rt_count(fields):
        rt_push(grants, campaign_own(actor, fields[i][0]))
        i = i + 1
    return grants

fn c2_install_actor_laws_into(domain, owned_adoptions, actor, mode):
    c2m_install(domain, owned_adoptions, actor, mode)
    c2i_install_laws(domain, owned_adoptions, actor, mode)
    c2i_record_install(domain, owned_adoptions, actor, mode)
    c2_safety_install(domain, owned_adoptions, actor, mode)
    if actor == "mora":
        dv_adopt_into(domain, owned_adoptions, campaign_method("mora.c2.take.anti_erosion", c2_take_anti_erosion_law()), mode, 1, [campaign_approved("actual-care-from-authored-mixed-anti-erosion-medicine")])
        let patients = c2_care_patients()
        var patient_index = 0
        while patient_index < rt_count(patients):
            let patient = patients[patient_index]
            dv_adopt_into(domain, owned_adoptions, campaign_method(rt_cat("mora.c2.administer.anti_erosion.", patient), c2_administer_anti_erosion_law(patient)), mode, 1, [campaign_approved("actual-care-from-authored-mixed-anti-erosion-medicine")])
            patient_index = patient_index + 1
    if actor == "moran":
        dv_adopt_into(domain, owned_adoptions, campaign_method("moran.c2.sketch.evening.go", c2i_evening_choice_law(actor, "go")), mode, 1, [campaign_approved("fourth-evening-owned-choice")])
        dv_adopt_into(domain, owned_adoptions, campaign_method("moran.c2.sketch.evening.stay", c2i_evening_choice_law(actor, "stay")), mode, 1, [campaign_approved("fourth-evening-owned-choice")])
    let source = [c2_source("10_执行.story", 4, "native-operational-actions")]
    let edges = c2_edges()
    var i = 0
    while i < rt_count(edges):
        let edge = edges[i]
        let there = c2_move_action(actor, edge.from, edge.to, edge.gate)
        let back = c2_move_action(actor, edge.to, edge.from, edge.gate)
        dv_adopt_into(domain, owned_adoptions, campaign_method(there.id, c2_move_law(actor, edge.from, edge.to, edge.gate)), mode, 1, source)
        dv_adopt_into(domain, owned_adoptions, campaign_method(back.id, c2_move_law(actor, edge.to, edge.from, edge.gate)), mode, 1, source)
        i = i + 1
    var day = 2
    while day <= 5:
        let meals = [{"id": "noon", "start": 720, "end": 840}, {"id": "evening", "start": 1080, "end": 1260}]
        i = 0
        while i < rt_count(meals):
            let meal = meals[i]
            let suffix = rt_cat(rt_show(day), rt_cat(".", meal.id))
            dv_adopt_into(domain, owned_adoptions, campaign_method(rt_cat(actor, rt_cat(".c2.collect.", suffix)), c2_collect_law(actor, day, meal.id, meal.start, meal.end)), mode, 1, source)
            dv_adopt_into(domain, owned_adoptions, campaign_method(rt_cat(actor, rt_cat(".c2.eat.", suffix)), c2_eat_law(actor, day, meal.id)), mode, 1, source)
            i = i + 1
        day = day + 1
    dv_adopt_into(domain, owned_adoptions, campaign_method(rt_cat(actor, ".c2.open.granary"), c2_open_granary_law(actor)), mode, 1, source)
    dv_adopt_into(domain, owned_adoptions, campaign_method(rt_cat(actor, ".c2.count.initial"), c2_initial_count_law(actor)), mode, 1, [campaign_approved("外间实际清点与新台账")])
    dv_adopt_into(domain, owned_adoptions, campaign_method(rt_cat(actor, ".c2.distribute"), c2_distribute_law(actor)), mode, 1, source)
    dv_adopt_into(domain, owned_adoptions, campaign_method(rt_cat(actor, ".c2.open.total_store"), c2_total_store_open_law(actor)), mode, 1, [campaign_approved("总库开启需要修闩与解锁的实际结果")])
    if actor != "shen":
        dv_adopt_into(domain, owned_adoptions, campaign_method(rt_cat(actor, ".c2.give_key.shen"), c2_give_key_law(actor, "shen")), mode, 1, source)
    dv_adopt_into(domain, owned_adoptions, campaign_method(rt_cat(actor, ".c2.report.night_take"), c2_report_law(actor)), mode, 1, source)
    if dv_has(campaign_people(), actor):
        dv_adopt_into(domain, owned_adoptions, campaign_method(rt_cat(actor, ".c2.night_take"), c2_night_take_law(actor, false)), mode, 1, source)
    dv_adopt_into(domain, owned_adoptions, campaign_method(rt_cat(actor, ".c2.night_eat"), c2_night_eat_law(actor)), mode, 1, source)
    if actor == "mora":
        dv_adopt_into(domain, owned_adoptions, campaign_method("mora.c2.night_take.patient", c2_night_take_law(actor, true)), mode, 1, source)
    if actor == "huo" or actor == "margaret":
