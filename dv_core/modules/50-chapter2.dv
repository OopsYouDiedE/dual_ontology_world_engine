    rt_push(rows, c2daily_after(c2daily_say("ward", "ward.c2.procedural-trap", "central_hall", notes_window, "说明夜间禁取的程序", "按字面公约，擅取即失格。只要夜间禁令确立，没有仲裁组双人签署便动干粮的人，便是自陷毁约之局。", ["gu"]), "ward", "ward.c2.discuss-forbid"))
    rt_push(rows, c2daily_after(c2daily_say("gu", "gu.c2.trap-warning", "central_hall", notes_window, "质疑禁取程序", "沃德，恶魔设的是信息诱饵，你设的是程序圈套。两边都在逼人犯规。如果不把旧账封死，明天无论谁动一口粮，都是你案头上的‘罪人’。", ["ward"]), "ward", "ward.c2.procedural-trap"))
    rt_push(rows, c2daily_after(c2daily_say("ruan", "ruan.c2.counter-gambit", "central_hall", notes_window, "说明补记提案的考虑", "棋盘上的死子，换个落点就是劫材。你在等夜里抓贼把公约做成法庭；我多留这一栏补记，正是要在恶魔借饥饿翻盘前，把死棋下活。", ["ward"]), "gu", "gu.c2.trap-warning"))
    rt_push(rows, c2daily_after(c2daily_say("mora", "mora.c2.care-defiance", "central_hall", notes_window, "说明照护病人的底线", "如果夜里有人发烧快咽气，我不管你的账本是锁着的还是空的。药和粥我照样拿，名字我照样签。你如果要按‘私取’来审判一个救命的医生，那就当着全校十六人的面来审。", ["ward"]), "ruan", "ruan.c2.counter-gambit"))
    let quake = dv_all([campaign_window(4, 1050, 1260), dv_fact(campaign_ref("c2.weather", "earthquake_recent"), true)])
    let color = dv_fact(c2daily_ref("rare_color_layer"), "夹道罕见紫金以太色层")
    var relay_index = 0
    while relay_index < 2:
        let suffix = rt_show(relay_index == 1)
        let declaration = rt_cat("moran.c2.sketch.evening.go.", suffix)
        let relay_id = rt_cat("demon.c2.relay.moran-outing.", suffix)
        let relay = c2d_row("demon", relay_id, "logistics", c2_night(4), dv_true(), "向夜巡者转述外出宣告", "莫兰刚才在我面前说想沿夹道外出写生。这是他当时宣告的去向，我不知道他现在在哪里，也不知道他的身体情况。", campaign_approved("user:2026-10-23-real-heard-route-relay-not-remote-patient-facts"))
        rt_push(rows, dv_with_many(relay, {"listeners": ["bertrand"], "received_speech_requirement": {"speaker": "moran", "action_id": declaration}}))
        relay_index = relay_index + 1
    rt_push(rows, dv_with(c2d_row("demon", "demon.c2.truth-color", "living_hall", quake, color, "介绍夹道的色层", "夹道有罕见的紫金以太色层。", campaign_approved("actual-truthful-color-temptation-after-quake")), "opportunity", {"location": "living_hall", "participants": ["moran"], "mode": "all-present"}))
    let recent_quake = dv_fact(campaign_ref("c2.weather", "earthquake_recent"), true)
    let color_warning = dv_with(c2daily_say("veronica", "veronica.c2.color-refute", "living_hall", quake, "提醒颜色不能证明安全", "颜色好看，不能证明安全。震后要在现场测量浓度，核对读数取得的时刻，再谈能不能出去；别让一句真话把人引出门。", ["moran", "demon"]), "literal", recent_quake)
    rt_push(rows, c2daily_after(color_warning, "demon", "demon.c2.truth-color"))
    let guards = ["detective", "bertrand", "huo"]
    var g = 0
    while g < rt_count(guards):
        let actor = guards[g]
        let id = rt_cat(actor, ".c2.caution-moran")
        var caution = c2daily_say(actor, id, "living_hall", c2_night(4), "劝同伴先复测读数", "莫兰，颜色不能证明安全；读数的时效和路线都要核对。先留在门内，我们复测后再谈出去。", ["moran"])
        caution = dv_with_many(caution, {"safety_warning": true, "personal_choice": {"group": rt_cat("safety-warning.", actor), "requires": c2_night(4), "prohibits": dv_fact(c2d_mark(actor, id), true), "promotes": ["patient_priority", "safety", "measured_work"], "sacrifices": [], "basis": [campaign_approved("user:2026-10-18-owned-safety-intervention")]}})
        rt_push(rows, caution)
        let commitment = campaign_own(actor, "guard_commitment")
        let guard_source = campaign_approved("user:2026-10-18-owned-safety-intervention")
        var undertake = c2daily_say(actor, rt_cat(actor, ".c2.guard.undertake"), "living_hall", c2_night(4), "承诺承担守门轮班", "这一班我愿意守门；真正到岗后值守，离岗时交接。", ["moran"])
        undertake = dv_with_many(undertake, {"guard_decision": true, "repeatable": true, "owned_decision": c2_guard_decision(actor, "committed", guard_source), "effects": [dv_assign(commitment, true)], "personal_choice": {"group": rt_cat("guard-duty.", actor), "requires": c2_night(4), "prohibits": dv_fact(commitment, true), "promotes": ["patient_priority", "safety", "measured_work"], "sacrifices": ["research"], "basis": [guard_source]}})
        rt_push(rows, undertake)
        var decline = c2daily_say(actor, rt_cat(actor, ".c2.guard.decline"), "living_hall", c2_night(4), "谢绝本次守门轮班", "这班我暂不承担；请由愿意留下的人实际到岗，我的这句话不算有人值守。", ["moran"])
        decline = dv_with_many(decline, {"guard_decision": true, "repeatable": true, "owned_decision": c2_guard_decision(actor, "declined", guard_source), "effects": [dv_assign(commitment, false)], "personal_choice": {"group": rt_cat("guard-duty.", actor), "requires": c2_night(4), "prohibits": dv_fact(commitment, true), "promotes": ["research"], "sacrifices": ["patient_priority", "safety", "measured_work"], "basis": [guard_source]}})
        rt_push(rows, decline)
        g = g + 1
    let people = campaign_people()
    let venues = ["oath_court", "central_hall"]
    var v = 0
    while v < rt_count(venues):
        let room = venues[v]
        var weather = dv_fact(campaign_ref("c2.weather", "wind"), true)
        if room == "central_hall":
            weather = dv_fact(campaign_ref("c2.weather", "wind"), false)
        let present = [c2d_council_when(), weather]
        var i = 0
        while i < rt_count(people):
            let actor = people[i]
            let stance = campaign_any(dv_fact(campaign_own(actor, "accepted.open_plan"), true), campaign_any(dv_fact(campaign_own(actor, "accepted.seal_plan"), true), dv_fact(campaign_own(actor, "accepted.committee_plan"), true)))
            let options = ["open_plan", "seal_plan", "committee_plan"]
            let labels = ["核对读数后组织外出劳作", "风止震后先留安全处复测", "公用物资逐项登记共同核对"]
            var n = 0
            while n < rt_count(options):
                var ballot = c2daily_say(actor, rt_cat(actor, rt_cat(".c2.vote.", rt_cat(room, options[n]))), room, dv_all([dv_all(present), c2_alive(actor), dv_fact(campaign_own(actor, rt_cat("accepted.", options[n])), true), dv_fact(c2daily_ref(rt_cat("voted.", actor)), false)]), rt_cat("投票：", labels[n]), rt_cat("我的票投给：", labels[n]), [])
                ballot = dv_with(ballot, "effects", [dv_assign(c2daily_ref(rt_cat("voted.", actor)), true), dv_assign(c2daily_ref(rt_cat("ballot.", actor)), options[n]), dv_increment(c2daily_ref(rt_cat("votes.", options[n])), 1)])
                let norms = c2_norms()
                var q = 0
                while q < rt_count(norms):
                    let norm = norms[q]
                    if norm.id == options[n]:
                        ballot = dv_with(ballot, "personal_choice", {"group": "council-ballot", "requires": dv_fact(campaign_own(actor, rt_cat("accepted.", norm.id)), true), "prohibits": dv_fact(c2daily_ref(rt_cat("voted.", actor)), true), "promotes": norm.promotes, "sacrifices": norm.sacrifices, "basis": [norm.source]})
                    q = q + 1
                rt_push(rows, ballot)
                n = n + 1
            var vote = c2daily_say(actor, rt_cat(actor, rt_cat(".c2.sign.", room)), room, dv_all([dv_all(present), c2_alive(actor), stance, dv_fact(c2daily_ref(rt_cat("voted.", actor)), true), dv_fact(c2daily_ref(rt_cat("signed.", actor)), false)]), "签署本人赞成的提案", "我把本人赞成的提案与保留意见写入公约，签名交众人核对。", [])
            vote = dv_with(vote, "effects", [dv_assign(c2daily_ref(rt_cat("signed.", actor)), true)])
            vote = dv_with(vote, "observation_grants", [c2daily_ref("council_closed")])
            rt_push(rows, vote)
            i = i + 1
        v = v + 1
    return rows

axiom c2daily_cook_law():
    let pre = dv_all([campaign_at("shen", "logistics"), campaign_window(2, 690, 810), dv_fact(c2daily_ref("meal_cooked"), false)])
    return dv_axiom("c2daily_cook_law", 1, pre, [dv_increment(campaign_ref("c2.counter", "remaining"), -16), dv_increment(campaign_ref("c2.ledger", "removed"), 16), dv_increment(campaign_ref("c2.ledger", "day_recorded"), 16), dv_assign(c2daily_ref("portions"), 16), dv_assign(c2daily_ref("meal_cooked"), true)])

axiom c2daily_deliver_law():
    let pre = dv_all([campaign_at("shen", "living_hall"), campaign_window(2, 690, 810), dv_fact(c2daily_ref("meal_cooked"), true), dv_fact(c2daily_ref("meal_prepared"), false)])
    return dv_axiom("c2daily_deliver_law", 1, pre, [dv_assign(c2daily_ref("meal_prepared"), true)])

axiom c2daily_serve_law(actor):
    let pre = dv_all([campaign_at(actor, "living_hall"), campaign_window(2, 720, 810), dv_fact(c2daily_ref("meal_prepared"), true), dv_at_least(c2daily_ref("portions"), 1), dv_fact(campaign_own(actor, "collected.2.noon"), false), c2_alive(actor)])
    return dv_axiom("c2daily_serve_law", 1, pre, [dv_increment(c2daily_ref("portions"), -1), dv_increment(campaign_own(actor, "rations"), 1), dv_assign(campaign_own(actor, "collected.2.noon"), true)])

axiom c2daily_draft_law():
    let pre = dv_all([campaign_at("ruan", "central_hall"), c2daily_notes_window(), dv_fact(c2daily_ref("draft_notes"), false)])
    return dv_axiom("c2daily_draft_law", 1, pre, [dv_assign(c2daily_ref("draft_notes"), true)])

axiom c2daily_council_end_law():
    var pre = [dv_fact(c2daily_ref("council_ended"), false)]
    let people = campaign_people()
    var i = 0
    while i < rt_count(people):
        rt_push(pre, dv_fact(c2daily_ref(rt_cat("signed.", people[i])), true))
        i = i + 1
    return dv_axiom("c2daily_council_end_law", 1, dv_all(pre), [dv_assign(c2daily_ref("council_ended"), true), dv_assign(c2daily_ref("council_closed"), true)])

// user:2026-10-18章末授权：截止只收束议事，不代替真实签名。
法则 c2daily_council_close_law：
    当 campaign_clock() 至少 6330。
    并且 c2daily_ref("council_closed") 等于 false。
    则 c2daily_ref("council_closed") 变为 true。

// The low hum and aftershock persist through closing; this is a present signal,
// not a historical pulse. The environment never writes a mind.
法则 c2daily_tremor_law：
    当 c2daily_ref("council_closed") 等于 true。
    并且 c2daily_ref("underground_tremor") 等于 false。
    则 c2daily_ref("underground_tremor") 变为 true。

fn c2daily_closing_fields():
    var fields = ["council_closed", "council_ended", "underground_tremor", "votes.open_plan", "votes.seal_plan", "votes.committee_plan"]
    let people = campaign_people()
    var i = 0
    while i < rt_count(people):
        rt_push(fields, rt_cat("signed.", people[i]))
        rt_push(fields, rt_cat("voted.", people[i]))
        rt_push(fields, rt_cat("ballot.", people[i]))
        i = i + 1
    return fields

// Read-only inheritance evidence; unknown fields remain unknown.
fn c2daily_chapter_summary(physical):
    var people = []
    let ids = campaign_people()
    var i = 0
    while i < rt_count(ids):
        let id = ids[i]
        rt_push(people, {"id": id, "alive": dv_read(physical, campaign_own(id, "alive")), "signed": dv_read(physical, c2daily_ref(rt_cat("signed.", id))), "voted": dv_read(physical, c2daily_ref(rt_cat("voted.", id))), "ballot": dv_read(physical, c2daily_ref(rt_cat("ballot.", id))), "rations": dv_read(physical, campaign_own(id, "rations")), "hungry": dv_read(physical, campaign_own(id, "hungry")), "erosion_exposure": dv_read(physical, campaign_own(id, "erosion_exposure")), "pending_notes": dv_read(physical, campaign_own(id, "pending_notes"))})
        i = i + 1
    return {"scope": "read-only-actual-state-not-character-knowledge", "council_closed": dv_read(physical, c2daily_ref("council_closed")), "council_ended": dv_read(physical, c2daily_ref("council_ended")), "underground_tremor": dv_read(physical, c2daily_ref("underground_tremor")), "people": people, "counter_remaining": dv_read(physical, campaign_ref("c2.counter", "remaining")), "counter_open": dv_read(physical, campaign_ref("c2.counter", "open")), "ledger_pending": dv_read(physical, campaign_ref("c2.ledger", "pending_registered")), "ledger_counted": dv_read(physical, campaign_ref("c2.ledger", "counted")), "ledger_removed": dv_read(physical, campaign_ref("c2.ledger", "removed")), "ledger_day_recorded": dv_read(physical, campaign_ref("c2.ledger", "day_recorded")), "ledger_night_recorded": dv_read(physical, campaign_ref("c2.ledger", "night_recorded")), "reserve_added": dv_read(physical, campaign_ref("c2.granary", "reserve_added")), "contract_joined": dv_read(physical, campaign_ref("case.contract", "joined_inventory")), "astral_draft": dv_read(physical, campaign_ref("case.astral", "complete_draft")), "medicine_key_given": dv_read(physical, campaign_ref("case.logistics", "medicine_key_given"))}

axiom c2daily_watch_law(watched):
    let guards = ["detective", "bertrand", "huo"]
    var present = []
    var i = 0
    while i < rt_count(guards):
        rt_push(present, dv_all([dv_fact(campaign_own(guards[i], "guard_active"), true), campaign_at(guards[i], "living_hall"), c2_alive(guards[i]), campaign_at("moran", "living_hall")]))
        i = i + 1
    var premise = campaign_any(present[0], campaign_any(present[1], present[2]))
    if not watched:
        premise = dv_not(premise)
    return dv_axiom("c2daily_watch_law", 1, premise, [dv_assign(campaign_own("moran", "watched"), watched)])

fn c2daily_tasks():
    return [
        {"actor": "huo", "id": "huo.c2.repair-faucet", "label": "修理水龙头", "room": "washroom", "field": "faucet_repaired", "when": campaign_window(2, 480, 570), "text": "霍铎关水拆下接头，重新拧紧盥洗室的水龙头。"},
        {"actor": "mora", "id": "mora.c2.examine-ankle", "label": "检查脚踝与负重情况", "room": "living_hall", "field": "ankle_examined", "when": dv_all([campaign_window(2, 570, 600), campaign_at("elena", "living_hall"), c2_alive("elena")]), "text": "茉拉当面检查伊莲娜的脚踝、绷带和负重反应。"},
        {"actor": "su", "id": "su.c2.try-stethoscope", "label": "试用听诊器", "room": "living_hall", "field": "stethoscope_tried", "when": dv_all([campaign_window(2, 570, 600), campaign_at("mora", "living_hall")]), "text": "苏泠擦净耳件，在茉拉指导下试用听诊器。", "received_speech_requirement": {"speaker": "mora", "action_id": "mora.c2.stethoscope-consent"}}]

axiom c2daily_task_law(task):
    let pre = dv_all([campaign_at(task.actor, task.room), task.when, dv_fact(c2daily_ref(task.field), false)])
    return dv_axiom("c2daily_task_law", 1, pre, [dv_assign(c2daily_ref(task.field), true)])

fn c2daily_install_scene(scene):
    if dv_find(scene, "chapter2_daily_installed", false):
        return scene
    let source = campaign_approved("real-sixteen-portion-lunch-deduct-stock-once")
    var fields = {"meal_cooked": dv_field(false), "meal_prepared": dv_field(false), "portions": dv_field(0), "draft_notes": dv_field(false), "rare_color_layer": dv_field("夹道罕见紫金以太色层"), "council_ended": dv_field(false), "underground_tremor": dv_field(false), "votes.open_plan": dv_field(0), "votes.seal_plan": dv_field(0), "votes.committee_plan": dv_field(0)}
    let tasks = c2daily_tasks()
    var t = 0
    while t < rt_count(tasks):
        fields = dv_with(fields, tasks[t].field, dv_field(false))
        t = t + 1
    let people = campaign_people()
    var f = 0
    while f < rt_count(people):
        fields = dv_with(fields, rt_cat("signed.", people[f]), dv_field(false))
        fields = dv_with(fields, rt_cat("voted.", people[f]), dv_field(false))
        fields = dv_with(fields, rt_cat("ballot.", people[f]), dv_unknown())
        fields = dv_with(fields, rt_cat("guarding.", people[f]), dv_field(false))
        f = f + 1
    fields = dv_with(fields, "council_closed", dv_field(false))
    var physical = campaign_add_new(scene.physical, c2_object("c2.daily", "living_hall", fields))
    physical = dv_adopt(physical, campaign_method("c2.daily.council-end", c2daily_council_end_law()), "enforce", 1, source)
    var processes = dv_clone(dv_find(scene, "world_processes", []))
    rt_push(processes, {"id": "c2.daily.council-end", "law": "c2.daily.council-end", "basis": [source]})
    let closing_source = campaign_approved("user:2026-10-18章末授权")
    physical = dv_adopt(physical, campaign_method("c2.daily.council-close", c2daily_council_close_law()), "enforce", 1, [closing_source])
    physical = dv_adopt(physical, campaign_method("c2.daily.tremor", c2daily_tremor_law()), "enforce", 1, [closing_source])
    rt_push(processes, {"id": "c2.daily.council-close", "law": "c2.daily.council-close", "once": true, "basis": [closing_source]})
    rt_push(processes, {"id": "c2.daily.tremor", "law": "c2.daily.tremor", "once": true, "basis": [closing_source]})
    let watch_states = [true, false]
    var w = 0
    while w < rt_count(watch_states):
        let id = rt_cat("c2.daily.watch.", rt_show(watch_states[w]))
        physical = dv_adopt(physical, campaign_method(id, c2daily_watch_law(watch_states[w])), "enforce", 1, source)
        rt_push(processes, {"id": id, "law": id, "basis": [source]})
        w = w + 1
    var bindings = dv_clone(scene.bindings)
    var actors = []
    var i = 0
    while i < rt_count(scene.actors):
        var actor = scene.actors[i]
        var mind = campaign_add_new(actor.mind, campaign_local_object("c2.daily"))
        rt_push(bindings, dv_binding("c2.daily", "c2.daily", actor.id))
        // These are the owner's new, unperformed protocol actions, not a copy
        // of another person's vote or a prediction of a future agreement.
        let personal_record = dv_with(dv_field(false), "basis", [campaign_approved("own-unperformed-council-record")])
        mind = dv_store(mind, c2daily_ref(rt_cat("signed.", actor.id)), personal_record)
        mind = dv_store(mind, c2daily_ref(rt_cat("voted.", actor.id)), personal_record)
        if actor.id == "demon":
            mind = dv_store(mind, c2daily_ref("rare_color_layer"), dv_field("夹道罕见紫金以太色层"))
        var actions = dv_clone(actor.actions)
        t = 0
        while t < rt_count(tasks):
            let task = tasks[t]
            if actor.id == task.actor:
                let law = c2daily_task_law(task)
                physical = dv_adopt(physical, campaign_method(task.id, law), "enforce", 1, source)
                mind = dv_adopt(mind, campaign_method(task.id, law), "predict", 1, source)
                mind = dv_store(mind, c2daily_ref(task.field), dv_field(false))
                var action = dv_with(campaign_surface_action(task.id, "help", law.premise, law.premise, task.id, [c2daily_ref(task.field)], task.label, task.text, source), "predict_law", task.id)
                if dv_has_key(task, "received_speech_requirement"):
                    action = dv_with(action, "received_speech_requirement", task.received_speech_requirement)
                rt_push(actions, action)
            t = t + 1
        if actor.id == "ruan":
            let id = "ruan.c2.draft-notes"
            let law = c2daily_draft_law()
            physical = dv_adopt(physical, campaign_method(id, law), "enforce", 1, source)
            mind = dv_adopt(mind, campaign_method(id, law), "predict", 1, source)
            mind = dv_store(mind, c2daily_ref("draft_notes"), dv_field(false))
            rt_push(actions, dv_with(campaign_surface_action(id, "help", law.premise, law.premise, id, [c2daily_ref("draft_notes")], "起草夜间取粮补记栏", "阮清月留出补记栏，写下夜间取用者、份数、用途和次日核对的草案。", source), "predict_law", id))
        if actor.id == "shen":
            let id = "shen.c2.daily.cook-sixteen"
            let law = c2daily_cook_law()
            physical = dv_adopt(physical, campaign_method(id, law), "enforce", 1, source)
            mind = dv_adopt(mind, campaign_method(id, law), "predict", 1, source)
            mind = dv_store(mind, c2daily_ref("meal_prepared"), dv_field(false))
            mind = dv_store(mind, c2daily_ref("meal_cooked"), dv_field(false))
            rt_push(actions, dv_with(campaign_surface_action(id, "help", law.premise, law.premise, id, [c2daily_ref("meal_cooked"), c2daily_ref("portions"), campaign_ref("c2.counter", "remaining")], "准备十六人份午餐", "沈鼎把十六份口粮做成烩菜、热汤和面饼。", source), "predict_law", id))
            let delivery = "shen.c2.daily.deliver-sixteen"
            let delivery_law = c2daily_deliver_law()
            physical = dv_adopt(physical, campaign_method(delivery, delivery_law), "enforce", 1, source)
            mind = dv_adopt(mind, campaign_method(delivery, delivery_law), "predict", 1, source)
            rt_push(actions, dv_with_many(campaign_surface_action(delivery, "help", delivery_law.premise, delivery_law.premise, delivery, [c2daily_ref("meal_prepared")], "摆好饭桌并送餐", "沈鼎把热饭摆上起居厅的四张桌子。", source), {"predict_law": delivery, "public_observers": campaign_people(), "public_grants": [c2daily_ref("meal_prepared"), c2daily_ref("portions")]}))
        if dv_has(campaign_people(), actor.id):
            let id = rt_cat(actor.id, ".c2.daily.serve")
            let law = c2daily_serve_law(actor.id)
            physical = dv_adopt(physical, campaign_method(id, law), "enforce", 1, source)
            mind = dv_adopt(mind, campaign_method(id, law), "predict", 1, source)
            rt_push(actions, dv_with(campaign_surface_action(id, "help", law.premise, law.premise, id, [c2daily_ref("portions"), campaign_own(actor.id, "rations"), campaign_own(actor.id, "collected.2.noon")], "领取本人午餐", "从热饭中领自己的一份。", source), "predict_law", id))
        rt_push(actions, c2_inspect_action(actor.id, "c2.daily", "living_hall", ["meal_prepared", "portions", "draft_notes"], "查看饭桌与补记草案", "查看饭桌与补记草案。", source))
        rt_push(actions, dv_with(c2_inspect_action(actor.id, "c2.daily", "central_hall", ["draft_notes"], "查看补记草案", "查看补记草案。", source), "id", rt_cat(actor.id, ".c2.daily.inspect-central")))
        let venues = ["oath_court", "central_hall"]
        var venue_index = 0
        while venue_index < rt_count(venues):
            let room = venues[venue_index]
            let council_when = dv_all([campaign_at(actor.id, room), c2d_council_when()])
            let council_fields = [rt_cat("signed.", actor.id), rt_cat("voted.", actor.id), rt_cat("ballot.", actor.id), "votes.open_plan", "votes.seal_plan", "votes.committee_plan"]
            var council = c2_inspect_action(actor.id, "c2.daily", room, council_fields, "核对本人投票与签名", "在会场核对本人的投票、签名记录与当前票数。", source)
            council = dv_with_many(council, {"id": rt_cat(actor.id, rt_cat(".c2.daily.council-record.", room)), "precondition": council_when, "authority_precondition": council_when})
            rt_push(actions, council)
            let when = dv_all([campaign_at(actor.id, room), campaign_any(dv_fact(c2daily_ref("council_closed"), true), dv_at_least(campaign_clock(), 6330))])
            var closing = c2_inspect_action(actor.id, "c2.daily", room, c2daily_closing_fields(), "核对会场记录与周围动静", "在会场核对投票、签名与议事收束记录，留意脚下的动静。", closing_source)
            closing = dv_with_many(closing, {"id": rt_cat(actor.id, rt_cat(".c2.daily.closing.", room)), "precondition": when, "authority_precondition": when})
            rt_push(actions, closing)
            venue_index = venue_index + 1
        actor = dv_with_many(actor, {"mind": mind, "actions": campaign_public_methods(actions)})
        rt_push(actors, actor)
        i = i + 1
    return dv_with_many(scene, {"physical": physical, "bindings": bindings, "actors": actors, "chapter2_daily_installed": true, "world_processes": processes})


// Native optional chapter-two conversations. Only local successful speech is heard.
// Dates open opportunities; they do not place people, settle a dispute or invent illness.

fn c2d_ref(field):
    return campaign_ref("c2.dialogue", field)

fn c2d_person_ref(actor, field):
    return campaign_ref(rt_cat("c2.dialogue.person.", actor), field)

fn c2d_mark(actor, method):
    return c2d_person_ref(actor, rt_cat("said.", method))

fn c2d_source(file, line, id):
    return c2_source(file, line, id)

fn c2d_people():
    return dv_append(campaign_people(), "demon")

fn c2d_row(actor, id, room, when, literal, label, text, source):
    return {"actor": actor, "id": id, "room": room, "when": when, "literal": literal, "label": label, "text": text, "source": source}

fn c2d_question(id, room, when, target, topic, label, text, refs, source):
    return dv_with_many(c2d_row("detective", id, room, when, dv_true(), label, text, source), {"request": {"target": target, "topic": topic}, "purpose_refs": refs, "category": "case"})

fn c2d_reply(actor, id, room, when, literal, topic, label, text, source):
    return dv_with(c2d_row(actor, id, room, when, literal, label, text, source), "response_topic", topic)

fn c2d_introductions():
    let key = ["authored-declaration", "c2d_introductions"]
    let cached = rt_memo_get([], key)
    if cached[0]:
        return cached[1]
    return rt_memo_put([], key, c2d_introductions_build())

fn c2d_introductions_build():
    return [
        {"actor": "ward", "text": "弗雷德里克·沃德，执业律师，甲区。", "source": c2d_source("06_场面.story", 25, "chapter2.meet_jia.002")},
        {"actor": "gu", "text": "老朽顾平章，读碑的。", "source": c2d_source("06_场面.story", 31, "chapter2.meet_jia.008")},
        {"actor": "selma", "text": "赛尔玛，采标本的。你们是乙区的？", "source": c2d_source("06_场面.story", 57, "chapter2.meet_bing.002")},
        {"actor": "ruan", "text": "阮清月。下棋。", "source": c2d_source("06_场面.story", 58, "chapter2.meet_bing.003")},
        {"actor": "moran", "text": "……莫兰。", "source": c2d_source("06_场面.story", 60, "chapter2.meet_bing.005")},
        {"actor": "mora", "text": "茉拉，医生。", "source": c2d_source("06_场面.story", 136, "chapter2.meet_ding.003")},
        {"actor": "bertrand", "text": "贝尔特朗，丁区。", "source": c2d_source("06_场面.story", 137, "chapter2.meet_ding.004")},
        {"actor": "margaret", "text": "玛格丽特，盖房子的。", "source": c2d_source("06_场面.story", 138, "chapter2.meet_ding.005")},
        {"actor": "veronica", "text": "维罗妮卡，化学。", "source": c2d_source("06_场面.story", 139, "chapter2.meet_ding.006")}]

fn c2d_curriculum():
    return [
        {"id": "lesson11", "title": "守则读法", "text": "入夜之后，诸位留于室内。已开放的封闭连廊也须核对密封、通风和现场读数。源质计在户外仪器阵入口，先在安全侧学会读数，再定路线。低洼、夜间与无风时易积灰，风止或地震后停行复测。读数不明时，留在已确认安全处，呼叫协助。", "source": campaign_source("docs/design-standard.md", 0, "最低限度安全教学")},
        {"id": "lesson12", "title": "传声与机械", "text": "传声管两端都能传声。先核对通路与盖片，发话、复述分开进行；同时说话会互相遮盖。管口附近的话也可能传到另一端。", "source": c2d_source("07_家具与文本.story", 86, "第十二课.内容")},
        {"id": "lesson13", "title": "言灵初阶", "text": "十个词、基本语法：名词居首、条件居中、动词收尾。练习：两盏灯只灭一盏。", "source": c2d_source("07_家具与文本.story", 88, "第十三课.内容")},
        {"id": "lesson14", "title": "异象与记忆", "text": "辨别自己看见的、别人告诉你的，和自己盼着是真的。熟悉感只是一条线索，地点、时长与缘由仍需各自查证。", "source": campaign_source("docs/design-standard.md", 0, "前两章的信息边界")}]

fn c2d_rows():
    let key = ["authored-declaration", "c2d_rows"]
    let cached = rt_memo_get([], key)
    if cached[0]:
        return cached[1]
    return rt_memo_put([], key, c2d_rows_build())

fn c2d_rows_build():
    var rows = []
    let contract_ref = c2d_ref("contract_full_text")
    let contract_source = campaign_source("docs/design-standard.md", 0, "主动询问契约全文")
    let trace = dv_all([dv_fact(campaign_evidence_ref("shelf_old"), true), dv_fact(campaign_evidence_ref("hand_not_mine"), true), dv_fact(dv_ref("demon.body", "state", "hand_shape"), "long-narrow-hand"), dv_fact(dv_ref("demon.body", "state", "shelf_print_owner"), "demon")])
    let rule4 = dv_fact(c2d_ref("school_rule4"), "我所立之规，皆张贴于此。")
    var authority = c2d_question("detective.c2.ask-seal-authority", "living_hall", trace, "demon", "contract.seal-authority", "询问封存授权", "架沿的窄手印与你的手形相合。你说封存之物是你取走的；谁授权你封存？", [], contract_source)
    authority = dv_with_many(authority, {"category": "contract", "received_speech_requirement": {"speaker": "demon", "action_id": "demon.departure.answer-print"}})
    rt_push(rows, authority)
    let sealed = dv_fact(c2d_ref("seal_authority"), "契约")
    rt_push(rows, c2d_reply("demon", "demon.c2.seal-authority", "living_hall", dv_true(), sealed, "contract.seal-authority", "答复封存授权", "封存的权限来自契约。", contract_source))
    var other_rules = c2d_question("detective.c2.ask-other-rules", "lecture", dv_all([rule4, sealed]), "demon", "contract.other-rules", "询问其他规则", "第四条说“我所立之规，皆张贴于此”。是否意味着尚有非你所立之规？", [], contract_source)
    other_rules = dv_with_many(other_rules, {"category": "contract", "received_speech_requirement": {"speaker": "demon", "action_id": "demon.c2.school-rule4"}})
    rt_push(rows, other_rules)
    rt_push(rows, c2d_reply("demon", "demon.c2.other-rules", "lecture", dv_true(), dv_fact(c2d_ref("authority_bounded"), true), "contract.other-rules", "答复其他规则", "是。还有我也须遵守的契约。", contract_source))
    var origin = c2d_question("detective.c2.ask-rule-authority", "lecture", rule4, "demon", "contract.rule-authority", "询问契约与权限来源", "你既须遵守契约，又由契约取得封存权限，那么契约是谁立的？权限究竟从哪里来？", [], contract_source)
    origin = dv_with_many(origin, {"category": "contract", "received_speech_requirement": {"speaker": "demon", "action_id": "demon.c2.other-rules"}})
    rt_push(rows, origin)
    let bounded = dv_fact(c2d_ref("authority_bounded"), true)
    rt_push(rows, c2d_reply("demon", "demon.c2.rule-authority", "lecture", dv_true(), bounded, "contract.rule-authority", "答复权限来源", "我也受契约约束。", contract_source))
    var full = c2d_question("detective.c2.ask-contract", "lecture", dv_all([trace, rule4, sealed, bounded]), "demon", "contract.full-text", "索取契约全文", "那么请把约束你、也规定你权限来源的契约全文告诉我们。", [contract_ref], contract_source)
    full = dv_with_many(full, {"category": "contract", "received_speech_requirement": {"speaker": "demon", "action_id": "demon.c2.rule-authority"}})
    rt_push(rows, full)
    rt_push(rows, c2d_reply("demon", "demon.c2.contract-full-text", "lecture", dv_true(), dv_fact(contract_ref, campaign_contract_text()), "contract.full-text", "宣读契约全文", campaign_contract_text(), contract_source))
    let people = campaign_people()
    var p = 0
    while p < rt_count(people):
        let known_contract = dv_fact(contract_ref, campaign_contract_text())
        rt_push(rows, c2d_row(people[p], rt_cat(people[p], ".c2.share-contract"), "living_hall", known_contract, known_contract, "转述契约全文", campaign_contract_text(), contract_source))
        p = p + 1
    let daily = c2daily_rows()
    var d = 0
    while d < rt_count(daily):
        rt_push(rows, daily[d])
        d = d + 1
    let cooperation = c2_cooperation_rows()
    d = 0
    while d < rt_count(cooperation):
        rt_push(rows, cooperation[d])
        d = d + 1
    let intros = c2d_introductions()
    var i = 0
    while i < rt_count(intros):
        let intro = intros[i]
        let literal = dv_all([dv_fact(c2d_person_ref(intro.actor, "introduction"), intro.text), dv_fact(c2d_person_ref(intro.actor, "name"), campaign_person_name(intro.actor))])
        let row = c2d_row(intro.actor, rt_cat(intro.actor, ".c2.dialogue.introduce"), "living_hall", literal, literal, "向在场者自我介绍", intro.text, intro.source)
        rt_push(rows, dv_with(row, "opportunity", {"location": "living_hall", "participants": ["detective"], "mode": "all-present"}))
        i = i + 1
    let courses = c2d_curriculum()
    i = 0
    while i < rt_count(courses):
        let course = courses[i]
        let literal = dv_fact(c2d_ref(course.id), course.text)
        var row = c2d_row("demon", rt_cat("demon.c2.teach.", course.id), "lecture", dv_all([dv_fact(campaign_access("north"), true), literal]), literal, rt_cat("讲授：", course.title), course.text, course.source)
        row = dv_with(row, "opportunity", {"location": "lecture", "participants": campaign_people(), "mode": "at-least-one-present"})
        rt_push(rows, row)
        i = i + 1
    let before = dv_fact(c2d_mark("demon", "demon.c2.teach.lesson11"), true)
    rt_push(rows, c2d_row("demon", "demon.c2.lesson11.close", "lecture", before, dv_true(), "宣布本课结束", "本课到此。诸位所立之规，也请这样读。下课。", c2d_source("06_场面.story", 90, "chapter2.lesson.005")))
    let rooms = ["central_hall", "logistics", "clinic"]
    i = 0
    while i < rt_count(rooms):
        let room = rooms[i]
        let after_night = dv_true()
        rt_push(rows, c2d_question(rt_cat("detective.c2.ask.mora.", room), room, after_night, "mora", "night_patient_food", "询问夜间取粮与病人用粮", "台账有待核对的差额。你夜里取过口粮吗？用途是什么？", [campaign_own("mora", "night_taken")], c2d_source("00_时间与文案.story", 87, "质询问题：取用")))
        rt_push(rows, c2d_question(rt_cat("detective.c2.ask.quer.", room), room, after_night, "quer", "night_self_food", "询问夜间取粮", "夜里取过口粮吗？", [campaign_own("quer", "night_taken")], c2d_source("04_案件.story", 76, "夜取自粮的质询")))
        rt_push(rows, c2d_question(rt_cat("detective.c2.ask.latch.", room), room, after_night, "quer", "latch_repair", "询问粮仓门闩维修", "粮仓的门闩修过吗？", [c2d_person_ref("quer", "repaired_latch")], c2d_source("00_时间与文案.story", 89, "质询问题：门闩")))
        rt_push(rows, c2d_question(rt_cat("detective.c2.ask.ledger.", room), room, after_night, "ruan", "night_ledger", "询问台账登记", "这些取用已经记了哪些，还有哪些待核对？", [campaign_ref("c2.ledger", "night_recorded")], c2d_source("00_时间与文案.story", 90, "质询问题：台账")))
        rt_push(rows, c2d_question(rt_cat("detective.c2.ask.shadow.", room), room, after_night, "bertrand", "night_shadow", "询问夜巡所见", "你夜巡时，看见了什么？", [c2d_person_ref("bertrand", "small_shadow_seen")], c2d_source("04_案件.story", 19, "夜巡所见")))
        let mora_fact = dv_all([dv_fact(campaign_own("mora", "night_taken"), true), dv_fact(c2d_person_ref("mora", "patient_food_reason"), true)])
        rt_push(rows, c2d_reply("mora", rt_cat("mora.c2.reply.patient_food.", room), room, mora_fact, mora_fact, "night_patient_food", "说明为病人取粮的经过", "我为病人夜里取过口粮。取用和补记可以一起核对。", c2d_source("04_案件.story", 73, "夜取病粮：反应（次日措辞适配）")))
        let quer_fact = dv_all([dv_fact(campaign_own("quer", "night_taken"), true), dv_fact(campaign_own("quer", "accepted.mora_night"), true)])
        rt_push(rows, c2d_reply("quer", rt_cat("quer.c2.reply.self_food.", room), room, quer_fact, quer_fact, "night_self_food", "说明本人取粮的经过", "我夜里取过口粮，也认了急需可以自取、随后补记这条。记录可以一起核对。", c2d_source("04_案件.story", 80, "夜取自粮：反应·雀儿（次日措辞适配）")))
        let repaired = dv_fact(c2d_person_ref("quer", "repaired_latch"), true)
        rt_push(rows, c2d_reply("quer", rt_cat("quer.c2.reply.repair.", room), room, repaired, repaired, "latch_repair", "说明修闩经过", "门闩松了，是我修的。", c2d_source("04_案件.story", 85, "修门闩：反应")))
        let ledger = dv_all([dv_fact(campaign_ref("c2.ledger", "night_recorded"), 0), dv_at_least(campaign_ref("c2.ledger", "day_recorded"), 1)])
        rt_push(rows, c2d_reply("ruan", rt_cat("ruan.c2.reply.ledger.", room), room, ledger, ledger, "night_ledger", "说明本人所见的台账", "我看到的台账上已有白天领取记录，夜间补记这一栏还是空的。", c2d_source("04_案件.story", 91, "台账：反应")))
        let small = dv_fact(c2d_person_ref("bertrand", "small_shadow_seen"), true)
        rt_push(rows, c2d_reply("bertrand", rt_cat("bertrand.c2.reply.shadow.", room), room, small, small, "night_shadow", "说明夜巡所见", "身影是看见了。是谁，我没看清。", c2d_source("04_案件.story", 102, "夜巡望见的身影：反应")))
        i = i + 1
    let requested_repair = dv_fact(c2d_person_ref("margaret", "requested_latch_repair"), true)
    let marks = dv_fact(campaign_ref("c2.granary", "tool_marks"), true)
    let repair_witness = c2d_row("margaret", "margaret.c2.testimony.repair", "central_hall", dv_all([requested_repair, marks]), dv_all([requested_repair, marks]), "说明自己提出的修闩请求", "我请雀儿修过门闩。现在能看见工具痕，谁实际动过手还得另问。", c2d_source("04_案件.story", 86, "修门闩：反应·雀儿"))
    rt_push(rows, dv_with(repair_witness, "opportunity", {"location": "central_hall", "participants": ["detective", "quer"], "mode": "all-present"}))
    let council = c2d_council_when()
    let places = ["oath_court", "central_hall"]
    i = 0
    while i < rt_count(places):
        let room = places[i]
        var weather = dv_fact(campaign_ref("c2.weather", "wind"), true)
        if room == "central_hall":
            weather = dv_fact(campaign_ref("c2.weather", "wind"), false)
        let when = dv_all([council, weather])
        let source = campaign_source("docs/design-standard.md", 0, "第五日物资与安全公约")
        let proposals = c2_norms()
        var n = 0
        while n < rt_count(proposals):
            let norm = proposals[n]
            if dv_has(["open_plan", "seal_plan", "committee_plan"], norm.id):
                let literal = dv_fact(campaign_ref(c2_norm_object(norm.id), "text"), norm.surface)
                let row = c2d_row(norm.owner, rt_cat(norm.owner, rt_cat(".c2.council.proposal.", rt_cat(room, norm.id))), room, dv_all([when, c2d_stance(norm.owner, norm.id)]), literal, rt_cat("提出议案：", norm.title), norm.surface, source)
                rt_push(rows, dv_with(row, "norm_proposal", norm))
            n = n + 1
        i = i + 1
    let rescue_source = campaign_source("docs/design-standard.md", 0, "实际夹道救援后的本人报告与现场照护")
    let rescue_history = dv_fact(campaign_own("bertrand", "rescue_exposed"), true)
    var rescue_report = c2d_row("bertrand", "bertrand.c2.rescue.report", "living_hall", c2_can_act("bertrand"), rescue_history, "报告救援经历并请求检查", "我刚进入过夹道救人。请医生检查我的情况。", rescue_source)
    rescue_report = dv_with_many(rescue_report, {"opportunity": {"location": "living_hall", "participants": ["mora"], "mode": "all-present"}, "listeners": ["mora"], "completed_action_requirement": {"action_id": "bertrand.c2.rescue.moran_from_alley"}})
    rt_push(rows, rescue_report)
    let comforts = c2d_companion_comfort_rows()
    var c = 0
    while c < rt_count(comforts):
        rt_push(rows, comforts[c])
        c = c + 1
    let rebukes = c2d_demon_rebuke_rows()
    c = 0
    while c < rt_count(rebukes):
        rt_push(rows, rebukes[c])
        c = c + 1
    let shura_rows = c2d_shura_rows()
    c = 0
    while c < rt_count(shura_rows):
        rt_push(rows, shura_rows[c])
        c = c + 1
    return rows

fn c2d_companion_comfort_rows():
    var rows = []
    let source = campaign_source("docs/design-standard.md", 0, "愚蠢侦探路线：群像温厚包容")
    let after_night = dv_at_least(campaign_clock(), 1440)
    let shen_text = "想不明白就先歇一歇。愿意的话，来后厨和我搭把手；饭食的事也可以一起商量。"
    var shen_row = c2d_row("shen", "shen.c2.dialogue.comfort_soup", "living_hall", after_night, dv_true(), "以热汤安慰同伴", shen_text, source)
    shen_row = dv_with_many(shen_row, {"opportunity": {"location": "living_hall", "participants": ["detective"], "mode": "all-present"}, "effects": [dv_assign(c2d_person_ref("shen", "comfort_soup"), true)], "personal_choice": {"group": "companion-comfort", "requires": after_night, "prohibits": dv_fact(c2d_person_ref("shen", "comfort_soup"), true), "promotes": ["solidarity", "safety"], "sacrifices": [], "basis": [source]}})
    rt_push(rows, shen_row)
    let quer_text = "大侦探，想不明白也别一个人硬撑。愿意就跟我搭个伴，进夹道前先把路看清楚。"
    var quer_row = c2d_row("quer", "quer.c2.dialogue.comfort_boxes", "living_hall", after_night, dv_true(), "提出搬箱换取口粮", quer_text, source)
    quer_row = dv_with_many(quer_row, {"opportunity": {"location": "living_hall", "participants": ["detective"], "mode": "all-present"}, "effects": [dv_assign(c2d_person_ref("quer", "comfort_boxes"), true)], "personal_choice": {"group": "companion-comfort", "requires": after_night, "prohibits": dv_fact(c2d_person_ref("quer", "comfort_boxes"), true), "promotes": ["solidarity", "movement_freedom"], "sacrifices": [], "basis": [source]}})
    rt_push(rows, quer_row)
    let huo_text = "齿轮卡死时硬撬会崩齿。想不明白先放着；愿意帮忙的话，我们先一起看看手头能做什么。"
    var huo_row = c2d_row("huo", "huo.c2.dialogue.comfort_jack", "logistics", after_night, dv_true(), "提出用千斤顶帮忙", huo_text, source)
    huo_row = dv_with_many(huo_row, {"opportunity": {"location": "logistics", "participants": ["detective"], "mode": "all-present"}, "effects": [dv_assign(c2d_person_ref("huo", "comfort_jack"), true)], "personal_choice": {"group": "companion-comfort", "requires": after_night, "prohibits": dv_fact(c2d_person_ref("huo", "comfort_jack"), true), "promotes": ["solidarity", "measured_work"], "sacrifices": [], "basis": [source]}})
    rt_push(rows, huo_row)
    let ward_text = "证据还可以继续核对。对一份陈述有疑问，也不该因此否定陈述者的安全保障与口粮配给权。"
    var ward_row = c2d_row("ward", "ward.c2.dialogue.comfort_rights", "living_hall", after_night, dv_true(), "承诺维护同伴的陈述权", ward_text, source)
    ward_row = dv_with_many(ward_row, {"opportunity": {"location": "living_hall", "participants": ["detective"], "mode": "all-present"}, "effects": [dv_assign(c2d_person_ref("ward", "comfort_rights"), true)], "personal_choice": {"group": "companion-comfort", "requires": after_night, "prohibits": dv_fact(c2d_person_ref("ward", "comfort_rights"), true), "promotes": ["solidarity", "ward_authority"], "sacrifices": [], "basis": [source]}})
    rt_push(rows, ward_row)
    let mora_text = "需要歇一歇就坐下。想不明白不是罪过；你若有不舒服，可以告诉我。"
    var mora_row = c2d_row("mora", "mora.c2.dialogue.comfort_care", "clinic", after_night, dv_true(), "提出继续照护伤者", mora_text, source)
    mora_row = dv_with_many(mora_row, {"opportunity": {"location": "clinic", "participants": ["detective"], "mode": "all-present"}, "effects": [dv_assign(c2d_person_ref("mora", "comfort_care"), true)], "personal_choice": {"group": "companion-comfort", "requires": after_night, "prohibits": dv_fact(c2d_person_ref("mora", "comfort_care"), true), "promotes": ["patient_priority", "solidarity"], "sacrifices": [], "basis": [source]}})
    rt_push(rows, mora_row)
    return rows

fn c2d_demon_rebuke_rows():
    var rows = []
    let source = campaign_source("docs/design-standard.md", 0, "非常规手段：驱使恶魔后的同伴严厉谴责")
    let after_demon = dv_fact(campaign_ref("c2.demon", "intervened"), true)
    let mora_text = "我反对把同伴的生命当作与恶魔谈判的筹码。它是否介入、介入后发生了什么，都要逐项核对，不能把托付生命当作理所当然。"
    var mora_row = c2d_row("mora", "mora.c2.dialogue.demon_rebuke", "clinic", after_demon, dv_true(), "追问安全信息的遗漏", mora_text, source)
    mora_row = dv_with_many(mora_row, {"opportunity": {"location": "clinic", "participants": ["detective"], "mode": "all-present"}, "effects": [dv_assign(c2d_person_ref("mora", "demon_rebuked"), true)]})
    rt_push(rows, mora_row)
    let elena_text = "你在走钢丝，侦探。我不信任向深渊代管者求助的选择。作出承诺前，你想清楚自己能担下什么了吗？"
    var elena_row = c2d_row("elena", "elena.c2.dialogue.demon_rebuke", "quiet_room", after_demon, dv_true(), "质疑沉静室事件的说明", elena_text, source)
    elena_row = dv_with_many(elena_row, {"opportunity": {"location": "quiet_room", "participants": ["detective"], "mode": "all-present"}, "effects": [dv_assign(c2d_person_ref("elena", "demon_rebuked"), true)]})
    rt_push(rows, elena_row)
    let ruan_text = "我反对这种引狼入室的劫争。借它的力量之后，条件、代价与能够制衡它的手段，你准备怎样逐项交代？"
    var ruan_row = c2d_row("ruan", "ruan.c2.dialogue.demon_rebuke", "central_hall", after_demon, dv_true(), "追问契约的履行", ruan_text, source)
    ruan_row = dv_with_many(ruan_row, {"opportunity": {"location": "central_hall", "participants": ["detective"], "mode": "all-present"}, "effects": [dv_assign(c2d_person_ref("ruan", "demon_rebuked"), true)]})
    rt_push(rows, ruan_row)
    return rows

fn c2d_demon_trial_dialogues():
    var rows = []
    let source = campaign_source("docs/design-standard.md", 0, "修罗侦探路线：恶魔真话背刺与大公审")
    // A received source/parse pair proves this quotation was heard. It does not
    // establish why the later choices, exposure or casualties occurred.
    let betrayal_pre = campaign_any(dv_fact(campaign_own("moran", "dead"), true), dv_fact(campaign_own("bertrand", "stone_stupor"), true))
    let demon_text = rt_cat("我实际听到侦探对莫兰说：『", rt_cat(c2_color_encouragement_text(), "』。这句话与后来的选择、执行和伤亡，仍须逐项核对。"))
    var demon_row = c2d_row("demon", "demon.c2.truth_betrayal", "central_hall", betrayal_pre, dv_true(), "陈述有关侦探的证言", demon_text, source)
    demon_row = dv_with_many(demon_row, {"received_speech_requirement": {"speaker": "detective", "action_id": "detective.c2.color.encourage"}, "opportunity": {"location": "central_hall", "participants": ["ruan", "ward", "mora"], "mode": "at-least-one-present"}, "effects": [dv_assign(c2d_ref("demon_truth_betrayal"), true)]})
    rt_push(rows, demon_row)
    let ruan_trial_text = "先核对侦探实际说过的话，再核对莫兰自己的选择、实际动线和伤情。不能仅凭言语与伤亡的先后，就把借刀杀人的推断当作定案事实。"
    let trial_pre = dv_true()
    var ruan_row = c2d_row("ruan", "ruan.c2.trial.indict", "central_hall", trial_pre, dv_true(), "提出对侦探的指控", ruan_trial_text, source)
    ruan_row = dv_with_many(ruan_row, {"received_speech_requirement": {"speaker": "demon", "action_id": "demon.c2.truth_betrayal"}, "effects": [dv_assign(c2d_person_ref("ruan", "trial_indicted"), true)]})
    rt_push(rows, ruan_row)
    let moran_evidence = dv_fact(campaign_own("moran", "dead"), true)
    let mora_trial_text = "我在现场确认莫兰已经死亡。死亡原因、言语是否影响了他的选择、又怎样造成死亡，还须另有证据。"
    var mora_trial = c2d_row("mora", "mora.c2.trial.witness", "central_hall", dv_true(), moran_evidence, "陈述照护经过", mora_trial_text, source)
    mora_trial = dv_with_many(mora_trial, {"received_speech_requirement": {"speaker": "ruan", "action_id": "ruan.c2.trial.indict"}, "completed_action_requirement": {"action_id": "mora.c2.examine.moran"}, "effects": [dv_assign(c2d_person_ref("mora", "trial_witnessed"), true)]})
    rt_push(rows, mora_trial)
    let ward_trial_text = "我听到了现场死亡的证言。言论原始记录、本人选择、实际动线与死因仍须分别核对；这些证言尚不足以认定侦探有罪，不能据此直接监禁或剥夺配给。"
    var ward_row = c2d_row("ward", "ward.c2.trial.verdict", "central_hall", dv_true(), moran_evidence, "提出审判意见", ward_trial_text, source)
    ward_row = dv_with(ward_row, "received_speech_requirement", {"speaker": "mora", "action_id": "mora.c2.trial.witness"})
    rt_push(rows, ward_row)
    return rows

fn c2d_demon_incite_guard():
    var rows = []
    let source = campaign_source("docs/design-standard.md", 0, "恶魔铜口挑拨看守擅离职守")
    let imprisoned = dv_fact(campaign_ref("c2.trial", "detective_imprisoned"), true)
    let demon_incite_text = "守门人何必徒劳执锁？是否继续看守，是否解除门锁，请你自己作出选择，也自己承担这个选择的后果。"
    var demon_incite = c2d_row("demon", "demon.c2.intercom.incite_guard", "living_hall", imprisoned, dv_true(), "向看守提出留守理由", demon_incite_text, source)
    rt_push(rows, demon_incite)
    return rows

fn c2d_shura_rows():
    var rows = []
    let source = campaign_source("docs/design-standard.md", 0, "修罗侦探路线：恶魔背刺、公审与监禁挑拨")
    let trials = c2d_demon_trial_dialogues()
    var t = 0
    while t < rt_count(trials):
        rt_push(rows, trials[t])
        t = t + 1
    let incites = c2d_demon_incite_guard()
    t = 0
    while t < rt_count(incites):
        rt_push(rows, incites[t])
        t = t + 1
    let imprisoned = dv_fact(campaign_ref("c2.trial", "detective_imprisoned"), true)
    let shen_intercom_text = "沈大哥，后厨的火若是断了，断粮的不仅是我。你愿意为了这场审判，听任一个人挨饿吗？"
    var shen_intercom = c2d_row("detective", "detective.c2.intercom.shen", "living_hall", imprisoned, dv_true(), "请求听取关于后厨的辩解", shen_intercom_text, source)
    rt_push(rows, shen_intercom)
    let lucian_intercom_text = "高贵的骑士阁下，你愿意听我为自己辩解吗？被关押的人也应该有说话的机会吧？"
    var lucian_intercom = c2d_row("detective", "detective.c2.intercom.lucian", "living_hall", imprisoned, dv_true(), "请求听取本人的辩解", lucian_intercom_text, source)
    rt_push(rows, lucian_intercom)
    let ward_intercom_text = "弗雷德里克，被告答辩与回避程序是否完备，卷宗里的言论、动线与死因又是怎样核对的？请你逐项说明，也听取我的答辩。"
    var ward_intercom = c2d_row("detective", "detective.c2.intercom.ward", "living_hall", imprisoned, dv_true(), "询问答辩与回避程序", ward_intercom_text, source)
    rt_push(rows, ward_intercom)
    return rows

fn c2d_council_when():
    return dv_all([campaign_window(5, 450, 570), dv_fact(campaign_ref("c2.weather", "daylight"), true)])

// The actor must actually receive a proposal before treating council as an opportunity.
fn c2d_known_council_proposal():
    let norms = c2_norms()
    var known = dv_not(dv_true())
    var i = 0
    while i < rt_count(norms):
        let norm = norms[i]
        if dv_has(["open_plan", "seal_plan", "committee_plan"], norm.id):
            known = campaign_any(known, dv_fact(campaign_ref(c2_norm_object(norm.id), "text"), norm.surface))
        i = i + 1
    return known

fn c2d_stance(actor, norm):
    let accepted = dv_fact(campaign_own(actor, rt_cat("accepted.", norm)), true)
    let norms = c2_norms()
    var i = 0
    while i < rt_count(norms):
        if norms[i].id == norm and norms[i].owner == actor:
            return campaign_any(accepted, dv_fact(campaign_ref(c2_norm_object(norm), "proposed"), true))
        i = i + 1
    return accepted

axiom c2d_row_law(row):
    var effects = dv_single(dv_assign(c2d_mark(row.actor, row.id), true))
    let extra = dv_find(row, "effects", [])
    var i = 0
    while i < rt_count(extra):
        rt_push(effects, extra[i])
        i = i + 1
    return dv_axiom("c2d_row_law", 1, dv_all([campaign_at(row.actor, row.room), row.when]), effects)

法则 c2d_spoke_law，给定 行动者、method、room：
    前提 campaign_at(行动者, room)。
    则 c2d_mark(行动者, method) 变为 true。

法则 c2d_read_scope_law：
    前提 dv_fact(c2d_ref("indoor_rule"), "入夜之后，诸位留于室内。")。
    则 c2d_person_ref(侦探, "scope_undefined") 变为 true。

fn c2d_action(row):
    var prerequisites = [campaign_at(row.actor, row.room), row.when, row.literal]
    if not dv_find(row, "repeatable", false):
        rt_push(prerequisites, dv_fact(c2d_mark(row.actor, row.id), false))
    let known = dv_all(prerequisites)
    var speech = dv_with_many(campaign_speech(row.literal, row.source, "chapter2-owned-statement"), {"surface": row.text, "channel": "local"})
    if dv_has_key(row, "request"):
        speech = dv_with_many(speech, {"request": row.request, "utterance_type": "question"})
    var grants = dv_single(c2d_mark(row.actor, row.id))
    let effects = dv_find(row, "effects", [])
    var e = 0
    while e < rt_count(effects):
        rt_push(grants, effects[e].ref)
        e = e + 1
    // Actor-only observations after applied Complete; never speech propagation
    // or a claim that an environment effect has already happened in prediction.
    let observation_grants = dv_find(row, "observation_grants", [])
    e = 0
    while e < rt_count(observation_grants):
        if not dv_has(grants, observation_grants[e]):
            rt_push(grants, observation_grants[e])
        e = e + 1
    var raw_listeners = dv_find(row, "listeners", c2d_people())
    if not dv_has_key(row, "listeners") and not dv_has_key(row, "norm_proposal"):
        if dv_has_key(row, "opportunity"):
            let parts = dv_find(row.opportunity, "participants", [])
            if 0 < rt_count(parts):
                raw_listeners = dvp_merge_refs(parts, ["detective"])
        else:
            if dv_has_key(row, "request"):
                raw_listeners = [row.request.target, "detective"]
            else:
                if dv_has_key(row, "response_topic"):
                    raw_listeners = ["detective"]
    var listeners = []
    var l = 0
    while l < rt_count(raw_listeners):
        if raw_listeners[l] != row.actor:
            rt_push(listeners, raw_listeners[l])
        l = l + 1
    var action = dv_with_many(campaign_surface_action(row.id, "talk", known, dv_all([campaign_at(row.actor, row.room), row.when]), row.id, grants, row.label, row.text, row.source), {"speech": speech, "listeners": listeners, "predict_law": row.id, "owner": row.actor, "purpose_refs": dv_find(row, "purpose_refs", []), "required_room": row.room})
    if dv_has_key(row, "norm_proposal"):
        action = dv_with(action, "speech", dv_with_many(speech, {"utterance_type": "proposal", "norm_proposal": row.norm_proposal}))
    if dv_has_key(row, "personal_choice"):
        action = dv_with(action, "personal_choice", row.personal_choice)
    let metadata = ["public_grants", "public_observers", "work_decision", "work_reply", "work_clearance", "work_refusal", "concern_question", "repeatable", "manual_only", "safety_warning", "guard_decision", "advice_decision", "owned_decision", "owner_utility", "partner_decision", "completed_action_requirement"]
    var metadata_index = 0
    while metadata_index < rt_count(metadata):
        if dv_has_key(row, metadata[metadata_index]):
            action = dv_with(action, metadata[metadata_index], dv_get(row, metadata[metadata_index]))
        metadata_index = metadata_index + 1
    if dv_has_key(row, "manipulation"):
        action = dv_with(action, "speech", dv_with(action.speech, "manipulation", row.manipulation))
    if dv_has_key(row, "advice"):
        action = dv_with(action, "speech", dv_with(action.speech, "advice", row.advice))
    if row.actor == "demon":
        action = campaign_authorized_speech(action)
    if dv_has_key(row, "response_topic"):
        action = dv_with_many(action, {"response_topic": row.response_topic, "requires_actual_request": true})
    if dv_has_key(row, "opportunity"):
        action = dv_with(action, "opportunity_requirement", row.opportunity)
    if dv_has_key(row, "received_speech_requirement"):
        action = dv_with(action, "received_speech_requirement", row.received_speech_requirement)
    if dv_find(row, "category", "") == "case":
        action = dv_with_many(action, {"case_method": true, "case_base_when": known})
    return action

法则 c2d_start_watch_law：
    当 "bertrand" 位于 后勤院。
    并且 c2_any_night()。
    并且 c2_alive("bertrand")。
    则 c2d_person_ref("bertrand", "watching") 变为 true。

法则 c2d_small_shadow_law，给定 person：
    当 "bertrand" 位于 后勤院。
    并且 c2_any_night()。
    并且 c2d_person_ref("bertrand", "watching") 等于 true。
    并且 c2_alive("bertrand")。
    并且 c2d_person_ref("bertrand", "small_shadow_seen") 等于 false。
    并且 person 位于 后勤院。
    并且 c2_alive(person)。
    则 c2d_person_ref("bertrand", "small_shadow_seen") 变为 true。

fn c2d_watch_actions(actor):
    if actor != "bertrand":
        return []
    let source = c2d_source("04_案件.story", 25, "小巧身影的有限观察")
    let pre = dv_all([campaign_at(actor, "logistics"), c2_any_night(), c2_alive(actor)])
    let watch = campaign_surface_action("bertrand.c2.watch.start", "help", pre, pre, "bertrand.c2.watch.start", dv_single(c2d_person_ref(actor, "watching")), "提灯开始夜巡", "提着灯，守在后勤院。", source)
    let inspect = campaign_surface_action("bertrand.c2.watch.observe", "inspect", dv_all([pre, dv_fact(c2d_person_ref(actor, "watching"), true)]), pre, "", dv_single(c2d_person_ref(actor, "small_shadow_seen")), "留意夜间的动静", "留意夜里的身影。", source)
    return [dv_with(watch, "predict_law", "bertrand.c2.watch.start"), dv_with(inspect, "repeatable", true)]

axiom c2d_repair_record_law(actor):
    let original = c2_repair_latch_law(actor)
    return dv_axiom("c2d_repair_record_law", 1, original.premise, dv_append(original.effects, dv_assign(c2d_person_ref(actor, "repaired_latch"), true)))

axiom c2d_request_repair_record_law():
    let original = c2_latch_request_law("margaret", "quer")
    return dv_axiom("c2d_request_repair_record_law", 1, original.premise, dv_append(original.effects, dv_assign(c2d_person_ref("margaret", "requested_latch_repair"), true)))

axiom c2d_patient_take_record_law():
    let original = c2_night_take_law("mora", true)
    return dv_axiom("c2d_patient_take_record_law", 1, original.premise, dv_append(original.effects, dv_assign(c2d_person_ref("mora", "patient_food_reason"), true)))

fn c2d_objects():
    var objects = [c2_object("c2.dialogue", "lecture", {"indoor_rule": dv_field("入夜之后，诸位留于室内。"), "indoor_definition_given": dv_field(false), "contract_full_text": dv_field(campaign_contract_text()), "school_rule4": dv_field("我所立之规，皆张贴于此。"), "seal_authority": dv_field("契约"), "authority_bounded": dv_field(true), "demon_truth_betrayal": dv_field(false)})]
    let courses = c2d_curriculum()
    var i = 0
    while i < rt_count(courses):
        objects = dvs_replace(objects, 0, dv_with(objects[0], "facets", dv_with(objects[0].facets, "state", dv_with(objects[0].facets.state, courses[i].id, dv_field(courses[i].text)))))
        i = i + 1
    let people = c2d_people()
    let rows = c2d_rows()
    i = 0
    while i < rt_count(people):
        var fields = {"repaired_latch": dv_field(false), "requested_latch_repair": dv_field(false), "patient_food_reason": dv_field(false), "watching": dv_field(false), "small_shadow_seen": dv_field(false), "scope_undefined": dv_unknown()}
        var j = 0
        while j < rt_count(rows):
            if rows[j].actor == people[i]:
                fields = dv_with(fields, rt_cat("said.", rows[j].id), dv_field(false))
            j = j + 1
        let intros = c2d_introductions()
        j = 0
        while j < rt_count(intros):
            if intros[j].actor == people[i]:
                fields = dv_with(fields, "introduction", dv_field(intros[j].text))
                fields = dv_with(fields, "name", dv_with(dv_field(campaign_person_name(people[i])), "basis", [intros[j].source]))
            j = j + 1
        rt_push(objects, c2_object(rt_cat("c2.dialogue.person.", people[i]), "", fields))
        i = i + 1
    return objects

fn c2d_case_gate(mind):
    let refs = [campaign_ref("c2.ledger", "counted"), campaign_ref("c2.ledger", "reserve_received"), campaign_ref("c2.counter", "remaining"), campaign_ref("c2.ledger", "day_recorded"), campaign_ref("c2.ledger", "night_recorded"), campaign_ref("c2.ledger", "pending_registered")]
    var values = []
    var premises = []
    var i = 0
    while i < rt_count(refs):
        let cell = dv_read(mind, refs[i])
        if not dv_uncontested(cell):
            return dv_not(dv_true())
        rt_push(values, cell.value)
        rt_push(premises, dv_fact(refs[i], cell.value))
        i = i + 1
    if values[0] > 0 and values[2] + values[3] + values[4] + values[5] < values[0] + values[1]:
        return dv_all(premises)
    return dv_not(dv_true())

// Only authored goal syntax depends on id. These caches never read an actor.
fn c2d_goal_head_build(id, tasks):
    var goals = []
    var t = 0
    while t < rt_count(tasks):
        if tasks[t].actor == id:
            rt_push(goals, dv_with_many(campaign_goal(dv_fact(c2daily_ref(tasks[t].field), true), tasks[t].when, [campaign_approved("real-daily-contact-action")]), {"navigation_room": tasks[t].room, "navigation_methods": [tasks[t].id]}))
        t = t + 1
    rt_push(goals, dv_with_many(campaign_observation_goal(c2daily_ref("meal_prepared"), campaign_window(2, 690, 810), [campaign_approved("look-for-real-lunch")], 2130), {"navigation_room": "living_hall", "navigation_methods": [rt_cat(id, ".c2.inspect.c2.daily")]}))
    if id == "ward":
        rt_push(goals, dv_with_many(campaign_observation_goal(c2daily_ref("draft_notes"), c2daily_notes_window(), [campaign_approved("inspect-current-draft-before-owned-norm-discussion")], 2250), {"navigation_room": "central_hall", "navigation_methods": ["ward.c2.daily.inspect-central"]}))
    if id == "shen":
        rt_push(goals, dv_with_many(campaign_goal(dv_fact(c2daily_ref("meal_cooked"), true), campaign_window(2, 690, 810), [campaign_approved("cook-real-lunch")]), {"navigation_room": "logistics", "navigation_methods": ["shen.c2.daily.cook-sixteen"]}))
        rt_push(goals, dv_with_many(campaign_goal(dv_fact(c2daily_ref("meal_prepared"), true), dv_all([campaign_window(2, 690, 810), dv_fact(c2daily_ref("meal_cooked"), true)]), [campaign_approved("deliver-real-lunch")]), {"navigation_room": "living_hall", "navigation_methods": ["shen.c2.daily.deliver-sixteen"]}))
    if id == "ruan":
        rt_push(goals, dv_with_many(campaign_goal(dv_fact(c2daily_ref("draft_notes"), true), c2daily_notes_window(), [campaign_approved("draft-notes-through-real-action")]), {"navigation_room": "central_hall", "navigation_methods": ["ruan.c2.draft-notes"]}))
    return goals

fn c2d_goal_head(id, tasks):
    let key = ["c2d-goal-static-head-v1", id]
    let cached = rt_memo_get(tasks, key)
    if cached[0]:
        return cached[1]
    return rt_memo_put(tasks, key, c2d_goal_head_build(id, tasks))

fn c2d_goal_tail_build(id):
    var goals = []
    var i = 0
    let study = dv_all([dv_fact(campaign_access("north"), true), campaign_window(2, 600, 690)])
    rt_push(goals, dv_with_many(campaign_goal(campaign_at(id, "lecture"), study, [c2d_source("06_场面.story", 79, "请到讲堂")]), {"navigation_room": "lecture", "maintain_presence": true}))
    if id == "bertrand":
        rt_push(goals, dv_with(campaign_goal(dv_fact(c2d_person_ref(id, "watching"), true), c2_any_night(), [campaign_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/14_贝尔特朗.story", 30, "夜里巡夜：护住同伴")]), "navigation_room", "logistics"))
        rt_push(goals, dv_with(campaign_observation_goal(c2d_person_ref(id, "small_shadow_seen"), dv_all([c2_any_night(), dv_fact(c2d_person_ref(id, "watching"), true)]), [c2d_source("04_案件.story", 25, "有限身影观察")], 0), "navigation_room", "logistics"))
    if id == "detective":
        let ledger_fields = ["counted", "reserve_received", "day_recorded", "night_recorded", "pending_registered"]
        rt_push(goals, campaign_observation_goal(campaign_ref("c2.counter", "remaining"), campaign_at(id, "logistics"), [campaign_source("docs/design-standard.md", 0, "实物清点与台账对照")], 0))
        i = 0
        while i < rt_count(ledger_fields):
            rt_push(goals, campaign_observation_goal(campaign_ref("c2.ledger", ledger_fields[i]), campaign_at(id, "logistics"), [c2d_source("04_案件.story", 10, "从读到账目再判断是否有缺口")], 0))
            i = i + 1
    if id == "quer":
        rt_push(goals, dv_with(campaign_goal(dv_fact(campaign_ref("c2.granary", "latch_loose"), false), dv_all([dv_fact(campaign_ref("c2.granary", "latch_loose"), true), c2_work_accepted(id, "quer.c2.granary.precision")]), [c2d_source("10_执行.story", 17, "RepairLatch")]), "navigation_room", "logistics"))
    let opportunity = c2d_known_council_proposal()
    let venues = [{"room": "oath_court", "wind": true}, {"room": "central_hall", "wind": false}]
    i = 0
    while i < rt_count(venues):
        let venue = venues[i]
        let when = dv_all([c2d_council_when(), c2_alive(id), opportunity, dv_fact(campaign_ref("c2.weather", "wind"), venue.wind), dv_fact(c2daily_ref(rt_cat("signed.", id)), false)])
        rt_push(goals, dv_with(campaign_goal(campaign_at(id, venue.room), when, [c2d_source("06_场面.story", 340, "章二议事机会")]), "navigation_room", venue.room))
        // Ballot effects increment the actually inspected tally, never an assumed zero.
        let tally = ["votes.open_plan", "votes.seal_plan", "votes.committee_plan"]
        var n = 0
        while n < rt_count(tally):
            rt_push(goals, dv_with(campaign_observation_goal(c2daily_ref(tally[n]), when, [campaign_approved("actual-council-tally-before-personal-ballot")], 6210), "navigation_room", venue.room))
            n = n + 1
        i = i + 1
    return goals

fn c2d_goal_tail(id):
    let key = ["c2d-goal-static-tail-v1", id]
    let cached = rt_memo_get([], key)
    if cached[0]:
        return cached[1]
    return rt_memo_put([], key, c2d_goal_tail_build(id))

// All live qualification stays in c2d_goals. Only the resulting declaration
// is memoized by its complete row, owner and already computed condition.
fn c2d_row_goal(row, id, when):
    let key = ["c2d-row-goal-declaration-v1", id, when]
    let cached = rt_memo_get(row, key)
    if cached[0]:
        return cached[1]
    return rt_memo_put(row, key, campaign_index_goal_window({"kind": "communicate", "scope": "personal", "method_id": row.id, "available_when": when, "basis": [row.source], "requires_argument": false, "navigation_room": row.room}))

// These goals ask for local perception. The source receipt does not reveal
// a patient's location or condition; only a known location guides navigation.
fn c2d_trial_evidence_goals(actor):
    var goals = []
    var patients = []
    if actor.id == "mora" and c2_received_requirement(actor, {"speaker": "ruan", "action_id": "ruan.c2.trial.indict"}):
        patients = ["moran"]
    if actor.id == "demon" and c2_received_requirement(actor, {"speaker": "detective", "action_id": "detective.c2.color.encourage"}):
        patients = ["moran", "bertrand"]
    let source = campaign_source("docs/design-standard.md", 0, "修罗侦探路线：实际伤情核对")
    var i = 0
    while i < rt_count(patients):
        let patient = patients[i]
        var field = "dead"
        if patient == "bertrand":
            field = "stone_stupor"
        var goal = campaign_observation_goal(campaign_own(patient, field), dv_at_least(campaign_clock(), 6120), [source], 6120)
        let place = dv_read(actor.mind, campaign_position_ref(patient))
        if dv_uncontested(place) and dv_has(c2_rooms(), place.value):
            goal = dv_with_many(goal, {"navigation_room": place.value, "navigation_methods": [rt_cat(actor.id, rt_cat(".c2.examine.", patient))]})
        rt_push(goals, goal)
        i = i + 1
    return goals

fn c2d_goals(actor):
    var goals = []
    var rows = c2d_rows()
    if dv_find(actor.policy, "opt_plancache", false):
        let allowed = dv_find(actor.policy, "allow_manipulation_candidates", false)
        let key = ["owned-declared-goal-rows-v1", actor.id, allowed]
        let cached = rt_memo_get(rows, key)
        if cached[0]:
            rows = cached[1]
        else:
            var selected = []
            var row_index = 0
            while row_index < rt_count(rows):
                let row = rows[row_index]
                if row.actor == actor.id and (not dv_find(row, "manual_only", false) or (dv_has_key(row, "manipulation") and allowed)):
                    rt_push(selected, row)
                row_index = row_index + 1
            rows = rt_memo_put(rows, key, selected)
    let tasks = c2daily_tasks()
    goals = dv_clone(c2d_goal_head(actor.id, tasks))
    // Invocation-local reuse: actor/mind remain unchanged throughout this loop.
    // Evaluate lazily at the original first use so unrelated errors keep order.
    var concerned_ready = false
    var concerned = false
    var notice_ready = false
    var notice = false
    var case_ready = false
    var case_gate = false
    var i = 0
    while i < rt_count(rows):
        let row = rows[i]
        if row.actor == actor.id and (not dv_find(row, "manual_only", false) or (dv_has_key(row, "manipulation") and dv_find(actor.policy, "allow_manipulation_candidates", false))):
            var when = dv_all([row.when, row.literal])
            if not dv_find(row, "repeatable", false):
                when = dv_all([when, dv_fact(c2d_mark(actor.id, row.id), false)])
            if dv_has_key(row, "owned_decision"):
                let candidate = dvp_find_action(actor.actions, row.id)
                if candidate == false or not dvp_owned_decision_ready(actor, candidate, actor.mind):
                    when = dv_not(dv_true())
            if dv_has_key(row, "partner_decision"):
                let candidate = dvp_find_action(actor.actions, row.id)
                if candidate == false or not dvp_personal_ready(actor.mind, candidate.personal_choice):
                    when = dv_not(dv_true())
            if dv_find(row, "work_refusal", false) or dv_find(row, "concern_question", false):
                if not concerned_ready:
                    concerned = c2_quer_concerned(actor)
                    concerned_ready = true
                if not concerned:
                    when = dv_not(dv_true())
            if dv_find(row, "safety_warning", false) or dv_find(row, "guard_decision", false):
                if not notice_ready:
                    notice = c2_owned_safety_notice(actor)
                    notice_ready = true
                if not notice:
                    when = dv_not(dv_true())
            if dv_find(row, "category", "") == "case":
                if not case_ready:
                    case_gate = c2d_case_gate(actor.mind)
                    case_ready = true
                when = dv_all([when, case_gate])
            if dv_has_key(row, "received_speech_requirement"):
                if not c2_received_requirement(actor, row.received_speech_requirement):
                    when = dv_not(dv_true())
            if dv_has_key(row, "completed_action_requirement"):
                if not dv_has(dv_find(actor, "completed_actions", []), row.completed_action_requirement.action_id):
                    when = dv_not(dv_true())
            if dv_has_key(row, "response_topic"):
                if rt_count(dvs_pending_request(actor, row)) == 0:
                    when = dv_not(dv_true())
            if dv_has_key(row, "advice_decision"):
                let candidate = dvp_find_action(actor.actions, row.id)
                if candidate == false or not dvs_advice_decision_ready(actor, candidate, actor.mind):
                    when = dv_not(dv_true())
            if dv_has_key(row, "opportunity"):
                let opp = row.opportunity
                var opp_present = true
                if opp.mode == "all-present":
                    var p = 0
                    while p < rt_count(opp.participants):
                        if opp.participants[p] != actor.id and dv_truth(actor.mind, campaign_at(opp.participants[p], opp.location)) != "true":
                            opp_present = false
                        p = p + 1
                else:
                    if opp.mode == "at-least-one-present":
                        var p = 0
                        var any_present = false
                        while p < rt_count(opp.participants):
                            if opp.participants[p] == actor.id or dv_truth(actor.mind, campaign_at(opp.participants[p], opp.location)) == "true":
                                any_present = true
                            p = p + 1
                        if not any_present:
                            opp_present = false
                    else:
                        if opp.mode == "none-present":
                            var p = 0
                            while p < rt_count(opp.participants):
                                if opp.participants[p] != actor.id and dv_truth(actor.mind, campaign_at(opp.participants[p], opp.location)) == "true":
                                    opp_present = false
                                p = p + 1
                if not opp_present:
                    when = dv_not(dv_true())
            rt_push(goals, c2d_row_goal(row, actor.id, when))
        i = i + 1
    // Tail is first requested only after the original dynamic row loop.
    let tail = dv_clone(c2d_goal_tail(actor.id))
    i = 0
    while i < rt_count(tail):
        rt_push(goals, tail[i])
        i = i + 1
    let evidence_goals = c2d_trial_evidence_goals(actor)
    i = 0
    while i < rt_count(evidence_goals):
        rt_push(goals, evidence_goals[i])
        i = i + 1
    return goals

fn c2d_refresh_actor_goals(actor):
    return c2d_refresh_goals_from(c2_refresh_content_actions(actor))

fn c2d_refresh_goals_from(actor):
    let goals = c2d_goals(actor)
    var policy = dv_with(actor.policy, "chapter2_dialogue_goals", goals)
    var combined = c2_personal_goals(actor)
    var i = 0
    // Actual self-location is the arrival receipt; content installation is not arrival.
    if actor.id != "demon" and dv_truth(actor.mind, campaign_at(actor.id, "living_hall")) == "true":
        policy = dv_with(policy, "chapter1_carried_goals", [])
    let carried = dv_find(policy, "chapter1_carried_goals", [])
    if actor.id == "demon" or dv_truth(actor.mind, campaign_at(actor.id, "living_hall")) != "true":
        while i < rt_count(carried):
            rt_push(combined, carried[i])
            i = i + 1
    i = 0
    while i < rt_count(goals):
        rt_push(combined, goals[i])
        i = i + 1
    let original_actions = actor.actions
    var actions = []
    var case_ready = false
    var case_gate = false
    i = 0
    while i < rt_count(original_actions):
        var action = original_actions[i]
        if dv_find(action, "case_method", false):
            let base_when = action.case_base_when
            if not case_ready:
                case_gate = c2d_case_gate(actor.mind)
                case_ready = true
            action = dv_with(action, "precondition", dv_all([base_when, case_gate]))
        rt_push(actions, action)
        i = i + 1
    let view = dv_with_many(actor, {"policy": dv_with(policy, "goals", combined), "actions": actions})
    return dv_with(view, "policy", dv_with(view.policy, "goals", c2_navigation_goals(view, combined)))

fn c2d_install_scene(scene):
    if dv_find(scene, "chapter2_dialogue_installed", false):
        return scene
    var physical = scene.physical
    var bindings = dv_clone(scene.bindings)
    let objects = c2d_objects()
    var i = 0
    while i < rt_count(objects):
        physical = campaign_add_new(physical, objects[i])
        i = i + 1
    let rows = c2d_rows()
    i = 0
    while i < rt_count(rows):
        physical = dv_adopt(physical, campaign_method(rows[i].id, c2d_row_law(rows[i])), "enforce", 1, rows[i].source)
        i = i + 1
    physical = dv_adopt(physical, campaign_method("bertrand.c2.watch.start", c2d_start_watch_law()), "enforce", 1, c2d_source("04_案件.story", 25, "有限巡夜"))
    var processes = dv_clone(dv_find(scene, "world_processes", []))
    let small_people = ["quer", "su", "elena"]
    i = 0
    while i < rt_count(small_people):
        let id = rt_cat("c2.dialogue.shadow.", small_people[i])
        let source = c2d_source("04_案件.story", 25, "瘦小身影：不据此辨人")
        physical = dv_adopt(physical, campaign_method(id, c2d_small_shadow_law(small_people[i])), "enforce", 1, source)
        rt_push(processes, {"id": id, "law": id, "basis": [source]})
        i = i + 1
    let repair_source = c2d_source("10_执行.story", 17, "真实修理的本人记录")
    physical = dv_adopt(physical, campaign_method("quer.c2.dialogue.record-repair", c2d_repair_record_law("quer")), "enforce", 1, repair_source)
    physical = dv_adopt(physical, campaign_method("huo.c2.dialogue.record-repair", c2d_repair_record_law("huo")), "enforce", 1, repair_source)
    physical = dv_adopt(physical, campaign_method("margaret.c2.dialogue.record-request", c2d_request_repair_record_law()), "enforce", 1, c2d_source("04_案件.story", 86, "玛格丽特的请托"))
    physical = dv_adopt(physical, campaign_method("mora.c2.dialogue.record-patient-take", c2d_patient_take_record_law()), "enforce", 1, c2d_source("10_执行.story", 7, "NightTakeSick：本人行动理由"))
    var actors = []
    i = 0
    while i < rt_count(scene.actors):
        var actor = scene.actors[i]
        var mind = actor.mind
        var j = 0
        while j < rt_count(objects):
            mind = campaign_add_new(mind, campaign_local_object(objects[j].id))
            if dv_local(bindings, objects[j].id, actor.id) == "":
                rt_push(bindings, dv_binding(objects[j].id, objects[j].id, actor.id))
            j = j + 1
        // Only new protocol/identity self fields are initialized; all inherited bodies stay untouched.
        let own_fields = dv_get(dv_get(dv_find(physical, "objects", []), rt_cat("c2.dialogue.person.", actor.id)), "facets")
        let self_fields = own_fields.state
        j = 0
        while j < rt_count(self_fields):
            let field = self_fields[j]
            if field[0] != "small_shadow_seen" and field[0] != "scope_undefined":
                if not dv_read(mind, c2d_person_ref(actor.id, field[0])).known:
                    mind = dv_store(mind, c2d_person_ref(actor.id, field[0]), field[1])
            j = j + 1
        if actor.id == "demon":
            let curriculum_fields = objects[0].facets.state
            j = 0
            while j < rt_count(curriculum_fields):
                mind = dv_store(mind, c2d_ref(curriculum_fields[j][0]), curriculum_fields[j][1])
                j = j + 1
        var actions = dv_clone(actor.actions)
        j = 0
        while j < rt_count(rows):
            if rows[j].actor == actor.id:
                rt_push(actions, c2d_action(rows[j]))
                mind = dv_adopt(mind, campaign_method(rows[j].id, c2d_row_law(rows[j])), "predict", 1, rows[j].source)
            j = j + 1
        let watch = c2d_watch_actions(actor.id)
        j = 0
        while j < rt_count(watch):
            rt_push(actions, watch[j])
            j = j + 1
        if actor.id == "demon":
            let examinations = c2_casualty_actions("demon")
            j = 0
            while j < rt_count(examinations):
                rt_push(actions, examinations[j])
                j = j + 1
        if actor.id == "bertrand":
            mind = dv_adopt(mind, campaign_method("bertrand.c2.watch.start", c2d_start_watch_law()), "predict", 1, c2d_source("04_案件.story", 25, "本人巡夜选择"))
        j = 0
        while j < rt_count(actions):
            var action = actions[j]
            if actor.id == "quer" or actor.id == "huo":
                if action.id == rt_cat(actor.id, ".c2.repair.latch"):
                    let law = rt_cat(actor.id, ".c2.dialogue.record-repair")
                    action = dv_with_many(action, {"law": law, "predict_law": law, "grants": dv_append(action.grants, c2d_person_ref(actor.id, "repaired_latch"))})
                    mind = dv_adopt(mind, campaign_method(law, c2d_repair_record_law(actor.id)), "predict", 1, repair_source)
            if action.id == "margaret.c2.request.repair_latch":
                let law = "margaret.c2.dialogue.record-request"
                action = dv_with_many(action, {"law": law, "predict_law": law, "grants": dv_append(action.grants, c2d_person_ref(actor.id, "requested_latch_repair"))})
                mind = dv_adopt(mind, campaign_method(law, c2d_request_repair_record_law()), "predict", 1, c2d_source("04_案件.story", 86, "本人请求记录"))
            if action.id == "mora.c2.night_take.patient":
                let law = "mora.c2.dialogue.record-patient-take"
                action = dv_with_many(action, {"law": law, "predict_law": law, "grants": dv_append(action.grants, c2d_person_ref(actor.id, "patient_food_reason"))})
                mind = dv_adopt(mind, campaign_method(law, c2d_patient_take_record_law()), "predict", 1, c2d_source("10_执行.story", 7, "NightTakeSick：本人行动理由"))
            actions = dvs_replace(actions, j, action)
            j = j + 1
        actor = dv_with_many(actor, {"mind": mind, "actions": campaign_public_methods(actions), "policy": dv_with(actor.policy, "notice_co_presence", true)})
        rt_push(actors, c2d_refresh_actor_goals(actor))
        i = i + 1
    return dv_with_many(scene, {"physical": physical, "actors": actors, "bindings": bindings, "world_processes": processes, "chapter2_dialogue_installed": true})

// Display reads the name carried by the actual introduction, including in old records.
fn c2d_known_speaker_name(mind, actor):
    let name = dv_read(mind, c2d_person_ref(actor, "name"))
    if dv_uncontested(name) and rt_is_text(name.value):
        return name.value
    return ""


// Article 11 negotiation only. No departure, safety oracle or seed-selected dissenter.
fn c2h_ref(field):
    return campaign_ref("c2.homecoming", field)

fn c2h_person(actor, field):
    return c2h_ref(rt_cat(actor, rt_cat(".", field)))

fn c2h_source():
    return campaign_approved("user:2026-10-18-article11-owned-negotiation")

fn c2h_contract():
    return dv_fact(c2d_ref("contract_full_text"), campaign_contract_text())

// A promise from a companion is not an island-exit promise. These unmet
// premises remain unknown until a separately authorized real source exists.
fn c2h_consent_requires(actor):
    var clauses = [c2h_contract()]
    if dv_has(["ward", "veronica", "ruan"], actor):
        rt_push(clauses, dv_fact(c2h_ref("safety_verified"), true))
    if dv_has(["margaret", "shen", "mora", "bertrand"], actor):
        rt_push(clauses, dv_fact(campaign_ref("c2.granary", "reserve_added"), true))
        rt_push(clauses, dv_fact(c2h_ref("care_continuity_verified"), true))
    if actor == "quer":
        rt_push(clauses, dv_fact(campaign_ref("case.contract", "gu_apologized"), true))
        rt_push(clauses, dv_fact(campaign_own("ward", "restriction_withdrawn"), true))
        rt_push(clauses, dv_fact(c2h_ref("outside_promise.quer"), true))
    if actor == "elena":
        rt_push(clauses, dv_fact(campaign_ref("case.astral", "abandoned_child_misunderstanding_resolved"), true))
        rt_push(clauses, dv_fact(c2h_ref("outside_promise.elena"), true))
    return dv_all(clauses)

fn c2h_objection(actor):
    if dv_has(["ward", "veronica", "ruan"], actor):
        叙述：
            我对契约履行的安全仍有保留，暂不赞成。条文、本人实证与履行结果需要分别核对。
    if dv_has(["huo", "su", "moran", "gu"], actor):
        叙述：
            尽忘意味着放弃在这里取得的认识。我仍要比较求知与生存的价值，现在保留意见。
    if dv_has(["margaret", "shen", "mora", "bertrand"], actor):
        叙述：
            粮仓和病人的责任还要依据我实际知道的情况核对。我暂不把归乡当作这些责任已经解决。
    if actor == "quer" or actor == "elena":
        叙述：
            旧怨是否真正修复，岛外是否有可以依靠的承诺，都要由我自己确认。现在我保留意见。
    叙述：
        我还愿意继续核对留岛与尽忘归乡的代价，暂不赞成。

fn c2h_rows():
    var rows = []
    let source = c2h_source()
    let proposal_id = "detective.c2.homecoming.propose"
    var propose = c2d_row("detective", proposal_id, "living_hall", c2h_contract(), dv_true(), "提出尽忘归乡的协商", "我提议按契约第十一条协商尽忘归乡。我的愿意另行表态；其余仍存活在岛上的每个人都须本人同意，听见提议不算同意。", source)
    propose = dv_with_many(propose, {"effects": [dv_assign(c2h_ref("proposed"), true)], "received_speech_requirement": {"speaker": "demon", "action_id": "demon.c2.contract-full-text"}})
    rt_push(rows, propose)
    let people = campaign_people()
    var i = 0
    while i < rt_count(people):
        let actor = people[i]
        let ready = dv_all([c2_alive(actor), c2h_contract()])
        let consent = c2h_consent_requires(actor)
        let options = ["consent", "defer"]
        var n = 0
        while n < rt_count(options):
            let accepts = options[n] == "consent"
            var when = ready
            var text = c2h_objection(actor)
            if accepts:
                when = dv_all([ready, consent])
                text = "这是我本人的选择：我愿意尽忘归乡。这句话只记录我的愿意，不能代替任何其他人的同意。"
            var decision_field = "consent_detective"
            if actor == "detective":
                decision_field = "willing"
            elif accepts:
                text = "我同意侦探按契约第十一条申请尽忘归乡。这只表示我对他的申请的表态，不表示我自己也决定离开。"
            let id = rt_cat(actor, rt_cat(".c2.homecoming.", options[n]))
            var row = c2d_row(actor, id, "living_hall", when, dv_true(), dv_get({"consent": "同意归乡申请", "defer": "暂缓归乡申请"}, options[n]), text, source)
            row = dv_with_many(row, {"effects": [dv_assign(c2h_person(actor, "decided"), true), dv_assign(c2h_person(actor, decision_field), accepts), dv_assign(c2h_person(actor, "stance"), options[n])], "repeatable": true, "owned_decision": c2h_decision(actor, options[n]), "received_speech_requirement": {"speaker": "detective", "action_id": proposal_id}})
            if actor == "detective":
                row = dv_without(row, "received_speech_requirement")
                row = dv_with(row, "when", dv_all([when, dv_fact(c2h_ref("proposed"), true)]))
            rt_push(rows, row)
            n = n + 1
        i = i + 1
    // Departure requires a separately implemented execution contract. A proposal
    // and elapsed time never stand in for consent, safety or actual departure.
    let ruan_id = "ruan.c2.exile.dead_stone"
    let proposal = "ward.c2.exile.motion"
    let ruan_pre = dv_all([c2h_present("ruan"), dv_fact(campaign_ref("c2.casualty", "casualty_occurred"), true)])
    var ruan = c2d_row("ruan", ruan_id, "central_hall", ruan_pre, dv_true(), "提议核对伤亡与配给责任", "我主张把伤亡与配给责任放在一起对账，并提出是否继续承担侦探配给的问题。这只是我的主张。", source)
    ruan = dv_with_many(ruan, {"effects": [dv_assign(c2h_person("ruan", "dead_stone_declared"), true)], "public_grants": [c2h_person("ruan", "dead_stone_declared"), c2d_mark("ruan", ruan_id)], "personal_choice": c2h_exile_choice("ruan-declaration", ruan_pre, ["controlled_audit", "records"], ["patient_priority"])})
    rt_push(rows, ruan)
    let ward_pre = dv_all([c2h_present("ward"), dv_fact(c2h_person("ruan", "dead_stone_declared"), true), c2h_balance_condition()])
    var ward = c2d_row("ward", proposal, "central_hall", ward_pre, dv_true(), "提出剥夺配给与放逐动议", "我提出《剥夺配给与放逐动议》，请各位分别表态。提出动议尚不代表动议通过或已经执行。", source)
    ward = dv_with_many(ward, {"effects": [dv_assign(c2h_ref("exile_motion_proposed"), true)], "public_grants": [c2h_ref("exile_motion_proposed"), c2d_mark("ward", proposal)], "received_speech_requirement": {"speaker": "ruan", "action_id": ruan_id}, "personal_choice": c2h_exile_choice("ward-motion", ward_pre, ["committee", "records"], ["patient_priority"])})
    rt_push(rows, ward)
    i = 0
    while i < rt_count(people):
        let actor = people[i]
        let ready = dv_all([c2h_present(actor), dv_fact(c2h_ref("exile_motion_proposed"), true)])
        let options = ["consent", "reject"]
        var n = 0
        while n < rt_count(options):
            let accepts = options[n] == "consent"
            var promotes = ["patient_priority", "solidarity"]
            var sacrifices = ["restriction"]
            var text = "我反对放逐侦探。这只记录我本人的意见。"
            if accepts:
                promotes = ["safety", "records", "restriction"]
                sacrifices = ["patient_priority", "solidarity"]
                text = "我同意这项放逐动议。这只记录我本人的意见，不能替他人投票，也不代表已执行。"
            let id = rt_cat(actor, rt_cat(".c2.exile.", options[n]))
            var row = c2d_row(actor, id, "central_hall", ready, dv_true(), dv_get({"consent": "赞成放逐动议", "reject": "反对放逐动议"}, options[n]), text, source)
            row = dv_with_many(row, {"effects": [dv_assign(c2h_person(actor, "exile_stance"), options[n])], "public_grants": [c2h_person(actor, "exile_stance"), c2d_mark(actor, id)], "repeatable": true, "owned_decision": c2h_exile_decision(actor, options[n]), "received_speech_requirement": {"speaker": "ward", "action_id": proposal}, "personal_choice": c2h_exile_choice(rt_cat("exile.", actor), ready, promotes, sacrifices)})
            rt_push(rows, row)
            n = n + 1
        i = i + 1
    // A unanimous decision records deprivation of rations; it never moves or
    // exiles anyone. There is no escort execution contract in this module.
    let passed = c2h_motion_passed_condition()
    var record = c2d_row("ward", "ward.c2.exile.record-unanimous", "central_hall", passed, dv_true(), "记录在场者的表决", "本次在场有能力参与者已分别同意，记录一致剥夺配给的决议。放逐尚待实际执行。", source)
    record = dv_with_many(record, {"effects": [dv_assign(c2h_ref("exile_motion_passed"), true), dv_assign(c2h_ref("ration_deprivation_decided"), true)], "public_grants": [c2h_ref("exile_motion_passed"), c2h_ref("ration_deprivation_decided")], "personal_choice": c2h_exile_choice("ward-record-unanimous", passed, ["committee", "records"], [])})
    rt_push(rows, record)
    let refuse_pre = dv_all([c2h_present("veronica"), dv_fact(c2h_ref("exile_motion_passed"), true), dv_fact(c2h_person("veronica", "exile_stance"), "consent")])
    var refuse = c2d_row("veronica", "veronica.c2.exile.refuse", "central_hall", refuse_pre, dv_true(), "表明是否继续提供防护", "我拒绝继续为这项配给责任提供防护。这是我本人的决定。", source)
    refuse = dv_with_many(refuse, {"effects": [dv_assign(c2h_person("veronica", "protection_refused"), true)], "received_speech_requirement": {"speaker": "ward", "action_id": "ward.c2.exile.record-unanimous"}, "personal_choice": c2h_exile_choice("veronica-refuse-protection", refuse_pre, ["safety", "avoid_ethics_review"], ["patient_priority"])})
    rt_push(rows, refuse)
    return rows

fn c2h_present(actor):
    return dv_all([campaign_at(actor, "central_hall"), c2_alive(actor), dv_fact(campaign_own(actor, "stone_stupor"), false), dv_fact(campaign_own(actor, "in_coma"), false)])

fn c2h_exile_choice(group, requires, promotes, sacrifices):
    return {"group": group, "requires": requires, "prohibits": dv_not(dv_true()), "promotes": promotes, "sacrifices": sacrifices, "require_positive": true, "basis": [c2h_source()]}

fn c2h_exile_decision(actor, stance):
    var refs = [c2h_ref("exile_motion_proposed"), campaign_ref("c2.casualty", "casualty_occurred"), campaign_own(actor, "hungry"), campaign_own(actor, "alive"), campaign_own(actor, "stone_stupor"), campaign_own(actor, "in_coma")]
    return {"id": rt_cat("exile.", actor), "stance": stance, "context_refs": refs, "context_policy_keys": ["value_order", "speaker_trust", "class_bias"], "request_topics": [], "basis": [c2h_source()]}

// Existing group balance is a background prerequisite, never a voting rule.
// Cardinality is compiled into ordinary propositions and evaluated in the same
// world as the actual law; the summary does not publish authority effects.
fn c2h_at_least_conditions(items, start, count):
    if count <= 0:
        return dv_true()
    if rt_count(items) - start < count:
        return dv_not(dv_true())
    return campaign_any(dv_all([items[start], c2h_at_least_conditions(items, start + 1, count - 1)]), c2h_at_least_conditions(items, start + 1, count))

fn c2h_balance_condition():
    let guardians = ["shen", "mora", "huo", "quer", "bertrand", "margaret"]
    let calculators = ["ruan", "ward", "veronica"]
    var g = []
    var c = []
    var i = 0
    while i < rt_count(guardians):
        rt_push(g, c2h_present(guardians[i]))
        i = i + 1
    i = 0
    while i < rt_count(calculators):
        rt_push(c, c2h_present(calculators[i]))
        i = i + 1
    var cases = []
    i = 1
    while i <= rt_count(calculators):
        rt_push(cases, dv_all([c2h_at_least_conditions(c, 0, i), dv_not(c2h_at_least_conditions(g, 0, i))]))
        i = i + 1
    return dv_not(dv_all(c2_negated_conditions(cases)))

fn c2h_motion_passed_condition():
    var clauses = [c2h_present("ward"), dv_fact(c2h_ref("exile_motion_proposed"), true), c2h_balance_condition()]
    let people = campaign_people()
    var i = 0
    while i < rt_count(people):
        let actor = people[i]
        // An absent living capable person is unresolved, never an implicit yes.
        let excluded = campaign_any(dv_fact(campaign_own(actor, "alive"), false), dv_fact(campaign_own(actor, "stone_stupor"), true))
        let consent = dv_all([c2h_present(actor), dv_fact(c2h_person(actor, "exile_stance"), "consent"), dv_fact(c2d_mark(actor, rt_cat(actor, ".c2.exile.consent")), true)])
        rt_push(clauses, campaign_any(excluded, consent))
        i = i + 1
    return dv_all(clauses)

fn c2h_inspect_ballot(actor, person):
    let pre = dv_all([campaign_at(actor, "central_hall"), campaign_at(person, "central_hall"), c2_alive(actor)])
    let refs = [campaign_own(person, "alive"), campaign_own(person, "stone_stupor"), campaign_own(person, "in_coma"), c2h_person(person, "exile_stance"), c2d_mark(person, rt_cat(person, ".c2.exile.consent")), c2d_mark(person, rt_cat(person, ".c2.exile.reject"))]
    return dv_with(campaign_surface_action(rt_cat(actor, rt_cat(".c2.exile.inspect.", person)), "inspect", pre, pre, "", refs, "核对在场者的表态记录", "核对在场者的状态与本人表态记录。", c2h_source()), "repeatable", true)

fn c2h_is_exile(id):
    if dv_has(["ruan.c2.exile.dead_stone", "ward.c2.exile.motion", "ward.c2.exile.record-unanimous", "veronica.c2.exile.refuse"], id):
        return true
    let people = campaign_people()
    var i = 0
    while i < rt_count(people):
        if id == rt_cat(people[i], ".c2.exile.consent") or id == rt_cat(people[i], ".c2.exile.reject"):
            return true
        i = i + 1
    return false

fn c2h_install_scene(scene):
    if dv_find(scene, "chapter2_homecoming_installed", false):
        return scene
    var fields = {"proposed": dv_field(false), "departed": dv_field(false), "trauma_imprints_sealed": dv_field(false), "ration_deprivation_decided": dv_field(false), "exile_motion_proposed": dv_field(false), "exile_motion_passed": dv_field(false), "safety_verified": dv_unknown(), "outside_promise.quer": dv_unknown(), "outside_promise.elena": dv_unknown(), "care_continuity_verified": dv_unknown()}
    let people = campaign_people()
    var i = 0
    while i < rt_count(people):
        fields = dv_with_many(fields, [[rt_cat(people[i], ".decided"), dv_field(false)], [rt_cat(people[i], ".willing"), dv_unknown()], [rt_cat(people[i], ".consent_detective"), dv_unknown()], [rt_cat(people[i], ".stance"), dv_unknown()], [rt_cat(people[i], ".exile_stance"), dv_unknown()]])
        i = i + 1
    var physical = campaign_add_new(scene.physical, c2_object("c2.homecoming", "living_hall", fields))
    var bindings = dv_clone(scene.bindings)
    var actors = []
    let rows = c2h_rows()
    i = 0
    while i < rt_count(rows):
        physical = dv_store(physical, c2d_mark(rows[i].actor, rows[i].id), dv_field(false))
        physical = dv_adopt(physical, campaign_method(rows[i].id, c2d_row_law(rows[i])), "enforce", 1, [rows[i].source])
        i = i + 1
    i = 0
    while i < rt_count(scene.actors):
        var actor = scene.actors[i]
        var mind = campaign_add_new(actor.mind, campaign_local_object("c2.homecoming"))
        if dv_local(bindings, "c2.homecoming", actor.id) == "":
            rt_push(bindings, dv_binding("c2.homecoming", "c2.homecoming", actor.id))
        var actions = dv_clone(actor.actions)
        if dv_has(people, actor.id):
            mind = dv_store(mind, c2h_person(actor.id, "decided"), dv_field(false))
        var j = 0
        while j < rt_count(rows):
            let row = rows[j]
            if row.actor == actor.id:
                mind = dv_store(mind, c2d_mark(actor.id, row.id), dv_field(false))
                mind = dv_adopt(mind, campaign_method(row.id, c2d_row_law(row)), "predict", 1, [row.source])
                let is_exile = c2h_is_exile(row.id)
                var act = c2d_action(row)
                if not is_exile:
                    act = dv_with(act, "manual_only", true)
                rt_push(actions, act)
            j = j + 1
        if dv_has(people, actor.id):
            j = 0
            while j < rt_count(people):
                if actor.id == "ward" or people[j] == actor.id:
                    rt_push(actions, c2h_inspect_ballot(actor.id, people[j]))
                j = j + 1
        rt_push(actors, dv_with_many(actor, {"mind": mind, "actions": campaign_public_methods(actions)}))
        i = i + 1
    return dv_with_many(scene, {"physical": physical, "actors": actors, "bindings": bindings, "chapter2_homecoming_installed": true})

// Both stances share an identity: only new relevant owned facts reopen a vote.
fn c2h_decision(actor, stance):
    var refs = [c2d_ref("contract_full_text"), c2h_ref("proposed")]
    if dv_has(["ward", "veronica", "ruan"], actor):
        rt_push(refs, c2h_ref("safety_verified"))
    if dv_has(["margaret", "shen", "mora", "bertrand"], actor):
        refs = dvp_merge_refs(refs, [campaign_ref("c2.granary", "reserve_added"), c2h_ref("care_continuity_verified"), campaign_own("moran", "fever"), campaign_own("moran", "hungry")])
    if actor == "quer":
        refs = dvp_merge_refs(refs, [campaign_ref("case.contract", "gu_apologized"), campaign_own("ward", "restriction_withdrawn"), c2h_ref("outside_promise.quer")])
    if actor == "elena":
        refs = dvp_merge_refs(refs, [campaign_ref("case.astral", "abandoned_child_misunderstanding_resolved"), c2h_ref("outside_promise.elena")])
    if dv_has(["huo", "su", "moran", "gu"], actor):
        refs = dvp_merge_refs(refs, [campaign_own(actor, "hungry"), campaign_own(actor, "fever"), campaign_ref("c2.weather", "earthquake_recent"), campaign_ref("c2.meter", "safe")])
    return {"id": rt_cat("homecoming.", actor), "stance": stance, "context_refs": refs, "context_policy_keys": ["drive", "caution", "speaker_trust", "class_bias"], "request_topics": [], "basis": [c2h_source()]}

fn c2h_owner_utility(actor, action, consent):
    var direction = 1
    if not consent:
        direction = -1
    // Drive values preserving inquiry; caution values survival. The known
    // substantive requirements still gate consent before either is compared.
    let trust = dvs_speaker_trust(actor.policy, "detective")
    let basis = [c2h_source(), {"samples": dv_find(actor, "cognitive_samples", []), "policy_drive": dv_find(actor.policy, "drive", false), "policy_caution": dv_find(actor.policy, "caution", false), "speaker": "detective", "speaker_trust": trust, "speaker_trust_policy": dv_find(actor.policy, "speaker_trust", []), "class_bias": dv_find(actor.policy, "class_bias", []), "owned_inputs": dvs_owned_decision_inputs(actor, action.owned_decision, actor.mind).sources}]
    return {"requires": action.precondition, "basis": basis, "terms": [{"quantity": {"policy_key": "drive"}, "weight": -direction}, {"quantity": {"policy_key": "caution"}, "weight": direction}, {"quantity": {"speaker": "detective"}, "weight": direction}]}

// Call after c2d_refresh_actor_goals, which rebuilds the base goal list.
// Recompute navigation after adding these communication goals so another room
// is a real known-path movement opportunity rather than a local-only label.
fn c2h_refresh_actor(actor):
    var actions = actor.actions
    var goals = actor.policy.goals
    var i = 0
    while i < rt_count(actions):
        var action = actions[i]
        if dv_has_key(action, "owned_decision") and action.owned_decision.id == rt_cat("homecoming.", actor.id):
            action = dv_without(action, "personal_choice")
            action = dv_with(action, "owner_utility", c2h_owner_utility(actor, action, action.owned_decision.stance == "consent"))
            actions = dvs_replace(actions, i, action)
        if c2h_is_exile(action.id):
            var available = action.precondition
            if dv_has_key(action, "received_speech_requirement") and not c2_received_requirement(actor, action.received_speech_requirement):
                available = dv_not(dv_true())
            if not dvp_owned_decision_ready(actor, action, actor.mind):
                available = dv_not(dv_true())
            rt_push(goals, campaign_index_goal_window({"kind": "communicate", "scope": "personal", "method_id": action.id, "available_when": available, "basis": [c2h_source()], "requires_argument": false, "navigation_room": "central_hall"}))
        if dv_has(["detective.c2.homecoming.propose", rt_cat(actor.id, ".c2.homecoming.consent"), rt_cat(actor.id, ".c2.homecoming.defer")], action.id) and dv_find(actor.policy, "homecoming_negotiation", false):
            action = dv_with(action, "manual_only", false)
            actions = dvs_replace(actions, i, action)
            var available = action.precondition
            if dv_has_key(action, "received_speech_requirement") and not c2_received_requirement(actor, action.received_speech_requirement):
                available = dv_not(dv_true())
            if not dvp_owned_decision_ready(actor, action, actor.mind):
                available = dv_not(dv_true())
            rt_push(goals, campaign_index_goal_window({"kind": "communicate", "scope": "personal", "method_id": action.id, "available_when": available, "basis": [c2h_source()], "requires_argument": false, "navigation_room": "living_hall"}))
        i = i + 1
    if dv_has(campaign_people(), actor.id):
        var people = [actor.id]
        if actor.id == "ward":
            people = campaign_people()
        i = 0
        while i < rt_count(people):
            let person = people[i]
            var opened = dv_fact(c2h_ref("exile_motion_proposed"), true)
            if actor.id == "ward":
                opened = campaign_any(opened, dv_fact(c2h_person("ruan", "dead_stone_declared"), true))
            let ready = dv_all([campaign_at(actor.id, "central_hall"), campaign_at(person, "central_hall"), opened])
            let refs = [campaign_own(person, "alive"), campaign_own(person, "stone_stupor"), campaign_own(person, "in_coma"), c2h_person(person, "exile_stance")]
            var r = 0
            while r < rt_count(refs):
                rt_push(goals, dv_with(campaign_observation_goal(refs[r], ready, [c2h_source()], 0), "navigation_room", "central_hall"))
                r = r + 1
            i = i + 1
    var substantive = []
    i = 0
    while i < rt_count(goals):
        if not dv_has_key(goals[i], "navigation_intention"):
            rt_push(substantive, goals[i])
        i = i + 1
    let view = dv_with_many(actor, {"actions": actions, "policy": dv_with(actor.policy, "goals", substantive)})
    return dv_with(view, "policy", dv_with(view.policy, "goals", c2_navigation_goals(view, substantive)))

fn c2h_guardian_balance(physical):
    let groups = [["shen", "mora", "huo", "quer", "bertrand", "margaret"], ["ruan", "ward", "veronica"]]
    var counts = []
    var ballots = []
    var group = 0
    while group < rt_count(groups):
        var present = 0
        var i = 0
        while i < rt_count(groups[group]):
            let actor = groups[group][i]
            let eligible = dv_truth(physical, c2h_present(actor))
            if eligible == "true":
                present = present + 1
            rt_push(ballots, {"actor": actor, "present_capable": eligible, "stance": dv_read(physical, c2h_person(actor, "exile_stance"))})
            i = i + 1
        rt_push(counts, present)
        group = group + 1
    var all_ballots = []
    let people = campaign_people()
    var i = 0
    while i < rt_count(people):
        let actor = people[i]
        rt_push(all_ballots, {"actor": actor, "present_capable": dv_truth(physical, c2h_present(actor)), "alive": dv_read(physical, campaign_own(actor, "alive")), "permanently_disabled": dv_read(physical, campaign_own(actor, "stone_stupor")), "stance": dv_read(physical, c2h_person(actor, "exile_stance")), "consent_execution": dv_read(physical, c2d_mark(actor, rt_cat(actor, ".c2.exile.consent"))), "reject_execution": dv_read(physical, c2d_mark(actor, rt_cat(actor, ".c2.exile.reject")))})
        i = i + 1
    return {"guardians_present_capable": counts[0], "calculators_present_capable": counts[1], "background_gate": dv_truth(physical, c2h_balance_condition()), "group_members": ballots, "ballots": all_ballots, "unanimous_decision_eligible": dv_truth(physical, c2h_motion_passed_condition()), "motion_proposed": dv_read(physical, c2h_ref("exile_motion_proposed")), "motion_passed": dv_read(physical, c2h_ref("exile_motion_passed")), "ration_deprivation_decided": dv_read(physical, c2h_ref("ration_deprivation_decided")), "exile_execution": "not-implemented"}

// These are event-grounded literary candidates, not personal cognitive imprints.
// The caller has no actor contact history, so no recipient or sealing is asserted.
fn c2h_trauma_imprints(physical):
    var imprints = []
    let rows = [
        {"ref": campaign_ref("c2.casualty", "moran_dead"), "id": "imprint_avoid_doors", "description": "对死亡留下的恐惧"},
        {"ref": campaign_ref("c2.casualty", "bertrand_stupor"), "id": "imprint_empty_chair_stone", "description": "对石雕般失能留下的创伤"},
        {"ref": campaign_ref("c2.weather", "earthquake_recent"), "id": "imprint_wind_flinch", "description": "对地震留下的惊惧"},
        {"ref": campaign_own("detective", "hungry"), "id": "imprint_empty_plate_tears", "description": "对饥饿留下的恐惧"}]
    var i = 0
    while i < rt_count(rows):
        let st = dv_read(physical, rows[i].ref)
        if dv_uncontested(st) and st.value == true:
            rt_push(imprints, {"id": rows[i].id, "description": rows[i].description, "basis": {"ref": rows[i].ref, "state": st}, "status": "event-grounded-candidate-contact-unverified"})
        i = i + 1
    return imprints

fn c2h_summary(physical):
    var others = []
    var unanimous = true
    let people = campaign_people()
    var i = 0
    while i < rt_count(people):
        let id = people[i]
        if id != "detective":
            let alive = dv_read(physical, campaign_own(id, "alive"))
            let willing = dv_read(physical, c2h_person(id, "consent_detective"))
            rt_push(others, {"actor": id, "alive": alive, "consent_detective": willing, "stance": dv_read(physical, c2h_person(id, "stance"))})
            if not dv_uncontested(alive) or (alive.value == true and (not dv_uncontested(willing) or willing.value != true)):
                unanimous = false
        i = i + 1
    let balance = c2h_guardian_balance(physical)
    return {"scope": "negotiation-only", "proposed": dv_read(physical, c2h_ref("proposed")), "own_willing": dv_read(physical, c2h_person("detective", "willing")), "others": others, "all_other_living_consent": unanimous, "safety_verification": dv_read(physical, c2h_ref("safety_verified")), "seed_specific_homecoming_utility": "declared-shared-owner-utility", "departure": dv_read(physical, c2h_ref("departed")), "guardian_balance": balance, "trauma_imprints": c2h_trauma_imprints(physical)}
