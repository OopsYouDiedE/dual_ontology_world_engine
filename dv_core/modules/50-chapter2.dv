    rt_push(rows, c2daily_after(c2daily_say("huo", "huo.c2.truss", "living_hall", ding, "说明接头与承重检查", "先查接头，再看承重。光看外形漂亮，顶不住用。", ["margaret"]), "margaret", "margaret.c2.arch"))
    let lesson = campaign_window(2, 600, 690)
