fn c2_install_actor_laws(world, actor):
    var owned_adoptions = dv_clone(world.adoptions)
    var mode = "enforce"
    if world.domain == "mind":
        mode = "predict"
    c2_install_actor_laws_into(world.domain, owned_adoptions, actor, mode)
    return dv_finish_owned_adoptions(world, owned_adoptions)

fn c2_extend_world(world):
    var result = c2_world_objects(world)
    var owned_adoptions = dv_clone(result.adoptions)
    let domain = result.domain
    dv_adopt_into(domain, owned_adoptions, campaign_method("c2.weather.first_wind", c2_first_wind_law()), "enforce", 1, [campaign_approved("second-day-morning-wind")])
    let changes = c2_weather_changes()
    var change_index = 0
    while change_index < rt_count(changes):
        let id = rt_cat("c2.weather.", changes[change_index].id)
        dv_adopt_into(domain, owned_adoptions, campaign_method(id, c2_weather_change_law(changes[change_index])), "enforce", 1, [campaign_approved("第五部分：五日环境变化")])
        change_index = change_index + 1
    c2_install_teacher_laws_into(domain, owned_adoptions, "enforce")
    dv_adopt_into(domain, owned_adoptions, campaign_method("c2.meter.safe", c2i_meter_safe_law()), "enforce", 1, [campaign_approved("current-instrument-qualitative-safe-reading")])
    dv_adopt_into(domain, owned_adoptions, campaign_method("c2.meter.stale", c2i_meter_stale_law()), "enforce", 1, [campaign_approved("quake-invalidates-prior-reading")])
    var light_day = 1
    while light_day < 6:
        dv_adopt_into(domain, owned_adoptions, campaign_method(rt_cat("c2.daylight.", rt_show(light_day)), c2_daylight_law(light_day, true)), "enforce", 1, [c2_source("00_时间与文案.story", 35, "明示昼夜时段边界")])
        dv_adopt_into(domain, owned_adoptions, campaign_method(rt_cat("c2.nightlight.", rt_show(light_day)), c2_daylight_law(light_day, false)), "enforce", 1, [c2_source("00_时间与文案.story", 35, "明示昼夜时段边界")])
        light_day = light_day + 1
    let people = campaign_people()
    var i = 0
    while i < rt_count(people):
        c2_install_actor_laws_into(domain, owned_adoptions, people[i], "enforce")
        dv_adopt_into(domain, owned_adoptions, campaign_method(rt_cat("c2.outdoor-danger.", people[i]), c2i_outdoor_danger_law(people[i])), "enforce", 1, [campaign_approved("actual-quake-air-exposure-engineering-dose")])
        let physiology = [{"id": "weakness", "law": c2_disease_weakness_law(people[i])}, {"id": "impairment", "law": c2_disease_impairment_law(people[i])}, {"id": "respiratory-failure", "law": c2_respiratory_failure_law(people[i])}, {"id": "respiratory-terminal", "law": c2_respiratory_terminal_law(people[i])}]
        var pathology = 0
        while pathology < rt_count(physiology):
            dv_adopt_into(domain, owned_adoptions, campaign_method(rt_cat("c2.physiology.", rt_cat(people[i], rt_cat(".", physiology[pathology].id))), physiology[pathology].law), "enforce", 1, [campaign_approved("user:2026-10-22-continuous-disease-and-effective-care")])
            pathology = pathology + 1
        var day = 2
        while day <= 5:
            let noon = rt_cat("c2.hunger.", rt_cat(people[i], rt_cat(".", rt_cat(rt_show(day), ".noon"))))
            let evening = rt_cat("c2.hunger.", rt_cat(people[i], rt_cat(".", rt_cat(rt_show(day), ".evening"))))
            dv_adopt_into(domain, owned_adoptions, campaign_method(noon, c2_missed_meal_law(people[i], day, "noon", 840)), "enforce", 1, [campaign_approved("hunger-follows-actual-missed-meal")])
            dv_adopt_into(domain, owned_adoptions, campaign_method(evening, c2_missed_meal_law(people[i], day, "evening", 1260)), "enforce", 1, [campaign_approved("hunger-follows-actual-missed-meal")])
            day = day + 1
        dv_adopt_into(domain, owned_adoptions, campaign_method(rt_cat("c2.terminal.", people[i]), c2_terminal_exposure_law(people[i])), "enforce", 1, [campaign_approved("actual-terminal-exposure")])
        i = i + 1
    dv_adopt_into(domain, owned_adoptions, campaign_method("c2.moran.acute_collapse", c2_moran_acute_collapse_law()), "enforce", 1, [c2_source("docs/design-standard.md", 0, "莫兰吸入微粒急性休克")])
    dv_adopt_into(domain, owned_adoptions, campaign_method("c2.moran.fatal_settle", c2_moran_fatal_settle_law()), "enforce", 1, [c2_source("docs/design-standard.md", 0, "莫兰次晨无药身亡结算")])
    dv_adopt_into(domain, owned_adoptions, campaign_method("c2.bertrand.petrification_settle", c2_bertrand_petrification_settle_law()), "enforce", 1, [c2_source("docs/design-standard.md", 0, "贝尔特朗次晨无药木僵石雕结算")])
    return dv_finish_owned_adoptions(result, owned_adoptions)

fn c2_shared_objects():
    var result = ["campaign.clock", "campaign.access", "c2.corridor.north", "c2.corridor.east", "c2.meter", "demon.body", "case.contract", "case.astral", "case.logistics", "c2.granary", "c2.counter", "c2.ledger", "c2.bowl", "c2.kitchen", "c2.weather", "c2.litter.living", "c2.litter.contract", "c2.litter.astral", "c2.litter.logistics", "c2.casualty", "c2.trial", "c2.ascension", "c2.duty", "c2.demon", "c2.clinic", "c2.seal"]
    let norms = c2_norms()
    var i = 0
    while i < rt_count(norms):
        rt_push(result, c2_norm_object(norms[i].id))
        i = i + 1
    let people = campaign_people()
    i = 0
    while i < rt_count(people):
        rt_push(result, campaign_body(people[i]))
        i = i + 1
    return result

// A declared work location is an intention, not a prediction of its result.
// Choose one location for all owned opportunities, including daily work and
// communication, rather than granting simultaneous competing arrival rewards.
fn c2_navigation_condition(condition, actor):
    let op = dv_find(condition, "op", "")
    if op == "equals" and dv_same_local_ref(actor, condition.ref, campaign_position_ref(actor)):
        return dv_true()
    if op == "all":
        var items = []
        var i = 0
        while i < rt_count(condition.items):
            rt_push(items, c2_navigation_condition(condition.items[i], actor))
            i = i + 1
        return dv_all(items)
    return condition

fn c2_navigation_pending(actor, goal):
    if dv_find(goal, "kind", "") == "evidence":
        return not dvp_source_supported_since(dv_read(actor.mind, goal.ref), dv_find(goal, "source", "perception"), dv_find(goal, "minimum_time", 0))
    return campaign_future_goal_pending(actor, goal)

fn c2_navigation_local_ready(actor, goal):
    var methods = dv_find(goal, "navigation_methods", [])
    if dv_has_key(goal, "method_id"):
        methods = dv_append(methods, goal.method_id)
    let relevant = dvp_goal_refs(actor)
    var i = 0
    while i < rt_count(methods):
        let action = dvp_find_action(actor.actions, methods[i])
        if action != false and action.kind != "move" and dvp_eligible(actor, action, actor.mind, relevant):
            return true
        i = i + 1
    return false

fn c2_navigation_goals(actor, goals):
    if c2i_closing_navigation(actor) != false:
        return goals
    // An active, already reached presence intention does not earn another
    // unrelated arrival reward. Substantive actions still enter shared choice.
    var held = 0
    var maintained_route = false
    while held < rt_count(goals):
        let goal = goals[held]
        if dv_find(goal, "maintain_presence", false) and 0 < rt_count(dv_find(goal, "basis", [])):
            if dv_truth(actor.mind, dv_find(goal, "available_when", dv_true())) == "true":
                if dv_truth(actor.mind, goal.proposition) == "true":
                    return goals
                let room = dv_find(goal, "navigation_room", "")
                if room != "" and maintained_route == false:
                    let route = c2_navigation_route(actor, room)
                    if route != false:
                        maintained_route = {"goal": goal, "route": route}
        held = held + 1
    if maintained_route != false:
        let route = maintained_route.route
        let goal = maintained_route.goal
        let intended = campaign_goal(campaign_at(actor.id, route.next), dv_all([dv_find(goal, "available_when", dv_true()), campaign_at(actor.id, route.origin)]), dv_append(goal.basis, route))
        return dv_append(goals, dv_with(intended, "navigation_intention", {"target": route.target, "next": route.next, "scope": "maintained-known-route-not-task-completion"}))
    // Unmet work prerequisites do not create independent arrival value.
    // A declared evidence goal can still motivate a real on-site inspection.
    var first = false
    var i = 0
    while i < rt_count(goals):
        let goal = goals[i]
        let room = dv_find(goal, "navigation_room", "")
        let basis = dv_find(goal, "basis", [])
        let condition = dv_find(goal, "available_when", dv_true())
        var when = false
        if dv_find(actor.policy, "opt_plancache", false):
            let key = ["navigation-condition-v1", actor.id]
            let cached = rt_memo_get(condition, key)
            if cached[0]:
                when = cached[1]
            else:
                when = rt_memo_put(condition, key, c2_navigation_condition(condition, actor.id))
        else:
            when = c2_navigation_condition(condition, actor.id)
        if room != "" and 0 < rt_count(basis) and c2_navigation_pending(actor, goal) and dv_truth(actor.mind, when) == "true":
            let ready = dv_truth(actor.mind, dv_all(dv_find(goal, "navigation_requirements", []))) == "true"
            if dv_truth(actor.mind, campaign_at(actor.id, room)) == "true":
                if ready and c2_navigation_local_ready(actor, goal):
                    // Local substantive work keeps priority over another trip.
                    return goals
            elif ready:
                let route = c2_navigation_route(actor, room)
                if route != false:
                    let candidate = {"goal": goal, "route": route, "when": when}
                    if first == false:
                        first = candidate
        i = i + 1
    if first != false:
        let route = first.route
        let basis = dv_append(first.goal.basis, route)
        let intended = campaign_goal(campaign_at(actor.id, route.next), dv_all([first.when, campaign_at(actor.id, route.origin)]), basis)
        return dv_append(goals, dv_with(intended, "navigation_intention", {"target": route.target, "next": route.next, "scope": "known-route-only-not-task-completion"}))
    return goals

// A closed downstream gate does not prevent approaching its safe-side origin.
// The returned prefix contains only owned, known-open movement laws. Searching
// the declared map beyond that gate never grants access or assumes it can open.
fn c2_navigation_route(actor, target):
    if not dv_find(actor.policy, "opt_plancache", false):
        return c2_navigation_route_uncached(actor, target)
    actor = rt_snapshot(actor)
    let key = ["c2_navigation_route-complete-knowledge-v1", actor.id, actor.mind.revision, actor.mind.time, dv_find(actor, "location", ""), actor.policy, target]
    let cached = rt_memo_get(actor.mind, key)
    if cached[0]:
        return cached[1]
    return rt_memo_put(actor.mind, key, c2_navigation_route_uncached(actor, target))

fn c2_navigation_route_uncached(actor, target):
    let direct = c2i_known_route(actor, target)
    if direct != false:
        return direct
    let position = dv_read(actor.mind, campaign_position_ref(actor.id))
    if not dv_uncontested(position) or position.value == target:
        return false
    var queue = [{"room": position.value, "first": "", "prefix_end": position.value, "blocked": false, "basis": []}]
    var visited = [position.value]
    var cursor = 0
    let edges = c2_edges()
    while cursor < rt_count(queue):
        let node = queue[cursor]
        var i = 0
        while i < rt_count(edges):
            let edge = edges[i]
            var destination = ""
            if edge.from == node.room:
                destination = edge.to
            if edge.to == node.room:
                destination = edge.from
            if destination != "" and not dv_has(visited, destination):
                var action = c2_move_action(actor.id, node.room, destination, edge.gate)
                if actor.id == "bertrand" and dv_truth(actor.mind, dv_fact(campaign_own("bertrand", "carrying"), "moran")) == "true":
                    action = c2_carry_moran_action(node.room, destination, edge.gate)
                let adoption = dv_find(actor.mind.adoptions, action.predict_law, false)
                if adoption != false and adoption.active and adoption.mode == "predict":
                    var next = dv_with(node, "room", destination)
                    if not node.blocked:
                        if dv_truth(actor.mind, dv_fact(campaign_access(edge.gate), true)) == "true":
                            var first = node.first
                            if first == "":
                                first = destination
                            next = dv_with_many(next, {"first": first, "prefix_end": destination, "basis": dv_append(node.basis, {"method": action.id, "adoption_basis": adoption.basis, "gate": campaign_access(edge.gate), "gate_cell": dv_read(actor.mind, campaign_access(edge.gate))})})
                        else:
                            next = dv_with(next, "blocked", true)
                    if destination == target and next.first != "":
                        return {"origin": position.value, "next": next.first, "target": next.prefix_end, "requested_target": target, "path_basis": next.basis, "scope": "known-open-prefix-before-unverified-gate"}
                    rt_push(queue, next)
                    rt_push(visited, destination)
            i = i + 1
        cursor = cursor + 1
    return false

// A route inspection concerns a door at the owner's current known location.
fn c2_gate_visible(actor, gate):
    let edges = c2_edges()
    var locations = []
    var i = 0
    while i < rt_count(edges):
        if edges[i].gate == gate:
            rt_push(locations, campaign_at(actor, edges[i].from))
            rt_push(locations, campaign_at(actor, edges[i].to))
        i = i + 1
    return dv_not(dv_all(c2_negated_conditions(locations)))

fn c2_negated_conditions(conditions):
    var result = []
    var i = 0
    while i < rt_count(conditions):
        rt_push(result, dv_not(conditions[i]))
        i = i + 1
    return result

fn c2_personal_goal_templates_build(id):
    let source = [campaign_person_source(id)]
    var goals = [campaign_observation_goal(campaign_clock(), dv_true(), [campaign_approved("actual-clock-observation-before-time-sensitive-actions")], 0)]
    // Fixed, owned observation windows do not assume what the weather will be.
    // Rechecking at a new day/evening is distinct from refreshing on each clock tick.
    let weather_fields = ["wind", "daylight", "earthquake_recent", "environment_epoch"]
    var weather_day = 2
    while weather_day <= 5:
        let boundaries = [480, 1260]
        var phase = 0
        while phase < rt_count(boundaries):
            let start = boundaries[phase]
            var end = 1260
            if start == 1260:
                end = 1440
            var field_index = 0
            while field_index < rt_count(weather_fields):
                rt_push(goals, campaign_observation_goal(campaign_ref("c2.weather", weather_fields[field_index]), campaign_window(weather_day, start, end), [campaign_approved("owned-daily-environment-observation-opportunity")], (weather_day - 1) * 1440 + start))
                field_index = field_index + 1
            phase = phase + 1
        weather_day = weather_day + 1
    var quake_field = 0
    while quake_field < rt_count(weather_fields):
        rt_push(goals, campaign_observation_goal(campaign_ref("c2.weather", weather_fields[quake_field]), campaign_window(4, 1050, 1260), [campaign_approved("owned-evening-safety-observation-not-predicted-quake")], 5370))
        quake_field = quake_field + 1
    // user:2026-10-18章末授权：观察真实收束，不预置签署结果。
    rt_push(goals, campaign_observation_goal(campaign_ref("c2.daily", "council_closed"), dv_at_least(campaign_clock(), 6330), [campaign_approved("user:2026-10-18章末授权")], 6330))
    rt_push(goals, campaign_observation_goal(campaign_ref("c2.daily", "council_ended"), dv_fact(campaign_ref("c2.daily", "council_closed"), true), [campaign_approved("user:2026-10-18章末授权")], 0))
    rt_push(goals, campaign_observation_goal(campaign_ref("c2.daily", "underground_tremor"), dv_fact(campaign_ref("c2.daily", "council_closed"), true), [campaign_approved("user:2026-10-18章末授权")], 6330))
    rt_push(goals, campaign_observation_goal(campaign_clock(), dv_at_least(campaign_clock(), 7200), [campaign_approved("day5-evening-rest-until-horizon")], 7200))
    var gates = ["living", "north", "east"]
    if id == "quer":
        rt_push(goals, dv_with_many(campaign_observation_goal(campaign_clock(), campaign_at(id, "living_hall"), [campaign_approved("actual-clock-observation-before-time-sensitive-actions")], 1980), {"refresh_until": dv_at_least(campaign_clock(), 1980), "refresh_refs": [campaign_position_ref("margaret"), campaign_position_ref("mora")]}))
    var gate_index = 0
    while gate_index < rt_count(gates):
        rt_push(goals, dv_with(campaign_observation_goal(campaign_access(gates[gate_index]), c2_gate_visible(id, gates[gate_index]), [c2_source("00_通行.story", 9, "复查眼前通路")], 0), "refresh_until", dv_fact(campaign_access(gates[gate_index]), true)))
        gate_index = gate_index + 1
    if id == "quer":
        rt_push(goals, campaign_observation_goal(campaign_ref("c2.weather", "daylight"), dv_all([campaign_at(id, "living_hall"), dv_at_least(campaign_clock(), 1980)]), [c2_source("00_时间与文案.story", 35, "看天色辨昼夜")], 1980))
        rt_push(goals, campaign_observation_goal(campaign_ref("c2.weather", "wind"), dv_all([campaign_at(id, "living_hall"), dv_at_least(campaign_clock(), 1980)]), [campaign_approved("visible-current-wind")], 1980))
        rt_push(goals, campaign_observation_goal(campaign_ref("c2.weather", "severe_air"), dv_all([campaign_at(id, "living_hall"), dv_at_least(campaign_clock(), 1980)]), [campaign_approved("visible-current-air")], 1980))
    if id == "demon":
        rt_push(goals, dv_with_many(campaign_observation_goal(campaign_clock(), dv_true(), [campaign_approved("actual-clock-observation-before-time-sensitive-actions")], 1980), {"refresh_until": dv_at_least(campaign_clock(), 1980)}))
        rt_push(goals, campaign_observation_goal(campaign_position_ref(id), dv_true(), [c2_source("06_场面.story", 85, "自己的现场身体位置")], 0))
        rt_push(goals, dv_with(campaign_observation_goal(campaign_access("north"), c2_gate_visible(id, "north"), [c2_source("00_通行.story", 9, "复查眼前通路")], 0), "refresh_until", dv_fact(campaign_access("north"), true)))
        rt_push(goals, dv_with(campaign_observation_goal(campaign_access("east"), c2_gate_visible(id, "east"), [c2_source("00_通行.story", 9, "复查眼前通路")], 0), "refresh_until", dv_fact(campaign_access("east"), true)))
        return goals
    if dv_has(["detective", "huo", "shen", "su"], id):
        let door_fields = ["outer_released", "inner_down", "open"]
        var door_index = 0
        while door_index < rt_count(door_fields):
            rt_push(goals, campaign_observation_goal(campaign_ref("departure.door", door_fields[door_index]), campaign_at(id, "foyer"), [campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/08_终局.story", 4, "当前隔离门")], 0))
            door_index = door_index + 1
    if dv_has(["quer", "shen", "huo", "margaret", "bertrand"], id):
        let indoor_gates = ["north", "east"]
        var corridor_index = 0
        while corridor_index < rt_count(indoor_gates):
            let gate = indoor_gates[corridor_index]
            rt_push(goals, dv_with_many(campaign_observation_goal(campaign_ref("c2.weather", "severe_air"), dv_all([campaign_at(id, c2_corridor_origin(gate)), dv_at_least(campaign_clock(), 1980)]), [campaign_approved("current-intake-safety-before-corridor-work")], 1980), {"refresh_until": dv_fact(campaign_ref(rt_cat("c2.corridor.", gate), "ventilated"), true), "refresh_refs": [campaign_ref(rt_cat("c2.corridor.", gate), "intake_safe"), campaign_ref(rt_cat("c2.corridor.", gate), "seal_intact")]}))
            rt_push(goals, campaign_observation_goal(campaign_ref(rt_cat("c2.corridor.", gate), "ventilated"), dv_all([campaign_at(id, c2_corridor_origin(gate)), dv_at_least(campaign_clock(), 1980)]), [campaign_approved("现场核对封闭连廊")], 1980))
            rt_push(goals, campaign_goal(dv_fact(campaign_ref(rt_cat("c2.corridor.", gate), "ventilated"), true), dv_all([campaign_at(id, c2_corridor_origin(gate)), dv_at_least(campaign_clock(), 1980)]), [campaign_approved("经核对后实际换气")]))
            rt_push(goals, campaign_goal(dv_fact(campaign_access(gate), true), dv_all([campaign_at(id, c2_corridor_origin(gate)), dv_at_least(campaign_clock(), 1980)]), [campaign_approved("经核对后实际开启连廊")]))
            corridor_index = corridor_index + 1
    let norms = c2_norms()
    var i = 0
    while i < rt_count(norms):
        let norm = norms[i]
        if norm.owner == id and norm.id != "measurement_pause":
            rt_push(goals, dv_with_many(campaign_goal(dv_fact(campaign_ref(c2_norm_object(norm.id), "posted"), true), dv_at_least(campaign_clock(), 2250), [norm.source]), {"navigation_room": norm.board, "navigation_requirements": [c2_norm_available(norm)], "navigation_methods": [rt_cat(id, rt_cat(".c2.propose.", norm.id)), rt_cat(id, rt_cat(".c2.post.", norm.id))]}))
        rt_push(goals, campaign_observation_goal(campaign_ref(c2_norm_object(norm.id), "posted"), dv_all([campaign_at(id, norm.board), dv_at_least(campaign_clock(), 2250)]), [norm.source], 0))
        rt_push(goals, campaign_observation_goal(campaign_ref(c2_norm_object(norm.id), "text"), dv_fact(campaign_ref(c2_norm_object(norm.id), "posted"), true), [norm.source], 0))
        rt_push(goals, campaign_goal(dv_fact(campaign_own(id, rt_cat("decided.", norm.id)), true), dv_fact(campaign_ref(c2_norm_object(norm.id), "text"), norm.surface), [norm.source]))
        i = i + 1
    var day = 2
    while day <= 5:
        let meals = [{"id": "noon", "start": 720, "end": 840}, {"id": "evening", "start": 1080, "end": 1260}]
        i = 0
        while i < rt_count(meals):
            let meal = meals[i]
            let flag = rt_cat("eaten.", rt_cat(rt_show(day), rt_cat(".", meal.id)))
            var meal_room = "logistics"
            if day == 2 and meal.id == "noon":
                meal_room = "living_hall"
            var meal_ready = campaign_any(dv_at_least(campaign_own(id, "rations"), 1), dv_fact(campaign_ref("c2.counter", "open"), true))
            if meal_room == "living_hall":
                meal_ready = campaign_any(dv_at_least(campaign_own(id, "rations"), 1), dv_fact(c2daily_ref("meal_prepared"), true))
            let suffix = rt_cat(rt_show(day), rt_cat(".", meal.id))
            var meal_methods = [rt_cat(id, rt_cat(".c2.collect.", suffix)), rt_cat(id, rt_cat(".c2.eat.", suffix))]
            if meal_room == "living_hall":
                rt_push(meal_methods, rt_cat(id, ".c2.daily.serve"))
            rt_push(goals, dv_with_many(campaign_goal(dv_fact(campaign_own(id, flag), true), campaign_window(day, meal.start, meal.end), source), {"navigation_room": meal_room, "navigation_requirements": [meal_ready], "navigation_methods": meal_methods}))
            i = i + 1
        day = day + 1
    rt_push(goals, campaign_goal(dv_fact(campaign_own(id, "hungry"), false), dv_fact(campaign_own(id, "hungry"), true), source))
    rt_push(goals, campaign_goal(dv_fact(campaign_own(id, "day5_concluded"), true), dv_at_least(campaign_clock(), 7200), source))
    if campaign_profile(id).domain == "resources":
        rt_push(goals, campaign_observation_goal(campaign_ref("c2.counter", "remaining"), campaign_at(id, "logistics"), source, 0))
        rt_push(goals, campaign_observation_goal(campaign_ref("c2.ledger", "counted"), campaign_at(id, "logistics"), source, 0))
        var service_day = 2
        while service_day <= 5:
            let active = campaign_any(campaign_window(service_day, 720, 840), campaign_window(service_day, 1080, 1260))
            rt_push(goals, dv_with_many(campaign_goal(dv_fact(campaign_ref("c2.counter", "open"), true), active, [campaign_approved("real-counter-service-does-not-require-total-granary-key")]), {"navigation_room": "logistics", "navigation_requirements": [dv_fact(campaign_ref("c2.ledger", "counted"), 99)], "navigation_methods": [rt_cat(id, ".c2.distribute")]}))
            service_day = service_day + 1
    rt_push(goals, dv_with_many(campaign_goal(dv_fact(campaign_own(id, "owe_notes"), 0), dv_all(dv_pair(dv_at_least(campaign_own(id, "owe_notes"), 1), dv_fact(campaign_own(id, "busy_care"), false))), [c2_source("10_执行.story", 9, "Inform")]), {"navigation_room": "logistics", "navigation_methods": [rt_cat(id, ".c2.report.night_take"), rt_cat(id, ".c2.report.pending"), rt_cat(id, ".c2.report.pending.patient")]}))
    if id == "ruan" or id == "ward":
        var record_day = 2
        while record_day <= 5:
            let periods = [{"start": 720, "end": 840}, {"start": 1080, "end": 1260}]
            var period_index = 0
            while period_index < rt_count(periods):
                let period = periods[period_index]
                let available = dv_all([campaign_at(id, "logistics"), campaign_window(record_day, period.start, period.end)])
                rt_push(goals, campaign_observation_goal(campaign_ref("c2.ledger", "pending_registered"), available, [campaign_approved("owned-records-duty-actual-pending-inspection")], (record_day - 1) * 1440 + period.start))
                period_index = period_index + 1
            record_day = record_day + 1
    if id == "huo" or id == "margaret":
        rt_push(goals, campaign_observation_goal(campaign_ref("c2.granary", "structure_checked"), campaign_at(id, "logistics"), source, 0))
        rt_push(goals, campaign_goal(dv_fact(campaign_ref("c2.granary", "structure_checked"), true), campaign_at(id, "logistics"), source))
    if id == "mora":
        let patients = c2_care_patients()
        var patient_index = 0
        while patient_index < rt_count(patients):
            let patient = patients[patient_index]
            let need = campaign_any(dv_fact(campaign_own(patient, "active_erosion_disease"), true), campaign_any(dv_fact(campaign_own(patient, "in_coma"), true), campaign_any(dv_fact(campaign_own(patient, "fever"), true), dv_fact(campaign_own(patient, "rescue_exposed"), true))))
            rt_push(goals, campaign_goal(dv_fact(campaign_own(patient, "anti_erosion_treated"), true), dv_all([need, dv_fact(campaign_ref("case.logistics", "anti_erosion_mixed"), true)]), source))
            patient_index = patient_index + 1
        rt_push(goals, campaign_goal(dv_fact(campaign_own("moran", "hungry"), false), dv_all([dv_fact(campaign_own("moran", "fever"), true), dv_fact(campaign_own("moran", "hungry"), true)]), [campaign_approved("mora-does-not-refuse-a-real-patient")]))
    if id == "detective":
        rt_push(goals, campaign_goal(dv_fact(campaign_ref("c2.duty", "rations_assisted"), true), campaign_at(id, "living_hall"), source))
        rt_push(goals, campaign_goal(dv_fact(campaign_ref("c2.duty", "prop_assisted"), true), campaign_at(id, "logistics"), source))
        rt_push(goals, campaign_goal(dv_fact(campaign_ref("c2.duty", "medicine_assisted"), true), campaign_at(id, "clinic"), source))
        rt_push(goals, campaign_goal(dv_fact(campaign_ref("c2.duty", "comforted"), true), campaign_at(id, "living_hall"), source))
    if id == "lucian":
        rt_push(goals, campaign_goal(dv_fact(campaign_ref("c2.corridor.north", "airlock_held"), true), c2_night(4), source))
    if id == "quer":
        rt_push(goals, campaign_goal(dv_fact(campaign_ref("c2.granary", "water_valve_repaired"), true), c2_night(3), source))
    if id == "shen" or id == "huo":
        rt_push(goals, campaign_goal(dv_fact(campaign_ref("c2.granary", "pulley_braced"), true), c2_night(4), source))
    if id == "margaret":
        rt_push(goals, campaign_goal(dv_fact(campaign_ref("c2.granary", "timber_braced"), true), c2_night(4), source))
    if id == "moran":
        let sketch_ready = dv_all([c2_night(4), dv_fact(campaign_ref("case.astral", "evening_choice"), "go")])
        rt_push(goals, dv_with_many(campaign_goal(dv_fact(campaign_own(id, "evening_sketch_completed"), true), sketch_ready, source), {"navigation_completion": dv_fact(campaign_own(id, "evening_sketch_completed"), true), "navigation_room": "outdoor_alley", "navigation_requirements": [sketch_ready], "navigation_methods": ["moran.c2.sketch.outdoor_night"]}))
    if id == "bertrand":
        rt_push(goals, campaign_goal(campaign_at("moran", "living_hall"), dv_all([c2_night(4), dv_fact(campaign_own("moran", "in_coma"), true)]), source))
        rt_push(goals, dv_with_many(campaign_goal(campaign_at(id, "outdoor_alley"), dv_all([c2_night(4), dv_fact(campaign_own("moran", "in_coma"), true), campaign_at("moran", "outdoor_alley"), dv_fact(campaign_own(id, "carrying"), "")]), source), {"navigation_completion": dv_fact(campaign_own(id, "rescue_exposed"), true), "navigation_room": "outdoor_alley", "navigation_requirements": [dv_fact(campaign_own("moran", "in_coma"), true), campaign_at("moran", "outdoor_alley")], "navigation_methods": ["bertrand.c2.rescue.moran_from_alley"]}))
        rt_push(goals, dv_with_many(campaign_goal(campaign_at(id, "living_hall"), dv_fact(campaign_own(id, "carrying"), "moran"), source), {"navigation_completion": campaign_at("moran", "living_hall"), "navigation_room": "living_hall", "navigation_requirements": [dv_fact(campaign_own(id, "carrying"), "moran")]}))
    return goals

// Cache only content-authored values; callers own a clone before appending.
fn c2_personal_goal_templates(id):
    let key = ["c2-personal-goal-templates-v1", id]
    let cached = rt_memo_get([], key)
    if cached[0]:
        return cached[1]
    return rt_memo_put([], key, c2_personal_goal_templates_build(id))

fn c2_personal_goals(actor):
    var goals = dv_clone(c2_personal_goal_templates(actor.id))
    // Refresh only by a real look at this board during the negotiation window.
    let board_when = dv_all([c2_night(4), campaign_at(actor.id, "living_hall")])
    rt_push(goals, campaign_observation_goal(campaign_ref(c2_norm_object("measurement_pause"), "posted"), board_when, [campaign_approved("user:2026-10-23-local-board-recheck-at-evening-meeting")], 5580))
    if actor.id == "demon":
        if c2_moran_outing_heard(actor):
            let relay = "demon.c2.relay.moran-outing.false"
            var pending = not dv_has(dv_find(actor, "completed_actions", []), relay)
            if c2_received_requirement(actor, {"speaker": "moran", "action_id": "moran.c2.sketch.evening.go.true"}):
                pending = not dv_has(dv_find(actor, "completed_actions", []), "demon.c2.relay.moran-outing.true")
            if pending:
                rt_push(goals, dv_with(campaign_goal(campaign_at(actor.id, "logistics"), c2_night(4), [campaign_approved("user:2026-10-23-real-heard-route-relay-not-remote-patient-facts")]), "navigation_room", "logistics"))
        return goals
    if actor.id == "detective":
        let scientific_choice = {"personal_choice": {"promotes": ["measured_work", "understand_cost"], "sacrifices": ["pursue_desire", "avoid_attachment"]}}
        if dvp_personal_motivation(actor, scientific_choice) > 0:
            let when = campaign_window(4, 1050, 1260)
            rt_push(goals, dv_with_many(campaign_observation_goal(campaign_ref("c2.weather", "environment_epoch"), when, [campaign_approved("user:2026-10-23-owner-empirical-evening-inquiry")], 5370), {"navigation_room": "living_hall", "navigation_methods": ["detective.c2.inspect.weather"]}))
            let object = c2_norm_object("measurement_pause")
            let ready = dv_all([when, campaign_any(dv_fact(campaign_ref("c2.weather", "wind"), false), dv_fact(campaign_ref("c2.weather", "earthquake_recent"), true))])
            rt_push(goals, dv_with_many(campaign_goal(dv_fact(campaign_ref(object, "posted"), true), ready, [campaign_approved("user:2026-10-23-real-negotiated-measurement-pause")]), {"navigation_room": "living_hall", "navigation_methods": ["detective.c2.propose.measurement_pause", "detective.c2.post.measurement_pause"]}))
    let investigations = c2i_goals(actor)
    var investigation_index = 0
    while investigation_index < rt_count(investigations):
        rt_push(goals, investigations[investigation_index])
        investigation_index = investigation_index + 1
    let safety = c2_safety_goals(actor)
    investigation_index = 0
    while investigation_index < rt_count(safety):
        rt_push(goals, safety[investigation_index])
        investigation_index = investigation_index + 1
    return goals

fn c2_refresh_actor_goals(actor):
    var goals = c2_personal_goals(actor)
    let carried = dv_find(actor.policy, "chapter1_carried_goals", [])
    var i = 0
    while i < rt_count(carried):
        rt_push(goals, carried[i])
        i = i + 1
    return dv_with(actor, "policy", dv_with(actor.policy, "goals", goals))

fn c2_install_teacher_laws_into(domain, owned_adoptions, mode):
    let edges = c2_edges()
    var i = 0
    while i < rt_count(edges):
        let edge = edges[i]
        let there = c2_move_action("demon", edge.from, edge.to, edge.gate)
        let back = c2_move_action("demon", edge.to, edge.from, edge.gate)
        dv_adopt_into(domain, owned_adoptions, campaign_method(there.id, c2_move_law("demon", edge.from, edge.to, edge.gate)), mode, 1, [c2_source("06_场面.story", 85, "讲堂中的授课者")])
        dv_adopt_into(domain, owned_adoptions, campaign_method(back.id, c2_move_law("demon", edge.to, edge.from, edge.gate)), mode, 1, [c2_source("06_场面.story", 85, "讲堂中的授课者")])
        i = i + 1
    return true

fn c2_install_teacher_laws(world):
    var owned_adoptions = dv_clone(world.adoptions)
    var mode = "enforce"
    if world.domain == "mind":
        mode = "predict"
    c2_install_teacher_laws_into(world.domain, owned_adoptions, mode)
    return dv_finish_owned_adoptions(world, owned_adoptions)

fn c2_extend_teacher(actor):
    var mind = actor.mind
    let objects = c2_shared_objects()
    var i = 0
    while i < rt_count(objects):
        mind = campaign_add_new(mind, campaign_local_object(objects[i]))
        i = i + 1
    mind = c2_install_teacher_laws(mind)
    var actions = dv_clone(actor.actions)
    rt_push(actions, dv_with(campaign_surface_action("demon.c2.inspect.body-location", "inspect", dv_true(), dv_true(), "", dv_single(campaign_position_ref("demon")), "查看周围", "看了看周围。", c2_source("06_场面.story", 85, "身体位置由现场取得")), "repeatable", true))
    let routes = c2_route_inspections(actor.id)
    i = 0
    while i < rt_count(routes):
        rt_push(actions, routes[i])
        i = i + 1
    let edges = c2_edges()
    i = 0
    while i < rt_count(edges):
        rt_push(actions, c2_move_action(actor.id, edges[i].from, edges[i].to, edges[i].gate))
        rt_push(actions, c2_move_action(actor.id, edges[i].to, edges[i].from, edges[i].gate))
        i = i + 1
    let observations = c2_compact_observations(actor.id)
    i = 0
    while i < rt_count(observations):
        rt_push(actions, observations[i])
        i = i + 1
    let result = dv_with_many(actor, {"mind": mind, "location_ref": campaign_position_ref("demon"), "observable_presence_when": dv_fact(campaign_ref("demon.body", "manifested"), true), "actions": campaign_public_methods(actions), "policy": dv_with_many(actor.policy, {"budget": dv_max(dv_find(actor.policy, "budget", 0), 240), "wait_chunk_limit": 180, "chapter1_carried_goals": dv_find(actor.policy, "goals", []), "chapter2_profile": {"id": "demon", "domain": "teaching", "station_roles": [], "basis": [c2_source("09_表达.story", 605, "我想教")]}, "notice_co_presence": true, "visual_identity_when": dv_fact(campaign_ref("c2.weather", "daylight"), true)})})
    return c2_refresh_actor_goals(result)

fn c2_extend_actor(actor):
    return c2_extend_actor_from(actor, actor.mind, actor.mind)

fn c2_extend_actor_from(actor, physical, previous):
    if not dv_has(campaign_people(), actor.id):
        if actor.id == "demon":
            return c2_extend_teacher(actor)
        return actor
    var mind = actor.mind
    let objects = c2_shared_objects()
    var i = 0
    while i < rt_count(objects):
        if not dv_has_key(mind.objects, objects[i]):
            mind = dv_add_object(mind, campaign_local_object(objects[i]))
        i = i + 1
    // The owner can feel own inventory/unfinished decisions; no other body is copied.
    var own = []
    if not dv_has_key(previous.objects, campaign_body(actor.id)):
        own = dv_get(physical.objects, campaign_body(actor.id)).facets.state
    i = 0
    while i < rt_count(own):
        let field = own[i]
        if not dv_read(mind, campaign_own(actor.id, field[0])).known:
            mind = dv_store(mind, campaign_own(actor.id, field[0]), dv_with(field[1], "source", "perception"))
        i = i + 1
    // The owner knows this personal decision has not yet been made; this is
    // protocol state, not an observation of another person's future choice.
    if actor.id == "moran" and not dv_read(mind, campaign_ref("case.astral", "evening_choice")).known:
        mind = dv_store(mind, campaign_ref("case.astral", "evening_choice"), dv_with(dv_field(""), "basis", [campaign_approved("own-unperformed-evening-choice")]))
    // Own authorship is known before proposing; another person's proposal is not.
    let norms = c2_norms()
    i = 0
    while i < rt_count(norms):
        let norm = norms[i]
        if norm.owner == actor.id:
            let object = c2_norm_object(norm.id)
            if not dv_read(mind, campaign_ref(object, "owner")).known:
                mind = dv_store(mind, campaign_ref(object, "owner"), dv_with(dv_field(actor.id), "basis", [norm.source]))
            if not dv_read(mind, campaign_ref(object, "text")).known:
                mind = dv_store(mind, campaign_ref(object, "text"), dv_with(dv_field(norm.surface), "basis", [norm.source]))
            if not dv_has_key(previous.objects, object):
                if not dv_read(mind, campaign_ref(object, "proposed")).known:
                    mind = dv_store(mind, campaign_ref(object, "proposed"), dv_field(false))
                if not dv_read(mind, campaign_ref(object, "posted")).known:
                    mind = dv_store(mind, campaign_ref(object, "posted"), dv_field(false))
        i = i + 1
    mind = c2_install_actor_laws(mind, actor.id)
    let profile = campaign_profile(actor.id)
    let binding = {"topic": "chapter2", "heard_when": dv_true(), "completed_when": dv_not(dv_true()), "basis": profile.basis}
    var order = dv_clone(dv_find(actor.policy, "value_order", []))
    if dv_has(["ward", "lucian", "moran", "veronica", "ruan"], actor.id):
        order = c2m_concat(profile.value_order, [for value in order if not dv_has(profile.value_order, value): value])
    i = 0
    while i < rt_count(profile.value_order):
        if not dv_has(order, profile.value_order[i]):
            rt_push(order, profile.value_order[i])
        i = i + 1
    var value_basis = dv_clone(dv_find(actor.policy, "value_basis", []))
    i = 0
    while i < rt_count(profile.basis):
        rt_push(value_basis, profile.basis[i])
        i = i + 1
    var norm_rules = dv_clone(dv_find(actor.policy, "norm_rules", []))
    let extra_rules = c2_personal_norms(actor.id)
    i = 0
    while i < rt_count(extra_rules):
        var found = false
        var rule_index = 0
        while rule_index < rt_count(norm_rules):
            if norm_rules[rule_index].id == extra_rules[i].id:
                found = true
            rule_index = rule_index + 1
        if not found:
            rt_push(norm_rules, extra_rules[i])
        i = i + 1
    var policy = dv_with_many(actor.policy, {"topic_bindings": dv_append(dv_find(actor.policy, "topic_bindings", []), binding), "value_order": order, "value_basis": value_basis, "chapter2_profile": profile, "norm_rules": norm_rules, "visual_identity_when": dv_fact(campaign_ref("c2.weather", "daylight"), true)})
    policy = dv_with_many(policy, {"plan_depth": 2, "first_night_plan_depth": 2, "first_night_plan_active": false, "positive_move_root_stop": false, "daytime_wait_chunk_limit": 120})
    var actions = c2_actor_actions(actor.id)
    let first_night_group = dv_has(["detective", "huo", "shen", "su", "quer", "lucian", "ward", "gu"], actor.id) and dv_truth(physical, campaign_at(actor.id, "living_hall")) == "true"
    // Residents still outside the living hall retain the methods and goals needed to arrive.
    if not first_night_group:
        i = 0
        while i < rt_count(actor.actions):
            rt_push(actions, actor.actions[i])
            i = i + 1
        policy = dv_with(policy, "chapter1_carried_goals", dv_find(actor.policy, "goals", []))
    else:
        policy = dv_with(policy, "chapter1_carried_goals", [])
    var erosion = cognitive_erosion(campaign_own(actor.id, "erosion_exposure"), c2i_erosion_parameters(actor.id), 1, [campaign_approved("engineering-dose-units-not-measured-physiology")])
    erosion = dv_with(erosion, "incapacity_when", campaign_any(dv_fact(campaign_own(actor.id, "alive"), false), campaign_any(dv_fact(campaign_own(actor.id, "in_coma"), true), dv_fact(campaign_own(actor.id, "stone_stupor"), true))))
    let result = dv_with_many(actor, {"mind": mind, "actions": actions, "policy": policy, "erosion": erosion})
    return c2_refresh_actor_goals(result)

fn c2_extend_scene(scene):
    if dv_find(scene, "chapter2_content_installed", false):
        return scene
    let physical = c2_extend_world(scene.physical)
    var actors = []
    var bindings = dv_clone(scene.bindings)
    let objects = c2_shared_objects()
    var i = 0
    while i < rt_count(scene.actors):
        let actor = scene.actors[i]
        rt_push(actors, c2_extend_actor_from(actor, physical, scene.physical))
        var j = 0
        while j < rt_count(objects):
            if dv_local(bindings, objects[j], actor.id) == "":
                rt_push(bindings, dv_binding(objects[j], objects[j], actor.id))
            j = j + 1
        i = i + 1
    var processes = dv_clone(dv_find(scene, "world_processes", []))
    let extra = c2_world_processes()
    i = 0
    while i < rt_count(extra):
        rt_push(processes, extra[i])
        i = i + 1
    return dv_with_many(scene, {"id": "chapter2-native-content", "physical": physical, "actors": actors, "bindings": bindings, "clock_ref": campaign_clock(), "world_processes": processes, "chapter2_contracts": c2_runtime_contracts(), "chapter2_content_installed": true})

fn c2_world_processes():
    var result = [
        {"id": "c2.meter.safe", "law": "c2.meter.safe", "basis": [campaign_approved("current-instrument-qualitative-safe-reading")]},
        {"id": "c2.meter.stale", "law": "c2.meter.stale", "basis": [campaign_approved("quake-invalidates-prior-reading")]},
        {"id": "c2.weather.first_wind", "law": "c2.weather.first_wind", "once": true, "basis": [campaign_approved("second-day-morning-wind")]}]
    let changes = c2_weather_changes()
    var change_index = 0
    while change_index < rt_count(changes):
        let id = rt_cat("c2.weather.", changes[change_index].id)
        rt_push(result, {"id": id, "law": id, "once": true, "basis": [campaign_approved("第五部分：五日环境变化")]})
        change_index = change_index + 1
    var i = 0
    var light_day = 1
    while light_day < 6:
        rt_push(result, {"id": rt_cat("c2.daylight.", rt_show(light_day)), "law": rt_cat("c2.daylight.", rt_show(light_day)), "once": true, "basis": [c2_source("00_时间与文案.story", 35, "明示昼夜时段边界")]})
        rt_push(result, {"id": rt_cat("c2.nightlight.", rt_show(light_day)), "law": rt_cat("c2.nightlight.", rt_show(light_day)), "once": true, "basis": [c2_source("00_时间与文案.story", 35, "明示昼夜时段边界")]})
        light_day = light_day + 1
    let people = campaign_people()
    i = 0
    while i < rt_count(people):
        var day = 2
        while day <= 5:
            let prefix = rt_cat("c2.hunger.", rt_cat(people[i], rt_cat(".", rt_show(day))))
            rt_push(result, {"id": rt_cat(prefix, ".noon"), "law": rt_cat(prefix, ".noon"), "once": true, "basis": [campaign_approved("hunger-follows-actual-missed-meal")]})
            rt_push(result, {"id": rt_cat(prefix, ".evening"), "law": rt_cat(prefix, ".evening"), "once": true, "basis": [campaign_approved("hunger-follows-actual-missed-meal")]})
            day = day + 1
        let danger = rt_cat("c2.outdoor-danger.", people[i])
        rt_push(result, {"id": danger, "law": danger, "basis": [campaign_approved("actual-quake-air-exposure-engineering-dose")]})
        let pathology = ["weakness", "impairment", "respiratory-failure", "respiratory-terminal"]
        var p = 0
        while p < rt_count(pathology):
            let id = rt_cat("c2.physiology.", rt_cat(people[i], rt_cat(".", pathology[p])))
            rt_push(result, {"id": id, "law": id, "basis": [campaign_approved("user:2026-10-22-continuous-disease-and-effective-care")]})
            p = p + 1
        let terminal = rt_cat("c2.terminal.", people[i])
        rt_push(result, {"id": terminal, "law": terminal, "basis": [campaign_approved("actual-terminal-exposure")]})
        i = i + 1
    rt_push(result, {"id": "c2.drawer.ink-contact", "law": "c2.drawer.ink-contact", "basis": [c2m_source()]})
    rt_push(result, {"id": "c2.moran.acute_collapse", "law": "c2.moran.acute_collapse", "basis": [c2_source("docs/design-standard.md", 0, "莫兰吸入微粒急性休克")]})
    rt_push(result, {"id": "c2.moran.fatal_settle", "law": "c2.moran.fatal_settle", "once": true, "basis": [c2_source("docs/design-standard.md", 0, "莫兰次晨无药身亡结算")]})
    rt_push(result, {"id": "c2.bertrand.petrification_settle", "law": "c2.bertrand.petrification_settle", "once": true, "basis": [c2_source("docs/design-standard.md", 0, "贝尔特朗次晨无药木僵石雕结算")]})
    return result

fn c2_runtime_contracts():
    return {
        "engineering_parameters": {"reserve": "672 portions = 16*21*2; retained original counter stock", "erosion": "dose thresholds 1/2/4/6/8 and coupling factor 1; daytime exposure +1, actual severe quake-alley exposure +8; qualitative authored hazard with explicit engineering scale, not measured physiology"},
        "clock": {"ref": campaign_clock(), "unit": "minute", "day_origin": "day1-at-minute-zero", "start": "retain-actual-chapter1-handoff", "end": "day5-morning", "constraint": "never-rewind-or-write-actor-choices-from-a-date"},
        "access": {"object": "campaign.access", "fields": ["living", "contract", "astral", "logistics", "north", "east"], "source": c2_source("00_通行.story", 9, "authored-boundaries"), "constraint": "actual-opening-observation-and-movement-required"},
        "phase_services": {"counter": "real-counter-staff-action-opens-99-ration-pool-without-total-granary-key", "inventory": "each-collect-spends-one-not-32-per-day", "hunger": "derive-from-real-missed-meals-never-brand-quer-hungry-by-date", "goal_refresh": "c2_refresh_actor_goals-after-real-clock-updates-reads-only-owned-mind", "observations": "explicit-clock-self-route-and-weather-actions-not-passive-global-knowledge"},
        "norms": {"receipt": "real-proposal-post-read-events", "choice": "owner-value-order-after-personal-receipt", "execution": "policy.norm_rules-available_when-and-action.normative_method-against-owned-mind", "indifference": "do-not-treat-a-zero-value-tie-as-positive-adoption-support", "constraint": "posting-does-not-enforce-a-global-law"},
        "stations": {"scope": "chapter-two-granary-cooperation-only", "reserve_parameter": "672-standard-portions=16-persons*21-days*2-meals; engineering-unit-conversion"},
        "environment": {"object": "c2.weather", "inputs": ["wind", "daylight", "earthquake_recent", "severe_air"], "authored_processes": ["falling-ash-through-day2-dawn", "day2-forenoon-wind", "day3-night-calm", "day4-evening-earthquake", "day5-dawn-wind"], "provenance": "authored-clock-conditions-and-actual-weather-control-history", "qualitative_laws": ["windy-day-high-ground-short-excursion", "calm-night-low-lane-slope-foot-water-spring-lethal-exposure"], "unimplemented_room_safety_draft": {"status": "isolated-no-production-controls-or-inputs", "fixture": "verification/checks/fixtures/room-safety-draft.dv", "qualitative_requirements": ["closed-indoor-doors-windows-and-isolation-protect", "recent-earthquake-heavy-air-can-seep-through-gaps"], "inputs": "unknown-not-assumed-false"}, "constraint": "new clinical durations are explicit user-authorized model parameters, not measured physiology; no detector-profile branch"},
        "physiology": {"inputs": ["actual-exposure", "observed-fever", "actual-care", "terminal-exposure"], "revision_20261022": {"initial_condition": "Su's pre-existing erosion disease, not a preset injury", "chronic": "active disease held 4320 minutes causes severe weakness; another 720 untreated minutes causes motor impairment and serious-injury history", "acute": "actual exposure >=8 plus coma or stone stupor causes respiratory failure; 120 continuous untreated minutes of failure can cause actual death", "serious_injury": "actual motor impairment preventing independent movement, or actual respiratory failure; fever alone is insufficient"}, "anti_erosion": {"source": "case.logistics.anti_erosion_mixed from the actual mixing action", "receipt": "Mora takes the prepared medicine at white_tower_safe, then per-patient anti_erosion_treated only after successful on-site Complete", "quantity": "not-modelled: no declared stock or dose count; availability for both patients is not established", "scope": "successful administration halts the new disease/respiratory progression and clears current weakness, motor impairment and respiratory failure; retains serious-injury history, coma, established stone stupor, exposure and death; never revival"}, "constraint": "never-use-third-day-illness-or-fourth-night-death-as-an-assignment"},
        "evidence": {"ledger": "derive-from-real-removals-day-records-and-night-reports", "latch": "tool-marks-only-from-real-repair", "bowl": "residue-only-from-real-patient-feeding", "crumbs": "only-from-real-night-eating", "testimony": "speaker-owned-perception-no-identity-from-a-small-shadow"},
        "handoff": {"preserve": ["accepted_norms", "trust", "hunger", "remaining_rations", "casualties", "memories", "erosion", "ownership"], "constraint": "copy-committed-state-never-reset-to-a-preset-ending"}}

fn c2_next_chapter_contract(scene):
    return {"id": "chapter2-to-chapter3-actual-state", "physical": dv_clone(scene.physical), "actors": dv_clone(scene.actors), "bindings": dv_clone(scene.bindings), "inheritance": c2_runtime_contracts().handoff, "source": campaign_approved("day5-contract-inherits-real-state")}

// Investigation rows describe completed contact, never a calendar-assigned resolution.
fn c2i_row(actor, id, room, when, object, field, requirements, label, text):
    return {"actor": actor, "id": id, "room": room, "when": when, "object": object, "field": field, "requirements": requirements, "label": label, "text": text}

fn c2i_granary_team():
    return dv_all([campaign_at("margaret", "logistics"), campaign_at("huo", "logistics"), campaign_at("quer", "logistics"), c2_alive("margaret"), c2_alive("huo"), c2_alive("quer")])

fn c2i_granary_support():
    return dv_all([c2i_granary_team(), dv_fact(campaign_own("margaret", "support_active"), true), dv_fact(campaign_own("huo", "support_active"), true)])

fn c2i_rows():
    let key = ["authored-declaration", "c2i_rows"]
    let cached = rt_memo_get([], key)
    if cached[0]:
        return cached[1]
    return rt_memo_put([], key, c2i_rows_build())

fn c2i_rows_build():
    let document = campaign_window(2, 840, 960)
    let resonance = campaign_window(3, 570, 720)
    let safety = campaign_window(3, 840, 1020)
    var rows = [
        c2i_row("quer", "quer.c2.document.dismantle-lock", "document_workshop", document, "case.contract", "lock_no_pry", [], "检视文献工房的锁具", "拆下锁具，逐面验看：锁芯和门边没有撬痕。"),
        c2i_row("detective", "detective.c2.document.inventory", "document_workshop", document, "case.contract", "emergency_inventory_majority", [], "整理文献工房的散页", "从散页中找出大半张紧急清册，保留断口等待另一半核对。"),
        c2i_row("quer", "quer.c2.resonance.pipe-climb", "resonance_hall", resonance, "case.astral", "ladder_lowered", [], "攀上管架放下梯子", "沿九米管架攀上平台，把梯子放下。"),
        c2i_row("quer", "quer.c2.resonance.copper", "resonance_hall", resonance, "case.astral", "copper_filings", [dv_fact(campaign_ref("case.astral", "ladder_lowered"), true)], "检视平台管口", "平台的管口下留着细小铜屑。"),
        c2i_row("detective", "detective.c2.resonance.steps", "resonance_hall", resonance, "case.astral", "seven_step_scuffs", [dv_fact(campaign_ref("case.astral", "ladder_lowered"), true)], "对照七星步位与地面", "顺着七星步位，逐一比对地面的擦痕。"),
        c2i_row("detective", "detective.c2.resonance.palm", "resonance_hall", resonance, "case.astral", "palm_print", [dv_fact(campaign_ref("case.astral", "ladder_lowered"), true)], "检视梯子与平台边缘", "梯上与平台边缘留着掌印，位置与攀援线路相接。"),
        c2i_row("detective", "detective.c2.resonance.pressure", "quiet_room", resonance, "case.astral", "vent_pressure_formula", [], "检视备用通风道的标记", "检查备用通风道，抄下标注时刻与压差的算式，保留两者的对应关系。"),
        c2i_row("quer", "quer.c2.safety.acid-drawer", "white_tower_safe", safety, "case.logistics", "r07_skin_test", [], "打开日志抽屉", "实际开启已可操作的抽屉，取出R-07自体皮试记录。"),
        c2i_row("margaret", "margaret.c2.granary.wedge", "logistics", campaign_window(3, 720, 840), "c2.granary", "wedge_set", [c2i_granary_team(), dv_fact(campaign_own("margaret", "can_structure"), true), dv_fact(campaign_ref("c2.granary", "structure_checked"), true)], "放置结构楔", "按昨日勘查位置置入结构楔，托住变形门框。"),
        c2i_row("huo", "huo.c2.granary.jack", "logistics", campaign_window(3, 720, 840), "c2.granary", "lift_mm", [c2i_granary_team(), dv_fact(campaign_own("huo", "can_weight"), true), dv_fact(campaign_own("margaret", "support_active"), true), dv_fact(campaign_ref("c2.granary", "wedge_set"), true)], "用千斤顶承托门框", "以千斤顶和滑轮抬升门框四毫米，保持载荷，让雀儿操作双栓。")]
    let contract_join = dv_all([dv_fact(campaign_ref("case.contract", "lock_no_pry"), true), dv_fact(campaign_ref("case.contract", "emergency_inventory_majority"), true)])
    rt_push(rows, c2i_row("ward", "ward.c2.document.half-paper", "document_workshop", document, "case.contract", "ward_half_paper", [campaign_case_claim("contract", "keys_found")], "出示保存的半张纸", "取出保存的半张纸，把断口摊在紧急清册旁。"))
    rt_push(rows, c2i_row("detective", "detective.c2.document.join", "document_workshop", document, "case.contract", "joined_inventory", [contract_join, dv_fact(campaign_ref("case.contract", "ward_half_paper"), true)], "拼合清册并核对记录", "沿断口将沃德的半纸与大半张紧急清册拼合，逐项核对原来的取存记录。"))
    rt_push(rows, c2i_row("gu", "gu.c2.document.apology", "document_workshop", document, "case.contract", "gu_apologized", [dv_fact(campaign_ref("case.contract", "joined_inventory"), true)], "为先前的指认致歉", "清册拼合了，锁也没有撬痕。老朽先前失察，在这里致歉。"))
    rt_push(rows, c2i_row("ward", "ward.c2.document.return-key", "document_workshop", document, "case.contract", "key_returned", [dv_fact(campaign_ref("case.contract", "joined_inventory"), true), dv_fact(campaign_ref("case.contract", "cabinet_key_holder"), "ward"), campaign_at("quer", "document_workshop")], "归还代管钥匙", "证据已核清。我把代管的钥匙当面归还雀儿。"))
    rt_push(rows, c2i_row("detective", "detective.c2.astral.reassure", "quiet_room", resonance, "case.astral", "moran_reassured", [campaign_at("moran", "quiet_room")], "安抚画夹的主人", "先别急着解释，把画夹取来，我们逐页看清楚。"))
    rt_push(rows, c2i_row("moran", "moran.c2.astral.draft", "quiet_room", resonance, "case.astral", "complete_draft", [dv_fact(campaign_ref("case.astral", "moran_reassured"), true)], "展出画夹中的底稿", "翻开画夹暗层，展出完整底稿：两指向下，作劈切之势。"))
    rt_push(rows, c2i_row("elena", "elena.c2.astral.identify", "quiet_room", resonance, "case.astral", "abandoned_child_misunderstanding_resolved", [dv_fact(campaign_ref("case.astral", "complete_draft"), true)], "说明草图中的手势", "是双指向下的劈切，不是弃子的手势。此前的误会应当撤回。"))
    let assembled = dv_all([campaign_at("mora", "white_tower_safe"), campaign_at("bertrand", "white_tower_safe"), campaign_at("veronica", "white_tower_safe")])
    rt_push(rows, c2i_row("veronica", "veronica.c2.safety.scars", "white_tower_safe", safety, "case.logistics", "three_old_scars", [assembled, dv_fact(campaign_ref("case.logistics", "r07_skin_test"), true)], "出示旧疤并核对记录", "卷起左袖，露出三道旧疤，按日期和R-07自体皮试记录核对。"))
    rt_push(rows, c2i_row("mora", "mora.c2.safety.apology-key", "white_tower_safe", safety, "case.logistics", "medicine_key_given", [assembled, dv_fact(campaign_ref("case.logistics", "three_old_scars"), true)], "致歉并交接药柜钥匙", "是我误会了。药柜钥匙交给你，我们把抗侵蚀剂配出来。"))
    rt_push(rows, c2i_row("veronica", "veronica.c2.safety.mix", "white_tower_safe", safety, "case.logistics", "anti_erosion_mixed", [assembled, dv_fact(campaign_ref("case.logistics", "medicine_key_given"), true)], "配制抗侵蚀剂", "依皮试记录核对材料与用量，配成抗侵蚀剂，贴妥标签。"))
    rt_push(rows, c2i_row("moran", "moran.c2.sketch.day", "outdoor_high", campaign_window(3, 720, 1020), campaign_body("moran"), "day_sketch_exposed", [dv_fact(campaign_ref("c2.weather", "daylight"), true)], "前往高地写生", "在高地对着光写生，返程前察觉灰尘刺激，身体发热。"))
    return rows

fn c2i_value(row):
    if row.field == "lift_mm":
        return 4
    return true

fn c2i_premise(row):
    return dv_all([c2i_physical_premise(row), c2_work_accepted(row.actor, row.id)])

fn c2i_physical_premise(row):
    var conditions = dv_append(row.requirements, dv_all([campaign_at(row.actor, row.room), c2_alive(row.actor), row.when]))
    if row.field == "wedge_set" or row.field == "lift_mm":
        rt_push(conditions, dv_fact(campaign_own(row.actor, "support_active"), false))
    if row.field == "emergency_inventory_majority":
        rt_push(conditions, campaign_any(dv_fact(campaign_ref("case.contract", "inventory_hidden"), false), dv_fact(campaign_ref("case.contract", "inventory_recovered"), true)))
    if row.field == "vent_pressure_formula":
        rt_push(conditions, campaign_any(dv_fact(campaign_ref("case.astral", "pipe_blocked"), false), dv_fact(campaign_ref("case.astral", "pipe_cleared"), true)))
    if row.field == "complete_draft":
        rt_push(conditions, campaign_any(dv_fact(campaign_ref("case.astral", "draft_hidden"), false), dv_fact(campaign_ref("case.astral", "draft_recovered"), true)))
    if row.field == "r07_skin_test":
        rt_push(conditions, campaign_any(dv_fact(campaign_ref("case.logistics", "drawer_etched"), false), dv_fact(campaign_ref("case.logistics", "drawer_neutralized"), true)))
    return dv_all(conditions)

axiom c2i_contact_law(row):
    var effects = dv_single(dv_assign(campaign_ref(row.object, row.field), c2i_value(row)))
    if row.field == "wedge_set" or row.field == "lift_mm":
        rt_push(effects, dv_assign(campaign_own(row.actor, "support_active"), true))
    if row.field == "key_returned":
        rt_push(effects, dv_assign(campaign_ref("case.contract", "cabinet_key_holder"), "quer"))
    if row.field == "day_sketch_exposed":
        rt_push(effects, dv_assign(campaign_own("moran", "fever"), true))
        rt_push(effects, dv_increment(campaign_own("moran", "erosion_exposure"), 1))
    return dv_axiom("c2i_contact_law", 1, c2i_physical_premise(row), effects)

fn c2i_world_objects(world):
    var result = world
    result = campaign_add_new(result, c2_object("c2.meter", "outdoor_meter", {"safe": dv_field(false), "environment_epoch": dv_field(0), "sample_location": dv_field("outdoor_meter")}))
    let cases = ["case.contract", "case.astral", "case.logistics"]
    var i = 0
    while i < rt_count(cases):
        result = campaign_add_new(result, c2_object(cases[i], "", {}))
        i = i + 1
    if not dv_read(result, campaign_ref("case.contract", "cabinet_key_holder")).known:
        if dv_truth(world, campaign_case_claim("contract", "keys_found")) == "true":
            result = dv_store(result, campaign_ref("case.contract", "cabinet_key_holder"), dv_field("ward"))
        else:
            result = dv_store(result, campaign_ref("case.contract", "cabinet_key_holder"), dv_unknown())
    let rows = c2i_rows()
    i = 0
    while i < rt_count(rows):
        let ref = campaign_ref(rows[i].object, rows[i].field)
        if not dv_read(result, ref).known:
            var initial = false
            if rows[i].field == "lift_mm":
                initial = 0
            result = dv_store(result, ref, dv_field(initial))
        i = i + 1
    if not dv_read(result, campaign_ref("case.astral", "evening_choice")).known:
        result = dv_store(result, campaign_ref("case.astral", "evening_choice"), dv_field(""))
    result = campaign_add_new(result, c2_object("c2.seal", "", {"holder": dv_field("ward"), "location": dv_field("")}))
    return c2m_initialize(result)

fn c2i_install_laws(domain, adoptions, actor, mode):
    let rows = c2i_rows()
    var i = 0
    while i < rt_count(rows):
        if rows[i].actor == actor:
            dv_adopt_into(domain, adoptions, campaign_method(rows[i].id, c2i_contact_law(rows[i])), mode, 1, [campaign_approved("chapter-two-real-investigation-contact")])
        i = i + 1
    return true

fn c2i_actions(actor):
    var result = []
    let custody = c2_inspect_action(actor, "case.contract", "document_workshop", ["key_returned", "cabinet_key_holder"], "核对钥匙交接记录", "当面核对代管钥匙的持有人与实际交接记录。", campaign_approved("actual-key-custody-receipt"))
    rt_push(result, dv_with(custody, "id", rt_cat(actor, ".c2.inspect.key-custody")))
    let rows = c2i_rows()
    var i = 0
    while i < rt_count(rows):
        let row = rows[i]
        if row.actor == actor:
            let pre = c2i_premise(row)
            let ref = campaign_ref(row.object, row.field)
            var grants = [ref]
            var visible_grants = [ref]
            if row.field == "wedge_set" or row.field == "lift_mm":
                rt_push(grants, campaign_own(actor, "support_active"))
                rt_push(visible_grants, campaign_own(actor, "support_active"))
            if row.field == "key_returned":
                rt_push(grants, campaign_ref("case.contract", "cabinet_key_holder"))
                rt_push(visible_grants, campaign_ref("case.contract", "cabinet_key_holder"))
            if row.field == "day_sketch_exposed":
                rt_push(grants, campaign_own("moran", "fever"))
                rt_push(grants, campaign_own("moran", "erosion_exposure"))
            var action = dv_with_many(campaign_surface_action(row.id, "experiment", pre, c2i_physical_premise(row), row.id, grants, row.label, row.text, campaign_approved("chapter-two-real-investigation-contact")), {"public_observers": campaign_people(), "public_grants": visible_grants})
            if actor == "quer" and row.field != "lock_no_pry":
                action = dv_with(action, "work_operation", row.id)
            if row.field == "wedge_set" or row.field == "lift_mm":
                action = dv_with(action, "repeatable", true)
            let talk_fields = ["gu_apologized", "key_returned", "moran_reassured", "abandoned_child_misunderstanding_resolved", "medicine_key_given"]
            if dv_has(talk_fields, row.field):
                action = dv_with_many(action, {"kind": "talk", "speech": dv_with(campaign_speech(dv_true(), campaign_approved("chapter-two-evidence-led-dialogue"), "case-resolution"), "surface", row.text), "listeners": campaign_people()})
            rt_push(result, action)
        i = i + 1
    // Evidence becomes available to another actor through an actual local inspection.
    let places = [{"object": "case.contract", "room": "document_workshop", "fields": ["lock_no_pry", "emergency_inventory_majority", "ward_half_paper", "joined_inventory"]}, {"object": "case.astral", "room": "resonance_hall", "fields": ["ladder_lowered", "copper_filings", "seven_step_scuffs", "palm_print"]}, {"object": "case.astral", "room": "quiet_room", "fields": ["vent_pressure_formula", "moran_reassured", "complete_draft"]}, {"object": "case.logistics", "room": "white_tower_safe", "fields": ["r07_skin_test", "three_old_scars", "medicine_key_given", "anti_erosion_mixed"]}, {"object": "c2.granary", "room": "logistics", "fields": ["wedge_set", "lift_mm", "double_bolts", "reserve_added"]}]
    i = 0
    while i < rt_count(places):
        let place = places[i]
        var inspect = c2_inspect_action(actor, place.object, place.room, place.fields, "核对现场操作与证据", "在现场核对已完成的操作与留下的证据。", campaign_approved("chapter-two-evidence-requires-local-inspection"))
        inspect = dv_with(inspect, "id", rt_cat(actor, rt_cat(".c2.investigation.inspect.", place.room)))
        rt_push(result, inspect)
        i = i + 1
    if dv_has(["margaret", "huo", "quer"], actor):
        let team = [{"actor": "margaret", "job": "margaret.c2.granary.wedge"}, {"actor": "huo", "job": "huo.c2.granary.jack"}, {"actor": "quer", "job": "quer.c2.granary.precision"}]
        i = 0
        while i < rt_count(team):
            let peer = team[i]
            let pre = dv_all([campaign_at(actor, "logistics"), campaign_at(peer.actor, "logistics")])
            var inspect = c2_inspect_action(actor, campaign_body(peer.actor), "logistics", ["support_active", rt_cat("work.accepted.", peer.job)], "核对协作与承托状态", "在现场核对协作人的承诺与实际承托状态。", campaign_approved("actual-cooperation-observation"))
            inspect = dv_with_many(inspect, {"id": rt_cat(actor, rt_cat(".c2.inspect.support.", peer.actor)), "precondition": pre, "authority_precondition": pre})
            rt_push(result, inspect)
            i = i + 1
    return result

// Supervision is learned by a real local inspection, after travelling to it.
// Sampling the outdoor meter cannot supply who is currently accompanying us.
fn c2i_watch_goal(actor, when, source, minimum):
    var room = "central_hall"
    var method = "moran.c2.inspect.current-watch"
    if dv_truth(actor.mind, campaign_at(actor.id, "living_hall")) == "true":
        room = "living_hall"
        method = "moran.c2.inspect.current-watch-living"
    return dv_with_many(campaign_observation_goal(campaign_own("moran", "watched"), when, source, minimum), {"navigation_room": room, "navigation_methods": [method]})

fn c2i_goals(actor):
    let id = actor.id
    var goals = []
    if id == "quer" and c2_quer_concerned(actor):
        rt_push(goals, dv_with_many(campaign_goal(dv_fact(campaign_own("ward", "restriction_withdrawn"), true), dv_all([dv_fact(campaign_ref("case.contract", "joined_inventory"), true), dv_fact(campaign_ref("case.contract", "lock_no_pry"), true)]), [campaign_approved("actual-restriction-withdrawal-receipt")]), {"navigation_room": "document_workshop", "navigation_methods": ["quer.c2.ask-restriction-status"]}))
    if id == "ward" or id == "quer":
        rt_push(goals, campaign_observation_goal(campaign_ref("case.contract", "cabinet_key_holder"), campaign_at(id, "document_workshop"), [campaign_approved("actual-key-custody-receipt")], 0))
    goals = c2m_concat(goals, c2m_goals(actor))
    if id == "bertrand" and c2_moran_outing_heard(actor):
        rt_push(goals, dv_with_many(campaign_observation_goal(campaign_own("moran", "in_coma"), c2_night(4), [campaign_approved("user:2026-10-22-search-from-real-heard-intention")], 5370), {"navigation_room": "outdoor_alley", "navigation_methods": ["bertrand.c2.search.moran-alley"]}))
    if id == "mora":
        let mixed = dv_fact(campaign_ref("case.logistics", "anti_erosion_mixed"), true)
        rt_push(goals, dv_with_many(campaign_goal(dv_fact(campaign_own(id, "anti_erosion_carried"), true), mixed, [campaign_approved("actual-care-from-authored-mixed-anti-erosion-medicine")]), {"navigation_completion": dv_fact(campaign_own(id, "anti_erosion_carried"), true), "navigation_room": "white_tower_safe", "navigation_requirements": [mixed], "navigation_methods": ["mora.c2.take.anti_erosion"]}))
        let patients = c2_care_patients()
        var patient_index = 0
        while patient_index < rt_count(patients):
            let patient = patients[patient_index]
            let position = dv_read(actor.mind, campaign_position_ref(patient))
            let need = campaign_any(dv_fact(campaign_own(patient, "active_erosion_disease"), true), campaign_any(dv_fact(campaign_own(patient, "in_coma"), true), campaign_any(dv_fact(campaign_own(patient, "fever"), true), dv_fact(campaign_own(patient, "rescue_exposed"), true))))
            if dv_uncontested(position) and dv_has(c2_rooms(), position.value):
                let condition = dv_all([need, dv_fact(campaign_own(id, "anti_erosion_carried"), true)])
                rt_push(goals, dv_with_many(campaign_goal(dv_fact(campaign_own(patient, "anti_erosion_treated"), true), condition, [campaign_approved("actual-care-from-authored-mixed-anti-erosion-medicine")]), {"navigation_completion": dv_fact(campaign_own(patient, "anti_erosion_treated"), true), "navigation_room": position.value, "navigation_requirements": [condition], "navigation_methods": [rt_cat("mora.c2.administer.anti_erosion.", patient)]}))
            patient_index = patient_index + 1
    if id == "mora" or id == "bertrand":
        let patients = c2_care_patients()
        var patient_index = 0
        while patient_index < rt_count(patients):
            let patient = patients[patient_index]
            rt_push(goals, campaign_observation_goal(campaign_own(patient, "in_coma"), c2_patient_contact(id, patient), [campaign_approved("actual-contact-before-care-or-rescue")], 0))
            rt_push(goals, campaign_observation_goal(campaign_own(patient, "active_erosion_disease"), c2_patient_contact(id, patient), [campaign_approved("actual-contact-before-care-or-rescue")], 0))
            rt_push(goals, campaign_observation_goal(campaign_own(patient, "motor_impairment"), dv_all([c2_patient_contact(id, patient), dv_at_least(campaign_clock(), 4320)]), [campaign_approved("actual-contact-before-care-or-rescue")], 4320))
            rt_push(goals, campaign_observation_goal(campaign_own(patient, "respiratory_failure"), c2_patient_contact(id, patient), [campaign_approved("actual-contact-before-care-or-rescue")], 5370))
            rt_push(goals, campaign_observation_goal(campaign_own(patient, "anti_erosion_treated"), c2_patient_contact(id, patient), [campaign_approved("actual-contact-before-care-or-rescue")], 0))
            patient_index = patient_index + 1
    let rows = c2i_rows()
    let closing = c2i_closing_navigation(actor)
    if closing != false:
        let source = campaign_approved("user:2026-10-18章末授权")
        let when = campaign_any(dv_fact(campaign_ref("c2.daily", "council_closed"), true), dv_at_least(campaign_clock(), 6330))
        rt_push(goals, campaign_goal(campaign_at(id, closing.target), when, [source, closing]))
        if closing.next != closing.target:
            rt_push(goals, campaign_goal(campaign_at(id, closing.next), dv_all([when, campaign_at(id, closing.origin)]), [source, closing]))
    var i = 0
    while i < rt_count(rows):
        let row = rows[i]
        if row.actor == id:
            let completion = dv_fact(campaign_ref(row.object, row.field), c2i_value(row))
            let undertaking = dv_all([row.when, c2_work_accepted(id, row.id)])
            rt_push(goals, dv_with_many(campaign_goal(completion, undertaking, [campaign_approved("chapter-two-investigation-opportunity")]), {"navigation_completion": completion, "navigation_room": row.room, "navigation_requirements": row.requirements, "navigation_methods": [row.id]}))
        i = i + 1
    if id == "ruan":
        rt_push(goals, campaign_goal(dv_fact(campaign_ref("c2.ledger", "supplement_column"), true), dv_fact(campaign_own("ruan", "accepted.records_supplement"), true), [campaign_approved("implement-reserved-column-after-acceptance")]))
    if id == "moran":
        // The declared evening discussion needs a real meeting before its
        // speaker-dependent options can exist. This grants no color or advice.
        if not c2_received_requirement(actor, {"speaker": "demon", "action_id": "demon.c2.truth-color"}):
            rt_push(goals, dv_with_many(campaign_goal(campaign_at(id, "living_hall"), campaign_window(4, 1050, 1260), [campaign_approved("user:2026-10-22-evening-research-meeting")]), {"navigation_room": "living_hall", "maintain_presence": true}))
        rt_push(goals, c2i_watch_goal(actor, c2_night(4), [campaign_approved("actual-current-supervision-not-permanent-flag")], 5370))
        rt_push(goals, campaign_goal(campaign_at("moran", "outdoor_alley"), dv_fact(campaign_ref("case.astral", "evening_choice"), "go"), [campaign_approved("execute-actual-personal-sketch-choice")]))
        rt_push(goals, campaign_goal(dv_fact(campaign_ref("case.astral", "evening_choice"), "go"), c2_night(4), [campaign_approved("evening-research-opportunity-not-compulsory-outcome")]))
        rt_push(goals, campaign_goal(campaign_at("moran", "clinic"), dv_fact(campaign_own("moran", "fever"), true), [campaign_approved("actual-discomfort-motivates-return-to-care")]))
    let evidence_places = [{"object": "case.contract", "room": "document_workshop", "fields": ["lock_no_pry", "emergency_inventory_majority", "ward_half_paper", "joined_inventory"]}, {"object": "case.astral", "room": "resonance_hall", "fields": ["ladder_lowered", "copper_filings", "seven_step_scuffs", "palm_print"]}, {"object": "case.astral", "room": "quiet_room", "fields": ["vent_pressure_formula", "moran_reassured", "complete_draft"]}, {"object": "case.logistics", "room": "white_tower_safe", "fields": ["r07_skin_test", "three_old_scars", "medicine_key_given", "anti_erosion_mixed"]}]
    var place_index = 0
    while place_index < rt_count(evidence_places):
        let place = evidence_places[place_index]
        if id == "detective" or id == "quer" or place.object == rt_cat("case.", campaign_profile(id).group):
            var field_index = 0
            while field_index < rt_count(place.fields):
                rt_push(goals, campaign_observation_goal(campaign_ref(place.object, place.fields[field_index]), campaign_at(id, place.room), [campaign_approved("actual-local-case-inspection")], 0))
                field_index = field_index + 1
        place_index = place_index + 1
    if dv_has(["detective", "margaret", "huo", "quer"], id):
        let granary_fields = ["structure_checked", "wedge_set", "lift_mm", "double_bolts"]
        var field_index = 0
        while field_index < rt_count(granary_fields):
            rt_push(goals, dv_with_many(campaign_observation_goal(campaign_ref("c2.granary", granary_fields[field_index]), campaign_window(3, 720, 840), [campaign_approved("actual-cooperation-observation")], 0), {"navigation_room": "logistics", "navigation_methods": [rt_cat(id, ".c2.inspect.c2.granary"), rt_cat(id, ".c2.investigation.inspect.logistics")]}))
            field_index = field_index + 1
        rt_push(goals, campaign_goal(dv_fact(campaign_ref("c2.granary", "total_store_locked"), false), campaign_window(3, 720, 840), [campaign_approved("three-person-granary-opening")]))
    return goals

法则 c2i_reserve_column_law：
    当 "ruan" 位于 后勤院。
    并且 配给总账 的 "supplement_column" 等于 false。
    则 配给总账 的 "supplement_column" 变为 true。

axiom c2i_complete_pending_law(actor):
    return c2i_complete_pending_purpose_law(actor, "self")

法则 c2i_complete_pending_purpose_law，给定 行动者、purpose：
    当 行动者 位于 后勤院。
    并且 c2_alive(行动者)。
    并且 campaign_own(行动者, "pending_notes") 至少 1。
    并且 campaign_own(行动者, rt_cat("pending.", purpose)) 至少 1。
    并且 campaign_own(行动者, "owe_notes") 至少 1。
    并且 campaign_own(行动者, 正在照护) 等于 false。
    则 campaign_own(行动者, "pending_notes") 增加 -1。
    并使 campaign_own(行动者, rt_cat("pending.", purpose)) 增加 -1。
    并使 campaign_own(行动者, rt_cat("purpose_clarified.", purpose)) 变为 true。
    并使 campaign_own(行动者, "owe_notes") 增加 -1。
    并使 配给总账 的 "pending_registered" 增加 -1。
    并使 配给总账 的 "night_recorded" 增加 1。

fn c2i_record_install(domain, adoptions, actor, mode):
    let source = [campaign_approved("actual-reserved-column-and-pending-entry")]
    dv_adopt_into(domain, adoptions, campaign_method(rt_cat(actor, ".c2.night_take.registered"), c2_night_take_variant_law(actor, false, true)), mode, 1, source)
    dv_adopt_into(domain, adoptions, campaign_method(rt_cat(actor, ".c2.report.pending"), c2i_complete_pending_law(actor)), mode, 1, source)
    if actor == "mora":
        dv_adopt_into(domain, adoptions, campaign_method("mora.c2.night_take.patient.registered", c2_night_take_variant_law(actor, true, true)), mode, 1, source)
        dv_adopt_into(domain, adoptions, campaign_method("mora.c2.report.pending.patient", c2i_complete_pending_purpose_law(actor, "patient")), mode, 1, source)
    if actor == "ruan":
        dv_adopt_into(domain, adoptions, campaign_method("ruan.c2.ledger.reserve-column", c2i_reserve_column_law()), mode, 1, source)
    return true

fn c2i_record_actions(actor):
    var result = []
    let source = campaign_approved("actual-reserved-column-and-pending-entry")
    let law = c2_night_take_variant_law(actor, false, true)
    let id = rt_cat(actor, ".c2.night_take.registered")
    rt_push(result, dv_with_many(campaign_surface_action(id, "help", law.premise, law.premise, id, c2_pending_grants(actor, "self"), "取粮并留下待核记号", "为自己取一份口粮，在预留栏留下待补核的取用记号。", source), {"normative_method": "pending_take", "public_observers": campaign_people(), "public_grants": [campaign_ref("c2.ledger", "pending_registered")]}))
    let report = c2i_complete_pending_law(actor)
    let report_id = rt_cat(actor, ".c2.report.pending")
    rt_push(result, dv_with_many(campaign_surface_action(report_id, "help", report.premise, report.premise, report_id, c2_pending_grants(actor, "self"), "补记本人取粮用途", "将本人为自己取用的一份补入用途说明，记入台账，保留供现场复核。", source), {"repeatable": true, "public_observers": campaign_people(), "public_grants": [campaign_ref("c2.ledger", "pending_registered"), campaign_ref("c2.ledger", "night_recorded")]}))
    if actor == "mora":
        let patient = c2_night_take_variant_law(actor, true, true)
        rt_push(result, dv_with_many(campaign_surface_action("mora.c2.night_take.patient.registered", "help", patient.premise, patient.premise, "mora.c2.night_take.patient.registered", c2_pending_grants(actor, "patient"), "为病人取粮并留下待核记号", "为发热病人取一份粮，在预留栏留下待补核的记号。", source), {"normative_method": "pending_take", "public_observers": campaign_people(), "public_grants": [campaign_ref("c2.ledger", "pending_registered")]}))
        let patient_report = c2i_complete_pending_purpose_law(actor, "patient")
        rt_push(result, dv_with_many(campaign_surface_action("mora.c2.report.pending.patient", "help", patient_report.premise, patient_report.premise, "mora.c2.report.pending.patient", c2_pending_grants(actor, "patient"), "补记病人用粮", "将为病人取用的一份补入照护用途说明，记入台账，保留供现场复核。", source), {"repeatable": true, "public_observers": campaign_people(), "public_grants": [campaign_ref("c2.ledger", "pending_registered"), campaign_ref("c2.ledger", "night_recorded")]}))
    if actor == "ruan":
        let column = c2i_reserve_column_law()
        rt_push(result, campaign_surface_action("ruan.c2.ledger.reserve-column", "help", dv_all([column.premise, dv_fact(campaign_own("ruan", "accepted.records_supplement"), true)]), column.premise, "ruan.c2.ledger.reserve-column", [campaign_ref("c2.ledger", "supplement_column")], "划出配给补记栏", "在台账上划出补记栏，分别记待核取用与已核结余。", source))
    return result

fn c2_pending_grants(actor, purpose):
    return [campaign_own(actor, "rations"), campaign_own(actor, "owe_notes"), campaign_own(actor, "pending_notes"), campaign_own(actor, rt_cat("pending.", purpose)), campaign_own(actor, rt_cat("purpose_clarified.", purpose)), campaign_own(actor, "last_take_purpose"), campaign_own(actor, "night_taken"), campaign_ref("c2.ledger", "pending_registered"), campaign_ref("c2.ledger", "night_recorded"), campaign_ref("c2.counter", "remaining")]

// Dose units and thresholds are explicit engineering parameters, not measured physiology.
fn c2i_erosion_parameters(actor):
    // The acute night exposure is not an immediate erasure of learned routes.
    // Later memory loss uses the authored next-morning clinical settlement,
    // while acute coma is independently enforced at the actual hazard site.
    return [{"at": 1, "rank": 0}, {"at": 2, "rank": 1}, {"at": 4, "rank": 2, "when": dv_at_least(campaign_clock(), 6120)}, {"at": 6, "rank": 3, "when": dv_fact(campaign_own(actor, "stone_stupor"), true)}, {"at": 8, "rank": 4, "when": dv_fact(campaign_own(actor, "dead"), true)}]

法则 c2i_outdoor_danger_law，给定 行动者：
    当 行动者 位于 "outdoor_alley"。
    并且 c2_alive(行动者)。
    并且 "c2.weather" 的 "earthquake_recent" 等于 true。
    并且 "c2.weather" 的 "severe_air" 等于 true。
    并且 campaign_own(行动者, "evening_sketch_exposed") 等于 false。
    则 campaign_own(行动者, "erosion_exposure") 增加 8。
    并使 campaign_own(行动者, "evening_sketch_exposed") 变为 true。

fn c2i_evening_actions(actor):
    if actor != "moran":
        return []
    let source = campaign_approved("fourth-evening-owned-research-and-safety-choice")
    let when = dv_all([c2_night(4), c2_alive(actor)])
    let result_ref = campaign_ref("case.astral", "evening_choice")
    var result = []
    var watch_index = 0
    while watch_index < 2:
        let watched = watch_index == 1
        let context = dv_all([when, dv_fact(campaign_own(actor, "watched"), watched)])
        var options = [{"value": "go", "label": "提出沿夹道外出写生", "text": "色层难得。我想沿夹道再看一眼，把那层颜色画下来。", "promotes": ["research"], "sacrifices": ["cautious_travel", "safety"]}, {"value": "stay", "label": "提出留在安全处完成草图", "text": "先留在安全处，把现有草图画完，等新读数。", "promotes": ["safety", "cautious_travel"], "sacrifices": ["research"]}]
        var i = 0
        while i < rt_count(options):
            let option = options[i]
            var promotes = option.promotes
            if watched and option.value == "stay":
                // Public accountability is an additional reason, evaluated by shared utility.
                promotes = ["measured_work", "safety", "cautious_travel"]
            let id = rt_cat("moran.c2.sketch.evening.", rt_cat(option.value, rt_cat(".", rt_show(watched))))
            let law = rt_cat("moran.c2.sketch.evening.", option.value)
            // A dangerous intention remains physically possible. Actual adopted
            // safety norms and the owner's competing reasons decide whether to go;
            // an unsafe reading is not an author-level ban on considering it.
            let ready = context
            let choice = {"group": "moran.evening-sketch", "requires": ready, "prohibits": campaign_any(dv_fact(result_ref, "stay"), dv_fact(result_ref, "go")), "promotes": promotes, "sacrifices": option.sacrifices, "basis": [source]}
            let speech = dv_with(campaign_speech(dv_true(), source, "evening-sketch-choice"), "surface", option.text)
            var action = campaign_surface_action(id, "talk", ready, when, law, [result_ref], option.label, option.text, source)
            action = dv_with(action, "owned_safety_choice", ready)
            action = dv_with_many(action, {"personal_choice": choice, "speech": speech, "listeners": c2d_people(), "received_speech_requirement": {"speaker": "demon", "action_id": "demon.c2.truth-color"}})
            rt_push(result, action)
            i = i + 1
        watch_index = watch_index + 1
    let unsafe = dv_all([when, dv_fact(campaign_ref("c2.meter", "safe"), false)])
    let unsafe_choice = {"group": "moran.evening-sketch", "requires": unsafe, "prohibits": campaign_any(dv_fact(result_ref, "stay"), dv_fact(result_ref, "go")), "promotes": ["safety", "cautious_travel"], "sacrifices": ["research"], "basis": [source]}
    let unsafe_action = dv_with(campaign_surface_action("moran.c2.sketch.evening.stay.unsafe", "help", unsafe, when, "moran.c2.sketch.evening.stay", [result_ref], "留在安全处等待新读数", "我看到的读数不安全，先留在安全处。", source), "owned_safety_choice", unsafe)
    rt_push(result, dv_with_many(unsafe_action, {"personal_choice": unsafe_choice, "received_speech_requirement": {"speaker": "demon", "action_id": "demon.c2.truth-color"}}))
    let watch = c2_inspect_action(actor, campaign_body(actor), "central_hall", ["watched"], "查看身边的同行者", "看看谁还在身边，是否有人正负责监督这次外出。", source)
    rt_push(result, dv_with(watch, "id", "moran.c2.inspect.current-watch"))
    let local_watch = c2_inspect_action(actor, campaign_body(actor), "living_hall", ["watched"], "查看门内的值守者", "留意门内实际在场的守望者。", source)
    rt_push(result, dv_with(local_watch, "id", "moran.c2.inspect.current-watch-living"))
    return result

法则 c2i_evening_choice_law，给定 行动者、取值：
    当 c2_alive(行动者)。
    并且 c2_night(4)。
    则 "case.astral" 的 "evening_choice" 变为 取值。

法则 c2i_meter_safe_law：
    当 "c2.weather" 的 "wind" 等于 true。
    并且 "c2.weather" 的 "severe_air" 等于 false。
    并且 "c2.meter" 的 "safe" 等于 false。
    则 "c2.meter" 的 "safe" 变为 true。

法则 c2i_meter_stale_law：
    当 "c2.weather" 的 "severe_air" 等于 true。
    并且 "c2.meter" 的 "safe" 等于 true。
    则 "c2.meter" 的 "safe" 变为 false。

// One navigation intention at a time. Local ready work outranks a trip;
// all completion goals remain available to the shared planner.
fn c2i_navigation_focus(actor, rows):
    var fallback = ""
    var ready = ""
    var i = 0
    while i < rt_count(rows):
        let row = rows[i]
        if row.actor == actor.id and dv_truth(actor.mind, row.when) == "true" and dv_truth(actor.mind, dv_fact(campaign_ref(row.object, row.field), c2i_value(row))) != "true":
            if fallback == "":
                fallback = row.id
            if dv_truth(actor.mind, dv_all(row.requirements)) == "true":
                if dv_truth(actor.mind, campaign_at(actor.id, row.room)) == "true":
                    return row.id
                if ready == "" and c2i_known_route(actor, row.room) != false:
                    ready = row.id
        i = i + 1
    if ready != "":
        return ready
    return fallback

// Intermediate intention follows an owned, known-open path; execution still checks each gate.
fn c2i_known_route(actor, target):
    if not dv_find(actor.policy, "opt_plancache", false):
        return c2i_known_route_uncached(actor, target)
    actor = rt_snapshot(actor)
    let key = ["c2i_known_route-complete-knowledge-v1", actor.id, actor.mind.revision, actor.mind.time, dv_find(actor, "location", ""), actor.policy, target]
    let cached = rt_memo_get(actor.mind, key)
    if cached[0]:
        return cached[1]
    return rt_memo_put(actor.mind, key, c2i_known_route_uncached(actor, target))

fn c2i_known_route_uncached(actor, target):
    let position = dv_read(actor.mind, campaign_position_ref(actor.id))
    if not dv_uncontested(position) or position.value == target:
        return false
    var queue = [{"room": position.value, "first": "", "basis": []}]
    var visited = [position.value]
    var cursor = 0
    let edges = c2_edges()
    while cursor < rt_count(queue):
        let node = queue[cursor]
        var i = 0
        while i < rt_count(edges):
            let edge = edges[i]
            var destination = ""
            if edge.from == node.room:
                destination = edge.to
            if edge.to == node.room:
                destination = edge.from
            if destination != "" and not dv_has(visited, destination) and dv_truth(actor.mind, dv_fact(campaign_access(edge.gate), true)) == "true":
                var action = c2_move_action(actor.id, node.room, destination, edge.gate)
                if actor.id == "bertrand" and dv_truth(actor.mind, dv_fact(campaign_own("bertrand", "carrying"), "moran")) == "true":
                    action = c2_carry_moran_action(node.room, destination, edge.gate)
                let adoption = dv_find(actor.mind.adoptions, action.predict_law, false)
                if adoption != false and adoption.active and adoption.mode == "predict":
                    var first = node.first
                    if first == "":
                        first = destination
                    let basis = dv_append(node.basis, {"method": action.id, "adoption_basis": adoption.basis, "gate": campaign_access(edge.gate), "gate_cell": dv_read(actor.mind, campaign_access(edge.gate))})
                    if destination == target:
                        return {"origin": position.value, "next": first, "target": target, "path_basis": basis, "scope": "owned-route-intention-not-execution"}
                    rt_push(queue, {"room": destination, "first": first, "basis": basis})
                    rt_push(visited, destination)
            i = i + 1
        cursor = cursor + 1
    return false

// One owned navigation intention also serves closing evidence. No location,
// access state or successful inspection is supplied by this route selection.
fn c2i_closing_navigation(actor):
    let when = campaign_any(dv_fact(campaign_ref("c2.daily", "council_closed"), true), dv_at_least(campaign_clock(), 6330))
    if dv_truth(actor.mind, when) != "true":
        return false
    let venues = ["central_hall", "oath_court"]
    let completed = dv_find(actor, "completed_actions", [])
    var i = 0
    while i < rt_count(venues):
        if dv_has(completed, rt_cat(actor.id, rt_cat(".c2.daily.closing.", venues[i]))):
            return false
        i = i + 1
    var best = false
    var distance = -1
    i = 0
    while i < rt_count(venues):
        let room = venues[i]
        if dv_truth(actor.mind, campaign_at(actor.id, room)) == "true":
            return {"origin": room, "next": room, "target": room, "path_basis": [], "scope": "owned-closing-inspection-intention-not-execution"}
        let route = c2i_known_route(actor, room)
        if route != false and (distance < 0 or rt_count(route.path_basis) < distance):
            best = route
            distance = rt_count(route.path_basis)
        i = i + 1
    return best

fn c2i_navigation_input(actor):
    var refs = [campaign_position_ref(actor.id), campaign_access("north"), campaign_access("east"), campaign_access("living")]
    refs = dvp_merge_refs(refs, [campaign_ref("c2.daily", "council_closed")])
    let edges = c2_edges()
    var edge_index = 0
    while edge_index < rt_count(edges):
        refs = dvp_merge_refs(refs, [campaign_access(edges[edge_index].gate)])
        edge_index = edge_index + 1
    let goals = dv_find(actor.policy, "goals", [])
    var i = 0
    while i < rt_count(goals):
        let completion = dv_find(goals[i], "navigation_completion", false)
        if completion != false:
            refs = dvp_merge_refs(refs, dvs_sim_refs(completion))
        i = i + 1
    let rows = c2i_rows()
    var windows = []
    i = 0
    while i < rt_count(rows):
        if rows[i].actor == actor.id:
            refs = dvp_merge_refs(refs, dvs_sim_refs(dv_all(rows[i].requirements)))
            rt_push(windows, dv_truth(actor.mind, rows[i].when))
        i = i + 1
    var inputs = []
    i = 0
    while i < rt_count(refs):
        rt_push(inputs, {"ref": refs[i], "cell": dvs_reason_value(dv_read(actor.mind, refs[i]))})
        i = i + 1
    return {"inputs": inputs, "windows": windows, "adoptions": actor.mind.adoptions, "closing_available": dv_truth(actor.mind, campaign_any(dv_fact(campaign_ref("c2.daily", "council_closed"), true), dv_at_least(campaign_clock(), 6330))), "closing_central_completed": dv_has(dv_find(actor, "completed_actions", []), rt_cat(actor.id, ".c2.daily.closing.central_hall")), "closing_oath_completed": dv_has(dv_find(actor, "completed_actions", []), rt_cat(actor.id, ".c2.daily.closing.oath_court"))}

// Work decisions belong to their owner. An invitation is a heard request;
// neither it nor a partnership promise changes another body's physical skill.
fn c2_work_accepted(actor, id):
    return dv_fact(campaign_own(actor, rt_cat("work.accepted.", id)), true)

fn c2_work_decision(item, stance, source):
    var refs = []
    if item.actor == "quer" and item.field != "lock_no_pry":
        refs = [campaign_case_ref("contract", "quer_insulted"), campaign_first_night_ref("ward.restriction_announced"), campaign_own("ward", "restriction_withdrawn"), campaign_ref("case.contract", "key_returned"), campaign_ref("case.contract", "cabinet_key_holder")]
    return {"id": rt_cat("work.", item.id), "stance": stance, "context_refs": refs, "request_topics": [rt_cat("work.", item.id)], "basis": [source]}

fn c2_guard_decision(actor, stance, source):
    var refs = [campaign_ref("c2.weather", "earthquake_recent"), campaign_ref("c2.weather", "wind"), campaign_ref("c2.weather", "environment_epoch"), campaign_ref("c2.meter", "safe"), campaign_position_ref("moran"), campaign_own("moran", "alive")]
    let guards = ["detective", "bertrand", "huo"]
    var i = 0
    while i < rt_count(guards):
        if guards[i] != actor:
            rt_push(refs, campaign_own(guards[i], "guard_active"))
        i = i + 1
    return {"id": rt_cat("guard-duty.", actor), "stance": stance, "context_refs": refs, "request_topics": [rt_cat("guard-duty.", actor)], "basis": [source]}

fn c2_partner_already_decided(actor, kind):
    let completed = dv_find(actor, "completed_actions", [])
    if dv_truth(actor.mind, dv_fact(campaign_first_night_ref("partner_promised"), true)) == "true":
        return true
    if actor.id == "detective" and (dv_has(completed, "night.accept-partner") or dv_has(completed, "detective.c2.partner.accept")):
        return true
    if kind == "offer":
        return dv_truth(actor.mind, dv_fact(campaign_first_night_ref("partner_offered"), true)) == "true" or dv_has(completed, "night.partner") or dv_has(completed, "quer.c2.partner.offer")
    return false

fn c2_work_specs():
    var result = []
    let rows = c2i_rows()
    var i = 0
    while i < rt_count(rows):
        rt_push(result, {"id": rows[i].id, "actor": rows[i].actor, "room": rows[i].room, "when": rows[i].when, "purpose": c2_work_purpose(rows[i].field), "field": rows[i].field})
        i = i + 1
    rt_push(result, {"id": "quer.c2.granary.precision", "actor": "quer", "room": "logistics", "when": campaign_window(3, 720, 840), "purpose": "在结构与载荷稳定后操作双钩和精密门栓。", "field": "double_bolts"})
    return result

fn c2_work_purpose(field):
    if field == "wedge_set":
        叙述：
            检查结构后置楔，持续托住门框。
    if field == "lift_mm":
        叙述：
            核对载荷并操作千斤顶，持续保持抬升。
    if field == "lock_no_pry":
        叙述：
            拆验锁具，记录实际痕迹。
    if field == "emergency_inventory_majority" or field == "joined_inventory" or field == "ward_half_paper":
        叙述：
            查找并出示各自实际持有的散页，核对清册与授权上下文。
    if field == "day_sketch_exposed":
        叙述：
            自行判断写生机会，记录实际观察与身体感受。
    if field == "key_returned":
        叙述：
            核对代管依据与现场记录，办理钥匙交接。
    if field == "gu_apologized" or field == "abandoned_child_misunderstanding_resolved":
        叙述：
            依据实际取得的材料，重新评估并说明先前判断。
    叙述：
        承担自己能做的现场核对，所见与结果另行记录。

fn c2_quer_restriction():
    return dv_fact(campaign_first_night_ref("ward.restriction_announced"), true)

fn c2_quer_restricted(actor):
    let heard = c2_received_requirement(actor, {"speaker": "ward", "action_id": "night.ward-claim"})
    return (heard or dv_truth(actor.mind, c2_quer_restriction()) == "true") and dv_truth(actor.mind, dv_fact(campaign_own("ward", "restriction_withdrawn"), true)) != "true"

fn c2_quer_concerned(actor):
    return (c2_quer_restricted(actor) or dv_truth(actor.mind, campaign_case_claim("contract", "quer_insulted")) == "true") and dv_truth(actor.mind, dv_fact(campaign_own("ward", "restriction_withdrawn"), true)) != "true"

fn c2_cooperation_basis(actor, basis):
    var result = basis
    if actor.id == "quer":
        let refs = [campaign_case_ref("contract", "quer_insulted"), campaign_first_night_ref("ward.restriction_announced"), campaign_own("ward", "restriction_withdrawn")]
        var i = 0
        while i < rt_count(refs):
            let cell = dv_read(actor.mind, refs[i])
            if dv_uncontested(cell):
                result = dv_append(result, {"ref": refs[i], "receipt": cell})
            i = i + 1
        let heard = dv_find(actor, "received_speeches", [])
        i = 0
        while i < rt_count(heard):
            if heard[i].speaker == "ward" and heard[i].action_id == "night.ward-claim":
                result = dv_append(result, heard[i])
            i = i + 1
    return result

fn c2_cooperation_rows():
    var rows = []
    let source = campaign_approved("user:2026-10-18-real-owned-cooperation-and-retraction")
    let early = campaign_window(2, 480, 960)
    let offer_when = dv_all([early, dv_fact(campaign_first_night_ref("partner_offered"), false)])
    var offer = c2d_row("quer", "quer.c2.partner.offer", "living_hall", offer_when, dv_true(), "邀请结伴核查文献", "咱们一起去文献工房？我验锁，你核清册，到了现场再说下一步。", source)
    offer = dv_with_many(offer, {"effects": [dv_assign(campaign_first_night_ref("partner_offered"), true)], "public_grants": [campaign_first_night_ref("partner_offered")], "partner_decision": "offer", "opportunity": {"location": "living_hall", "participants": ["detective"], "mode": "all-present"}, "personal_choice": {"group": "quer.partner", "requires": early, "prohibits": dv_fact(campaign_first_night_ref("partner_offered"), true), "promotes": ["evidence", "movement_freedom"], "sacrifices": [], "basis": [source]}})
    rt_push(rows, offer)
    let accept_when = dv_all([early, dv_fact(campaign_first_night_ref("partner_promised"), false)])
    var accept = c2d_row("detective", "detective.c2.partner.accept", "living_hall", accept_when, dv_true(), "答应承担清册核对", "好。我承担清册核对；专业操作由你自己决定。", source)
    accept = dv_with_many(accept, {"received_speech_requirement": {"any_of": [{"speaker": "quer", "action_id": "quer.c2.partner.offer"}, {"speaker": "quer", "action_id": "night.partner"}]}, "effects": [dv_assign(campaign_first_night_ref("partner_promised"), true)], "partner_decision": "accept", "public_grants": [campaign_first_night_ref("partner_promised")], "personal_choice": {"group": "detective.partner", "requires": early, "prohibits": dv_fact(campaign_first_night_ref("partner_promised"), true), "promotes": ["evidence"], "sacrifices": [], "basis": [source]}})
    rt_push(rows, accept)
    let work = c2_work_specs()
    var i = 0
    while i < rt_count(work):
        let item = work[i]
        let decided = campaign_own(item.actor, rt_cat("work.decided.", item.id))
        let undecided = dv_fact(decided, false)
        let item_active = dv_all([item.when, undecided])
        var take = c2d_row(item.actor, rt_cat(item.id, ".undertake"), item.room, item_active, dv_true(), rt_cat("承担：", item.purpose), rt_cat("这一项我来承担：", item.purpose), source)
        var promotes = ["evidence", "measured_work", "records"]
        if item.field == "day_sketch_exposed":
            promotes = ["research"]
        if item.field == "lock_no_pry":
            promotes = ["not_targeted", "movement_freedom", "evidence"]
        take = dv_with_many(take, {"effects": [dv_assign(decided, true), dv_assign(campaign_own(item.actor, rt_cat("work.accepted.", item.id)), true)], "repeatable": false, "work_decision": item.id, "work_reply": item.id, "owned_decision": c2_work_decision(item, "accepted", source), "work_clearance": item.field == "lock_no_pry", "public_observers": campaign_people(), "public_grants": [decided, campaign_own(item.actor, rt_cat("work.accepted.", item.id))], "personal_choice": {"group": rt_cat("work.", item.id), "requires": item_active, "prohibits": dv_fact(decided, true), "promotes": promotes, "sacrifices": [], "require_positive": true, "basis": [source]}})
        if item.field == "wedge_set" or item.field == "lift_mm" or item.field == "double_bolts":
            take = dv_with(take, "received_speech_requirement", {"speaker": "detective", "action_id": rt_cat(item.id, ".request")})
        rt_push(rows, take)
        if item.actor == "quer" and item.field != "lock_no_pry":
            var refuse = c2d_row("quer", rt_cat(item.id, ".refuse-restriction"), item.room, item_active, dv_true(), rt_cat("说明保留意见：", item.purpose), "先前对我的指控还没有向我澄清，却先叫我替你们开锁？把依据说清楚，再谈这次合作。", source)
            refuse = dv_with_many(refuse, {"work_refusal": true, "work_reply": item.id, "repeatable": false, "owned_decision": c2_work_decision(item, "declined", source), "effects": [dv_assign(campaign_own("quer", rt_cat("work.accepted.", item.id)), false), dv_assign(decided, true)], "public_observers": campaign_people(), "public_grants": [decided, campaign_own("quer", rt_cat("work.accepted.", item.id))], "personal_choice": {"group": rt_cat("work.", item.id), "requires": item_active, "prohibits": dv_fact(decided, true), "promotes": ["not_targeted", "movement_freedom", "evidence"], "sacrifices": ["measured_work"], "basis": [source]}})
            rt_push(rows, refuse)
        if item.actor == "quer" or item.actor == "huo" or item.actor == "margaret":
            var requester = "detective"
            if requester != item.actor:
                var invite = c2d_row(requester, rt_cat(item.id, ".request"), item.room, item_active, dv_true(), rt_cat("请求协作：", item.purpose), rt_cat("请你自己判断能否承担这一项：", item.purpose), source)
                invite = dv_with_many(invite, {"repeatable": false, "request": {"target": item.actor, "topic": rt_cat("work.", item.id)}, "opportunity": {"location": item.room, "participants": [item.actor], "mode": "all-present"}})
                rt_push(rows, invite)
        i = i + 1
    let reviewed = dv_all([dv_fact(campaign_ref("case.contract", "joined_inventory"), true), dv_fact(campaign_ref("case.contract", "lock_no_pry"), true)])
    var withdraw = c2d_row("ward", "ward.c2.withdraw-restriction", "document_workshop", reviewed, reviewed, "撤回先前的指控", "清册与锁具已核清。我撤回针对雀儿的窃取指控；代管钥匙的归还也请按现场记录核对。", source)
    withdraw = dv_with_many(withdraw, {"effects": [dv_assign(campaign_own("ward", "restriction_withdrawn"), true)], "public_grants": [campaign_own("ward", "restriction_withdrawn")], "public_observers": campaign_people(), "personal_choice": {"group": "ward.reconsider-restriction", "requires": reviewed, "prohibits": dv_fact(campaign_own("ward", "restriction_withdrawn"), true), "promotes": ["records", "evidence", "witnesses"], "sacrifices": ["ward_authority"], "basis": [source]}})
    rt_push(rows, withdraw)
    var status = c2d_row("quer", "quer.c2.ask-restriction-status", "document_workshop", dv_true(), dv_true(), "询问指控是否撤回", "先前的指控是否已经撤回？请把现在的依据说清楚。", source)
    status = dv_with_many(status, {"concern_question": true, "repeatable": true, "request": {"target": "ward", "topic": "restriction-status"}})
    rt_push(rows, status)
    let withdrawn = dv_fact(campaign_own("ward", "restriction_withdrawn"), true)
    rt_push(rows, dv_with_many(c2d_reply("ward", "ward.c2.reply-withdrawn", "document_workshop", withdrawn, withdrawn, "restriction-status", "答复指控撤回事宜", "我已经撤回先前那项指控。", source), {"repeatable": true, "listeners": ["quer", "detective"], "public_observers": campaign_people(), "public_grants": [campaign_own("ward", "restriction_withdrawn")]}))
    let people = campaign_people()
    let clerks = ["ruan", "ward"]
    var clerk_index = 0
    while clerk_index < rt_count(clerks):
        var person_index = 0
        while person_index < rt_count(people):
            let person = people[person_index]
            if person != clerks[clerk_index]:
                let pending = dv_at_least(campaign_ref("c2.ledger", "pending_registered"), 1)
                var ask = c2d_row(clerks[clerk_index], rt_cat(clerks[clerk_index], rt_cat(".c2.ask-pending-purpose.", person)), "logistics", pending, dv_true(), "询问待核取用的用途", "台账还有待核记号。你有需要说明的取用用途吗？我们按实际记号逐份核对。", source)
                ask = dv_with_many(ask, {"request": {"target": person, "topic": "pending-purpose"}, "opportunity": {"location": "logistics", "participants": [person], "mode": "all-present"}})
                rt_push(rows, ask)
            person_index = person_index + 1
        clerk_index = clerk_index + 1
    var person_index = 0
    while person_index < rt_count(people):
        let person = people[person_index]
        var purposes = ["self"]
        if person == "mora":
            purposes = ["self", "patient"]
        var purpose_index = 0
        while purpose_index < rt_count(purposes):
            let purpose = purposes[purpose_index]
            let pending = dv_at_least(campaign_own(person, rt_cat("pending.", purpose)), 1)
            var text = "这一份是为自己急需取用，已留下待核记号；用途和结余可一起核对。"
            if purpose == "patient":
                text = "这一份是为病人取用，已留下待核记号；实际送达和使用还要分别核对。"
            var reply = c2d_reply(person, rt_cat(person, rt_cat(".c2.clarify-pending.", purpose)), "logistics", pending, pending, "pending-purpose", "说明本人待核取用的用途", text, source)
            reply = dv_with(reply, "effects", [dv_assign(campaign_own(person, rt_cat("purpose_clarified.", purpose)), true)])
            rt_push(rows, reply)
            purpose_index = purpose_index + 1
        person_index = person_index + 1
    let heard_color = {"speaker": "demon", "action_id": "demon.c2.truth-color"}
    let color_time = campaign_window(4, 1050, 1800)
    var question = c2d_row("detective", "detective.c2.color.ask-omission", "living_hall", color_time, dv_true(), "追问遗漏的安全条件", "你只说颜色罕见。还有哪些安全条件没有说明，读数又是什么时候取得的？", source)
    question = dv_with_many(question, {"manual_only": true, "request": {"target": "demon", "topic": "color.safety-omission"}, "received_speech_requirement": heard_color, "opportunity": {"location": "living_hall", "participants": ["demon"], "mode": "all-present"}})
    rt_push(rows, question)
    let color_fact = dv_fact(c2daily_ref("rare_color_layer"), "夹道罕见紫金以太色层")
    var encourage = c2d_row("detective", "detective.c2.color.encourage", "living_hall", color_time, color_fact, "鼓励同伴考虑外出写生", c2_color_encouragement_text(), source)
    let advice_id = "chapter2.color-encouragement"
    encourage = dv_with_many(encourage, {"manual_only": true, "listeners": ["moran", "demon"], "effects": [], "received_speech_requirement": heard_color, "opportunity": {"location": "living_hall", "participants": ["moran"], "mode": "all-present"}, "advice": {"id": advice_id, "topic": "evening-sketch", "targets": ["moran"], "proposed_action_ids": ["moran.c2.sketch.evening.go.false", "moran.c2.sketch.evening.go.true"], "position": "consider", "basis": [source]}, "manipulation": {"advice_id": advice_id, "targets": ["moran"], "method": "selective-truth-color-encouragement", "action_ids": ["moran.c2.move.outdoor_high.outdoor_alley"], "consequence_when": campaign_at("moran", "outdoor_alley"), "basis": [source]}})
    rt_push(rows, encourage)
    let watch_states = [false, true]
    var watch_index = 0
    while watch_index < rt_count(watch_states):
        let watched = watch_states[watch_index]
        let assessment = rt_cat("moran.c2.sketch.evening.go.", rt_show(watched))
        let when = dv_all([c2_night(4), dv_fact(campaign_own("moran", "watched"), watched)])
        let decisions = [true, false]
        var decision_index = 0
        while decision_index < rt_count(decisions):
            let accepted = decisions[decision_index]
            var text = "这条建议我会纳入考虑；是否出去，仍按我的读数、动机和眼前责任决定。"
            if not accepted:
                text = "我暂不采纳这条建议；先按自己实际掌握的情况决定下一步。"
            var reply = c2d_row("moran", rt_cat("moran.c2.color-advice.", rt_cat(rt_show(watched), rt_cat(".", rt_show(accepted)))), "living_hall", when, dv_true(), rt_cat(dv_get({"true": "采纳", "false": "不采纳"}, rt_show(accepted)), "外出建议"), text, source)
            reply = dv_with_many(reply, {"received_speech_requirement": {"speaker": "detective", "action_id": "detective.c2.color.encourage"}, "advice_decision": {"advice_id": advice_id, "accepted": accepted, "assessment_action_id": assessment}})
            rt_push(rows, reply)
            decision_index = decision_index + 1
        watch_index = watch_index + 1
    return rows

// A measurement is an actual local observation. Its cells retain execution
// time and source; the weather epoch observed elsewhere is a different receipt.
fn c2_meter_fields():
    return ["safe", "environment_epoch", "sample_location"]

fn c2_sample_claim(cell):
    let claims = dv_find(cell, "claims", [])
    var latest = false
    var i = 0
    while i < rt_count(claims):
        let claim = claims[i]
        if claim.source == "perception" and claim.origin == "direct" and dv_same(claim.value, cell.value):
            if latest == false or latest.time < claim.time:
                latest = claim
        i = i + 1
    return latest

fn c2_meter_fresh(actor):
    let reading = dv_read(actor.mind, campaign_ref("c2.meter", "safe"))
    let sampled = dv_read(actor.mind, campaign_ref("c2.meter", "environment_epoch"))
    let location = dv_read(actor.mind, campaign_ref("c2.meter", "sample_location"))
    let observed = dv_read(actor.mind, campaign_ref("c2.weather", "environment_epoch"))
    if not dv_uncontested(reading) or not dv_uncontested(sampled) or not dv_uncontested(location):
        return false
    let read_claim = c2_sample_claim(reading)
    let epoch_claim = c2_sample_claim(sampled)
    let location_claim = c2_sample_claim(location)
    if read_claim == false or epoch_claim == false or location_claim == false:
        return false
    if location.value != "outdoor_meter" or read_claim.time != epoch_claim.time or location_claim.time != epoch_claim.time:
        return false
    if not dv_same(read_claim.id[0], epoch_claim.id[0]) or not dv_same(location_claim.id[0], epoch_claim.id[0]):
        return false
    if dv_uncontested(observed) and observed.value != sampled.value:
        return false
    if actor.mind.time - read_claim.time > 30:
        return false
    return true

fn c2_safety_actions(actor):
    var actions = []
    let source = campaign_approved("user:2026-10-18-owned-measurement-and-continuing-duty")
    let fields = c2_meter_fields()
    var sample = c2_inspect_action(actor, "c2.meter", "outdoor_meter", fields, "实测源质计并记录读数", "在源质计安全侧实测，记录读数、采样地点及现场环境标记。", source)
    sample = dv_with(sample, "id", rt_cat(actor, ".c2.sample.meter"))
    sample = dv_with(sample, "grants", dv_append(sample.grants, campaign_ref("c2.weather", "severe_air")))
    rt_push(actions, sample)
    if actor == "margaret" or actor == "huo":
        let id = rt_cat(actor, ".c2.release.support")
        let pre = dv_fact(campaign_own(actor, "support_active"), true)
        let law = dv_axiom("c2_release_support", 1, pre, [dv_assign(campaign_own(actor, "support_active"), false)])
        rt_push(actions, dv_with_many(campaign_surface_action(id, "help", pre, pre, id, [campaign_own(actor, "support_active")], "交接并停止承托", "明确交接并停止承托，未重新就位前不再把这处载荷当作有人维持。", source), {"predict_law": id, "repeatable": true, "public_observers": campaign_people(), "public_grants": [campaign_own(actor, "support_active")]}))
    if dv_has(["detective", "bertrand", "huo"], actor):
        let id = rt_cat(actor, ".c2.guard.take-post")
        let pre = dv_all([c2_night(4), campaign_at(actor, "living_hall"), dv_fact(campaign_own(actor, "guard_commitment"), true), campaign_at("moran", "living_hall"), c2_alive(actor)])
        let law = c2_guard_post_law(actor)
        var post = campaign_surface_action(id, "help", pre, law.premise, id, [campaign_own(actor, "guard_active")], "在门内值守", "留在门内实际值守，留意莫兰和门口的动静。", source)
        post = dv_with_many(post, {"speech": dv_with_many(campaign_speech(campaign_at(actor, "living_hall"), source, "actual-guard-post"), {"surface": "我已经在门内就位，这一班由我实际值守。", "channel": "local"}), "listeners": campaign_people()})
        post = dv_with(post, "personal_choice", {"group": rt_cat("guard-duty.", actor), "requires": pre, "prohibits": dv_fact(campaign_own(actor, "guard_active"), true), "promotes": ["patient_priority", "safety", "measured_work"], "sacrifices": ["research"], "basis": [source]})
        rt_push(actions, dv_with_many(post, {"repeatable": true, "public_observers": campaign_people(), "public_grants": [campaign_own(actor, "guard_active")]}))
        let release_id = rt_cat(actor, ".c2.guard.release-post")
        let release_pre = dv_all([campaign_at(actor, "living_hall"), dv_fact(campaign_own(actor, "guard_active"), true)])
        var release = campaign_surface_action(release_id, "help", release_pre, release_pre, release_id, [campaign_own(actor, "guard_active"), campaign_own(actor, "guard_commitment")], "交接并离开值守位置", "我现在交接离岗；接班人实际到岗前，不要把这里当作仍有人值守。", source)
        release = dv_with_many(release, {"repeatable": true, "owned_decision": c2_guard_decision(actor, "released", source), "personal_choice": {"group": rt_cat("guard-duty.", actor), "requires": release_pre, "prohibits": dv_not(dv_true()), "promotes": ["research"], "sacrifices": ["patient_priority", "safety", "measured_work"], "require_positive": true, "basis": [source]}, "speech": dv_with_many(campaign_speech(campaign_at(actor, "living_hall"), source, "actual-guard-release"), {"surface": release.surface, "channel": "local"}), "listeners": campaign_people(), "public_grants": [campaign_own(actor, "guard_active"), campaign_own(actor, "guard_commitment")]})
        rt_push(actions, release)
    return actions

法则 c2_guard_post_law，给定 行动者：
    当 行动者 位于 起居厅。
    并且 "moran" 位于 起居厅。
    并且 c2_alive(行动者)。
    并且 c2_night(4)。
    则 campaign_own(行动者, "guard_active") 变为 true。

fn c2_safety_install(domain, adoptions, actor, mode):
    let source = [campaign_approved("user:2026-10-18-owned-measurement-and-continuing-duty")]
    if actor == "margaret" or actor == "huo":
        let pre = dv_fact(campaign_own(actor, "support_active"), true)
        dv_adopt_into(domain, adoptions, campaign_method(rt_cat(actor, ".c2.release.support"), dv_axiom("c2_release_support", 1, pre, [dv_assign(campaign_own(actor, "support_active"), false)])), mode, 1, source)
    if dv_has(["detective", "bertrand", "huo"], actor):
        dv_adopt_into(domain, adoptions, campaign_method(rt_cat(actor, ".c2.guard.take-post"), c2_guard_post_law(actor)), mode, 1, source)
        let pre = dv_all([campaign_at(actor, "living_hall"), dv_fact(campaign_own(actor, "guard_active"), true)])
        dv_adopt_into(domain, adoptions, campaign_method(rt_cat(actor, ".c2.guard.release-post"), dv_axiom("c2_guard_release_law", 1, pre, [dv_assign(campaign_own(actor, "guard_active"), false), dv_assign(campaign_own(actor, "guard_commitment"), false)])), mode, 1, source)
    return true

fn c2_received_requirement(actor, requirement):
    let receipts = dv_find(actor, "received_speeches", [])
    if dv_has_key(requirement, "any_of"):
        var i = 0
        while i < rt_count(requirement.any_of):
            if dvp_received_speech_matches(receipts, requirement.any_of[i]):
                return true
            i = i + 1
        return false
    return dvp_received_speech_matches(receipts, requirement)

fn c2_owned_safety_notice(actor):
    if c2_received_requirement(actor, {"speaker": "demon", "action_id": "demon.c2.truth-color"}):
        return true
    if dv_truth(actor.mind, dv_fact(campaign_ref("c2.weather", "earthquake_recent"), true)) == "true":
        return true
    if dv_truth(actor.mind, dv_fact(campaign_ref("c2.weather", "wind"), false)) == "true":
        return true
    return dv_truth(actor.mind, dv_fact(campaign_ref("c2.meter", "safe"), false)) == "true"

fn c2_owned_recheck_needed(actor):
    let seen = dv_read(actor.mind, campaign_ref("c2.meter", "safe"))
    if not dv_uncontested(seen):
        return true
    return not c2_meter_fresh(actor)

// Only owned observations and actual request receipts change the chooser view.
// Physical laws retain bodily feasibility and never acquire this view's beliefs.
fn c2_refresh_content_actions(actor):
    let original_actions = actor.actions
    var actions = []
    var i = 0
    let notice = c2_owned_safety_notice(actor)
    let recheck = c2_owned_recheck_needed(actor)
    let adopted_stop = dv_truth(actor.mind, dv_fact(campaign_own(actor.id, "accepted.seal_plan"), true)) == "true"
    while i < rt_count(original_actions):
        var action = original_actions[i]
        if action.id == "bertrand.c2.search.moran-alley":
            var heard = "moran.c2.sketch.evening.go.false"
            if c2_received_requirement(actor, {"speaker": "moran", "action_id": "moran.c2.sketch.evening.go.true"}):
                heard = "moran.c2.sketch.evening.go.true"
            var speaker = "moran"
            if not c2_received_requirement(actor, {"speaker": speaker, "action_id": heard}):
                speaker = "demon"
                heard = "demon.c2.relay.moran-outing.false"
                if c2_received_requirement(actor, {"speaker": speaker, "action_id": "demon.c2.relay.moran-outing.true"}):
                    heard = "demon.c2.relay.moran-outing.true"
            action = dv_with(action, "received_speech_requirement", {"speaker": speaker, "action_id": heard})
        if dv_has_key(action, "partner_decision"):
            let base = dv_find(action, "owned_precondition_base", action.precondition)
            let choice = dv_find(action, "owned_choice_base", action.personal_choice)
            var qualification = dv_true()
            if c2_partner_already_decided(actor, action.partner_decision):
                qualification = dv_not(dv_true())
            action = dv_with_many(action, {"owned_precondition_base": base, "owned_choice_base": choice, "precondition": dv_all([base, qualification]), "personal_choice": dv_with(choice, "requires", dv_all([choice.requires, qualification]))})
        if dv_has_key(action, "work_reply"):
            let request = dvs_pending_request(actor, {"response_topic": rt_cat("work.", action.work_reply)})
            if 0 < rt_count(request):
                action = dv_with_many(action, {"response_topic": rt_cat("work.", action.work_reply), "requires_actual_request": true})
            else:
                action = dv_without(dv_without(action, "response_topic"), "requires_actual_request")
        if dv_has_key(action, "work_decision"):
            var choice = dv_find(action, "owned_choice_base", action.personal_choice)
            action = dv_with(action, "owned_choice_base", choice)
            let request = dvs_pending_request(actor, {"response_topic": rt_cat("work.", action.work_decision)})
            if 0 < rt_count(request):
                choice = dv_with(choice, "basis", dv_append(choice.basis, {"source_event": request.source_event, "parse_event": request.parse_event, "requester": request.requester}))
            if dv_truth(actor.mind, dv_fact(campaign_first_night_ref("partner_promised"), true)) == "true":
                choice = dv_with(choice, "basis", dv_append(choice.basis, {"ref": campaign_first_night_ref("partner_promised"), "receipt": dv_read(actor.mind, campaign_first_night_ref("partner_promised"))}))
            if actor.id == "quer" and c2_quer_concerned(actor) and not dv_find(action, "work_clearance", false):
                choice = dv_with(choice, "sacrifices", ["not_targeted", "movement_freedom"])
            if actor.id == "quer" and dv_truth(actor.mind, dv_fact(campaign_own("ward", "restriction_withdrawn"), true)) == "true":
                choice = dv_with(choice, "basis", dv_append(choice.basis, {"ref": campaign_own("ward", "restriction_withdrawn"), "receipt": dv_read(actor.mind, campaign_own("ward", "restriction_withdrawn"))}))
            if actor.id == "quer" and dv_truth(actor.mind, dv_fact(campaign_ref("case.contract", "cabinet_key_holder"), "quer")) == "true":
                choice = dv_with(choice, "basis", dv_append(choice.basis, {"ref": campaign_ref("case.contract", "cabinet_key_holder"), "receipt": dv_read(actor.mind, campaign_ref("case.contract", "cabinet_key_holder"))}))
            action = dv_with(action, "personal_choice", dv_with(choice, "basis", c2_cooperation_basis(actor, choice.basis)))
        if actor.id == "quer" and dv_has_key(action, "work_operation"):
            let source = campaign_approved("user:2026-10-18-owned-cooperation-choice")
            var sacrifices = []
            if c2_quer_concerned(actor):
                sacrifices = ["not_targeted", "movement_freedom"]
            action = dv_with(action, "personal_choice", {"group": rt_cat("work.", action.work_operation), "requires": action.precondition, "prohibits": dv_not(dv_true()), "promotes": ["evidence", "measured_work"], "sacrifices": sacrifices, "require_positive": true, "basis": c2_cooperation_basis(actor, [source])})
        if actor.id == "quer" and dv_has_key(action, "personal_choice") and dv_find(action.personal_choice, "group", "") != "quer.partner":
            if dv_has_key(action, "work_refusal"):
                let base = dv_find(action, "owned_precondition_base", action.precondition)
                let choice = dv_find(action, "owned_choice_base", action.personal_choice)
                let surface = dv_find(action, "owned_surface_base", action.surface)
                action = dv_with_many(action, {"owned_precondition_base": base, "owned_choice_base": choice, "owned_surface_base": surface, "surface": surface, "speech": dv_with(action.speech, "surface", surface), "precondition": base, "personal_choice": choice})
                action = dv_with(action, "personal_choice", dv_with(choice, "basis", c2_cooperation_basis(actor, choice.basis)))
                if c2_quer_restricted(actor):
                    let text = "我实际听到过先限制我自由的要求，尚未收到撤回说明。把依据说清楚，再谈这次合作。"
                    action = dv_with_many(action, {"surface": text, "speech": dv_with(action.speech, "surface", text)})
                if not c2_quer_concerned(actor):
                    action = dv_with(action, "precondition", dv_not(dv_true()))
                    action = dv_with(action, "personal_choice", dv_with(choice, "requires", dv_not(dv_true())))
        if dv_find(action, "concern_question", false):
            let base = dv_find(action, "owned_precondition_base", action.precondition)
            let surface = dv_find(action, "owned_surface_base", action.surface)
            action = dv_with_many(action, {"owned_precondition_base": base, "owned_surface_base": surface, "surface": surface, "speech": dv_with(action.speech, "surface", surface)})
            var qualification = dv_not(dv_true())
            if c2_quer_concerned(actor):
                qualification = dv_true()
            action = dv_with(action, "precondition", dv_all([base, qualification]))
            if c2_quer_restricted(actor):
                let text = "我实际听到的自由限制是否已经撤回？请把现在的依据说清楚。"
                action = dv_with_many(action, {"surface": text, "speech": dv_with(action.speech, "surface", text)})
        if actor.id == "ward" and (action.id == "ward.c2.withdraw-restriction" or action.id == "ward.c2.reply-withdrawn"):
            if dv_has(dv_find(actor, "completed_actions", []), "night.ward-claim") or dv_truth(actor.mind, c2_quer_restriction()) == "true":
                var text = "我已经撤回先前的指控和由我提出的自由限制。"
                if action.id == "ward.c2.withdraw-restriction":
                    text = "清册与锁具已核清。我撤回先前的指控和由我提出的自由限制；钥匙交接另按实际记录核对。"
                action = dv_with_many(action, {"surface": text, "speech": dv_with(action.speech, "surface", text)})
        if dv_find(action, "safety_warning", false) or dv_find(action, "guard_decision", false):
            let base = dv_find(action, "owned_precondition_base", action.precondition)
            action = dv_with(action, "owned_precondition_base", base)
            var qualification = dv_not(dv_true())
            if notice:
                qualification = dv_true()
            action = dv_with(action, "precondition", dv_all([base, qualification]))
            let choice = dv_find(action, "owned_choice_base", action.personal_choice)
            action = dv_with_many(action, {"owned_choice_base": choice, "personal_choice": dv_with(choice, "requires", dv_all([choice.requires, qualification]))})
        if dv_has_key(action, "owned_safety_choice"):
            var qualification = action.owned_safety_choice
            if adopted_stop and recheck and action.law == "moran.c2.sketch.evening.go":
                qualification = dv_not(dv_true())
            action = dv_with(action, "precondition", qualification)
            action = dv_with(action, "personal_choice", dv_with(action.personal_choice, "requires", qualification))
        // A supporter can physically leave; doing so releases the operation.
        // Its own continuing-duty goal is considered by the shared planner.
        rt_push(actions, action)
        i = i + 1
    let original_rules = dv_find(actor.policy, "norm_rules", [])
    var rules = []
    i = 0
    while i < rt_count(original_rules):
        var rule = original_rules[i]
        if rule.id == "seal_plan":
            var applies = dv_not(dv_true())
            if recheck:
                applies = dv_fact(campaign_own(actor.id, "accepted.seal_plan"), true)
            rule = dv_with(rule, "available_when", applies)
        rt_push(rules, rule)
        i = i + 1
    return dv_with_many(actor, {"actions": actions, "policy": dv_with(actor.policy, "norm_rules", rules)})

fn c2_safety_goals(actor):
    var goals = []
    let source = [campaign_approved("user:2026-10-18-owned-measurement-and-continuing-duty")]
    let work = c2_work_specs()
    var work_index = 0
    while work_index < rt_count(work):
        let item = work[work_index]
        if item.actor == actor.id:
            let candidate = dvp_find_action(actor.actions, rt_cat(item.id, ".undertake"))
            if candidate != false and dvp_owned_decision_ready(actor, candidate, actor.mind):
                rt_push(goals, dv_with_many(campaign_goal(c2_work_accepted(actor.id, item.id), item.when, [campaign_approved("user:2026-10-18-real-owned-cooperation-and-retraction")]), {"navigation_room": item.room, "navigation_methods": [rt_cat(item.id, ".undertake")]}))
        work_index = work_index + 1
    let outward = dv_truth(actor.mind, dv_fact(campaign_own(actor.id, "accepted.measurement_pause"), true)) == "true" or dv_truth(actor.mind, dv_fact(campaign_own(actor.id, "accepted.seal_plan"), true)) == "true" or dv_truth(actor.mind, dv_fact(campaign_own(actor.id, "accepted.open_plan"), true)) == "true"
    if outward and c2_owned_recheck_needed(actor):
        let previous = dv_read(actor.mind, campaign_ref("c2.meter", "safe"))
        let sample = c2_sample_claim(previous)
        let environment = dv_read(actor.mind, campaign_ref("c2.weather", "environment_epoch"))
        var minimum = 0
        if sample != false:
            minimum = sample.time + 30
        if dv_uncontested(environment) and (sample == false or sample.time < environment.time):
            minimum = environment.time
        rt_push(goals, dv_with_many(campaign_observation_goal(campaign_ref("c2.meter", "safe"), dv_at_least(campaign_clock(), 1980), source, minimum), {"navigation_room": "outdoor_meter", "navigation_methods": [rt_cat(actor.id, ".c2.sample.meter")]}))
    if dv_has(["detective", "bertrand", "huo"], actor.id):
        // A fresh unsafe sample completes the empirical part of an adopted
        // pause. Return to the agreed door instead of polling away its duty.
        if dv_truth(actor.mind, dv_fact(campaign_own(actor.id, "accepted.measurement_pause"), true)) == "true" and dv_truth(actor.mind, dv_fact(campaign_ref("c2.meter", "safe"), false)) == "true":
            let resolved = dv_truth(actor.mind, dv_fact(campaign_ref("case.astral", "evening_choice"), "go")) == "true" or dv_truth(actor.mind, dv_fact(campaign_ref("case.astral", "evening_choice"), "stay")) == "true"
            if not resolved:
                rt_push(goals, dv_with_many(campaign_goal(campaign_at(actor.id, "living_hall"), campaign_window(4, 1050, 1800), source), {"navigation_room": "living_hall", "maintain_presence": true}))
        if c2_owned_safety_notice(actor):
            let candidate = dvp_find_action(actor.actions, rt_cat(actor.id, ".c2.guard.undertake"))
            if candidate != false and dvp_owned_decision_ready(actor, candidate, actor.mind):
                rt_push(goals, dv_with_many(campaign_goal(dv_fact(campaign_own(actor.id, "guard_commitment"), true), c2_night(4), source), {"navigation_room": "living_hall", "navigation_methods": [rt_cat(actor.id, ".c2.guard.undertake")]}))
        rt_push(goals, dv_with_many(campaign_goal(dv_fact(campaign_own(actor.id, "guard_active"), true), dv_all([c2_night(4), dv_fact(campaign_own(actor.id, "guard_commitment"), true)]), source), {"navigation_room": "living_hall", "navigation_methods": [rt_cat(actor.id, ".c2.guard.take-post")]}))
        rt_push(goals, campaign_goal(campaign_at(actor.id, "living_hall"), dv_all([c2_night(4), dv_fact(campaign_own(actor.id, "guard_active"), true)]), source))
    if dv_has(["margaret", "huo"], actor.id):
        rt_push(goals, campaign_goal(campaign_at(actor.id, "logistics"), dv_all([campaign_window(3, 720, 840), dv_fact(campaign_own(actor.id, "support_active"), true), dv_fact(campaign_ref("c2.granary", "total_store_locked"), true)]), source))
        var job = "margaret.c2.granary.wedge"
        if actor.id == "huo":
            job = "huo.c2.granary.jack"
        rt_push(goals, dv_with_many(campaign_goal(dv_fact(campaign_own(actor.id, "support_active"), true), dv_all([campaign_window(3, 720, 840), c2_work_accepted(actor.id, job), dv_fact(campaign_ref("c2.granary", "total_store_locked"), true)]), source), {"navigation_room": "logistics", "navigation_methods": [job]}))
    if actor.id == "moran":
        var minimum = 5370
        let guards = ["detective", "bertrand", "huo"]
        var i = 0
        while i < rt_count(guards):
            let position = dv_read(actor.mind, campaign_position_ref(guards[i]))
            let active = dv_read(actor.mind, campaign_own(guards[i], "guard_active"))
            if dv_uncontested(position):
                minimum = dv_max(minimum, position.time)
            if dv_uncontested(active):
                minimum = dv_max(minimum, active.time)
            i = i + 1
        rt_push(goals, c2i_watch_goal(actor, c2_night(4), source, minimum))
    return goals

// Owner motives are declarations; opportunities and consequences still require real execution.
叙述 c2_color_encouragement_text：
    那层颜色确实罕见。莫兰，想画就再去看一眼吧。

fn c2m_source():
    return campaign_approved("user:2026-10-18-personal-active-motives")

fn c2m_row(actor, suffix, room, object, field, requirements, effects, label, text, promotes, sacrifices, private):
    return {"actor": actor, "id": rt_cat(actor, rt_cat(".c2.motive.", suffix)), "room": room, "object": object, "field": field, "requirements": requirements, "effects": effects, "label": label, "text": text, "promotes": promotes, "sacrifices": sacrifices, "private": private}

fn c2m_rows():
    let key = ["authored-declaration", "c2m_rows"]
    let cached = rt_memo_get([], key)
    if cached[0]:
        return cached[1]
    return rt_memo_put([], key, c2m_rows_build())

fn c2m_rows_build():
    let contract = "case.contract"
    let astral = "case.astral"
    let logistics = "case.logistics"
    let ledger = "c2.ledger"
    var rows = []
    rt_push(rows, c2m_row("ward", "hide-inventory", "document_workshop", contract, "inventory_hidden", [campaign_window(2, 700, 800), dv_fact(campaign_ref(contract, "joined_inventory"), false), dv_fact(campaign_ref(contract, "emergency_inventory_majority"), false)], [dv_assign(campaign_ref(contract, "blue_ink"), true)], "将清册收入铁匣", "把清册收进铁匣，手边的蓝墨蹭在匣口；我想先保住自己的处置权。", ["ward_authority", "pursue_desire"], ["evidence", "understand_cost"], true))
    rt_push(rows, c2m_row("lucian", "obstruct-resonance", "quiet_room", astral, "pipe_blocked", [campaign_window(2, 820, 940), dv_fact(campaign_ref(astral, "vent_pressure_formula"), false)], [dv_assign(campaign_ref(astral, "formula_partial"), true)], "堵住传声管并擦去算式", "堵住传声管，擦去压差式的一部分；这次共鸣的解释权，我想留在自己手里。", ["resonance_exclusivity", "pursue_desire"], ["evidence", "understand_cost"], true))
    rt_push(rows, c2m_row("moran", "hide-draft", "quiet_room", astral, "draft_hidden", [campaign_window(3, 480, 560), dv_fact(campaign_ref(astral, "complete_draft"), false)], [dv_assign(campaign_ref(astral, "misleading_sketch"), true)], "藏起底稿并替换草图", "把底稿藏进画夹暗层，换上一张容易误读的草图；我怕他们据此把我隔离。", ["avoid_isolation", "pursue_desire"], ["evidence", "understand_cost"], true))
    rt_push(rows, c2m_row("veronica", "etch-drawer", "white_tower_safe", logistics, "drawer_etched", [campaign_window(2, 700, 800), dv_fact(campaign_ref(logistics, "r07_skin_test"), false)], [dv_assign(campaign_ref(logistics, "r07_label_changed"), true)], "酸蚀日志抽屉并更换标签", "用酸蚀住日志抽屉，换去R-07标签；我不想让这份记录先变成伦理审查的罪证。", ["avoid_ethics_review", "pursue_desire"], ["records", "evidence", "understand_cost"], true))
    rt_push(rows, c2m_row("ruan", "leave-latch", "logistics", ledger, "audit_gap_created", [campaign_window(3, 1080, 1260), dv_fact(campaign_ref("c2.granary", "total_store_locked"), true)], [dv_assign(campaign_ref(ledger, "ration_latch_unfastened"), true), dv_assign(campaign_ref(ledger, "verification_ink"), true), dv_assign(campaign_ref(ledger, "drawer_contact_since_mark"), false)], "留下配给屉暗扣与校验墨点", "主仓还没开。我故意留下配给屉暗扣和校验墨点，想用一次可追查的缺口迫使大家认真对账。", ["controlled_audit", "records", "pursue_desire"], ["safety", "understand_cost"], true))
    let inspected = dv_all([dv_fact(campaign_ref(contract, "blue_ink"), true), dv_fact(campaign_ref(contract, "cabinet_key_holder"), "ward"), dv_fact(campaign_ref(contract, "lock_no_pry"), true)])
    rt_push(rows, c2m_row("ward", "hand-inventory", "document_workshop", contract, "inventory_recovered", [campaign_window(2, 840, 960), dv_fact(campaign_ref(contract, "inventory_hidden"), true), inspected], [], "打开铁匣交出清册", "蓝墨、锁具和代管记录都已经摆在面前。我自己打开铁匣，把清册交出来供现场核对。", ["records", "evidence", "witnesses"], ["ward_authority"], false))
    rt_push(rows, c2m_row("quer", "open-inventory-box", "document_workshop", contract, "inventory_recovered", [dv_fact(campaign_ref(contract, "inventory_hidden"), true), dv_fact(campaign_ref(contract, "blue_ink"), true), dv_fact(campaign_own("quer", "can_lock"), true)], [], "检视并打开铁匣", "沿蓝墨痕找到铁匣，实际拆开匣锁，取出里面的清册。", ["evidence", "measured_work"], [], false))
    rt_push(rows, c2m_row("quer", "clear-pipe", "quiet_room", astral, "pipe_cleared", [dv_fact(campaign_ref(astral, "pipe_blocked"), true), dv_fact(campaign_ref(astral, "formula_partial"), true)], [], "疏通传声管", "找到堵塞处，拆开接头，实际疏通传声管；压差式仍须重新测量核对。", ["evidence", "measured_work"], [], false))
    rt_push(rows, c2m_row("detective", "recover-draft", "quiet_room", astral, "draft_recovered", [dv_fact(campaign_ref(astral, "draft_hidden"), true), dv_fact(campaign_ref(astral, "misleading_sketch"), true), dv_fact(campaign_ref(astral, "moran_reassured"), true), campaign_at("moran", "quiet_room")], [], "逐层检视画夹", "在莫兰面前逐层检查画夹，找回藏起的原稿，留待本人展出并逐页核对。", ["evidence", "patient_priority"], [], false))
    rt_push(rows, c2m_row("quer", "neutralize-drawer", "white_tower_safe", logistics, "drawer_neutralized", [dv_fact(campaign_ref(logistics, "drawer_etched"), true), dv_fact(campaign_ref(logistics, "r07_label_changed"), true)], [], "检查并中和抽屉残酸", "现场检查酸痕和换签处，中和残酸，松开抽屉；日志还要实际取出。", ["evidence", "measured_work", "safety"], [], false))
    rt_push(rows, c2m_row("lucian", "decoy-poem", "living_hall", contract, "blackboard_poem", [campaign_window(2, 600, 900)], [], "在黑板题诗", "在黑板上题写诗句，把废稿留在现场。", ["resonance_exclusivity", "pursue_desire"], ["not_targeted"], false))
    rt_push(rows, c2m_row("quer", "take-seal", "living_hall", contract, "seal_taken", [campaign_at("ward", "living_hall"), dv_fact(campaign_ref("c2.seal", "holder"), "ward")], [dv_assign(campaign_own("ward", "seal_present"), false), dv_assign(campaign_own("quer", "seal_present"), true), dv_assign(campaign_ref("c2.seal", "holder"), "quer"), dv_assign(campaign_ref("c2.seal", "location"), "")], "取走临时治安印章", "在沃德所在现场取走临时治安印章，暂时带在身上。", ["avoid_isolation", "measured_work"], ["not_targeted"], false))
    rt_push(rows, c2m_row("ward", "accuser-loss", "document_workshop", contract, "seal_lost", [campaign_window(2, 700, 1000), dv_fact(campaign_own("ward", "seal_present"), false)], [dv_assign(campaign_ref(contract, "ward_accusing"), true)], "检查随身印章", "检查随身保管处，发现临时治安印章已不在手里，要求追查去向。", ["ward_authority", "pursue_desire"], ["solidarity"], false))
    rt_push(rows, c2m_row("quer", "hide-seal-piano", "resonance_hall", contract, "seal_in_piano", [dv_fact(campaign_ref("c2.seal", "holder"), "quer")], [dv_assign(campaign_own("quer", "seal_present"), false), dv_assign(campaign_ref("c2.seal", "holder"), ""), dv_assign(campaign_ref("c2.seal", "location"), "resonance_hall.piano"), dv_assign(campaign_ref(contract, "seal_in_cistern"), false)], "将印章藏入钢琴", "将随身带来的临时治安印章藏入大钢琴内。", ["avoid_isolation", "measured_work"], ["not_targeted"], false))
    rt_push(rows, c2m_row("ruan", "retrieve-seal-piano", "resonance_hall", contract, "seal_taken_by_ruan", [dv_fact(campaign_ref(contract, "seal_in_piano"), true)], [dv_assign(campaign_own("ruan", "seal_present"), true), dv_assign(campaign_ref("c2.seal", "holder"), "ruan"), dv_assign(campaign_ref("c2.seal", "location"), ""), dv_assign(campaign_ref(contract, "seal_in_piano"), false)], "检视钢琴内部", "核对钢琴内实际藏印处，将印章取出带走。", ["controlled_audit", "pursue_desire"], ["safety"], true))
    rt_push(rows, c2m_row("ruan", "sink-seal-cistern", "logistics", contract, "seal_in_cistern", [dv_fact(campaign_ref("c2.seal", "holder"), "ruan")], [dv_assign(campaign_own("ruan", "seal_present"), false), dv_assign(campaign_ref("c2.seal", "holder"), ""), dv_assign(campaign_ref("c2.seal", "location"), "logistics.cistern"), dv_assign(campaign_ref(contract, "seal_in_piano"), false), dv_assign(campaign_ref(contract, "daotuoxue_trap"), true)], "将印章放入水窖滤网槽", "将实际带来的印章放入水窖滤网槽，留下可供现场追查的物件。", ["controlled_audit", "pursue_desire"], ["safety"], true))
    return rows

fn c2m_fields():
    return [{"object": "case.contract", "room": "living_hall", "fields": ["blackboard_poem"]}, {"object": "case.contract", "room": "resonance_hall", "fields": ["seal_in_piano"]}, {"object": "case.contract", "room": "logistics", "fields": ["seal_in_cistern", "daotuoxue_trap"]}, {"object": "case.contract", "room": "document_workshop", "fields": ["inventory_hidden", "inventory_recovered", "blue_ink", "lock_no_pry", "cabinet_key_holder", "joined_inventory", "emergency_inventory_majority", "seal_lost", "ward_accusing"]}, {"object": "case.astral", "room": "quiet_room", "fields": ["pipe_blocked", "formula_partial", "pipe_cleared", "draft_hidden", "misleading_sketch", "draft_recovered", "moran_reassured", "vent_pressure_formula", "complete_draft"]}, {"object": "case.logistics", "room": "white_tower_safe", "fields": ["drawer_etched", "r07_label_changed", "drawer_neutralized", "r07_skin_test"]}, {"object": "c2.ledger", "room": "logistics", "fields": ["audit_gap_created", "ration_latch_unfastened", "verification_ink", "ink_disturbed", "counted", "reserve_received", "day_recorded", "night_recorded", "pending_registered"]}]

fn c2m_initialize(world):
    var result = world
    if not dv_read(result, campaign_ref("c2.ledger", "drawer_contact_since_mark")).known:
        result = dv_store(result, campaign_ref("c2.ledger", "drawer_contact_since_mark"), dv_field(false))
    let internal = ["seal_taken", "seal_taken_by_ruan"]
    var internal_index = 0
    while internal_index < rt_count(internal):
        let ref = campaign_ref("case.contract", internal[internal_index])
        if not dv_read(result, ref).known:
            result = dv_store(result, ref, dv_field(false))
        internal_index = internal_index + 1
    let groups = c2m_fields()
    var i = 0
    while i < rt_count(groups):
        var j = 0
        while j < rt_count(groups[i].fields):
            let field = groups[i].fields[j]
            // Existing evidence and unknown custody are retained. Only newly declared acts start undone.
            if not dv_read(result, campaign_ref(groups[i].object, field)).known and field != "cabinet_key_holder":
                var initial = false
                result = dv_store(result, campaign_ref(groups[i].object, field), dv_field(initial))
            j = j + 1
        i = i + 1
    return result

fn c2m_ready(row):
    var conditions = dv_append(row.requirements, dv_all([campaign_at(row.actor, row.room), c2_can_act(row.actor)]))
    if row.id != "quer.c2.motive.take-seal" and row.id != "ruan.c2.motive.retrieve-seal-piano":
        rt_push(conditions, dv_fact(campaign_ref(row.object, row.field), false))
    if row.private:
        rt_push(conditions, dv_fact(campaign_own(row.actor, "private_motive"), true))
    return dv_all(conditions)

fn c2m_authority(row):
    var conditions = [c2m_ready(row)]
    if row.id == "ruan.c2.motive.retrieve-seal-piano":
        rt_push(conditions, dv_fact(campaign_ref("c2.seal", "holder"), ""))
        rt_push(conditions, dv_fact(campaign_ref("c2.seal", "location"), "resonance_hall.piano"))
    if row.private:
        let people = dv_append(campaign_people(), "demon")
        var i = 0
        while i < rt_count(people):
            if people[i] != row.actor:
                rt_push(conditions, dv_not(campaign_at(people[i], row.room)))
            i = i + 1
    return dv_all(conditions)

axiom c2m_law(row, mode):
    var premise = c2m_authority(row)
    if mode == "predict":
        premise = c2m_ready(row)
    return dv_axiom("c2m_law", 1, premise, c2m_concat([dv_assign(campaign_ref(row.object, row.field), true)], row.effects))

fn c2m_install(domain, adoptions, actor, mode):
    if actor == "ruan":
        dv_adopt_into(domain, adoptions, campaign_method("c2.drawer.ink-contact", c2m_ink_contact_law()), mode, 1, [c2m_source()])
    let rows = c2m_rows()
    var i = 0
    while i < rt_count(rows):
        if rows[i].actor == actor:
            dv_adopt_into(domain, adoptions, campaign_method(rows[i].id, c2m_law(rows[i], mode)), mode, 1, [c2m_source()])
        i = i + 1
    return true

fn c2m_actions(actor):
    var result = []
    let rows = c2m_rows()
    var i = 0
    while i < rt_count(rows):
        let row = rows[i]
        if row.actor == actor:
            var grants = [campaign_ref(row.object, row.field)]
            var j = 0
            while j < rt_count(row.effects):
                rt_push(grants, row.effects[j].ref)
                j = j + 1
            let ready = c2m_ready(row)
            var action = dv_with(campaign_surface_action(row.id, "experiment", ready, c2m_authority(row), row.id, grants, row.label, row.text, c2m_source()), "predict_law", row.id)
            action = dv_with(action, "personal_choice", {"group": row.id, "requires": ready, "prohibits": dv_fact(campaign_ref(row.object, row.field), true), "promotes": row.promotes, "sacrifices": row.sacrifices, "require_positive": true, "basis": [c2m_source()]})
            if row.private:
                action = dv_with_many(action, {"private_execution": {"requires": ready, "benefit": {"policy_key": "drive"}, "resource_cost": {"policy_key": "caution"}, "basis": [c2m_source()]}, "opportunity_requirement": {"location": row.room, "participants": c2m_other_people(actor), "mode": "none-present"}})
            else:
                action = dv_with_many(action, {"public_observers": campaign_people(), "public_grants": grants})
            rt_push(result, action)
        i = i + 1
    let visible_custody = dv_all([campaign_at(actor, "living_hall"), campaign_at("ward", "living_hall")])
    let held_custody = dv_all([visible_custody, dv_fact(campaign_ref("c2.seal", "holder"), "ward")])
    rt_push(result, dv_with(campaign_surface_action(rt_cat(actor, ".c2.inspect.seal.ward"), "inspect", visible_custody, held_custody, "", [campaign_ref("c2.seal", "holder")], "检视临时治安印章", "在同一现场查看沃德随身保管的临时治安印章。", c2m_source()), "repeatable", true))
    let groups = c2m_fields()
    i = 0
    while i < rt_count(groups):
        let group = groups[i]
        var inspect = c2_inspect_action(actor, group.object, group.room, group.fields, "检视现场实物与痕迹", "在现场查看实物的位置、痕迹和操作后的状态，不据此认定是谁做的。", c2m_source())
        inspect = dv_with(inspect, "id", rt_cat(actor, rt_cat(".c2.motive.inspect.", rt_cat(group.object, rt_cat(".", group.room)))))
        if group.object == "c2.ledger":
            inspect = dv_with(inspect, "grants", dv_append(inspect.grants, campaign_ref("c2.counter", "remaining")))
            let comparison = c2_visible_line(dv_fact(campaign_ref("c2.ledger", "verification_ink"), true), "现场还剩{库存}份；起始登记{起始}份，新增存粮登记{新增}份，白日领取{白日}份，夜间补记{补记}份，待补用途{待记}份。结合墨点扰动与这些实物、登记继续核对；墨痕本身不能确定取用次数和取用者。", [c2_visible_binding("库存", campaign_ref("c2.counter", "remaining"), {}), c2_visible_binding("起始", campaign_ref("c2.ledger", "counted"), {}), c2_visible_binding("新增", campaign_ref("c2.ledger", "reserve_received"), {}), c2_visible_binding("白日", campaign_ref("c2.ledger", "day_recorded"), {}), c2_visible_binding("补记", campaign_ref("c2.ledger", "night_recorded"), {}), c2_visible_binding("待记", campaign_ref("c2.ledger", "pending_registered"), {})], c2m_source())
            inspect = dv_with(inspect, "presentation", dv_with(inspect.presentation, "lines", dv_append(inspect.presentation.lines, comparison)))
        rt_push(result, inspect)
        i = i + 1
    return result

// Cache pure declaration assembly only. The caller still checks private
// completion before requesting travel, and navigation eligibility stays live.
fn c2m_row_goal(row, id, when, completion, travel):
    let key = ["c2m-row-goal-declaration-v1", id, when, completion, travel]
    let cached = rt_memo_get(row, key)
    if cached[0]:
        return cached[1]
    var goal = false
    if travel:
        goal = dv_with_many(campaign_goal(campaign_at(id, row.room), when, [c2m_source()]), {"navigation_completion": campaign_at(id, row.room), "navigation_room": row.room, "navigation_requirements": [], "navigation_methods": [row.id]})
    else:
        goal = dv_with_many(campaign_goal(completion, when, [c2m_source()]), {"navigation_completion": completion, "navigation_room": row.room, "navigation_requirements": row.requirements, "navigation_methods": [row.id]})
    return rt_memo_put(row, key, goal)

fn c2m_observation_goal_templates(id, groups):
    let key = ["c2m-observation-goal-declarations-v1", id]
    let cached = rt_memo_get(groups, key)
    if cached[0]:
        return cached[1]
    var result = []
    var i = 0
    while i < rt_count(groups):
        let group = groups[i]
        var j = 0
        while j < rt_count(group.fields):
            rt_push(result, campaign_observation_goal(campaign_ref(group.object, group.fields[j]), campaign_at(id, group.room), [c2m_source()], 0))
            j = j + 1
        i = i + 1
    return rt_memo_put(groups, key, result)

// Travel to inspect an owned opportunity retains its declared time window.
// Nonclock facts remain unknown until local inspection; they are not supplied.
fn c2m_travel_window(condition):
    let refs = dvs_sim_refs(condition)
    var clock_only = 0 < rt_count(refs)
    var i = 0
    while i < rt_count(refs):
        if not dv_same(refs[i], campaign_clock()):
            clock_only = false
        i = i + 1
    if clock_only:
        return condition
    if dv_find(condition, "op", "") == "all":
        var items = []
        i = 0
        while i < rt_count(condition.items):
            rt_push(items, c2m_travel_window(condition.items[i]))
            i = i + 1
        return dv_all(items)
    return dv_true()

fn c2m_goals(actor):
    var result = []
    let rows = c2m_rows()
    var i = 0
    while i < rt_count(rows):
        let row = rows[i]
        if row.actor == actor.id:
            let available = dv_all(row.requirements)
            let completion = dv_fact(campaign_ref(row.object, row.field), true)
            var when = available
            if row.private:
                let motive = dv_fact(campaign_own(actor.id, "private_motive"), true)
                when = dv_all([available, motive])
                // Travel expresses an intention to inspect a possible opportunity, not foreknowledge of the room.
                if dv_truth(actor.mind, completion) != "true":
                    let travel_when = dv_all([motive, c2m_travel_window(available)])
                    rt_push(result, c2m_row_goal(row, actor.id, travel_when, completion, true))
            rt_push(result, c2m_row_goal(row, actor.id, when, completion, false))
        i = i + 1
    if actor.id == "quer":
        rt_push(result, campaign_observation_goal(campaign_ref("c2.seal", "holder"), dv_all([campaign_at(actor.id, "living_hall"), campaign_at("ward", "living_hall")]), [c2m_source()], 0))
    let observations = c2m_observation_goal_templates(actor.id, c2m_fields())
    i = 0
    while i < rt_count(observations):
        rt_push(result, observations[i])
        i = i + 1
    return result

fn c2m_labels():
    return {"inventory_hidden": "清册收在铁匣内", "inventory_recovered": "清册已从铁匣取出", "blue_ink": "匣口留着蓝墨", "pipe_blocked": "传声管内有堵塞物", "formula_partial": "压差式有部分被擦掉", "pipe_cleared": "传声管已经疏通", "draft_hidden": "画夹暗层藏有底稿", "misleading_sketch": "外层草图与底稿不同", "draft_recovered": "原稿已从暗层找回", "drawer_etched": "日志抽屉留着酸蚀痕迹", "r07_label_changed": "R-07标签有换贴痕迹", "drawer_neutralized": "抽屉残酸已经中和", "audit_gap_created": "配给屉留下可供核对的缺口", "ration_latch_unfastened": "配给屉暗扣未扣紧", "verification_ink": "暗扣旁留着校验墨点", "ink_disturbed": "校验墨点有取粮接触留下的扰动", "blackboard_poem": "黑板上留有粉笔诗句废稿", "seal_lost": "官印离奇失踪", "ward_accusing": "沃德正激烈指控众人", "seal_in_piano": "大钢琴内部藏有官印", "seal_in_cistern": "水窖滤网槽沉有官印", "daotuoxue_trap": "水窖滤网槽有放置物件留下的痕迹"}

fn c2m_visible_lines(object, fields):
    var result = []
    let labels = c2m_labels()
    var i = 0
    while i < rt_count(fields):
        if dv_has_key(labels, fields[i]):
            rt_push(result, c2_visible_line(dv_fact(campaign_ref(object, fields[i]), true), rt_cat(dv_get(labels, fields[i]), "。"), [], c2m_source()))
            rt_push(result, c2_visible_line(dv_fact(campaign_ref(object, fields[i]), false), rt_cat("现场未见：", rt_cat(dv_get(labels, fields[i]), "。")), [], c2m_source()))
        i = i + 1
    return result

fn c2m_concat(left, right):
    var result = dv_clone(left)
    var i = 0
    while i < rt_count(right):
        rt_push(result, right[i])
        i = i + 1
    return result

fn c2m_other_people(actor):
    var result = []
    let people = dv_append(campaign_people(), "demon")
    var i = 0
    while i < rt_count(people):
        if people[i] != actor:
            rt_push(result, people[i])
        i = i + 1
    return result

// Every successful ration removal physically touches the same service drawer.
// The counter's open service state and the original actors, time and accounting stay unchanged.
fn c2m_ration_contact_effects():
    return [dv_assign(campaign_ref("c2.ledger", "drawer_contact_since_mark"), true)]

法则 c2m_ink_contact_law：
    当 配给总账 的 "ration_latch_unfastened" 等于 true。
    并且 配给总账 的 "verification_ink" 等于 true。
    并且 配给总账 的 "drawer_contact_since_mark" 等于 true。
    并且 配给总账 的 "ink_disturbed" 等于 false。
    则 配给总账 的 "ink_disturbed" 变为 true。


// Optional daily opportunities. Speech marks record execution, never scheduled outcomes.
fn c2daily_ref(field):
    return campaign_ref("c2.daily", field)

fn c2daily_say(actor, id, room, when, label, text, people):
    let source = campaign_approved(rt_cat("authorized-second-chapter-daily.", id))
    let row = c2d_row(actor, id, room, when, dv_true(), label, text, source)
    return dv_with(row, "opportunity", {"location": room, "participants": people, "mode": "all-present"})

fn c2daily_after(row, speaker, action):
    return dv_with(row, "received_speech_requirement", {"speaker": speaker, "action_id": action})

fn c2daily_notes_window():
    return dv_all([dv_at_least(campaign_clock(), 1440 + 810), dv_not(dv_at_least(campaign_clock(), 3 * 1440))])

fn c2daily_rows():
    let key = ["authored-declaration", "c2daily_rows"]
    let cached = rt_memo_get([], key)
    if cached[0]:
        return cached[1]
    return rt_memo_put([], key, c2daily_rows_build())

