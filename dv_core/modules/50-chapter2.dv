#include 35-campaign-schema.dv

// Native chapter-two content. No scheduled loss, illness, death, adoption or answer.
// Install into a committed chapter-one handoff; retain every existing mind and world object.
// Missing environment/physiology inputs remain unknown, never replaced by authored outcomes.

// 文件内称谓只展开为原有标识，不改变对象身份或授予认识。
称谓 后勤院 为「logistics」。
称谓 配给柜 为「c2.counter」。
称谓 余量 为「remaining」。
称谓 配给总账 为「c2.ledger」。
称谓 已点数 为「counted」。
称谓 开放状态 为「open」。
称谓 粮仓 为「c2.granary」。
称谓 双闩状态 为「double_bolts」。
称谓 总粮仓锁定 为「total_store_locked」。
称谓 储备已入账 为「reserve_added」。
称谓 已收储备 为「reserve_received」。
称谓 持钥人 为「key_owner」。
称谓 正在照护 为「busy_care」。
称谓 诊疗室 为「clinic」。
称谓 饥饿状态 为「hungry」。
称谓 持有口粮 为「rations」。
称谓 已食用份数 为「consumed」。
称谓 锁定状态 为「locked」。
称谓 存活状态 为「alive」。
称谓 侦探 为「detective」。
称谓 起居厅 为「living_hall」。
称谓 卢西安 为「lucian」。
称谓 雀儿 为「quer」。
称谓 共鸣厅 为「resonance_hall」。
称谓 中央厅 为「central_hall」。
称谓 白塔安全端 为「white_tower_safe」。

fn c2_source(file, line, id):
    return campaign_source(rt_cat("godot_csharp/scenes/Awakening/Script/story/续篇/", file), line, id)

fn c2_night(day):
    return campaign_window(day, 1260, 1800)

fn c2_any_night():
    return campaign_any(c2_night(1), campaign_any(c2_night(2), campaign_any(c2_night(3), campaign_any(c2_night(4), c2_night(5)))))

fn c2_edges():
    let key = ["authored-declaration", "c2_edges"]
    let cached = rt_memo_get([], key)
    if cached[0]:
        return cached[1]
    return rt_memo_put([], key, c2_edges_build())

fn c2_edges_build():
    return [
        {"from": "living_hall", "to": "central_hall", "gate": "north"},
        {"from": "central_hall", "to": "lecture", "gate": "north"},
        {"from": "central_hall", "to": "document_workshop", "gate": "north"},
        {"from": "central_hall", "to": "resonance_hall", "gate": "north"},
        {"from": "resonance_hall", "to": "quiet_room", "gate": "north"},
        {"from": "logistics", "to": "white_tower_safe", "gate": "east"},
        {"from": "living_hall", "to": "washroom", "gate": "living"},
        {"from": "central_hall", "to": "oath_court", "gate": "north"},
        {"from": "central_hall", "to": "outdoor_meter", "gate": "north"},
        {"from": "outdoor_meter", "to": "outdoor_high", "gate": "north"},
        {"from": "outdoor_high", "to": "outdoor_alley", "gate": "north"},
        {"from": "central_hall", "to": "logistics", "gate": "east"},
        {"from": "logistics", "to": "clinic", "gate": "east"},
        {"from": "logistics", "to": "greenhouse", "gate": "east"}]

fn c2_rooms():
    return ["outdoor_meter", "outdoor_high", "outdoor_alley", "document_workshop", "resonance_hall", "quiet_room", "white_tower_safe", "washroom", "hall", "living_hall", "central_hall", "logistics", "clinic", "lecture", "greenhouse", "threshold.contract", "threshold.astral", "threshold.logistics", "dorm.contract", "dorm.astral", "dorm.logistics", "pantry", "foyer", "corridor", "R05", "R06", "R07", "R08"]

fn c2_locations():
    return dv_append(c2_rooms(), "oath_court")

fn c2_norms():
    let key = ["authored-declaration", "c2_norms"]
    let cached = rt_memo_get([], key)
    if cached[0]:
        return cached[1]
    return rt_memo_put([], key, c2_norms_build())

fn c2_norms_build():
    return [
        {"id": "records_supplement", "title": "夜间取用补记", "owner": "ruan", "board": "central_hall", "surface": "急需可取，预留补记栏；次日将取用、用途和结余一同核清。", "promotes": ["records", "night_exception", "patient_priority"], "sacrifices": ["no_exception"], "mode": "permit", "method": "unrecorded_take", "source": campaign_approved("third-night-supplement-proposal")},
        {"id": "night_forbid", "title": "夜间禁取", "owner": "ward", "board": "central_hall", "surface": "夜间停取公物，待白日登记后再领。", "promotes": ["no_exception", "restriction"], "sacrifices": ["night_exception"], "mode": "forbid", "method": "unrecorded_take", "source": campaign_approved("third-night-forbid-proposal")},
        {"id": "ward_ledger", "title": "公物登记", "owner": "ward", "board": "central_hall", "surface": "凡取用公物须登记于台账；无登记取用者视为私取。", "promotes": ["records", "ward_authority", "no_exception"], "sacrifices": ["night_exception"], "mode": "forbid", "method": "unrecorded_take", "source": c2_source("03_规矩与结局.story", 6, "WardLedger")},
        {"id": "ward_night", "title": "夜间行动登记", "owner": "ward", "board": "central_hall", "surface": "夜间取用公物先登记，次日共同核对记录。", "promotes": ["restriction", "ward_authority"], "sacrifices": ["not_targeted", "movement_freedom"], "mode": "forbid", "method": "unrecorded_take", "source": campaign_approved("第五部分：WardNight当前公约提案")},
        {"id": "mora_night", "title": "病人夜间用粮", "owner": "mora", "board": "logistics", "surface": "病者伤者优先。夜间照护或饥饿急需可取一份，次日告知。", "promotes": ["patient_priority", "night_exception"], "sacrifices": ["no_exception"], "mode": "permit", "method": "unrecorded_take", "source": campaign_approved("第五部分：MoraNight当前公约提案")},
        {"id": "ruan_ledger", "title": "按人配给与清点", "owner": "ruan", "board": "logistics", "surface": "每日按人头分配，日末清点。", "promotes": ["per_person", "records"], "sacrifices": [], "mode": "prefer", "method": "collect_and_count", "source": c2_source("03_规矩与结局.story", 59, "RuanLedger")},
        {"id": "shen_kitchen", "title": "统一烹饪", "owner": "shen", "board": "living_hall", "surface": "粮仓钥匙交给做饭的人，统一煮粥，先喂饿着的人。", "promotes": ["central_cooking", "patient_priority", "records"], "sacrifices": [], "mode": "prefer", "method": "cook_and_feed", "source": c2_source("03_规矩与结局.story", 113, "ShenKitchen")},
        {"id": "veronica_evidence", "title": "实物与登记要求", "owner": "veronica", "board": "lecture", "surface": "指控须有实物为证；取用须有记录。", "promotes": ["evidence", "records"], "sacrifices": [], "mode": "forbid", "method": "unsupported_accusation", "source": c2_source("03_规矩与结局.story", 127, "VeronicaEvidence")},
        {"id": "lucian_no_brand", "title": "查验前的行动自由", "owner": "lucian", "board": "lecture", "surface": "未经查验，不得以“私取”之名限制任何人行走。", "promotes": ["evidence", "not_targeted", "movement_freedom", "night_exception"], "sacrifices": ["restriction"], "mode": "forbid", "method": "unverified_restriction", "source": c2_source("03_规矩与结局.story", 141, "LucianNoBrand")},
        {"id": "measurement_pause", "title": "震后复测与返程约定", "owner": "detective", "board": "living_hall", "surface": "风止或震动以后先暂停外出，重新核对读数；读数不安全就留在门内，安全后再约定路线和返程。我愿在门内值守，实际在场时再共同核对。", "promotes": ["measured_work", "understand_cost"], "sacrifices": ["pursue_desire", "avoid_attachment"], "mode": "forbid", "method": "outdoor_travel", "source": campaign_approved("user:2026-10-23-real-negotiated-measurement-pause")},
        {"id": "open_plan", "title": "开放议案", "owner": "huo", "board": "central_hall", "surface": "外出前核对源质计与风向，按安全读数安排劳作，约定返程与停行条件。", "promotes": ["measured_work"], "sacrifices": ["cautious_travel", "committee"], "mode": "permit", "method": "measured_outing", "source": campaign_approved("第五部分：OpenPlan当前公约提案")},
        {"id": "seal_plan", "title": "封闭议案", "owner": "gu", "board": "central_hall", "surface": "读数不明、风止或地震之后，先留在安全处，复测后再定行程。", "promotes": ["cautious_travel", "tradition"], "sacrifices": ["measured_work"], "mode": "forbid", "method": "outdoor_travel", "source": campaign_approved("第五部分：SealPlan当前公约提案")},
        {"id": "committee_plan", "title": "公物登记议案", "owner": "ward", "board": "central_hall", "surface": "公用粮水药逐项登记，列明取用、补记和结余，供众人核对。", "promotes": ["committee", "ward_authority", "records"], "sacrifices": ["measured_work"], "mode": "require", "method": "collect_and_count", "source": campaign_approved("第五部分：CommitteePlan当前公约提案")}]

fn c2_norm_object(id):
    return rt_cat("c2.norm.", id)

fn c2_alive(actor):
    if actor == "demon":
        return dv_true()
    return dv_fact(campaign_own(actor, "alive"), true)

fn c2_can_act(actor):
    if actor == "demon":
        return dv_true()
    return dv_all([c2_alive(actor), dv_fact(campaign_own(actor, "in_coma"), false), dv_fact(campaign_own(actor, "stone_stupor"), false)])

fn c2_object(id, room, fields):
    var state = fields
    if room != "" and not dv_has_key(state, "location"):
        state = dv_with(state, "location", dv_field(room))
    let descriptor = campaign_object_descriptor(id)
    if descriptor.map_kind == "object" and not dv_has_key(state, "name"):
        state = dv_with(state, "name", dv_field(descriptor.map_title))
    return dv_with(campaign_state_object(id, state), "location", room)

fn c2_initial_body(actor):
    var fields = {"alive": dv_field(true), "dead": dv_field(false), "stone_stupor": dv_field(false), "exiled": dv_field(false), "rations": dv_field(0), "consumed": dv_field(0), "hungry": dv_field(false), "owe_notes": dv_field(0), "pending_notes": dv_field(0), "busy_care": dv_field(false), "station": dv_field(""), "guard_commitment": dv_field(false), "guard_response_ready": dv_unknown(), "repair_requested": dv_field(false), "watched": dv_field(false), "night_taken": dv_field(false), "exposure_terminal": dv_unknown(), "reason_committed": dv_field(false), "norm_conflict_driven": dv_field(false), "fever": dv_unknown(), "day_sketch_exposed": dv_field(false), "evening_sketch_exposed": dv_field(false), "evening_sketch_completed": dv_field(false), "anti_erosion_treated": dv_field(false), "active_erosion_disease": dv_field(actor == "su"), "severe_weakness": dv_field(false), "motor_impairment": dv_field(false), "serious_injury": dv_field(false), "respiratory_failure": dv_field(false), "anti_erosion_carried": dv_field(false), "erosion_exposure": dv_field(0), "restriction_withdrawn": dv_field(false), "guard_active": dv_field(false), "support_active": dv_field(false), "in_coma": dv_field(false), "sketch_lured": dv_field(false), "rescue_exposed": dv_field(false), "seal_present": dv_field(actor == "ward"), "carrying": dv_field(""), "carried_by": dv_field("")}
    if actor == "su":
        fields = dv_with(fields, "active_erosion_disease", dv_with(dv_field(true), "basis", [campaign_approved("user:2026-10-22-confirmed-preexisting-su-erosion-disease")]))
    if dv_has(["ward", "lucian", "moran", "veronica", "ruan"], actor):
        fields = dv_with(fields, "private_motive", dv_with(dv_field(true), "basis", [campaign_approved("user:2026-10-18-personal-active-motives")]))
    let work = c2_work_specs()
    var work_index = 0
    while work_index < rt_count(work):
        if work[work_index].actor == actor:
            fields = dv_with(fields, rt_cat("work.decided.", work[work_index].id), dv_field(false))
            fields = dv_with(fields, rt_cat("work.accepted.", work[work_index].id), dv_field(false))
        work_index = work_index + 1
    if actor == "moran":
        fields = dv_with(fields, "fever", dv_field(false))
    fields = dv_with_many(fields, {"last_take_purpose": dv_unknown(), "pending.self": dv_field(0), "pending.patient": dv_field(0), "purpose_clarified.self": dv_field(false), "purpose_clarified.patient": dv_field(false)})
    let norms = c2_norms()
    var i = 0
    while i < rt_count(norms):
        fields = dv_with(fields, rt_cat("read.", norms[i].id), dv_field(false))
        fields = dv_with(fields, rt_cat("accepted.", norms[i].id), dv_field(false))
        fields = dv_with(fields, rt_cat("decided.", norms[i].id), dv_field(false))
        i = i + 1
    var day = 2
    while day <= 5:
        fields = dv_with(fields, rt_cat("collected.", rt_cat(rt_show(day), ".noon")), dv_field(false))
        fields = dv_with(fields, rt_cat("collected.", rt_cat(rt_show(day), ".evening")), dv_field(false))
        fields = dv_with(fields, rt_cat("eaten.", rt_cat(rt_show(day), ".noon")), dv_field(false))
        fields = dv_with(fields, rt_cat("eaten.", rt_cat(rt_show(day), ".evening")), dv_field(false))
        fields = dv_with(fields, rt_cat("hunger_checked.", rt_cat(rt_show(day), ".noon")), dv_field(false))
        fields = dv_with(fields, rt_cat("hunger_checked.", rt_cat(rt_show(day), ".evening")), dv_field(false))
        day = day + 1
    let roles = campaign_profile(actor).station_roles
    fields = dv_with(fields, "can_structure", dv_field(actor == "margaret"))
    fields = dv_with(fields, "can_weight", dv_field(dv_has(roles, "weight")))
    fields = dv_with(fields, "can_lock", dv_field(dv_has(roles, "lock")))
    fields = dv_with(fields, "can_relay", dv_field(dv_has(roles, "relay")))
    return c2_object(campaign_body(actor), "", fields)

fn c2_initial_body_from(actor, world):
    var body = c2_initial_body(actor)
    let fields = body.facets.state
    var i = 0
    while i < rt_count(fields):
        let field = fields[i][0]
        var prior = dv_read(world, dv_ref(actor, "body", field))
        if not dv_uncontested(prior):
            prior = dv_read(world, dv_ref(actor, "state", field))
        if dv_uncontested(prior):
            body = dv_with(body, "facets", dv_with(body.facets, "state", dv_with(body.facets.state, field, prior)))
        i = i + 1
    return body

fn c2_world_objects(world):
    var result = world
    result = campaign_add_new(result, campaign_state_object("campaign.clock", {"minute": dv_field(dv_find(world, "time", 0))}))
    result = campaign_add_new(result, campaign_state_object("campaign.access", {"living": dv_field(true), "contract": dv_field(false), "astral": dv_field(false), "logistics": dv_field(false), "north": dv_field(false), "east": dv_field(false)}))
    if not dv_read(result, campaign_access("living")).known:
        result = dv_store(result, campaign_access("living"), dv_field(true))
    result = campaign_add_new(result, c2_object("c2.corridor.north", "living_hall", {"air_safe": dv_field(false), "intake_safe": dv_field(false), "seal_intact": dv_field(true), "ventilated": dv_field(false), "airlock_held": dv_field(false), "airlock_hazard": dv_field(false), "roof_collapsed": dv_field(false)}))
    result = campaign_add_new(result, c2_object("c2.corridor.east", "central_hall", {"air_safe": dv_field(false), "intake_safe": dv_field(false), "seal_intact": dv_field(true), "ventilated": dv_field(false), "acid_gas_released": dv_field(false), "airlock_held": dv_field(false), "airlock_hazard": dv_field(false)}))
    let corridor_gates = ["north", "east"]
    var gate_index = 0
    while gate_index < rt_count(corridor_gates):
        if not dv_read(result, campaign_access(corridor_gates[gate_index])).known:
            result = dv_store(result, campaign_access(corridor_gates[gate_index]), dv_field(false))
        gate_index = gate_index + 1
    result = campaign_add_new(result, c2_object("c2.granary", "logistics", {"remaining": dv_unknown(), "locked": dv_field(true), "total_store_locked": dv_field(true), "latch_loose": dv_field(true), "structure_checked": dv_field(false), "wedge_set": dv_field(false), "lift_mm": dv_field(0), "double_bolts": dv_field(true), "reserve_added": dv_field(false), "tool_marks": dv_field(false), "key_owner": dv_unknown(), "water_valve_repaired": dv_field(false), "pulley_braced": dv_field(false), "timber_braced": dv_field(false), "water_valve_hazard": dv_field(false), "pulley_hazard": dv_field(false), "timber_hazard": dv_field(false), "destroyed": dv_field(false)}))
    result = campaign_add_new(result, c2_object("c2.counter", "logistics", {"open": dv_field(false), "remaining": dv_field(99)}))
    result = campaign_add_new(result, c2_object("c2.ledger", "logistics", {"removed": dv_field(0), "day_recorded": dv_field(0), "night_recorded": dv_field(0), "counted": dv_field(0), "reserve_received": dv_field(0), "supplement_column": dv_field(false), "pending_registered": dv_field(0)}))
    result = campaign_add_new(result, c2_object("c2.bowl", "clinic", {"portions": dv_field(0), "residue": dv_field(false)}))
    result = campaign_add_new(result, c2_object("c2.kitchen", "logistics", {"cooked": dv_field(false), "water": dv_unknown(), "fake_alarm": dv_field(false)}))
    result = campaign_add_new(result, c2_object("c2.casualty", "", {"casualty_occurred": dv_field(false), "moran_dead": dv_field(false), "bertrand_stupor": dv_field(false)}))
    result = campaign_add_new(result, c2_object("c2.trial", "", {"detective_imprisoned": dv_field(false), "intercom_reversed": dv_field(false), "guard_abandoned_post": dv_field(false), "community_covenant_failed": dv_field(false), "traitor_executed": dv_field(false), "ward_impeached": dv_field(false)}))
    result = campaign_add_new(result, c2_object("c2.ascension", "outdoor_high", {"godhood_achieved": dv_field(false)}))
    result = campaign_add_new(result, c2_object("c2.duty", "", {"rations_assisted": dv_field(false), "prop_assisted": dv_field(false), "medicine_assisted": dv_field(false), "comforted": dv_field(false)}))
    result = campaign_add_new(result, c2_object("c2.demon", "", {"intervened": dv_field(false), "intervention_requested": dv_field(false)}))
    result = campaign_add_new(result, c2_object("c2.clinic", "clinic", {"sedative_administered": dv_field(false)}))
    result = campaign_add_new(result, c2_object("c2.weather", "", {"phase": dv_field("falling_ash"), "ash_falling": dv_field(true), "wind": dv_unknown(), "daylight": dv_unknown(), "daylight_phase": dv_field("unclassified"), "earthquake_recent": dv_field(false), "severe_air": dv_field(true), "environment_epoch": dv_field(0)}))
    if not dv_has_key(dv_get(result.objects, "c2.weather").facets.state, "daylight_phase"):
        result = dv_store(result, campaign_ref("c2.weather", "daylight_phase"), dv_field("unclassified"))
    var i = 0
    let norms = c2_norms()
    while i < rt_count(norms):
        let norm = norms[i]
        result = campaign_add_new(result, c2_object(c2_norm_object(norm.id), norm.board, {"owner": dv_field(norm.owner), "text": dv_field(norm.surface), "proposed": dv_field(false), "posted": dv_field(false)}))
        i = i + 1
    let people = campaign_people()
    i = 0
    while i < rt_count(people):
        result = campaign_add_new(result, c2_initial_body_from(people[i], world))
        result = campaign_add_new(result, c2_object(rt_cat("c2.litter.", campaign_profile(people[i]).group), rt_cat("dorm.", campaign_profile(people[i]).group), {"crumbs": dv_field(0)}))
        i = i + 1
    result = c2i_world_objects(result)
    let changes = c2_weather_changes()
    i = 0
    while i < rt_count(changes):
        let ref = campaign_ref("c2.weather", rt_cat("occurred.", changes[i].id))
        if not dv_read(result, ref).known:
            result = dv_store(result, ref, dv_field(false))
        i = i + 1
    return result

axiom c2_move_law(actor, origin, target, gate):
    var conditions = [campaign_at(actor, origin), dv_fact(campaign_access(gate), true)]
    if actor != "demon":
        rt_push(conditions, dv_fact(campaign_own(actor, "station"), ""))
        rt_push(conditions, dv_fact(campaign_own(actor, "busy_care"), false))
        rt_push(conditions, c2_can_act(actor))
        if actor == "bertrand":
            rt_push(conditions, dv_fact(campaign_own(actor, "carrying"), ""))
    if gate == "north" and ((origin == "living_hall" and target == "central_hall") or (origin == "central_hall" and target == "outdoor_meter")):
        rt_push(conditions, dv_fact(campaign_ref("c2.corridor.north", "airlock_held"), false))
    let groups = ["contract", "astral", "logistics"]
    var i = 0
    while i < rt_count(groups):
        let dorm = rt_cat("dorm.", groups[i])
        let threshold = rt_cat("threshold.", groups[i])
        if (origin == dorm and target == threshold) or (origin == threshold and target == dorm):
            rt_push(conditions, dv_fact(campaign_ref(rt_cat("case.", groups[i]), "outer_latch_released"), true))
        i = i + 1
    if actor != "demon":
        rt_push(conditions, dv_fact(campaign_own(actor, "motor_impairment"), false))
    var effects = [dv_assign(campaign_position_ref(actor), target)]
    if origin == "logistics" and dv_has(["margaret", "huo"], actor):
        rt_push(effects, dv_assign(campaign_own(actor, "support_active"), false))
    if origin == "living_hall" and dv_has(["detective", "bertrand", "huo"], actor):
        rt_push(effects, dv_assign(campaign_own(actor, "guard_active"), false))
    return dv_axiom("c2_move_law", 1, dv_all(conditions), effects)

fn c2_place_label(place):
    return campaign_location_title(place)

fn c2_move_action(actor, origin, target, gate):
    let id = rt_cat(actor, rt_cat(".c2.move.", rt_cat(origin, rt_cat(".", target))))
    let premise = c2_move_law(actor, origin, target, gate).premise
    var method = "travel"
    if dv_has(["oath_court", "greenhouse", "outdoor_high", "outdoor_alley"], target):
        method = "outdoor_travel"
    if target == "outdoor_meter":
        method = "measurement_approach"
    var grants = [campaign_position_ref(actor)]
    if origin == "logistics" and dv_has(["margaret", "huo"], actor):
        rt_push(grants, campaign_own(actor, "support_active"))
    if origin == "living_hall" and dv_has(["detective", "bertrand", "huo"], actor):
        rt_push(grants, campaign_own(actor, "guard_active"))
    return dv_with_many(campaign_surface_action(id, "move", premise, premise, id, grants, rt_cat("前往", c2_place_label(target)), dvs_surface_parts(["从", c2_place_label(origin), "穿过廊门，来到", c2_place_label(target), "。"]), c2_source("00_通行.story", 9, "routes-and-boundaries")), {"repeatable": true, "normative_method": method, "travel": {"from": origin, "to": target, "gate": gate}, "predict_law": id, "failure_grants": [campaign_access(gate)], "failure_observe_when": campaign_at(actor, origin), "public_observers": campaign_people(), "public_grants": grants})

fn c2_norm_condition(norm, actor):
    let night = c2_any_night()
    if norm.id == "ward_night":
        return night
    if norm.id == "measurement_pause":
        return campaign_any(dv_fact(campaign_ref("c2.meter", "safe"), false), campaign_any(dv_fact(campaign_ref("c2.weather", "wind"), false), dv_fact(campaign_ref("c2.weather", "earthquake_recent"), true)))
    if norm.id == "seal_plan":
        return campaign_any(dv_fact(campaign_ref("c2.weather", "wind"), false), dv_fact(campaign_ref("c2.weather", "earthquake_recent"), true))
    if norm.id == "mora_night":
        return dv_all(dv_pair(night, campaign_any(dv_fact(campaign_own(actor, "hungry"), true), dv_fact(campaign_own("moran", "fever"), true))))
    return dv_at_least(campaign_clock(), 2250)

fn c2_personal_norms(actor):
    let norms = c2_norms()
    var result = []
    var i = 0
    while i < rt_count(norms):
        let norm = norms[i]
        rt_push(result, {"id": norm.id, "mode": norm.mode, "method": norm.method, "available_when": dv_all(dv_pair(dv_fact(campaign_own(actor, rt_cat("accepted.", norm.id)), true), c2_norm_condition(norm, actor))), "promotes": norm.promotes, "sacrifices": norm.sacrifices, "basis": [norm.source], "scope": "subject-local-accepted-norm"})
        if norm.method == "unrecorded_take" and (norm.mode == "permit" or norm.id == "night_forbid"):
            rt_push(result, {"id": rt_cat(norm.id, ".pending"), "mode": norm.mode, "method": "pending_take", "available_when": dv_all([dv_fact(campaign_own(actor, rt_cat("accepted.", norm.id)), true), c2_norm_condition(norm, actor)]), "promotes": norm.promotes, "sacrifices": norm.sacrifices, "basis": [norm.source], "scope": "subject-local-accepted-norm"})
        i = i + 1
    if actor == "mora":
        rt_push(result, {"id": "mora_patient_boundary", "mode": "forbid", "method": "refuse_patient", "available_when": dv_true(), "promotes": ["patient_priority"], "sacrifices": [], "basis": [campaign_approved("mora-personal-bottom-line-does-not-refuse-patients")], "scope": "personal-bottom-line"})
    return result

fn c2_inspect_action(actor, object, room, fields, label, text, source):
    var grants = []
    var i = 0
    while i < rt_count(fields):
        rt_push(grants, campaign_ref(object, fields[i]))
        i = i + 1
    let descriptor = campaign_object_descriptor(object)
    if descriptor.map_kind == "object":
        rt_push(grants, campaign_ref(object, "name"))
        rt_push(grants, campaign_ref(object, "location"))
    var intent_label = label
    if dv_has(["核对现场操作与证据", "检视现场实物与痕迹"], label) and descriptor.map_title != "":
        intent_label = rt_cat(label, rt_cat("：", descriptor.map_title))
    var action = dv_with_many(campaign_surface_action(rt_cat(actor, rt_cat(".c2.inspect.", object)), "inspect", campaign_at(actor, room), campaign_at(actor, room), "", grants, intent_label, text, source), {"repeatable": true, "presentation": c2_inspection_presentation(actor, object, fields), "required_room": room})
    if descriptor.map_kind == "object":
        action = dv_with(action, "interaction", {"kind": "site", "site": object})
    return action

fn c2_visible_line(when, template, bindings, source):
    return {"when": when, "template": template, "bindings": bindings, "source": source}

fn c2_visible_binding(name, ref, labels):
    return {"name": name, "ref": ref, "labels": labels}

fn c2_inspection_has(fields, field):
    var i = 0
    while i < rt_count(fields):
        if fields[i] == field:
            return true
        i = i + 1
    return false

fn c2_inspection_presentation(actor, object, fields):
    var lines = c2m_visible_lines(object, fields)
    let description = c2_source("09_表达.story", 653, "存粮与门闩")
    if object == "c2.granary":
        rt_push(lines, c2_visible_line(dv_fact(campaign_ref(object, "latch_loose"), true), "门闩变形松动，重锁另须处理。", [], c2_source("09_表达.story", 654, "闩松")))
        rt_push(lines, c2_visible_line(dv_fact(campaign_ref(object, "tool_marks"), true), "门闩有新的工具痕，已经紧固。", [], c2_source("09_表达.story", 655, "闩修")))
        rt_push(lines, c2_visible_line(dv_all([dv_fact(campaign_ref(object, "latch_loose"), false), dv_fact(campaign_ref(object, "tool_marks"), false)]), "门闩完好。", [], c2_source("09_表达.story", 656, "闩好")))
        rt_push(lines, c2_visible_line(dv_true(), "粮仓门{状态}。", [c2_visible_binding("状态", campaign_ref(object, "locked"), {"true": "锁着", "false": "未锁"})], description))
        rt_push(lines, c2_visible_line(dv_true(), "总库门{状态}。", [c2_visible_binding("状态", campaign_ref(object, "total_store_locked"), {"true": "关着", "false": "开着"})], description))
    if object == "c2.counter":
        rt_push(lines, c2_visible_line(dv_true(), "配给台{状态}。", [c2_visible_binding("状态", campaign_ref(object, "open"), {"true": "正在发粮", "false": "还没开粮"})], c2_source("00_时间与文案.story", 98, "配给台关闭")))
        rt_push(lines, c2_visible_line(dv_true(), "配给台还剩{数}份口粮。", [c2_visible_binding("数", campaign_ref(object, "remaining"), {})], description))
    if object == "c2.ledger":
        rt_push(lines, c2_visible_line(dv_at_least(campaign_ref(object, "counted"), 1), "起始清点记录为{数}份。", [c2_visible_binding("数", campaign_ref(object, "counted"), {})], campaign_approved("实际清点的新台账")))
        rt_push(lines, c2_visible_line(dv_true(), "白天领取记了{白天}份，夜间补记了{夜间}份。", [c2_visible_binding("白天", campaign_ref(object, "day_recorded"), {}), c2_visible_binding("夜间", campaign_ref(object, "night_recorded"), {})], c2_source("04_案件.story", 88, "台账上的领取与补记")))
    if object == "c2.bowl":
        rt_push(lines, c2_visible_line(dv_fact(campaign_ref(object, "residue"), true), "莫兰床边一只碗，碗底有进食留下的残渣。", [], c2_source("09_表达.story", 642, "describe.bowl_residue")))
        rt_push(lines, c2_visible_line(dv_all([dv_fact(campaign_ref(object, "residue"), false), dv_fact(campaign_ref(object, "portions"), 0)]), "碗是干净的。", [], c2_source("09_表达.story", 643, "describe.bowl_clean")))
    if object == "c2.litter.living" or object == "c2.litter.contract" or object == "c2.litter.astral" or object == "c2.litter.logistics":
        rt_push(lines, c2_visible_line(dv_at_least(campaign_ref(object, "crumbs"), 1), "废纸篓里有饼屑。", [], c2_source("09_表达.story", 662, "废纸粮：仅呈现已知饼屑")))
        rt_push(lines, c2_visible_line(dv_fact(campaign_ref(object, "crumbs"), 0), "没见饼屑。", [], c2_source("09_表达.story", 664, "废纸：未见饼屑")))
    if object == campaign_body("moran"):
        rt_push(lines, c2_visible_line(dv_fact(campaign_own("moran", "fever"), true), "莫兰额头很烫。", [], c2_source("09_表达.story", 658, "病床：仅呈现已知体温")))
    if object == "c2.weather":
        rt_push(lines, c2_visible_line(dv_fact(campaign_ref(object, "ash_falling"), true), "主楼的灰还在落。", [], c2_source("00_时间与文案.story", 52, "开场白")))
        rt_push(lines, c2_visible_line(dv_fact(campaign_ref(object, "ash_falling"), false), "落灰停了。", [], campaign_approved("second-day-morning-wind")))
        rt_push(lines, c2_visible_line(dv_fact(campaign_ref(object, "wind"), true), "廊外起风了。", [], campaign_approved("second-day-morning-wind")))
    if object == "c2.daily" and dv_has(fields, "council_closed"):
        let closing_source = campaign_approved("user:2026-10-18章末授权")
        rt_push(lines, c2_visible_line(dv_all([dv_fact(campaign_ref(object, "council_closed"), true), dv_fact(campaign_ref(object, "council_ended"), true)]), "议事已经收束。公约的签名齐备，各人的赞成提案与保留意见仍按原记录保存。", [], closing_source))
        rt_push(lines, c2_visible_line(dv_all([dv_fact(campaign_ref(object, "council_closed"), true), dv_fact(campaign_ref(object, "council_ended"), false)]), "议事时段已经结束，公约签名尚未齐备。未签名、未投票与未决事项仍按实际记录保留。", [], closing_source))
        rt_push(lines, c2_visible_line(dv_fact(campaign_ref(object, "underground_tremor"), true), "铜口底噪里夹着极轻的共鸣，脚下仍能觉出余震。来由尚待查明。", [], closing_source))
    if object == "case.contract" or object == "case.astral" or object == "case.logistics":
        let names = {"lock_no_pry": "锁具检查", "emergency_inventory_majority": "大半张清册的查找", "ward_half_paper": "另一半清册的出示", "joined_inventory": "清册拼合", "ladder_lowered": "备用梯放下", "copper_filings": "铜屑勘查", "seven_step_scuffs": "步位擦痕勘查", "palm_print": "掌印勘查", "vent_pressure_formula": "通风压差算式核对", "moran_reassured": "画夹持有人的安抚", "complete_draft": "完整底稿出示", "r07_skin_test": "R-07皮试记录查找", "three_old_scars": "旧疤核对", "medicine_key_given": "药柜钥匙交接"}
        var i = 0
        while i < rt_count(fields):
            let label = dv_find(names, fields[i], "现场操作")
            if not dv_has_key(c2m_labels(), fields[i]):
                rt_push(lines, c2_visible_line(dv_fact(campaign_ref(object, fields[i]), true), rt_cat(label, "：现场记录为已完成。"), [], campaign_approved("actual-local-case-inspection")))
                rt_push(lines, c2_visible_line(dv_fact(campaign_ref(object, fields[i]), false), rt_cat(label, "：现场记录为尚未完成。"), [], campaign_approved("actual-local-case-inspection")))
            i = i + 1
    return {"actor": actor, "voice": "visible-inspection", "lines": lines}

fn c2_route_inspections(actor):
    let rows = c2_edges()
    var result = []
    var i = 0
    while i < rt_count(rows):
        let row = rows[i]
        if (row.from == "living_hall" and row.to == "central_hall") or (row.from == "central_hall" and row.to == "logistics"):
            let source = c2_source("00_通行.story", 9, "visible-local-route")
            let id = rt_cat(actor, rt_cat(".c2.inspect.route.", rt_cat(row.from, rt_cat(".", row.to))))
            var grants = dv_single(campaign_access(row.gate))
            if dv_has(["contract", "astral", "logistics"], row.gate):
                rt_push(grants, campaign_ref(rt_cat("case.", row.gate), "outer_latch_released"))
            rt_push(result, dv_with(campaign_surface_action(id, "inspect", campaign_at(actor, row.from), campaign_at(actor, row.from), "", grants, "检视廊门与外闩", "查看廊门和外闩。", source), "repeatable", true))
            let back = rt_cat(actor, rt_cat(".c2.inspect.route.", rt_cat(row.to, rt_cat(".", row.from))))
            rt_push(result, dv_with(campaign_surface_action(back, "inspect", campaign_at(actor, row.to), campaign_at(actor, row.to), "", grants, "检视此侧廊门", "从这侧查看廊门。", source), "repeatable", true))
        i = i + 1
    return result

axiom c2_collect_law(actor, day, meal, start, end):
    let flag = rt_cat("collected.", rt_cat(rt_show(day), rt_cat(".", meal)))
    return dv_axiom("c2_collect_law", 1, dv_all([campaign_at(actor, "logistics"), campaign_window(day, start, end), dv_fact(campaign_ref("c2.counter", "open"), true), dv_at_least(campaign_ref("c2.counter", "remaining"), 1), dv_fact(campaign_own(actor, flag), false), c2_alive(actor)]), c2m_concat([dv_increment(campaign_ref("c2.counter", "remaining"), -1), dv_increment(campaign_ref("c2.ledger", "removed"), 1), dv_increment(campaign_ref("c2.ledger", "day_recorded"), 1), dv_increment(campaign_own(actor, "rations"), 1), dv_assign(campaign_own(actor, flag), true)], c2m_ration_contact_effects()))

axiom c2_eat_law(actor, day, meal):
    var start = 720
    var end = 840
    if meal == "evening":
        start = 1080
        end = 1260
    let flag = rt_cat("eaten.", rt_cat(rt_show(day), rt_cat(".", meal)))
    return dv_axiom("c2_eat_law", 1, dv_all([campaign_window(day, start, end), dv_at_least(campaign_own(actor, "rations"), 1), dv_fact(campaign_own(actor, flag), false), c2_alive(actor)]), [dv_increment(campaign_own(actor, "rations"), -1), dv_increment(campaign_own(actor, "consumed"), 1), dv_assign(campaign_own(actor, "hungry"), false), dv_assign(campaign_own(actor, flag), true)])

axiom c2_open_granary_law(actor):
    let access = campaign_any(dv_fact(campaign_ref("c2.granary", "key_owner"), actor), dv_fact(campaign_own(actor, "can_lock"), true))
    return dv_axiom("c2_open_granary_law", 1, dv_all([campaign_at(actor, "logistics"), c2_alive(actor), access]), dv_single(dv_assign(campaign_ref("c2.granary", "locked"), false)))

法则 c2_initial_count_law，给定 行动者：
    当 行动者 位于 后勤院。
    并且 c2_alive(行动者)。
    并且 配给柜 的 余量 等于 99。
    并且 配给总账 的 已点数 等于 0。
    则 配给总账 的 已点数 变为 99。

法则 c2_distribute_law，给定 行动者：
    当 行动者 位于 后勤院。
    并且 c2_alive(行动者)。
    并且 配给总账 的 已点数 等于 99。
    并且 配给柜 的 开放状态 等于 false。
    则 配给柜 的 开放状态 变为 true。

法则 c2_total_store_open_law，给定 行动者：
    当 c2i_granary_support()。
    并且 campaign_window(3, 720, 840)。
    并且 行动者 位于 后勤院。
    并且 campaign_own(行动者, "can_lock") 等于 true。
    并且 粮仓 的 双闩状态 等于 false。
    并且 粮仓 的 总粮仓锁定 等于 true。
    并且 粮仓 的 储备已入账 等于 false。
    并且 c2_alive(行动者)。
    则 粮仓 的 总粮仓锁定 变为 false。
    并使 粮仓 的 储备已入账 变为 true。
    并使 配给柜 的 余量 增加 672。
    并使 配给总账 的 已收储备 增加 672。

法则 c2_give_key_law，给定 行动者、目标：
    当 行动者 位于 后勤院。
    并且 目标 位于 后勤院。
    并且 粮仓 的 持钥人 等于 行动者。
    并且 c2_alive(行动者)。
    并且 c2_alive(目标)。
    则 粮仓 的 持钥人 变为 目标。

axiom c2_night_take_variant_law(actor, patient, registered):
    var need = dv_fact(campaign_own(actor, "hungry"), true)
    if patient:
        need = dv_all([dv_fact(campaign_own("moran", "fever"), true), dv_fact(campaign_own("moran", "hungry"), true), c2_alive("moran"), dv_fact(campaign_ref("c2.bowl", "portions"), 0)])
    var record_condition = dv_fact(campaign_ref("c2.ledger", "supplement_column"), false)
    var effects = [dv_increment(campaign_ref("c2.counter", "remaining"), -1), dv_increment(campaign_ref("c2.ledger", "removed"), 1), dv_increment(campaign_own(actor, "rations"), 1), dv_increment(campaign_own(actor, "owe_notes"), 1), dv_assign(campaign_own(actor, "night_taken"), true)]
    var purpose = "self"
    if patient:
        purpose = "patient"
    rt_push(effects, dv_assign(campaign_own(actor, "last_take_purpose"), purpose))
    if registered:
        record_condition = dv_fact(campaign_ref("c2.ledger", "supplement_column"), true)
        rt_push(effects, dv_increment(campaign_ref("c2.ledger", "pending_registered"), 1))
        rt_push(effects, dv_increment(campaign_own(actor, "pending_notes"), 1))
        rt_push(effects, dv_increment(campaign_own(actor, rt_cat("pending.", purpose)), 1))
        rt_push(effects, dv_assign(campaign_own(actor, rt_cat("purpose_clarified.", purpose)), false))
    return dv_axiom("c2_night_take_variant_law", 1, dv_all([record_condition, campaign_at(actor, "logistics"), c2_any_night(), dv_fact(campaign_own(actor, "rations"), 0), dv_fact(campaign_ref("c2.counter", "open"), true), dv_at_least(campaign_ref("c2.counter", "remaining"), 1), c2_alive(actor), need]), c2m_concat(effects, c2m_ration_contact_effects()))

axiom c2_night_take_law(actor, patient):
    return c2_night_take_variant_law(actor, patient, false)


法则 c2_report_law，给定 行动者：
    当 行动者 位于 后勤院。
    并且 campaign_own(行动者, "owe_notes") 至少 1。
    并且 campaign_own(行动者, "pending_notes") 等于 0。
    并且 campaign_own(行动者, 正在照护) 等于 false。
    并且 c2_alive(行动者)。
    则 campaign_own(行动者, "owe_notes") 增加 -1。
    并使 配给总账 的 "night_recorded" 增加 1。

axiom c2_night_eat_law(actor):
    var room = rt_cat("dorm.", campaign_profile(actor).group)
    if campaign_profile(actor).group == "living":
        room = "living_hall"
    return dv_axiom("c2_night_eat_law", 1, dv_all([campaign_at(actor, room), c2_any_night(), dv_fact(campaign_own(actor, "hungry"), true), dv_at_least(campaign_own(actor, "rations"), 1), c2_alive(actor)]), [dv_increment(campaign_own(actor, "rations"), -1), dv_increment(campaign_own(actor, "consumed"), 1), dv_assign(campaign_own(actor, "hungry"), false), dv_increment(campaign_ref(rt_cat("c2.litter.", campaign_profile(actor).group), "crumbs"), 1)])

法则 c2_deliver_patient_law，给定 行动者：
    当 行动者 位于 诊疗室。
    并且 "moran" 位于 诊疗室。
    并且 c2_alive("moran")。
    并且 campaign_own("moran", 饥饿状态) 等于 true。
    并且 "c2.bowl" 的 "portions" 等于 0。
    并且 campaign_own(行动者, 持有口粮) 至少 1。
    并且 campaign_own("moran", "fever") 等于 true。
    并且 c2_alive(行动者)。
    则 campaign_own(行动者, 持有口粮) 增加 -1。
    并使 "c2.bowl" 的 "portions" 增加 1。
    并使 "c2.kitchen" 的 "cooked" 变为 true。

法则 c2_feed_patient_law，给定 行动者：
    当 行动者 位于 诊疗室。
    并且 "moran" 位于 诊疗室。
    并且 c2_alive("moran")。
    并且 campaign_own("moran", 饥饿状态) 等于 true。
    并且 campaign_own("moran", "fever") 等于 true。
    并且 "c2.bowl" 的 "portions" 至少 1。
    并且 c2_alive(行动者)。
    则 "c2.bowl" 的 "portions" 增加 -1。
    并使 "c2.bowl" 的 "residue" 变为 true。
    并使 campaign_own("moran", 已食用份数) 增加 1。
    并使 campaign_own("moran", 饥饿状态) 变为 false。
    并使 campaign_own(行动者, 正在照护) 变为 true。

法则 c2_leave_care_law，给定 行动者：
    前提 dv_fact(campaign_own(行动者, 正在照护), true)。
    则 campaign_own(行动者, 正在照护) 变为 false。

法则 c2_latch_request_law，给定 发起者、目标：
    当 发起者 位于 后勤院。
    并且 目标 位于 后勤院。
    并且 粮仓 的 "latch_loose" 等于 true。
    则 campaign_own(发起者, "repair_requested") 变为 true。

法则 c2_check_structure_law，给定 行动者：
    当 行动者 位于 后勤院。
    并且 campaign_window(2, 720, 1080)。
    并且 c2_alive(行动者)。
    并且 campaign_own(行动者, "can_structure") 等于 true。
    并且 粮仓 的 "structure_checked" 等于 false。
    则 粮仓 的 "structure_checked" 变为 true。

法则 c2_repair_latch_law，给定 行动者：
    当 行动者 位于 后勤院。
    并且 c2i_granary_support()。
    并且 campaign_window(3, 720, 840)。
    并且 campaign_own(行动者, "can_lock") 等于 true。
    并且 粮仓 的 "lift_mm" 等于 4。
    并且 粮仓 的 "structure_checked" 等于 true。
    并且 粮仓 的 "latch_loose" 等于 true。
    并且 c2_alive(行动者)。
    则 粮仓 的 "latch_loose" 变为 false。
    并使 粮仓 的 "tool_marks" 变为 true。
    并使 粮仓 的 双闩状态 变为 false。
    并使 粮仓 的 锁定状态 变为 false。

fn c2_norm_available(norm):
    if norm.id == "measurement_pause":
        return dv_all([campaign_window(4, 1050, 1260), campaign_any(dv_fact(campaign_ref("c2.weather", "wind"), false), dv_fact(campaign_ref("c2.weather", "earthquake_recent"), true))])
    if norm.id == "records_supplement":
        return dv_all([dv_fact(campaign_ref("c2.daily", "draft_notes"), true), dv_fact(campaign_ref("c2.dialogue.person.ruan", "said.ruan.c2.discuss-supplement"), true)])
    if norm.id == "night_forbid":
        return dv_all([dv_fact(campaign_ref("c2.daily", "draft_notes"), true), dv_fact(campaign_ref("c2.dialogue.person.ward", "said.ward.c2.discuss-forbid"), true)])
    return dv_true()

法则 c2_propose_law，给定 行动者、规约：
    当 c2_alive(行动者)。
    并且 c2_norm_available(规约)。
    并且 c2_norm_object(规约.id) 的 "owner" 等于 行动者。
    则 c2_norm_object(规约.id) 的 "proposed" 变为 true。

法则 c2_post_law，给定 行动者、规约：
    当 行动者 位于 规约.board。
    并且 c2_norm_object(规约.id) 的 "owner" 等于 行动者。
    并且 c2_norm_object(规约.id) 的 "proposed" 等于 true。
    并且 c2_norm_object(规约.id) 的 "posted" 等于 false。
    则 c2_norm_object(规约.id) 的 "posted" 变为 true。

法则 c2_read_norm_law，给定 行动者、规约：
    当 行动者 位于 规约.board。
    并且 c2_norm_object(规约.id) 的 "posted" 等于 true。
    并且 campaign_own(行动者, rt_cat("read.", 规约.id)) 等于 false。
    则 campaign_own(行动者, rt_cat("read.", 规约.id)) 变为 true。

法则 c2_decide_norm_law，给定 行动者、规约、是否接受：
    当 campaign_own(行动者, rt_cat("decided.", 规约.id)) 等于 false。
    并且 c2_alive(行动者)。
    则 campaign_own(行动者, rt_cat("decided.", 规约.id)) 变为 true。
    并使 campaign_own(行动者, rt_cat("accepted.", 规约.id)) 变为 是否接受。

fn c2_norm_actions(actor, norm):
    let object = c2_norm_object(norm.id)
    var result = []
    if actor == norm.owner:
        let id = rt_cat(actor, rt_cat(".c2.propose.", norm.id))
        let speech = dv_with_many(campaign_speech(dv_fact(campaign_ref(object, "text"), norm.surface), norm.source, "personal-norm-proposal"), {"surface": norm.surface, "utterance_type": "proposal", "norm_proposal": norm})
        var proposal = dv_with_many(campaign_surface_action(id, "talk", dv_all([campaign_at(actor, norm.board), c2_alive(actor), c2_norm_available(norm)]), dv_all([campaign_at(actor, norm.board), c2_alive(actor), c2_norm_available(norm)]), id, dv_single(campaign_ref(object, "proposed")), rt_cat("提出：", norm.title), norm.surface, norm.source), {"speech": speech, "listeners": campaign_people()})
        if norm.id == "measurement_pause":
            proposal = dv_with(proposal, "personal_choice", {"group": "measurement-pause-proposal", "requires": c2_norm_available(norm), "prohibits": dv_fact(campaign_ref(object, "proposed"), true), "promotes": norm.promotes, "sacrifices": norm.sacrifices, "require_positive": true, "basis": [norm.source]})
        rt_push(result, proposal)
        let post_id = rt_cat(actor, rt_cat(".c2.post.", norm.id))
        let pre = dv_all(dv_pair(campaign_at(actor, norm.board), dv_fact(campaign_ref(object, "proposed"), true)))
        rt_push(result, campaign_surface_action(post_id, "help", pre, pre, post_id, dv_single(campaign_ref(object, "posted")), rt_cat("张贴：", norm.title), dvs_surface_parts(["在公告板上贴出：", norm.surface]), norm.source))
    let peek = rt_cat(actor, rt_cat(".c2.inspect.board.", norm.id))
    rt_push(result, dv_with(campaign_surface_action(peek, "inspect", campaign_at(actor, norm.board), campaign_at(actor, norm.board), "", dv_single(campaign_ref(object, "posted")), rt_cat("检视公告：", norm.title), "查看公告板。", norm.source), "repeatable", true))
    let read_id = rt_cat(actor, rt_cat(".c2.read.", norm.id))
    let read_pre = dv_all([campaign_at(actor, norm.board), dv_fact(campaign_ref(object, "posted"), true), dv_fact(campaign_own(actor, rt_cat("read.", norm.id)), false)])
    rt_push(result, dv_with(campaign_surface_action(read_id, "read", read_pre, read_pre, read_id, dv_pair(campaign_ref(object, "text"), campaign_own(actor, rt_cat("read.", norm.id))), rt_cat("阅读：", norm.title), norm.surface, norm.source), "norm_receipt", {"norm": norm, "content": dv_fact(campaign_ref(object, "text"), norm.surface)}))
    let known = dv_fact(campaign_ref(object, "text"), norm.surface)
    var accepted = true
    var n = 0
    while n < 2:
        var verb = "accept"
        var promotes = norm.promotes
        var sacrifices = norm.sacrifices
        var surface = "我照这条做。"
        if not accepted:
            verb = "decline"
            promotes = norm.sacrifices
            sacrifices = norm.promotes
            surface = "这条我不认。"
        surface = dvs_surface_parts(["针对以下条文：\n", norm.surface, "\n", surface])
        let id = rt_cat(actor, rt_cat(".c2.", rt_cat(verb, rt_cat(".", norm.id))))
        let grants = dv_pair(campaign_own(actor, rt_cat("decided.", norm.id)), campaign_own(actor, rt_cat("accepted.", norm.id)))
        let speech = dv_with(campaign_speech(dv_true(), norm.source, "personal-norm-decision"), "surface", surface)
        let choice = {"group": rt_cat("norm.", norm.id), "requires": known, "prohibits": dv_fact(campaign_own(actor, rt_cat("decided.", norm.id)), true), "promotes": promotes, "sacrifices": sacrifices, "basis": [norm.source]}
        var supported_choice = choice
        if accepted:
            supported_choice = dv_with(choice, "require_positive", true)
        rt_push(result, dv_with_many(campaign_surface_action(id, "talk", known, dv_all([c2_alive(actor), dv_fact(campaign_own(actor, rt_cat("decided.", norm.id)), false)]), id, grants, rt_cat(dv_get({"accept": "赞成", "decline": "不采纳"}, verb), rt_cat("：", norm.title)), surface, norm.source), {"speech": speech, "listeners": [], "personal_choice": supported_choice, "norm_decision": {"id": norm.id, "accepted": accepted, "norm": norm}}))
        accepted = false
        n = n + 1
    return result

axiom c2_missed_meal_law(actor, day, meal, end):
    let suffix = rt_cat(rt_show(day), rt_cat(".", meal))
    return dv_axiom("c2_missed_meal_law", 1, dv_all([dv_at_least(campaign_clock(), (day - 1) * 1440 + end), dv_fact(campaign_own(actor, rt_cat("eaten.", suffix)), false), dv_fact(campaign_own(actor, rt_cat("hunger_checked.", suffix)), false), c2_alive(actor)]), dv_pair(dv_assign(campaign_own(actor, "hungry"), true), dv_assign(campaign_own(actor, rt_cat("hunger_checked.", suffix)), true)))

法则 c2_terminal_exposure_law，给定 行动者：
    当 c2_alive(行动者)。
    并且 campaign_own(行动者, "dead") 等于 true。
    并且 campaign_own(行动者, "exposure_terminal") 等于 true。
    则 campaign_own(行动者, 存活状态) 变为 false。

法则 c2_first_wind_law：
    当 campaign_clock() 至少 1980。
    并且 "c2.weather" 的 "phase" 等于 "falling_ash"。
    则 "c2.weather" 的 "phase" 变为 "wind_started"。
    并使 "c2.weather" 的 "severe_air" 变为 false。
    并使 "c2.weather" 的 "wind" 变为 true。
    并使 "c2.weather" 的 "ash_falling" 变为 false。
    并使 "c2.corridor.north" 的 "intake_safe" 变为 true。
    并使 "c2.corridor.east" 的 "intake_safe" 变为 true。
    并使 "c2.weather" 的 "environment_epoch" 增加 1。
    并使 "c2.meter" 的 "environment_epoch" 增加 1。

fn c2_weather_changes():
    return [
        {"id": "third_night", "minute": 4140, "wind": false, "quake": false, "severe": true, "recheck": false},
        {"id": "fourth_quake", "minute": 5370, "wind": false, "quake": true, "severe": true, "recheck": true},
        {"id": "fifth_dawn", "minute": 6120, "wind": true, "quake": false, "severe": false, "recheck": false}]

axiom c2_weather_change_law(change):
    let mark = campaign_ref("c2.weather", rt_cat("occurred.", change.id))
    var effects = [dv_assign(mark, true), dv_assign(campaign_ref("c2.weather", "wind"), change.wind), dv_assign(campaign_ref("c2.weather", "earthquake_recent"), change.quake), dv_assign(campaign_ref("c2.weather", "severe_air"), change.severe), dv_increment(campaign_ref("c2.weather", "environment_epoch"), 1), dv_increment(campaign_ref("c2.meter", "environment_epoch"), 1)]
    if change.severe or change.recheck or change.id == "fifth_dawn":
        let gates = ["north", "east"]
        var i = 0
        while i < rt_count(gates):
            rt_push(effects, dv_assign(campaign_ref(rt_cat("c2.corridor.", gates[i]), "intake_safe"), not change.severe))
            if change.recheck:
                rt_push(effects, dv_assign(campaign_ref(rt_cat("c2.corridor.", gates[i]), "air_safe"), false))
                rt_push(effects, dv_assign(campaign_ref(rt_cat("c2.corridor.", gates[i]), "ventilated"), false))
            i = i + 1
    return dv_axiom("c2_weather_change_law", 1, dv_all([dv_at_least(campaign_clock(), change.minute), dv_fact(mark, false)]), effects)

axiom c2_daylight_law(day, light):
    var phase = "night"
    var period = c2_night(day)
    if light:
        phase = "day"
        period = campaign_window(day, 360, 1260)
    return dv_axiom("c2_daylight_law", 1, dv_all([period, dv_not(dv_fact(campaign_ref("c2.weather", "daylight_phase"), phase))]), [dv_assign(campaign_ref("c2.weather", "daylight"), light), dv_assign(campaign_ref("c2.weather", "daylight_phase"), phase)])

fn c2_corridor_origin(gate):
    if gate == "east":
        return "central_hall"
    return "living_hall"

// Ventilated records a completed purge under measured safe intake conditions.
axiom c2_purge_corridor_law(actor, gate):
    let object = rt_cat("c2.corridor.", gate)
    let origin_condition = campaign_any(campaign_at(actor, c2_corridor_origin(gate)), campaign_at(actor, "central_hall"))
    return dv_axiom("c2_purge_corridor_law", 1, dv_all([origin_condition, c2_alive(actor), dv_fact(campaign_ref(object, "intake_safe"), true), dv_fact(campaign_ref(object, "seal_intact"), true), dv_fact(campaign_ref("c2.weather", "severe_air"), false), dv_fact(campaign_ref(object, "ventilated"), false)]), [dv_assign(campaign_ref(object, "ventilated"), true), dv_assign(campaign_ref(object, "air_safe"), true)])

axiom c2_open_corridor_law(actor, gate):
    let object = rt_cat("c2.corridor.", gate)
    let origin_condition = campaign_any(campaign_at(actor, c2_corridor_origin(gate)), campaign_at(actor, "central_hall"))
    return dv_axiom("c2_open_corridor_law", 1, dv_all([origin_condition, c2_alive(actor), dv_fact(campaign_ref(object, "air_safe"), true), dv_fact(campaign_ref(object, "seal_intact"), true), dv_fact(campaign_ref(object, "ventilated"), true), dv_fact(campaign_access(gate), false), dv_fact(campaign_ref(object, "airlock_held"), false)]), [dv_assign(campaign_access(gate), true)])

fn c2_corridor_actions(actor):
    var actions = []
    let gates = ["north", "east"]
    var i = 0
    while i < rt_count(gates):
        let gate = gates[i]
        let object = rt_cat("c2.corridor.", gate)
        let source = campaign_approved("第五部分：封闭连廊的现场读数、密封与通风")
        let inspection = c2_inspect_action(actor, object, c2_corridor_origin(gate), ["air_safe", "intake_safe", "seal_intact", "ventilated", "airlock_held", "airlock_hazard"], "实测连廊读数并核对密封", "从安全侧实测补风处读数，核对密封与已完成的换气记录。", source)
        rt_push(actions, dv_with(inspection, "grants", dv_append(inspection.grants, campaign_ref("c2.weather", "severe_air"))))
        let purge = c2_purge_corridor_law(actor, gate)
        let purge_id = rt_cat(actor, rt_cat(".c2.purge.corridor.", gate))
        rt_push(actions, dv_with(campaign_surface_action(purge_id, "help", purge.premise, purge.premise, purge_id, [campaign_ref(object, "ventilated"), campaign_ref(object, "air_safe")], "核对补风路径并换气", "核对补风处读数与排烟路径，完成连廊换气后收拢风门。", source), "predict_law", purge_id))
        let law = c2_open_corridor_law(actor, gate)
        let id = rt_cat(actor, rt_cat(".c2.open.corridor.", gate))
        var action = campaign_surface_action(id, "help", law.premise, law.premise, id, [campaign_access(gate)], "开启连廊隔离门", "核对现场条件后，开启连廊隔离门。", source)
        action = dv_with_many(action, {"predict_law": id, "public_observers": dv_append(campaign_people(), "demon"), "public_grants": [campaign_access(gate)]})
        rt_push(actions, action)
        i = i + 1
    return actions

fn c2_supply_actions(actor):
    var result = []
    var day = 2
    while day <= 5:
        let meals = [{"id": "noon", "start": 720, "end": 840}, {"id": "evening", "start": 1080, "end": 1260}]
        var i = 0
        while i < rt_count(meals):
            let meal = meals[i]
            let suffix = rt_cat(rt_show(day), rt_cat(".", meal.id))
            let id = rt_cat(actor, rt_cat(".c2.collect.", suffix))
            let flag = rt_cat("collected.", suffix)
            let known = dv_all([campaign_at(actor, "logistics"), campaign_window(day, meal.start, meal.end), dv_fact(campaign_ref("c2.counter", "open"), true), dv_fact(campaign_own(actor, flag), false)])
            if day != 2 or meal.id != "noon":
                rt_push(result, dv_with(campaign_surface_action(id, "help", known, known, id, [campaign_ref("c2.counter", "remaining"), campaign_own(actor, "rations"), campaign_own(actor, flag), campaign_ref("c2.ledger", "day_recorded")], "领取一份口粮", "在配给台领了一份口粮。", c2_source("10_执行.story", 10, "Collect")), "normative_method", "collect_and_count"))
            let eat = rt_cat(actor, rt_cat(".c2.eat.", suffix))
            let eat_known = dv_all([campaign_window(day, meal.start, meal.end), dv_at_least(campaign_own(actor, "rations"), 1), dv_fact(campaign_own(actor, rt_cat("eaten.", suffix)), false)])
            rt_push(result, campaign_surface_action(eat, "help", eat_known, eat_known, eat, [campaign_own(actor, "rations"), campaign_own(actor, "consumed"), campaign_own(actor, "hungry"), campaign_own(actor, rt_cat("eaten.", suffix))], "吃一份随身口粮", "吃了手里的那份口粮。", campaign_approved("two-actual-meals-per-person-not-a-daily-stock-deduction")))
            i = i + 1
        day = day + 1
    let open = rt_cat(actor, ".c2.open.granary")
    let can_open = campaign_any(dv_fact(campaign_ref("c2.granary", "key_owner"), actor), dv_fact(campaign_own(actor, "can_lock"), true))
    let open_pre = dv_all(dv_pair(campaign_at(actor, "logistics"), can_open))
    rt_push(result, campaign_surface_action(open, "experiment", open_pre, open_pre, open, dv_single(campaign_ref("c2.granary", "locked")), "打开粮仓门锁", "打开粮仓的门锁。", c2_source("10_执行.story", 34, "OpenGranary")))
    let key = dv_all(dv_pair(campaign_at(actor, "logistics"), dv_fact(campaign_ref("c2.granary", "key_owner"), actor)))
    let count_id = rt_cat(actor, ".c2.count.initial")
    let count_known = dv_all([campaign_at(actor, "logistics"), dv_fact(campaign_ref("c2.counter", "remaining"), 99), dv_fact(campaign_ref("c2.ledger", "counted"), 0)])
    rt_push(result, campaign_surface_action(count_id, "help", count_known, c2_initial_count_law(actor).premise, count_id, [campaign_ref("c2.ledger", "counted")], "清点外间存粮并记账", "逐份清点外间干粮，将九十九份的起始实数记入新台账。", campaign_approved("外间实际清点与新台账")))
    let distribute = rt_cat(actor, ".c2.distribute")
    rt_push(result, campaign_surface_action(distribute, "help", c2_distribute_law(actor).premise, c2_distribute_law(actor).premise, distribute, [campaign_ref("c2.counter", "open")], "开启配给台", "配给台开始发粮。", campaign_approved("counter-99-is-independent-of-total-granary-key")))
    if actor == "quer":
        let total_store = rt_cat(actor, ".c2.open.total_store")
        let ready = dv_all([c2_total_store_open_law(actor).premise, c2_work_accepted(actor, "quer.c2.granary.precision")])
        rt_push(result, dv_with(campaign_surface_action(total_store, "experiment", ready, c2_total_store_open_law(actor).premise, total_store, [campaign_ref("c2.granary", "total_store_locked"), campaign_ref("c2.granary", "reserve_added"), campaign_ref("c2.counter", "remaining"), campaign_ref("c2.ledger", "reserve_received")], "推开总库门并清点存粮", "在结构楔与千斤顶持续承托下推开总库门，将实际新增存粮并入配给库存。", campaign_approved("总库开启需要修闩与解锁的实际结果")), "work_operation", "quer.c2.granary.precision"))
    if actor != "shen":
        let give = rt_cat(actor, ".c2.give_key.shen")
        rt_push(result, campaign_surface_action(give, "help", key, dv_all(dv_pair(key, campaign_at("shen", "logistics"))), give, dv_single(campaign_ref("c2.granary", "key_owner")), "交出粮仓钥匙", "把粮仓钥匙交给沈鼎。", c2_source("10_执行.story", 15, "GiveKey")))
    let report = rt_cat(actor, ".c2.report.night_take")
    let report_pre = c2_report_law(actor).premise
    rt_push(result, campaign_surface_action(report, "talk", report_pre, report_pre, report, [campaign_own(actor, "owe_notes"), campaign_ref("c2.ledger", "night_recorded"), campaign_own(actor, "night_taken")], "补记本人夜间取粮", "在台账上补记了夜里取的一份。", c2_source("10_执行.story", 9, "Inform")))
    if dv_has(campaign_people(), actor):
        let id = rt_cat(actor, ".c2.night_take")
        let pre = c2_night_take_law(actor, false).premise
        rt_push(result, dv_with(campaign_surface_action(id, "help", pre, pre, id, [campaign_own(actor, "rations"), campaign_own(actor, "owe_notes"), campaign_own(actor, "night_taken"), campaign_ref("c2.counter", "remaining")], "夜间取一份口粮", "从配给台取了一份口粮，留待补记。", campaign_approved("按实际饥饿与持粮状态夜取")), "normative_method", "unrecorded_take"))
        let eat = rt_cat(actor, ".c2.night_eat")
        let pre_eat = c2_night_eat_law(actor).premise
        rt_push(result, campaign_surface_action(eat, "help", pre_eat, pre_eat, eat, [campaign_own(actor, "rations"), campaign_own(actor, "hungry"), campaign_own(actor, "consumed"), campaign_ref(rt_cat("c2.litter.", campaign_profile(actor).group), "crumbs")], "吃一份随身口粮", "吃了手里的那份口粮。", campaign_approved("夜食在实际地点留下痕迹")))
    if actor == "mora":
        let pre = c2_night_take_law(actor, true).premise
        rt_push(result, dv_with(campaign_surface_action("mora.c2.night_take.patient", "help", pre, pre, "mora.c2.night_take.patient", [campaign_own(actor, "rations"), campaign_own(actor, "owe_notes"), campaign_own(actor, "night_taken"), campaign_ref("c2.counter", "remaining")], "为病人领取口粮", "从配给台取一份口粮，准备送去诊疗所。", campaign_approved("按本人所知的照护需要取粮")), "normative_method", "unrecorded_take"))
    return result

fn c2_special_actions(actor):
    var result = []
    if actor == "margaret":
        let id = rt_cat(actor, ".c2.check.structure")
        let pre = c2_check_structure_law(actor).premise
        rt_push(result, campaign_surface_action(id, "experiment", pre, pre, id, [campaign_ref("c2.granary", "structure_checked"), campaign_ref("c2.granary", "latch_loose")], "检查门闩与门框受力", "检查变形门闩与门框受力，确认修整的位置。", campaign_approved("粮仓结构检查与机械处理")))
    if actor == "margaret":
        let source = c2_source("04_案件.story", 84, "actual-latch-repair-request")
        let pre = dv_all(dv_pair(campaign_at(actor, "logistics"), dv_fact(campaign_ref("c2.granary", "latch_loose"), true)))
        let speech = dv_with_many(campaign_speech(dv_true(), source, "repair-request"), {"surface": "粮仓的门闩松了。雀儿，请你修一修。", "request": {"target": "quer", "topic": "repair_latch"}})
        rt_push(result, dv_with_many(campaign_surface_action("margaret.c2.request.repair_latch", "talk", pre, pre, "margaret.c2.request.repair_latch", [], "请求修理粮仓门闩", "粮仓的门闩松了。雀儿，请你修一修。", source), {"speech": speech, "listeners": ["quer"]}))
    if actor == "quer":
        let physical = c2_repair_latch_law(actor).premise
        let pre = dv_all([physical, c2_work_accepted(actor, "quer.c2.granary.precision")])
        let id = rt_cat(actor, ".c2.repair.latch")
        rt_push(result, dv_with(campaign_surface_action(id, "experiment", pre, physical, id, [campaign_ref("c2.granary", "latch_loose"), campaign_ref("c2.granary", "tool_marks"), campaign_ref("c2.granary", "double_bolts"), campaign_ref("c2.granary", "locked")], "修整粮仓门闩与双栓", "趁门框抬起四毫米，双钩同时挑开两根门栓，再紧固门闩。", c2_source("10_执行.story", 17, "RepairLatch")), "work_operation", "quer.c2.granary.precision"))
    if actor == "mora" or actor == "selma" or actor == "shen":
        let inspection = c2_inspect_action(actor, campaign_body("moran"), "clinic", ["fever", "hungry", "alive"], "查看病人的状况", "走近莫兰，查看他的状况。", campaign_approved("moran-illness-requires-actual-exposure-and-observation"))
        let patient_present = dv_all(dv_pair(campaign_at(actor, "clinic"), campaign_at("moran", "clinic")))
        rt_push(result, dv_with_many(inspection, {"precondition": patient_present, "authority_precondition": patient_present}))
        let deliver = rt_cat(actor, ".c2.deliver.patient_food")
        let carry = c2_deliver_patient_law(actor).premise
        rt_push(result, campaign_surface_action(deliver, "help", carry, carry, deliver, [campaign_own(actor, "rations"), campaign_ref("c2.bowl", "portions")], "为病人煮粥并送餐", "将实际取来的一份粮煮成粥，盛到莫兰床边的碗里。", c2_source("10_执行.story", 7, "NightTakeSick-delivery")))
        let feed = rt_cat(actor, ".c2.feed.patient")
        let food = c2_feed_patient_law(actor).premise
        rt_push(result, campaign_surface_action(feed, "help", food, food, feed, [campaign_ref("c2.bowl", "portions"), campaign_ref("c2.bowl", "residue"), campaign_own(actor, "busy_care"), campaign_own("moran", "hungry"), campaign_own("moran", "consumed")], "照看病人进食", "照看莫兰吃饭。", c2_source("10_执行.story", 286, "patient-breakfast-from-real-food")))
        let leave = rt_cat(actor, ".c2.leave.care")
        let busy = dv_fact(campaign_own(actor, "busy_care"), true)
        rt_push(result, campaign_surface_action(leave, "help", busy, busy, leave, dv_single(campaign_own(actor, "busy_care")), "暂停照护", "暂且停下照看。", campaign_approved("actual-care-and-report-compete-for-personal-time")))
    return result

fn c2_inspections(actor):
    var result = c2_route_inspections(actor)
    let source = c2_source("04_案件.story", 8, "actual-evidence-catalog")
    rt_push(result, c2_inspect_action(actor, "c2.granary", "logistics", ["locked", "latch_loose", "structure_checked", "tool_marks", "total_store_locked", "water_valve_hazard", "pulley_hazard", "timber_hazard"], "检视粮仓门闩和门锁", "细看粮仓门闩和门锁。", source))
    rt_push(result, c2_inspect_action(actor, "c2.ledger", "logistics", ["day_recorded", "night_recorded", "counted", "reserve_received", "supplement_column", "pending_registered"], "翻看配给台账", "翻看台账上的领取和补记。", source))
    rt_push(result, c2_inspect_action(actor, "c2.counter", "logistics", ["open", "remaining"], "检视配给台与口粮", "查看配给台和剩下的口粮。", source))
    rt_push(result, c2_inspect_action(actor, "c2.bowl", "clinic", ["portions", "residue"], "检视病床旁的碗", "细看莫兰床边的碗。", source))
    let groups = ["living", "contract", "astral", "logistics"]
    var i = 0
    while i < rt_count(groups):
        var room = rt_cat("dorm.", groups[i])
        if groups[i] == "living":
            room = "hall"
        rt_push(result, c2_inspect_action(actor, rt_cat("c2.litter.", groups[i]), room, ["crumbs"], "检视废纸篓", "细看废纸篓。", source))
        i = i + 1
    return result

