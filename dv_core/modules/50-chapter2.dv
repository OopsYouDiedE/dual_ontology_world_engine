fn c2_rescue_edges():
    return [{"from": "outdoor_alley", "to": "outdoor_high", "gate": "north"}, {"from": "outdoor_high", "to": "outdoor_meter", "gate": "north"}, {"from": "outdoor_meter", "to": "central_hall", "gate": "north"}, {"from": "central_hall", "to": "living_hall", "gate": "north"}]

axiom c2_carry_moran_law(origin, target, gate):
    let premise = dv_all([c2_can_act("bertrand"), c2_alive("moran"), campaign_at("bertrand", origin), campaign_at("moran", origin), dv_fact(campaign_access(gate), true), dv_fact(campaign_own("moran", "in_coma"), true), dv_fact(campaign_own("bertrand", "carrying"), "moran"), dv_fact(campaign_own("moran", "carried_by"), "bertrand")])
    var effects = [dv_assign(campaign_position_ref("bertrand"), target), dv_assign(campaign_position_ref("moran"), target)]
    if target == "living_hall":
        rt_push(effects, dv_assign(campaign_own("bertrand", "carrying"), ""))
        rt_push(effects, dv_assign(campaign_own("moran", "carried_by"), ""))
    return dv_axiom("c2_carry_moran_law", 1, premise, effects)

fn c2_carry_moran_action(origin, target, gate):
    let id = rt_cat("bertrand.c2.carry.", rt_cat(origin, rt_cat(".", target)))
    let law = c2_carry_moran_law(origin, target, gate)
    let grants = [campaign_position_ref("bertrand"), campaign_position_ref("moran"), campaign_own("bertrand", "carrying"), campaign_own("moran", "carried_by")]
    return dv_with_many(campaign_surface_action(id, "move", law.premise, law.premise, id, grants, rt_cat("搬运伤者前往", c2_place_label(target)), dvs_surface_parts(["扶住昏迷的莫兰，从", c2_place_label(origin), "逐段搬至", c2_place_label(target), "。"]), campaign_approved("actual-contact-and-segmented-rescue")), {"repeatable": true, "travel": {"from": origin, "to": target, "gate": gate}, "predict_law": id, "public_observers": campaign_people(), "public_grants": grants})

// Shared pathology does not inspect detective policy or select a victim.
// Durations are new authored engineering parameters, not medical measurements.
fn c2_care_patients():
    return ["su", "moran", "bertrand"]

axiom c2_disease_weakness_law(actor):
    let pre = dv_all([c2_alive(actor), dv_held_for(campaign_own(actor, "active_erosion_disease"), true, campaign_clock(), 4320), dv_fact(campaign_own(actor, "anti_erosion_treated"), false), dv_fact(campaign_own(actor, "severe_weakness"), false)])
    return dv_axiom("c2_disease_weakness_law", 1, pre, [dv_assign(campaign_own(actor, "severe_weakness"), true)])

axiom c2_disease_impairment_law(actor):
    let pre = dv_all([c2_alive(actor), dv_fact(campaign_own(actor, "active_erosion_disease"), true), dv_held_for(campaign_own(actor, "severe_weakness"), true, campaign_clock(), 720), dv_fact(campaign_own(actor, "anti_erosion_treated"), false), dv_fact(campaign_own(actor, "motor_impairment"), false)])
    return dv_axiom("c2_disease_impairment_law", 1, pre, [dv_assign(campaign_own(actor, "motor_impairment"), true), dv_assign(campaign_own(actor, "serious_injury"), true), dv_assign(campaign_ref("c2.casualty", "casualty_occurred"), true)])

axiom c2_respiratory_failure_law(actor):
    let impaired = campaign_any(dv_fact(campaign_own(actor, "in_coma"), true), dv_fact(campaign_own(actor, "stone_stupor"), true))
    let pre = dv_all([c2_alive(actor), impaired, dv_at_least(campaign_own(actor, "erosion_exposure"), 8), dv_fact(campaign_own(actor, "anti_erosion_treated"), false), dv_fact(campaign_own(actor, "respiratory_failure"), false)])
    return dv_axiom("c2_respiratory_failure_law", 1, pre, [dv_assign(campaign_own(actor, "respiratory_failure"), true), dv_assign(campaign_own(actor, "serious_injury"), true), dv_assign(campaign_ref("c2.casualty", "casualty_occurred"), true)])

axiom c2_respiratory_terminal_law(actor):
    let pre = dv_all([c2_alive(actor), dv_at_least(campaign_own(actor, "erosion_exposure"), 8), dv_held_for(campaign_own(actor, "respiratory_failure"), true, campaign_clock(), 120), dv_fact(campaign_own(actor, "anti_erosion_treated"), false)])
    var effects = [dv_assign(campaign_own(actor, "dead"), true), dv_assign(campaign_own(actor, "alive"), false), dv_assign(campaign_own(actor, "exposure_terminal"), true), dv_assign(campaign_ref("c2.casualty", "casualty_occurred"), true)]
    if actor == "moran":
        rt_push(effects, dv_assign(campaign_ref("c2.casualty", "moran_dead"), true))
    return dv_axiom("c2_respiratory_terminal_law", 1, pre, effects)

fn c2_moran_fatal_settle_law():
    return c2_respiratory_terminal_law("moran")

