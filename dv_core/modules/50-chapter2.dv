fn c2_all_companions_fallen():
    let people = campaign_people()
    var fallen = []
    var i = 0
    while i < rt_count(people):
        let p = people[i]
        if p != "detective":
            rt_push(fallen, dv_fact(campaign_own(p, "alive"), false))
        i = i + 1
    return dv_all(fallen)

fn c2_foolish_duty_actions(actor):
    if actor != "detective":
        return []
    var result = []
    let source = campaign_source("docs/design-standard.md", 0, "愚蠢侦探路线：抱团生存与日常运转")
    let assist_rations_id = "detective.c2.duty.assist_rations"
    let rations_pre = dv_all([campaign_at("detective", "living_hall"), c2_alive("detective"), dv_fact(campaign_ref("c2.counter", "open"), true), dv_fact(campaign_ref("c2.duty", "rations_assisted"), false)])
    let assist_rations = campaign_surface_action(assist_rations_id, "help", rations_pre, rations_pre, assist_rations_id, [campaign_ref("c2.duty", "rations_assisted")], "协助分发热汤和配给", "在生活厅协助沈鼎分发热汤与温热配给，照料同伴温饱。", source)
    rt_push(result, dv_with_many(assist_rations, {"repeatable": false, "personal_choice": {"group": "detective-duty", "requires": rations_pre, "prohibits": dv_fact(campaign_ref("c2.duty", "rations_assisted"), true), "promotes": ["solidarity", "safety", "measured_work"], "sacrifices": [], "basis": [source]}}))
    let assist_prop_id = "detective.c2.duty.assist_prop"
    let prop_pre = dv_all([campaign_at("detective", "logistics"), c2_alive("detective"), dv_fact(campaign_ref("c2.granary", "latch_loose"), true), dv_fact(campaign_ref("c2.duty", "prop_assisted"), false)])
    let assist_prop = campaign_surface_action(assist_prop_id, "help", prop_pre, prop_pre, assist_prop_id, [campaign_ref("c2.duty", "prop_assisted")], "协助扶稳承重支撑", "在后勤院协助霍铎与玛格丽特扶稳千斤顶立柱，稳固承重支撑。", source)
    rt_push(result, dv_with_many(assist_prop, {"repeatable": false, "personal_choice": {"group": "detective-duty", "requires": prop_pre, "prohibits": dv_fact(campaign_ref("c2.duty", "prop_assisted"), true), "promotes": ["solidarity", "safety", "measured_work"], "sacrifices": [], "basis": [source]}}))
    let assist_med_id = "detective.c2.duty.assist_medicine"
    let med_pre = dv_all([campaign_at("detective", "clinic"), c2_alive("detective"), dv_fact(campaign_own("moran", "fever"), true), dv_fact(campaign_ref("c2.duty", "medicine_assisted"), false)])
    let assist_med = campaign_surface_action(assist_med_id, "help", med_pre, med_pre, assist_med_id, [campaign_ref("c2.duty", "medicine_assisted")], "协助递送汤药", "在诊疗所协助茉拉跑腿递送退烧汤药，缓解伤患高热痛苦。", source)
    rt_push(result, dv_with_many(assist_med, {"repeatable": false, "personal_choice": {"group": "detective-duty", "requires": med_pre, "prohibits": dv_fact(campaign_ref("c2.duty", "medicine_assisted"), true), "promotes": ["patient_priority", "solidarity", "safety"], "sacrifices": [], "basis": [source]}}))
    let comfort_id = "detective.c2.duty.comfort"
    let comfort_pre = dv_all([campaign_at("detective", "living_hall"), c2_alive("detective"), c2_any_night(), dv_fact(campaign_ref("c2.duty", "comforted"), false)])
    let comfort_act = campaign_surface_action(comfort_id, "help", comfort_pre, comfort_pre, comfort_id, [campaign_ref("c2.duty", "comforted")], "安抚受惊的同伴", "在生活厅安抚受惊崩溃的同伴，维系社群凝聚力与求生希望。", source)
    rt_push(result, dv_with_many(comfort_act, {"repeatable": false, "personal_choice": {"group": "detective-duty", "requires": comfort_pre, "prohibits": dv_fact(campaign_ref("c2.duty", "comforted"), true), "promotes": ["solidarity", "safety"], "sacrifices": [], "basis": [source]}}))
    return result

fn c2_hero_substitutions(actor):
    var result = []
    let source = campaign_source("docs/design-standard.md", 0, "危机爆发时的群像英雄补位与替换决定")
    if actor == "lucian":
        let id = "lucian.c2.hero.airlock_brace"
        let pre = dv_all([campaign_at("lucian", "living_hall"), c2_alive("lucian"), c2_night(4), dv_fact(campaign_ref("c2.corridor.north", "airlock_hazard"), true), dv_fact(campaign_ref("c2.corridor.north", "airlock_held"), false)])
        let choice = {"group": "heroic-substitution", "requires": pre, "prohibits": dv_fact(campaign_ref("c2.corridor.north", "airlock_held"), true), "promotes": ["heroic_substitution", "solidarity", "safety"], "sacrifices": ["resonance_exclusivity"], "basis": [source]}
        let act = campaign_surface_action(id, "help", pre, pre, id, [campaign_ref("c2.corridor.north", "airlock_held")], "值守北气闸", "卢西安收敛狂言，以古典贵族骑士道精神在侦探失职时死守气闸，阻挡毒雾侵袭。", source)
        rt_push(result, dv_with_many(act, {"repeatable": false, "personal_choice": choice, "public_observers": campaign_people(), "public_grants": [campaign_ref("c2.corridor.north", "airlock_held")]}))
    if actor == "quer":
        let id = "quer.c2.hero.valve_repair"
        let pre = dv_all([campaign_at("quer", "logistics"), c2_alive("quer"), c2_night(3), dv_fact(campaign_ref("c2.granary", "water_valve_hazard"), true), dv_fact(campaign_ref("c2.granary", "water_valve_repaired"), false)])
        let choice = {"group": "heroic-substitution", "requires": pre, "prohibits": dv_fact(campaign_ref("c2.granary", "water_valve_repaired"), true), "promotes": ["heroic_substitution", "solidarity", "safety"], "sacrifices": ["not_targeted"], "basis": [source]}
        let act = campaign_surface_action(id, "help", pre, pre, id, [campaign_ref("c2.granary", "water_valve_repaired")], "抢修供水主阀", "雀儿深夜冒险攀爬外墙，徒手抢修破裂的供水主阀，恢复学园生机。", source)
        rt_push(result, dv_with_many(act, {"repeatable": false, "personal_choice": choice, "public_observers": campaign_people(), "public_grants": [campaign_ref("c2.granary", "water_valve_repaired")]}))
    if actor == "shen" or actor == "huo":
        let id = rt_cat(actor, ".c2.hero.pulley_brace")
        let pre = dv_all([campaign_at(actor, "logistics"), c2_alive(actor), c2_night(4), dv_fact(campaign_ref("c2.granary", "pulley_hazard"), true), dv_fact(campaign_ref("c2.granary", "pulley_braced"), false)])
        let choice = {"group": "heroic-substitution", "requires": pre, "prohibits": dv_fact(campaign_ref("c2.granary", "pulley_braced"), true), "promotes": ["heroic_substitution", "solidarity", "safety"], "sacrifices": ["measured_work"], "basis": [source]}
        let act = campaign_surface_action(id, "help", pre, pre, id, [campaign_ref("c2.granary", "pulley_braced")], "承托配重滑轮", "在门框变形险情中，省下自身口粮救济伤员，以血肉之躯死死抵住配重滑轮。", source)
        rt_push(result, dv_with_many(act, {"repeatable": false, "personal_choice": choice, "public_observers": campaign_people(), "public_grants": [campaign_ref("c2.granary", "pulley_braced")]}))
    if actor == "margaret":
        let id = "margaret.c2.hero.timber_brace"
        let pre = dv_all([campaign_at("margaret", "living_hall"), c2_alive("margaret"), c2_night(4), dv_fact(campaign_ref("c2.granary", "timber_hazard"), true), dv_fact(campaign_ref("c2.granary", "timber_braced"), false)])
        let choice = {"group": "heroic-substitution", "requires": pre, "prohibits": dv_fact(campaign_ref("c2.granary", "timber_braced"), true), "promotes": ["heroic_substitution", "solidarity", "safety"], "sacrifices": [], "basis": [source]}
        let act = campaign_surface_action(id, "help", pre, pre, id, [campaign_ref("c2.granary", "timber_braced")], "架起承重枕木", "在坍塌险情中，玛格丽特用肩膀架起承重枕木，掩护受惊同伴撤回安全区。", source)
        rt_push(result, dv_with_many(act, {"repeatable": false, "personal_choice": choice, "public_observers": campaign_people(), "public_grants": [campaign_ref("c2.granary", "timber_braced")]}))
    return result

fn c2_hero_actions(actor):
    return c2_hero_substitutions(actor)

fn c2_moran_outing_heard(actor):
    if c2_received_requirement(actor, {"speaker": "demon", "action_id": "demon.c2.relay.moran-outing.false"}) or c2_received_requirement(actor, {"speaker": "demon", "action_id": "demon.c2.relay.moran-outing.true"}):
        return true
    return c2_received_requirement(actor, {"speaker": "moran", "action_id": "moran.c2.sketch.evening.go.false"}) or c2_received_requirement(actor, {"speaker": "moran", "action_id": "moran.c2.sketch.evening.go.true"})

fn c2_casualty_actions(actor):
    var result = []
    let source = campaign_source("docs/design-standard.md", 0, "蝴蝶效应连送两人惨败机制")
    if actor == "moran":
        let id = "moran.c2.sketch.outdoor_night"
        let pre = c2_moran_sketch_outdoor_law().premise
        let grants = [campaign_own("moran", "evening_sketch_completed")]
        let act = campaign_surface_action(id, "experiment", pre, pre, id, grants, "在夹道写生", "在实际抵达的夹道对着色层完成一段写生。", source)
        rt_push(result, dv_with_many(act, {"repeatable": false, "public_observers": campaign_people(), "public_grants": grants}))
    if actor == "bertrand":
        let search_known = dv_all([c2_night(4), c2_can_act(actor), campaign_at(actor, "outdoor_alley")])
        let search_contact = dv_all([search_known, campaign_at("moran", "outdoor_alley")])
        let search_grants = [campaign_position_ref("moran"), campaign_own("moran", "alive"), campaign_own("moran", "in_coma"), campaign_own("moran", "carried_by")]
        rt_push(result, dv_with_many(campaign_surface_action("bertrand.c2.search.moran-alley", "inspect", search_known, search_contact, "", search_grants, "沿听到的写生去向寻找同伴", "沿本人实际听到的外出方向抵达夹道，在现场查找并检查同伴。", campaign_approved("user:2026-10-22-search-from-real-heard-intention")), {"received_speech_requirement": {"speaker": "moran", "action_id": "moran.c2.sketch.evening.go.false"}}))
        let id = "bertrand.c2.rescue.moran_from_alley"
        let law = c2_bertrand_rescue_law()
        let grants = [campaign_own("bertrand", "carrying"), campaign_own("moran", "carried_by"), campaign_own("bertrand", "rescue_exposed")]
        let act = campaign_surface_action(id, "help", law.premise, law.premise, id, grants, "扶起伤者并准备搬运", "在夹道实际接触昏迷的莫兰，扶起同伴，准备沿原路逐段搬回。", source)
        rt_push(result, dv_with_many(act, {"repeatable": false, "personal_choice": {"group": "rescue-moran", "requires": law.premise, "prohibits": dv_fact(campaign_own("bertrand", "carrying"), "moran"), "promotes": ["solidarity", "safety"], "sacrifices": [], "basis": [source]}, "public_observers": campaign_people(), "public_grants": grants}))
        let edges = c2_rescue_edges()
        var i = 0
        while i < rt_count(edges):
            rt_push(result, c2_carry_moran_action(edges[i].from, edges[i].to, edges[i].gate))
            i = i + 1
    let patients = c2_care_patients()
    let rooms = c2_rooms()
    var patient_index = 0
    while patient_index < rt_count(patients):
        let patient = patients[patient_index]
        var contacts = []
        var room_index = 0
        while room_index < rt_count(rooms):
            let room = rooms[room_index]
            rt_push(contacts, dv_all([campaign_at(actor, room), campaign_at(patient, room)]))
            room_index = room_index + 1
        let pre = dv_all([c2_can_act(actor), dv_not(dv_all(c2_negated_conditions(contacts)))])
        let id = rt_cat(actor, rt_cat(".c2.examine.", patient))
        let fields = ["alive", "dead", "in_coma", "stone_stupor", "anti_erosion_treated", "active_erosion_disease", "severe_weakness", "motor_impairment", "serious_injury", "respiratory_failure", "carrying", "carried_by"]
        var grants = [campaign_position_ref(patient)]
        var field_index = 0
        while field_index < rt_count(fields):
            rt_push(grants, campaign_own(patient, fields[field_index]))
            field_index = field_index + 1
        let lines = [c2_visible_line(dv_true(), "现场生命迹象：{生命}；意识：{意识}；木僵症状：{木僵}。", [c2_visible_binding("生命", campaign_own(patient, "alive"), {"true": "存活", "false": "已无生命迹象"}), c2_visible_binding("意识", campaign_own(patient, "in_coma"), {"true": "昏迷", "false": "未见昏迷"}), c2_visible_binding("木僵", campaign_own(patient, "stone_stupor"), {"true": "存在", "false": "未见"})], source)]
        rt_push(lines, c2_visible_line(dv_fact(campaign_own(patient, "motor_impairment"), true), "持续病程已经造成严重运动功能障碍，无法独立行走。", [], campaign_approved("user:2026-10-22-continuous-disease-and-effective-care")))
        rt_push(lines, c2_visible_line(dv_fact(campaign_own(patient, "respiratory_failure"), true), "现场出现呼吸衰竭症状，需要立即有效救治。", [], campaign_approved("user:2026-10-22-continuous-disease-and-effective-care")))
        rt_push(result, dv_with_many(campaign_surface_action(id, "inspect", pre, pre, "", grants, "检查同伴的伤情", "在同一现场查看同伴的意识、生命和搬运状态，记录实际见到的伤情。", source), {"repeatable": true, "presentation": {"actor": actor, "voice": "visible-inspection", "lines": lines}}))
        patient_index = patient_index + 1
    return result

fn c2_patient_contact(actor, patient):
    let rooms = c2_rooms()
    var contacts = []
    var i = 0
    while i < rt_count(rooms):
        rt_push(contacts, dv_all([campaign_at(actor, rooms[i]), campaign_at(patient, rooms[i])]))
        i = i + 1
    return dv_not(dv_all(c2_negated_conditions(contacts)))

法则 c2_take_anti_erosion_law：
    当 c2_can_act("mora")。
    并且 "mora" 位于 白塔安全端。
    并且 "case.logistics" 的 "anti_erosion_mixed" 等于 true。
    并且 campaign_own("mora", "anti_erosion_carried") 等于 false。
    则 campaign_own("mora", "anti_erosion_carried") 变为 true。

axiom c2_administer_anti_erosion_law(patient):
    let illness = campaign_any(dv_fact(campaign_own(patient, "active_erosion_disease"), true), campaign_any(dv_fact(campaign_own(patient, "in_coma"), true), campaign_any(dv_fact(campaign_own(patient, "fever"), true), dv_fact(campaign_own(patient, "rescue_exposed"), true))))
    return dv_axiom("c2_administer_anti_erosion_law", 1, dv_all([c2_can_act("mora"), c2_alive(patient), c2_patient_contact("mora", patient), dv_fact(campaign_own("mora", "anti_erosion_carried"), true), illness, dv_fact(campaign_ref("case.logistics", "anti_erosion_mixed"), true), dv_fact(campaign_own(patient, "anti_erosion_treated"), false)]), [dv_assign(campaign_own(patient, "anti_erosion_treated"), true), dv_assign(campaign_own(patient, "severe_weakness"), false), dv_assign(campaign_own(patient, "motor_impairment"), false), dv_assign(campaign_own(patient, "respiratory_failure"), false)])

fn c2_anti_erosion_actions(actor):
    if actor != "mora":
        return []
    let patients = c2_care_patients()
    let source = campaign_approved("actual-care-from-authored-mixed-anti-erosion-medicine")
    var result = []
    let take = c2_take_anti_erosion_law()
    rt_push(result, dv_with(campaign_surface_action("mora.c2.take.anti_erosion", "help", take.premise, take.premise, "mora.c2.take.anti_erosion", [campaign_own("mora", "anti_erosion_carried")], "领取抗侵蚀剂", "在实际配药地点领取已经配成并贴妥标签的抗侵蚀剂，带在身上。", source), "repeatable", false))
    var i = 0
    while i < rt_count(patients):
        let patient = patients[i]
        let id = rt_cat("mora.c2.administer.anti_erosion.", patient)
        let law = c2_administer_anti_erosion_law(patient)
        let grants = [campaign_own(patient, "anti_erosion_treated"), campaign_own(patient, "severe_weakness"), campaign_own(patient, "motor_impairment"), campaign_own(patient, "respiratory_failure")]
        let action = campaign_surface_action(id, "help", law.premise, law.premise, id, grants, "为病人使用抗侵蚀剂", "在病人所在现场使用已经配成的抗侵蚀剂，记录实际给药。", source)
        rt_push(result, dv_with_many(action, {"repeatable": false, "personal_choice": {"group": id, "requires": law.premise, "prohibits": dv_fact(campaign_own(patient, "anti_erosion_treated"), true), "promotes": ["patient_priority", "safety"], "sacrifices": [], "basis": [source]}, "public_observers": campaign_people(), "public_grants": grants}))
        i = i + 1
    return result

fn c2_unconventional_actions(actor):
    if actor != "detective":
        return []
    var result = []
    let source = campaign_source("docs/design-standard.md", 0, "第四夜非常规手段：方案A/B/C/D")
    let id_a = "detective.c2.unconventional.drive_demon"
    let pre_a = dv_all([c2_night(4), c2_alive("detective"), campaign_at("detective", "living_hall"), dv_fact(campaign_ref("c2.corridor.north", "airlock_hazard"), true), dv_fact(campaign_ref("c2.demon", "intervention_requested"), false)])
    let eff_a = [dv_assign(campaign_ref("c2.demon", "intervention_requested"), true)]
    let grants_a = [campaign_ref("c2.demon", "intervention_requested")]
    let act_a = campaign_surface_action(id_a, "talk", pre_a, dv_all([pre_a, campaign_at("demon", "living_hall")]), id_a, grants_a, "请求守住北气闸", "向恶魔提出守住北气闸的请求；对方是否接受和执行，仍须由其本人决定。", source)
    rt_push(result, dv_with_many(act_a, {"effects": eff_a, "speech": dv_with(campaign_speech(dv_true(), source, "airlock-intervention-request"), "surface", "请你守住北气闸；你愿意接下这项请求吗？"), "listeners": ["demon"], "request": {"target": "demon", "topic": "airlock-intervention"}, "opportunity_requirement": {"location": "living_hall", "participants": ["demon"], "mode": "all-present"}, "repeatable": false, "public_observers": campaign_people(), "public_grants": grants_a, "personal_choice": {"group": "unconventional-night4", "requires": pre_a, "prohibits": dv_fact(campaign_ref("c2.demon", "intervention_requested"), true), "promotes": ["safety", "solidarity"], "sacrifices": [], "basis": [source]}}))
    let id_b = "detective.c2.unconventional.iron_wedge"
    let pre_b = dv_all([c2_night(4), c2_alive("detective"), campaign_at("detective", "living_hall"), dv_fact(campaign_ref("c2.corridor.north", "airlock_hazard"), true), dv_fact(campaign_ref("c2.corridor.north", "airlock_held"), false)])
    let eff_b = [dv_assign(campaign_ref("c2.corridor.north", "airlock_held"), true)]
    let grants_b = [campaign_ref("c2.corridor.north", "airlock_held")]
    let act_b = campaign_surface_action(id_b, "experiment", pre_b, pre_b, id_b, grants_b, "用铁楔封闭气闸", "方案B【物理铁楔】：借口剪切应力超标焊死锁芯并打入铁楔封门，阻止任何人冲入毒雾。", source)
    rt_push(result, dv_with_many(act_b, {"effects": eff_b, "repeatable": false, "public_observers": campaign_people(), "public_grants": grants_b, "personal_choice": {"group": "unconventional-night4", "requires": pre_b, "prohibits": dv_fact(campaign_ref("c2.corridor.north", "airlock_held"), true), "promotes": ["safety"], "sacrifices": ["movement_freedom"], "basis": [source]}}))
    let id_c = "detective.c2.unconventional.false_alarm"
    let pre_c = dv_all([c2_night(4), c2_alive("detective"), campaign_at("detective", "logistics"), dv_fact(campaign_ref("c2.weather", "severe_air"), true), dv_fact(campaign_ref("c2.corridor.north", "airlock_hazard"), true), dv_fact(campaign_ref("c2.kitchen", "fake_alarm"), false)])
    let eff_c = [dv_assign(campaign_ref("c2.kitchen", "fake_alarm"), true)]
    let grants_c = [campaign_ref("c2.kitchen", "fake_alarm")]
    let act_c = campaign_surface_action(id_c, "experiment", pre_c, pre_c, id_c, grants_c, "在后厨制造爆管警报", "在后厨制造假爆管警报。其他人是否听见并采取行动，须分别记录。", source)
    rt_push(result, dv_with_many(act_c, {"effects": eff_c, "repeatable": false, "public_observers": campaign_people(), "public_grants": grants_c, "personal_choice": {"group": "unconventional-night4", "requires": pre_c, "prohibits": dv_fact(campaign_ref("c2.kitchen", "fake_alarm"), true), "promotes": ["safety"], "sacrifices": [], "basis": [source]}}))
    return result

