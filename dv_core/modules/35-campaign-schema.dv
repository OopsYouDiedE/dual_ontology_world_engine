// Campaign contracts shared by independently compiled chapters.
// These constructors declare identities and handoff fields; they grant no observations.
#include 30-session.dv

fn campaign_source(path, line, id):
    return {"path": path, "line": line, "id": id}

fn cognitive_erosion(exposure_ref, thresholds, coupling_factor, basis):
    dv_require(0 < rt_count(basis), "Erosion needs declared provenance")
    return {"physical_ref": exposure_ref, "thresholds": thresholds, "coupling_factor": coupling_factor, "basis": basis}

fn campaign_evidence_ref(atom):
    return dv_ref("cognition", "state", atom)

fn campaign_at(actor, room):
    return dv_fact(dv_ref(actor, "state", "location"), room)

fn campaign_local_object(id):
    return dv_object(id, "perceived", {"state": [], "identity": []})

fn campaign_state_object(id, fields):
    let descriptor = campaign_object_descriptor(id)
    var state = fields
    if descriptor.map_kind == "object" and not dv_has_key(state, "name"):
        state = dv_with(state, "name", dv_field(descriptor.map_title))
    return dv_with_many(dv_object(id, "physical", {"state": state, "identity": []}), descriptor)

// Visibility is an authored field whitelist, separate from map metadata.
// Installing local identities still leaves every value unknown. The common
// perception path reads these fields only at actual co-location boundaries.
fn campaign_install_visible_objects(scene):
    var visible = []
    var i = 0
    while i < rt_count(scene.physical.objects):
        let object = scene.physical.objects[i][1]
        if 0 < rt_count(dv_find(object, "visible_fields", [])):
            rt_push(visible, object.id)
        i = i + 1
    var actors = []
    var bindings = scene.bindings
    i = 0
    while i < rt_count(scene.actors):
        let actor = scene.actors[i]
        var mind = actor.mind
        var j = 0
        while j < rt_count(visible):
            let id = visible[j]
            if dv_local(bindings, id, actor.id) == "":
                if not dv_has_key(mind.objects, id):
                    mind = dv_add_object(mind, campaign_local_object(id))
                bindings = dv_append(bindings, dv_binding(id, id, actor.id))
            j = j + 1
        rt_push(actors, dv_with_many(actor, {"mind": mind, "policy": dv_with(actor.policy, "notice_visible_objects", true)}))
        i = i + 1
    return dv_with_many(scene, {"actors": actors, "bindings": bindings})

// Authored presentation metadata never grants a field to a subject's mind.
fn campaign_object_descriptor(id):
    let key = ["campaign-object-descriptor-v2", id]
    let cached = rt_memo_get([], key)
    if cached[0]:
        return cached[1]
    return rt_memo_put([], key, campaign_object_descriptor_build(id))

fn campaign_object_descriptor_build(id):
    let names = {"coat": "风衣", "lens": "黄铜放大镜", "graphite_pencil": "石墨笔", "evidence_bags": "证物袋", "opening.cabinet": "领取柜", "opening.silver": "银元", "opening.testpiece": "金属试件", "opening.audition": "试听机", "opening.tea": "茶具", "c2.granary": "粮仓", "c2.counter": "配给台", "c2.ledger": "公物台账", "c2.bowl": "粥碗", "c2.kitchen": "炉灶", "c2.meter": "源质计", "c2.seal": "印章"}
    if dv_has_key(names, id):
        return {"map_kind": "object", "map_title": dv_get(names, id), "visible_fields": ["name", "location"]}
    let sites = {"site:bed:R05": "床", "site:bed:R06": "床", "site:bed:R07": "床", "site:bed:R08": "床", "site:shelf": "书架", "site:slate": "长桌与石板", "site:transmitter": "传声铜口", "site:door-floor": "门边地面", "site:score": "书桌与乐谱", "site:pantry-counter": "备餐柜与水槽"}
    if dv_has_key(sites, id):
        return {"map_kind": "object", "map_title": dv_get(sites, id), "visible_fields": ["name", "location"]}
    if dv_has(campaign_people(), id) or id == "demon":
        return {"map_kind": "person", "map_title": campaign_person_name(id)}
    let people = ["detective", "huo", "shen", "su"]
    var i = 0
    while i < rt_count(people):
        if id == rt_cat("opening.slot.", people[i]):
            return {"map_kind": "object", "map_title": rt_cat(campaign_person_name(people[i]), "的标签柜")}
        if id == rt_cat("opening.cup.", people[i]):
            return {"map_kind": "object", "map_title": "茶杯"}
        i = i + 1
    let groups = ["living", "contract", "astral", "logistics"]
    i = 0
    while i < rt_count(groups):
        if id == rt_cat("c2.litter.", groups[i]):
            return {"map_kind": "object", "map_title": "废纸篓"}
        i = i + 1
    return {"map_kind": "record", "map_title": ""}

fn campaign_location_title(location):
    let key = ["campaign-location-title-v2", location]
    let cached = rt_memo_get([], key)
    if cached[0]:
        return cached[1]
    return rt_memo_put([], key, campaign_location_title_build(location))

fn campaign_location_title_build(location):
    let titles = {"R05": "乙区 · 卧室 R-05", "R06": "乙区 · 卧室 R-06", "R07": "乙区 · 卧室 R-07", "R08": "乙区 · 卧室 R-08", "hall": "乙区 · 活动厅", "foyer": "乙区 · 门厅", "corridor": "乙区 · 宿舍走廊", "pantry": "乙区 · 备餐间", "living_hall": "生活翼 · 公共起居厅", "washroom": "生活翼 · 盥洗室", "central_hall": "主楼 · 中央厅", "main_dining": "主楼一楼 · 大食堂", "main_granary": "主楼一楼 · 主粮仓与外侧配给区", "lecture": "主楼 · 讲堂", "logistics": "后勤院 · 食堂", "clinic": "白塔院 · 诊疗所", "greenhouse": "后勤院 · 温室", "document_workshop": "文契院 · 文献工房", "resonance_hall": "星仪院 · 共鸣厅", "resonance": "星仪院 · 共鸣厅", "quiet_room": "星仪院 · 沉静室", "white_tower_safe": "白塔院 · 安全端", "outdoor_meter": "室外 · 仪器阵", "outdoor_high": "室外 · 高地通路", "outdoor_alley": "室外 · 夹道", "oath_court": "室外 · 誓约庭", "threshold.contract": "生活翼 · 甲区门外", "threshold.astral": "生活翼 · 丙区门外", "threshold.logistics": "生活翼 · 丁区门外", "dorm.contract": "甲区 · 活动厅", "dorm.astral": "丙区 · 活动厅", "dorm.logistics": "丁区 · 活动厅", "dorm.yi": "乙区 · 活动厅"}
    return dv_find(titles, location, "现场")

fn campaign_location_region(location):
    let key = ["campaign-location-region-v2", location]
    let cached = rt_memo_get([], key)
    if cached[0]:
        return cached[1]
    return rt_memo_put([], key, campaign_location_region_build(location))

fn campaign_location_region_build(location):
    let titles = campaign_location_title(location)
    let regions = ["甲区", "乙区", "丙区", "丁区", "生活翼", "主楼", "后勤院", "白塔院", "室外"]
    var i = 0
    while i < rt_count(regions):
        if rt_length(titles) >= rt_length(regions[i]) and rt_slice(titles, 0, rt_length(regions[i])) == regions[i]:
            return regions[i]
        i = i + 1
    return "其他"

fn campaign_action(id, kind, known, physical, law, grants, source):
    return dv_with(dv_with(dv_with({"id": id, "kind": kind, "precondition": known, "authority_precondition": physical}, "law", law), "grants", grants), "source_refs", dv_single(source))

// Intent is selected before execution; surface and speech remain Complete-only prose.
fn campaign_intent_action(id, kind, known, physical, law, grants, label, source):
    return dv_with(campaign_action(id, kind, known, physical, law, grants, source), "label", label)

fn campaign_method(name, law):
    return dv_instance(name, law)

fn campaign_any(left, right):
    return dv_not(dv_all(dv_pair(dv_not(left), dv_not(right))))

fn campaign_authorized_speech(action):
    return dv_with(action, "authority_truth_gate", {"required": true, "contract_id": "contract-8", "basis": dv_single(campaign_source("docs/design-standard.md", 462, "may-not-deceive-students"))})

fn campaign_case_ref(group, field):
    return dv_ref(rt_cat("case.", group), "state", field)

fn campaign_case_claim(group, field):
    return dv_fact(campaign_case_ref(group, field), true)

fn campaign_first_night_ref(field):
    return dv_ref("night.first", "state", field)

fn campaign_positive_clock_bounds(condition):
    var result = []
    let op = dv_find(condition, "op", "")
    if op == "at_least":
        if dv_same(condition.ref, campaign_clock()):
            rt_push(result, condition.value)
    if op == "all":
        let items = dv_find(condition, "items", [])
        var i = 0
        while i < rt_count(items):
            let nested = campaign_positive_clock_bounds(items[i])
            var j = 0
            while j < rt_count(nested):
                rt_push(result, nested[j])
                j = j + 1
            i = i + 1
    return result

fn campaign_clock_boundaries(condition):
    let key = ["campaign_clock_boundaries"]
    let cached = rt_memo_get(condition, key)
    if cached[0]:
        return cached[1]
    return rt_memo_put(condition, key, campaign_clock_boundaries_uncached(condition))

fn campaign_clock_boundaries_uncached(condition):
    if dv_find(condition, "op", "") == "not":
        return campaign_clock_boundaries(condition.item)
    var result = campaign_positive_clock_bounds(condition)
    if dv_find(condition, "op", "") == "all":
        var i = 0
        while i < rt_count(condition.items):
            let nested = campaign_clock_boundaries(condition.items[i])
            var j = 0
            while j < rt_count(nested):
                if not dv_has(result, nested[j]):
                    rt_push(result, nested[j])
                j = j + 1
            i = i + 1
    return result

fn campaign_without_clock(condition):
    let key = ["campaign_without_clock"]
    let cached = rt_memo_get(condition, key)
    if cached[0]:
        return cached[1]
    return rt_memo_put(condition, key, campaign_without_clock_uncached(condition))

fn campaign_without_clock_uncached(condition):
    let op = dv_find(condition, "op", "")
    if dv_record_like(condition) and dv_has_key(condition, "ref") and dv_find(condition.ref, "object", "") == "c2.weather":
        return dv_true()
    if op == "at_least" and dv_same(condition.ref, campaign_clock()):
        return dv_true()
    if op == "not":
        let inner = dv_find(condition, "item", false)
        if inner != false and dv_record_like(inner) and dv_has_key(inner, "ref") and dv_find(inner.ref, "object", "") == "c2.weather":
            return dv_true()
        if inner != false and dv_find(inner, "op", "") == "at_least" and dv_same(inner.ref, campaign_clock()):
            return dv_true()
    if op == "all":
        var items = []
        var i = 0
        while i < rt_count(condition.items):
            rt_push(items, campaign_without_clock(condition.items[i]))
            i = i + 1
        return dv_all(items)
    return condition

fn campaign_future_goal_pending(actor, goal):
    let kind = dv_find(goal, "kind", "")
    if kind == "achieve":
        return dv_truth(actor.mind, goal.proposition) != "true"
    if kind == "communicate":
        let method = dvp_find_action(actor.actions, dv_find(goal, "method_id", ""))
        if method != false and dv_has_key(method, "owned_decision"):
            return dvp_owned_decision_ready(actor, method, actor.mind)
        return not dv_has(dv_find(actor, "completed_actions", []), dv_find(goal, "method_id", ""))
    if kind == "know" or kind == "evidence":
        if dv_has_key(goal, "minimum_time") and actor.mind.time < goal.minimum_time:
            return true
        return not dv_uncontested(dv_read(actor.mind, goal.ref))
    return false

fn campaign_index_goal_window(goal):
    let condition = dv_find(goal, "available_when", dv_true())
    let key = ["c1n_goal_window-v2"]
    let cached = rt_memo_get(condition, key)
    var window = []
    if cached[0]:
        window = cached[1]
    else:
        window = rt_memo_put(condition, key, {"future_clock_condition": condition, "future_clock_bounds": campaign_positive_clock_bounds(condition), "future_clock_boundaries": campaign_clock_boundaries(condition), "future_nonclock": campaign_without_clock(condition)})
    return dv_with_many(goal, window)

fn campaign_approved(id):
    return campaign_source("docs/design-standard.md", 0, id)

fn campaign_ref(object, field):
    return dv_ref(object, "state", field)

fn campaign_body(actor):
    return rt_cat("c2.person.", actor)

fn campaign_own(actor, field):
    return campaign_ref(campaign_body(actor), field)

fn campaign_clock():
    return dv_ref("campaign.clock", "state", "minute")

fn campaign_access(gate):
    return dv_ref("campaign.access", "state", gate)

fn campaign_position_ref(actor):
    return dv_ref(actor, "state", "location")

fn campaign_window(day, start, end):
    let origin = (day - 1) * 1440
    return dv_all(dv_pair(dv_at_least(campaign_clock(), origin + start), dv_not(dv_at_least(campaign_clock(), origin + end))))

fn campaign_people():
    return ["detective", "huo", "shen", "su", "lucian", "gu", "quer", "ward", "selma", "ruan", "elena", "moran", "veronica", "bertrand", "margaret", "mora"]

// Stable bit identities follow the registered student catalogue. Objective
// values and knowledge remain in their original worlds; registration grants
// neither observations nor a new environment state. Numeric room transport,
// daily ledgers and protection actions require explicit scene declarations.
fn campaign_simulation_config(scene):
    let people = campaign_people()
    var identities = []
    var i = 0
    while i < rt_count(people):
        rt_push(identities, {"actor": people[i], "index": i})
        i = i + 1
    rt_push(identities, {"actor": "demon", "index": 16})
    var facts = []
    let weather = ["ash_falling", "wind", "daylight", "severe_air", "earthquake_recent"]
    if dv_has_key(scene.physical.objects, "c2.weather"):
        i = 0
        while i < rt_count(weather):
            rt_push(facts, {"id": rt_cat("weather.", weather[i]), "ref": campaign_ref("c2.weather", weather[i])})
            i = i + 1
    if dv_has_key(scene.physical.objects, "c2.meter"):
        rt_push(facts, {"id": "meter.safe", "ref": campaign_ref("c2.meter", "safe")})
    i = 0
    while i < rt_count(people):
        if dv_has_key(scene.physical.objects, campaign_body(people[i])):
            rt_push(facts, {"id": rt_cat(people[i], ".erosion_exposure"), "ref": campaign_own(people[i], "erosion_exposure")})
            rt_push(facts, {"id": rt_cat(people[i], ".alive"), "ref": campaign_own(people[i], "alive")})
        i = i + 1
    let declared = dv_find(scene, "simulation_declarations", [])
    let extra_facts = dv_find(declared, "facts", [])
    i = 0
    while i < rt_count(extra_facts):
        rt_push(facts, extra_facts[i])
        i = i + 1
    return dv_with_many(declared, {"identities": identities, "facts": facts})

fn campaign_person_source(actor):
    let rows = [["detective", "01_侦探.story", 11], ["huo", "02_霍铎.story", 48], ["shen", "03_沈鼎.story", 45], ["su", "04_苏泠.story", 43], ["lucian", "05_卢西安.story", 25], ["gu", "06_顾平章.story", 25], ["quer", "07_雀儿.story", 27], ["ward", "08_沃德.story", 24], ["selma", "09_赛尔玛.story", 25], ["ruan", "10_阮清越.story", 24], ["elena", "11_伊莲娜.story", 24], ["moran", "12_莫兰.story", 23], ["veronica", "13_维罗妮卡.story", 25], ["bertrand", "14_贝尔特朗.story", 26], ["margaret", "15_玛格丽特.story", 27], ["mora", "16_茉拉.story", 26]]
    var i = 0
    while i < rt_count(rows):
        if rows[i][0] == actor:
            return campaign_source(rt_cat("godot_csharp/scenes/Awakening/Script/story/生态/人物/", rows[i][1]), rows[i][2], rt_cat(actor, ".personal-values"))
        i = i + 1
    return campaign_approved("unknown-person-profile-needs-source")

fn campaign_profile(actor):
    var group = "living"
    var domain = "investigation"
    var roles = []
    var values = ["evidence", "safety", "patient_priority", "records"]
    if dv_has(["quer", "ward", "gu", "lucian"], actor):
        group = "contract"
    if dv_has(["selma", "ruan", "elena", "moran"], actor):
        group = "astral"
    if dv_has(["veronica", "bertrand", "margaret", "mora"], actor):
        group = "logistics"
    if dv_has(["mora", "shen", "ruan"], actor):
        domain = "resources"
    if dv_has(["selma", "veronica", "gu", "lucian"], actor):
        domain = "research"
    if dv_has(["bertrand", "margaret", "huo"], actor):
        domain = "safety"
    if actor == "huo":
        roles = ["weight"]
        values = ["measured_work", "records", "central_cooking", "evidence", "safety"]
    if actor == "quer":
        roles = ["lock"]
        values = ["not_targeted", "evidence", "movement_freedom", "night_exception", "measured_work"]
    if actor == "su":
        roles = ["relay"]
        values = ["measured_work", "signal", "evidence"]
    if actor == "bertrand":
        roles = ["weight"]
        values = ["patient_priority", "records", "safety"]
    if actor == "margaret":
        roles = ["weight"]
        values = ["evidence", "central_cooking", "records", "safety"]
    if actor == "mora":
        values = ["patient_priority", "cautious_travel", "evidence", "night_exception"]
    if actor == "shen":
        values = ["central_cooking", "patient_priority", "per_person", "not_targeted", "cautious_travel"]
    if actor == "ruan":
        values = ["records", "controlled_audit", "per_person", "committee", "witnesses", "evidence"]
    if actor == "ward":
        values = ["ward_authority", "committee", "records", "restriction", "no_exception", "witnesses", "evidence"]
    if actor == "gu":
        values = ["cautious_travel", "tradition", "records", "evidence", "contract"]
    if actor == "lucian":
        values = ["resonance_exclusivity", "not_targeted", "evidence", "movement_freedom", "patient_priority", "contract", "records"]
    if actor == "selma":
        values = ["patient_priority", "evidence", "research"]
    if actor == "veronica":
        values = ["avoid_ethics_review", "evidence", "records", "committee", "research"]
    if actor == "elena":
        values = ["tradition", "evidence", "contract", "safety", "cautious_travel"]
    if actor == "moran":
        values = ["avoid_isolation", "measured_work", "research"]
    return {"id": actor, "group": group, "domain": domain, "station_roles": roles, "value_order": values, "basis": [campaign_person_source(actor), campaign_approved("chapter-two-role-groups")]}

fn campaign_add_new(world, object):
    if dv_has_key(world.objects, object.id):
        return world
    return dv_add_object(world, object)

fn campaign_surface_action(id, kind, known, physical, law, grants, label, text, source):
    return dv_with(campaign_intent_action(id, kind, known, physical, law, grants, label, source), "surface", text)

fn campaign_goal(proposition, when, basis):
    return campaign_index_goal_window({"kind": "achieve", "scope": "personal", "proposition": proposition, "available_when": when, "basis": basis})

fn campaign_observation_goal(ref, when, basis, time):
    return campaign_index_goal_window({"kind": "evidence", "scope": "personal", "ref": ref, "source": "perception", "available_when": when, "basis": basis, "minimum_time": time})

叙述 campaign_contract_text：
    1. 恶魔常驻岛内，不得离岛。
    2. 经学员本人授权，恶魔封存其在校记忆（在校经历、师生与同学关系、事故全貌）；姓名、生平与入学前技艺不在封存之列。
    3. 恶魔维持学园基础生存设施的运转（水、炉火、照明的设施本身；不负责分配物资，不创造物资）。
    4. 恶魔所受约束，唯有学员出于自主的行动方可解除；恶魔不得代为或强迫学员完成解除。
    5. 恶魔须公开它自己所立之规；规则许诺的路径必须真实可行。
    6. 恶魔须传授学员理解处境与继续学习所需之知；学员自负其选择的后果。
    7. 恶魔不得伤害学员身心，不得拘禁学员，不得令学员因无知而死。
    8. 恶魔对学员所作事实陈述的字面语义在客观现实中不得为假；学员问及本人封存之物或契约条文，须按所知如实作答，不知则明言不知。
    9. 恶魔不得主动向学员提及封存之物的所在与取回之法，不得促其取回；学员自行问及者，依前条作答。
    10. 封存的记忆可凭对应之物恢复；恢复者自负其果。
    11. 本人尚未深属此岛，且经当时在岛存活之其余全部在册学员一致同意，可择定“尽忘归乡”；上述条件持续成立时，于下一次入睡遗忘此地一切、在家乡醒来。
    12. （终局）担保耗尽时，恶魔须将醒着且未深属此岛的学员遣返家乡，并抹去其与此地有关的一切记忆。

fn campaign_person_name(actor):
    let names = {"detective": "侦探", "huo": "霍铎", "shen": "沈鼎", "su": "苏泠", "lucian": "卢西安", "gu": "顾平章", "quer": "雀儿", "ward": "沃德", "selma": "赛尔玛", "ruan": "阮清月", "elena": "伊莲娜", "moran": "莫兰", "veronica": "维罗妮卡", "bertrand": "贝尔特朗", "margaret": "玛格丽特", "mora": "茉拉", "demon": "代管者"}
    return dv_get(names, actor)

// First-night records remain shared persisted identities across the chapter handoff.
fn campaign_handoff_fields():
    return {"case": "case.", "first_night": "night.first", "contract": "opening.contracts", "person_identity": "opening.person.", "clock": campaign_clock(), "access": "campaign.access"}

fn campaign_speech(literal, surface, scope):
    return {"literal_ast": literal, "referents": [], "scope": scope, "time_anchor": "当前发言", "surface_ref": surface, "presuppositions": [], "implicature_candidates": []}

fn campaign_public_methods(actions):
    var result = []
    var i = 0
    while i < rt_count(actions):
        let action = actions[i]
        var method = dv_with_many(action, {"purpose_refs": dv_find(action, "purpose_refs", action.grants), "purpose_basis": action.source_refs})
        if (action.kind == "move" or action.kind == "replay") and not dv_find(action, "once", false):
            method = dv_with(method, "repeatable", true)
        rt_push(result, method)
        i = i + 1
    return result

// Sims 4-style character autonomy profiles, smart station advertisements,
// implicit bodily habits surviving amnesia, player-visible scope filters, and
// simple brush-off responses (简单的应答直接搪塞过去) for unseen off-screen zones.

fn sims_autonomy_source(id):
    return campaign_source("dv_core/modules/35-campaign-schema.dv", 418, rt_cat("sims-autonomy-player-visible.", id))

fn sims_player_visible_rooms(zone):
    if zone == "zone_yi":
        return ["R05", "R06", "R07", "R08", "hall", "pantry", "foyer", "corridor", "living_hall", "central_hall", "main_granary", "logistics", "clinic", "greenhouse", "document_workshop", "resonance_hall", "quiet_room", "white_tower_safe", "oath_court"]
    if zone == "zone_jia" or zone == "contract":
        return ["dorm.contract", "threshold.contract", "living_hall", "central_hall", "main_granary", "logistics", "clinic", "greenhouse", "document_workshop", "resonance_hall", "quiet_room", "white_tower_safe", "oath_court"]
    if zone == "zone_bing" or zone == "astral":
        return ["dorm.astral", "threshold.astral", "living_hall", "central_hall", "main_granary", "logistics", "clinic", "greenhouse", "document_workshop", "resonance_hall", "quiet_room", "white_tower_safe", "oath_court"]
    if zone == "zone_ding" or zone == "logistics":
        return ["dorm.logistics", "threshold.logistics", "living_hall", "central_hall", "main_granary", "logistics", "clinic", "greenhouse", "document_workshop", "resonance_hall", "quiet_room", "white_tower_safe", "oath_court"]
    return []

fn sims_unseen_dorm_rooms(zone):
    if zone == "zone_yi":
        return ["dorm.contract", "dorm.astral", "dorm.logistics"]
    return []

fn sims_implicit_habits(actor):
    if actor == "detective":
        return [
            {"id": "habit.cuff_rub", "trigger": "R05", "kind": "inspect", "bonus": 0.15, "surface": "右手袖口磨得发亮——写字时总拿那儿蹭桌沿。"},
            {"id": "habit.magnifier_check", "trigger": "hall", "kind": "inspect", "bonus": 0.15, "surface": "习惯性摸向风衣口袋里的黄铜放大镜。"}
        ]
    if actor == "huo":
        return [
            {"id": "habit.mortise_touch", "trigger": "R06", "kind": "inspect", "bonus": 0.15, "surface": "手先去摸床沿榫接处与顺时针三圈半的机油布。"},
            {"id": "habit.slate_shorthand", "trigger": "hall", "kind": "talk", "bonus": 0.15, "surface": "指尖沿刻痕辨认⊥、✕、◎的钳工速记习惯。"}
        ]
    if actor == "shen":
        return [
            {"id": "habit.unsweetened_tea_for_su", "trigger": "hall", "kind": "inspect", "bonus": 0.2, "surface": "推到苏泠面前的那杯茶顺手不放糖，老霍那杯加两勺。"},
            {"id": "habit.feed_sourdough_starter", "trigger": "pantry", "kind": "inspect", "bonus": 0.2, "surface": "揭开陶罐喂老酵头的手法熟极而流，双手比脑子先记得。"}
        ]
    if actor == "su":
        return [
            {"id": "habit.tap_four_four_meter", "trigger": "R08", "kind": "inspect", "bonus": 0.15, "surface": "手指无意识在桌沿敲击四四拍，捕捉墙内不断线的低音。"},
            {"id": "habit.hollow_frame_ear", "trigger": "foyer", "kind": "inspect", "bonus": 0.2, "surface": "侧耳贴近门框背面，辨别墙内传声铜管松动接头的漏音。"}
        ]
    if actor == "quer":
        return [
            {"id": "habit.steel_wire_pick", "trigger": "living_hall", "kind": "experiment", "bonus": 0.2, "surface": "袖口常备精钢丝，见着外闩便手痒想探一探锁簧。"},
            {"id": "habit.familiar_greeting", "trigger": "living_hall", "kind": "talk", "bonus": 0.15, "surface": "一见沈鼎与霍铎便脱口而出‘老霍、沈叔’。"}
        ]
    if actor == "ward":
        return [
            {"id": "habit.public_notice_audit", "trigger": "living_hall", "kind": "help", "bonus": 0.15, "surface": "按章清点红纸与蜡布筒，坚持公开程序与限制令。"}
        ]
    if actor == "gu":
        return [
            {"id": "habit.copy_book_spines", "trigger": "living_hall", "kind": "talk", "bonus": 0.15, "surface": "在北台书架前把认得的书脊一行行抄录核对，奉行孤证不立。"}
        ]
    if actor == "lucian":
        return [
            {"id": "habit.doorway_etiquette", "trigger": "living_hall", "kind": "talk", "bonus": 0.15, "surface": "斜倚墙边讲究隔门交谈的礼数，不屑贴门呼喊。"}
        ]
    return []

fn sims_station_advertisements(room):
    if room == "hall":
        return [
            {"site": "site:slate", "need": "cognition", "advertise": 0.25, "kinds": ["inspect", "talk"]},
            {"site": "site:transmitter", "need": "cognition", "advertise": 0.3, "kinds": ["inspect", "answer", "talk"]},
            {"site": "opening.cabinet", "need": "obsession", "advertise": 0.25, "kinds": ["inspect", "talk"]}
        ]
    if room == "pantry":
        return [
            {"site": "site:pantry-counter", "need": "hunger", "advertise": 0.25, "kinds": ["inspect", "talk"]}
        ]
    if room == "foyer":
        return [
            {"site": "site:door-floor", "need": "cognition", "advertise": 0.25, "kinds": ["inspect", "help", "talk"]}
        ]
    if room == "living_hall":
        return [
            {"site": "living_hearth", "need": "hunger", "advertise": 0.25, "kinds": ["help", "inspect"]},
            {"site": "living_table", "need": "social", "advertise": 0.2, "kinds": ["talk", "inspect"]}
        ]
    return []

fn sims_actor_profile(actor):
    let base = campaign_profile(actor)
    var weights = {"hunger": 1.0, "safety": 1.0, "social": 1.0, "cognition": 1.1, "obsession": 1.0}
    if actor == "detective":
        weights = {"hunger": 0.9, "safety": 1.1, "social": 1.0, "cognition": 1.4, "obsession": 1.2}
    if actor == "huo":
        weights = {"hunger": 1.0, "safety": 1.2, "social": 0.9, "cognition": 1.2, "obsession": 1.3}
    if actor == "shen":
        weights = {"hunger": 1.3, "safety": 1.2, "social": 1.2, "cognition": 0.9, "obsession": 1.0}
    if actor == "su":
        weights = {"hunger": 0.9, "safety": 1.0, "social": 0.9, "cognition": 1.3, "obsession": 1.3}
    if actor == "quer":
        weights = {"hunger": 1.1, "safety": 0.9, "social": 1.2, "cognition": 1.1, "obsession": 1.2}
    if actor == "ward":
        weights = {"hunger": 1.0, "safety": 1.2, "social": 1.1, "cognition": 1.2, "obsession": 1.1}
    if actor == "gu":
        weights = {"hunger": 1.0, "safety": 1.1, "social": 0.9, "cognition": 1.3, "obsession": 1.1}
    if actor == "lucian":
        weights = {"hunger": 0.9, "safety": 1.1, "social": 1.1, "cognition": 1.1, "obsession": 1.2}
    return {
        "actor": actor,
        "group": base.group,
        "domain": base.domain,
        "commodity_needs": {"hunger": 75, "safety": 80, "social": 70, "cognition": 60, "obsession": 65},
        "autonomy_weights": weights,
        "implicit_habits": sims_implicit_habits(actor),
        "basis": [sims_autonomy_source(actor)]
    }

// Simple brush-off responses (简单的应答直接搪塞过去) for unseen rooms and off-screen
// dormitory events during Chapter 1 when the player starts in Zone Yi.
fn sims_brush_off_rows():
    return [
        {
            "actor": "ward",
            "id": "brush-off.closed-doors",
            "start": 960,
            "end": 1105,
            "when": dv_fact(campaign_first_night_ref("done.night.ask-closed-doors"), true),
            "received": {"speaker": "detective", "action_id": "night.ask-closed-doors"},
            "label": "简短搪塞丙丁两区的近况",
            "text": "方才代管者已在铜口交代过了：丙区西夹道尚有源质余气，门内人并不知情，依《契约》第七条暂不开闸；丁区有人高烧清创，从内侧拧死了死锁与传声止音阀。等明日散尽余气再说吧。"
        },
        {
            "actor": "detective",
            "id": "ask-unseen-contract",
            "start": 780,
            "end": 1440,
            "when": campaign_at("quer", "living_hall"),
            "manual_only": true,
            "label": "询问甲区寝室内先前的经过",
            "text": "你们在甲区寝室里头，先前都查了些什么？"
        },
        {
            "actor": "quer",
            "id": "brush-off.quer-contract",
            "start": 780,
            "end": 1440,
            "when": dv_fact(campaign_first_night_ref("done.night.ask-unseen-contract"), true),
            "received": {"speaker": "detective", "action_id": "night.ask-unseen-contract"},
            "label": "随口搪塞甲区寝室的琐事",
            "text": "嗨，关在屋里闷都闷死了，无非是翻翻旧物、拌几句嘴，我就顺手拿钢丝把门挑开出来透透气呗！里头那些鸡毛蒜皮的事，有什么好细说的。"
        },
        {
            "actor": "lucian",
            "id": "brush-off.lucian-contract",
            "start": 780,
            "end": 1440,
            "when": dv_fact(campaign_first_night_ref("done.night.ask-unseen-contract"), true),
            "received": {"speaker": "detective", "action_id": "night.ask-unseen-contract"},
            "label": "冷淡敷衍甲区室内的问答",
            "text": "不过是按铜口定下的规矩报了个名字、递了句答复罢了。内室那些杂乱口角，不提也罢。"
        },
        {
            "actor": "detective",
            "id": "brush-off.astral-door",
            "start": 750,
            "end": 1440,
            "when": dv_true(),
            "manual_only": true,
            "kind": "inspect",
            "label": "走近紧闭的丙区隔离门",
            "text": "丙区气闸门紧闭。旁侧铜口只留下一句简短的例行告示：‘西夹道余气未散，门内人不知外侧险情；依第七条，明晨散尽前概不放行。’"
        },
        {
            "actor": "detective",
            "id": "brush-off.logistics-door",
            "start": 750,
            "end": 1440,
            "when": dv_true(),
            "manual_only": true,
            "kind": "inspect",
            "label": "走近反锁的丁区隔离门",
            "text": "丁区厚门从内侧拧死了防侵死锁，门边传声管的止音阀也已关死，里头没有人应声，只能等明日天亮。"
        }
    ]

// Chapter handoff evidence, populated only by the first chapter meal Complete.
fn campaign_finale_eaten_ref(actor):
    return campaign_first_night_ref(rt_cat("done.night.finale.eat.", actor))


// Shared committed meal evidence; no clock or location substitutes for eating.
fn campaign_finale_meal_complete():
    var conditions = []
    let people = campaign_people()
    var i = 0
    while i < rt_count(people):
        rt_push(conditions, dv_fact(campaign_finale_eaten_ref(people[i]), true))
        i = i + 1
    return dv_all(conditions)

// Neutral visual identifiers are shared by content labels and host projections.
fn campaign_unknown_person_label(actor, viewer):
    if actor == "":
        return "现场记录"
    if actor == viewer:
        return "本人"
    if actor == "demon":
        return "铜口里的声音"
    let people = campaign_people()
    var i = 0
    while i < rt_count(people):
        if people[i] == actor:
            return rt_cat("陌生学员·", rt_show(i + 1))
        i = i + 1
    return "陌生学员"

fn campaign_person_name_ref(actor):
    if dv_has(["detective", "huo", "shen", "su"], actor):
        return dv_ref(rt_cat("opening.personal.", actor), "state", "name")
    return dv_ref(actor, "identity", "name")

// The actual dumpling cooking Complete also places the cooked portions on the table.
fn campaign_finale_meal_ready_ref():
    return campaign_first_night_ref("done.night.finale.cook-dumplings")

fn campaign_finale_meal_remaining_ref():
    return campaign_first_night_ref("meal_servings")
