fn c1_talk_recalled_names(actor):
    return dv_with(c1_once(c1_observe_as(campaign_intent_action(rt_cat(actor, ".talk.recalled_names"), "talk", campaign_at(actor, "pantry"), dv_all(dv_pair(campaign_at(actor, "pantry"), campaign_at("shen", "pantry"))), "", dv_single(campaign_evidence_ref("recalled_names")), "询问关于姓名的记忆", campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/可习得命题.story", 92, "recall_shen.003")), "testimony", "shen", 0.85)), "surface", "沈鼎回想起：阿泠的茶不放糖，老霍的放两勺，那位喝清茶不放奶。‘阿泠’这称呼，他自己也不知怎么脱口而出。")

行动 c1_sole_test，给定 行动者：
    编号 rt_cat(行动者, ".compare_sole")。
    类别 "experiment"。
    本人须知 dv_all(dv_pair(campaign_at(行动者, 乙区门厅), dv_fact(dv_ref(行动者, "state", "identity"), 侦探)))。
    现场要求 行动者 位于 乙区门厅。
    遵循 ""。
    可获知 dv_single(campaign_evidence_ref("boots_fit"))。
    依据 [campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/可习得命题.story", 81, "exp_E3.002")]。
    仅一次 true。

fn c1_sound_source():
    return campaign_source("docs/design-standard.md", 551, "E8:实际分处活动厅、R-08和门框旁听取同一复述；所闻须由本人报告")

fn c1_sound_ref(field):
    return dv_ref("ritual", "state", field)

fn c1_sound_fact(field, value):
    return dv_fact(c1_sound_ref(field), value)

fn c1_sound_station(actor):
    if actor == "su":
        return "R08"
    if actor == "shen":
        return "foyer"
    return "hall"

fn c1_sound_result(actor):
    if actor == "su" or actor == "shen":
        return "tail-stresses-only"
    return "four-beats-clear"

fn c1_sound_words(actor):
    if actor == "su" or actor == "shen":
        return "……铜牌……四拍"
    return "请看／铜牌，慢数／四拍"

fn c1_sound_report_text(actor):
    if actor == "su":
        return "我站在 R-08，贴着门内侧听。听清的是‘……铜牌……四拍’，前面的‘请看’和‘慢数’辨不出来。不看着铜管，会把这声听成门外有人在喊。"
    if actor == "shen":
        return "我在门厅门框旁。先是一阵发闷的气声，接着是‘……铜牌……四拍’，像从大门外面传来的；夹在前面的字，我没听清。"
    return "我留在活动厅，面对铜口。听见的是‘请看／铜牌，慢数／四拍’，四拍都能分清；‘请看’和‘慢数’读得轻，‘铜牌’和‘四拍’重。"

fn c1_sound_pending():
    return dv_all([c1_sound_fact("sound_trial_requested", true), c1_sound_fact("sound_trial_done", false)])

fn c1_sound_invite(actor):
    let source = c1_sound_source()
    let clear = dv_all([c1_sound_fact("sound_trial_requested", false), c1_sound_fact("sound_trial_done", false)])
    let known = dv_all([campaign_at(actor, "hall"), c1_statement("pipe_layout"), clear])
    let physical = dv_all([campaign_at(actor, "hall"), campaign_at("detective", "hall"), campaign_at("huo", "hall"), campaign_at("shen", "hall"), campaign_at("su", "hall"), clear])
    let id = rt_cat(actor, ".sound.invite")
    let law = dv_axiom(id, 1, physical, [dv_assign(c1_sound_ref("sound_trial_requested"), true), dv_assign(c1_sound_ref("coordinator"), actor)])
    var action = c1_once(campaign_intent_action(id, "talk", known, physical, id, [c1_sound_ref("sound_trial_requested"), c1_sound_ref("coordinator")], "邀请众人分处听取同一句话", source))
    action = dv_with_many(action, {"speech": dv_with_many(c1_speech(dv_true(), source, "audible-voluntary-trial-invitation"), {"channel": "copper.living", "surface": "我想把这条传声管试清楚。愿意帮忙的话，请在 R-08 和门框旁各留一人，另两人留在厅里；到位后各敲两下。请代管者听见我们都到位后，试读‘请看／铜牌，慢数／四拍’这句新短语，前轻后重。", "request": {"target": "demon", "topic": "sound-trial-repeat"}}), "listeners": ["detective", "huo", "shen", "su", "demon"], "public_grants": [c1_sound_ref("sound_trial_requested"), c1_sound_ref("coordinator")], "purpose_refs": [campaign_evidence_ref("sound_trial"), campaign_evidence_ref("heads_lost")], "opportunity_requirement": {"location": "hall", "participants": ["detective", "huo", "shen", "su"], "mode": "all-present"}, "predict_law": id, "presentation": c1_op_presentation(actor, "visible-action", ["手指沿着铜管的接缝移过，停在分支处。"])})
    return {"action": action, "law": law}

fn c1_sound_ready(actor):
    let source = c1_sound_source()
    let id = rt_cat(actor, ".sound.take-position")
    let ready = rt_cat("ready.", actor)
    let known = dv_all([c1_sound_pending(), campaign_at(actor, c1_sound_station(actor)), c1_sound_fact(ready, false)])
    let physical = dv_all([c1_sound_pending(), campaign_at(actor, c1_sound_station(actor)), c1_sound_fact(ready, false)])
    let law = dv_axiom(id, 1, physical, [dv_assign(c1_sound_ref(ready), true)])
    var action = c1_once(campaign_intent_action(id, "talk", known, physical, id, [c1_sound_ref(ready), dv_ref(actor, "state", "location")], "留在听音处并发出到位信号", source))
    let words = rt_cat(rt_cat("我已经在", c1_place_label(c1_sound_station(actor))), "，会留在这里听完。铜管响起两下短促的敲击。")
    action = dv_with_many(action, {"speech": dv_with_many(c1_speech(campaign_at(actor, c1_sound_station(actor)), source, "own-position-and-voluntary-commitment"), {"channel": "copper.trial.signal", "surface": words}), "listeners": ["detective", "huo", "shen", "su", "demon"], "public_grants": [c1_sound_ref(ready)], "predict_law": id, "presentation": c1_op_presentation(actor, "visible-action", [])})
    return {"action": action, "law": law}

fn c1_sound_agreement():
    let source = c1_sound_source()
    let id = "demon.sound.agree-repeat"
    let physical = dv_all([campaign_at("demon", "living_hall"), c1_sound_pending(), c1_sound_fact("repeater_agreed", false)])
    let law = dv_axiom(id, 1, physical, [dv_assign(c1_sound_ref("repeater_agreed"), true)])
    var action = c1_once(campaign_intent_action(id, "talk", physical, physical, id, [c1_sound_ref("repeater_agreed")], "应实际请求答应复述", source))
    action = campaign_authorized_speech(dv_with_many(action, {"speech": dv_with_many(c1_speech(dv_true(), source, "own-audible-commitment"), {"channel": "copper.trial.signal", "surface": "可以。各位到位以后，我就读‘请看／铜牌，慢数／四拍’，前轻后重，各读两遍。结束时，以两声轻响为记。"}), "listeners": ["detective", "huo", "shen", "su"], "public_grants": [c1_sound_ref("repeater_agreed")], "response_topic": "sound-trial-repeat", "requires_actual_request": true, "request_transport": {"channel": "copper.living"}, "predict_law": id}))
    return {"action": action, "law": law}

fn c1_sound_execution_condition(actor):
    var terms = [c1_sound_pending(), c1_sound_fact("coordinator", actor), c1_sound_fact("repeater_agreed", true), campaign_at(actor, "hall")]
    let people = ["detective", "huo", "shen", "su"]
    var i = 0
    while i < rt_count(people):
        rt_push(terms, c1_sound_fact(rt_cat("ready.", people[i]), true))
        i = i + 1
    return dv_all(terms)

fn c1_sound_execution_law(actor):
    var terms = [c1_sound_execution_condition(actor), campaign_at("demon", "living_hall")]
    var effects = [dv_assign(c1_sound_ref("sound_trial_done"), true)]
    let people = ["detective", "huo", "shen", "su"]
    var i = 0
    while i < rt_count(people):
        let id = people[i]
        rt_push(terms, campaign_at(id, c1_sound_station(id)))
        rt_push(effects, dv_assign(c1_sound_ref(rt_cat("heard.", id)), c1_sound_result(id)))
        rt_push(effects, dv_assign(c1_sound_ref(rt_cat("heard_at.", id)), c1_sound_station(id)))
        rt_push(effects, dv_assign(c1_sound_ref(rt_cat("heard_words.", id)), c1_sound_words(id)))
        rt_push(effects, dv_assign(c1_sound_ref(rt_cat("heard_from.", id)), "demon:copper.living"))
        i = i + 1
    return dv_axiom(rt_cat(actor, ".sound_trial"), 1, dv_all(terms), effects)

fn c1_sound_action(actor):
    let source = c1_sound_source()
    let known = c1_sound_execution_condition(actor)
    let physical = dv_all([c1_sound_execution_condition(actor), campaign_at("detective", "hall"), campaign_at("huo", "hall"), campaign_at("su", "R08"), campaign_at("shen", "foyer"), campaign_at("demon", "living_hall")])
    var action = c1_once(campaign_intent_action(rt_cat(actor, ".sound_trial"), "sound_test", known, physical, rt_cat(actor, ".sound_trial"), [c1_sound_ref("sound_trial_done"), campaign_evidence_ref("sound_trial")], "按已确认的站位完成一次声路试验", source))
    // Only the termination signal crosses this action's public channel. The
    // filtered words belong to each actual listening position's own observation.
    action = dv_with_many(action, {"speech": dv_with_many(c1_speech(dv_true(), source, "trial-termination-signal"), {"channel": "copper.trial.signal", "surface": "两声轻响，停歇。试验结束。"}), "listeners": ["detective", "huo", "shen", "su", "demon"], "public_grants": [c1_sound_ref("sound_trial_done")], "predict_law": rt_cat(actor, ".sound_trial"), "presentation": c1_op_presentation(actor, "visible-action", ["约定的两声轻响传过铜管，读句停止。"]), "purpose_refs": [campaign_evidence_ref("sound_trial"), campaign_evidence_ref("heads_lost")]})
    return action

fn c1_sound_read_result(actor):
    let source = c1_sound_source()
    let id = rt_cat(actor, ".sound.remember-hearing")
    let checked = rt_cat("hearing_checked.", actor)
    let at = campaign_at(actor, c1_sound_station(actor))
    let known = dv_all([at, c1_sound_fact("sound_trial_done", true), c1_sound_fact(rt_cat("ready.", actor), true), c1_sound_fact(checked, false)])
    let physical = dv_all([known, c1_sound_fact(rt_cat("heard.", actor), c1_sound_result(actor)), c1_sound_fact(rt_cat("heard_at.", actor), c1_sound_station(actor))])
    let law = dv_axiom(id, 1, physical, [dv_assign(c1_sound_ref(checked), true)])
    var grants = [c1_sound_ref(checked), c1_sound_ref(rt_cat("heard.", actor)), c1_sound_ref(rt_cat("heard_at.", actor)), c1_sound_ref(rt_cat("heard_words.", actor)), c1_sound_ref(rt_cat("heard_from.", actor)), campaign_evidence_ref("sound_trial")]
    if actor == "su" or actor == "shen":
        rt_push(grants, campaign_evidence_ref("heads_lost"))
    var action = c1_once(campaign_intent_action(id, "inspect", known, physical, id, grants, "记下本人在听音处实际听见的声音", source))
    action = dv_with_many(action, {"predict_law": id, "presentation": c1_op_presentation(actor, "private-monologue", [c1_sound_report_text(actor)]), "observation_source": "perception", "observation_origin": actor})
    return {"action": action, "law": law}

fn c1_sound_report(actor):
    let source = c1_sound_source()
    let id = rt_cat(actor, ".sound.report-hearing")
    let known = dv_all([campaign_at(actor, "hall"), c1_sound_fact(rt_cat("hearing_checked.", actor), true), c1_sound_fact(rt_cat("heard.", actor), c1_sound_result(actor))])
    var grants = [c1_sound_ref(rt_cat("heard.", actor)), c1_sound_ref(rt_cat("heard_at.", actor)), c1_sound_ref(rt_cat("heard_words.", actor)), c1_sound_ref(rt_cat("heard_from.", actor)), campaign_evidence_ref("sound_trial")]
    var literal = dv_all([c1_sound_fact(rt_cat("heard.", actor), c1_sound_result(actor)), c1_sound_fact(rt_cat("heard_at.", actor), c1_sound_station(actor)), c1_sound_fact(rt_cat("heard_words.", actor), c1_sound_words(actor))])
    if actor == "su" or actor == "shen":
        rt_push(grants, campaign_evidence_ref("heads_lost"))
        literal = dv_all([literal, c1_statement("heads_lost")])
    let reported = c1_sound_ref(rt_cat("hearing_reported.", actor))
    var present = ["detective"]
    if actor == "detective":
        present = ["su"]
    var action = campaign_intent_action(id, "talk", known, known, id, [reported], "向在场者报告自己的听感", source)
    action = dv_with_many(action, {"speech": dv_with(c1_speech(literal, source, "own-station-hearing-report"), "surface", c1_sound_report_text(actor)), "listeners": ["detective", "huo", "shen", "su"], "public_grants": [], "response_topic": "heads_lost", "opportunity_requirement": {"location": "hall", "participants": present, "mode": "all-present"}, "purpose_refs": grants, "predict_law": id, "presentation": c1_op_presentation(actor, "dialogue", [])})
    return action

fn c1_loss_testimony(actor):
    let source = c1_sound_source()
    let known = dv_all([campaign_at(actor, "hall"), c1_sound_fact("sound_trial_done", true), dv_not(c1_statement("heads_lost"))])
    var action = c1_once(campaign_intent_action(rt_cat(actor, ".loss_testimony"), "talk", known, campaign_at(actor, "hall"), "", [], "询问 R-08 的实际听感", source))
    return dv_with_many(action, {"speech": dv_with_many(c1_speech(dv_true(), source, "actual-question-to-trial-participant"), {"surface": "你刚才在房里听见了什么？请照听见的说，听不清的地方也说出来。", "request": {"target": "su", "topic": "heads_lost"}}), "listeners": ["su"], "purpose_refs": [campaign_evidence_ref("heads_lost")], "presentation": c1_op_presentation(actor, "dialogue", [])})

fn c1_sound_install_scene(scene):
    if dv_find(scene, "sound_trial_installed", false):
        return scene
    let source = c1_sound_source()
    let people = ["detective", "huo", "shen", "su"]
    var physical = scene.physical
    var bindings = dv_clone(scene.bindings)
    var initial = {"sound_trial_requested": false, "sound_trial_done": false, "coordinator": "", "repeater_agreed": false}
    var i = 0
    while i < rt_count(people):
        initial = dv_with(initial, rt_cat("ready.", people[i]), false)
        initial = dv_with(initial, rt_cat("hearing_checked.", people[i]), false)
        initial = dv_with(initial, rt_cat("hearing_reported.", people[i]), false)
        physical = dv_store(physical, c1_sound_ref(rt_cat("heard.", people[i])), dv_field(""))
        physical = dv_store(physical, c1_sound_ref(rt_cat("heard_at.", people[i])), dv_field(""))
        physical = dv_store(physical, c1_sound_ref(rt_cat("heard_words.", people[i])), dv_field(""))
        physical = dv_store(physical, c1_sound_ref(rt_cat("heard_from.", people[i])), dv_field(""))
        // The base physical world already owns this complete execution law.
        // This installer adds participant state and their separate local models.
        i = i + 1
    i = 0
    while i < rt_count(initial):
        physical = dv_store(physical, c1_sound_ref(initial[i][0]), dv_field(initial[i][1]))
        i = i + 1
    var actors = []
    i = 0
    while i < rt_count(scene.actors):
        var actor = scene.actors[i]
        if dv_has(people, actor.id) or actor.id == "demon":
            // The custodian's base mind has only its own position and question.
            // Declare a blank local record before writing the explicit initial
            // trial state; never copy the physical ritual's hidden contents.
            var mind = campaign_add_new(actor.mind, campaign_local_object("ritual"))
            if dv_local(bindings, "ritual", actor.id) == "":
                rt_push(bindings, dv_binding("ritual", "ritual", actor.id))
            var j = 0
            while j < rt_count(initial):
                mind = dv_store(mind, c1_sound_ref(initial[j][0]), dv_with(dv_field(initial[j][1]), "basis", [source]))
                j = j + 1
            var actions = []
            j = 0
            while j < rt_count(actor.actions):
                var action = actor.actions[j]
                // The former generic reply could assert a result without ever
                // taking part. Only the completed own-hearing report replaces it.
                if action.id != rt_cat(actor.id, ".reply.heads_lost") and not (dv_has(["su", "shen"], actor.id) and action.id == rt_cat(actor.id, ".sound_trial")):
                    if dv_has(people, actor.id) and action.kind == "move":
                        let free = campaign_any(c1_sound_fact(rt_cat("ready.", actor.id), false), c1_sound_fact(rt_cat("hearing_checked.", actor.id), true))
                        action = dv_with_many(action, {"precondition": dv_all([action.precondition, free]), "authority_precondition": dv_all([action.authority_precondition, free])})
                    rt_push(actions, action)
                j = j + 1
            var declarations = []
            var goals = dv_clone(actor.policy.goals)
            if dv_has(["detective", "huo"], actor.id):
                let invitation = c1_sound_invite(actor.id)
                rt_push(declarations, invitation)
                rt_push(goals, {"kind": "communicate", "scope": "personal", "method_id": invitation.action.id, "available_when": invitation.action.precondition, "requires_argument": false, "basis": [source]})
                rt_push(goals, campaign_goal(c1_sound_fact("sound_trial_done", true), dv_all([c1_sound_pending(), c1_sound_fact("coordinator", actor.id)]), [source]))
            if dv_has(people, actor.id):
                rt_push(declarations, c1_sound_ready(actor.id))
                rt_push(declarations, c1_sound_read_result(actor.id))
                let report = c1_sound_report(actor.id)
                let report_law = dv_axiom(report.id, 1, report.authority_precondition, [dv_assign(c1_sound_ref(rt_cat("hearing_reported.", actor.id)), true)])
                rt_push(declarations, {"action": report, "law": report_law})
                rt_push(goals, campaign_goal(campaign_at(actor.id, c1_sound_station(actor.id)), c1_sound_pending(), [source]))
                rt_push(goals, campaign_goal(c1_sound_fact(rt_cat("ready.", actor.id), true), c1_sound_pending(), [source]))
                rt_push(goals, campaign_goal(c1_sound_fact(rt_cat("hearing_checked.", actor.id), true), c1_sound_fact("sound_trial_done", true), [source]))
                rt_push(goals, campaign_goal(campaign_at(actor.id, "hall"), dv_all([c1_sound_fact(rt_cat("hearing_checked.", actor.id), true), c1_sound_fact(rt_cat("hearing_reported.", actor.id), false)]), [source]))
                rt_push(goals, {"kind": "communicate", "scope": "personal", "method_id": report.id, "available_when": report.precondition, "requires_argument": false, "basis": [source]})
                mind = dv_adopt(mind, campaign_method(rt_cat(actor.id, ".sound_trial"), c1_sound_execution_law(actor.id)), "predict", 1, [source])
            else:
                let agreement = c1_sound_agreement()
                rt_push(declarations, agreement)
                rt_push(goals, {"kind": "communicate", "scope": "personal", "method_id": agreement.action.id, "available_when": agreement.action.precondition, "requires_argument": false, "basis": [source]})
            j = 0
            while j < rt_count(declarations):
                let declaration = declarations[j]
                rt_push(actions, declaration.action)
                physical = dv_adopt(physical, campaign_method(declaration.action.id, declaration.law), "enforce", 1, [source])
                mind = dv_adopt(mind, campaign_method(declaration.action.id, declaration.law), "predict", 1, [source])
                j = j + 1
            var hearing = dv_clone(dv_find(actor, "hearing_grants", []))
            let senders = ["detective", "huo", "shen", "su", "demon"]
            j = 0
            while j < rt_count(senders):
                var sender_room = c1_sound_station(senders[j])
                if senders[j] == "demon":
                    sender_room = "living_hall"
                let listener_room = c1_sound_station(actor.id)
                var listener_rooms = ["hall", listener_room]
                if actor.id == "demon":
                    listener_rooms = ["living_hall"]
                rt_push(hearing, {"speaker": senders[j], "channel": "copper.trial.signal", "available_when": dv_true(), "sender_locations": [sender_room], "listener_locations": listener_rooms, "basis": [source]})
                j = j + 1
            actor = dv_with_many(actor, {"mind": mind, "actions": c1_public_methods(actions), "hearing_grants": hearing, "policy": dv_with(actor.policy, "goals", goals)})
        rt_push(actors, actor)
        i = i + 1
    return dv_with_many(scene, {"physical": physical, "actors": actors, "bindings": bindings, "sound_trial_installed": true})

fn c1_latch_contact_ref():
    return dv_ref("ritual", "state", "present_latch_contact.detective")

fn c1_latch_contact_source():
    return campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/04_低语与回想.story", 161, "recall_detective.002; bodily-flash-only")

法则 c1_latch_contact_law：
