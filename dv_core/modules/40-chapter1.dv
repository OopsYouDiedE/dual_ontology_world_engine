    var result = []
    rt_push(result, {"id": "quer", "material_label": "检视随身袋子的扎口", "name": "雀儿", "group": "contract", "desire": "一个不会赶她走的地方", "initial_surface": "门。门闩在外面。", "material_surface": "袋子还在，口扎得死紧。我的结。", "intention_surface": "先看看那道门闩。", "memory_surface": "怎么来的？上船，然后……不知道。", "memory_source": campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 47, "opening_quer.003"), "initial_source": campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 46, "opening_quer.002"), "material_source": campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/10_开场独白.story", 48, "opening_quer.004"), "desire_source": campaign_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/07_雀儿.story", 10, "quer.desire")})
