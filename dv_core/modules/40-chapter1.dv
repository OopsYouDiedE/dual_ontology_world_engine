    var action = c1_once(campaign_intent_action(name, "talk", dv_all([campaign_at("detective", room), c1_statement("shelf_old")]), campaign_at("detective", room), name, [c1_palm_invitation_ref()], "邀请在场者对照掌印", campaign_source("user", 0, "E11亲见后正式邀请与实际收闻同行机会")))
    return dv_with_many(action, {"predict_law": name, "speech": dv_with(c1_speech(claim, surface, "own-comparison-invitation"), "surface", surface), "listeners": ["huo", "shen", "su"], "surface": surface})

