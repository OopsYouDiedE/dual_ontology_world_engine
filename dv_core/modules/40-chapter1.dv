    return dv_with_many(action, {"predict_law": name, "travel": {"from": "R05", "to": "R05", "station": "site:E11"}, "surface": "四个人都在书架旁，依次将手掌靠近灰上的半枚手印，比过掌宽。侦探、霍铎、沈鼎、苏泠，都与它不合。", "sensory_mode": "executed-four-person-palm-comparison"})


fn c1_deep_resonance_site(actor):
    if actor == "huo":
        return {"room": "hall", "station": "site:E7", "evidence": "slate_marks"}
    if actor == "shen":
        return {"room": "pantry", "station": "site:E10", "evidence": "starter_layers"}
    return {"room": "R08", "station": "site:E6", "evidence": "score_partial"}

fn c1_deep_resonance_source(actor):
    return campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/04_低语与回想.story", 1, rt_cat("recall_", actor))

fn c1_deep_resonance_ref(actor):
    return dv_ref("ritual", "state", rt_cat("deep-retrieved.", actor))

fn c1_recall_advice_question():
    let source = campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/04_低语与回想.story", 134, "recall_hesitate_shen.002")
    let known = dv_all([campaign_at("shen", "pantry"), c1_statement("starter_kept"), dv_fact(c1_deep_resonance_ref("shen"), false)])
    let literal = c1_statement("starter_kept")
    let speech = dv_with_many(c1_speech(literal, source, "owner-request-for-advice"), {"utterance_type": "question", "surface": "罐子是我的。可这事……你说呢？", "request": {"target": "detective", "topic": "recall_advice"}})
    return dv_with_many(c1_once(campaign_intent_action("shen.recall_advice.ask", "talk", known, campaign_at("shen", "pantry"), "", [], "询问是否触碰回想之物", source)), {"speech": speech, "listeners": ["detective"], "opportunity_requirement": {"location": "pantry", "participants": ["shen", "detective"], "mode": "all-present"}, "received_speech_requirement": {"speaker": "demon", "action_id": "demon.opening.desire-offer"}})

fn c1_recall_advice_actions():
    let path = "godot_csharp/scenes/Awakening/Script/story/第一章/场面/04_低语与回想.story"
    let rows = [{"id": "touch", "label": "建议触碰回想之物", "text": "碰吧。我在边上。", "line": 137}, {"id": "decline", "label": "建议暂缓触碰回想之物", "text": "别往下想了。不知道那是什么，先别碰。", "line": 140}, {"id": "own", "label": "请物主自行决定", "text": "这是你的东西。你自己拿主意。", "line": 143}, {"id": "selective-truth", "label": "以随身物件鼓励触碰", "text": "罐子你照样喂着。先把自己的罐子拿稳，我就在旁边。", "line": 134}]
    var result = []
    var i = 0
    while i < rt_count(rows):
        let row = rows[i]
        var source = campaign_source(path, row.line, rt_cat("recall_advice.", row.id))
        var literal = dv_true()
        var known = campaign_at("detective", "pantry")
        if row.id == "selective-truth":
            source = campaign_source("user:current-request", 0, "authorized-partial-true-advice")
            literal = c1_statement("starter_kept")
            known = dv_all([known, literal])
        var speech = dv_with(c1_speech(literal, source, "player-advice-not-owner-command"), "surface", row.text)
        var position = "consider"
        if row.id == "decline":
            position = "avoid"
        if row.id == "own":
            position = "owner-decides"
        let advice_id = rt_cat("recall_advice.", row.id)
        speech = dv_with(speech, "advice", {"id": advice_id, "topic": "recall_advice", "targets": ["shen"], "proposed_action_ids": ["shen.deep-resonance"], "position": position, "basis": [source]})
        if row.id == "selective-truth":
            speech = dv_with(speech, "manipulation", {"method": "selective-true-owned-object-framing", "advice_id": advice_id, "targets": ["shen"], "action_ids": ["shen.deep-resonance"], "consequence_when": dv_fact(c1_deep_resonance_ref("shen"), true), "basis": [source, campaign_source(path, 134, "recall_hesitate_shen.002")]})
        let action = c1_once(campaign_intent_action(rt_cat("detective.recall_advice.", row.id), "talk", known, campaign_at("detective", "pantry"), "", [], row.label, source))
        rt_push(result, dv_with_many(action, {"speech": speech, "listeners": ["shen"], "manual_only": true, "response_topic": "recall_advice", "requires_actual_request": true, "response_once": true, "received_speech_requirement": {"speaker": "shen", "action_id": "shen.recall_advice.ask"}, "opportunity_requirement": {"location": "pantry", "participants": ["detective", "shen"], "mode": "all-present"}}))
        i = i + 1
    return result

fn c1_recall_advice_responses():
    let source = campaign_source("user:current-request", 0, "actual-owner-advice-acceptance-or-refusal")
    let options = ["touch", "decline", "own", "selective-truth"]
    var result = []
    var i = 0
    while i < rt_count(options):
        var stance_index = 0
        while stance_index < 2:
            let accepted = stance_index == 1
            var suffix = ".decline"
            var surface = "这条建议，我眼下不采纳。罐子我照样喂，回想的事由我自己定。"
            if accepted:
                suffix = ".accept"
                surface = "这建议我听进去了。碰不碰，我还按自己拿得准的事决定。"
            let id = rt_cat(rt_cat("shen.recall_advice.", options[i]), suffix)
            let known = campaign_at("shen", "pantry")
            let speech = dv_with(c1_speech(dv_true(), source, "owner-advice-stance-not-execution"), "surface", surface)
            let action = c1_once(campaign_intent_action(id, "talk", known, known, "", [], rt_cat(dv_get({"true": "采纳", "false": "不采纳"}, rt_show(accepted)), "回想建议"), source))
            rt_push(result, dv_with_many(action, {"speech": speech, "listeners": ["detective"], "received_speech_requirement": {"speaker": "detective", "action_id": rt_cat("detective.recall_advice.", options[i])}, "advice_decision": {"advice_id": rt_cat("recall_advice.", options[i]), "accepted": accepted, "assessment_action_id": "shen.deep-resonance"}}))
            stance_index = stance_index + 1
        i = i + 1
    return result

法则 c1_deep_resonance_law，给定 行动者：
    前提 campaign_at(行动者, c1_deep_resonance_site(行动者).room)。
    则 c1_deep_resonance_ref(行动者) 变为 true。

fn c1_deep_resonance_action(actor):
    let site = c1_deep_resonance_site(actor)
    let source = c1_deep_resonance_source(actor)
    var grants = [c1_deep_resonance_ref(actor)]
    var surface = "苏泠闭上眼，沿着乐谱里缺失的声音继续追索。门边有人喊开门；她想让那人进来。她睁开眼，脸色发白。"
    if actor == "huo":
        rt_push(grants, campaign_evidence_ref("recalled_copper"))
        surface = "粉笔灰沾了霍铎一手。他没有松开石板，继续追索那声音：铜口里很清楚，‘等我下一次通知。’他叫我守铜口。……他再也没有来。"
    if actor == "shen":
        rt_push(grants, campaign_evidence_ref("recalled_names"))
        surface = "沈鼎的拇指沿着罐壁上一层层干面痕继续摸索。阿泠的茶不放糖，老霍的放两勺，那位清茶不放奶。阿泠……这称呼怎么脱口就来了。"
    let prerequisite = dv_all([campaign_at(actor, site.room), c1_statement(site.evidence)])
    var action = c1_once(campaign_intent_action(rt_cat(actor, ".deep-resonance"), "move", prerequisite, campaign_at(actor, site.room), rt_cat(actor, ".deep-resonance"), grants, "触碰熟悉的物件以尝试回想", source))
    var requires = c1_statement(site.evidence)
    if actor == "huo":
        requires = dv_all([requires, c1_op_property("opening.facilities", "drawing_exists", true)])
    return dv_with_many(action, {"predict_law": rt_cat(actor, ".deep-resonance"), "travel": {"from": site.room, "to": site.room, "station": site.station}, "received_speech_requirement": {"speaker": "demon", "action_id": "demon.opening.desire-offer", "receipt_kind": "actual-listener-parse"}, "desire_requirement": {"subject": actor, "desire_id": c1_op_desire(actor).id, "basis": c1_op_desire(actor).basis}, "resonance": {"basis": [source], "requires": requires, "drive": {"policy_key": "drive"}, "relevance": {"policy_key": "resonance_relevance"}, "truth_bonus": {"policy_key": "truth_bonus"}, "caution": {"policy_key": "caution"}, "perceived_risk": {"policy_key": "perceived_risk"}, "retrieved_when": dv_fact(c1_deep_resonance_ref(actor), true), "coupling": 1, "night_call": true, "night_when": dv_fact(c1_deep_resonance_ref(actor), true)}, "surface": surface, "sensory_mode": "active-deep-resonance"})


fn c1_public_answer_speech(action):
    if action.answer_id == "me" or action.answer_id == "trust":
        var surface = "是我闩的门。"
        if action.answer_id == "trust":
            surface = "我因早已相熟而信霍铎。"
        return dv_with_many(action, {"speech": dv_with(c1_speech(action.answer, surface, "actual-public-defense"), "surface", surface), "listeners": ["demon", "huo", "shen", "su"]})
    if action.answer_id == "V5_0" or action.answer_id == "V5_1" or action.answer_id == "V5_2":
        var surface = "我决定先听霍铎的。"
        if action.answer_id == "V5_1":
            surface = "我决定先听苏泠的。"
        if action.answer_id == "V5_2":
            surface = "我决定暂不听从任何一方。"
        return dv_with_many(action, {"speech": dv_with(c1_speech(action.answer, surface, "actual-public-defense"), "surface", surface), "listeners": ["demon", "huo", "shen", "su"]})
    let pairs = [["V3_0", "V3_1", "voice-source", "声音来自铜口，经管道传来。", "声音就在门外。"], ["V4_0", "V4_1", "original-words", "原话是闩门禁开。", "原话是开门救人。"], ["V6_1", "V6_0", "familiarity", "我们原本相熟。", "我们原本不相熟。"]]
    var i = 0
    while i < rt_count(pairs):
        let pair = pairs[i]
        if action.answer_id == pair[0] or action.answer_id == pair[1]:
            var opposite = pair[0]
            var surface = pair[4]
            if action.answer_id == pair[0]:
                opposite = pair[1]
                surface = pair[3]
            let speech = dv_with_many(c1_speech(action.answer, surface, "actual-public-defense"), {"surface": surface, "public_claim": {"key": pair[2], "value": action.answer_id, "conflicts_with": [opposite], "basis": action.source_refs}})
            return dv_with_many(action, {"speech": speech, "listeners": ["demon", "huo", "shen", "su"]})
        i = i + 1
    return action

fn c1_answer_conflict_response(actor, key):
    var surface = "你刚才的答辩和现在说的互相矛盾。我不能只因你说得笃定就跟着你。"
    if actor == "su":
        surface = "你刚才明明那样说，现在又换了说法。别把我们当作可以随你推论摆弄的人。那是同伴的呼喊，也是人的性命。"
    if actor == "huo":
        surface = "你前后的答辩对不上。哪一处证物让你改了判断？我要看根据。"
    if actor == "shen":
        surface = "你前后说得不一样。我得先弄清你改口的根据，才敢让身边的人跟着做。"
    var action = c1_once(campaign_intent_action(rt_cat(rt_cat(actor, ".respond-defense-conflict."), key), "talk", campaign_at(actor, "hall"), campaign_at(actor, "hall"), "", [], "回应答辩中的冲突", campaign_source("user", 0, "实际前后矛盾答辩引起的道德谴责与疑虑")))
    return dv_with_many(action, {"received_claim_conflict": {"speaker": "detective", "key": key}, "speech": dv_with(c1_speech(dv_true(), surface, "own-moral-appraisal-of-actually-heard-defense"), "surface", surface), "listeners": ["detective", "huo", "shen", "su"], "personal_purpose": {"subject": actor, "id": "question-contradictory-defense", "basis": c1_op_desire(actor).basis}})


fn c1_palm_invitation_ref():
