                    rt_push(answers, {"id": complete_id, "stage": rt_cat(group, ".reason"), "content_grade": "complete-causal-account", "condition": complete, "required_support": complete, "question_match": dv_all([campaign_case_claim(group, "open"), campaign_case_claim(group, "receipt.detective")]), "answer_complete": complete, "require_argument": false, "accepted_law": rt_cat("other.complete-accept.", rt_cat(group, ".detective")), "progress_ref": campaign_case_ref(group, "complete_level.detective"), "completion_ref": campaign_case_ref(group, "complete_receipt.detective"), "accepted_listeners": ["detective", "demon"], "accepted_public_grants": [campaign_case_ref(group, "complete_receipt.detective"), campaign_case_ref(group, "complete_level.detective"), current_ref], "source_refs": [source]})
                    reason_index = reason_index + 1
                option_index = option_index + 1
            actor = dv_with_many(actor, {"actions": local_actions, "policy": dv_with(actor.policy, "goals", local_goals)})
            let origins = [c1_other_case(group).room, c1_other_threshold(group)]
            let targets = [c1_other_threshold(group), "living_hall"]
            var move_index = 0
            while move_index < rt_count(origins):
                let move_id = rt_cat("detective.other.exit.", rt_cat(group, rt_cat(".", origins[move_index])))
                let pre = dv_all([campaign_at("detective", origins[move_index]), campaign_case_claim(group, "outer_latch_released"), dv_fact(c1_other_access_ref(group), true)])
                let law = dv_axiom(move_id, 1, pre, [dv_assign(dv_ref("detective", "state", "location"), targets[move_index])])
                world = dv_adopt(world, campaign_method(move_id, law), "enforce", 1, [source])
                mind = dv_adopt(actor.mind, campaign_method(move_id, law), "predict", 1, [source])
                let action = dv_with_many(campaign_surface_action(move_id, "move", pre, pre, move_id, [dv_ref("detective", "state", "location")], "跨过寝区门槛", "确认外闩已经打开后，跨过门槛。", source), {"predict_law": move_id, "travel": {"from": origins[move_index], "to": targets[move_index], "gate": group}})
                actor = dv_with_many(actor, {"mind": mind, "actions": dv_append(actor.actions, c1_other_case_choice(action, group, "departure"))})
                move_index = move_index + 1
            let truth = c1_other_truth_rows(group)
            var j = 0
            while j < rt_count(truth):
                let row = truth[j]
                world = dv_store(world, campaign_case_ref(group, row.id), dv_field(false))
                let method = rt_cat("detective.truth.", row.id)
                let law = c1_other_truth_law(group, row)
                world = dv_adopt(world, campaign_method(method, law), "enforce", 1, [c1_other_case(group).source])
                mind = actor.mind
                if row.kind != "talk":
                    mind = dv_store(mind, campaign_case_ref(group, row.id), dv_with(dv_field(false), "basis", [c1_other_case(group).source]))
                mind = dv_adopt(mind, campaign_method(method, law), "predict", 1, [c1_other_case(group).source])
                var action = dv_with(campaign_surface_action(method, row.kind, law.premise, law.premise, method, [campaign_case_ref(group, row.id)], row.label, row.text, c1_other_case(group).source), "predict_law", method)
                if row.kind == "inspect" and dv_find(row, "shared_inspection", false):
                    action = dv_with_many(action, {"public_observers": c1_other_group_listeners(group, ""), "public_grants": [campaign_case_ref(group, row.id)]})
                if row.kind == "talk":
                    let after = campaign_case_claim(group, row.after)
                    action = dv_with_many(campaign_surface_action(rt_cat("detective.truth.ask.", row.id), "talk", dv_all([campaign_at("detective", c1_other_case(group).room), after]), dv_all([campaign_at("detective", c1_other_case(group).room), campaign_at(row.partner, c1_other_case(group).room)]), "", [], row.label, "请看这份已核对的材料。你能说明自己记得的经过吗？", c1_other_case(group).source), {"speech": dv_with_many(c1_speech(after, c1_other_case(group).source, "actual-evidence-question"), {"surface": "请看这份已核对的材料。你能说明自己记得的经过吗？", "request": {"target": row.partner, "topic": rt_cat("truth.", row.id)}}), "listeners": [row.partner], "purpose_refs": [campaign_case_ref(group, row.id)]})
                let actions = dv_append(actor.actions, c1_other_case_choice(action, group, "investigate"))
                var goals = dv_append(actor.policy.goals, campaign_goal(campaign_case_claim(group, row.id), campaign_at("detective", c1_other_case(group).room), [c1_other_case(group).source]))
                if row.kind == "talk":
                    rt_push(goals, {"kind": "communicate", "scope": "personal", "method_id": action.id, "available_when": action.precondition, "requires_argument": false, "basis": [c1_other_case(group).source]})
                actor = dv_with_many(actor, {"mind": mind, "actions": actions, "policy": dv_with(actor.policy, "goals", goals)})
                j = j + 1
            let last = truth[rt_count(truth) - 1]
            let reason = campaign_case_ref(group, rt_cat("reason.", c1_other_case(group).authority_reason))
            let inference = dv_axiom(rt_cat("detective.truth.reason.", group), 1, campaign_case_claim(group, last.id), [dv_assign(reason, true)])
            actor = dv_with(actor, "mind", dv_adopt(actor.mind, campaign_method(rt_cat("detective.truth.reason.", group), inference), "infer", 1, [c1_other_case(group).source]))
            if dv_local(bindings, rt_cat("case.", group), "detective") == "":
                rt_push(bindings, dv_binding(rt_cat("case.", group), rt_cat("case.", group), "detective"))
        rt_push(actors, actor)
        i = i + 1
    var respondents = []
    let truth = c1_other_truth_rows(group)
    i = 0
    while i < rt_count(actors):
        var actor = actors[i]
        var j = 0
        while j < rt_count(truth):
            let row = truth[j]
            if row.kind == "talk" and actor.id == row.partner:
