axiom c1_hist_argument_source(history, knowledge, source, loss):
    var local_1 = false
    if (source == "Tube"):
        local_1 = "tail"
    else:
        local_1 = "muffled-full"
    var local_2 = false
    if (source == "Tube"):
        local_2 = "Open"
    else:
        local_2 = "OpenSaveMe"
    return dv_axiom("c1_hist_argument_source", 1, dv_all([dv_fact(dv_ref(history, "state", "voice_source"), source), dv_fact(dv_ref(history, "heard_form", "past.su"), local_1), dv_fact(dv_ref(history, "heard_words", "past.su"), local_2), dv_fact(dv_ref(knowledge, "state", "predicted_bolt"), true)]), dv_pair(dv_assign(c1_hist_claim_ref("voice_source"), source), dv_assign(c1_hist_claim_ref("transmission_loss"), loss)))

