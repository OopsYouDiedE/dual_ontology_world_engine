    return c1_once(c1_observe_as(campaign_intent_action(rt_cat(actor, ".talk.cups_known"), "talk", campaign_at(actor, "pantry"), dv_all(dv_pair(campaign_at(actor, "pantry"), campaign_at("shen", "pantry"))), "", dv_single(campaign_evidence_ref("cups_known")), "询问杯子的摆放", campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/可习得命题.story", 85, "help_E9.003")), "testimony", "shen", 0.85))

fn c1_talk_starter_kept(actor):
    return c1_once(c1_observe_as(campaign_intent_action(rt_cat(actor, ".talk.starter_kept"), "talk", campaign_at(actor, "pantry"), dv_all(dv_pair(campaign_at(actor, "pantry"), campaign_at("shen", "pantry"))), "", dv_single(campaign_evidence_ref("starter_kept")), "询问罐中酵头", campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/可习得命题.story", 86, "help_E10.002")), "testimony", "shen", 0.85))

fn c1_talk_recalled_copper(actor):
