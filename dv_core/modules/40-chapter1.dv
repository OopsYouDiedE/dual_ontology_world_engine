    前提 dv_all(dv_append(dv_list3(dv_fact(dv_ref(knowledge, "state", "slate_marks"), true), dv_fact(dv_ref(knowledge, "state", "slate_code"), true), dv_fact(dv_ref(knowledge, "state", "slate_person"), true)), dv_fact(dv_ref(knowledge, "state", "lens_mine"), true)))。
