fn c1_latch_contact_action():
    let known = dv_all([campaign_at("detective", "foyer"), c1_statement("bolt_down"), dv_fact(c1_latch_contact_ref(), false)])
    let physical = dv_all(dv_pair(campaign_at("detective", "foyer"), dv_fact(c1_latch_contact_ref(), false)))
