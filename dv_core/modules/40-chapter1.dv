                    actor = dv_with_many(actor, {"mind": mind, "actions": dv_append(actor.actions, seen), "policy": dv_with(actor.policy, "goals", dv_append(actor.policy.goals, campaign_observation_goal(dv_ref(peer.id, "state", "location"), ready, [c1_other_case(group).source], 0)))})
                peer_index = peer_index + 1
            let source = c1_other_case(group).source
            let public_refs = [campaign_case_ref(group, "open"), campaign_case_ref(group, "current"), current_ref, campaign_case_ref(group, "receipt.detective"), campaign_case_ref(group, "complete_receipt.detective"), campaign_case_ref(group, "outer_latch_released"), campaign_case_ref(group, "formal_release"), c1_other_access_ref(group), campaign_clock()]
            let recheck = dv_with(campaign_surface_action("detective.other.reask-question", "inspect", here, here, "", public_refs, "核对寝区公开题目与答复记录", "在寝区铜口核对当前实际公开的题目与答复记录。", source), "repeatable", true)
            var local_actions = dv_append(actor.actions, recheck)
            var local_goals = dv_clone(actor.policy.goals)
            rt_push(local_goals, campaign_observation_goal(current_ref, here, [source], 0))
            rt_push(local_goals, campaign_goal(campaign_case_claim(group, "receipt.detective"), dv_all([campaign_case_claim(group, "open"), dv_true()]), [source]))
            rt_push(local_goals, campaign_goal(campaign_case_claim(group, "complete_receipt.detective"), campaign_case_claim(group, "receipt.detective"), [source]))
            let exit_ready = dv_all([campaign_case_claim(group, "outer_latch_released"), dv_fact(c1_other_access_ref(group), true)])
            rt_push(local_goals, campaign_observation_goal(campaign_case_ref(group, "outer_latch_released"), here, [source], 0))
