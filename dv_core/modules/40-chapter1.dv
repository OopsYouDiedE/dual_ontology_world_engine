fn c1_other_person(id):
    var rows = c1_other_people()
    var i = 0
    while (i < rt_count(rows)):
        if (rows[i].id == id):
            return rows[i]
        i = (i + 1)
    dv_require(false, "Unknown chapter-one other-group actor")
    return false

fn c1_other_case(group):
    if (group == "contract"):
        return {"id": "contract", "room": "dorm.contract", "zone": "甲区", "prompt": "谁开启内柜，物品藏在哪里，又做了什么？", "options": ["quer", "ward", "gu", "lucian"], "reason_options": ["authorized_transfer", "theft"], "reason_surfaces": ["受命转移文书", "私自行窃"], "authority_actor": "quer", "authority_reason": "authorized_transfer", "source": campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 9, "文契"), "outside_evidence_surface": "无署名、无日期的《紧急转移清册》残页记着交“雀（J.C.）”用钥匙转移管网图；须与残角、柜锁及管网图去向合并核对", "outside_evidence_scope": "requires-local-inspection-and-personal-testimony"}
    if (group == "astral"):
        return {"id": "astral", "room": "dorm.astral", "zone": "丙区", "prompt": "是谁让一个人留在了沉静室里？", "options": ["ruan", "selma", "moran"], "reason_options": ["self_preservation", "requested_closure"], "reason_surfaces": ["单方面止损、保住多数而封门", "伊莲娜示意关门"], "authority_actor": "ruan", "authority_reason": "requested_closure", "source": campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 28, "星仪"), "outside_evidence_surface": "莫兰撕下的那页速写：伊莲娜在门内抬手示意；沉静室门内的步位标线一道不乱", "outside_evidence_scope": "requires-local-inspection-and-personal-testimony"}
    if (group == "logistics"):
        return {"id": "logistics", "room": "dorm.logistics", "zone": "丁区", "prompt": "白塔柜里那瓶试剂，是谁取走的？", "options": ["veronica", "mora", "bertrand", "margaret"], "reason_options": ["experiment", "wound_cleaning"], "reason_surfaces": ["未经医嘱进行激进酸试验", "依据自体耐受标定救治贝尔特朗"], "authority_actor": "veronica", "authority_reason": "wound_cleaning", "source": campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 45, "后勤"), "outside_evidence_surface": "维罗妮卡左臂的旧疤与本人对稀酸清创的解释", "outside_evidence_scope": "requires-local-inspection-and-personal-testimony"}
    dv_require(false, "Unknown chapter-one dormitory group")
    return false

fn c1_other_traces(group):
    var result = []
    if (group == "contract"):
        rt_push(result, {"id": "wet_rubbing", "title": "拓片", "surface": "顾平章的拓片墨迹未干。", "excluded_actor": "gu", "needs_actual_witness": false, "source": campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 18, "拓片墨未干")})
    if (group == "contract"):
        rt_push(result, {"id": "continuous_manuscript", "title": "手稿", "surface": "卢西安的手稿写满三页，墨迹连贯。", "excluded_actor": "lucian", "needs_actual_witness": false, "source": campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 19, "手稿写满三页")})
    if (group == "contract"):
        rt_push(result, {"id": "lock_checklist", "title": "柜锁清单", "surface": "沃德的柜锁清单上压着笔痕，写的是记录。", "excluded_actor": "ward", "needs_actual_witness": false, "source": campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 20, "清单上的笔痕")})
    if (group == "astral"):
        rt_push(result, {"id": "continuous_specimen_notes", "title": "标本笔记", "surface": "赛尔玛的标本笔记一条接一条，时刻连着。", "excluded_actor": "selma", "needs_actual_witness": false, "source": campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 37, "标本笔记不断")})
    if (group == "astral"):
        rt_push(result, {"id": "remaining_sketches", "title": "速写本", "surface": "莫兰的速写本撕掉了一页，剩下的都是共鸣厅里的人，没有门。", "excluded_actor": "moran", "needs_actual_witness": false, "source": campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 38, "速写本缺页")})
    if (group == "logistics"):
        rt_push(result, {"id": "sealed_medicine", "title": "药包封条", "surface": "茉拉药包的封条完好。", "excluded_actor": "mora", "needs_actual_witness": false, "source": campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 54, "药包封条完好")})
    if (group == "logistics"):
        rt_push(result, {"id": "lamp_and_no_reagent", "title": "提灯与持灯者的手", "surface": "玛格丽特的提灯灯油耗了一半，手上没有试剂味。", "excluded_actor": "margaret", "needs_actual_witness": false, "source": campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 55, "提灯油耗一半")})
    if (group == "logistics"):
        rt_push(result, {"id": "matching_lamps", "title": "两盏提灯", "surface": "两盏提灯的灯油耗相同。", "excluded_actor": "bertrand", "needs_actual_witness": true, "source": campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 56, "两盏灯互证")})
    return result

fn c1_other_identity(group, actor):
    return campaign_case_claim(group, rt_cat("answer.", actor))

// These old-source trace/actor associations are defeasible personal hypotheses.
// No inference law writes an exclusion or an answer merely from ink, a drawing,
// a seal, smell, or equal lamp consumption. Contrary personal evidence revises
// them through the shared hypothesis selector.
fn c1_other_exclusion_hypotheses(id):
    let person = c1_other_person(id)
    let spec = c1_other_case(person.group)
    let traces = c1_other_traces(person.group)
    var result = []
    var i = 0
    while i < rt_count(traces):
        let trace = traces[i]
        let observed = campaign_case_claim(person.group, rt_cat("trace.", trace.id))
        let proposition = dv_not(c1_other_identity(person.group, trace.excluded_actor))
        var available = dv_all(dv_pair(campaign_case_claim(person.group, "open"), observed))
        if trace.needs_actual_witness:
            available = dv_all(dv_pair(available, campaign_case_claim(person.group, "mutual_witness_received")))
        rt_push(result, {"id": rt_cat(rt_cat(id, ".exclusion."), trace.id), "question": rt_cat(person.group, ".identity"), "group": rt_cat(person.group, ".identity"), "proposition": proposition, "prior": 0.5, "available_when": available, "basis": [trace.source], "kind": "fallible-trace-heuristic", "observed_premise": observed, "scope": "present-material-to-past-activity", "missing_support": "independent-event-time-or-personal-witness", "established": false})
        i = i + 1
    return result

axiom c1_other_question_open(group):
    var effects = dv_pair(dv_assign(campaign_case_ref(group, "open"), true), dv_assign(campaign_case_ref(group, "current"), rt_cat(group, ".identity")))
    var people = c1_other_people()
    var i = 0
    while (i < rt_count(people)):
        if (people[i].group == group):
            rt_push(effects, dv_assign(dv_ref(rt_cat("personal.", people[i].id), "state", "current"), rt_cat(group, ".identity")))
        i = (i + 1)
    return dv_axiom(rt_cat("c1_other_question_open.", group), 1, dv_fact(campaign_case_ref(group, "open"), false), effects)

法则 c1_other_accept，给定 分区、行动者：
    名为 rt_cat(rt_cat("c1_other_accept.", 分区), rt_cat(".", 行动者))。
    前提 campaign_case_claim(分区, 开放状态)。
    则 campaign_case_ref(分区, rt_cat("receipt.", 行动者)) 变为 true。
    并使 campaign_case_ref(分区, rt_cat("level.", 行动者)) 变为 1。
    并使 rt_cat("personal.", 行动者) 的 "current" 变为 rt_cat(分区, ".reason")。

// A valid duty report permits a real release action at the shared living hall.
axiom c1_other_release(group, clock_ref):
    var people = c1_other_people()
    var reported = dv_not(dv_true())
    var i = 0
    while (i < rt_count(people)):
        if (people[i].group == group):
            reported = campaign_any(reported, campaign_case_claim(group, rt_cat("receipt.", people[i].id)))
        i = (i + 1)
    var safe_time = 480
    var safety = campaign_case_claim(group, "evidence_complete")
    if group == "astral":
        safe_time = 1890
        safety = dv_all([campaign_case_claim(group, "care_given"), campaign_case_claim(group, "west_passage_checked"), c1_other_material(group, "west_air_clear", true), c1_other_material(group, "west_gas", "below-safety-mark"), c1_other_material(group, "ventilation_functional", true)])
    if group == "logistics":
        safe_time = 2010
        safety = dv_all([campaign_case_claim(group, "care_given"), campaign_case_claim(group, "observation_complete"), c1_other_material(group, "evening_checked", true), c1_other_material(group, "overnight_stable", true), c1_other_material(group, "fever", false), c1_other_material(group, "wound_stable", true)])
    return dv_axiom(rt_cat("c1_other_release.", group), 1, dv_all([reported, safety, dv_at_least(clock_ref, safe_time), campaign_at("demon", "living_hall"), dv_fact(dv_ref("demon.body", "state", "manifested"), true), dv_fact(campaign_case_ref(group, "formal_release"), false)]), [dv_assign(campaign_case_ref(group, "outer_latch_released"), true), dv_assign(campaign_case_ref(group, "formal_release"), true), dv_assign(c1_other_access_ref(group), true), dv_assign(dv_ref("demon.body", "state", "manifested"), false), dv_assign(dv_ref("demon.body", "state", "latch_hand_trace"), "long-narrow-hand")])

fn c1_other_open_action(group, speaker):
    var spec = c1_other_case(group)
    var action = c1_once(campaign_intent_action(rt_cat("other.question.", group), "opening.notice", campaign_at(speaker, "living_hall"), dv_all(dv_pair(campaign_at(speaker, "living_hall"), dv_fact(campaign_case_ref(group, "open"), false))), rt_cat("other.open.", group), [], rt_cat("提出", rt_cat(spec.zone, "的问题")), spec.source))
    action = dv_with_many(action, {"obligation": true, "obligation_due": 480, "completed_action_requirement": {"action_id": "demon.opening"}, "obligation_basis": [spec.source]})
    var speech = dv_with_many(c1_speech(dv_true(), spec.source, "group-question-not-an-asserted-answer"), {"surface": dvs_surface_parts(["铜口里传来声音：", spec.prompt]), "utterance_type": "question", "channel": rt_cat("copper.", group)})
    var listeners = []
    var grants = dv_pair(campaign_case_ref(group, "open"), campaign_case_ref(group, "current"))
    var people = c1_other_people()
    var i = 0
    while (i < rt_count(people)):
        if (people[i].group == group):
            rt_push(listeners, people[i].id)
            rt_push(grants, dv_ref(rt_cat("personal.", people[i].id), "state", "current"))
        i = (i + 1)
    return dv_with(dv_with(dv_with(dv_with(action, "speech", speech), "listeners", listeners), "public_grants", grants), "purpose_refs", dv_single(campaign_case_ref(group, "open")))

fn c1_other_inspections(id):
    var person = c1_other_person(id)
    var spec = c1_other_case(person.group)
    var rows = c1_other_traces(person.group)
    var result = []
    var i = 0
    while (i < rt_count(rows)):
        var row = rows[i]
        var ref = campaign_case_ref(person.group, rt_cat("trace.", row.id))
        var action = c1_once(campaign_intent_action(rt_cat(rt_cat(id, ".inspect."), row.id), "inspect", campaign_at(id, spec.room), campaign_at(id, spec.room), "", dv_single(ref), rt_cat("检视", row.title), row.source))
        rt_push(result, dv_with_many(action, {"label": rt_cat("检视", row.title), "surface": row.surface}))
        i = (i + 1)
    if id == "lucian":
        let departed = campaign_any(campaign_at("quer", "threshold.contract"), campaign_at("quer", "living_hall"))
        rt_push(result, dv_with(campaign_intent_action("lucian.inspect.quer-departure", "inspect", dv_all([campaign_at(id, spec.room), departed]), dv_all([campaign_at(id, spec.room), departed]), "", [dv_ref("quer", "state", "location")], "查看门边同伴的去向", spec.source), "surface", "卢西安从门边确认雀儿已经走出甲区。"))
    var own_ref = dv_ref(rt_cat("personal.", id), "state", "material_detail")
    rt_push(result, dv_with_many(c1_once(campaign_intent_action(rt_cat(id, ".inspect.own-material"), "inspect", campaign_at(id, spec.room), campaign_at(id, spec.room), "", dv_single(own_ref), person.material_label, person.material_source)), {"label": person.material_label, "surface": person.material_surface}))
    return result

fn c1_other_answer_actions(id):
    var person = c1_other_person(id)
    var spec = c1_other_case(person.group)
    var result = []
    var i = 0
    while (i < rt_count(spec.options)):
        var option = spec.options[i]
        var answer = c1_other_submission(person.group, option)
        var action_id = rt_cat(rt_cat(rt_cat(id, ".answer."), person.group), rt_cat(".", option))
        var known = dv_all([campaign_at(id, spec.room), campaign_case_claim(person.group, "open"), answer, dv_true()])
        var action = campaign_intent_action(action_id, "answer", known, known, "", [], rt_cat("提交人物答复：", c1_other_person(option).name), spec.source)
        var speech = dv_with(c1_speech(answer, spec.source, "literal-actor-only-not-motive"), "surface", rt_cat(c1_other_person(option).name, c1_other_report_surface(person.group)))
        rt_push(result, dv_with_many(action, {"answer": answer, "answer_id": action_id, "topic": rt_cat(person.group, ".identity"), "speech": dv_with(speech, "channel", rt_cat("copper.", person.group)), "listeners": dv_single("demon"), "authority_precondition": dv_all([campaign_at(id, spec.room), campaign_case_claim(person.group, "open"), campaign_at("demon", "living_hall"), dv_true()]), "purpose_refs": dv_single(campaign_case_ref(person.group, rt_cat("receipt.", id)))}))
        i = (i + 1)
    return result

fn c1_other_formal_answers():
    var people = c1_other_people()
    var result = []
    var i = 0
    while (i < rt_count(people)):
        var person = people[i]
        var spec = c1_other_case(person.group)
        var j = 0
        while (j < rt_count(spec.options)):
            var option = spec.options[j]
            var literal = c1_other_submission(person.group, option)
            var id = rt_cat(rt_cat(rt_cat(person.id, ".answer."), person.group), rt_cat(".", option))
            rt_push(result, {"id": id, "stage": rt_cat(person.group, ".identity"), "condition": literal, "required_support": literal, "question_match": campaign_case_claim(person.group, "open"), "answer_complete": literal, "require_argument": false, "accepted_law": rt_cat(rt_cat("other.accept.", person.group), rt_cat(".", person.id)), "progress_ref": campaign_case_ref(person.group, rt_cat("level.", person.id)), "completion_ref": campaign_case_ref(person.group, rt_cat("receipt.", person.id)), "accepted_listeners": [person.id, "demon"], "accepted_public_grants": [campaign_case_ref(person.group, rt_cat("receipt.", person.id)), campaign_case_ref(person.group, rt_cat("level.", person.id)), dv_ref(rt_cat("personal.", person.id), "state", "current"), campaign_clock()], "source_refs": dv_single(spec.source)})
            j = (j + 1)
        i = (i + 1)
    return result

fn c1_other_preconception(id):
    if (id == "ward"):
        return {"preferred": "theft", "source_strength": 3, "basis": dv_single(campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 22, "ward.preconception")), "kind": "authored-preconception-not-evidence"}
    if (id == "gu"):
        return {"preferred": "theft", "source_strength": 1, "basis": dv_single(campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 23, "gu.preconception")), "kind": "authored-preconception-not-evidence"}
    if (id == "lucian"):
        return {"preferred": "authorized_transfer", "source_strength": 1, "basis": dv_single(campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 24, "lucian.preconception")), "kind": "authored-preconception-not-evidence"}
    if (id == "elena"):
        return {"preferred": "self_preservation", "source_strength": 3, "basis": dv_single(campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 40, "elena.preconception")), "kind": "authored-preconception-not-evidence"}
    if (id == "selma"):
        return {"preferred": "self_preservation", "source_strength": 1, "basis": dv_single(campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 41, "selma.preconception")), "kind": "authored-preconception-not-evidence"}
    if (id == "mora"):
        return {"preferred": "experiment", "source_strength": 3, "basis": dv_single(campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 58, "mora.preconception")), "kind": "authored-preconception-not-evidence"}
    if (id == "bertrand"):
        return {"preferred": "experiment", "source_strength": 1, "basis": dv_single(campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/寝区案件.story", 59, "bertrand.preconception")), "kind": "authored-preconception-not-evidence"}
    return false

fn c1_other_reason_hypotheses(id):
    var person = c1_other_person(id)
    var spec = c1_other_case(person.group)
    var bias = c1_other_preconception(id)
    var options = spec.reason_options
    var ordered = []
    var i = 0
    if (not (bias == false)):
        rt_push(ordered, bias.preferred)
    while (i < rt_count(options)):
        if (not dv_has(ordered, options[i])):
            rt_push(ordered, options[i])
        i = (i + 1)
    var result = []
    i = 0
    while (i < rt_count(ordered)):
        var option = ordered[i]
        var basis = dv_single(spec.source)
        if (not (bias == false)):
            if (bias.preferred == option):
                basis = bias.basis
        var proposition = campaign_case_claim(person.group, rt_cat("reason.", option))
        rt_push(result, {"id": rt_cat(rt_cat(person.group, ".reason."), option), "question": rt_cat(person.group, ".reason"), "group": rt_cat(person.group, ".reason"), "proposition": proposition, "assumptions": dv_single(proposition), "prior": 0.5, "available_when": campaign_case_claim(person.group, rt_cat("receipt.", id)), "basis": basis, "interpretation_scope": "motive-separate-from-accepted-literal-actor", "source_preconception": bias})
        i = (i + 1)
    return result

fn c1_other_mind(id):
    var person = c1_other_person(id)
    var spec = c1_other_case(person.group)
    var mind = dv_with(dv_world(rt_cat("mind.", id), "mind", id), "time", 480)
    mind = dv_add_object(mind, c1_position(id, spec.room))
    mind = dv_store(mind, dv_ref(id, "identity", "name"), dv_with(dv_field(person.name), "basis", [person.initial_source]))
    mind = dv_add_object(mind, campaign_local_object(rt_cat("case.", person.group)))
    var people = c1_other_people()
    var peer_index = 0
    while (peer_index < rt_count(people)):
        if (people[peer_index].group == person.group):
            mind = dv_add_object(mind, campaign_local_object(rt_cat("personal.", people[peer_index].id)))
            if people[peer_index].id != id:
                mind = dv_add_object(mind, campaign_local_object(people[peer_index].id))
        peer_index = (peer_index + 1)
    mind = dv_add_object(mind, campaign_state_object("memory", dv_single(dv_pair("empty_school_recall", dv_with(dv_field(true), "basis", dv_single(person.memory_source))))))
    mind = dv_store(mind, dv_ref(rt_cat("personal.", id), "state", "initial_surface"), dv_with(dv_field(person.initial_surface), "basis", dv_single(person.initial_source)))
    return mind

fn c1_other_policy(id):
    var person = c1_other_person(id)
    var spec = c1_other_case(person.group)
    var goals = []
    var i = 0
    while (i < rt_count(spec.options)) and id == c1_other_reporter(person.group):
        rt_push(goals, {"kind": "know", "question": rt_cat(person.group, ".identity"), "ref": campaign_case_ref(person.group, rt_cat("answer.", spec.options[i])), "available_when": campaign_case_claim(person.group, "open"), "basis": dv_single(spec.source)})
        i = (i + 1)
    if id == c1_other_reporter(person.group):
        rt_push(goals, campaign_goal(campaign_case_claim(person.group, rt_cat("receipt.", id)), campaign_case_claim(person.group, "open"), [spec.source]))
    // Private keepsakes remain inspectable without giving every offscreen
    // resident the same compulsory self-inspection task at the same instant.
    if id == "lucian":
        rt_push(goals, campaign_observation_goal(dv_ref("quer", "state", "location"), campaign_case_claim("contract", "outer_latch_released"), [spec.source], 0))
    var hypotheses = c1_other_exclusion_hypotheses(id)
    var reasons = c1_other_reason_hypotheses(id)
    i = 0
    while (i < rt_count(reasons)):
        rt_push(hypotheses, reasons[i])
        i = (i + 1)
    return dv_with_many(c1_player_policy(), {"hypotheses": hypotheses, "goals": goals, "desire": {"surface": person.desire, "basis": dv_single(person.desire_source), "fulfillment": "not-asserted"}, "notice_co_presence": true, "topic_bindings": dv_pair({"topic": "own_material", "heard_when": dv_true(), "completed_when": dv_not(dv_true()), "basis": dv_single(person.material_source)}, {"topic": rt_cat(person.group, ".reason"), "heard_when": campaign_case_claim(person.group, rt_cat("receipt.", id)), "completed_when": dv_not(dv_true()), "basis": dv_single(spec.source)})})

fn c1_other_character(id):
    var person = c1_other_person(id)
    var actions = c1_other_inspections(id)
    var answers = c1_other_answer_actions(id)
    var i = 0
    while (i < rt_count(answers)):
        rt_push(actions, answers[i])
        i = (i + 1)
    var replies = c1_other_personal_replies(id)
    i = 0
    while (i < rt_count(replies)):
        rt_push(actions, replies[i])
        i = (i + 1)
    return {"id": id, "mind": c1_other_mind(id), "actions": actions, "policy": c1_other_policy(id), "balance": {"time": 100000, "computation": 100000, "stamina": 100000}, "location_ref": dv_ref(id, "state", "location"), "location": c1_other_case(person.group).room, "question_ref": dv_ref(rt_cat("personal.", id), "state", "current"), "dossier": person}

fn c1_other_groups_actors():
    var result = []
    var people = c1_other_people()
    var i = 0
    while (i < rt_count(people)):
        rt_push(result, c1_other_character(people[i].id))
        i = (i + 1)
    return result

// Real physical authored traces and literal history; invisible answer fields are never grants.
fn c1_other_group_extend(world, group):
    var spec = c1_other_case(group)
    var fields = {"open": dv_field(false), "current": dv_field(""), "outer_latch_released": dv_field(false), "formal_release": dv_field(false)}
    var i = 0
    while (i < rt_count(spec.options)):
        fields = dv_with(fields, rt_cat("answer.", spec.options[i]), dv_field((spec.options[i] == spec.authority_actor)))
        i = (i + 1)
    i = 0
    while (i < rt_count(spec.reason_options)):
        fields = dv_with(fields, rt_cat("reason.", spec.reason_options[i]), dv_field((spec.reason_options[i] == spec.authority_reason)))
        i = (i + 1)
    var traces = c1_other_traces(group)
    i = 0
    while (i < rt_count(traces)):
        fields = dv_with(fields, rt_cat("trace.", traces[i].id), dv_field(true))
        i = (i + 1)
    var people = c1_other_people()
    i = 0
    var result = world
    while (i < rt_count(people)):
        var person = people[i]
        if (person.group == group):
            fields = dv_with(fields, rt_cat("receipt.", person.id), dv_field(false))
            fields = dv_with(fields, rt_cat("level.", person.id), dv_field(0))
            result = dv_add_object(result, c1_position(person.id, spec.room))
            result = dv_store(result, dv_ref(person.id, "identity", "name"), dv_with(dv_field(person.name), "basis", [person.initial_source]))
            result = dv_add_object(result, campaign_state_object(rt_cat("personal.", person.id), {"material_detail": dv_field(person.material_surface), "current": dv_field("")}))
            result = dv_adopt(result, campaign_method(rt_cat(rt_cat("other.accept.", group), rt_cat(".", person.id)), c1_other_accept(group, person.id)), "enforce", 1, dv_single(spec.source))
        i = (i + 1)
    result = dv_add_object(result, campaign_state_object(rt_cat("case.", group), fields))
    result = dv_adopt(result, campaign_method(rt_cat("other.open.", group), c1_other_question_open(group)), "enforce", 1, dv_single(spec.source))
    return c1_other_activity_physical(result, group)

fn c1_other_groups_physical(world):
    return c1_other_group_extend(c1_other_group_extend(c1_other_group_extend(world, "contract"), "astral"), "logistics")

fn c1_other_groups_bindings():
    var people = c1_other_people()
    var result = []
    var i = 0
    while (i < rt_count(people)):
        var person = people[i]
        rt_push(result, dv_binding(person.id, person.id, person.id))
        rt_push(result, dv_binding(rt_cat("case.", person.group), rt_cat("case.", person.group), person.id))
        var j = 0
        while (j < rt_count(people)):
            if (people[j].group == person.group):
                rt_push(result, dv_binding(rt_cat("personal.", people[j].id), rt_cat("personal.", people[j].id), person.id))
                if people[j].id != person.id:
                    rt_push(result, dv_binding(people[j].id, people[j].id, person.id))
            j = (j + 1)
        i = (i + 1)
    return result

fn c1_other_groups_question_actions(speaker):
    return dv_list3(c1_other_open_action("contract", speaker), c1_other_open_action("astral", speaker), c1_other_open_action("logistics", speaker))

fn c1_other_groups_release_laws(clock_ref):
    return dv_list3(c1_other_release("contract", clock_ref), c1_other_release("astral", clock_ref), c1_other_release("logistics", clock_ref))

// Personal reports quote the actor's own inspected material. They do not turn a
// handwritten page, lamp oil or familiar knot into a recovered night's memory.
fn c1_other_personal_replies(id):
    var person = c1_other_person(id)
    var ref = dv_ref(rt_cat("personal.", id), "state", "material_detail")
    var known = dv_fact(ref, person.material_surface)
    var people = c1_other_people()
    var result = []
    var i = 0
    while (i < rt_count(people)):
        var other = people[i]
        if dv_and((other.group == person.group), (not (other.id == id))):
            var action = campaign_intent_action(rt_cat(rt_cat(id, ".reply.own-material."), other.id), "talk", known, campaign_at(id, c1_other_case(person.group).room), "", [], "说明本人查看的随身物件", person.material_source)
            var speech = dv_with(c1_speech(known, person.material_source, "personally-inspected-material-not-night-witness"), "surface", person.material_surface)
            rt_push(result, dv_with_many(action, {"speech": speech, "listeners": dv_single(other.id), "response_topic": rt_cat("own_material.", id), "requires_actual_request": true}))
        i = (i + 1)
    return result

fn c1_other_release_action(group, speaker, clock_ref):
    var law = c1_other_release(group, clock_ref)
    var surface = "从起居厅一侧抬起寝区外闩，正式宣告放行。"
    if group == "contract":
        surface = "代管者复核已被挑开的甲区门闩，正式宣告沃德等人可以离开。"
    let action = campaign_intent_action(rt_cat("other.release.", group), "help", law.premise, law.premise, rt_cat("other.release.", group), [campaign_case_ref(group, "outer_latch_released"), campaign_case_ref(group, "formal_release"), c1_other_access_ref(group), dv_ref("demon.body", "state", "manifested")], rt_cat("释放", rt_cat(c1_other_case(group).zone, "外闩")), c1_other_case(group).source)
    return dv_with_many(action, {"surface": surface, "predict_law": rt_cat("other.release.", group), "speech": dv_with_many(c1_speech(dv_true(), c1_other_case(group).source, "actual-formal-release"), {"surface": surface, "channel": rt_cat("copper.", group)}), "listeners": c1_other_group_listeners(group, ""), "public_grants": [campaign_case_ref(group, "outer_latch_released"), campaign_case_ref(group, "formal_release"), c1_other_access_ref(group), campaign_clock()]})

fn c1_other_departure_source(id):
    if (id == "lucian"):
        return {"target": "Living", "surface": "在起居厅听见乙区门里有人说话，靠在对面墙上等着", "source": campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 8, "lucian.departure"), "source_duration": 12}
    if (id == "gu"):
        return {"target": "Living", "surface": "在起居厅北台的书架前，把认得的书脊一行行抄下来", "source": campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 11, "gu.departure"), "source_duration": 12}
    if (id == "quer"):
        return {"target": "Living", "surface": "蹲在乙区门外看那道外闩，只看不碰", "source": campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 14, "quer.departure"), "source_duration": 12}
    if (id == "ward"):
        return {"target": "Living", "surface": "在起居厅公告板张贴《私取者戒》，把未经公开授权的私藏定为窃取", "source": campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 17, "ward.departure"), "source_duration": 12}
    if (id == "selma"):
        return {"target": "Greenhouse", "surface": "离开丙区到温室查看标本，把寝区观察与新环境分开记", "source": campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 20, "selma.departure"), "source_duration": 12}
    if (id == "ruan"):
        return {"target": "Hall", "surface": "到中央厅收起棋子，核对自己能确认的物品数目", "source": campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 23, "ruan.departure"), "source_duration": 12}
    if (id == "elena"):
        return {"target": "Hall", "surface": "离开丙区后在中央厅坐下，避开伤脚久站", "source": campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 26, "elena.departure"), "source_duration": 12}
    if (id == "moran"):
        return {"target": "Hall", "surface": "到中央厅观察窗光，翻看刚才画出的色层", "source": campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 29, "moran.departure"), "source_duration": 12}
    if (id == "veronica"):
        return {"target": "Logistics", "surface": "离开丁区到后勤院查看公用器具，暂不取用未知试剂", "source": campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 32, "veronica.departure"), "source_duration": 12}
    if (id == "bertrand"):
        return {"target": "Hall", "surface": "从丁区出来巡看中央厅的通路，给后来的人留出门口", "source": campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 35, "bertrand.departure"), "source_duration": 12}
    if (id == "margaret"):
        return {"target": "Hall", "surface": "走到中央厅把真正看见的门外尺寸补进草图", "source": campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 38, "margaret.departure"), "source_duration": 12}
    if (id == "mora"):
        return {"target": "Clinic", "surface": "离开丁区到诊疗所清点可用敷料，预备有人求助", "source": campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/出区日常.story", 41, "mora.departure"), "source_duration": 12}
    dv_require(false, "Unknown chapter-one departure actor")
    return false

// Source-directed departure remains optional and requires actual opened-latch observation.
// The caller installs this law in physical/enforce and this person's mind/predict.
axiom c1_other_depart(id):
    var person = c1_other_person(id)
    var source = c1_other_departure_source(id)
    var premise = dv_all(dv_list3(campaign_at(id, c1_other_case(person.group).room), campaign_case_claim(person.group, "outer_latch_released"), dv_fact(c1_other_access_ref(person.group), true)))
    if id == "ward" or id == "gu":
        premise = dv_all([premise, campaign_case_claim("contract", "formal_release")])
    if id != "quer" and id != "lucian" and id != "ward" and id != "gu":
        premise = dv_all([premise, campaign_case_claim(person.group, "formal_release")])
    if id == "lucian":
        premise = dv_all([premise, campaign_any(campaign_at("quer", "threshold.contract"), campaign_at("quer", "living_hall"))])
    return dv_axiom(rt_cat("c1_other_depart.", id), 1, premise, dv_single(dv_assign(dv_ref(id, "state", "location"), c1_other_threshold(person.group))))

fn c1_other_departure_actions(id):
    var person = c1_other_person(id)
    var room = c1_other_case(person.group).room
    var source = c1_other_departure_source(id)
    var ref = campaign_case_ref(person.group, "outer_latch_released")
    var inspect = dv_with_many(campaign_intent_action(rt_cat(id, ".inspect.outer-latch"), "inspect", campaign_at(id, room), campaign_at(id, room), "", dv_pair(ref, c1_other_access_ref(person.group)), "检视寝区外闩", source.source), {"repeatable": true, "manual_only": true, "label": "检视寝区外闩"})
    var premise = c1_other_depart(id).premise
    var depart = dv_with_many(campaign_intent_action(rt_cat(id, ".leave-dormitory"), "move", premise, premise, rt_cat("other.depart.", id), dv_single(dv_ref(id, "state", "location")), "离开寝区", source.source), {"predict_law": rt_cat("other.depart.", id), "surface": dvs_surface_parts([c1_other_person(id).name, "离开寝区。"]), "next_observation_surface": "跨过门槛，来到本寝区的门外。", "later_intention_surface": source.surface, "travel": {"from": room, "to": c1_other_threshold(person.group), "gate": person.group}})
    if id == "quer":
        depart = dv_with_many(depart, {"public_observers": ["lucian", "ward", "gu"], "public_grants": [dv_ref("quer", "state", "location")]})
    depart = dv_with(depart, "personal_choice", {"group": "leave-open-dormitory", "requires": premise, "prohibits": dv_not(dv_true()), "promotes": ["leave_confinement"], "sacrifices": [], "basis": dv_single(person.initial_source)})
    return dv_pair(inspect, depart)

fn c1_other_groups_costs():
    var costs = c1_costs()
    rt_push(costs, dv_pair("other_departure", c1_cost(12, c1_other_departure_source("quer").source)))
    return costs

fn c1_other_group_listeners(group, except):
    var result = []
    var people = c1_other_people()
    var i = 0
    while i < rt_count(people):
        let person = people[i]
        if dv_and(person.group == group, person.id != except):
            rt_push(result, person.id)
        i = i + 1
    return result

fn c1_other_wake_action(id):
    let person = c1_other_person(id)
    let room = c1_other_case(person.group).room
    let literal = dv_all([dv_fact(dv_ref(rt_cat("personal.", id), "state", "initial_surface"), person.initial_surface), dv_fact(dv_ref(id, "identity", "name"), person.name)])
    let action = c1_once(campaign_intent_action(rt_cat(id, ".wake-and-introduce"), "talk", dv_all(dv_pair(campaign_at(id, room), literal)), campaign_at(id, room), "", [], "向同伴自我介绍", person.initial_source))
    let text = dvs_surface_parts([person.initial_surface, "\n", c1_other_introduction(id)])
    return dv_with_many(action, {"label": "回应姓名询问", "speech": dv_with(c1_speech(literal, person.initial_source, "own-current-perception"), "surface", text), "listeners": c1_other_group_listeners(person.group, id), "surface": "", "response_topic": "personal-introduction", "requires_actual_request": true})

fn c1_other_trace_conversations(id):
    let person = c1_other_person(id)
    let spec = c1_other_case(person.group)
    let peers = c1_other_group_listeners(person.group, id)
    let traces = c1_other_traces(person.group)
    var result = []
    var i = 0
    while i < rt_count(peers):
        let peer = peers[i]
        var j = 0
        while j < rt_count(traces):
            let trace = traces[j]
            let topic = rt_cat(rt_cat(person.group, ".trace."), trace.id)
            let ref = campaign_case_ref(person.group, rt_cat("trace.", trace.id))
            let literal = dv_fact(ref, true)
            let prefix = rt_cat(rt_cat(id, ".material."), rt_cat(peer, rt_cat(".", trace.id)))
            let request = dv_with_many(c1_speech(dv_true(), trace.source, "request-personal-observation"), {"surface": dvs_surface_parts(["你查看过", trace.title, "吗？把你看到的告诉我。"]), "utterance_type": "question", "request": {"target": peer, "topic": topic}})
            rt_push(result, dv_with_many(campaign_intent_action(rt_cat(prefix, ".ask"), "talk", campaign_at(id, spec.room), campaign_at(id, spec.room), "", [], rt_cat("问同伴：", trace.title), trace.source), {"label": rt_cat("问同伴：", trace.title), "label_parts": [{"text": "问"}, {"ref": dv_ref(peer, "identity", "name"), "fallback": "同伴"}, {"text": rt_cat("：", trace.title)}], "speech": request, "listeners": dv_single(peer), "purpose_refs": dv_single(ref)}))
            let report = dv_with(c1_speech(literal, trace.source, "personally-observed-trace-not-night-witness"), "surface", trace.surface)
            rt_push(result, dv_with_many(campaign_intent_action(rt_cat(prefix, ".report"), "talk", dv_all(dv_pair(campaign_at(id, spec.room), literal)), campaign_at(id, spec.room), "", [], rt_cat("告知同伴：", trace.title), trace.source), {"label": rt_cat("告知同伴：", trace.title), "label_parts": [{"text": "告知"}, {"ref": dv_ref(peer, "identity", "name"), "fallback": "同伴"}, {"text": rt_cat("：", trace.title)}], "speech": report, "listeners": dv_single(peer), "offer_to": peer, "response_topic": topic, "purpose_refs": dv_single(ref)}))
            j = j + 1
        i = i + 1
    return result

fn c1_other_desire_action(id):
    let person = c1_other_person(id)
    let room = c1_other_case(person.group).room
    let ref = dv_ref(rt_cat("personal.", id), "state", "material_detail")
    let action = c1_once(campaign_intent_action(rt_cat(id, ".follow-own-interest"), "inspect", campaign_at(id, room), campaign_at(id, room), "", dv_single(ref), rt_cat("进一步", person.material_label), person.material_source))
    return dv_with_many(action, {"label": rt_cat("进一步", person.material_label), "surface": dvs_surface_parts([person.intention_surface, "\n", person.material_surface]), "purpose_refs": dv_single(ref), "motive_basis": dv_single(person.desire_source)})

// Install the actual residents, their private rules and objects, copper channels,
// scoped formal questions, and answer transitions. Release/departure needs the
// campaign's real clock and access graph; this constructor never advances either.
fn c1_other_groups_install_scene(scene):
    var world = c1_other_groups_physical(scene.physical)
    let release_laws = c1_other_groups_release_laws(campaign_clock())
    var release_index = 0
    while release_index < rt_count(release_laws):
        let group = ["contract", "astral", "logistics"][release_index]
        world = dv_adopt(world, campaign_method(rt_cat("other.release.", group), release_laws[release_index]), "enforce", 1, dv_single(c1_other_case(group).source))
        release_index = release_index + 1
    var actors = dv_clone(scene.actors)
    var bindings = dv_clone(scene.bindings)
    var answers = dv_clone(scene.formal_answers)
    let people = c1_other_people()
    var i = 0
    while i < rt_count(people):
        let person = people[i]
        let object = rt_cat("personal.", person.id)
        world = dv_store(world, dv_ref(object, "state", "initial_surface"), dv_field(person.initial_surface))
        var actor = c1_other_activity_actor(c1_other_character(person.id), person.group)
        let depart_method = campaign_method(rt_cat("other.depart.", person.id), c1_other_depart(person.id))
        world = dv_adopt(world, depart_method, "enforce", 1, dv_single(person.initial_source))
        var own_mind = dv_add_object(actor.mind, campaign_local_object("campaign.access"))
        own_mind = dv_adopt(own_mind, depart_method, "predict", 1, dv_single(person.initial_source))
        actor = dv_with_many(actor, {"mind": own_mind, "policy": dv_with_many(actor.policy, {"value_order": ["leave_confinement", "pursue_desire"], "value_basis": dv_single(person.initial_source)})})
        rt_push(bindings, dv_binding("campaign.access", "campaign.access", person.id))
        rt_push(bindings, dv_binding("campaign.clock", "campaign.clock", person.id))
        var actions = []
        rt_push(actions, c1_other_wake_action(person.id))
        rt_push(actions, c1_other_desire_action(person.id))
        var j = 0
        while j < rt_count(actor.actions):
            if actor.actions[j].id != rt_cat(person.id, ".inspect.own-material"):
                rt_push(actions, actor.actions[j])
            j = j + 1
        let departure_actions = c1_other_departure_actions(person.id)
        j = 0
        while j < rt_count(departure_actions):
            rt_push(actions, departure_actions[j])
            j = j + 1
        rt_push(actions, c1_other_handoff_action(person.id))
        let conversations = c1_other_trace_conversations(person.id)
        j = 0
        while j < rt_count(conversations):
            rt_push(actions, conversations[j])
            j = j + 1
        let channel = rt_cat("copper.", person.group)
        let ready = campaign_at(person.id, c1_other_case(person.group).room)
        actor = dv_with_many(actor, {"actions": actions, "hearing_grants": [{"speaker": "demon", "channel": channel, "available_when": ready, "sender_locations": ["living_hall"], "listener_locations": [c1_other_case(person.group).room], "basis": [c1_other_case(person.group).source]}], "request_channels": [{"target": "demon", "channel": channel, "available_when": ready, "basis": [c1_other_case(person.group).source]}]})
        rt_push(actors, actor)
        i = i + 1
    let local_bindings = c1_other_groups_bindings()
    i = 0
    while i < rt_count(local_bindings):
        rt_push(bindings, local_bindings[i])
        i = i + 1
    let formal = c1_other_formal_answers()
    i = 0
    while i < rt_count(formal):
        rt_push(answers, formal[i])
        i = i + 1
    var installed_actors = []
    i = 0
    while i < rt_count(actors):
        if actors[i].id == "demon":
            var demon = actors[i]
            var mind = demon.mind
            var actions = dv_clone(demon.actions)
            var hearing = dv_clone(dv_find(demon, "hearing_grants", []))
            var g = 0
            let groups = ["contract", "astral", "logistics"]
            while g < rt_count(groups):
                let group = groups[g]
                let spec = c1_other_case(group)
                mind = dv_add_object(mind, campaign_state_object(rt_cat("case.", group), {"open": dv_field(false)}))
                mind = dv_adopt(mind, campaign_method(rt_cat("other.open.", group), c1_other_question_open(group)), "predict", 1, dv_single(spec.source))
                rt_push(bindings, dv_binding(rt_cat("case.", group), rt_cat("case.", group), "demon"))
                let listeners = c1_other_group_listeners(group, "")
                var k = 0
                while k < rt_count(listeners):
                    rt_push(hearing, {"speaker": listeners[k], "channel": rt_cat("copper.", group), "available_when": campaign_at("demon", "living_hall"), "sender_locations": [spec.room], "listener_locations": ["living_hall"], "basis": [spec.source]})
                    rt_push(hearing, {"speaker": listeners[k], "channel": "formal-receipt", "available_when": campaign_at("demon", "living_hall"), "sender_locations": [spec.room], "listener_locations": ["living_hall"], "basis": [spec.source]})
                    mind = dv_add_object(mind, campaign_local_object(rt_cat("personal.", listeners[k])))
                    k = k + 1
                rt_push(actions, c1_other_open_action(group, "demon"))
                g = g + 1
            rt_push(installed_actors, dv_with_many(demon, {"mind": mind, "actions": actions, "hearing_grants": hearing}))
        else:
            rt_push(installed_actors, actors[i])
        i = i + 1
    return dv_with_many(scene, {"physical": world, "actors": installed_actors, "bindings": bindings, "formal_answers": answers, "cost_model": dv_append(scene.cost_model, dv_pair("other_departure", c1_cost(2, campaign_source("godot_csharp/scenes/Awakening/Script/story/剧情时长.story", 37, "走动：2"))))})

fn c1_other_introduction(id):
    if id == "quer":
        叙述：
            叫我雀儿就行。别站门前——让我看一眼那道闩。
    if id == "lucian":
        叙述：
            卢西安。名字还记得，半句诗也还记得；偏偏缺了我们怎么到这儿来的那一段。
    if id == "ward":
        叙述：
            沃德。先说姓名，再说各自记得的最后一件事。不要混在一起。
    if id == "gu":
        叙述：
            顾平章。容老朽擦擦眼镜。纸上的东西还在，人却想不起来，真是怪事。
    if id == "ruan":
        叙述：
            阮清月。那盘棋先别碰。我们还不知道谁摆的，也不知道轮到谁。
    if id == "elena":
        叙述：
            伊莲娜。别拉我起来……脚踝疼。你们谁知道这里是什么地方？
    if id == "selma":
        叙述：
            赛尔玛。请别动窗台上的苗。我得先弄清楚本子上哪些是我记的。
    if id == "moran":
        叙述：
            莫兰。等一等，那层绿马上要散了。你们说，我听着。
    if id == "mora":
        叙述：
            茉拉。刚才谁在咳嗽？先让我看看，再说别的。
    if id == "bertrand":
        叙述：
            贝尔特朗。门外有动静。先别挤过去，给彼此留条退路。
    if id == "veronica":
        叙述：
            维罗妮卡。谁动过这排器具？不知道也直说，别替别人猜。
    叙述：
        玛格丽特。先别都靠那面墙。这根梁的搭法，我得再看一遍。

fn c1_other_access_ref(group):
    return dv_ref("campaign.access", "state", group)

fn c1_other_threshold(group):
    return rt_cat("threshold.", group)

fn c1_other_handoff_text(id):
    if id == "ward":
        叙述：
            开锁的人已经核对了。出去以后，那把钥匙的来路还得写清楚。
    if id == "quer":
        叙述：
            我答了。你还要把我堵在这儿？门开了，让开一点。
    if id == "lucian":
        叙述：
            名字答对了，缘由还空着呢。沃德，留一行空白总比填错强。
    if id == "gu":
        叙述：
            门开了。先莫争，外面若有文书，读过再说。
    if id == "elena":
        叙述：
            我慢一点。阮清月……出去以后，你也别先走。
    if id == "ruan":
        叙述：
            我在这儿。你先扶住门框，等站稳了再迈那一步。
    if id == "selma":
        叙述：
            我的本子带上了。门内查到的，跟出去以后查到的，分开记。
    if id == "moran":
        叙述：
            外面的光不一样。等我站到门边再画，别挡着伊莲娜。
    if id == "mora":
        叙述：
            人先出去。试剂的事还没说清；有谁不舒服，别瞒着。
    if id == "veronica":
        叙述：
            取走一瓶东西和拿它做了什么，是两件事。先把原瓶找到。
    if id == "bertrand":
        叙述：
            我站门边。一个一个过去，先看落脚的地方。
    叙述：
        门框没歪。慢慢过，别拿身体去撞那道闩。

fn c1_other_handoff_action(id):
    let person = c1_other_person(id)
    let receipt = campaign_case_claim(person.group, rt_cat("receipt.", id))
    let ready = dv_all(dv_pair(campaign_at(id, c1_other_threshold(person.group)), receipt))
    let text = c1_other_handoff_text(id)
    return dv_with_many(c1_once(campaign_intent_action(rt_cat(id, ".doorway-handoff"), "talk", ready, campaign_at(id, c1_other_threshold(person.group)), "", [], "说明答复收据与下一步打算", person.initial_source)), {"speech": dv_with(c1_speech(receipt, person.initial_source, "own-answer-receipt-and-next-intention"), "surface", text), "listeners": c1_other_group_listeners(person.group, id), "surface": text})


// Each flag below is produced by a real Complete, then observed by the actor.
fn c1_other_report_time(group):
    if group == "contract":
        return 840
    if group == "astral":
        return 1065
    return 1100

fn c1_other_report_surface(group):
    if group == "contract":
        叙述：
            ；藏处是壁炉砖槽；未经公开授权，背着同行私藏。我将此定为窃取。
    if group == "astral":
        叙述：
            ；她单方面止损，为保住多数而拉闸封门。
    叙述：
        ；她未经医嘱，进行了激进的酸试验。

fn c1_other_submission(group, option):
    return dv_all([c1_other_identity(group, option), c1_other_material_identity(group, option), campaign_case_claim(group, "evidence_complete"), campaign_case_claim(group, "report_basis")])

// Unordered opportunities over personally acquired material. No row names a
// predecessor or a target performance time; the chooser owns every next act.
fn c1_other_material_ref(group, field):
    return campaign_case_ref(group, rt_cat("material.", field))

fn c1_other_material(group, field, value):
    return dv_fact(c1_other_material_ref(group, field), value)

fn c1_other_initial_material(group):
    if group == "contract":
        return {"sleeve_wax": "quer", "ash_path": "fireplace-brick", "key_holder": "quer", "scrap_initials": "J.C.", "scrap_instruction": "open-and-remove-privately", "signed_public_order": false, "tube_place": "fireplace-brick", "tube_title": "underground-service-plan", "seal_intact": true}
    if group == "astral":
        return {"injured_person": "elena", "ankle_swollen": true, "moran_distressed": true, "half_sketch": "hand-behind-lowered-gate", "admitted_operator": "", "stated_calculation": "", "support_received": false, "support_active": false, "west_air_clear": false, "ventilation_functional": true, "west_gas": "residual", "palm_bronze_residue": true, "grip_pressure": "downward-pull", "abrasion_form": "gate-handle"}
    return {"injured_person": "bertrand", "fever": true, "acid_blisters": true, "physician_permission": false, "reported_taker": "", "reported_reagent": "", "overnight_stable": false, "wound_stable": false, "evening_checked": false, "care_active": false, "bottle_label": "R-07", "working_glove_acid_residue": true, "cabinet_key_in_kit": true}

fn c1_other_reporter(group):
    if group == "contract":
        return "ward"
    if group == "astral":
        return "selma"
    return "mora"

fn c1_other_material_identity(group, option):
    if group == "contract":
        var initials = ""
        if option == "quer":
            initials = "J.C."
        return dv_all([c1_other_material(group, "key_holder", option), c1_other_material(group, "scrap_initials", initials), c1_other_material(group, "scrap_instruction", "open-and-remove-privately"), c1_other_material(group, "tube_place", "fireplace-brick"), c1_other_material(group, "tube_title", "underground-service-plan")])
    if group == "astral":
        return dv_all([c1_other_material(group, "admitted_operator", option), c1_other_material(group, "half_sketch", "hand-behind-lowered-gate"), c1_other_material(group, "stated_calculation", "preserve-three")])
    return dv_all([c1_other_material(group, "reported_taker", option), c1_other_material(group, "reported_reagent", "R-07"), c1_other_material(group, "acid_blisters", true), c1_other_material(group, "physician_permission", false)])

fn c1_other_activity_rows(group):
    let key = ["c1-other-conditional-activities-v2", group]
    let cached = rt_memo_get([], key)
    if cached[0]:
        return cached[1]
    return rt_memo_put([], key, c1_other_activity_declarations(group))

fn c1_other_activity_declarations(group):
    let opened = campaign_case_claim(group, "open")
    if group == "contract":
        return [
            {"id": "wax_ash_seen", "actor": "ward", "when": opened, "kind": "inspect", "materials": ["sleeve_wax", "ash_path"], "label": "查看衣袖与壁炉前的煤灰", "text": "雀儿袖口粘着火漆屑。煤灰中的足印朝壁炉砖槽延伸。"},
            {"id": "keys_found", "actor": "ward", "when": dv_all([opened, c1_other_material(group, "sleeve_wax", "quer")]), "present": ["quer"], "kind": "inspect", "materials": ["key_holder", "scrap_initials", "scrap_instruction", "signed_public_order"], "label": "搜查钥匙与文书", "text": "沃德从雀儿衣袋中搜出钥匙和半角红墨残纸，照着残字念道：‘……交由 J.C. 开启内柜，取走……切勿令外人知晓。’"},
            {"id": "evidence_complete", "actor": "gu", "when": dv_all([opened, c1_other_material(group, "ash_path", "fireplace-brick")]), "kind": "inspect", "materials": ["tube_place", "tube_title", "seal_intact"], "label": "沿煤灰足印查找壁炉砖槽", "text": "顾平章从壁炉砖槽取出一只蜡布筒。火漆封口完整，筒上写着《地下勤务环廊管网总图》。"},
            {"id": "quer_insulted", "actor": "ward", "when": dv_all([opened, c1_other_material(group, "key_holder", "quer"), c1_other_material(group, "scrap_instruction", "open-and-remove-privately")]), "present": ["quer"], "kind": "talk", "materials": [], "label": "质问私下开柜取图的缘由", "text": "沃德把钥匙与残纸按在桌上：‘纸片无公章、无署名，又叫你背着我们三人行动。趁乱开柜藏图，还要如何狡辩？’"},
            {"id": "refuse_explanation", "actor": "quer", "when": campaign_case_claim(group, "quer_insulted"), "kind": "talk", "materials": [], "label": "拒绝搜查者的盘问", "text": "雀儿冷笑着抱起双臂：‘搜也搜了，还要我认什么？’"},
            {"id": "object_to_search", "actor": "lucian", "when": campaign_case_claim(group, "quer_insulted"), "present": ["ward", "quer"], "kind": "talk", "materials": [], "label": "制止对同伴的逼问", "text": "卢西安走到雀儿身旁：‘半张纸就能给人定罪？你这套官样文章，留着吓唬墙上的灰吧！’"},
            {"id": "report_basis", "actor": "ward", "when": c1_other_material_identity(group, "quer"), "kind": "talk", "materials": [], "label": "核对开柜、藏处与公开授权", "text": "沃德把钥匙、半角残纸和蜡布筒排在桌上：‘开柜者、藏处，都已对应。既无正式公文，我仍按私自藏匿记。’"}
        ]
    if group == "astral":
        return [
            {"id": "assess_injury", "actor": "selma", "when": opened, "present": ["elena", "moran"], "kind": "inspect", "materials": ["injured_person", "ankle_swollen", "moran_distressed"], "label": "查看伤踝与同伴的状况", "text": "伊莲娜左踝肿胀，稍一挪动就吸气。莫兰抱紧画夹，手指发颤。"},
            {"id": "care_given", "actor": "selma", "when": c1_other_material(group, "ankle_swollen", true), "present": ["elena"], "kind": "help", "materials": [], "label": "固定伤踝并送水", "text": "赛尔玛重新固定伊莲娜的绷带，把水递到她手边。"},
            {"id": "inspect_own_gate_traces", "actor": "ruan", "when": opened, "kind": "inspect", "materials": ["palm_bronze_residue", "grip_pressure", "abrasion_form"], "label": "查看手掌与袖口的铜屑和压痕", "text": "阮清月摊开手掌，擦出一点铜绿色的粉屑。掌根的压痕朝下延伸，擦伤的弧度像一道粗闸柄。她把手指蜷起，重新比了一遍受力方向。"},
            {"id": "ruan_admitted", "actor": "ruan", "when": dv_all([opened, c1_other_material(group, "own_latch_inference", "ruan")]), "kind": "talk", "materials": ["admitted_operator", "stated_calculation"], "effects": [dv_assign(c1_other_material_ref(group, "admitted_operator"), "ruan"), dv_assign(c1_other_material_ref(group, "stated_calculation"), "preserve-three")], "label": "说明自己对落闸的判断", "text": "阮清月平静地说：‘是我拉的闸。当时毒气外溢，关门弃一保三是目数上的最优解，无需抵赖。’"},
            {"id": "support_given", "actor": "selma", "when": dv_all([campaign_case_claim(group, "care_given"), c1_other_material(group, "moran_distressed", true)]), "present": ["moran"], "kind": "talk", "materials": ["support_received", "support_active"], "effects": [dv_assign(c1_other_material_ref(group, "support_received"), true), dv_assign(c1_other_material_ref(group, "support_active"), true)], "label": "开始陪伴失神的同伴", "text": "赛尔玛在莫兰旁边坐下，把水递过去：‘我在这里。愿意的时候，就指给我看。’她开始陪着他辨认画稿上的明暗。"},
            {"id": "evidence_complete", "actor": "moran", "when": c1_other_material(group, "support_received", true), "present": ["selma"], "kind": "help", "materials": ["half_sketch", "support_active"], "effects": [dv_assign(c1_other_material_ref(group, "support_active"), false)], "label": "把表层草图交给同伴看", "text": "莫兰松开画夹，把表层草图转向赛尔玛。铜闸已落下，门内伸出一只手，纸边截去了手腕下方。"},
            {"id": "report_basis", "actor": "selma", "when": c1_other_material_identity(group, "ruan"), "kind": "talk", "materials": [], "label": "对照拉闸自述与表层草图", "text": "赛尔玛把阮清月的原话记在半截草图旁：‘门里还有人在伸手，你便为了外面的人拉了闸……’"},
            {"id": "west_passage_checked", "actor": "selma", "when": dv_all([campaign_case_claim(group, "care_given"), dv_at_least(campaign_clock(), 1890)]), "kind": "inspect", "physical_requires": dv_all([c1_other_material(group, "west_gas", "below-safety-mark"), c1_other_material(group, "ventilation_functional", true)]), "materials": ["west_gas", "ventilation_functional", "west_air_clear"], "effects": [dv_assign(c1_other_material_ref(group, "west_air_clear"), true)], "label": "晨间检查西夹道源质计", "text": "赛尔玛贴近门边的源质计，核对刻度；指针落在安全线以下，通风口仍有气流。她把读数报给铜口，随后重新查看伊莲娜的绷带。"}
        ]
    return [
        {"id": "assess_injury", "actor": "mora", "when": opened, "present": ["bertrand"], "kind": "inspect", "materials": ["injured_person", "fever"], "label": "查看发热同伴的呼吸与体温", "text": "贝尔特朗额头滚烫，呼吸急促。茉拉打开急救皮箱，解开妨碍换药的衣袖。"},
        {"id": "care_given", "actor": "mora", "when": c1_other_material(group, "fever", true), "present": ["bertrand"], "kind": "help", "materials": ["acid_blisters", "care_active"], "effects": [dv_assign(c1_other_material_ref(group, "care_active"), true)], "label": "开始补水降温与床边照护", "text": "茉拉在床边坐下，开始补水降温，换上一块湿布。她揭开敷料的一角，见到创缘的强酸灼伤水泡，把这一项记下，继续留在伤员身旁。"},
        {"id": "inspect_own_reagent_traces", "actor": "veronica", "when": opened, "kind": "inspect", "materials": ["bottle_label", "working_glove_acid_residue", "cabinet_key_in_kit"], "label": "核对瓶签、手套残迹与备用钥匙", "text": "维罗妮卡逐一转过瓶签。R-07 瓶颈有干涸残液，她的工作手套留着同样的酸蚀斑，备用钥匙夹在器具袋内。她把这几样放在一起比看。"},
        {"id": "evidence_complete", "actor": "veronica", "when": dv_all([campaign_case_claim(group, "care_given"), c1_other_material(group, "own_reagent_account", "R-07")]), "present": ["mora"], "kind": "talk", "materials": ["reported_taker", "reported_reagent"], "effects": [dv_assign(c1_other_material_ref(group, "reported_taker"), "veronica"), dv_assign(c1_other_material_ref(group, "reported_reagent"), "R-07")], "label": "回应试剂取用的质问", "text": "维罗妮卡说：‘R-07 是我取的。组织未坏死，反应已配平。我没兴趣向不懂配平式的人作道德检讨。’"},
        {"id": "report_basis", "actor": "mora", "when": c1_other_material_identity(group, "veronica"), "kind": "talk", "materials": ["physician_permission"], "label": "对照创面、试剂与医嘱记录", "text": "茉拉把照护记录摊开给在场者核对其中未开医嘱的一栏，又检查贝尔特朗创缘的水泡：‘未经医嘱，便拿污染创面做激进的酸试验。’"},
        {"id": "evening_check", "actor": "mora", "when": dv_all([campaign_case_claim(group, "care_given"), dv_at_least(campaign_clock(), 1260), dv_not(dv_at_least(campaign_clock(), 1800))]), "present": ["bertrand"], "kind": "inspect", "materials": ["fever", "wound_stable", "evening_checked"], "effects": [dv_assign(c1_other_material_ref(group, "evening_checked"), true)], "label": "晚间复查并留下照护记录", "text": "茉拉重新量体温，摸过脉搏，再查看敷料下的创缘，把这一回的情况记在照护页上。"},
        {"id": "morning_check_unstable", "actor": "mora", "when": dv_all([campaign_case_claim(group, "care_given"), c1_other_material(group, "evening_checked", true), dv_at_least(campaign_clock(), 2010), campaign_any(c1_other_material(group, "fever", true), c1_other_material(group, "wound_stable", false))]), "present": ["bertrand"], "kind": "inspect", "materials": ["fever", "wound_stable", "care_active"], "label": "晨间复查仍需留观的伤员", "text": "茉拉对照昨晚的记录重新检查。当前体温与创面还不满足放行条件。她把结果记下，留在床边继续照护。"},
        {"id": "observation_complete", "actor": "mora", "when": dv_all([campaign_case_claim(group, "care_given"), c1_other_material(group, "evening_checked", true), dv_at_least(campaign_clock(), 2010)]), "present": ["bertrand"], "kind": "inspect", "physical_requires": dv_all([c1_other_material(group, "evening_checked", true), c1_other_material(group, "fever", false), c1_other_material(group, "wound_stable", true)]), "materials": ["fever", "wound_stable", "evening_checked", "overnight_stable", "care_active"], "effects": [dv_assign(c1_other_material_ref(group, "overnight_stable"), true), dv_assign(c1_other_material_ref(group, "care_active"), false)], "label": "对照晚间记录复查伤员", "text": "茉拉对照昨晚亲手写下的记录，再量体温、检查创缘。热已退下，创缘没有继续扩散。她向铜口报出两次检查的结果，收起急救皮箱。"}
    ]

axiom c1_other_activity_law(group, row):
    var pre = [campaign_at(row.actor, c1_other_case(group).room), dv_fact(campaign_case_ref(group, row.id), false)]
    var physical_condition = row.when
    if row.id == "ruan_admitted":
        physical_condition = campaign_case_claim(group, "open")
    if group == "logistics" and row.id == "evidence_complete":
        physical_condition = campaign_case_claim(group, "care_given")
    rt_push(pre, physical_condition)
    rt_push(pre, dv_find(row, "physical_requires", dv_true()))
    let present = dv_find(row, "present", [])
    var i = 0
    while i < rt_count(present):
        rt_push(pre, campaign_at(present[i], c1_other_case(group).room))
        i = i + 1
    // Own inference and testimony are cognition premises. The physical side
    // checks current contact and the real operation's declared conditions.
    let effects = dv_append(dv_find(row, "effects", []), dv_assign(campaign_case_ref(group, row.id), true))
    return dv_axiom(rt_cat("other.activity.", row.id), 1, dv_all(pre), effects)

fn c1_other_activity_physical(world, group):
    var result = world
    let material = c1_other_initial_material(group)
    var i = 0
    while i < rt_count(material):
        result = dv_store(result, c1_other_material_ref(group, material[i][0]), dv_field(material[i][1]))
        i = i + 1
    let rows = c1_other_activity_rows(group)
    i = 0
    while i < rt_count(rows):
        result = dv_store(result, campaign_case_ref(group, rows[i].id), dv_field(false))
        result = dv_adopt(result, campaign_method(rt_cat(rt_cat("other.activity.", group), rt_cat(".", rows[i].id)), c1_other_activity_law(group, rows[i])), "enforce", 1, [c1_other_case(group).source])
        i = i + 1
    return result

fn c1_other_activity_actor(actor, group):
    var result = actor
    var mind = campaign_add_new(result.mind, campaign_local_object("campaign.clock"))
    let source = c1_other_case(group).source
    let rows = c1_other_activity_rows(group)
    var i = 0
    while i < rt_count(rows):
        mind = dv_store(mind, campaign_case_ref(group, rows[i].id), dv_with(dv_field(false), "basis", [source]))
        i = i + 1
    if actor.id == "ruan":
        let traces = dv_all([c1_other_material(group, "palm_bronze_residue", true), c1_other_material(group, "grip_pressure", "downward-pull"), c1_other_material(group, "abrasion_form", "gate-handle")])
        let inference = dv_axiom("ruan.own-gate-traces", 1, traces, [dv_assign(c1_other_material_ref(group, "own_latch_inference"), "ruan")])
        mind = dv_adopt(mind, campaign_method("ruan.own-gate-traces", inference), "infer", 0.8, [campaign_source("docs/design-standard.md", 584, "本人实际检视掌痕后作出的可错判断；不恢复封存记忆")])
    if actor.id == "veronica":
        let traces = dv_all([c1_other_material(group, "bottle_label", "R-07"), c1_other_material(group, "working_glove_acid_residue", true), c1_other_material(group, "cabinet_key_in_kit", true)])
        let inference = dv_axiom("veronica.own-reagent-traces", 1, traces, [dv_assign(c1_other_material_ref(group, "own_reagent_account"), "R-07")])
        mind = dv_adopt(mind, campaign_method("veronica.own-reagent-traces", inference), "infer", 0.85, [campaign_source("docs/design-standard.md", 596, "本人实际核对器具、瓶签与酸蚀斑后辨认；不是初始答案")])
    if actor.id == "mora":
        mind = dv_store(mind, c1_other_material_ref(group, "physician_permission"), dv_with(dv_field(false), "basis", [campaign_source("docs/design-standard.md", 596, "本人未曾开出该项医嘱")]))
    var actions = dv_clone(result.actions)
    var goals = dv_clone(result.policy.goals)
    let witnesses = dv_append(c1_other_group_listeners(group, ""), "detective")
    i = 0
    while i < rt_count(rows):
        let row = rows[i]
        if row.actor == actor.id:
            let ref = campaign_case_ref(group, row.id)
            let method = rt_cat(rt_cat("other.activity.", group), rt_cat(".", row.id))
            let law = c1_other_activity_law(group, row)
            let known = dv_all([campaign_at(actor.id, c1_other_case(group).room), row.when, dv_fact(ref, false)])
            var grants = [ref, campaign_clock()]
            var j = 0
            while j < rt_count(row.materials):
                rt_push(grants, c1_other_material_ref(group, row.materials[j]))
                j = j + 1
            mind = dv_adopt(mind, campaign_method(method, law), "predict", 1, [source])
            var activity = dv_with_many(campaign_surface_action(rt_cat(actor.id, rt_cat(".activity.", row.id)), row.kind, known, law.premise, method, grants, row.label, row.text, source), {"predict_law": method, "public_observers": witnesses, "public_grants": grants, "opportunity_requirement": {"location": c1_other_case(group).room, "participants": dv_find(row, "present", []), "mode": "all-present"}})
            if row.kind == "talk":
                activity = dv_with_many(activity, {"speech": dv_with(c1_speech(dv_true(), source, "own-current-evidence-appraisal"), "surface", row.text), "listeners": c1_other_group_listeners(group, actor.id), "surface": "", "presentation": c1_op_presentation(actor.id, "dialogue", [])})
            if row.id == "west_passage_checked" or row.id == "observation_complete":
                activity = dv_with_many(activity, {"speech": dv_with_many(c1_speech(dv_true(), source, "actual-safety-report"), {"surface": row.text, "channel": rt_cat("copper.", group)}), "listeners": ["demon"], "public_grants": dv_append(grants, campaign_case_ref(group, "care_given"))})
            rt_push(actions, activity)
            rt_push(goals, campaign_goal(dv_fact(ref, true), row.when, [source]))
        i = i + 1
    let options = c1_other_case(group).options
    i = 0
    while i < rt_count(options):
        let option = options[i]
        let method = rt_cat(rt_cat("other.material-identity.", group), rt_cat(".", option))
        let inferred = dv_axiom(method, 1, c1_other_material_identity(group, option), [dv_assign(campaign_case_ref(group, rt_cat("answer.", option)), true)])
        mind = dv_adopt(mind, campaign_method(method, inferred), "infer", 1, [source])
        i = i + 1
    return dv_with_many(result, {"mind": mind, "actions": actions, "policy": dv_with_many(result.policy, {"goals": goals, "offscreen_activity_scope": "owned-material-and-care-opportunities"})})


fn c1_other_literal_report_surface(group, option):
    let name = c1_other_person(option).name
    if group == "contract":
        return rt_cat(name, "开启内柜，并将物件藏入壁炉砖槽。仅凭这些痕迹，授权和动机还没有说明。")
    if group == "astral":
        return rt_cat(name, "拉闸封门。门内人的意思和封门缘由还需要核对。")
    return rt_cat(name, "取走了试剂。取用目的还需要本人说明和实际材料支持。")

fn c1_other_reason_report_surface(group, option, reason):
    let spec = c1_other_case(group)
    var i = 0
    while i < rt_count(spec.reason_options):
        if spec.reason_options[i] == reason:
            return rt_cat(rt_cat(c1_other_person(option).name, "；经实际材料与本人说明核对："), rt_cat(spec.reason_surfaces[i], "。"))
        i = i + 1
    dv_require(false, "Unknown chapter-one reason option")
    return ""

axiom c1_other_complete_accept(group, actor):
    let pre = dv_all([campaign_case_claim(group, "open"), campaign_case_claim(group, rt_cat("receipt.", actor))])
    return dv_axiom(rt_cat("c1_other_complete_accept.", rt_cat(group, rt_cat(".", actor))), 1, pre, [dv_assign(campaign_case_ref(group, rt_cat("complete_receipt.", actor)), true), dv_assign(campaign_case_ref(group, rt_cat("complete_level.", actor)), 1), dv_assign(dv_ref(rt_cat("personal.", actor), "state", "current"), rt_cat(group, ".complete"))])

// The common chooser compares only alternatives whose complete present
// eligibility holds. The declaration never makes a future reply executable.
fn c1_other_case_choice_declaration(group, mode, condition, source_refs):
    var promotes = ["solve_case", "evidence", "clarify_terms"]
    var sacrifices = ["avoid_attachment"]
    if mode == "literal":
        promotes = ["solve_case", "avoid_attachment"]
        sacrifices = ["evidence", "clarify_terms"]
    if mode == "departure":
        promotes = ["pursue_desire", "avoid_attachment"]
        sacrifices = ["solve_case", "evidence", "clarify_terms"]
    let basis = dv_append(source_refs, campaign_source("user:current-request", 0, "approved-cross-zone-personal-choice-20261018"))
    return {"group": rt_cat("detective.case-response.", group), "requires": condition, "prohibits": dv_not(dv_true()), "promotes": promotes, "sacrifices": sacrifices, "basis": basis}

fn c1_other_case_choice(action, group, mode):
    return dv_with(action, "personal_choice", c1_other_case_choice_declaration(group, mode, action.precondition, action.source_refs))

fn c1_other_placement_release_goals(goals, group, release, local_release, manifest, local_manifest):
    let old_items = release.premise.items
    let new_items = local_release.premise.items
    let unmanifested = dv_fact(dv_ref("demon.body", "state", "manifested"), false)
    let old_group_manifest = dv_all([old_items[0], old_items[1], old_items[2], old_items[3], unmanifested])
    let new_group_manifest = dv_all([new_items[0], new_items[1], new_items[2], new_items[3], unmanifested])
    let receipt_ref = campaign_case_ref(group, "receipt.detective")
    var result = []
    var i = 0
    while i < rt_count(goals):
        var goal = goals[i]
        let condition = dv_find(goal, "available_when", dv_true())
        if dv_same(condition, release.premise):
            goal = campaign_index_goal_window(dv_with(goal, "available_when", local_release.premise))
        if dv_same(condition, manifest.premise):
            goal = campaign_index_goal_window(dv_with(goal, "available_when", local_manifest.premise))
        if dv_same(condition, old_group_manifest):
            goal = campaign_index_goal_window(dv_with(goal, "available_when", new_group_manifest))
        if dv_same(dv_find(goal, "ref", false), campaign_case_ref(group, "evidence_complete")) and dv_has_key(goal, "refresh_refs"):
            goal = dv_with(goal, "refresh_refs", dvp_add_ref(goal.refresh_refs, receipt_ref))
        rt_push(result, goal)
        i = i + 1
    rt_push(result, campaign_observation_goal(receipt_ref, campaign_at("demon", "living_hall"), [c1_other_case(group).source], 0))
    return result

// Placement installs the local public protocol; no question receipt, answer or
// recollection exists until its actual action and observation have occurred.
fn c1_other_place_detective(scene, zone, profile):
    var group = zone
    if zone == "zone_jia" or zone == "甲":
        group = "contract"
    if zone == "zone_bing" or zone == "丙":
        group = "astral"
    if zone == "zone_ding" or zone == "丁":
        group = "logistics"
    dv_require(dv_has(["contract", "astral", "logistics"], group), "Unsupported detective dormitory placement")
    let placement_source = c1_other_case(group).source
    let current_ref = dv_ref("personal.detective", "state", "current")
    let opening = c1_other_question_open(group)
    let local_opening = dv_with(opening, "effects", dv_append(opening.effects, dv_assign(current_ref, rt_cat(group, ".identity"))))
    let release = c1_other_release(group, campaign_clock())
