        world = c1_add_move_methods(world, actor, "enforce")
        world = c1_evidence_contact_methods(c1_latch_contact_method(world, actor, "enforce"), actor, "enforce")
        if dv_has(["huo", "shen", "su"], actor):
            world = dv_store(world, c1_deep_resonance_ref(actor), dv_field(false))
        world = dv_adopt(world, campaign_method(rt_cat(actor, ".sound_trial"), c1_sound_execution_law(actor)), "enforce", 1, [c1_sound_source()])
        i = (i + 1)
    world = dv_adopt(world, campaign_method("demon.opening", c1_opening_emit("question")), "enforce", 1, dv_single(campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/01_开场.story", 28, "s3_broadcast.019")))
    world = dv_adopt(world, campaign_method("demon.question", c1_question_emit("question")), "enforce", 1, dv_single(campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/01_开场.story", 46, "s5_question.004")))
    world = dv_adopt(world, campaign_method("demon.original_question", c1_original_question_open("question")), "enforce", 1, dv_single(campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/07_答辩.story", 16, "answer_q2.001")))
    world = c1_adopt_protocol(world)
    return c1_register_speech_contract(world)

