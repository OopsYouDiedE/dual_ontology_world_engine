fn c1_answer_actions(actor):
    let actions = [c1_answer_me(actor), c1_answer_V1_0(actor), c1_answer_V1_1(actor), c1_answer_V1_2(actor), c1_answer_V2_0(actor), c1_answer_V2_1(actor), c1_answer_V2_2(actor), c1_answer_V3_0(actor), c1_answer_V3_1(actor), c1_answer_V4_0(actor), c1_answer_V4_1(actor), c1_answer_V5_0(actor), c1_answer_V5_1(actor), c1_answer_V5_2(actor), c1_answer_trust(actor), c1_answer_V6_0(actor), c1_answer_V6_1(actor)]
    var result = []
    var i = 0
    while i < rt_count(actions):
        var action = c1_public_answer_speech(actions[i])
        if dv_has(["V1_0", "V1_1", "V1_2", "V2_0", "V2_1", "V2_2", "V5_0", "V5_1", "V5_2", "V6_0", "V6_1"], action.answer_id):
            action = dv_with(action, "answer_form", "supporting-statement")
        rt_push(result, action)
        i = i + 1
    return result

fn c1_raw_hypotheses():
    return [c1_hypothesis_me(), c1_hypothesis_V1_0(), c1_hypothesis_V1_1(), c1_hypothesis_V1_2(), c1_hypothesis_V2_0(), c1_hypothesis_V2_1(), c1_hypothesis_V2_2(), c1_hypothesis_V3_0(), c1_hypothesis_V3_1(), c1_hypothesis_V4_0(), c1_hypothesis_V4_1(), c1_hypothesis_V5_0(), c1_hypothesis_V5_1(), c1_hypothesis_V5_2(), c1_hypothesis_trust(), c1_hypothesis_V6_0(), c1_hypothesis_V6_1()]

fn c1_hypotheses():
    var items = c1_raw_hypotheses()
    var result = []
    var n = 0
    while (n < rt_count(items)):
        var item = items[n]
        rt_push(result, dv_with(item, "question", c1_answer_topic(item.id)))
        n = (n + 1)
    return result

