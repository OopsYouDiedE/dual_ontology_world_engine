    world = dv_add_object(world, dv_with(campaign_state_object("coat", {"name": dv_field("风衣"), "location": dv_field("R05"), "worn_by": dv_field("")}), "facets", {"state": {"name": dv_field("风衣"), "location": dv_field("R05"), "worn_by": dv_field("")}, "identity": {"owner": dv_field("detective")}}))
    // The coat starts on its hook; its pockets travel only when the coat is worn.
    world = dv_add_object(world, campaign_state_object("lens", {"name": dv_field("黄铜放大镜"), "location": dv_field("coat")}))
    world = dv_add_object(world, campaign_state_object("graphite_pencil", {"name": dv_field("石墨笔"), "location": dv_field("coat")}))
