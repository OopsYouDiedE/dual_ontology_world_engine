            j = j + 1
        rt_push(respondents, actor)
        i = i + 1
    return dv_with_many(scene, {"physical": world, "actors": respondents, "bindings": bindings, "detective_start_group": group, "formal_answers": answers})

fn c1_other_truth_rows(group):
    if group == "contract":
        return [
            {"id": "seal_examined", "actor": "detective", "after": "evidence_complete", "time": 480, "kind": "inspect", "partner": "", "label": "对照火漆封口与纸边", "text": "侦探对照火漆指模、封口和纸片毛边：封缄曾由同一只手压合，红墨残纸是从完整文书新撕下的。它说明有人交接，不能独自补出授权者。"},
            {"id": "quer_recalled", "actor": "detective", "after": "seal_examined", "time": 480, "kind": "talk", "partner": "quer", "label": "询问钥匙与文书的交接", "text": "侦探把封口与毛边递给雀儿。她盯着火漆，想起有人将钥匙和文书交到她掌中，叮嘱她取出内柜物件并藏妥。她承认藏入壁炉砖槽；这不是她自行决定的偷窃。"}
        ]
    if group == "astral":
        return [
            {"id": "moran_calmed", "actor": "detective", "after": "evidence_complete", "time": 480, "kind": "talk", "partner": "moran", "label": "安抚同伴并请求查看画夹", "text": "侦探没有催问，陪莫兰把呼吸放缓。他终于同意打开画夹暗层，取出未被截去的完整草图。"},
            {"id": "gesture_examined", "actor": "detective", "after": "moran_calmed", "time": 480, "kind": "inspect", "partner": "", "shared_inspection": true, "label": "检视完整草图", "text": "侦探将完整草图展开给在场者共同检视。完整草图中，伊莲娜伸出的手接着做了明确的劈切手势。半截画面遮住的，正是这个后续动作。"},
            {"id": "elena_identified", "actor": "detective", "after": "gesture_examined", "time": 480, "kind": "talk", "partner": "elena", "label": "询问草图中的手势", "text": "伊莲娜辨认完整草图：‘是我的手。我让她关。’阮清月确实拉闸，却不是单方面把她抛下。"}
        ]
    return [
        {"id": "old_scar_examined", "actor": "detective", "after": "evidence_complete", "time": 480, "kind": "inspect", "partner": "veronica", "label": "检视左臂旧疤", "text": "维罗妮卡同意卷起左袖。侦探查看的是左臂旧疤，边缘已愈合，与贝尔特朗今天的高烧分属不同病史。"},
        {"id": "veronica_explained", "actor": "detective", "after": "old_scar_examined", "time": 480, "kind": "talk", "partner": "veronica", "label": "询问旧疤与试剂用途", "text": "维罗妮卡说明：左臂三道旧疤来自R-07强酸络合剂的自体耐受标定。她依据此前在自己身上做的标定救治贝尔特朗；今天的酸泡争执不能抹去旧疤与救治用途。"}
    ]

axiom c1_other_truth_law(group, row):
    var subject = "detective"
    if row.kind == "talk":
        subject = row.partner
    var pre = [campaign_at(subject, c1_other_case(group).room), campaign_case_claim(group, row.after), dv_fact(campaign_case_ref(group, row.id), false)]
    if row.partner != "":
        rt_push(pre, campaign_at(row.partner, c1_other_case(group).room))
    return dv_axiom(rt_cat("detective.truth.", row.id), 1, dv_all(pre), [dv_assign(campaign_case_ref(group, row.id), true)])

// Present doors, bodies and heard voices are distinct from frozen accident evidence.
// Initial placement creates a physical body; it never opens a latch or marks a crossing.

fn c1dep_source(file, line, id):
    return campaign_source(rt_cat("godot_csharp/scenes/Awakening/Script/story/第一章/场面/", file), line, id)

fn c1dep_ref(field):
    return dv_ref("departure.door", "state", field)

fn c1dep_cross_ref(actor):
    return dv_ref(rt_cat("departure.person.", actor), "state", "crossed")

fn c1dep_complete():
    return dv_all([dv_fact(dv_ref("question", "state", "solved_identity"), true), dv_fact(dv_ref("question", "state", "solved_voice_source"), true), dv_fact(dv_ref("question", "state", "solved_words"), true), dv_fact(dv_ref("question", "state", "solved_trust"), true)])

fn c1dep_can_cross():
    return dv_all([dv_fact(c1dep_ref("outer_released"), true), dv_fact(c1dep_ref("inner_down"), false), dv_fact(c1dep_ref("open"), true)])

fn c1dep_entered(world, actor):
    return dv_truth(world, dv_fact(c1dep_cross_ref(actor), true)) == "true"

法则 c1dep_outer_law：
    当 c1dep_complete()。
    并且 恶魔 位于 起居厅。
    并且 "demon.body" 的 "manifested" 等于 true。
    并且 c1dep_ref("outer_released") 等于 false。
    则 c1dep_ref("outer_released") 变为 true。
    并使 campaign_access("living_exit") 变为 true。
    并使 "demon.body" 的 "manifested" 变为 false。
    并使 "demon.body" 的 "latch_hand_trace" 变为 "long-narrow-hand"。

法则 c1dep_pick_law：
    当 雀儿 位于 起居厅。
    并且 campaign_clock() 至少 780。
    并且 c1dep_ref("outer_released") 等于 false。
    并且 c1dep_ref("quer_has_wire") 等于 true。
    则 c1dep_ref("outer_released") 变为 true。
    并使 c1dep_ref("picked_by_quer") 变为 true。
    并使 campaign_access("living_exit") 变为 true。

法则 c1dep_pick_contract_law：
    当 雀儿 位于 "dorm.contract"。
    并且 campaign_case_claim("contract", "quer_insulted")。
    并且 c1dep_ref("quer_has_wire") 等于 true。
    并且 campaign_case_ref("contract", "outer_latch_released") 等于 false。
    则 campaign_case_ref("contract", "outer_latch_released") 变为 true。
    并使 c1_other_access_ref("contract") 变为 true。
    并使 c1dep_ref("contract_picked_by_quer") 变为 true。

法则 c1dep_inner_law，给定 行动者：
    当 行动者 位于 乙区门厅。
    并且 c1dep_ref("outer_released") 等于 true。
    并且 c1dep_ref("inner_down") 等于 true。
    则 c1dep_ref("inner_down") 变为 false。

法则 c1dep_open_law，给定 行动者：
    当 行动者 位于 乙区门厅。
    并且 c1dep_ref("outer_released") 等于 true。
    并且 c1dep_ref("inner_down") 等于 false。
    并且 c1dep_ref(开放状态) 等于 false。
    则 c1dep_ref(开放状态) 变为 true。

axiom c1dep_cross_law(actor, outward):
    var origin = "living_hall"
    var target = "foyer"
    if outward:
        origin = "foyer"
        target = "living_hall"
    var effects = dv_single(dv_assign(dv_ref(actor, "state", "location"), target))
    if outward:
        rt_push(effects, dv_assign(c1dep_cross_ref(actor), true))
    return dv_axiom("c1dep_cross_law", 1, dv_all([campaign_at(actor, origin), c1dep_can_cross()]), effects)

axiom c1dep_join_law(actor, group):
    var pre = dv_all([campaign_at(actor, rt_cat("threshold.", group)), dv_fact(campaign_ref(rt_cat("case.", group), "outer_latch_released"), true), dv_fact(campaign_access(group), true)])
    if actor == "quer" or actor == "lucian":
        pre = dv_all([pre, dv_at_least(campaign_clock(), 690)])
    return dv_axiom("c1dep_join_law", 1, pre, dv_single(dv_assign(dv_ref(actor, "state", "location"), "living_hall")))

fn c1dep_speech(actor, id, room, when, literal, label, text, source):
    return dv_with_many(campaign_surface_action(id, "talk", dv_all([campaign_at(actor, room), when, literal]), campaign_at(actor, room), "", [], label, text, source), {"speech": dv_with_many(c1_speech(literal, source, "current-doorway-dialogue"), {"surface": text, "channel": "door.living"}), "listeners": dv_append(campaign_people(), "demon")})

fn c1dep_actions(actor):
    var actions = []
    let source = c1dep_source("08_终局.story", 4, "s10_steps.003")
    let four = ["detective", "huo", "shen", "su"]
    if dv_has(four, actor):
        let fields = [c1dep_ref("outer_released"), c1dep_ref("inner_down"), c1dep_ref("open"), campaign_access("living_exit")]
        rt_push(actions, dv_with(campaign_surface_action(rt_cat(actor, ".departure.inspect-door"), "inspect", campaign_at(actor, "foyer"), campaign_at(actor, "foyer"), "", fields, "检视隔离门内外门闩", "查看门内的插闩和门外的横闩。", c1dep_source("11_门外的人.story", 8, "door_voices.005")), "repeatable", true))
        if actor == "detective":
            let inner = dv_all([campaign_at(actor, "foyer"), dv_fact(c1dep_ref("outer_released"), true), dv_fact(c1dep_ref("inner_down"), true)])
            rt_push(actions, dv_with_many(campaign_surface_action(rt_cat(actor, ".departure.draw-inner"), "help", inner, inner, rt_cat(actor, ".departure.draw-inner"), dv_single(c1dep_ref("inner_down")), "拔出门内插闩", "拔出门内的插闩。", source), {"predict_law": rt_cat(actor, ".departure.draw-inner"), "public_observers": four, "public_grants": [c1dep_ref("inner_down")]}))
            let open = dv_all([campaign_at(actor, "foyer"), dv_fact(c1dep_ref("outer_released"), true), dv_fact(c1dep_ref("inner_down"), false)])
            rt_push(actions, dv_with_many(campaign_surface_action(rt_cat(actor, ".departure.open-door"), "help", open, open, rt_cat(actor, ".departure.open-door"), dv_single(c1dep_ref("open")), "拉开隔离门", "拉开隔离门。", c1dep_source("08_终局.story", 8, "s10_open")), {"predict_law": rt_cat(actor, ".departure.open-door"), "speech": dv_with_many(c1_speech(dv_true(), c1dep_source("08_终局.story", 8, "s10_open"), "actual-door-open"), {"surface": "拉开隔离门。", "channel": "door.living"}), "listeners": ["huo", "shen", "su"], "public_grants": [c1dep_ref("outer_released"), c1dep_ref("inner_down"), c1dep_ref("open"), campaign_access("living_exit")]}))
        let out = dv_all([campaign_at(actor, "foyer"), c1dep_can_cross()])
        let back = dv_all([campaign_at(actor, "living_hall"), c1dep_can_cross()])
        let out_id = rt_cat(actor, ".departure.cross-out")
        let in_id = rt_cat(actor, ".departure.cross-in")
        rt_push(actions, dv_with_many(campaign_surface_action(out_id, "move", out, out, out_id, [dv_ref(actor, "state", "location"), c1dep_cross_ref(actor), campaign_clock()], "前往起居厅", "跨过门槛，走进起居厅。", c1dep_source("08_终局.story", 24, "s10_open.003：是否迈出由本人选择")), {"predict_law": out_id, "repeatable": true, "travel": {"from": "foyer", "to": "living_hall", "gate": "living_exit"}}))
        rt_push(actions, dv_with_many(campaign_surface_action(in_id, "move", back, back, in_id, dv_single(dv_ref(actor, "state", "location")), "回到门厅", "穿过隔离门，回到门厅。", source), {"predict_law": in_id, "repeatable": true, "travel": {"from": "living_hall", "to": "foyer", "gate": "living_exit"}}))
    if actor != "demon" and campaign_profile(actor).group != "living":
        let group = campaign_profile(actor).group
        let pre = c1dep_join_law(actor, group).premise
        let id = rt_cat(actor, ".departure.join-living")
        rt_push(actions, dv_with_many(campaign_surface_action(id, "move", pre, pre, id, dv_single(dv_ref(actor, "state", "location")), "从寝区门外前往起居厅", "从寝区门外走进起居厅。", c1_other_departure_source(actor).source), {"predict_law": id, "repeatable": true, "travel": {"from": rt_cat("threshold.", group), "to": "living_hall", "gate": "living"}}))
    if actor == "quer":
        rt_push(actions, dv_with(campaign_surface_action("quer.departure.inspect-yi-outer", "inspect", campaign_at(actor, "living_hall"), campaign_at(actor, "living_hall"), "", [c1dep_ref("outer_released")], "检视乙区外闩", "查看乙区门外的横闩。", source), "repeatable", true))
        let own_pre = c1dep_pick_contract_law().premise
        rt_push(actions, dv_with_many(campaign_surface_action("quer.departure.pick-contract", "experiment", own_pre, own_pre, "quer.departure.pick-contract", [campaign_case_ref("contract", "outer_latch_released"), c1_other_access_ref("contract"), c1dep_ref("contract_picked_by_quer")], "用钢丝挑开甲区外闩", "雀儿从袖口拉出精钢丝，探过门缝挑起甲区外闩。", campaign_source("docs/design-standard.md", 0, "甲区开锁机会")), {"predict_law": "quer.departure.pick-contract", "public_observers": ["lucian", "ward", "gu"], "public_grants": [campaign_case_ref("contract", "outer_latch_released"), c1_other_access_ref("contract")]}))
        let pre = c1dep_pick_law().premise
        let pick_source = c1dep_source("12_雀儿撬门.story", 7, "quer_opens.001-002")
        let pick = campaign_surface_action("quer.departure.pick-outer", "experiment", pre, pre, "quer.departure.pick-outer", [c1dep_ref("outer_released"), c1dep_ref("picked_by_quer"), campaign_access("living_exit")], "用铁丝挑开外闩", "细铁丝拨了四下，外侧的横闩抬了起来。", pick_source)
        rt_push(actions, dv_with_many(pick, {"predict_law": "quer.departure.pick-outer", "speech": dv_with_many(c1_speech(dv_true(), pick_source, "actual-latch-sound"), {"surface": "门外传来细铁丝拨动和横闩抬起的金属响声。", "channel": "door.living"}), "listeners": four, "public_grants": [c1dep_ref("outer_released"), campaign_access("living_exit")]}))
        let receipt = dv_at_least(campaign_clock(), 690)
        let call = c1dep_speech(actor, "quer.departure.call-inside", "living_hall", receipt, dv_true(), "呼唤门内的人", "里头有人？", c1dep_source("11_门外的人.story", 5, "door_voices.002：询问部分"))
        rt_push(actions, dv_with(call, "speech", dv_with(call.speech, "utterance_type", "question")))
        let self = dv_fact(c1dep_ref("contract_picked_by_quer"), true)
        let reply = c1dep_speech(actor, "quer.departure.answer-door", "living_hall", self, self, "隔门自报姓名", "甲区的，叫我雀儿。那边的门让我挑开了。你们这扇，我也可以看看。", c1dep_source("11_门外的人.story", 8, "door_voices.005"))
        rt_push(actions, dv_with(reply, "response_topic", "door_identity"))
    if actor == "lucian":
        let receipt = dv_at_least(campaign_clock(), 690)
        rt_push(actions, dv_with(c1dep_speech(actor, "lucian.departure.rebuke-quer", "living_hall", receipt, dv_true(), "提醒同伴隔门交谈的礼数", "雀儿，贴着门板喊，里头听得见，礼数可就丢了。", c1dep_source("11_门外的人.story", 6, "door_voices.003")), "received_speech_requirement", {"speaker": "quer", "action_id": "quer.departure.call-inside"}))
    if actor == "detective":
        var ask = c1dep_speech(actor, "detective.departure.ask-door", "foyer", dv_true(), dv_true(), "询问门外人的身份", "门外是谁？", c1dep_source("11_门外的人.story", 7, "door_voices.004"))
        ask = dv_with_many(ask, {"speech": dv_with(ask.speech, "request", {"target": "quer", "topic": "door_identity"}), "request_transport": {"channel": "door.living"}, "received_speech_requirement": {"speaker": "quer", "action_id": "quer.departure.call-inside"}})
        rt_push(actions, ask)
    if actor == "su":
        let picked = dv_all([campaign_at(actor, "living_hall"), dv_fact(c1dep_ref("picked_by_quer"), true)])
        rt_push(actions, c1dep_speech(actor, "su.departure.picked-rebuke", "living_hall", picked, picked, "指出门闩是从外侧打开的", "门闩是从外侧挑开的。刚才那几下金属响，就在门板后面。", c1dep_source("08_终局.story", 26, "su_picked_rebuke")))
        let unpicked = dv_all([campaign_at(actor, "living_hall"), dv_fact(c1dep_ref("picked_by_quer"), false), dv_fact(c1dep_ref("outer_released"), true)])
        rt_push(actions, c1dep_speech(actor, "su.departure.praise", "living_hall", unpicked, unpicked, "确认门闩已经放开", "外闩放开了。先把脚下和门框边看清楚，再往外走。", c1dep_source("08_终局.story", 29, "su_unpicked_praise")))
    if actor == "shen":
        let picked = dv_all([campaign_at(actor, "living_hall"), dv_fact(c1dep_ref("picked_by_quer"), true)])
        rt_push(actions, c1dep_speech(actor, "shen.departure.picked-doubt", "living_hall", picked, picked, "提醒同伴查看门口", "门外那道横闩抬起来了。门槛上有灰，别一脚全踩乱了。", c1dep_source("08_终局.story", 27, "shen_picked_doubt")))
    if actor == "huo":
        let picked = dv_all([campaign_at(actor, "living_hall"), dv_fact(c1dep_ref("picked_by_quer"), true)])
        rt_push(actions, c1dep_speech(actor, "huo.departure.picked-cold", "living_hall", picked, picked, "检查被挑动的外闩", "细铁丝能伸到这里。横闩端头这一道新划痕，留下来给我看看。", c1dep_source("08_终局.story", 28, "huo_picked_cold")))
        let unpicked = dv_all([campaign_at(actor, "living_hall"), dv_fact(c1dep_ref("picked_by_quer"), false), dv_fact(c1dep_ref("outer_released"), true)])
        rt_push(actions, c1dep_speech(actor, "huo.departure.trust", "living_hall", unpicked, unpicked, "查看已放行的门闩", "横闩抬起了，门框没有再受力。走吧，门口别挤。", c1dep_source("08_终局.story", 30, "huo_unpicked_trust")))
    if actor == "demon":
        let manifestation = c1dep_manifest_law()
        rt_push(actions, dv_with_many(campaign_surface_action("demon.departure.manifest", "help", manifestation.premise, manifestation.premise, "demon.departure.manifest", [dv_ref("demon.body", "state", "manifested")], "凝实身体以接触门闩", "虚影在门闩前凝实，修长窄薄的手掌获得了可以碰触物体的重量。", source), {"predict_law": "demon.departure.manifest", "repeatable": true}))
        let groups = ["contract", "astral", "logistics"]
        var g = 0
        while g < rt_count(groups):
            let group = groups[g]
            var refs = [campaign_case_ref(group, "outer_latch_released"), campaign_case_ref(group, "formal_release"), campaign_case_ref(group, "evidence_complete"), campaign_case_ref(group, "care_given"), campaign_case_ref(group, "west_passage_checked"), campaign_case_ref(group, "observation_complete"), campaign_clock()]
            let people = c1_other_people()
            var p = 0
            while p < rt_count(people):
                if people[p].group == group:
                    rt_push(refs, campaign_case_ref(group, rt_cat("receipt.", people[p].id)))
                p = p + 1
            rt_push(actions, dv_with(campaign_surface_action(rt_cat("demon.departure.inspect.", group), "inspect", campaign_at(actor, "living_hall"), campaign_at(actor, "living_hall"), "", refs, rt_cat("核对", rt_cat(c1_other_case(group).zone, "的答复与外闩")), "核对铜口答复记录与寝区外闩。", c1_other_case(group).source), "repeatable", true))
            rt_push(actions, c1_other_release_action(group, actor, campaign_clock()))
            g = g + 1
        let solved_refs = [dv_ref("question", "state", "solved_identity"), dv_ref("question", "state", "solved_voice_source"), dv_ref("question", "state", "solved_words"), dv_ref("question", "state", "solved_trust")]
        rt_push(actions, dv_with(campaign_surface_action("demon.departure.inspect-accepted", "inspect", campaign_at(actor, "living_hall"), campaign_at(actor, "living_hall"), "", solved_refs, "查看已认定的答复", "查看已认定的答复。", source), "repeatable", true))
        rt_push(actions, dv_with(campaign_surface_action("demon.departure.inspect-body", "inspect", dv_true(), dv_true(), "", dv_single(campaign_position_ref(actor)), "查看周围", "看了看周围。", source), "repeatable", true))
        rt_push(actions, dv_with(campaign_surface_action("demon.departure.inspect-outer", "inspect", campaign_at(actor, "living_hall"), campaign_at(actor, "living_hall"), "", dv_single(c1dep_ref("outer_released")), "检视隔离门外闩", "查看隔离门外侧的横闩。", source), "repeatable", true))
        let after_answer = dv_all([campaign_at(actor, "living_hall"), c1dep_complete()])
        rt_push(actions, dv_with(campaign_surface_action("demon.departure.inspect-clock", "inspect", after_answer, after_answer, "", [campaign_clock()], "查看起居厅钟面", "查看起居厅钟面。", source), "repeatable", true))
        let pre = c1dep_outer_law().premise
        let lifted = campaign_surface_action("demon.departure.release-outer", "help", pre, pre, "demon.departure.release-outer", [c1dep_ref("outer_released"), campaign_access("living_exit"), dv_ref("demon.body", "state", "manifested")], "抬起外闩", "外侧的横闩，被一只手抬了起来。", source)
        rt_push(actions, dv_with_many(lifted, {"predict_law": "demon.departure.release-outer", "speech": dv_with_many(c1_speech(dv_true(), source, "actual-latch-sound"), {"surface": "门外传来横闩抬起的金属响声。", "channel": "door.living"}), "listeners": four, "public_grants": [c1dep_ref("outer_released"), campaign_access("living_exit")]}))
    let hand_ref = dv_ref("demon.body", "state", "hand_shape")
    let owner_ref = dv_ref("demon.body", "state", "shelf_print_owner")
    let hand_source = campaign_source("docs/design-standard.md", 0, "架沿手印的观察与询问")
    if dv_has(four, actor):
        let present = dv_all([campaign_at(actor, "living_hall"), campaign_at("demon", "living_hall"), dv_fact(dv_ref("demon.body", "state", "manifested"), true)])
        rt_push(actions, campaign_surface_action(rt_cat(actor, ".departure.inspect-hand"), "inspect", campaign_at(actor, "living_hall"), present, "", [hand_ref], "检视门边人的手形", "他手形修长，掌面窄薄。仅凭外形，还不能断定架沿的半枚手印属于他。", hand_source))
        let seen_print = dv_fact(campaign_evidence_ref("hand_not_mine"), true)
        var ask = c1dep_speech(actor, rt_cat(actor, ".departure.ask-print"), "living_hall", seen_print, dv_true(), "询问架沿手印", "架上的手印，是你的吗？", hand_source)
        ask = dv_with_many(ask, {"speech": dv_with_many(ask.speech, {"channel": "local", "request": {"target": "demon", "topic": "shelf.print-owner"}}), "purpose_refs": [owner_ref]})
        rt_push(actions, ask)
    if actor == "demon":
        let claim = dv_fact(owner_ref, "demon")
        var reply = c1dep_speech(actor, "demon.departure.answer-print", "living_hall", claim, claim, "答复手印与封存物的去向", "是。诸位封存之物，是我取走的。", hand_source)
        reply = dv_with_many(reply, {"precondition": dv_all([campaign_at(actor, "living_hall"), claim]), "authority_precondition": campaign_at(actor, "living_hall"), "speech": dv_with(reply.speech, "channel", "local"), "response_topic": "shelf.print-owner", "requires_actual_request": true})
        rt_push(actions, campaign_authorized_speech(reply))
    return c1_public_methods(actions)

fn c1dep_laws(world, actor):
    var mode = "enforce"
    if world.domain == "mind":
        mode = "predict"
    var result = world
    let source = c1dep_source("08_终局.story", 4, "s10_steps.003")
    if actor == "detective":
        result = dv_adopt(result, campaign_method(rt_cat(actor, ".departure.draw-inner"), c1dep_inner_law(actor)), mode, 1, [source])
        result = dv_adopt(result, campaign_method(rt_cat(actor, ".departure.open-door"), c1dep_open_law(actor)), mode, 1, [source])
    if dv_has(["detective", "huo", "shen", "su"], actor):
        result = dv_adopt(result, campaign_method(rt_cat(actor, ".departure.cross-out"), c1dep_cross_law(actor, true)), mode, 1, [source])
        result = dv_adopt(result, campaign_method(rt_cat(actor, ".departure.cross-in"), c1dep_cross_law(actor, false)), mode, 1, [source])
    if actor != "demon" and campaign_profile(actor).group != "living":
        result = dv_adopt(result, campaign_method(rt_cat(actor, ".departure.join-living"), c1dep_join_law(actor, campaign_profile(actor).group)), mode, 1, [c1_other_departure_source(actor).source])
    if actor == "quer":
        result = dv_adopt(result, campaign_method("quer.departure.pick-contract", c1dep_pick_contract_law()), mode, 1, [campaign_source("docs/design-standard.md", 0, "甲区开锁机会")])
        result = dv_adopt(result, campaign_method("quer.departure.pick-outer", c1dep_pick_law()), mode, 1, [c1dep_source("12_雀儿撬门.story", 7, "quer_opens.001-002")])
    if actor == "demon":
        result = dv_adopt(result, campaign_method("demon.departure.manifest", c1dep_manifest_law()), mode, 1, [source])
        if mode == "predict":
            let groups = ["contract", "astral", "logistics"]
            var g = 0
            while g < rt_count(groups):
                result = dv_adopt(result, campaign_method(rt_cat("other.release.", groups[g]), c1_other_release(groups[g], campaign_clock())), mode, 1, [c1_other_case(groups[g]).source])
                g = g + 1
        result = dv_adopt(result, campaign_method("demon.departure.release-outer", c1dep_outer_law()), mode, 1, [source])
    return result

fn c1dep_goals(actor):
    var goals = []
    let source = [c1dep_source("08_终局.story", 24, "s10_open.003：未迈出由本人选择")]
    if dv_has(["detective", "huo", "shen", "su"], actor.id):
        let after_trust = dv_fact(dv_ref("question", "state", "solved_trust"), true)
        let released = dv_fact(c1dep_ref("outer_released"), true)
        let at_door = campaign_at(actor.id, "foyer")
        let recheck = campaign_any(after_trust, campaign_any(released, at_door))
        let door_source = [c1dep_source("11_门外的人.story", 8, "door_voices.005：本人听见门外动静或在门厅现场复查")]
        rt_push(goals, dv_with_many(campaign_observation_goal(c1dep_ref("outer_released"), recheck, door_source, 0), {"refresh_until": released, "refresh_refs": [dv_ref("question", "state", "solved_trust")]}))
        rt_push(goals, dv_with_many(campaign_observation_goal(c1dep_ref("inner_down"), recheck, door_source, 0), {"refresh_until": dv_not(dv_true()), "refresh_refs": [c1dep_ref("outer_released")]}))
        rt_push(goals, dv_with_many(campaign_observation_goal(c1dep_ref("open"), recheck, door_source, 0), {"refresh_until": dv_not(dv_true()), "refresh_refs": [c1dep_ref("outer_released")]}))
        rt_push(goals, campaign_goal(dv_fact(c1dep_ref("inner_down"), false), dv_fact(c1dep_ref("outer_released"), true), source))
        rt_push(goals, campaign_goal(dv_fact(c1dep_ref("open"), true), dv_fact(c1dep_ref("outer_released"), true), source))
        rt_push(goals, campaign_goal(campaign_at(actor.id, "living_hall"), dv_fact(c1dep_ref("outer_released"), true), source))
    if actor.id != "demon" and campaign_profile(actor.id).group != "living":
        let leave = c1_other_depart(actor.id)
        rt_push(goals, campaign_goal(campaign_at(actor.id, rt_cat("threshold.", campaign_profile(actor.id).group)), leave.premise, [c1_other_departure_source(actor.id).source]))
        var join_available = campaign_at(actor.id, rt_cat("threshold.", campaign_profile(actor.id).group))
        if actor.id == "quer" or actor.id == "lucian":
            join_available = c1dep_join_law(actor.id, campaign_profile(actor.id).group).premise
        rt_push(goals, campaign_goal(campaign_at(actor.id, "living_hall"), join_available, [c1_other_departure_source(actor.id).source]))
    if actor.id == "quer":
        rt_push(goals, campaign_goal(campaign_case_claim("contract", "outer_latch_released"), c1dep_pick_contract_law().premise, source))
        rt_push(goals, dv_with(campaign_observation_goal(c1dep_ref("outer_released"), campaign_at(actor.id, "living_hall"), source, 0), "refresh_until", dv_fact(c1dep_ref("outer_released"), true)))
        rt_push(goals, campaign_goal(dv_fact(c1dep_ref("outer_released"), true), campaign_at(actor.id, "living_hall"), [c1dep_source("12_雀儿撬门.story", 10, "quer_opens.004")]))
    let actions = c1dep_actions(actor.id)
    var i = 0
    while i < rt_count(actions):
        if dv_has_key(actions[i], "speech"):
            rt_push(goals, {"kind": "communicate", "scope": "personal", "method_id": actions[i].id, "available_when": actions[i].precondition, "requires_argument": false, "basis": actions[i].source_refs})
        i = i + 1
    if actor.id == "demon":
        rt_push(goals, campaign_observation_goal(campaign_clock(), dv_all([campaign_at(actor.id, "living_hall"), c1dep_complete()]), source, 0))
        let people = c1_other_people()
        i = 0
        while i < rt_count(people):
            let ref = campaign_case_ref(people[i].group, rt_cat("receipt.", people[i].id))
            rt_push(goals, campaign_observation_goal(ref, campaign_at(actor.id, "living_hall"), source, 0))
            i = i + 1
        let groups = ["contract", "astral", "logistics"]
        i = 0
        while i < rt_count(groups):
            let ref = campaign_case_ref(groups[i], "formal_release")
            var receipt_refs = []
            var receipt_index = 0
            while receipt_index < rt_count(people):
                if people[receipt_index].group == groups[i]:
                    rt_push(receipt_refs, campaign_case_ref(groups[i], rt_cat("receipt.", people[receipt_index].id)))
                receipt_index = receipt_index + 1
            let evidence_ref = campaign_case_ref(groups[i], "evidence_complete")
            rt_push(goals, dv_with_many(campaign_observation_goal(evidence_ref, campaign_at(actor.id, "living_hall"), source, 0), {"refresh_until": dv_fact(evidence_ref, true), "refresh_refs": receipt_refs}))
            var reported = dv_not(dv_true())
            var safe_time = 480
            var safety = campaign_case_claim(groups[i], "evidence_complete")
            if groups[i] == "astral":
                safe_time = 1890
                safety = dv_all([campaign_case_claim(groups[i], "care_given"), campaign_case_claim(groups[i], "west_passage_checked")])
            if groups[i] == "logistics":
                safe_time = 2010
                safety = dv_all([campaign_case_claim(groups[i], "care_given"), campaign_case_claim(groups[i], "observation_complete")])
            var person_index = 0
            while person_index < rt_count(people):
                if people[person_index].group == groups[i]:
                    reported = campaign_any(reported, campaign_case_claim(groups[i], rt_cat("receipt.", people[person_index].id)))
                person_index = person_index + 1
            let manifest_ready = dv_all([reported, safety, dv_at_least(campaign_clock(), safe_time), campaign_at(actor.id, "living_hall"), dv_fact(dv_ref("demon.body", "state", "manifested"), false)])
            rt_push(goals, campaign_goal(dv_fact(dv_ref("demon.body", "state", "manifested"), true), manifest_ready, source))
            rt_push(goals, campaign_observation_goal(ref, campaign_at(actor.id, "living_hall"), source, 0))
            rt_push(goals, campaign_goal(dv_fact(ref, true), c1_other_release(groups[i], campaign_clock()).premise, source))
            i = i + 1
        rt_push(goals, campaign_goal(dv_fact(dv_ref("demon.body", "state", "manifested"), true), c1dep_manifest_law().premise, source))
        rt_push(goals, campaign_observation_goal(campaign_position_ref(actor.id), dv_true(), source, 0))
        rt_push(goals, campaign_observation_goal(c1dep_ref("outer_released"), campaign_at(actor.id, "living_hall"), source, 0))
        rt_push(goals, campaign_goal(dv_fact(c1dep_ref("outer_released"), true), c1dep_complete(), source))
    var refreshed = []
    var g = 0
    while g < rt_count(goals):
        var goal = goals[g]
        if dv_has_key(goal, "refresh_until") and not dv_has_key(goal, "refresh_refs"):
            var triggers = []
            if dv_has(["detective", "huo", "shen", "su"], actor.id):
                rt_push(triggers, dv_ref("question", "state", "solved_trust"))
            goal = dv_with(goal, "refresh_refs", triggers)
        rt_push(refreshed, goal)
        g = g + 1
    goals = refreshed

    return goals

fn c1dep_install_scene(scene):
    if dv_find(scene, "departure_installed", false):
        return scene
    var physical = dv_store(scene.physical, dv_ref("demon", "state", "location"), dv_field("living_hall"))
    physical = campaign_add_new(physical, campaign_state_object("departure.door", {"outer_released": dv_field(false), "inner_down": dv_field(true), "open": dv_field(false), "quer_has_wire": dv_field(true), "picked_by_quer": dv_field(false), "contract_picked_by_quer": dv_field(false)}))
    physical = campaign_add_new(physical, campaign_state_object("demon.body", {"manifested": dv_field(false), "latch_hand_trace": dv_field("")}))
    physical = dv_store(physical, dv_ref("demon.body", "state", "hand_shape"), dv_field("long-narrow-hand"))
    physical = dv_store(physical, dv_ref("demon.body", "state", "shelf_print_owner"), dv_field("demon"))
    if not dv_read(physical, campaign_access("living_exit")).known:
        physical = dv_store(physical, campaign_access("living_exit"), dv_field(false))
    var objects = ["departure.door", "demon.body", "campaign.access", "campaign.clock", "case.contract", "case.astral", "case.logistics"]
    let four = ["detective", "huo", "shen", "su"]
    var i = 0
    while i < rt_count(four):
        let id = rt_cat("departure.person.", four[i])
        physical = campaign_add_new(physical, campaign_state_object(id, {"crossed": dv_field(false)}))
        rt_push(objects, id)
        i = i + 1
    var actors = []
    var bindings = dv_clone(scene.bindings)
    i = 0
    while i < rt_count(scene.actors):
        var actor = scene.actors[i]
        physical = c1dep_laws(physical, actor.id)
        var mind = actor.mind
        if actor.id == "demon":
            mind = dv_store(mind, dv_ref("demon", "state", "location"), dv_with(dv_field("living_hall"), "basis", [c1dep_source("08_终局.story", 1, "自身所在铜管外端")] ))
        var j = 0
        while j < rt_count(objects):
            mind = campaign_add_new(mind, campaign_local_object(objects[j]))
            if dv_local(bindings, objects[j], actor.id) == "":
                rt_push(bindings, dv_binding(objects[j], objects[j], actor.id))
            j = j + 1
        mind = c1dep_laws(mind, actor.id)
        if dv_has(four, actor.id):
            mind = dv_store(mind, c1dep_ref("outer_released"), dv_with(dv_field(false), "basis", [c1dep_source("08_终局.story", 4, "s10_steps.003")]))
        if actor.id == "demon":
            mind = dv_store(mind, dv_ref("demon.body", "state", "manifested"), dv_with(dv_field(false), "basis", [c1dep_source("08_终局.story", 4, "自身虚实体状态")]))
            mind = dv_store(mind, dv_ref("demon.body", "state", "shelf_print_owner"), dv_with(dv_field("demon"), "basis", [campaign_source("docs/design-standard.md", 0, "本人移物行动")]))
        if actor.id == "quer" and not dv_read(mind, c1dep_ref("quer_has_wire")).known:
            mind = dv_store(mind, c1dep_ref("quer_has_wire"), dv_with(dv_field(true), "basis", [c1dep_source("12_雀儿撬门.story", 9, "quer_opens.003：手里的铁丝")]))
        var actions = c1dep_unify_demon_position(actor.actions)
        var hearing = c1dep_unify_demon_position(dv_find(actor, "hearing_grants", []))
        var transport_index = 0
        while transport_index < rt_count(hearing):
            var grant = hearing[transport_index]
            if grant.speaker == "demon":
                grant = dv_with(grant, "sender_locations", ["living_hall"])
            if actor.id == "demon":
                grant = dv_with(grant, "listener_locations", ["living_hall"])
            hearing = dvs_replace(hearing, transport_index, grant)
            transport_index = transport_index + 1
        var channels = dv_clone(dv_find(actor, "request_channels", []))
        if actor.id == "demon":
            j = 0
            while j < rt_count(actions):
                if dv_has_key(actions[j], "speech"):
                    var action = dv_with(actions[j], "speech", dv_with(actions[j].speech, "emission_location_ref", dv_ref("demon", "state", "location")))
                    action = dv_without(action, "opportunity_requirement")
                    if action.id == "demon.opening":
                        action = dv_without(action, "received_speech_requirement")
                    if dv_has_key(action, "response_topic"):
                        action = dv_with(action, "request_transport", {"channel": "copper.living"})
                    actions = dvs_replace(actions, j, action)
                j = j + 1
            j = 0
            while j < rt_count(hearing):
                hearing = dvs_replace(hearing, j, dv_with(hearing[j], "reception_location_ref", dv_ref("demon", "state", "location")))
                j = j + 1
            j = 0
            while j < rt_count(four):
                rt_push(hearing, {"speaker": four[j], "channel": "", "available_when": campaign_at("demon", "living_hall"), "sender_locations": ["hall"], "listener_locations": ["living_hall"], "reception_location_ref": dv_ref("demon", "state", "location"), "basis": [c1dep_source("08_终局.story", 1, "铜口听取已认定的答复")]})
                rt_push(hearing, {"speaker": four[j], "channel": "copper.living", "available_when": campaign_at("demon", "living_hall"), "sender_locations": ["hall"], "listener_locations": ["living_hall"], "reception_location_ref": dv_ref("demon", "state", "location"), "basis": [c1dep_source("08_终局.story", 1, "铜口接收实际询问")]})
                rt_push(hearing, {"speaker": four[j], "channel": "formal-receipt", "available_when": campaign_at("demon", "living_hall"), "sender_locations": ["hall"], "listener_locations": ["living_hall"], "reception_location_ref": dv_ref("demon", "state", "location"), "basis": [c1dep_source("08_终局.story", 1, "铜口接收实际答辩回执")]})
                rt_push(channels, {"target": four[j], "channel": "copper.living", "available_when": campaign_at("demon", "living_hall"), "basis": [c1dep_source("08_终局.story", 1, "应已经听到的询问向端口回答")]})
                j = j + 1
            actor = dv_with_many(actor, {"location_ref": campaign_position_ref("demon"), "observable_presence_when": dv_fact(dv_ref("demon.body", "state", "manifested"), true)})
        if dv_has(four, actor.id):
            rt_push(hearing, {"speaker": "demon", "channel": "copper.morning", "available_when": dv_true(), "sender_locations": ["living_hall"], "listener_locations": ["hall", "R05", "R06", "R07", "R08", "foyer", "pantry", "corridor"], "basis": [campaign_source("docs/design-standard.md", 506, "醒来时真实听见晨间广播的寝区管路")]})
            j = 0
            while j < rt_count(four):
                if four[j] != actor.id:
                    rt_push(hearing, {"speaker": four[j], "channel": "formal-receipt", "available_when": dv_true(), "sender_locations": ["hall"], "listener_locations": ["hall", "foyer", "pantry", "corridor"], "basis": [c1dep_source("08_终局.story", 1, "乙区实际公开答辩回执") ]})
                j = j + 1
            rt_push(hearing, {"speaker": "demon", "channel": "", "available_when": campaign_at(actor.id, "hall"), "sender_locations": ["living_hall"], "listener_locations": ["hall"], "basis": [c1dep_source("08_终局.story", 1, "铜管实际传声")]})
            rt_push(hearing, {"speaker": "demon", "channel": "copper.living", "available_when": campaign_at(actor.id, "hall"), "sender_locations": ["living_hall"], "listener_locations": ["hall"], "basis": [c1dep_source("08_终局.story", 1, "铜管实际回复")]})
            rt_push(hearing, {"speaker": "demon", "channel": "door.living", "available_when": campaign_any(campaign_at(actor.id, "foyer"), campaign_at(actor.id, "hall")), "sender_locations": ["living_hall"], "listener_locations": ["foyer", "hall"], "basis": [c1dep_source("08_终局.story", 4, "门外抬闩的实际声响")]})
            if actor.id != "detective":
                rt_push(hearing, {"speaker": "detective", "channel": "door.living", "available_when": campaign_any(campaign_at(actor.id, "foyer"), campaign_at(actor.id, "hall")), "sender_locations": ["foyer"], "listener_locations": ["foyer", "hall"], "basis": [c1dep_source("08_终局.story", 8, "s10_open")]})
            rt_push(channels, {"target": "demon", "channel": "copper.living", "available_when": campaign_at(actor.id, "hall"), "basis": [c1dep_source("08_终局.story", 46, "对着铜口询问")]})
            j = 0
            while j < rt_count(actions):
                if dv_has_key(actions[j], "speech"):
                    let listeners = dv_find(actions[j], "listeners", [])
                    if not dv_has(listeners, "demon"):
                        actions = dvs_replace(actions, j, dv_with(actions[j], "listeners", dv_append(listeners, "demon")))
                let request = dv_find(dv_find(actions[j], "speech", []), "request", false)
                if request != false:
                    if request.target == "demon":
                        actions = dvs_replace(actions, j, dv_with_many(actions[j], {"request_transport": {"channel": "copper.living"}, "speech": dv_with(actions[j].speech, "channel", "copper.living"), "opportunity_requirement": {"location": "hall", "participants": [actor.id], "mode": "all-present"}}))
                j = j + 1
            let outsiders = ["quer", "lucian"]
            j = 0
            while j < rt_count(outsiders):
                rt_push(hearing, {"speaker": outsiders[j], "channel": "door.living", "available_when": campaign_at(actor.id, "foyer"), "sender_locations": ["living_hall"], "listener_locations": ["foyer"], "basis": [c1dep_source("11_门外的人.story", 5, "隔门只闻其声")]})
                j = j + 1
            rt_push(channels, {"target": "quer", "channel": "door.living", "available_when": campaign_at(actor.id, "foyer"), "basis": [c1dep_source("11_门外的人.story", 7, "隔门询问")]})
        if actor.id == "quer" or actor.id == "lucian":
            j = 0
            while j < rt_count(four):
                rt_push(hearing, {"speaker": four[j], "channel": "door.living", "available_when": campaign_at(actor.id, "living_hall"), "sender_locations": ["foyer"], "listener_locations": ["living_hall"], "basis": [c1dep_source("11_门外的人.story", 7, "隔门问答")]})
                rt_push(channels, {"target": four[j], "channel": "door.living", "available_when": campaign_at(actor.id, "living_hall"), "basis": [c1dep_source("11_门外的人.story", 8, "隔门回答")]})
                j = j + 1
        let extra = c1dep_actions(actor.id)
        j = 0
        while j < rt_count(extra):
            rt_push(actions, extra[j])
            j = j + 1
        actor = dv_with_many(actor, {"mind": c1dep_unify_demon_position(mind), "policy": c1dep_unify_demon_position(actor.policy), "actions": c1_public_methods(actions), "hearing_grants": hearing, "request_channels": channels})
        if actor.id == "demon":
            actor = dv_with(actor, "policy", dv_with_many(actor.policy, {"wait_chunk_limit": 60, "plan_depth": 1}))
        let goals = c1dep_goals(actor)
        var combined = dv_clone(dv_find(actor.policy, "goals", []))
        j = 0
        while j < rt_count(goals):
            rt_push(combined, goals[j])
            j = j + 1
        actor = dv_with(actor, "policy", dv_with_many(actor.policy, {"goals": combined, "departure_goals": goals}))
        rt_push(actors, actor)
        i = i + 1
    return dv_with_many(scene, {"physical": c1dep_unify_demon_position(physical), "actors": actors, "bindings": bindings, "departure_installed": true, "departure_input_contract": {"demon_body_ref": campaign_position_ref("demon"), "body_origin": "living-hall-outside-isolation-door", "normal_release_requires": c1dep_outer_law().premise, "entered_ref": c1dep_cross_ref("detective")}})


axiom c1dep_manifest_law():
    var ready = dv_all([c1dep_complete(), dv_fact(c1dep_ref("outer_released"), false)])
    let groups = ["contract", "astral", "logistics"]
    var i = 0
    while i < rt_count(groups):
        let group = groups[i]
        let people = c1_other_people()
        var j = 0
        while j < rt_count(people):
            if people[j].group == group:
                var safe_time = 480
                var safety = campaign_case_claim(group, "evidence_complete")
                if group == "astral":
                    safe_time = 1890
                    safety = dv_all([campaign_case_claim(group, "care_given"), campaign_case_claim(group, "west_passage_checked"), c1_other_material(group, "west_air_clear", true), c1_other_material(group, "west_gas", "below-safety-mark"), c1_other_material(group, "ventilation_functional", true)])
                if group == "logistics":
                    safe_time = 2010
                    safety = dv_all([campaign_case_claim(group, "care_given"), campaign_case_claim(group, "observation_complete"), c1_other_material(group, "evening_checked", true), c1_other_material(group, "overnight_stable", true), c1_other_material(group, "fever", false), c1_other_material(group, "wound_stable", true)])
                ready = campaign_any(ready, dv_all([campaign_case_claim(group, rt_cat("receipt.", people[j].id)), dv_fact(campaign_case_ref(group, "formal_release"), false), safety, dv_at_least(campaign_clock(), safe_time)]))
            j = j + 1
        i = i + 1
    return dv_axiom("c1dep_manifest_law", 1, dv_all([campaign_at("demon", "living_hall"), ready, dv_fact(dv_ref("demon.body", "state", "manifested"), false)]), [dv_assign(dv_ref("demon.body", "state", "manifested"), true)])


// Only legacy predicates naming the demon's former hall position are translated.
// Copper hearing still names both real endpoints and never creates another body.
fn c1dep_unify_demon_position(value):
    if not rt_is_list(value):
        return value
    if dv_record_like(value):
        if dv_find(value, "op", "") == "equals" and dv_has_key(value, "ref") and dv_has_key(value, "value"):
            let ref = value.ref
            if dv_record_like(ref):
                if dv_find(ref, "object", "") == "demon" and dv_find(ref, "facet", "") == "state" and dv_find(ref, "field", "") == "location" and value.value == "hall":
                    return dv_with(value, "value", "living_hall")
        var fields = []
        var field_index = 0
        while field_index < rt_count(value):
            rt_push(fields, [value[field_index][0], c1dep_unify_demon_position(value[field_index][1])])
            field_index = field_index + 1
        return fields
    var result = []
    var i = 0
    while i < rt_count(value):
        rt_push(result, c1dep_unify_demon_position(value[i]))
        i = i + 1
    return result


// Executable native opening content. Old .story is provenance, never a runtime input.
// Installation authors the starting scene. It does not execute it, publish observations,
// deliver speech, choose a candidate, adopt short_stay or manufacture an acceptance.
// All candidates use the same real action/law/cost/observation/speech pipeline as play.
// File/catalog order is not a route, a command queue or a choice priority.
// Narrative and private monologue are presentation after an applied action, not testimony.

fn c1_op_source(line, id):
    return campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/01_开场.story", line, id)

fn c1_op_people():
    return ["detective", "huo", "shen", "su"]

fn c1_op_wake_room(id):
    if id == "detective":
        return "R05"
    if id == "huo":
        return "R06"
    if id == "shen":
        return "R07"
    return "R08"

fn c1_op_initial_room(id):
    if id == "detective":
        return c1_op_wake_room(id)
    return "hall"

fn c1_op_name(id, detective_name):
    if id == "detective":
        return detective_name
    if id == "huo":
        return "霍铎"
    if id == "shen":
        return "沈鼎"
    return "苏泠"

fn c1_op_profession(id):
    if id == "detective":
        return "侦探"
    if id == "huo":
        return "钳工"
    if id == "shen":
        return "烧菜"
    return "弹琴"

fn c1_op_person_ref(id, field):
    return dv_ref(rt_cat("opening.personal.", id), "state", field)

fn c1_op_known_speaker_label(mind, id):
    if id == "demon" and dv_truth(mind, c1_op_property("opening.roles", "custodian", "demon")) == "true":
        return "代管者"
    return ""

fn c1_op_property(object, field, value):
    return dv_fact(dv_ref(object, "state", field), value)

fn c1_op_wake_lines(id):
    if id == "detective":
        台词：
            我记得的最后一件事，是上船。
            衣架上挂着一件风衣。右手袖口磨得发亮——我写字时总拿那儿蹭桌沿。是我的。
            先出去，看看这是什么地方。
    if id == "huo":
        台词：
            ……
            手先去摸床沿。床板是榫接的，没用一颗钉子。
            上船以后的事，没了。
            挂钩上缠着机油布。顺时针，三圈半。我缠的。
            起来。
    if id == "shen":
        台词：
            ……
            哎哟，这胳膊。酸得跟揉了半宿面似的。
            昨儿……昨儿干啥了？就记得上了条船。
            桌上那块磨刀石，中间都磨出槽了。谁这么舍得用。
            先找口水喝。
    台词：
        ……
        墙里有一个很低的音，一直没断。
        最后记得的，是船上的汽笛。
        手指在被面上敲。四四拍。不知道敲了多久。
        ……那个音还在。

fn c1_op_person_object(id, detective_name):
    var recall = "boarding"
    if id == "su":
        recall = "ship-whistle"
    var fields = {"name": dv_field(c1_op_name(id, detective_name)), "profession": dv_field(c1_op_profession(id)), "last_recall": dv_field(recall)}
    if id == "su":
        fields = dv_with(fields, "prefers_unsweetened", dv_field(true))
    return campaign_state_object(rt_cat("opening.personal.", id), fields)

fn c1_op_objects(detective_name):
    var result = [campaign_state_object("opening.roles", {"custodian": dv_field("demon"), "teacher": dv_field("demon")}), campaign_state_object("opening.facilities", {"grain_store": dv_field(true), "water_supply": dv_field(true), "fire": dv_field(true), "drawing_exists": dv_field(true), "unheard_sounds_available": dv_field(true)}), campaign_state_object("opening.contracts", {"detective_party_not_custodian": dv_field(true), "full_text": dv_field(campaign_contract_text()), "care_has_term": dv_field(true)}), campaign_state_object("opening.cabinet", {"location": dv_field("hall"), "position_description": dv_field("铜口下方"), "labels": dv_field([detective_name, "霍铎", "沈鼎", "苏泠"])}), campaign_state_object("opening.slot.detective", {"location": dv_field("opening.cabinet"), "label": dv_field(detective_name), "door_open": dv_field(true), "contents": dv_field("empty")}), campaign_state_object("opening.slot.huo", {"location": dv_field("opening.cabinet"), "label": dv_field("霍铎"), "contents": dv_field("test-piece")}), campaign_state_object("opening.slot.shen", {"location": dv_field("opening.cabinet"), "label": dv_field("沈鼎"), "contents": dv_field("silver")}), campaign_state_object("opening.slot.su", {"location": dv_field("opening.cabinet"), "label": dv_field("苏泠"), "contents": dv_field("audition-access")}), campaign_state_object("opening.silver", {"location": dv_field("opening.cabinet"), "authenticity": dv_field("genuine")}), campaign_state_object("opening.testpiece", {"location": dv_field("opening.cabinet")}), campaign_state_object("opening.audition", {"location": dv_field("opening.cabinet")}), campaign_state_object("opening.tea", {"location": dv_field("hall"), "prepared": dv_field(false)}), campaign_state_object("opening.public_history", {"alarm_last_night": dv_field(true), "main_building_call": dv_field(true), "door_latched_this_side": dv_field(true), "caller_not_returned": dv_field(true)})]
    var people = c1_op_people()
    var i = 0
    while i < rt_count(people):
        var id = people[i]
        rt_push(result, c1_op_person_object(id, detective_name))
        rt_push(result, campaign_state_object(rt_cat("opening.cup.", id), {"recipient": dv_field(id), "contents": dv_field("empty")}))
        i = i + 1
    rt_push(result, campaign_state_object("opening.wake.huo", {"bed_join": dv_field("mortise-without-nails"), "oilcloth_wrap": dv_field("clockwise-three-and-a-half"), "own_wrap_recognized": dv_field(true)}))
    rt_push(result, campaign_state_object("opening.wake.shen", {"arms_aching": dv_field(true), "whetstone_grooved": dv_field(true)}))
    rt_push(result, campaign_state_object("opening.wake.su", {"low_wall_tone": dv_field(true), "finger_meter": dv_field("4/4")}))
    return result

// Existing room fixtures gain neutral physical identities. Their names and
// positions are visible; traces, inscriptions, contents and ownership still
// belong to the corresponding paid inspection or introduction.
fn c1_visible_site_objects():
    let sites = [["site:bed:R05", "R05"], ["site:bed:R06", "R06"], ["site:bed:R07", "R07"], ["site:bed:R08", "R08"], ["site:shelf", "R05"], ["site:slate", "hall"], ["site:transmitter", "hall"], ["site:door-floor", "foyer"], ["site:score", "R08"], ["site:pantry-counter", "pantry"]]
    var result = []
    var i = 0
    while i < rt_count(sites):
        rt_push(result, campaign_state_object(sites[i][0], {"location": dv_field(sites[i][1])}))
        i = i + 1
    return result

法则 c1_op_wake，给定 标识：
    名为 rt_cat("c1_op_wake.", 标识)。
    前提 campaign_at(标识, c1_op_wake_room(标识))。
    则 标识 的 "body" 的 "awake" 变为 true。

法则 c1_op_wear_coat：
    当 侦探 位于 "R05"。
    并且 "coat" 的 "identity" 的 "owner" 等于 侦探。
    则 "coat" 的 "worn_by" 变为 侦探。
    并使 "coat" 的 所在地 变为 侦探。

法则 c1_op_prepare_tea：
    前提 campaign_at(沈鼎, 乙区大厅)。
    则 "opening.tea" 的 "prepared" 变为 true。
    并使 "opening.tea" 的 "prepared_by" 变为 沈鼎。

axiom c1_op_serve_tea():
    var effects = []
    var people = c1_op_people()
    var i = 0
    while i < rt_count(people):
        rt_push(effects, dv_assign(dv_ref(rt_cat("opening.cup.", people[i]), "state", "contents"), "tea"))
        rt_push(effects, dv_assign(dv_ref(rt_cat("opening.cup.", people[i]), "state", "served_by"), "shen"))
        i = i + 1
    rt_push(effects, dv_assign(dv_ref("opening.cup.su", "state", "sugar_added"), false))
    return dv_axiom("c1_op_serve_tea", 1, dv_all(dv_pair(campaign_at("shen", "hall"), c1_op_property("opening.tea", "prepared", true))), effects)

法则 c1_op_bite_silver：
    当 沈鼎 位于 乙区大厅。
    并且 c1_op_property("opening.silver", 所在地, "opening.cabinet")。
    则 "opening.silver" 的 "last_bite_by" 变为 沈鼎。
    并使 "opening.silver" 的 "last_test" 变为 "bite"。

法则 c1_op_scrape_testpiece：
    当 霍铎 位于 乙区大厅。
    并且 c1_op_property("opening.testpiece", 所在地, "opening.cabinet")。
    则 "opening.testpiece" 的 "last_scraped_by" 变为 霍铎。

法则 c1_op_play_audition：
    当 苏泠 位于 乙区大厅。
    并且 c1_op_property("opening.audition", 所在地, "opening.cabinet")。
    则 "opening.audition" 的 "last_operator" 变为 苏泠。
    并使 "opening.audition" 的 "last_output" 变为 "audible"。

fn c1_op_rules():
    var result = []
    var people = c1_op_people()
    var i = 0
    while i < rt_count(people):
        rt_push(result, {"name": rt_cat("opening.wake.", people[i]), "law": c1_op_wake(people[i]), "source": c1_memory_source(people[i])})
        i = i + 1
    rt_push(result, {"name": "opening.wear-coat", "law": c1_op_wear_coat(), "source": c1_op_source(6, "s1_wake.006; s2_meet.008")})
    rt_push(result, {"name": "opening.prepare-tea", "law": c1_op_prepare_tea(), "source": c1_op_source(11, "s2_meet.009")})
    rt_push(result, {"name": "opening.serve-tea", "law": c1_op_serve_tea(), "source": c1_op_source(21, "s2_tea.011")})
    rt_push(result, {"name": "opening.bite-silver", "law": c1_op_bite_silver(), "source": c1_op_source(30, "s3_broadcast.020")})
    rt_push(result, {"name": "opening.scrape-testpiece", "law": c1_op_scrape_testpiece(), "source": c1_op_source(30, "s3_broadcast.020")})
    rt_push(result, {"name": "opening.play-audition", "law": c1_op_play_audition(), "source": c1_op_source(30, "s3_broadcast.020")})
    return result

fn c1_op_presentation(id, voice, lines):
    var rendered = []
    var i = 0
    while i < rt_count(lines):
        rt_push(rendered, {"template": lines[i], "bindings": []})
        i = i + 1
    return {"actor": id, "voice": voice, "lines": rendered, "publish_after": "actual-applied-execution", "knowledge_effect": "none"}

fn c1_op_wake_action(id):
    var known = campaign_at(id, c1_op_wake_room(id))
    var grants = [dv_ref(id, "body", "awake"), c1_op_person_ref(id, "name"), c1_op_person_ref(id, "profession"), c1_op_person_ref(id, "last_recall")]
    if id == "detective":
        rt_push(grants, dv_ref("coat", "identity", "owner"))
        rt_push(grants, dv_ref("coat", "state", "name"))
        rt_push(grants, dv_ref("coat", "state", "location"))
        rt_push(grants, dv_ref("coat", "state", "worn_by"))
    if id == "huo":
        rt_push(grants, dv_ref("opening.wake.huo", "state", "bed_join"))
        rt_push(grants, dv_ref("opening.wake.huo", "state", "oilcloth_wrap"))
        rt_push(grants, dv_ref("opening.wake.huo", "state", "own_wrap_recognized"))
    if id == "shen":
        rt_push(grants, dv_ref("opening.wake.shen", "state", "arms_aching"))
        rt_push(grants, dv_ref("opening.wake.shen", "state", "whetstone_grooved"))
    if id == "su":
        rt_push(grants, dv_ref("opening.wake.su", "state", "low_wall_tone"))
        rt_push(grants, dv_ref("opening.wake.su", "state", "finger_meter"))
    var kind = "inspect"
    return dv_with(dv_with(c1_once(campaign_intent_action(rt_cat(id, ".opening.wake"), kind, known, known, rt_cat("opening.wake.", id), grants, "回想醒来前的事", c1_memory_source(id))), "owner", id), "presentation", c1_op_presentation(id, "private-monologue", c1_op_wake_lines(id)))

fn c1_op_physical_action(id, name, law, grants, source, label, surface):
    return dv_with(dv_with(c1_once(campaign_intent_action(name, "inspect", campaign_at(id, "hall"), campaign_at(id, "hall"), law, grants, label, source)), "owner", id), "presentation", c1_op_presentation(id, "visible-action", dv_single(surface)))

fn c1_op_reward_actions():
    return [dv_with(c1_op_physical_action("shen", "shen.opening.bite-silver", "opening.bite-silver", [dv_ref("opening.silver", "state", "authenticity"), dv_ref("opening.silver", "state", "last_bite_by")], c1_op_source(30, "s3_broadcast.020"), "咬验领取柜中的银元", "沈鼎走到柜前，咬了一枚银元。"), "sensory_mode", "tactile-inspection"), c1_op_physical_action("huo", "huo.opening.scrape-testpiece", "opening.scrape-testpiece", [dv_ref("opening.testpiece", "state", "last_scraped_by")], c1_op_source(30, "s3_broadcast.020"), "检视领取柜中的试件", "霍铎把试件举到灯下，刮配合面。"), dv_with(c1_op_physical_action("su", "su.opening.play-audition", "opening.play-audition", [dv_ref("opening.audition", "state", "last_operator"), dv_ref("opening.audition", "state", "last_output")], c1_op_source(30, "s3_broadcast.020"), "操作领取柜旁的试听机", "苏泠摇响了柜旁的试听机。"), "sensory_mode", "auditory-playback")]

fn c1_op_dialogue(id, name, literal, label, surface, source, listeners):
    var known = dv_all(dv_pair(campaign_at(id, "hall"), literal))
    var speech = dv_with(c1_speech(literal, source, "present-opening-scene"), "surface", surface)
    var result = c1_once(dv_with_many(campaign_intent_action(name, "talk", known, known, "", [], label, source), {"speech": speech, "listeners": listeners, "owner": id}))
    if id == "demon":
        return campaign_authorized_speech(result)
    return result

fn c1_op_question(id, name, label, surface, source, listeners):
    var action = c1_op_dialogue(id, name, dv_true(), label, surface, source, listeners)
    return dv_with(action, "speech", dv_with(action.speech, "utterance_type", "question"))

fn c1_op_reward_refs(id):
    if id == "shen":
        return [dv_ref("opening.silver", "state", "authenticity"), dv_ref("opening.silver", "state", "last_bite_by")]
    if id == "huo":
        return [dv_ref("opening.testpiece", "state", "last_scraped_by")]
    return [dv_ref("opening.audition", "state", "last_operator"), dv_ref("opening.audition", "state", "last_output")]

fn c1_op_reward_requirement(id):
    if id == "shen":
        return dv_all(dv_pair(c1_op_property("opening.silver", "authenticity", "genuine"), c1_op_property("opening.silver", "last_bite_by", "shen")))
    if id == "huo":
        return c1_op_property("opening.testpiece", "last_scraped_by", "huo")
    return dv_all(dv_pair(c1_op_property("opening.audition", "last_operator", "su"), c1_op_property("opening.audition", "last_output", "audible")))

// Uses the existing person's rule, confidence and withdrawal; only a concrete personal
// material premise is added. No reward property implies bodily residence in the world.
fn c1_op_pragmatic_policy(id, policy):
    if id == "detective":
        return policy
    var bridges = dv_find(policy, "implicature_bridges", [])
    var result = []
    var i = 0
    while i < rt_count(bridges):
        var bridge = bridges[i]
        if bridge.id == "short_stay":
            bridge = dv_with_many(bridge, {"premise": dv_all(dv_pair(bridge.premise, c1_op_reward_requirement(id))), "basis": dv_append(bridge.basis, c1_op_source(30, "s3_broadcast.020")), "material_scope": "reward-corroboration", "duration_support": "none", "actual_material_refs": c1_op_reward_refs(id)})
        rt_push(result, bridge)
        i = i + 1
    return dv_with(policy, "implicature_bridges", result)

fn c1_op_morning_candidates():
    var result = []
    var people = c1_op_people()
    var i = 0
    while i < rt_count(people):
        if people[i] == "detective":
            rt_push(result, dv_with(c1_op_wake_action(people[i]), "personal_purpose", {"subject": people[i], "id": "current-self-observation", "basis": dv_single(c1_memory_source(people[i]))}))
        i = i + 1
    var wear = c1_once(campaign_intent_action("detective.opening.wear-coat", "inspect", dv_all(dv_pair(campaign_at("detective", "R05"), dv_fact(dv_ref("coat", "identity", "owner"), "detective"))), campaign_at("detective", "R05"), "opening.wear-coat", [dv_ref("coat", "state", "worn_by"), dv_ref("coat", "state", "location")], "穿上风衣", c1_op_source(6, "s1_wake.006; s2_meet.008")))
    rt_push(result, dv_with(wear, "owner", "detective"))
    rt_push(result, c1_op_physical_action("shen", "shen.opening.prepare-tea", "opening.prepare-tea", [dv_ref("opening.tea", "state", "prepared"), dv_ref("opening.tea", "state", "prepared_by")], c1_op_source(11, "s2_meet.009"), "泡茶", "沈鼎把茶泡上。"))
    return result

fn c1_op_meet_candidates():
    var listeners = c1_op_people()
    var welcome = c1_op_dialogue("shen", "shen.opening.welcome", c1_op_property("opening.tea", "prepared", true), "招呼刚醒来的同伴", "哟，又醒一个。进来坐，茶刚泡上。", c1_op_source(11, "s2_meet.009"), listeners)
    var shen_name = c1_op_dialogue("shen", "shen.opening.introduce", dv_all(dv_pair(dv_fact(c1_op_person_ref("shen", "name"), "沈鼎"), dv_fact(c1_op_person_ref("shen", "profession"), "烧菜"))), "向同伴自我介绍", "我姓沈，沈鼎，烧菜的。", c1_op_source(12, "s2_meet.010"), listeners)
    var huo_name = c1_op_dialogue("huo", "huo.opening.introduce", dv_all(dv_pair(dv_fact(c1_op_person_ref("huo", "name"), "霍铎"), dv_fact(c1_op_person_ref("huo", "profession"), "钳工"))), "向同伴自我介绍", "……霍铎。钳工。", c1_op_source(13, "s2_meet.011"), listeners)
    var su_name = c1_op_dialogue("su", "su.opening.introduce", dv_all(dv_pair(dv_fact(c1_op_person_ref("su", "name"), "苏泠"), dv_fact(c1_op_person_ref("su", "profession"), "弹琴"))), "向同伴自我介绍", "苏泠。弹琴的。", c1_op_source(14, "s2_meet.006"), listeners)
    var ask_name = c1_op_question("shen", "shen.opening.ask-name", "询问刚到同伴的姓名", "你呢？穿这么一身风衣，不像跑船的。", c1_op_source(15, "s2_meet.008"), dv_single("detective"))
    return [welcome, shen_name, huo_name, su_name, ask_name]

fn c1_op_tea_candidates(detective_name):
    var listeners = c1_op_people()
    var introduce = c1_op_dialogue("detective", "detective.opening.introduce", dv_all(dv_pair(dv_fact(c1_op_person_ref("detective", "name"), detective_name), dv_fact(c1_op_person_ref("detective", "profession"), "侦探"))), "向同伴自我介绍", rt_cat(detective_name, "。……做侦探的。"), c1_op_source(19, "s2_tea.001"), listeners)
    var memory = c1_op_dialogue("shen", "shen.opening.memory-report", dv_fact(c1_op_person_ref("shen", "last_recall"), "boarding"), "询问并交流登船记忆", "都还记得啥？我就记得上船。下了跳板往后，脑子里白茫茫一片。", c1_op_source(20, "s2_tea.016"), listeners)
    var serve = c1_op_physical_action("shen", "shen.opening.serve-tea", "opening.serve-tea", [dv_ref("opening.cup.su", "state", "contents"), dv_ref("opening.cup.su", "state", "sugar_added"), dv_ref("opening.cup.su", "state", "served_by")], c1_op_source(21, "s2_tea.011"), "将茶分给在场同伴", "他把茶一杯一杯推过来。推到苏泠面前的那杯，他没有放糖。")
    serve = dv_with_many(serve, {"public_observers": listeners, "public_grants": [dv_ref("opening.cup.su", "state", "contents"), dv_ref("opening.cup.su", "state", "sugar_added"), dv_ref("opening.cup.su", "state", "served_by")]})
    var su_ask = c1_op_question("su", "su.opening.ask-sugar", "询问泡茶的习惯", "……你怎么知道我喝茶不放糖？", c1_op_source(22, "s2_tea.012"), listeners)
    su_ask = dv_with_many(su_ask, {"precondition": dv_all(dv_pair(campaign_at("su", "hall"), c1_op_property("opening.cup.su", "sugar_added", false))), "authority_precondition": dv_all(dv_pair(campaign_at("su", "hall"), c1_op_property("opening.cup.su", "sugar_added", false)))})
    var shen_reply = c1_op_dialogue("shen", "shen.opening.body-habit", c1_op_property("opening.cup.su", "served_by", "shen"), "说明泡茶的习惯", "嗯？……顺手吧。", c1_op_source(23, "s2_tea.013"), listeners)
    shen_reply = dv_with(shen_reply, "speech", dv_with(shen_reply.speech, "scope", "own-bodily-action-appraisal-not-recovered-familiarity"))
    return [introduce, memory, serve, su_ask, shen_reply]

fn c1_op_broadcast_candidates():
    var action = c1_opening_action()
    var roles = dv_all(dv_pair(c1_op_property("opening.roles", "custodian", "demon"), c1_op_property("opening.roles", "teacher", "demon")))
    let history = dv_all([c1_op_property("opening.public_history", "alarm_last_night", true), c1_op_property("opening.public_history", "main_building_call", true), c1_op_property("opening.public_history", "door_latched_this_side", true), c1_op_property("opening.public_history", "caller_not_returned", true)])
    action = dv_with(action, "speech", dv_with_many(action.speech, {"literal_ast": dv_all([roles, action.speech.literal_ast, history, c1_op_property("opening.contracts", "care_has_term", true)]), "channel": "copper.morning", "surface": "诸位晨安。我是此地的代管者，也是诸位的教师。诸位初涉斯地，记忆有缺，并非伤病，请勿惊惶。诸位所需之知，我会教。此地对诸位的照料，有其期限。我所立之规，已贴在活动厅的公告框里。\n昨夜警铃骤起。主楼曾有人向诸位呼喊。通往主楼之门，在诸位这一侧闩上了。那人再没有回来。\n此为始业之问：门是谁闩上的？闩门之时，此人可曾听见门外的呼喊？每一问，说一句结论，再拿出一件撑得住它的东西。痕迹还在。答案备好了，到铜口来。"}))
    // This notice is the authored 08:00 boundary. It still has a selected,
    // executed and completed action; opening never preloads a listener's mind.
    action = dv_with_many(action, {"kind": "opening.notice", "obligation": true, "obligation_due": 480, "obligation_basis": [campaign_source("docs/design-standard.md", 506, "08:00-morning-broadcast-and-inaugural-question")], "public_grants": [dv_ref("question", "state", "open_identity"), dv_ref("question", "state", "current"), dv_ref("question", "state", "original"), dv_ref("question", "state", "requires_evidence"), dv_ref("question", "state", "outstanding_complete")], "presentation": c1_op_presentation("demon", "visible-action", ["墙内的铜管传来轻轻一声咳嗽。"]), "source_narration_limit": "no-unperformed-listener-reactions"})
    return [dv_with(action, "owner", "demon")]

fn c1_op_reward_candidates(detective_name):
    var cabinet_claim = dv_all(dv_pair(c1_op_property("opening.cabinet", "position_description", "铜口下方"), c1_op_property("opening.cabinet", "labels", [detective_name, "霍铎", "沈鼎", "苏泠"])))
    var invitation = c1_op_dialogue("demon", "demon.opening.reward-invitation", cabinet_claim, "邀请领取报偿", "诸位的报偿，就在铜口下方的领取柜里，各有名签。请亲手核验。", c1_op_source(29, "s4_rewards.004"), c1_op_people())
    invitation = dv_with(invitation, "speech", dv_with(invitation.speech, "shown_material_refs", [dv_ref("opening.cabinet", "state", "position_description"), dv_ref("opening.cabinet", "state", "labels")]))
    var candidates = [invitation]
    var rewards = c1_op_reward_actions()
    var ids = ["shen", "huo", "su"]
    var i = 0
    while i < rt_count(rewards):
        rt_push(candidates, rewards[i])
        i = i + 1
    return candidates

fn c1_op_desire_candidates(detective_name):
    var material_claim = dv_all([c1_op_property("opening.silver", "location", "opening.cabinet"), c1_op_property("opening.facilities", "grain_store", true), c1_op_property("opening.facilities", "water_supply", true), c1_op_property("opening.facilities", "fire", true), c1_op_property("opening.facilities", "drawing_exists", true), c1_op_property("opening.facilities", "unheard_sounds_available", true)])
    var offer = c1_op_dialogue("demon", "demon.opening.desire-offer", material_claim, "介绍岛上的工作与资源", "银元在柜里，沈师傅。粮仓、水窖、灶火，岛上也都有。那张减少不可逆损失的闭式热机图纸，此地有人画过，霍先生。此地还有诸位从未听过的声音，苏小姐。", c1_op_source(31, "s3_broadcast.021"), c1_op_people())
    offer = dv_with(offer, "speech", dv_with(offer.speech, "shown_material_refs", [dv_ref("opening.silver", "state", "location"), dv_ref("opening.testpiece", "state", "location"), dv_ref("opening.audition", "state", "location")]))
    var empty_slot = c1_once(campaign_intent_action("detective.opening.empty-slot", "inspect", campaign_at("detective", "hall"), campaign_at("detective", "hall"), "", [dv_ref("opening.cabinet", "state", "location"), dv_ref("opening.slot.detective", "state", "location"), dv_ref("opening.slot.detective", "state", "label"), dv_ref("opening.slot.detective", "state", "door_open"), dv_ref("opening.slot.detective", "state", "contents")], "检视自己的标签柜", c1_op_source(35, "s4_rewards.020")))
    empty_slot = dv_with(dv_with(empty_slot, "owner", "detective"), "presentation", c1_op_presentation("detective", "private-monologue", ["柜上有一格贴着我的名字。小门开着，里面什么也没有。"]))
    var ask_reward = c1_op_question("detective", "detective.opening.ask-reward", "询问自己的报偿", "那我的呢？", c1_op_source(36, "s4_rewards.016"), dv_single("demon"))
    ask_reward = dv_with(ask_reward, "precondition", dv_all(dv_pair(campaign_at("detective", "hall"), c1_op_property("opening.slot.detective", "contents", "empty"))))
    var contract = c1_op_dialogue("demon", "demon.opening.other-contract", c1_op_property("opening.contracts", "detective_party_not_custodian", true), "答复立约者的问题", "与你立约的，不是我。", c1_op_source(37, "s4_rewards.017"), c1_op_people())
    var shen_keep = c1_op_dialogue("shen", "shen.opening.accept-work", c1_op_reward_requirement("shen"), "答应继续做饭", "……钱是真的。这活我接着干。", c1_op_source(39, "s3_broadcast.022"), c1_op_people())
    shen_keep = dv_with(shen_keep, "speech", dv_with(shen_keep.speech, "intention_report", {"subject": "shen", "purpose": "keep-working", "basis": c1_op_reward_refs("shen"), "automatic_world_effect": "none"}))
    var huo_stay = c1_op_dialogue("huo", "huo.opening.seek-drawing", c1_op_reward_requirement("huo"), "表明留下寻找图纸的意愿", "我留下。那张图，我得找。", c1_op_source(40, "s4_rewards.023"), c1_op_people())
    huo_stay = dv_with(huo_stay, "speech", dv_with(huo_stay.speech, "intention_report", {"subject": "huo", "purpose": "seek-offered-drawing", "basis": c1_op_reward_refs("huo"), "automatic_world_effect": "none"}))
    return [offer, empty_slot, ask_reward, contract, shen_keep, huo_stay]

fn c1_op_investigation_candidates():
    var first = c1_op_dialogue("demon", "demon.opening.public-alarm", dv_all(dv_pair(c1_op_property("opening.public_history", "alarm_last_night", true), c1_op_property("opening.public_history", "main_building_call", true))), "说明昨夜的警铃与呼声", "昨夜警铃骤起。主楼曾有人向诸位呼喊。", c1_op_source(44, "s5_question.002"), c1_op_people())
    var second = c1_op_dialogue("demon", "demon.opening.public-latch", dv_all(dv_pair(c1_op_property("opening.public_history", "door_latched_this_side", true), c1_op_property("opening.public_history", "caller_not_returned", true))), "说明昨夜门闩的情况", "通往主楼之门，在诸位这一侧闩上了。那人再没有回来。", c1_op_source(45, "s5_question.003"), c1_op_people())
    var question = c1_question_action("prompt", c1_op_source(46, "s5_question.004"), true)
    question = dv_with(question, "speech", dv_with(question.speech, "surface", "此为始业之问：门是谁闩上的？闩门之时，此人可曾听见门外的呼喊？"))
    var invitation = c1_op_dialogue("demon", "demon.opening.investigate-invitation", dv_true(), "邀请调查并提交答复", "记不得，并不妨碍作答。痕迹还在。答案备好了，到铜口来。", c1_op_source(47, "s5_question.017"), c1_op_people())
    invitation = dv_with(invitation, "speech", dv_with(invitation.speech, "utterance_type", "invitation"))
    return [first, second, dv_with(question, "owner", "demon"), invitation]

// Conditional stance reports require the existing owner interpretations receipt.
// They remain ordinary optional candidates and must not be projected as facts
// about bodily residence. Generic eligibility checks the actual owner receipt.
fn c1_op_maintenance_actions():
    var ids = ["huo", "shen", "su"]
    var surfaces = ["试件，我刮过。初涉……我先按刚来这里办。", "钱是真的，我咬过。茶么，是顺手。……我还是按咱们才刚来想。", "……试听机里的声音，我听见了。初涉，我先按刚到这里听着。"]
    var result = []
    var i = 0
    while i < rt_count(ids):
        var id = ids[i]
        var action = c1_op_dialogue(id, rt_cat(id, ".opening.maintain-interpretation"), c1_op_reward_requirement(id), "坚持本人现有的解释", surfaces[i], c1_op_source(30, "s3_broadcast.020; authoring-attitude-report"), c1_op_people())
        var attitude = {"subject": id, "interpretation_id": "short_stay", "required_status": "accepted", "basis": c1_op_reward_refs(id), "source_event_requirement": "owner-existing-interpretation-receipt"}
        action = dv_with_many(action, {"owner_interpretation_requirement": attitude, "speech": dv_with_many(action.speech, {"utterance_type": "attitude-report", "attitude_report": attitude, "asserted_body_duration": "none"})})
        rt_push(result, action)
        i = i + 1
    return result

fn c1_op_scene(detective_name):
    return {"id": "chapter1-opening", "selection": "flat-owner-candidates", "input_slot": {"key": "detective_name", "value": detective_name, "source": c1_op_source(19, "s2_tea.001")}, "source_refs": [c1_op_source(4, "s1_wake"), c1_op_source(10, "s2_meet"), c1_op_source(18, "s2_tea"), c1_op_source(26, "s3_broadcast"), c1_op_source(43, "s5_question")], "candidate_contract": {"choice": "owner-policy-desires-purpose-and-actual-knowledge", "execution": "same-real-law-observation-speech-path-as-other-actions", "opportunity_requirement": "check-actual-owner-visible-context; never-place-a-peer", "received_speech_requirement": "check-owner-existing-hearing-parse-receipts", "desire_requirement": "check-owner-declared-desire-and-source", "request": "questions-create-requests-only-by-actual-hearing; replies-use-response_topic", "attitude_requirement": "check-owner-existing-interpretation-receipt", "presentation": "publish-only-after-applied-action; no-extra-knowledge", "not_happened": "leave-unselected-unheard-unperformed-interactions-unhappened", "time": "retain-initial-480-and-caller-360-minute-budget", "initial_state": "already-awake-at-current-origin; self-observations-occur-now"}}

fn c1_op_install_world(world, detective_name):
    var result = c1_add_objects(world, c1_op_objects(detective_name))
    var people = c1_op_people()
    var i = 0
    while i < rt_count(people):
        result = dv_store(result, dv_ref(people[i], "state", "location"), dv_field(c1_op_initial_room(people[i])))
        result = dv_store(result, dv_ref(people[i], "body", "awake"), dv_with(dv_field(true), "basis", dv_single(c1_memory_source(people[i]))))
        i = i + 1
    var rules = c1_op_rules()
    i = 0
    while i < rt_count(rules):
        result = dv_adopt(result, campaign_method(rules[i].name, rules[i].law), "enforce", 1, dv_single(rules[i].source))
        i = i + 1
    return result

fn c1_op_install_actor(actor, detective_name):
    var id = actor.id
    var mind = actor.mind
    var objects = c1_op_objects(detective_name)
    var i = 0
    while i < rt_count(objects):
        mind = dv_add_object(mind, campaign_local_object(objects[i].id))
        i = i + 1
    if dv_has(c1_op_people(), id):
        mind = dv_store(mind, dv_ref(id, "state", "location"), dv_field(c1_op_initial_room(id)))
        actor = dv_with(actor, "location", c1_op_initial_room(id))
        var own = c1_op_person_object(id, detective_name)
        var fields = own.facets.state
        var self_source = c1_op_source(19, "s2_tea.001;self-name-and-profession")
        if id == "huo":
            self_source = c1_op_source(13, "s2_meet.011")
        if id == "shen":
            self_source = c1_op_source(12, "s2_meet.010")
        if id == "su":
            self_source = c1_op_source(14, "s2_meet.006")
        var k = 0
        while k < rt_count(fields):
            var basis = dv_single(self_source)
            if fields[k][0] == "last_recall":
                basis = dv_single(c1_memory_source(id))
            if fields[k][0] == "prefers_unsweetened":
                basis = [c1_op_source(22, "s2_tea.012; own-taste")]
            mind = dv_store(mind, c1_op_person_ref(id, fields[k][0]), dv_with(fields[k][1], "basis", basis))
            k = k + 1
        if id == "detective":
            mind = dv_store(mind, dv_ref("coat", "identity", "owner"), dv_unknown())
        actor = dv_with(actor, "policy", c1_op_pragmatic_policy(id, actor.policy))
    if id == "demon":
        var whitelist = ["opening.roles", "opening.facilities", "opening.contracts", "opening.cabinet", "opening.silver", "opening.testpiece", "opening.audition", "opening.public_history"]
        i = 0
        while i < rt_count(objects):
            if dv_has(whitelist, objects[i].id):
                var fields = objects[i].facets.state
                var j = 0
                while j < rt_count(fields):
                    var ref = dv_ref(objects[i].id, "state", fields[j][0])
                    mind = dv_store(mind, ref, dv_with(fields[j][1], "basis", [c1_op_source(28, "s3_broadcast.019"), c1_op_source(31, "s3_broadcast.021;custodian-owned-inventory")]))
                    j = j + 1
            i = i + 1
    var rules = c1_op_rules()
    i = 0
    while i < rt_count(rules):
        if c1_op_rule_owner(rules[i].name) == id:
            mind = dv_adopt(mind, campaign_method(rules[i].name, rules[i].law), "predict", 1, dv_single(rules[i].source))
        i = i + 1
    if dv_has(c1_op_people(), id):
        mind = dv_store(mind, dv_ref(id, "body", "awake"), dv_with(dv_field(true), "basis", dv_single(c1_memory_source(id))))
    var pool = c1_op_flat_candidates(detective_name)
    var replacements = []
    i = 0
    while i < rt_count(pool):
        if pool[i].owner == id:
            rt_push(replacements, pool[i])
        i = i + 1
    var actions = []
    i = 0
    while i < rt_count(actor.actions):
        var old = actor.actions[i]
        var replace = dv_has(["demon.opening.memory-only", "demon.opening.contrary"], old.id)
        var j = 0
        while j < rt_count(replacements):
            if old.id == replacements[j].id:
                replace = true
            j = j + 1
        if not replace:
            rt_push(actions, old)
        i = i + 1
    i = 0
    while i < rt_count(replacements):
        rt_push(actions, replacements[i])
        i = i + 1
    actor = dv_with_many(actor, {"mind": mind, "actions": actions})
    return c1_op_install_purposes(actor)

fn c1_op_bindings(detective_name):
    var result = []
    var people = ["detective", "huo", "shen", "su", "demon"]
    var objects = c1_op_objects(detective_name)
    var i = 0
    while i < rt_count(people):
        var j = 0
        while j < rt_count(objects):
            rt_push(result, dv_binding(objects[j].id, objects[j].id, people[i]))
            j = j + 1
        i = i + 1
    return result

fn c1_opening_install_scene(scenario, detective_name):
    dv_require(not (detective_name == ""), "Opening requires an actual detective name")
    var result = dv_with(scenario, "physical", c1_op_install_world(scenario.physical, detective_name))
    var actors = []
    var i = 0
    while i < rt_count(scenario.actors):
        rt_push(actors, c1_op_install_actor(scenario.actors[i], detective_name))
        i = i + 1
    var bindings = scenario.bindings
    var new_bindings = c1_op_bindings(detective_name)
    i = 0
    while i < rt_count(new_bindings):
        rt_push(bindings, new_bindings[i])
        i = i + 1
    return dv_with_many(result, {"actors": actors, "bindings": bindings, "opening_scene": c1_op_scene(detective_name)})

// Declarations below describe each person's reasons, never the author's next step.
fn c1_op_desire(id):
    if id == "detective":
        return {"id": "understand-own-presence", "surface": "弄清自己为何在此", "basis": [campaign_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/01_侦探.story", 11, "detective.desire")]}
    if id == "huo":
        return {"id": "seek-power-drawing", "surface": "减少不可逆损失的闭式热机图纸", "basis": [campaign_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/02_霍铎.story", 10, "huo.desire")]}
    if id == "shen":
        return {"id": "protect-companions", "surface": "安稳，护住身边的人", "basis": [campaign_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/03_沈鼎.story", 10, "shen.desire")]}
    return {"id": "seek-unheard-sounds", "surface": "从未听过的声音", "basis": [campaign_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/04_苏泠.story", 10, "su.desire")]}

fn c1_op_rule_owner(name):
    if name == "opening.wake.detective" or name == "opening.wear-coat":
        return "detective"
    if name == "opening.wake.huo" or name == "opening.scrape-testpiece":
        return "huo"
    if name == "opening.wake.shen" or name == "opening.prepare-tea" or name == "opening.serve-tea" or name == "opening.bite-silver":
        return "shen"
    return "su"

fn c1_op_reward_object(id):
    if id == "shen":
        return "opening.silver"
    if id == "huo":
        return "opening.testpiece"
    return "opening.audition"

fn c1_op_invitation_requirement():
    return {"speaker": "demon", "action_id": "demon.opening.reward-invitation", "receipt_kind": "actual-listener-parse"}

fn c1_op_slot_inspections():
    var ids = ["huo", "shen", "su", "detective"]
    var result = []
    var i = 0
    while i < rt_count(ids):
        var id = ids[i]
        var known = dv_all(dv_pair(campaign_at(id, "hall"), c1_op_property("opening.cabinet", "position_description", "铜口下方")))
        var slot = rt_cat("opening.slot.", id)
        var refs = [dv_ref("opening.cabinet", "state", "location"), dv_ref(slot, "state", "location"), dv_ref(slot, "state", "label"), dv_ref(slot, "state", "contents")]
        if id != "detective":
            rt_push(refs, dv_ref(c1_op_reward_object(id), "state", "location"))
        var action = c1_once(campaign_intent_action(rt_cat(id, ".opening.inspect-reward-slot"), "inspect", known, campaign_at(id, "hall"), "", refs, "检视本人领取柜", c1_op_source(29, "s4_rewards.004")))
        rt_push(result, dv_with_many(action, {"owner": id, "received_speech_requirement": c1_op_invitation_requirement(), "personal_purpose": {"subject": id, "id": "verify-personally-addressed-offer", "basis": [c1_op_source(29, "s4_rewards.004")]}}))
        i = i + 1
    var look = c1_once(campaign_intent_action("shen.opening.look-arrival", "inspect", campaign_at("shen", "hall"), dv_all(dv_pair(campaign_at("shen", "hall"), campaign_at("detective", "hall"))), "", [dv_ref("coat", "state", "worn_by")], "查看刚到同伴的衣着", c1_op_source(15, "s2_meet.008")))
    rt_push(result, dv_with_many(look, {"owner": "shen", "opportunity_requirement": {"location": "hall", "participants": ["detective"], "mode": "all-present"}}))
    return result

fn c1_op_request(action, target, topic):
    return dv_with(action, "speech", dv_with(action.speech, "request", {"target": target, "topic": topic}))

fn c1_op_appropriate_candidate(action):
    var id = action.owner
    var name = action.id
    if action.law != "":
        action = dv_with(action, "predict_law", action.law)
    if dv_has_key(action, "speech"):
        var targets = []
        var listeners = dv_find(action, "listeners", [])
        var i = 0
        while i < rt_count(listeners):
            if listeners[i] != id:
                rt_push(targets, listeners[i])
            i = i + 1
        action = dv_with(action, "opportunity_requirement", {"location": "hall", "participants": targets, "mode": "at-least-one-present"})
    if name == "shen.opening.welcome" or name == "shen.opening.introduce" or name == "huo.opening.introduce" or name == "su.opening.introduce" or name == "shen.opening.memory-report":
        action = dv_with_many(action, {"response_topic": "opening.meeting", "offer_to": "detective", "opportunity_requirement": {"location": "hall", "participants": ["detective"], "mode": "all-present"}})
    if name == "shen.opening.introduce":
        action = dv_with(action, "completed_action_requirement", {"action_id": "shen.opening.welcome"})
    if name == "shen.opening.serve-tea":
        action = dv_with(action, "completed_action_requirement", {"action_id": "shen.opening.introduce"})
    if name == "shen.opening.ask-name":
        action = dv_with(action, "precondition", dv_all(dv_pair(action.precondition, dv_fact(dv_ref("coat", "state", "worn_by"), "detective"))))
        action = dv_with(action, "speech", dv_with(action.speech, "presuppositions", [dv_fact(dv_ref("coat", "state", "worn_by"), "detective")]))
        action = c1_op_request(action, "detective", "opening.self-introduction")
        action = dv_with(action, "opportunity_requirement", {"location": "hall", "participants": ["detective"], "mode": "all-present"})
        action = dv_with_many(action, {"completed_action_requirement": {"action_id": "shen.opening.introduce"}, "suppress_after_received_speech": {"speaker": "detective", "action_id": "detective.opening.introduce"}})
    if name == "detective.opening.introduce":
        // An actually completed self-introduction also answers a later-arriving name request.
        action = dv_with_many(action, {"response_topic": "opening.self-introduction", "response_once": true, "received_speech_requirement": {"any_of": [{"speaker": "shen", "action_id": "shen.opening.welcome"}, {"speaker": "shen", "action_id": "shen.opening.introduce"}, {"speaker": "shen", "action_id": "shen.opening.ask-name"}]}})
    if name == "su.opening.ask-sugar":
        action = dv_with(action, "precondition", dv_all(dv_pair(action.precondition, dv_fact(c1_op_person_ref("su", "prefers_unsweetened"), true))))
        action = dv_with(action, "speech", dv_with(action.speech, "presuppositions", [dv_fact(c1_op_person_ref("su", "prefers_unsweetened"), true), c1_op_property("opening.cup.su", "sugar_added", false)]))
        action = c1_op_request(action, "shen", "opening.sugar-habit")
    if name == "shen.opening.body-habit":
        action = dv_with(action, "response_topic", "opening.sugar-habit")
    if name == "detective.opening.ask-reward":
        action = c1_op_request(action, "demon", "opening.detective-reward")
    if name == "demon.opening.other-contract":
        action = dv_with(action, "response_topic", "opening.detective-reward")
    if name == "shen.opening.serve-tea":
        action = dv_with_many(action, {"precondition": dv_all(dv_pair(action.precondition, c1_op_property("opening.tea", "prepared", true))), "authority_precondition": dv_all([action.authority_precondition, campaign_at("detective", "hall"), campaign_at("huo", "hall"), campaign_at("su", "hall")]), "opportunity_requirement": {"location": "hall", "participants": ["detective", "huo", "su"], "mode": "all-present"}})
    if name == "demon.question.prompt":
        action = dv_with(action, "opportunity_requirement", {"location": "hall", "participants": c1_op_people(), "mode": "all-present"})
    if name == "demon.opening":
        action = dv_without(action, "opportunity_requirement")
    let broadcasts = ["demon.opening", "demon.opening.reward-invitation", "demon.opening.desire-offer"]
    var broadcast_index = 1
    while broadcast_index < rt_count(broadcasts):
        if name == broadcasts[broadcast_index]:
            action = dv_with(action, "completed_action_requirement", {"action_id": broadcasts[broadcast_index - 1]})
        broadcast_index = broadcast_index + 1
    if name == "shen.opening.bite-silver" or name == "huo.opening.scrape-testpiece" or name == "su.opening.play-audition":
        action = dv_with_many(action, {"precondition": dv_all([action.precondition, c1_op_property("opening.cabinet", "position_description", "铜口下方"), c1_op_property(c1_op_reward_object(id), "location", "opening.cabinet")]), "received_speech_requirement": c1_op_invitation_requirement(), "desire_requirement": {"subject": id, "desire_id": c1_op_desire(id).id, "basis": c1_op_desire(id).basis}, "personal_purpose": {"subject": id, "id": "inspect-relevant-offered-material", "basis": c1_op_desire(id).basis}})
    if name == "shen.opening.accept-work" or name == "huo.opening.seek-drawing":
        action = dv_with(action, "desire_requirement", {"subject": id, "desire_id": c1_op_desire(id).id, "basis": c1_op_desire(id).basis})
    if name == "huo.opening.seek-drawing":
        action = dv_with(action, "precondition", dv_all(dv_pair(action.precondition, c1_op_property("opening.facilities", "drawing_exists", true))))
    if name == "shen.opening.maintain-interpretation":
        action = dv_with(action, "precondition", dv_all(dv_pair(action.precondition, c1_op_property("opening.cup.su", "served_by", "shen"))))
    return action

fn c1_op_flat_candidates(detective_name):
    var catalogs = [c1_op_morning_candidates(), c1_op_meet_candidates(), c1_op_tea_candidates(detective_name), c1_op_broadcast_candidates(), c1_op_reward_candidates(detective_name), c1_op_desire_candidates(detective_name), c1_op_slot_inspections(), c1_op_maintenance_actions(), c1_op_contract_candidates()]
    var result = []
    var i = 0
    while i < rt_count(catalogs):
        var rows = catalogs[i]
        var j = 0
        while j < rt_count(rows):
            rt_push(result, c1_op_appropriate_candidate(rows[j]))
            j = j + 1
        i = i + 1
    rt_push(result, dv_with(dv_with(c1_inspect_E11("detective"), "owner", "detective"), "presentation", c1_op_presentation("detective", "visible-inspection", dv_single(c1_visible_E11()))))
    rt_push(result, dv_with(dv_with(c1_inspect_E12("detective"), "owner", "detective"), "presentation", c1_op_presentation("detective", "visible-inspection", dv_single(c1_visible_E12()))))
    return result

fn c1_op_know_goal(id, ref, basis, available):
    return {"kind": "know", "scope": "personal", "question": "opening_own", "ref": ref, "available_when": available, "basis": basis, "owner": id}

fn c1_op_achieve_goal(id, proposition, basis, available):
    return {"kind": "achieve", "scope": "personal", "question": "opening_own", "proposition": proposition, "available_when": available, "basis": basis, "owner": id}

fn c1_op_communicate_goal(id, method, basis, available):
    return {"kind": "communicate", "scope": "personal", "method_id": method, "available_when": available, "basis": basis, "requires_argument": false, "owner": id}

fn c1_op_owned_goals(id):
    var result = []
    if dv_has(c1_op_people(), id):
        var awake = dv_fact(dv_ref(id, "body", "awake"), true)
        var basis = dv_single(c1_memory_source(id))
        rt_push(result, c1_op_achieve_goal(id, dv_not(campaign_at(id, c1_op_wake_room(id))), basis, awake))
        rt_push(result, c1_op_achieve_goal(id, campaign_at(id, "hall"), basis, dv_all([dv_not(campaign_at(id, c1_op_wake_room(id))), dv_fact(dv_ref("departure.door", "state", "outer_released"), false)])))
        if id == "detective":
            rt_push(result, c1_op_know_goal(id, dv_ref("coat", "identity", "owner"), [c1_op_source(6, "s1_wake.006")], campaign_at(id, "R05")))
            rt_push(result, c1_op_achieve_goal(id, dv_fact(dv_ref("coat", "state", "worn_by"), "detective"), [c1_op_source(6, "s1_wake.006; s2_meet.008")], campaign_at(id, "R05")))
            rt_push(result, c1_op_know_goal(id, dv_ref("opening.slot.detective", "state", "contents"), [c1_op_source(35, "s4_rewards.020")], c1_op_property("opening.cabinet", "position_description", "铜口下方")))
            rt_push(result, c1_op_communicate_goal(id, "detective.opening.introduce", [c1_op_source(19, "s2_tea.001")], campaign_at(id, "hall")))
            rt_push(result, c1_op_communicate_goal(id, "detective.opening.ask-reward", [c1_op_source(36, "s4_rewards.016")], c1_op_property("opening.slot.detective", "contents", "empty")))
        if id == "huo":
            rt_push(result, c1_op_know_goal(id, dv_ref("opening.wake.huo", "state", "oilcloth_wrap"), basis, campaign_at(id, "R06")))
            rt_push(result, c1_op_communicate_goal(id, "huo.opening.seek-drawing", c1_op_desire(id).basis, c1_op_reward_requirement(id)))
        if id == "shen":
            rt_push(result, c1_op_know_goal(id, dv_ref("opening.wake.shen", "state", "whetstone_grooved"), basis, campaign_at(id, "R07")))
            rt_push(result, c1_op_achieve_goal(id, c1_op_property("opening.tea", "prepared", true), [c1_op_source(11, "s2_meet.009")], campaign_at(id, "hall")))
            rt_push(result, c1_op_achieve_goal(id, c1_op_property("opening.cup.su", "contents", "tea"), [c1_op_source(21, "s2_tea.011")], c1_op_property("opening.tea", "prepared", true)))
            rt_push(result, c1_op_communicate_goal(id, "shen.opening.welcome", [c1_op_source(11, "s2_meet.009")], c1_op_property("opening.tea", "prepared", true)))
            rt_push(result, c1_op_know_goal(id, dv_ref("coat", "state", "worn_by"), [c1_op_source(15, "s2_meet.008")], campaign_at(id, "hall")))
            rt_push(result, c1_op_communicate_goal(id, "shen.opening.ask-name", [c1_op_source(15, "s2_meet.008")], campaign_at(id, "hall")))
            rt_push(result, c1_op_communicate_goal(id, "shen.opening.memory-report", [c1_op_source(20, "s2_tea.016")], campaign_at(id, "hall")))
            rt_push(result, c1_op_communicate_goal(id, "shen.opening.accept-work", c1_op_desire(id).basis, c1_op_reward_requirement(id)))
            rt_push(result, c1_op_communicate_goal(id, "shen.opening.body-habit", [c1_op_source(23, "s2_tea.013")], c1_op_property("opening.cup.su", "served_by", "shen")))
        if id == "su":
            rt_push(result, c1_op_know_goal(id, dv_ref("opening.wake.su", "state", "low_wall_tone"), basis, campaign_at(id, "R08")))
            rt_push(result, c1_op_communicate_goal(id, "su.opening.ask-sugar", [c1_op_source(22, "s2_tea.012")], c1_op_property("opening.cup.su", "sugar_added", false)))
        if id != "detective":
            var invitation_known = c1_op_property("opening.cabinet", "position_description", "铜口下方")
            var desire = c1_op_desire(id)
            var introduction_source = c1_op_source(12, "s2_meet.010")
            if id == "huo":
                introduction_source = c1_op_source(13, "s2_meet.011")
            if id == "su":
                introduction_source = c1_op_source(14, "s2_meet.006")
            rt_push(result, c1_op_communicate_goal(id, rt_cat(id, ".opening.introduce"), [introduction_source], campaign_at(id, "hall")))
            rt_push(result, c1_op_know_goal(id, dv_ref(rt_cat("opening.slot.", id), "state", "contents"), desire.basis, invitation_known))
            var refs = c1_op_reward_refs(id)
            var i = 0
            while i < rt_count(refs):
                rt_push(result, c1_op_know_goal(id, refs[i], desire.basis, invitation_known))
                i = i + 1
            rt_push(result, c1_op_communicate_goal(id, rt_cat(id, ".opening.maintain-interpretation"), desire.basis, c1_op_reward_requirement(id)))
    if id == "demon":
        var methods = ["demon.opening", "demon.opening.reward-invitation", "demon.opening.desire-offer", "demon.opening.other-contract"]
        var i = 0
        while i < rt_count(methods):
            rt_push(result, c1_op_communicate_goal(id, methods[i], [c1_op_source(28, "s3_broadcast.019"), c1_op_source(46, "s5_question.004")], campaign_at(id, "hall")))
            i = i + 1
    return result

fn c1_op_install_purposes(actor):
    var policy = dv_with(actor.policy, "notice_co_presence", true)
    var goals = []
    var existing = dv_find(policy, "goals", [])
    var n = 0
    while n < rt_count(existing):
        var goal = existing[n]
        if dv_has(c1_op_people(), actor.id) and actor.id != "detective" and dv_find(goal, "question", "") == "own_material":
            // The public opening receipt establishes the own-material motive across
            // later question stages; its activation does not expire with a stage name.
            goal = dv_with(goal, "available_when", dv_all(dv_pair(dv_find(goal, "available_when", dv_true()), dv_fact(dv_ref("question", "state", "awake_scope"), true))))
        rt_push(goals, goal)
        n = n + 1
    var added = c1_op_owned_goals(actor.id)
    var i = 0
    while i < rt_count(added):
        rt_push(goals, added[i])
        i = i + 1
    policy = dv_with(policy, "goals", goals)
    if dv_has(c1_op_people(), actor.id):
        policy = dv_with(policy, "desires", dv_append(dv_find(policy, "desires", []), c1_op_desire(actor.id)))
    return dv_with(actor, "policy", policy)

fn c1_op_contract_candidates():
    // Full-contract questions belong to the second-day permission dialogue.
    return []

// First evening opportunities: time opens actions, never performs them.
// Numeric provisions are engineering serving units; no earlier stock history is asserted.
fn c1n_source(id):
    return campaign_source("language_core/verification/scenarios/chapter1-night.dv", 0, rt_cat("authorized-first-night-20261016.", id))

fn c1n_mark(id):
    return campaign_first_night_ref(rt_cat("done.", id))

fn c1n_judgment_ref():
    return campaign_first_night_ref("detective.evidence_judgment_stance")

fn c1n_row(actor, id, start, end, when, label, text):
    return {"actor": actor, "id": rt_cat("night.", id), "start": start, "end": end, "when": when, "label": label, "text": text, "kind": "talk", "effects": [], "grants": [], "literal": dv_true()}

fn c1n_rows():
    let key = ["authored-declaration", "c1n_rows"]
    let cached = rt_memo_get([], key)
    if cached[0]:
        return cached[1]
    return rt_memo_put([], key, c1n_rows_build())

fn c1n_rows_build():
    var rows = []
    let meet = dv_all([campaign_at("detective", "living_hall"), campaign_at("huo", "living_hall"), campaign_at("shen", "living_hall")])
    rt_push(rows, c1n_row("quer", "greeting", 750, 810, meet, "向熟悉的同伴打招呼", "老霍！沈叔！……咦，我怎么张嘴就这么叫了？"))
    let apron = c1n_row("shen", "apron", 750, 810, campaign_at("quer", "living_hall"), "从围裙口袋取出零嘴", "沈鼎摸了摸围裙口袋，摸出一点零嘴，递向雀儿。")
    rt_push(rows, dv_with_many(apron, {"kind": "help", "public_observers": campaign_people(), "public_grants": [c1n_mark(apron.id)]}))
    var show = c1n_row("ward", "show-evidence", 840, 930, dv_all([dv_fact(campaign_case_ref("contract", "evidence_complete"), true), dv_fact(campaign_case_ref("contract", "keys_found"), true), dv_fact(campaign_case_ref("contract", "wax_ash_seen"), true)]), "出示红纸与蜡布筒", "沃德摊开半角红纸，又放下管网图的蜡布筒。")
    show = dv_with_many(show, {"kind": "help", "effects": [dv_assign(dv_ref("night.evidence", "state", "displayed"), true)], "grants": [dv_ref("night.evidence", "state", "displayed")], "public_observers": campaign_people(), "public_grants": [dv_ref("night.evidence", "state", "displayed")]})
    rt_push(rows, show)
    var restriction = c1n_row("ward", "ward-claim", 840, 930, dv_fact(dv_ref("night.evidence", "state", "displayed"), true), "提议限制行动", "先限制雀儿的自由，待事情查明。")
    restriction = dv_with_many(restriction, {"effects": [dv_assign(campaign_first_night_ref("ward.restriction_announced"), true)], "grants": [campaign_first_night_ref("ward.restriction_announced")], "public_grants": [campaign_first_night_ref("ward.restriction_announced")]})
    rt_push(rows, restriction)
    let inspected = dv_all([dv_fact(dv_ref("night.evidence", "state", "wax_seal_intact"), true), dv_fact(dv_ref("night.evidence", "state", "fresh_torn_edge"), true)])
    let uncommitted = dv_fact(c1n_judgment_ref(), "uncommitted")
    var judgment = c1n_row("detective", "defer-judgment", 840, 930, dv_all([inspected, uncommitted]), "提议先核对材料再判断", "蜡布筒的火漆封口完好，红纸毛边却是新撕的。另一半多半仍在文献工房；明日到现场勘验，再作判断。")
    judgment = dv_with_many(judgment, {"received": {"speaker": "ward", "action_id": "night.ward-claim"}, "effects": [dv_assign(c1n_judgment_ref(), "deferred")], "grants": [c1n_judgment_ref()], "public_grants": [c1n_judgment_ref()]})
    rt_push(rows, judgment)
    var assent = c1n_row("detective", "provisional-assent", 840, 930, dv_all([dv_fact(dv_ref("night.evidence", "state", "displayed"), true), uncommitted]), "暂时附和限制行动的提议", "沃德已经摆出材料，我暂且附和先限制行动，先按他的说法处理。")
    assent = dv_with_many(assent, {"received": {"speaker": "ward", "action_id": "night.ward-claim"}, "effects": [dv_assign(c1n_judgment_ref(), "provisional-assent")], "grants": [c1n_judgment_ref()], "public_grants": [c1n_judgment_ref()]})
    rt_push(rows, assent)
    var defer = c1n_row("gu", "corroborate", 840, 930, dv_fact(c1n_judgment_ref(), "deferred"), "提出补充核验", "孤证不立。待明日去文献工房，把另一半找来核对。")
    defer = dv_with(defer, "received", {"speaker": "detective", "action_id": "night.defer-judgment"})
    rt_push(rows, defer)
    rt_push(rows, c1n_row("detective", "ask-closed-doors", 960, 1101, dv_true(), "询问其他寝区与伤者", "丙区、丁区里的人怎么样了？伤者还好吗？"))
    var count = c1n_row("shen", "count-provisions", 1110, 1230, dv_true(), "清点各区带来的余粮", "实际清点甲乙两区带来的余粮，按八份备餐用量记账。")
    count = dv_with_many(count, {"kind": "inspect", "effects": [dv_assign(dv_ref("night.provisions", "state", "counted"), true)], "grants": [dv_ref("night.provisions", "state", "counted"), dv_ref("night.provisions", "state", "bread"), dv_ref("night.provisions", "state", "onion"), dv_ref("night.provisions", "state", "meat")]})
    rt_push(rows, count)
    var cook = c1n_row("shen", "cook", 1110, 1230, dv_all([dv_fact(dv_ref("night.provisions", "state", "counted"), true), dv_at_least(dv_ref("night.provisions", "state", "bread"), 8), dv_at_least(dv_ref("night.provisions", "state", "onion"), 8), dv_at_least(dv_ref("night.provisions", "state", "meat"), 8)]), "准备八人份晚餐", "沈鼎用甲乙两区清点出的余粮，烤面包，煮洋葱碎肉汤，备出八人份。")
    cook = dv_with_many(cook, {"kind": "help", "effects": [dv_increment(dv_ref("night.provisions", "state", "bread"), -8), dv_increment(dv_ref("night.provisions", "state", "onion"), -8), dv_increment(dv_ref("night.provisions", "state", "meat"), -8), dv_assign(dv_ref("night.provisions", "state", "evening_servings"), 8)], "grants": [dv_ref("night.provisions", "state", "bread"), dv_ref("night.provisions", "state", "onion"), dv_ref("night.provisions", "state", "meat"), dv_ref("night.provisions", "state", "evening_servings"), dv_ref("night.provisions", "state", "consumed")], "public_observers": campaign_people(), "public_grants": [dv_ref("night.provisions", "state", "evening_servings"), dv_ref("night.provisions", "state", "consumed")]})
    rt_push(rows, cook)
    // No calendar tick restores this sealed memory. Until an actual recall or
    // sourced testimony establishes the personal field, this account is unavailable.
    rt_push(rows, c1n_row("quer", "cold-hand", 1260, 1440, dv_all([campaign_at("detective", "living_hall"), dv_fact(dv_ref("personal.quer", "state", "recalled_key_handover"), true)]), "讲述递钥匙时的记忆", "壁炉边，雀儿压低声音：递钥匙的那只手，很凉。那人说，‘别让它落进下面那东西手里。’我只知道自己听到了这句话。"))
    var partner = c1n_row("quer", "partner", 1260, 1440, dv_all([campaign_at("detective", "living_hall"), dv_fact(c1n_judgment_ref(), "deferred")]), "邀请明日结伴核查", "明日一起去文献工房。我替你开学园里的锁，咱们搭档，怎么样？")
    partner = dv_with_many(partner, {"received": {"speaker": "detective", "action_id": "night.defer-judgment"}, "effects": [dv_assign(campaign_first_night_ref("partner_offered"), true)], "grants": [campaign_first_night_ref("partner_offered")], "public_grants": [campaign_first_night_ref("partner_offered")]})
    rt_push(rows, partner)
    var accept = c1n_row("detective", "accept-partner", 1260, 1440, dv_all([campaign_at("quer", "living_hall"), dv_fact(c1n_judgment_ref(), "deferred")]), "答应结伴核查", "好。明日先去文献工房，到了现场再核对。")
    accept = dv_with_many(accept, {"received": {"speaker": "quer", "action_id": "night.partner"}, "effects": [dv_assign(campaign_first_night_ref("partner_promised"), true)], "grants": [campaign_first_night_ref("partner_promised")], "public_grants": [campaign_first_night_ref("partner_promised")]})
    rt_push(rows, accept)
    rt_push(rows, c1n_row("huo", "watch-offer", 1260, 1440, campaign_at("detective", "living_hall"), "提出分班守夜", "夜里总得有人醒着。我跟你分班，先把这一夜守过去。"))
    var watch = c1n_row("detective", "watch-agree", 1260, 1440, campaign_at("huo", "living_hall"), "答应分班守夜", "我们分班守夜。交班时把听见、看见的事情说清楚。")
    watch = dv_with_many(watch, {"received": {"speaker": "huo", "action_id": "night.watch-offer"}, "effects": [dv_assign(campaign_first_night_ref("watch_agreed"), true)], "grants": [campaign_first_night_ref("watch_agreed")], "public_grants": [campaign_first_night_ref("watch_agreed")]})
    rt_push(rows, watch)
    let diners = ["detective", "huo", "shen", "su", "quer", "ward", "gu", "lucian"]
    var diner_index = 0
    while diner_index < rt_count(diners):
        let diner = diners[diner_index]
        var meal = c1n_row(diner, rt_cat("eat.", diner), 1110, 1260, dv_at_least(dv_ref("night.provisions", "state", "evening_servings"), 1), "领取并食用晚餐", "取一份烤面包和洋葱碎肉汤，用过晚餐。")
        meal = dv_with_many(meal, {"kind": "help", "effects": [dv_increment(dv_ref("night.provisions", "state", "evening_servings"), -1), dv_increment(dv_ref("night.provisions", "state", "consumed"), 1)], "grants": [dv_ref("night.provisions", "state", "evening_servings"), dv_ref("night.provisions", "state", "consumed")], "public_observers": campaign_people(), "public_grants": [c1n_mark(meal.id)]})
        rt_push(rows, meal)
        diner_index = diner_index + 1
    var first_watch = c1n_row("huo", "first-watch", 1320, 1440, dv_fact(campaign_first_night_ref("watch_agreed"), true), "承担前半夜值守", "霍铎留在壁炉旁守前半夜，留意门口和走廊里的实际动静。")
    first_watch = dv_with(first_watch, "kind", "help")
    rt_push(rows, first_watch)
    var second_watch = c1n_row("detective", "second-watch", 1440, 1800, dv_fact(campaign_first_night_ref("watch_agreed"), true), "接替后半夜值守", "侦探接过后半夜的守候，核对门口和走廊里的动静。")
    second_watch = dv_with(second_watch, "kind", "help")
    rt_push(rows, second_watch)
    let lure_targets = ["huo", "su"]
    var lure_index = 0
    while lure_index < rt_count(lure_targets):
        let target = lure_targets[lure_index]
        let site = c1_deep_resonance_site(target)
        let literal = c1_statement(site.evidence)
        var text = "石板上确实留下了那些刻痕。你还想弄懂它，就继续沿着它追索吧。"
        if target == "su":
            text = "那份乐谱确实还有残缺的部分。你还想听全，就继续沿着它追索吧。"
        var lure = c1n_row("detective", rt_cat("selective-recall.", target), 1110, 1440, literal, "谈论封存物与回想", text)
        let source = c1n_source("user:2026-10-18-selective-truth-owner-choice")
        lure = dv_with_many(lure, {"literal": literal, "manual_only": true, "opportunity_requirement": {"location": "living_hall", "participants": [target], "mode": "all-present"}, "personal_choice": {"group": rt_cat("first-night-recall.", target), "requires": literal, "prohibits": dv_not(dv_true()), "promotes": ["pursue_desire"], "sacrifices": ["understand_cost", "safety"], "require_positive": true, "basis": [source]}, "manipulation": {"method": "selective-true-fragment-omitting-retrieval-cost", "targets": [target], "action_ids": [rt_cat(target, ".deep-resonance")], "consequence_when": dv_fact(c1_deep_resonance_ref(target), true), "basis": [source]}})
        rt_push(rows, lure)
        lure_index = lure_index + 1
    return rows

fn c1n_pre(row):
    return dv_all([campaign_at(row.actor, "living_hall"), campaign_window(1, row.start, row.end), row.when, dv_fact(c1n_mark(row.id), false)])

法则 c1n_law，给定 条目：
    前提 c1n_pre(条目)。
    效果 dv_append(条目.effects, dv_assign(c1n_mark(条目.id), true))。

fn c1n_action(row):
    var action = campaign_surface_action(row.id, row.kind, c1n_pre(row), c1n_pre(row), row.id, dv_append(row.grants, c1n_mark(row.id)), row.label, row.text, c1n_source(row.id))
    action = dv_with(action, "predict_law", row.id)
    if row.kind == "talk":
        var listeners = []
        let people = campaign_people()
        var listener_index = 0
        while listener_index < rt_count(people):
            if people[listener_index] != row.actor:
                rt_push(listeners, people[listener_index])
            listener_index = listener_index + 1
        action = dv_with_many(action, {"speech": dv_with_many(c1_speech(row.literal, c1n_source(row.id), "personally-owned-evening-statement"), {"surface": row.text, "channel": "local"}), "listeners": listeners})
    if dv_has_key(row, "public_grants"):
        action = dv_with(action, "public_grants", row.public_grants)
    if dv_has_key(row, "public_observers"):
        action = dv_with(action, "public_observers", row.public_observers)
    if dv_has_key(row, "received"):
        action = dv_with(action, "received_speech_requirement", row.received)
    if row.id == "night.defer-judgment" or row.id == "night.provisional-assent":
        action = c1_inquiry_choice(action, "first-night-evidence-judgment", row.id == "night.defer-judgment")
    let metadata = ["manual_only", "personal_choice", "opportunity_requirement"]
    var metadata_index = 0
    while metadata_index < rt_count(metadata):
        if dv_has_key(row, metadata[metadata_index]):
            action = dv_with(action, metadata[metadata_index], dv_get(row, metadata[metadata_index]))
        metadata_index = metadata_index + 1
    if dv_has_key(row, "manipulation"):
        action = dv_with(action, "speech", dv_with(action.speech, "manipulation", row.manipulation))
    return action

fn c1n_inspections(actor):
    if actor == "demon":
        return []
    let here = campaign_at(actor, "living_hall")
    var actions = []
    rt_push(actions, dv_with(campaign_surface_action(rt_cat("night.inspect-room.", actor), "inspect", here, here, "", [campaign_first_night_ref("watch_agreed"), dv_ref("night.provisions", "state", "evening_servings")], "查看备餐与守夜交班", "查看公共备餐和守夜交班的实际情况。", c1n_source("room-status")), "repeatable", true))
    if actor == "detective":
        let pre = dv_all([here, dv_fact(dv_ref("night.evidence", "state", "displayed"), true)])
        let inspection = campaign_surface_action("night.inspect-evidence", "inspect", pre, pre, "", [dv_ref("night.evidence", "state", "displayed"), dv_ref("night.evidence", "state", "wax_seal_intact"), dv_ref("night.evidence", "state", "fresh_torn_edge")], "检视蜡布筒封口与红纸边缘", "近看蜡布筒的火漆封口与红纸的新撕毛边。", c1n_source("inspect-evidence"))
        rt_push(actions, dv_with(c1_inquiry_choice(inspection, "first-night-evidence-judgment", true), "received_speech_requirement", {"speaker": "ward", "action_id": "night.ward-claim"}))
    if actor == "detective":
        rt_push(actions, campaign_surface_action("night.inspect-displayed", "inspect", here, here, "", [dv_ref("night.evidence", "state", "displayed")], "查看桌面是否摆出证物", "查看沃德是否已把证物摆在面前。", c1n_source("displayed")))
    let call_source = c1n_source("personally-heard-midnight-copper-call")
    let night_when = dv_all([campaign_window(1, 1440, 1800), dv_fact(c1n_night_seen_ref(actor), true)])
    let notice_id = rt_cat(actor, ".night.notice-time")
    let notice_when = dv_all([campaign_at(actor, "living_hall"), campaign_window(1, 1440, 1800)])
    rt_push(actions, dv_with(campaign_surface_action(notice_id, "inspect", notice_when, notice_when, notice_id, [campaign_clock(), c1n_night_seen_ref(actor)], "查看光线与时钟", "留意起居厅里此刻的光线与时钟，确认已经入夜。", c1n_source("own-observed-midnight-time")), "predict_law", notice_id))
    let call_ref = c1n_call_ref(actor)
    let call_id = rt_cat(actor, ".night.hear-private-call")
    let call_when = dv_all([campaign_at(actor, "living_hall"), night_when, dv_fact(call_ref, false)])
    var call = campaign_surface_action(call_id, "inspect", call_when, call_when, call_id, [call_ref], "聆听铜口的声音", "铜口深处有个声音，低低唤着你。那种熟悉感只落进你自己的耳中。", call_source)
    call = dv_with_many(call, {"predict_law": call_id, "night_call_requirement": {"basis": [call_source], "night_when": night_when}, "sensory_mode": "private-night-copper-call", "grant_observation_sources": [{"ref": call_ref, "source": "perception", "origin": "personally-heard-midnight-copper-call", "trust": 1}], "purpose_refs": [call_ref]})
    rt_push(actions, call)
    return actions

fn c1n_goals(actor):
    if actor.id == "demon":
        return []
    var goals = []
    let rows = c1n_rows()
    var i = 0
    while i < rt_count(rows):
        let row = rows[i]
        if row.actor == actor.id and (not dv_find(row, "manual_only", false) or (dv_has_key(row, "manipulation") and dv_find(actor.policy, "allow_manipulation_candidates", false))):
            if row.kind == "talk":
                rt_push(goals, {"kind": "communicate", "scope": "personal", "method_id": row.id, "available_when": c1n_pre(row), "requires_argument": false, "basis": [c1n_source(row.id)]})
            else:
                rt_push(goals, campaign_goal(dv_fact(c1n_mark(row.id), true), c1n_pre(row), [c1n_source(row.id)]))
        i = i + 1
    let inspections = c1n_inspections(actor.id)
    i = 0
    while i < rt_count(inspections):
        let action = inspections[i]
        var j = 0
        while j < rt_count(action.grants):
            var goal = campaign_observation_goal(action.grants[j], action.precondition, action.source_refs, 0)
            if action.id == rt_cat("night.inspect-room.", actor.id):
                // Recheck only after related received activity, never after the
                // inspection's own timestamp or an unrelated observation.
                let triggers = [c1n_mark("night.watch-agree"), c1n_mark("night.cook")]
                goal = dv_with_many(goal, {"refresh_until": dv_not(dv_true()), "refresh_refs": triggers})
            rt_push(goals, goal)
            j = j + 1
        i = i + 1
    return goals

fn c1_inquiry_room(actor, condition):
    if condition.op == "equals":
        if dv_same_local_ref(actor.id, condition.ref, actor.location_ref):
            return condition.value
    if condition.op == "all":
        var i = 0
        while i < rt_count(condition.items):
            let room = c1_inquiry_room(actor, condition.items[i])
            if room != "":
                return room
            i = i + 1
    return ""

fn c1_inquiry_route(actor, target):
    let position = dv_read(actor.mind, actor.location_ref)
    if not dv_uncontested(position) or position.value == target:
        return false
    var queue = [{"room": position.value, "first": "", "basis": []}]
    var seen = [position.value]
    var cursor = 0
    let edges = c1_edges()
    while cursor < rt_count(queue):
        let node = queue[cursor]
        var i = 0
        while i < rt_count(edges):
            var destination = ""
            if edges[i][0] == node.room:
                destination = edges[i][1]
            if edges[i][1] == node.room:
                destination = edges[i][0]
            if destination != "" and not dv_has(seen, destination):
                let method = c1_move_name(actor.id, node.room, destination)
                let adoption = dv_find(actor.mind.adoptions, method, false)
                if adoption != false and adoption.active and adoption.mode == "predict":
                    var first = node.first
                    if first == "":
                        first = destination
                    let basis = dv_append(node.basis, {"method": method, "basis": adoption.basis})
                    if destination == target:
                        return {"next": first, "target": target, "basis": basis}
                    rt_push(queue, {"room": destination, "first": first, "basis": basis})
                    rt_push(seen, destination)
            i = i + 1
        cursor = cursor + 1
    return false

fn c1_inquiry_navigation(actor):
    if actor.id != "detective":
        return actor
    var actions = actor.actions
    var action_index = 0
    while action_index < rt_count(actions):
        if dv_find(actions[action_index], "inquiry_navigation_choice", false):
            actions = dvs_replace(actions, action_index, dv_without(dv_without(actions[action_index], "personal_choice"), "inquiry_navigation_choice"))
        action_index = action_index + 1
    actor = dv_with(actor, "actions", actions)
    var goals = []
    let old = actor.policy.goals
    var i = 0
    while i < rt_count(old):
        if not dv_find(old[i], "inquiry_navigation", false):
            rt_push(goals, old[i])
        i = i + 1
    var selected = false
    let position = dv_read(actor.mind, actor.location_ref)
    i = 0
    while i < rt_count(goals):
        let goal = goals[i]
        if dv_has_key(goal, "ref") and dvp_topic(actor, goal) and 0 < rt_count(dv_find(goal, "basis", [])) and dv_truth(actor.mind, dv_find(goal, "available_when", dv_true())) == "true":
            let cell = dv_read(actor.mind, goal.ref)
            var pending = not dv_uncontested(cell)
            if dv_find(goal, "kind", "") == "evidence":
                pending = not dvp_source_supported_since(cell, dv_find(goal, "source", "perception"), dv_find(goal, "minimum_time", 0))
            if pending:
                var j = 0
                while j < rt_count(actor.actions):
                    let action = actor.actions[j]
                    if action.kind == "inspect" and dv_has(dv_find(action, "grants", []), goal.ref) and not dv_has(dv_find(actor, "completed_actions", []), action.id):
                        let room = c1_inquiry_room(actor, action.precondition)
                        if room != "":
                            if dv_uncontested(position) and room == position.value:
                                return dv_with(actor, "policy", dv_with(actor.policy, "goals", goals))
                            if selected == false:
                                let route = c1_inquiry_route(actor, room)
                                if route != false:
                                    selected = {"kind": "achieve", "scope": "personal", "owner": actor.id, "proposition": campaign_at(actor.id, route.next), "available_when": dv_find(goal, "available_when", dv_true()), "basis": goal.basis, "inquiry_navigation": true, "target_method": action.id, "target_ref": goal.ref, "route": route, "fulfillment": "movement-only-not-inspection"}
                    j = j + 1
        i = i + 1
    if selected != false:
        rt_push(goals, selected)
        let method = c1_move_name(actor.id, position.value, selected.route.next)
        action_index = 0
        while action_index < rt_count(actions):
            if actions[action_index].id == method:
                actions = dvs_replace(actions, action_index, dv_with(c1_inquiry_choice(actions[action_index], "chapter1-inquiry", true), "inquiry_navigation_choice", true))
            action_index = action_index + 1
        actor = dv_with(actor, "actions", actions)
    return dv_with(actor, "policy", dv_with(actor.policy, "goals", goals))

fn c1n_refresh_actor_goals(actor):
    if not dv_has_key(actor.policy, "first_night_goals"):
        var combined = dv_clone(dv_find(actor.policy, "first_night_base_goals", actor.policy.goals))
        let goals = c1n_goals(actor)
        var i = 0
        while i < rt_count(goals):
            rt_push(combined, goals[i])
            i = i + 1
        actor = dv_with(actor, "policy", dv_with_many(actor.policy, {"goals": combined, "first_night_goals": goals}))
    return c1n_known_future_wait_actor(c1_inquiry_navigation(actor))

fn c1n_morning_ready(world):
    return world.time >= 1800

fn c1n_install_scene(scene):
    if dv_find(scene, "first_night_installed", false):
        return scene
    let rows = c1n_rows()
    var fields = {"partner_offered": dv_field(false), "partner_promised": dv_field(false), "watch_agreed": dv_field(false), "detective.evidence_judgment_stance": dv_field("uncommitted"), "ward.restriction_announced": dv_field(false)}
    var i = 0
    while i < rt_count(rows):
        fields = dv_with(fields, rt_cat("done.", rows[i].id), dv_field(false))
        i = i + 1
    let objects = [campaign_state_object("night.first", fields), campaign_state_object("night.evidence", {"displayed": dv_field(false), "wax_seal_intact": dv_field(true), "fresh_torn_edge": dv_field(true)}), campaign_state_object("night.provisions", {"counted": dv_field(false), "bread": dv_field(8), "onion": dv_field(8), "meat": dv_field(8), "evening_servings": dv_field(0), "consumed": dv_field(0)})]
    var physical = scene.physical
    var bindings = dv_clone(scene.bindings)
    i = 0
    while i < rt_count(objects):
        physical = campaign_add_new(physical, objects[i])
        i = i + 1
    i = 0
    while i < rt_count(rows):
        physical = dv_adopt(physical, campaign_method(rows[i].id, c1n_law(rows[i])), "enforce", 1, [c1n_source(rows[i].id)])
        i = i + 1
    var costs = dv_clone(scene.cost_model)
    let durations = c1n_wait_durations()
    var duration_index = 0
    while duration_index < rt_count(durations):
        let minutes = durations[duration_index]
        costs = dv_with(costs, c1n_wait_kind(minutes), c1_cost(minutes, c1n_source("bounded-wait-engineering-duration")))
        duration_index = duration_index + 1
    var actors = []
    i = 0
    while i < rt_count(scene.actors):
        var actor = scene.actors[i]
        var mind = actor.mind
        var j = 0
        while j < rt_count(objects):
            mind = campaign_add_new(mind, campaign_local_object(objects[j].id))
            if dv_local(bindings, objects[j].id, actor.id) == "":
                rt_push(bindings, dv_binding(objects[j].id, objects[j].id, actor.id))
            j = j + 1
        if actor.id == "detective":
            mind = dv_store(mind, c1n_judgment_ref(), dv_with(dv_field("uncommitted"), "basis", [c1n_source("own-evidence-judgment-not-yet-expressed")]))
        if actor.id == "ward":
            mind = dv_store(mind, campaign_first_night_ref("ward.restriction_announced"), dv_with(dv_field(false), "basis", [c1n_source("own-restriction-not-yet-announced")]))
        let call_object = rt_cat("night.call.", actor.id)
        physical = campaign_add_new(physical, campaign_state_object(call_object, {"heard": dv_field(false), "night_observed": dv_field(false)}))
        mind = campaign_add_new(mind, campaign_local_object(call_object))
        mind = dv_store(mind, c1n_call_ref(actor.id), dv_with(dv_field(false), "basis", [c1n_source("own-night-call-not-yet-heard")]))
        if dv_local(bindings, call_object, actor.id) == "":
            rt_push(bindings, dv_binding(call_object, call_object, actor.id))
        let notice_id = rt_cat(actor.id, ".night.notice-time")
        physical = dv_adopt(physical, campaign_method(notice_id, c1n_night_seen_law(actor.id)), "enforce", 1, [c1n_source("own-observed-midnight-time")])
        mind = dv_adopt(mind, campaign_method(notice_id, c1n_night_seen_law(actor.id)), "predict", 1, [c1n_source("own-observed-midnight-time")])
        let call_id = rt_cat(actor.id, ".night.hear-private-call")
        physical = dv_adopt(physical, campaign_method(call_id, c1n_call_law(actor.id)), "enforce", 1, [c1n_source("personally-heard-midnight-copper-call")])
        mind = dv_adopt(mind, campaign_method(call_id, c1n_call_law(actor.id)), "predict", 1, [c1n_source("personally-heard-midnight-copper-call")])
        let wait_id = rt_cat("night.wait.", actor.id)
        physical = campaign_add_new(physical, campaign_state_object(wait_id, {"elapsed": dv_field(0)}))
        mind = campaign_add_new(mind, campaign_local_object(wait_id))
        mind = dv_store(mind, c1n_wait_ref(actor.id), dv_with(dv_field(0), "basis", [c1n_source("own-wait-account-initial")]))
        if dv_local(bindings, wait_id, actor.id) == "":
            rt_push(bindings, dv_binding(wait_id, wait_id, actor.id))
        duration_index = 0
        while duration_index < rt_count(durations):
            let minutes = durations[duration_index]
            let wait_method = c1n_wait_id(actor.id, minutes)
            physical = dv_adopt(physical, campaign_method(wait_method, c1n_wait_law(actor.id, minutes)), "enforce", 1, [c1n_source("own-bounded-wait")])
            mind = dv_adopt(mind, campaign_method(wait_method, c1n_wait_law(actor.id, minutes)), "predict", 1, [c1n_source("own-bounded-wait")])
            duration_index = duration_index + 1
        var actions = dv_clone(actor.actions)
        var hearing = dv_clone(dv_find(actor, "hearing_grants", []))
        let people = campaign_people()
        j = 0
        while j < rt_count(people):
            if people[j] != actor.id:
                mind = campaign_add_new(mind, campaign_local_object(people[j]))
                if dv_local(bindings, people[j], actor.id) == "":
                    rt_push(bindings, dv_binding(people[j], people[j], actor.id))
                rt_push(hearing, {"speaker": people[j], "channel": "local", "available_when": campaign_at(actor.id, "living_hall"), "sender_locations": ["living_hall"], "listener_locations": ["living_hall"], "basis": [c1n_source("actual-co-present-evening-speech")]})
            j = j + 1
        j = 0
        while j < rt_count(rows):
            let row = rows[j]
            if row.actor == actor.id:
                mind = dv_store(mind, c1n_mark(row.id), dv_field(false))
                mind = dv_adopt(mind, campaign_method(row.id, c1n_law(row)), "predict", 1, [c1n_source(row.id)])
                rt_push(actions, c1n_action(row))
            j = j + 1
        let inspect = c1n_inspections(actor.id)
        j = 0
        while j < rt_count(inspect):
            rt_push(actions, inspect[j])
            j = j + 1
        actor = dv_with_many(actor, {"mind": mind, "actions": c1_public_methods(actions), "hearing_grants": hearing, "policy": dv_with(actor.policy, "first_night_base_goals", actor.policy.goals)})
        rt_push(actors, c1n_refresh_actor_goals(actor))
        i = i + 1
    return dv_with_many(scene, {"physical": physical, "actors": actors, "bindings": bindings, "cost_model": costs, "first_night_installed": true})

// These are finite costed action lengths, not speed multipliers or world-clock writes.
fn c1n_wait_durations():
    return [180, 120, 60, 30, 20, 15, 10, 5, 4, 3, 2, 1]

fn c1n_wait_kind(minutes):
    return rt_cat("wait.first_night.", rt_show(minutes))

fn c1n_wait_id(actor, minutes):
    return rt_cat(rt_cat(actor, "."), c1n_wait_kind(minutes))

fn c1n_wait_ref(actor):
    return dv_ref(rt_cat("night.wait.", actor), "state", "elapsed")

法则 c1n_wait_law，给定 行动者、minutes：
    前提 dv_true()。
    则 c1n_wait_ref(行动者) 增加 minutes。

// Callers must supply a future opportunity from this actor's own authored intention
// or actual received information, never another mind or a physical future fact.
// The ordinary decision comparison remains responsible for choosing this action.
fn c1n_known_wait_actor(actor, target, basis):
    // No previous wait and no future opportunity means no candidate rebuild.
    // The live first-night profile transition below is still checked.
    actor = c1n_wait_profile(actor)
    if target <= actor.mind.time and dv_has_key(actor.policy, "known_wait_active") and not actor.policy.known_wait_active:
        return actor
    var active_wait = false
    var actions = []
    var i = 0
    while i < rt_count(actor.actions):
        if not dv_find(actor.actions[i], "known_opportunity_wait", false):
            rt_push(actions, actor.actions[i])
        i = i + 1
    var goals = []
    let existing = dv_find(actor.policy, "goals", [])
    i = 0
    while i < rt_count(existing):
        if not dv_find(existing[i], "known_opportunity_wait", false):
            rt_push(goals, existing[i])
        i = i + 1
    let elapsed = dv_read(actor.mind, c1n_wait_ref(actor.id))
    let progress_weight = dv_find(actor.policy, "progress_weight", 1)
    let time_cost = dv_find(actor.policy, "time_cost", 0.01)
    var current_night_action = false
    let rows = c1n_rows()
    let relevant = dvp_goal_refs(actor)
    i = 0
    while i < rt_count(rows):
        if rows[i].actor == actor.id:
            var action_index = 0
            while action_index < rt_count(actions) and not current_night_action:
                let action = actions[action_index]
                if action.id == rows[i].id and dvp_eligible(actor, action, actor.mind, relevant):
                    current_night_action = true
                action_index = action_index + 1
        i = i + 1
    var explicit_wait_choice = false
    let declared_wait_choices = dv_find(actor.policy, "known_opportunity_wait_choices", [])
    var declared_index = 0
    while declared_index < rt_count(declared_wait_choices):
        let declaration = declared_wait_choices[declared_index]
        if dv_has_key(declaration, "target_time") and dv_has_key(declaration, "available_when") and dv_has_key(declaration, "personal_choice"):
            if declaration.target_time == target and dv_truth(actor.mind, declaration.available_when) == "true" and 0 < rt_count(dv_find(declaration.personal_choice, "basis", [])):
                explicit_wait_choice = true
        declared_index = declared_index + 1
    if elapsed.known and actor.mind.time < target and 0 < rt_count(basis) and 0 < progress_weight and (not current_night_action or explicit_wait_choice):
        let durations = c1n_wait_durations()
        var minutes = 0
        i = 0
        var wait_chunk_limit = dv_find(actor.policy, "wait_chunk_limit", 180)
        if dv_has_key(actor.policy, "chapter2_profile"):
            let daytime_wait_limit = dv_find(actor.policy, "daytime_wait_chunk_limit", wait_chunk_limit)
            var day_minute = actor.mind.time
            while day_minute >= 1440:
                day_minute = day_minute - 1440
            if day_minute >= 480 and day_minute < 1260:
                wait_chunk_limit = dv_min(wait_chunk_limit, daytime_wait_limit)
            if dv_has_key(actor.policy, "daytime_wait_chunk_limit") and day_minute < 480:
                wait_chunk_limit = dv_min(wait_chunk_limit, 480 - day_minute)
        if actor.mind.time < 900 and dv_has(["detective", "huo", "shen", "su", "quer", "ward", "gu", "lucian"], actor.id) and dv_truth(actor.mind, campaign_at(actor.id, "living_hall")) == "true":
            wait_chunk_limit = 60
            if actor.mind.time >= 810 and actor.mind.time < 900:
                wait_chunk_limit = 30
        while i < rt_count(durations):
            if minutes == 0 and durations[i] >= 1 and durations[i] <= wait_chunk_limit and actor.mind.time + durations[i] <= target:
                minutes = durations[i]
            i = i + 1
        // Use only existing costed lengths and stop at the next owned boundary.
        // In particular, a nearby window must not be crossed by a fifteen-minute floor.
        if 0 < minutes:
            let id = c1n_wait_id(actor.id, minutes)
            let known = dv_true()
            let result = dv_at_least(c1n_wait_ref(actor.id), elapsed.value + minutes)
            let text = dvs_surface_parts(["留在原处，等候本人已知的下一次作息机会（", rt_show(minutes), "分钟）。"])
            var action = campaign_surface_action(id, c1n_wait_kind(minutes), known, dv_true(), id, [c1n_wait_ref(actor.id), campaign_clock()], rt_cat("等待", rt_cat(rt_show(minutes), "分钟")), text, c1n_source("own-bounded-wait"))
            let wait_choices = dv_find(actor.policy, "known_opportunity_wait_choices", [])
            var choice_index = 0
            while choice_index < rt_count(wait_choices):
                let declaration = wait_choices[choice_index]
                if dv_has_key(declaration, "target_time") and dv_has_key(declaration, "available_when") and dv_has_key(declaration, "personal_choice"):
                    if declaration.target_time == target and dv_truth(actor.mind, declaration.available_when) == "true" and 0 < rt_count(dv_find(declaration.personal_choice, "basis", [])):
                        dv_require(not dv_has_key(action, "personal_choice"), "Ambiguous known-opportunity wait choice")
                        action = dv_with(action, "personal_choice", declaration.personal_choice)
                choice_index = choice_index + 1
            active_wait = true
            rt_push(actions, c1_public_method(dv_with_many(action, {"predict_law": id, "repeatable": true, "known_opportunity_wait": true, "wait_until": target, "wait_basis": basis})))
            // Engineering preference: knowingly spend this time for the next
            // personally declared opportunity. Reimburse its ordinary time score
            // and retain only .01 net utility; other actions compete unchanged.
            let net_utility = 0.01
            let wait_value = (minutes * time_cost + net_utility) / progress_weight
            rt_push(goals, dv_with_many(campaign_goal(result, known, basis), {"weight": wait_value, "known_opportunity_wait": true, "wait_valuation": {"role": "engineering-personal-willingness-to-wait", "time_opportunity_cost": minutes * time_cost, "net_utility": net_utility, "progress_weight": progress_weight, "future_outcome": "unknown"}}))
    return dv_with_many(actor, {"actions": actions, "policy": dv_with_many(actor.policy, {"goals": goals, "known_wait_active": active_wait})})

fn c1n_wait_profile(actor):
    var policy = actor.policy
    if actor.mind.time < 1440 and dv_has(["detective", "huo", "shen", "su", "quer", "ward", "gu", "lucian"], actor.id) and dv_truth(actor.mind, campaign_at(actor.id, "living_hall")) == "true":
        if not dv_has_key(policy, "first_night_plan_depth"):
            policy = dv_with(policy, "first_night_plan_depth", dv_find(policy, "plan_depth", 2))
        policy = dv_with_many(policy, {"plan_depth": 1, "first_night_plan_active": true})
    else:
        if dv_find(policy, "first_night_plan_active", false):
            policy = dv_with_many(policy, {"plan_depth": policy.first_night_plan_depth, "first_night_plan_active": false})
    return dv_with(actor, "policy", policy)

// Only positive lower bounds in the actor's declared goal conditions qualify.
// A negated bound denotes an upper limit, so its subtree is deliberately opaque.
// Both opening and closing thresholds bound a wait. This reads declared syntax,
// not future world state; the caller still checks ownership and nonclock readiness.
// Time alone may open a known opportunity. All remaining conditions must
// already hold in the owner's mind, including being at its execution site.
// Static syntax metadata is built with the goal, never from physical future state.
fn c1n_known_future_wait_actor(actor):
    if actor.id == "demon" and not dv_has_key(actor.policy, "chapter2_profile"):
        return actor
    var target = -1
    var basis = []
    let goals = dv_find(actor.policy, "goals", [])
    var i = 0
    while i < rt_count(goals):
        let goal = goals[i]
        let own_basis = dv_find(goal, "basis", [])
        if not dv_find(goal, "known_opportunity_wait", false) and 0 < rt_count(own_basis):
            var indexed = goal
            if not dv_has_key(goal, "future_clock_boundaries") or not dv_same(dv_find(goal, "future_clock_condition", false), dv_find(goal, "available_when", dv_true())):
                indexed = campaign_index_goal_window(goal)
            let boundaries = indexed.future_clock_boundaries
            var candidate = -1
            var j = 0
            while j < rt_count(boundaries):
                if actor.mind.time < boundaries[j] and (candidate < 0 or boundaries[j] < candidate):
                    candidate = boundaries[j]
                j = j + 1
            // Only a potentially earlier boundary pays for the live pending and
            // nonclock checks. Syntax is cached; current cognition never is.
            if candidate >= 0 and (target < 0 or candidate < target) and campaign_future_goal_pending(actor, goal) and dv_truth(actor.mind, indexed.future_nonclock) == "true":
                target = candidate
                basis = dv_append(own_basis, {"kind": "own-declared-opportunity-boundary", "condition": indexed.future_clock_condition, "scope": "reconsideration-only-not-future-success"})
        i = i + 1
    if 0 <= target:
        return c1n_known_wait_actor(actor, target, basis)
    return c1n_known_wait_actor(actor, actor.mind.time, [])

fn c1n_call_ref(actor):
    return dv_ref(rt_cat("night.call.", actor), "state", "heard")

法则 c1n_call_law，给定 行动者：
    当 行动者 位于 起居厅。
    并且 campaign_window(1, 1440, 1800)。
    并且 c1n_night_seen_ref(行动者) 等于 true。
    并且 c1n_call_ref(行动者) 等于 false。
    则 c1n_call_ref(行动者) 变为 true。

fn c1n_night_seen_ref(actor):
    return dv_ref(rt_cat("night.call.", actor), "state", "night_observed")

法则 c1n_night_seen_law，给定 行动者：
    当 行动者 位于 起居厅。
    并且 campaign_window(1, 1440, 1800)。
    则 c1n_night_seen_ref(行动者) 变为 true。


// Content-owned configuration. Callers supply approved numeric budgets and value lists.
fn Standard_Detective(replay_depth, resistance, empirical_values, mediation_rules, basis):
    dv_require(0 < rt_count(basis), "Detective profile needs content provenance")
    return {"cognitive_profile": "Standard_Detective", "Replay_Depth": replay_depth, "plan_depth": 6, "Implicature_Resistance": resistance, "scope_reference_check": true, "value_order": empirical_values, "value_basis": basis, "norm_rules": mediation_rules, "class_bias": [], "profile_basis": basis}

fn Foolish_Detective(replay_depth, resistance, values, norm_rules, class_bias, basis):
    dv_require(0 < rt_count(basis), "Detective profile needs content provenance")
    return {"cognitive_profile": "Foolish_Detective", "Replay_Depth": replay_depth, "plan_depth": 2, "Implicature_Resistance": resistance, "scope_reference_check": false, "value_order": values, "value_basis": basis, "norm_rules": norm_rules, "class_bias": class_bias, "profile_basis": basis}

fn cognitive_sample(key, options, basis):
    dv_require(0 < rt_count(options) and 0 < rt_count(basis), "Cognitive sampling needs options and provenance")
    return {"key": key, "options": options, "basis": basis}

fn cognitive_initialization(profile, samples, basis):
    return {"profile": profile, "samples": samples, "basis": basis}

// Narrow engineering initial ranges, not narrative facts or acceptance targets.
fn c1c_install_scene(scene, seed, profile):
    dv_require(profile == "Standard_Detective" or profile == "Foolish_Detective" or profile == "Shura_Detective", "Unknown detective cognitive profile")
    let basis = [{"path": "user:current-request", "line": 0, "id": "declared-engineering-cognitive-initial-ranges"}]
    var actors = []
    var i = 0
    while i < rt_count(scene.actors):
        var actor = scene.actors[i]
        if actor.id != "demon":
            var low_trust = []
            var middle_trust = []
            var high_trust = []
            var j = 0
            while j < rt_count(scene.actors):
                let peer = scene.actors[j].id
                let current = dv_find(dv_find(actor.policy, "speaker_trust", []), peer, 0.5)
                low_trust = dv_with(low_trust, peer, dv_max(0, current - 0.05))
                middle_trust = dv_with(middle_trust, peer, current)
                high_trust = dv_with(high_trust, peer, dv_min(1, current + 0.05))
                j = j + 1
            let old = actor.policy
            let drive = dv_find(old, "drive", 1)
            let caution = dv_find(old, "caution", 0.5)
            let information = dv_find(old, "information_weight", 1)
            var samples = [cognitive_sample("drive", [dv_max(0, drive - 0.1), drive, drive + 0.1], basis), cognitive_sample("caution", [dv_max(0, caution - 0.05), caution, caution + 0.05], basis), cognitive_sample("speaker_trust", [low_trust, middle_trust, high_trust], basis), cognitive_sample("information_weight", [information * 0.95, information, information * 1.05], basis), cognitive_sample("implicature_threshold", [0.45, 0.5, 0.55], basis)]
            samples = dv_append(samples, cognitive_sample("resonance_relevance", [0.9, 1, 1.1], basis))
            samples = dv_append(samples, cognitive_sample("truth_bonus", [0.05, 0.1, 0.15], basis))
            // This is a subjective risk prior, never an observation of all actual costs.
            samples = dv_append(samples, cognitive_sample("perceived_risk", [0.45, 0.5, 0.55], basis))
            var selected_profile = []
            if actor.id == "detective":
                let norms = dv_find(old, "norm_rules", [])
                if profile == "Standard_Detective" or profile == "Shura_Detective":
                    selected_profile = Standard_Detective(64, 0.75, ["understand_cost", "solve_case", "evidence", "safety", "night_exception", "records", "measured_work", "clarify_terms", "seek_advice", "avoid_attachment"], norms, basis)
                    if profile == "Shura_Detective":
                        selected_profile = dv_with_many(selected_profile, {"cognitive_profile": "Shura_Detective", "value_order": ["pursue_desire", "understand_cost"], "allow_manipulation_candidates": true})
                else:
                    selected_profile = Foolish_Detective(2, 0.25, ["pursue_desire", "avoid_attachment", "solve_case", "understand_cost"], [], dv_find(old, "class_bias", []), basis)
            if actor.id == "detective":
                let threshold = selected_profile.Implicature_Resistance
                samples = dv_append(samples, cognitive_sample("implicature_threshold", [dv_max(0, threshold - 0.05), threshold, dv_min(1, threshold + 0.05)], basis))
            actor = dv_with(actor, "cognitive_initialization", cognitive_initialization(selected_profile, samples, basis))
        rt_push(actors, actor)
        i = i + 1
    return dv_with_many(scene, {"actors": actors, "opening_seed": seed, "detective_profile": profile})
