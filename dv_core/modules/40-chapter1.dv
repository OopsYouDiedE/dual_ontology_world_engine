fn dvs_scenario_base():
    return c1_active_configuration(c1_hist_install_scene(c1_scenario_native()))

fn c1_question_text(stage):
    if (stage == "prompt"):
        叙述：
            门是谁闩上的？
    else:
        if (stage == "voice_source"):
            叙述：
                苏泠听见的呼喊来自哪里？
        else:
            if (stage == "words"):
                叙述：
                    原话是什么？
            else:
                叙述：
                    既听同伴说门外有人，为何仍闩门？

fn c1_person_policy(id):
    let policy = c1_base_person_policy(id)
    var bindings = policy.topic_bindings
    let stages = ["identity", "voice_source", "words", "trust"]
    var i = 0
    while (i < rt_count(stages)):
        let stage = stages[i]
        rt_push(bindings, {"topic": stage, "heard_when": dv_fact(dv_ref("question", "state", rt_cat("open_", stage)), true), "completed_when": dv_not(dv_true()), "basis": [campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/07_答辩.story", 3, "answer_open.002")]})
        i = i + 1
    var updated = dv_with(policy, "topic_bindings", bindings)
    var palm_goals = dv_find(updated, "goals", [])
    rt_push(palm_goals, {"kind": "achieve", "proposition": campaign_at(id, "R05"), "available_when": dv_fact(c1_palm_invitation_ref(), true), "basis": [campaign_source("user", 0, "实际听闻邀请后可自行走到书架旁比对")]})
    if id == "detective":
        rt_push(palm_goals, {"kind": "know", "ref": campaign_evidence_ref("hand_not_mine"), "available_when": c1_statement("shelf_old"), "basis": [campaign_source("user", 0, "亲见书架手印后本人需要真实掌宽比对")]})
        let rooms = ["hall", "pantry", "foyer", "corridor", "R05", "R06", "R07", "R08"]
        var invitation_room = 0
        while invitation_room < rt_count(rooms):
            rt_push(palm_goals, {"kind": "communicate", "method_id": rt_cat("detective.invite-palms.", rooms[invitation_room]), "available_when": c1_statement("shelf_old"), "basis": [campaign_source("user", 0, "亲见书架后请同伴一同比对")]})
            invitation_room = invitation_room + 1
    updated = dv_with(updated, "goals", palm_goals)
    if id != "detective":
        var goals = dv_find(updated, "goals", [])
        rt_push(goals, {"kind": "know", "ref": c1_deep_resonance_ref(id), "available_when": c1_statement(c1_deep_resonance_site(id).evidence), "basis": c1_op_desire(id).basis})
        let keys = ["voice-source", "original-words", "familiarity"]
        var key_index = 0
        while key_index < rt_count(keys):
            rt_push(goals, {"kind": "communicate", "method_id": rt_cat(rt_cat(id, ".respond-defense-conflict."), keys[key_index]), "available_when": campaign_at(id, "hall"), "basis": c1_op_desire(id).basis})
            key_index = key_index + 1
        updated = dv_with(updated, "goals", goals)
    if id == "shen":
        let ask = c1_recall_advice_question()
        updated = dv_with(updated, "goals", dv_append(updated.goals, {"kind": "communicate", "scope": "personal", "method_id": ask.id, "available_when": ask.precondition, "basis": ask.source_refs}))
        let responses = c1_recall_advice_responses()
        var response_index = 0
        while response_index < rt_count(responses):
            let response = responses[response_index]
            updated = dv_with(updated, "goals", dv_append(updated.goals, {"kind": "communicate", "scope": "personal", "method_id": response.id, "available_when": response.precondition, "basis": response.source_refs}))
            response_index = response_index + 1
    return updated


// These actions publish evidence only after successful execution at the site.
fn c1_evidence_contact_ref(actor, evidence):
    return dv_ref("ritual", "state", rt_cat(rt_cat("compared.", actor), rt_cat(".", evidence)))

fn c1_evidence_contact_premise(actor, evidence):
    if evidence == "E2":
        return campaign_at(actor, "foyer")
    return dv_all([campaign_at(actor, "R05"), campaign_at("detective", "R05"), campaign_at("huo", "R05"), campaign_at("shen", "R05"), campaign_at("su", "R05")])

法则 c1_evidence_contact，给定 行动者、evidence：
    前提 c1_evidence_contact_premise(行动者, evidence)。
    则 c1_evidence_contact_ref(行动者, evidence) 变为 true。

fn c1_evidence_contact_methods(world, actor, mode):
    var result = world
    let evidence = ["E2", "E11"]
    var i = 0
    while i < rt_count(evidence):
        let name = rt_cat(rt_cat(actor, ".compare."), evidence[i])
        result = dv_adopt(result, campaign_method(name, c1_evidence_contact(actor, evidence[i])), mode, 1, [campaign_source("user", 0, "现场比对；成功Complete后形成证据")])
        i = i + 1
    if actor == "detective":
        let rooms = ["hall", "pantry", "foyer", "corridor", "R05", "R06", "R07", "R08"]
        var invitation_room = 0
        while invitation_room < rt_count(rooms):
            result = dv_adopt(result, campaign_method(rt_cat("detective.invite-palms.", rooms[invitation_room]), c1_palm_invitation_law(rooms[invitation_room])), mode, 1, [campaign_source("user", 0, "亲见手印后实际邀请同行比对")])
            invitation_room = invitation_room + 1
    if actor != "detective":
        result = dv_adopt(result, campaign_method(rt_cat(actor, ".deep-resonance"), c1_deep_resonance_law(actor)), mode, 1, [c1_deep_resonance_source(actor)])
    return result

fn c1_compare_wedge_action(actor):
    let name = rt_cat(actor, ".compare.E2")
    var action = c1_once(campaign_intent_action(name, "move", campaign_at(actor, "foyer"), campaign_at(actor, "foyer"), name, [c1_evidence_contact_ref(actor, "E2"), campaign_evidence_ref("ash_wedge")], "对照木楔与门底痕迹", campaign_source("user", 0, "E2厚度、擦痕和灰扇现场比对")))
    return dv_with_many(action, {"predict_law": name, "travel": {"from": "foyer", "to": "foyer", "station": "site:E2"}, "surface": "把木楔的厚度贴着门底擦痕比过，再对照门缝向内散开的灰扇。木楔曾撑起门缝，烟灰从门缝进入。", "sensory_mode": "executed-physical-comparison"})

fn c1_compare_palms_action(actor):
    let name = rt_cat(actor, ".compare.E11")
