fn c1_infer_rules():
    return [c1_infer_0("cognition"), c1_infer_1("cognition"), c1_infer_2("cognition"), c1_infer_3("cognition"), c1_infer_4("cognition"), c1_infer_5("cognition"), c1_infer_6("cognition"), c1_infer_7("cognition"), c1_infer_8("cognition"), c1_infer_9("cognition"), c1_infer_10("cognition"), c1_infer_11("cognition"), c1_infer_12("cognition"), c1_infer_13("cognition"), c1_infer_14("cognition"), c1_infer_15("cognition"), c1_infer_16("cognition"), c1_infer_17("cognition"), c1_infer_18("cognition"), c1_infer_19("cognition")]

fn c1_adopt_inferences(mind):
    var rules = c1_infer_rules()
    var result = mind
    var i = 0
    while (i < rt_count(rules)):
        result = dv_adopt(result, rules[i], "infer", 0.85, dv_single(campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/可习得命题.story", 2, "推知关系")))
        i = (i + 1)
    return result

fn c1_move_name(actor, origin, target):
    return rt_cat(rt_cat(rt_cat(actor, ".move."), origin), rt_cat(".", target))

fn c1_place_label(place):
    return campaign_location_title(place)

fn c1_move_action(actor, origin, target):
    var name = c1_move_name(actor, origin, target)
    return dv_with_many(campaign_intent_action(name, "move", campaign_at(actor, origin), campaign_at(actor, origin), name, dv_single(dv_ref(actor, "state", "location")), rt_cat("前往", c1_place_label(target)), campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/实体登记.story", 19, "重演通路")), {"predict_law": name, "travel": {"from": origin, "to": target}})

fn c1_add_move_methods(world, actor, mode):
    var edges = c1_edges()
    var result = world
    var i = 0
    while (i < rt_count(edges)):
        var edge = edges[i]
        var a = edges[i][0]
        var b = edges[i][1]
        result = dv_adopt(result, campaign_method(c1_move_name(actor, a, b), c1_move(actor, a, b)), mode, 1, dv_single(campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/实体登记.story", 19, "重演通路")))
        result = dv_adopt(result, campaign_method(c1_move_name(actor, b, a), c1_move(actor, b, a)), mode, 1, dv_single(campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/实体登记.story", 19, "重演通路")))
        i = (i + 1)
    return result

fn c1_move_actions(actor):
    var edges = c1_edges()
    var result = []
    var i = 0
    while (i < rt_count(edges)):
        var a = edges[i][0]
        var b = edges[i][1]
        rt_push(result, c1_move_action(actor, a, b))
        rt_push(result, c1_move_action(actor, b, a))
        i = (i + 1)
    return result

