fn c1_raw_question_action(stage, surface, first):
    var local_1 = false
    if first:
        local_1 = "question"
    else:
        local_1 = "receive_question"
    var local_2 = false
    if first:
        local_2 = "demon.question"
    else:
        if (stage == "voice_source"):
            local_2 = "demon.original_question"
        else:
            local_2 = ""
    var speech = dv_with_many(c1_speech(dv_true(), surface, "heard-public-question"), {"utterance_type": "question", "surface": dvs_surface_parts([c1_question_text(stage), " 每一问，说一句结论，再拿出一件撑得住它的东西。"])})
    if stage == "prompt" or stage == "voice_source":
        speech = dv_with(speech, "implicature_candidates", [{"id": "outside-help-presumption"}])
    return dv_with_many(c1_once(campaign_intent_action(rt_cat("demon.question.", stage), local_1, dv_fact(dv_ref("question", "state", "stage"), stage), dv_fact(dv_ref("question", "state", "stage"), stage), local_2, dv_single(dv_ref("question", "state", "stage")), "提出当前案件问题", surface)), {"speech": speech, "listeners": ["detective", "huo", "shen", "su"], "public_grants": [dv_ref("question", "state", "open_identity"), dv_ref("question", "state", "open_voice_source"), dv_ref("question", "state", "open_words"), dv_ref("question", "state", "open_trust"), dv_ref("question", "state", "current"), dv_ref("question", "state", "original"), dv_ref("question", "state", "requires_evidence"), dv_ref("question", "state", "outstanding_complete")]})

fn c1_question_action(stage, surface, first):
    return campaign_authorized_speech(c1_raw_question_action(stage, surface, first))

