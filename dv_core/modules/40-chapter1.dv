fn c1_costs():
    var costs = [dv_pair("opening", c1_cost(20, campaign_source("godot_csharp/scenes/Awakening/Script/story/剧情时长.story", 17, "s3_broadcast：20"))), dv_pair("question", c1_cost(15, campaign_source("godot_csharp/scenes/Awakening/Script/story/剧情时长.story", 18, "s5_question：15"))), dv_pair("receive_question", c1_cost(1, campaign_source("docs/design-standard.md", 0, "实际行动耗时：1分钟内容参数"))), dv_pair("inspect", c1_cost(1, campaign_source("docs/design-standard.md", 0, "实际行动耗时：1分钟内容参数"))), dv_pair("experiment", c1_cost(17, campaign_source("godot_csharp/scenes/Awakening/Script/story/剧情时长.story", 31, "试验：17"))), dv_pair("help", c1_cost(1, campaign_source("docs/design-standard.md", 0, "实际行动耗时：1分钟内容参数"))), dv_pair("talk", c1_cost(1, campaign_source("docs/design-standard.md", 0, "实际行动耗时：1分钟内容参数"))), dv_pair("sound_test", c1_cost(24, campaign_source("godot_csharp/scenes/Awakening/Script/story/剧情时长.story", 34, "声路：24"))), dv_pair("replay", dv_with(c1_cost(29, campaign_source("godot_csharp/scenes/Awakening/Script/story/剧情时长.story", 35, "重演：29")), "work_limit", 320)), dv_pair("answer", c1_cost(10, campaign_source("godot_csharp/scenes/Awakening/Script/story/剧情时长.story", 36, "答辩：10"))), dv_pair("move", c1_cost(2, campaign_source("godot_csharp/scenes/Awakening/Script/story/剧情时长.story", 37, "走动：2"))), dv_pair("recall", c1_cost(1, campaign_source("docs/design-standard.md", 0, "实际行动耗时：1分钟内容参数")))]
    // Authored duration for first acquisition of a short notice; reviewing known text is presentation only.
    costs = dv_with(costs, "opening.notice", c1_cost(0, campaign_source("docs/design-standard.md", 506, "08:00开局已到期的晨间通知；保留正式履约与收闻")))
    return dv_with(costs, "read", c1_cost(1, campaign_source("docs/design-standard.md", 0, "首次阅读短公告：1分钟内容参数")))

fn c1_bindings():
    var people = ["demon", "detective", "huo", "shen", "su"]
    var objects = ["demon", "detective", "huo", "shen", "su", "cognition", "question", "ritual", "coat", "lens", "graphite_pencil", "evidence_bags"]
    var result = []
    var i = 0
    var j = 0
    while (i < rt_count(people)):
        j = 0
        while (j < rt_count(objects)):
            rt_push(result, dv_binding(objects[j], objects[j], people[i]))
            j = (j + 1)
        i = (i + 1)
    return result

fn c1_binding_gaps():
    return ["No quantified >=3-day evidence; withdraw insufficient adoption without asserting its negation", "Historical wake latency is unknown; representative model coordinates are not a measured wake timestamp", "Original Q2 is distinct from literal V3; only actual paid model argument and its real support may satisfy it", "Historical route coordinates use existing edge/speed values; reaction/propagation real durations remain uncalibrated", "Demon listener models are independent provisional estimates; actual listener understanding may differ"]

fn c1_scenario_native():
    return dv_with(dv_with(dv_with(dv_with({"format": "dv-session-v1", "id": "chapter1-native-authoring", "physical": c1_physical_world(), "actors": [c1_character_demon(), c1_character_detective(), c1_character_huo(), c1_character_shen(), c1_character_su()]}, "bindings", c1_bindings()), "cost_model", c1_costs()), "formal_answers", c1_formal_answers()), "max_actions", 1200)

fn c1_variant_weight(weight, id):
    var data = dvs_scenario_base()
    var actors = data.actors
    var result = []
    var i = 0
    while (i < rt_count(actors)):
        var actor = actors[i]
        if (actor.id == "detective"):
            actor = dv_with(actor, "policy", dv_with(actor.policy, "information_weight", weight))
        rt_push(result, actor)
        i = (i + 1)
    return dv_with(dv_with(data, "actors", result), "id", id)

fn dvs_scenario_low():
    return c1_variant_weight(10.8, "chapter1-information-low")

fn dvs_scenario_holdout():
    return c1_variant_weight(13.2, "chapter1-information-holdout")

fn dvs_scenario_boundary():
    var data = dvs_scenario_base()
    var actors = data.actors
    var result = []
    var i = 0
    var position = dv_ref("su", "state", "location")
    var basis = dv_single("Human-authorized noncanonical boundary initial position: Su at R05, only alarm/no-message source area")
    while (i < rt_count(actors)):
        var actor = actors[i]
        if (actor.id == "su"):
            actor = dv_with(actor, "mind", dv_store(actor.mind, position, dv_with(dv_with(dv_read(actor.mind, position), "value", "R05"), "basis", basis)))
        rt_push(result, actor)
        i = (i + 1)
    return dv_with(dv_with(dv_with(data, "actors", result), "physical", dv_store(data.physical, position, dv_with(dv_with(dv_read(data.physical, position), "value", "R05"), "basis", basis))), "id", "chapter1-boundary-noncanonical")

