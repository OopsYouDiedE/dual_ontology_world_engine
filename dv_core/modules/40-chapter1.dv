#include 35-campaign-schema.dv

// Native chapter authorship: named worlds, characters, actions and structured speech.
// Old .story files are read-only provenance. This module never parses their serialized format.
// These authority conclusions are frozen authored history, never grants or mind initial facts.
// In particular familiar is a source scenario truth; the person's inference remains evidence-weighted.
// Truth, personally supported claim, topic relevance and actual shown evidence are independent axes.
// In particular a true location or a bare trust/familiarity claim does not answer the current question.
// Preserve both original lawful showings: E8 plus executed trial, or the E5 hollow-frame evidence.
// E2 or E9/E10 may show the motive; the full reason remains personally supported.
// Speech candidates share the one actual opening transition. Every fragment uses original words.

// 文件内称谓只展开为原有标识，不改变对象身份或授予认识。
称谓 乙区门厅 为「foyer」。
称谓 乙区大厅 为「hall」。
称谓 侦探 为「detective」。
称谓 所在地 为「location」。
称谓 备餐间 为「pantry」。
称谓 开放状态 为「open」。
称谓 恶魔 为「demon」。
称谓 起居厅 为「living_hall」。
称谓 雀儿 为「quer」。
称谓 沈鼎 为「shen」。
称谓 霍铎 为「huo」。
称谓 苏泠 为「su」。

fn c1_public_methods(actions):
    var result = []
    var n = 0
    while (n < rt_count(actions)):
        rt_push(result, c1_public_method(actions[n]))
        n = (n + 1)
    return result

fn c1_public_method(action):
    var method = dv_with(dv_with(action, "purpose_refs", dv_find(action, "purpose_refs", action.grants)), "purpose_basis", action.source_refs)
    var kind = action.kind
    if (kind == "answer"):
        return c1_public_answer_speech(dv_with(method, "topic", dv_find(action, "topic", c1_answer_topic(action.answer_id))))
    else:
        if dv_or((kind == "move"), (kind == "replay")):
            if (not dv_find(action, "once", false)):
                return dv_with(method, "repeatable", true)
            return method
        else:
            return method

fn c1_inquiry_choice(action, group, thorough):
    var promotes = ["solve_case", "avoid_attachment"]
    var sacrifices = ["evidence", "clarify_terms"]
    if thorough:
        promotes = ["solve_case", "evidence", "clarify_terms"]
        sacrifices = ["avoid_attachment"]
    return dv_with(action, "personal_choice", {"group": group, "requires": action.precondition, "prohibits": dv_not(dv_true()), "promotes": promotes, "sacrifices": sacrifices, "basis": action.source_refs})

fn c1_question_call_rule():
    let source = campaign_source("user:current-request", 0, "heard-question-outside-help-presumption")
    let established = dv_all([c1_statement("remote_voice"), c1_statement("heads_lost"), c1_statement("words_bolt")])
    return {"id": "outside-help-presumption", "cue": "outside-help-presumption", "premise": dv_true(), "proposition": c1_statement("outside_help_presumed"), "prior": 0.6, "basis": [source], "source_scope": "heard-public-question", "target_scope": "historical-caller-purpose", "scope_bridge": {"op": "constant", "value": "unknown"}, "available_when": dv_true(), "withdraw_when": established}

fn c1_shallow_question_action(actor):
    let source = campaign_source("user:current-request", 0, "owner-report-of-heard-question-presumption")
    var action = c1_once(campaign_intent_action(rt_cat(actor, ".question.report-presumption"), "talk", campaign_at(actor, "hall"), campaign_at(actor, "hall"), "", [], "请求说明当前指认的依据", source))
    action = dv_with_many(action, {"speech": dv_with(c1_speech(dv_true(), source, "own-defeasible-interpretation"), "surface", "问话提到了门外的呼喊，我先把它理解成求救；声音从哪里来，仍该核对。"), "listeners": ["demon", "huo", "shen", "su"], "owner_interpretation_requirement": {"subject": actor, "interpretation_id": "outside-help-presumption", "required_status": "accepted"}, "personal_purpose": {"subject": actor, "id": "state-provisional-reading", "basis": [source]}})
    return c1_inquiry_choice(action, "chapter1-inquiry", false)

fn c1_answer_topic(id):
    if (id == "me"):
        return "identity"
    else:
        if dv_or((id == "V3_0"), (id == "V3_1")):
            return "voice_source"
        else:
            if dv_or((id == "V4_0"), (id == "V4_1")):
                return "words"
            else:
                if (id == "trust"):
                    return "trust"
                else:
                    return "auxiliary"

fn c1_once(action):
    return dv_with(action, "once", true)

fn c1_observe_as(action, source, origin, trust):
    var result = dv_with(dv_with(dv_with(action, "observation_source", source), "observation_origin", origin), "observation_trust", trust)
    if dv_and((source == "testimony"), (not (origin == "demon"))):
        return c1_personal_request(result, origin)
    else:
        return result

fn c1_query_basis(atom):
    if dv_or((atom == "slate_code"), dv_or((atom == "slate_person"), (atom == "recalled_copper"))):
        return c1_statement("slate_marks")
    else:
        if (atom == "frame_hollow"):
            return c1_statement("fork_dent")
        else:
            if (atom == "cups_known"):
                return c1_statement("cups_preferences")
            else:
                if dv_or((atom == "starter_kept"), (atom == "recalled_names")):
                    return c1_statement("starter_layers")
                else:
                    if (atom == "heads_lost"):
                        return dv_fact(dv_ref("ritual", "state", "sound_trial_done"), true)
                    else:
                        return dv_true()

fn c1_personal_request(action, target):
    action = dv_without(action, "surface")
    var scope = action.grants
    var atom = action.grants[0].field
    var speech = dv_with(dv_with(c1_speech(dv_true(), "请把你辨认出的内容说给我听。", "professional-request"), "utterance_type", "question"), "request", {"target": target, "topic": action.grants[0].field})
    return dv_with(dv_with(dv_with(dv_with(dv_with(dv_with(action, "grants", []), "purpose_refs", scope), "precondition", dv_all([c1_query_basis(atom), dv_not(c1_statement(atom))])), "authority_precondition", dv_true()), "speech", speech), "listeners", dv_single(target))

fn c1_vector(time):
    return {"time": time, "computation": 1, "stamina": 0}

fn c1_cost(time, source):
    return dv_with({"minimum": c1_vector(time), "maximum": c1_vector(time), "actual": c1_vector(time)}, "source_refs", dv_single(source))

fn c1_materials():
    return [dv_pair("bolt_down", dv_field(true)), dv_pair("ash_wedge", dv_field(true)), dv_pair("boots_toward_bolt", dv_field(true)), dv_pair("cloth_after_boots", dv_field(true)), dv_pair("fork_dent", dv_field(true)), dv_pair("score_partial", dv_field(true)), dv_pair("score_in_room", dv_field(true)), dv_pair("slate_marks", dv_field(true)), dv_pair("pipe_layout", dv_field(true)), dv_pair("cups_preferences", dv_field(true)), dv_pair("starter_layers", dv_field(true)), dv_pair("shelf_old", dv_field(true)), dv_pair("lens_mine", dv_field(true)), dv_pair("boots_fit", dv_field(true)), dv_pair("frame_hollow", dv_field(true)), dv_pair("slate_code", dv_field(true)), dv_pair("slate_person", dv_field(true)), dv_pair("cups_known", dv_field(true)), dv_pair("starter_kept", dv_field(true)), dv_pair("hand_not_mine", dv_field(true)), dv_pair("sound_trial", dv_field(true)), dv_pair("heads_lost", dv_field(true)), dv_pair("recalled_bolt", dv_field(true)), dv_pair("recalled_trust", dv_field(true)), dv_pair("recalled_copper", dv_field(true)), dv_pair("recalled_names", dv_field(true))]

fn c1_authority_conclusions():
    return [dv_pair("me", dv_field(true)), dv_pair("remote_voice", dv_field(true)), dv_pair("words_bolt", dv_field(true)), dv_pair("familiar", dv_field(true)), dv_pair("trust_reason", dv_field(true)), dv_pair("su_room", dv_field(true)), dv_pair("su_hall", dv_field(false)), dv_pair("su_pantry", dv_field(false)), dv_pair("huo_copper", dv_field(true)), dv_pair("huo_room", dv_field(false)), dv_pair("huo_foyer", dv_field(false)), dv_pair("heed_huo", dv_field(true)), dv_pair("heed_su", dv_field(false)), dv_pair("heed_neither", dv_field(false))]

fn c1_physical_cognition():
    var fields = c1_materials()
    var conclusions = c1_authority_conclusions()
    var i = 0
    while (i < rt_count(conclusions)):
        fields = dv_with(fields, conclusions[i][0], conclusions[i][1])
        i = (i + 1)
    return campaign_state_object("cognition", fields)

fn c1_position(actor, room):
    return campaign_state_object(actor, dv_single(dv_pair("location", dv_field(room))))

fn c1_edges():
    return [dv_pair("R05", "corridor"), dv_pair("R06", "corridor"), dv_pair("R07", "corridor"), dv_pair("R08", "corridor"), dv_pair("corridor", "hall"), dv_pair("hall", "pantry"), dv_pair("hall", "foyer")]

