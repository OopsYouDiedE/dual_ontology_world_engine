fn c1_hist_variable_specs():
    return [["V1", "R08", "su_room", true, 1], ["V1", "hall", "su_hall", true, 1], ["V1", "pantry", "su_pantry", true, 1], ["V2", "hall", "huo_copper", true, 11], ["V2", "R06", "huo_room", true, 11], ["V2", "foyer", "huo_foyer", true, 11], ["V3", "Tube", "remote_voice", true, 21], ["V3", "OutsideDoor", "remote_voice", false, 21], ["V4", "BoltKeepShut", "words_bolt", true, 30], ["V4", "OpenSaveMe", "words_bolt", false, 30], ["V5", "huo", "heed_huo", true, 39], ["V5", "su", "heed_su", true, 39], ["V5", "self", "heed_neither", true, 39], ["V6", false, "familiar", false, 49], ["V6", true, "familiar", true, 50]]

fn c1_hist_domain(id, values):
    return {"id": id, "version": 1, "ref": dv_ref("history", "actual", id), "values": values}

fn c1_hist_domains():
    return [c1_hist_domain("V1", dv_list3("R08", "hall", "pantry")), c1_hist_domain("V2", dv_list3("hall", "R06", "foyer")), c1_hist_domain("V3", dv_pair("Tube", "OutsideDoor")), c1_hist_domain("V4", dv_pair("BoltKeepShut", "OpenSaveMe")), c1_hist_domain("V5", dv_list3("huo", "su", "self")), c1_hist_domain("V6", dv_pair(false, true))]

fn c1_hist_coordinate_name(index):
    return rt_cat("history.coordinate.", rt_show(index))

fn c1_hist_constraints():
    var specs = c1_hist_variable_specs()
    var result = []
    var index = 0
    while (index < rt_count(specs)):
        var spec = specs[index]
        var variable = specs[index][0]
        var value = specs[index][1]
        rt_push(result, dv_with(dv_with(dv_with(dv_with({"id": rt_cat("history.exclude.", rt_show(index)), "domain_versions": dv_single(dv_pair(variable, 1)), "scope": dv_single(variable), "assignments": dv_single({"variable": variable, "value": value})}, "condition", dv_fact(dv_ref("history", "actual", variable), value)), "support", dv_not(dv_fact(dv_ref("history", "actual", variable), value))), "infer_laws", c1_hist_coordinate_versions(variable)), "basis", dv_single(campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/推演变量与陈述.story", spec[4], variable))))
        index = (index + 1)
    return result

fn c1_hist_coordinate_versions(variable):
    var specs = c1_hist_variable_specs()
    var result = []
    var index = 0
    while (index < rt_count(specs)):
        if (specs[index][0] == variable):
            rt_push(result, {"id": c1_hist_coordinate_name(index), "version": 1})
        index = (index + 1)
    // Coordinate claims may depend on the person's ordinary learned inferences.
    // Declaring these laws grants no fact: the certificate still replays each
    // actual inference and traces its premises back to the person's receipts.
    let inferences = c1_infer_rules()
    index = 0
    while (index < rt_count(inferences)):
        rt_push(result, {"id": inferences[index].name, "version": inferences[index].version})
        index = index + 1
    return result

fn c1_hist_add_coordinates(mind):
    var specs = c1_hist_variable_specs()
    var result = mind
    var index = 0
    while (index < rt_count(specs)):
        var spec = specs[index]
        result = dv_adopt(result, campaign_method(c1_hist_coordinate_name(index), c1_hist_coordinate("cognition", "history", spec[2], spec[3], spec[0], spec[1])), "infer", 0.85, dv_single(campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/推演变量与陈述.story", spec[4], spec[0])))
        index = (index + 1)
    return result

fn c1_hist_assignments(su_room, huo_room, source, words, preference, familiar):
    return [{"variable": "V1", "value": su_room}, {"variable": "V2", "value": huo_room}, {"variable": "V3", "value": source}, {"variable": "V4", "value": words}, {"variable": "V5", "value": preference}, {"variable": "V6", "value": familiar}]

fn c1_hist_assumptions(su_room, huo_room, source, words, preference, familiar):
    return [dv_fact(dv_ref("history", "inputs", "su_origin"), su_room), dv_fact(dv_ref("history", "inputs", "huo_origin"), huo_room), dv_fact(dv_ref("history", "inputs", "source"), source), dv_fact(dv_ref("history", "inputs", "words"), words), dv_fact(dv_ref("history", "inputs", "trust_choice"), preference), dv_fact(dv_ref("history", "inputs", "familiar"), familiar)]

fn c1_hist_claim_slots():
    return dv_list3(dv_with({"slot_id": "actual_heard", "ref": c1_hist_claim_ref("actual_heard"), "trace_at": 160, "feature_index": 0}, "value_from_prediction", true), dv_with({"slot_id": "voice_source", "ref": c1_hist_claim_ref("voice_source"), "trace_at": 160, "feature_index": 4}, "value_from_prediction", true), dv_with({"slot_id": "transmission_loss", "ref": c1_hist_claim_ref("transmission_loss"), "trace_at": 160, "feature_index": 6}, "value_from_prediction", true))

fn c1_hist_feature(predicted, observed, label):
    return {"proposition": dv_fact(campaign_evidence_ref(predicted), true), "observation": dv_fact(campaign_evidence_ref(observed), true), "at": 160, "public_observation_label": label}

fn c1_hist_features():
    return [c1_hist_feature("predicted_bolt", "bolt_down", "隔离门内闩"), c1_hist_feature("predicted_wedge_soot", "ash_wedge", "木楔上的烟灰"), c1_hist_feature("predicted_boots_bolt", "boots_toward_bolt", "靴印朝向内闩"), c1_hist_feature("predicted_cloth_over_heel", "cloth_after_boots", "湿布压住靴印"), c1_hist_feature("predicted_slate_first", "slate_marks", "石板第一行刻痕"), c1_hist_feature("predicted_slate_second", "slate_person", "石板第二行图记"), c1_hist_feature("predicted_score_tail", "score_partial", "乐谱中的残缺词句")]

// Exact content whitelist; old unlabeled records stay private.
fn c1_hist_public_feature(feature):
    let declared = c1_hist_features()
    var i = 0
    while i < rt_count(declared):
        if dv_same(feature, declared[i]):
            return declared[i]
        i = i + 1
    return false

fn c1_hist_response_world(preference):
    var mind = dv_world(rt_cat("history-response-", preference), "mind", "modeled.detective")
    var basis = dv_pair(campaign_source("docs/design-standard.md", 713, "V5-trust-plus-one-not-action"), campaign_source("docs/design-standard.md", 723, "competing-reports-and-SocialSystem"))
    mind = c1_add_objects(mind, [campaign_local_object("modeled.detective"), campaign_local_object("modeled.huo"), campaign_local_object("modeled.su"), campaign_local_object("joint.request"), campaign_local_object("response.outcome")])
    mind = dv_store(mind, dv_ref("response.outcome", "state", "value"), dv_with(dv_field(0), "basis", basis))
    var local_1 = false
    if (preference == "huo"):
        local_1 = 4
    else:
        local_1 = 3
    var local_2 = false
    if (preference == "huo"):
        local_2 = 4
    else:
        local_2 = 3
    mind = dv_adopt(mind, campaign_method("huo.value", c1_hist_social_preview("modeled.huo", local_1, local_2)), "predict", 0.85, basis)
    var local_3 = false
    if (preference == "su"):
        local_3 = 4
    else:
        local_3 = 3
    var local_4 = false
    if (preference == "su"):
        local_4 = 4
    else:
        local_4 = 3
    mind = dv_adopt(mind, campaign_method("su.value", c1_hist_social_preview("modeled.su", local_3, local_4)), "predict", 0.85, basis)
    var local_5 = false
    if (preference == "self"):
        local_5 = 3
    else:
        local_5 = 2
    mind = dv_adopt(mind, campaign_method("inspect.value", c1_hist_inspection_preview(local_5)), "predict", 0.85, dv_pair(campaign_source("docs/design-standard.md", 713, "own-inspection-strengthens-evidence-preference"), campaign_source("godot_csharp/scenes/Awakening/Script/story/生态/人物/01_侦探.story", 29, "existing-caution-two")))
    return dv_accept_policy(mind, "joint-response", dv_person_policy("modeled.detective", dv_single(dv_criterion("relative-outcome", dv_ref("response.outcome", "state", "value"), "numeric", 0, 1)), 0, 1, []), basis)

fn c1_hist_response_option(id, received, predict, bridge):
    return dv_with(dv_with(dv_with({"id": id, "intent": id, "feasible": dv_fact(dv_ref("joint.request", "state", received), true), "effort": 0}, "feature_weights", []), "predict_law", predict), "bridge_law", bridge)

fn c1_hist_response_model(preference):
    return dv_with(dv_with(dv_with(dv_with(dv_with({"owner": "detective", "basis": dv_pair(campaign_source("docs/design-standard.md", 713, "V5-V6-model-not-fact"), campaign_source("docs/design-standard.md", 723, "joint-contradictory-reports")), "confidence": 0.85, "world": c1_hist_response_world(preference)}, "context", [{"from": dv_ref("history", "relationships", "trust_huo"), "to": dv_ref("modeled.huo", "relationship", "trust")}, {"from": dv_ref("history", "relationships", "trust_su"), "to": dv_ref("modeled.su", "relationship", "trust")}, {"from": dv_ref("history", "state", "request_received"), "to": dv_ref("joint.request", "state", "huo_received")}, {"from": dv_ref("history", "state", "det_heard_su_report"), "to": dv_ref("joint.request", "state", "su_received")}]), "requests", dv_single(dv_pair("competing-reports", dv_request("joint.request", "modeled.huo", "modeled.detective")))), "options", dv_list3(dv_pair("accept-huo", c1_hist_response_option("accept-huo", "huo_received", "huo.value", "history.response.huo")), dv_pair("accept-su", c1_hist_response_option("accept-su", "su_received", "su.value", "history.response.su")), dv_pair("inspect", c1_hist_response_option("inspect", "huo_received", "inspect.value", "history.response.self")))), "policy_id", "joint-response"), "choice_ref", dv_ref("history", "response", "detective"))

fn c1_hist_response_models():
    return dv_list3(dv_pair("history.huo", c1_hist_response_model("huo")), dv_pair("history.su", c1_hist_response_model("su")), dv_pair("history.self", c1_hist_response_model("self")))

法则 c1_hist_alarm_wake，给定 knowledge：
    前提 dv_fact(dv_ref(knowledge, "state", "own_alarm_anchor"), true)。
    则 "past.detective" 的 "intent" 变为 "seek-instruction"。

法则 c1_hist_visit_door，给定 history：
    当 "past.detective" 的 所在地 等于 乙区大厅。
    并且 history 的 "request_received" 等于 true。
    则 "past.detective" 的 "intent" 变为 "visit-door"。

法则 c1_hist_begin_return，给定 history、knowledge：
    当 "past.detective" 的 所在地 等于 乙区门厅。
    并且 knowledge 的 "predicted_bolt" 等于 true。
    则 "past.detective" 的 "intent" 变为 "return-report"。

法则 c1_hist_su_begin_score，给定 history：
    当 "past.su" 的 所在地 等于 乙区门厅。
    并且 "past.su" 的 "intent" 等于 "wait-at-door"。
    并且 history 的 "door_open" 等于 false。
    则 "past.su" 的 "intent" 变为 "write-score"。

法则 c1_hist_print_occurrence，给定 history、knowledge：
    前提 dv_fact(dv_ref(knowledge, "state", "predicted_boots_bolt"), true)。
    则 history 的 "prints_exist" 变为 true。

法则 c1_hist_shen_smoke_response，给定 history：
    当 "past.shen" 的 "belief" 的 "smoke" 等于 true。
    并且 history 的 "door_open" 等于 false。
    则 "past.shen" 的 "intent" 变为 "place-wet-cloth"。

法则 c1_hist_episode_registers，给定 history：
    前提 dv_true()。
    则 history 的 "request_received" 变为 false。
    并使 history 的 "det_heard_relay" 变为 false。
    并使 history 的 "det_heard_su_report" 变为 false。
    并使 history 的 "prints_exist" 变为 false。
    并使 "past.su" 的 "intent" 变为 "idle"。
    并使 "past.huo" 的 "intent" 变为 "idle"。
    并使 "past.shen" 的 "intent" 变为 "idle"。
    并使 "past.detective" 的 "intent" 变为 "idle"。
    并使 "past.su" 的 "belief" 的 "outside_wants_open" 变为 false。
    并使 "past.huo" 的 "belief" 的 "outside_wants_open" 变为 false。
    并使 history 的 "at_origin" 变为 false。
    并使 history 的 "latching_complete" 变为 false。

fn c1_hist_setup(mind):
    var result = c1_add_objects(mind, [campaign_local_object("history_claims"), campaign_local_object("history"), campaign_local_object("past.su"), campaign_local_object("past.huo"), campaign_local_object("past.detective"), campaign_local_object("past.shen")])
    return c1_hist_add_coordinates(result)

fn c1_hist_predicate_basis():
    return dv_list3(campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/声路与真相.story", 125, "smoke-footprints-cloth"), campaign_source("docs/design-standard.md", 718, "heard-words-by-channel"), campaign_source("docs/design-standard.md", 724, "perception-cognition-response"))

fn c1_hist_adopt(mind, id, rule):
    return dv_adopt(mind, campaign_method(id, rule), "predict", 0.85, c1_hist_predicate_basis())

fn c1_hist_adopt_shared(mind):
    var result = mind
    result = c1_hist_adopt(result, "history.reset", c1_hist_episode_registers("history"))
    result = c1_hist_adopt(result, "history.reset.records", c1_hist_reset_records("history", "cognition"))
    result = c1_hist_adopt(result, "history.wake", c1_hist_alarm_wake("cognition"))
    result = c1_hist_adopt(result, "history.smoke.due", c1_hist_smoke_due("history"))
    result = c1_hist_adopt(result, "history.smoke", c1_hist_smoke("history", "cognition"))
    result = c1_hist_adopt(result, "history.soot", c1_hist_wedge_soot("history", "cognition"))
    result = c1_hist_adopt(result, "history.su.intent", c1_hist_su_open_intent("history"))
    result = c1_hist_adopt(result, "history.huo.intent", c1_hist_huo_tail_open_intent("history"))
    result = c1_hist_adopt(result, "history.huo.guard", c1_hist_guard_call("history"))
    result = c1_hist_adopt(result, "history.request", c1_hist_receive_request("history", "cognition"))
    result = c1_hist_adopt(result, "history.visit", c1_hist_visit_door("history"))
    result = c1_hist_adopt(result, "history.su.report", c1_hist_su_report("history"))
    result = c1_hist_adopt(result, "history.response.huo", c1_hist_response_bridge("history", "accept-huo", "latch-request"))
    result = c1_hist_adopt(result, "history.response.su", c1_hist_response_bridge("history", "accept-su", "keep-open"))
    result = c1_hist_adopt(result, "history.response.self", c1_hist_response_bridge("history", "inspect", "inspect-first"))
    result = c1_hist_adopt(result, "history.latch", c1_hist_latch("history", "cognition"))
    result = c1_hist_adopt(result, "history.close-smoke", c1_hist_close_for_smoke("history"))
    result = c1_hist_adopt(result, "history.return", c1_hist_begin_return("history", "cognition"))
    result = c1_hist_adopt(result, "history.report", c1_hist_report("history", "cognition"))
    result = c1_hist_adopt(result, "history.su.return", c1_hist_su_begin_score("history"))
    result = c1_hist_adopt(result, "history.score", c1_hist_score("history", "cognition"))
    result = c1_hist_adopt(result, "history.fork", c1_hist_fork_tap("history", "cognition"))
    result = c1_hist_adopt(result, "history.prints", c1_hist_print_occurrence("history", "cognition"))
    result = c1_hist_adopt(result, "history.shen.intent", c1_hist_shen_smoke_response("history"))
    result = c1_hist_adopt(result, "history.cloth.place", c1_hist_cloth_response("history", "cognition"))
    result = c1_hist_adopt(result, "history.cloth", c1_hist_cloth("history", "cognition"))
    return result

法则 c1_hist_open_full_interpretation，给定 history、listener：
    前提 dv_fact(dv_ref(history, "heard_words", listener), "OpenSaveMe")。
    则 listener 的 "belief" 的 "outside_wants_open" 变为 true。

法则 c1_hist_layout_known，给定 knowledge、history：
    当 knowledge 的 "pipe_layout" 等于 true。
    并且 knowledge 的 "heads_lost" 等于 true。
    则 history 的 "loose_junction" 的 "R08" 变为 true。
    并使 history 的 "loose_junction" 的 乙区门厅 变为 true。

fn c1_hist_source_id(source, words):
    return rt_cat(rt_cat(source, "."), words)

fn c1_hist_origin_id(su_room, huo_room):
    return rt_cat(rt_cat("history.origin.", su_room), rt_cat(".", huo_room))

fn c1_hist_acoustic_id(source, words, listener, room):
    return rt_cat(rt_cat(rt_cat("history.hearing.", c1_hist_source_id(source, words)), rt_cat(".", listener)), rt_cat(".", room))

fn c1_hist_add_source_laws(mind):
    var result = mind
    var origins = dv_list3("R08", "hall", "pantry")
    var huos = dv_list3("hall", "R06", "foyer")
    var sources = dv_pair("Tube", "OutsideDoor")
    var words_list = dv_pair("BoltKeepShut", "OpenSaveMe")
    var listeners = dv_pair("past.su", "past.huo")
    var rooms = ["hall", "R08", "foyer", "pantry", "R05", "R06"]
    var i = 0
    var j = 0
    var k = 0
    var n = 0
    while (i < 3):
        j = 0
        while (j < 3):
            result = c1_hist_adopt(result, c1_hist_origin_id(origins[i], huos[j]), c1_hist_origin("history", "cognition", origins[i], huos[j]))
            j = (j + 1)
        i = (i + 1)
    i = 0
    while (i < 2):
        j = 0
        while (j < 2):
            var source = sources[i]
            var words = words_list[j]
            result = c1_hist_adopt(result, rt_cat("history.voice.", c1_hist_source_id(source, words)), c1_hist_voice_input("history", source, words))
            k = 0
            while (k < 2):
                n = 0
                while (n < 6):
                    var listener = listeners[k]
                    var room = rooms[n]
                    var local_1 = false
                    if (source == "Tube"):
                        if (room == "hall"):
                            local_1 = c1_hist_tube_full("history", listener, words)
                        else:
                            if dv_or((room == "R08"), (room == "foyer")):
                                var local_2 = false
                                if (words == "BoltKeepShut"):
                                    local_2 = "Open"
                                else:
                                    local_2 = "SaveMe"
                                local_1 = c1_hist_tube_tail("history", listener, room, words, local_2)
                            else:
                                if (room == "pantry"):
                                    local_1 = c1_hist_tube_hum("history", listener)
                                else:
                                    local_1 = c1_hist_room_alarm("history", listener, room)
                    else:
                        if dv_or((room == "R08"), (room == "foyer")):
                            local_1 = c1_hist_outside_received("history", listener, room, words)
                        else:
                            local_1 = c1_hist_room_silence("history", listener, room)
                    result = c1_hist_adopt(result, c1_hist_acoustic_id(source, words, listener, room), local_1)
                    n = (n + 1)
                k = (k + 1)
            j = (j + 1)
        i = (i + 1)
    return result

法则 c1_hist_room_alarm，给定 history、listener、room：
    当 history 的 "voice_source" 等于 "Tube"。
    并且 listener 的 所在地 等于 room。
    则 history 的 "heard_form" 的 listener 变为 "alarm-only"。
    并使 history 的 "heard_words" 的 listener 变为 "unintelligible"。

法则 c1_hist_outside_received，给定 history、listener、room、words：
    当 history 的 "voice_source" 等于 "OutsideDoor"。
    并且 history 的 "words" 等于 words。
    并且 listener 的 所在地 等于 room。
    则 history 的 "heard_form" 的 listener 变为 "muffled-full"。
    并使 history 的 "heard_words" 的 listener 变为 words。
    并使 history 的 "heard_origin" 的 listener 变为 "unresolved"。

法则 c1_hist_room_silence，给定 history、listener、room：
    当 history 的 "voice_source" 等于 "OutsideDoor"。
    并且 listener 的 所在地 等于 room。
    则 history 的 "heard_form" 的 listener 变为 "no-intelligible-voice"。
    并使 history 的 "heard_words" 的 listener 变为 "unintelligible"。

fn c1_hist_stage(at, laws):
    return {"at": at, "laws": laws, "optional": true}

fn c1_hist_travel_id(actor, origin, target, intent):
    return rt_cat(rt_cat(rt_cat(rt_cat("history.travel.", actor), rt_cat(".", origin)), rt_cat(".", target)), rt_cat(".", intent))

fn c1_hist_add_travel(mind, actor, origin, target, intent):
    return c1_hist_adopt(mind, c1_hist_travel_id(actor, origin, target, intent), c1_hist_travel(actor, origin, target, intent))

fn c1_hist_adopt_routes(mind):
    var result = mind
    var routes = [["past.detective", "R05", "corridor", "seek-instruction"], ["past.detective", "corridor", "hall", "seek-instruction"], ["past.detective", "hall", "foyer", "visit-door"], ["past.detective", "foyer", "hall", "return-report"], ["past.su", "R08", "corridor", "open-and-listen"], ["past.su", "corridor", "hall", "open-and-listen"], ["past.su", "hall", "foyer", "open-and-listen"], ["past.su", "foyer", "hall", "write-score"], ["past.su", "hall", "corridor", "write-score"], ["past.su", "corridor", "R08", "write-score"], ["past.shen", "pantry", "hall", "place-wet-cloth"], ["past.shen", "hall", "foyer", "place-wet-cloth"]]
    var index = 0
    while (index < rt_count(routes)):
        var route = routes[index]
        result = c1_hist_add_travel(result, route[0], route[1], route[2], route[3])
        index = (index + 1)
    return result

fn c1_hist_add_variant_laws(mind):
    var result = mind
    var listeners = dv_pair("past.su", "past.huo")
    var preferences = dv_list3("huo", "su", "self")
    var index = 0
    while (index < 2):
        var listener = listeners[index]
        result = c1_hist_adopt(result, rt_cat("history.tail-belief.", listener), c1_hist_open_interpretation("history", listener))
        result = c1_hist_adopt(result, rt_cat("history.open-belief.", listener), c1_hist_open_full_interpretation("history", listener))
        result = c1_hist_adopt(result, rt_cat("history.open-door.", listener), c1_hist_open_door("history", listener, "cognition"))
        index = (index + 1)
    index = 0
    while (index < 3):
        var preference = preferences[index]
        var local_1 = false
        if (preference == "huo"):
            local_1 = 4
        else:
            local_1 = 3
        var local_2 = false
        if (preference == "su"):
            local_2 = 4
        else:
            local_2 = 3
        result = c1_hist_adopt(result, rt_cat("history.relations.", preference), c1_hist_familiar_relations("history", preference, local_1, local_2))
        index = (index + 1)
    result = c1_hist_adopt(result, "history.layout", c1_hist_layout_known("cognition", "history"))
    result = c1_hist_adopt(result, "history.slate.BoltKeepShut", c1_hist_instruction_record("history", "cognition", "BoltKeepShut"))
    result = c1_hist_adopt(result, "history.slate.OpenSaveMe", c1_hist_instruction_record("history", "cognition", "OpenSaveMe"))
    result = c1_hist_adopt(result, "history.footprint", c1_hist_footprint("history", "cognition", "PoloBoot", "Bolt", "predicted_boots_bolt"))
    result = c1_hist_adopt(result, "history.argument.source.Tube", c1_hist_argument_source("history", "cognition", "Tube", "stressed-tail-without-leading-qualification"))
    result = c1_hist_adopt(result, "history.argument.source.OutsideDoor", c1_hist_argument_source("history", "cognition", "OutsideDoor", "muffled-full-speech"))
    result = c1_hist_adopt(result, "history.argument.heard.both", c1_hist_heard_argument("history", "cognition", true, "Huo-relay-and-Su-report"))
    result = c1_hist_adopt(result, "history.argument.heard.relay", c1_hist_heard_argument("history", "cognition", false, "Huo-relay-only"))
    return result

fn c1_hist_hearing_ids(source, words):
    var result = []
    var listeners = dv_pair("past.su", "past.huo")
    var rooms = ["hall", "R08", "foyer", "pantry", "R05", "R06"]
    var i = 0
    var j = 0
    while (i < 2):
        j = 0
        while (j < 6):
            rt_push(result, c1_hist_acoustic_id(source, words, listeners[i], rooms[j]))
            j = (j + 1)
        i = (i + 1)
    return result

fn c1_hist_order(stages):
    var result = []
    var used = []
    var count = 0
    while (count < rt_count(stages)):
        var found = false
        var best = 0
        var best_at = 0
        var index = 0
        while (index < rt_count(stages)):
            if dv_has(used, index):
                false
            else:
                var local_1 = false
                if found:
                    local_1 = (stages[index].at < best_at)
                else:
                    local_1 = true
                if local_1:
                    found = true
                    best = index
                    best_at = stages[index].at
            index = (index + 1)
        rt_push(used, best)
        rt_push(result, stages[best])
        count = (count + 1)
    return result

法则 c1_hist_smoke_pantry，给定 history：
    前提 dv_fact(dv_ref(history, "state", "smoke_entered"), true)。
    则 "past.shen" 的 "belief" 的 "smoke" 变为 true。

fn c1_hist_timeline(su_room, huo_room, source, words, preference):
    var stages = []
    var su_start = 1
    var su_corridor = (1 + (1.2 / 1.3))
    var su_hall = (1 + (3.2 / 1.3))
    var su_foyer = (1 + (5.7 / 1.3))
    rt_push(stages, c1_hist_stage(0, [c1_hist_origin_id(su_room, huo_room), "history.reset", "history.reset.records", "history.layout", "history.wake"]))
    rt_push(stages, c1_hist_stage(1, dv_single(rt_cat("history.voice.", c1_hist_source_id(source, words)))))
    c1_hist_hearing_stages(stages, 1, source, words)
    rt_push(stages, c1_hist_stage(1, ["history.tail-belief.past.su", "history.open-belief.past.su", "history.tail-belief.past.huo", "history.open-belief.past.huo", "history.su.intent", "history.huo.intent", rt_cat("history.slate.", words), "history.huo.guard", "history.open-door.past.huo", rt_cat("history.relations.", preference)]))
    rt_push(stages, c1_hist_stage(1.2, dv_single(c1_hist_travel_id("past.detective", "R05", "corridor", "seek-instruction"))))
    rt_push(stages, c1_hist_stage(2, dv_single("history.smoke.due")))
    c1_hist_hearing_stages(stages, 2.2, source, words)
    rt_push(stages, c1_hist_stage(3.2, dv_list3(c1_hist_travel_id("past.detective", "corridor", "hall", "seek-instruction"), "history.request", "history.visit")))
    if (su_room == "R08"):
        rt_push(stages, c1_hist_stage(su_corridor, dv_single(c1_hist_travel_id("past.su", "R08", "corridor", "open-and-listen"))))
        rt_push(stages, c1_hist_stage(su_hall, dv_single(c1_hist_travel_id("past.su", "corridor", "hall", "open-and-listen"))))
    if (su_room == "hall"):
        su_foyer = (1 + (2.5 / 1.3))
    rt_push(stages, c1_hist_stage(su_foyer, [c1_hist_travel_id("past.su", "hall", "foyer", "open-and-listen"), "history.open-door.past.su", "history.fork", "history.smoke", "history.soot"]))
    rt_push(stages, c1_hist_stage(5.7, dv_list3(c1_hist_travel_id("past.detective", "hall", "foyer", "visit-door"), "history.su.report", "history.smoke")))
    rt_push(stages, dv_with({"at": 5.7, "response": {"model": rt_cat("history.", preference), "request": "competing-reports", "options": dv_list3("accept-huo", "accept-su", "inspect")}, "optional": true}, "available_when", dv_fact(dv_ref("history", "state", "request_received"), true)))
    rt_push(stages, c1_hist_stage(5.7, ["history.latch", "history.close-smoke", "history.footprint", "history.prints", "history.return", "history.su.return", "history.argument.heard.both", "history.argument.heard.relay"]))
    rt_push(stages, c1_hist_stage(8.2, dv_pair(c1_hist_travel_id("past.detective", "foyer", "hall", "return-report"), "history.report")))
    rt_push(stages, c1_hist_stage((5.7 + (2.5 / 1.3)), dv_single(c1_hist_travel_id("past.su", "foyer", "hall", "write-score"))))
    rt_push(stages, c1_hist_stage((5.7 + (4.5 / 1.3)), dv_single(c1_hist_travel_id("past.su", "hall", "corridor", "write-score"))))
    rt_push(stages, c1_hist_stage((5.7 + (5.7 / 1.3)), dv_pair(c1_hist_travel_id("past.su", "corridor", "R08", "write-score"), "history.score")))
    rt_push(stages, c1_hist_stage((5.7 + (5.7 / 1.3)), dv_pair("history.smoke.pantry", "history.shen.intent")))
    rt_push(stages, c1_hist_stage(((5.7 + (5.7 / 1.3)) + (2 / 0.9)), dv_single(c1_hist_travel_id("past.shen", "pantry", "hall", "place-wet-cloth"))))
    rt_push(stages, c1_hist_stage(((5.7 + (5.7 / 1.3)) + (4.5 / 0.9)), dv_list3(c1_hist_travel_id("past.shen", "hall", "foyer", "place-wet-cloth"), "history.cloth.place", "history.cloth")))
    rt_push(stages, c1_hist_stage(160, dv_list3(rt_cat("history.argument.source.", source), "history.argument.heard.both", "history.argument.heard.relay")))
    return c1_hist_order(stages)

fn c1_manual_history_gate():
    let cups = dv_fact(campaign_evidence_ref("cups_preferences"), true)
    let starter = dv_fact(campaign_evidence_ref("starter_layers"), true)
    let names = dv_fact(campaign_evidence_ref("recalled_names"), true)
    // Three-valued disjunction through the existing all/not proposition model.
    return dv_not(dv_all([dv_not(dv_fact(campaign_evidence_ref("familiar"), true)), dv_not(dv_fact(campaign_evidence_ref("familiar"), false)), dv_not(dv_all([cups, starter])), dv_not(dv_all([cups, names])), dv_not(dv_all([starter, names]))]))

fn c1_manual_replay_variables():
    return [
        {"id": "V1", "label": "苏泠当时的位置", "values": [{"value": "R08", "label": "卧室"}, {"value": "hall", "label": "活动厅"}, {"value": "pantry", "label": "茶水间"}]},
        {"id": "V2", "label": "霍铎当时的位置", "values": [{"value": "hall", "label": "铜口旁"}, {"value": "R06", "label": "卧室"}, {"value": "foyer", "label": "门厅"}]},
        {"id": "V3", "label": "呼声的来源", "values": [{"value": "Tube", "label": "传声管"}, {"value": "OutsideDoor", "label": "门外"}]},
        {"id": "V4", "label": "当时的话语", "values": [{"value": "BoltKeepShut", "label": "闩门，别开"}, {"value": "OpenSaveMe", "label": "开门救人"}]},
        {"id": "V5", "label": "自己当时的选择", "values": [{"value": "huo", "label": "相信霍铎"}, {"value": "su", "label": "相信苏泠"}, {"value": "self", "label": "都不相信"}]},
        {"id": "V6", "label": "昨夜之前的关系（假设）", "available_when": c1_manual_history_gate(), "values": [{"value": false, "label": "彼此陌生"}, {"value": true, "label": "彼此熟悉"}]}
    ]

// A complete comparison needs actual owner receipts, regardless of their values.
// The alarm anchor remains an explicit hypothesis, not an acquired input.
fn c1_hist_external_inputs():
    var refs = [campaign_evidence_ref("pipe_layout"), campaign_evidence_ref("heads_lost")]
    let features = c1_hist_features()
    var i = 0
    while i < rt_count(features):
        refs = dvp_merge_refs(refs, dvs_sim_refs(features[i].observation))
        i = i + 1
    return refs

fn c1_hist_candidate(number, su_room, huo_room, source, words, preference, familiar):
    var manual_gate = dv_true()
    if familiar:
        manual_gate = c1_manual_history_gate()
    var assumptions = c1_hist_assumptions(su_room, huo_room, source, words, preference, familiar)
    rt_push(assumptions, dv_fact(campaign_evidence_ref("own_alarm_anchor"), true))
    rt_push(assumptions, dv_fact(dv_ref("history", "state", "sole"), "PoloBoot"))
    rt_push(assumptions, dv_fact(dv_ref("history", "state", "direction"), "Bolt"))
    return dv_with(dv_with(dv_with(dv_with(dv_with(dv_with(dv_with(dv_with(dv_with({"id": rt_cat("history-case-", rt_show(number)), "question": "original_q2_complete", "group": "six-variable-history", "prior": 0.5, "manual_available_when": manual_gate, "external_inputs": c1_hist_external_inputs()}, "proposition", dv_all(c1_hist_assumptions(su_room, huo_room, source, words, preference, familiar))), "basis", dv_pair(campaign_source("docs/design-standard.md", 703, "public-six-variable-candidate-space"), campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/声路与真相.story", 102, "fixed-external-event-catalog"))), "available_when", dv_fact(dv_ref("question", "state", "outstanding_complete"), true)), "assumptions", assumptions), "variable_assignments", c1_hist_assignments(su_room, huo_room, source, words, preference, familiar)), "timeline", c1_hist_timeline(su_room, huo_room, source, words, preference)), "start_time", 0), "features", c1_hist_features()), "claim_slots", c1_hist_claim_slots())

fn c1_hist_candidates():
    var result = []
    var domains = c1_hist_domains()
    var a = 0
    var b = 0
    var c = 0
    var d = 0
    var e = 0
    var f = 0
    var number = 0
    while (a < 3):
        b = 0
        while (b < 3):
            c = 0
            while (c < 2):
                d = 0
                while (d < 2):
                    e = 0
                    while (e < 3):
                        f = 0
                        while (f < 2):
                            rt_push(result, c1_hist_candidate(number, domains[0].values[a], domains[1].values[b], domains[2].values[c], domains[3].values[d], domains[4].values[e], domains[5].values[f]))
                            number = (number + 1)
                            f = (f + 1)
                        e = (e + 1)
                    d = (d + 1)
                c = (c + 1)
            b = (b + 1)
        a = (a + 1)
    return result

fn c1_hist_policy(policy):
    var hypotheses = policy.hypotheses
    var candidates = c1_hist_candidates()
    var combined = []
    var index = 0
    while (index < rt_count(hypotheses)):
        rt_push(combined, hypotheses[index])
        index = (index + 1)
    index = 0
    while (index < rt_count(candidates)):
        rt_push(combined, candidates[index])
        index = (index + 1)
    return dv_with(dv_with(dv_with(dv_with(dv_with(policy, "hypotheses", combined), "factor_domains", c1_hist_domains()), "factor_constraints", c1_hist_constraints()), "prune_confidence_limit", 0.85), "abduction", {"active": true, "confidence_cap": 0.85, "basis": dv_single(campaign_source("docs/design-standard.md", 1500, "approved-paid-model-best-explanation-not-certainty"))})

fn c1_hist_expected_answer():
    return dv_all(dv_list3(dv_fact(c1_hist_claim_ref("actual_heard"), "Huo-relay-and-Su-report"), dv_fact(c1_hist_claim_ref("voice_source"), "Tube"), dv_fact(c1_hist_claim_ref("transmission_loss"), "stressed-tail-without-leading-qualification")))

fn c1_hist_claim_ref(field):
    return dv_ref("history_claims", "state", field)

fn c1_hist_author_truth():
    return campaign_state_object("history_claims", {"actual_heard": dv_with(dv_field("Huo-relay-and-Su-report"), "basis", dv_single(campaign_source("docs/design-standard.md", 1509, "original-Q2-author-history"))), "voice_source": dv_with(dv_field("Tube"), "basis", dv_single(campaign_source("docs/design-standard.md", 640, "author-event-1-main-building-copper-source"))), "transmission_loss": dv_with(dv_field("stressed-tail-without-leading-qualification"), "basis", dv_single(campaign_source("docs/design-standard.md", 718, "transmission-table")))})

fn c1_hist_install_mind(mind):
    var result = c1_hist_adopt_shared(c1_hist_setup(mind))
    result = c1_hist_add_source_laws(result)
    result = c1_hist_adopt_routes(result)
    result = c1_hist_add_variant_laws(result)
    return c1_hist_adopt(result, "history.smoke.pantry", c1_hist_smoke_pantry("history"))

fn c1_hist_share_basis():
    return dv_single(campaign_source("docs/design-standard.md", 1500, "approved-estimated-argument-sharing-and-paid-scope-reassessment"))

fn c1_hist_share_action(actor):
    return dv_with(dv_with(dv_with(dv_with(dv_with(dv_with(dv_with(dv_with(campaign_intent_action(rt_cat(actor, ".share.original_q2_complete"), "talk", campaign_at(actor, "hall"), campaign_at(actor, "hall"), "", [], "说明已经核对的重演解释", campaign_source("docs/design-standard.md", 1500, "approved-actual-argument-sharing")), "speech_from_argument", true), "argument_slots", dv_list3("actual_heard", "voice_source", "transmission_loss")), "argument_question", "original_q2_complete"), "topic", "original_q2_complete"), "listeners", ["detective", "huo", "shen", "su"]), "speech", dv_with(c1_speech(dv_true(), "本人形成的历史解释；估计性、置信度与来源由实际论证生成。", "estimated-history-argument"), "channel", "speech")), "reassessment_source_scope", "awake_self"), "reassessment_scope_refs", dv_single(dv_ref("question", "state", "awake_scope")))

fn c1_hist_share_goal(actor):
    return dv_with({"kind": "communicate", "method_id": rt_cat(actor, ".share.original_q2_complete"), "requires_argument": true, "basis": c1_hist_share_basis()}, "available_when", campaign_at(actor, "hall"))

fn c1_hist_proposal_policy(policy):
    return dv_with(dv_with(policy, "proposal_acceptance", dv_with({"enabled": true, "basis": c1_hist_share_basis(), "required_slots": dv_list3("actual_heard", "voice_source", "transmission_loss"), "confidence_threshold": 0.5}, "available_when", dv_true())), "proposal_reassessment", dv_with(dv_with({"enabled": true, "basis": c1_hist_share_basis(), "required_slots": dv_list3("actual_heard", "voice_source", "transmission_loss"), "interpretation_ids": dv_single("short_stay")}, "source_scope", "awake_self"), "target_scope", "body_history"))

fn c1_hist_install_character(actor):
    var result = actor
    var actions = actor.actions
    var new_actions = []
    var index = 0
    while (index < rt_count(actions)):
        rt_push(new_actions, actions[index])
        index = (index + 1)
    rt_push(new_actions, c1_hist_share_action(actor.id))
    result = dv_with(result, "actions", new_actions)
    result = dv_with(result, "policy", c1_hist_proposal_policy(result.policy))
    if (actor.id == "detective"):
        result = dv_with(result, "mind", c1_hist_install_mind(result.mind))
        var policy = c1_hist_policy(result.policy)
        var goals = result.policy.goals
        var new_goals = []
        var goal_index = 0
        while (goal_index < rt_count(goals)):
            rt_push(new_goals, goals[goal_index])
            goal_index = (goal_index + 1)
        rt_push(new_goals, c1_hist_goal())
        rt_push(new_goals, c1_hist_share_goal(actor.id))
        result = dv_with(result, "policy", dv_with(policy, "goals", new_goals))
        result = dv_with(result, "response_models", c1_hist_response_models())
        return result
    else:
        return dv_with(result, "mind", dv_add_object(result.mind, campaign_local_object("history_claims")))

fn c1_hist_goal():
    return {"kind": "know", "question": "original_q2_complete", "ref": c1_hist_claim_ref("actual_heard"), "basis": dv_single(campaign_source("godot_csharp/scenes/Awakening/Script/story/第一章/场面/01_开场.story", 46, "s5_question.004"))}

fn c1_hist_install_scene(scene):
    var actors = scene.actors
    var result = []
    var index = 0
    var formal = scene.formal_answers
    var new_formal = []
    var world = scene.physical
    while (index < rt_count(actors)):
        var actor = actors[index]
        var local_1 = false
        if (actor.id == "demon"):
            local_1 = actor
        else:
            local_1 = c1_hist_install_character(actor)
        rt_push(result, local_1)
        index = (index + 1)
    index = 0
    while (index < rt_count(formal)):
        rt_push(new_formal, formal[index])
        index = (index + 1)
    // Original question remains a modeling source, not a fifth submission stage.
    world = dv_add_object(world, c1_hist_author_truth())
    return dv_with(dv_with(dv_with(scene, "actors", result), "physical", world), "formal_answers", c1_protocol_coordinates(new_formal))

fn c1_protocol_coordinates(rules):
    var result = []
    var i = 0
    while (i < rt_count(rules)):
        let rule = rules[i]
        var stage = c1_answer_topic(rule.id)
        if stage == "auxiliary":
            rt_push(result, rule)
        else:
            let progress_ref = dv_ref("question", "state", rt_cat("level_", stage))
            let completion_ref = dv_ref("question", "state", rt_cat("solved_", stage))
            let receipt_fields = dv_append(dv_append(dv_find(rule, "accepted_public_grants", []), progress_ref), completion_ref)
            rt_push(result, dv_with_many(rule, {"stage": stage, "progress_ref": progress_ref, "completion_ref": completion_ref, "accepted_public_grants": receipt_fields, "accepted_listeners": ["demon", "detective", "huo", "shen", "su"]}))
        i = i + 1
    return result

fn c1_hist_hearing_stages(stages, at, source, words):
    let listeners = ["past.su", "past.huo"]
    let rooms = ["hall", "R08", "foyer", "pantry", "R05", "R06"]
    var i = 0
    while (i < rt_count(listeners)):
        var laws = []
        var j = 0
        while (j < rt_count(rooms)):
            rt_push(laws, c1_hist_acoustic_id(source, words, listeners[i], rooms[j]))
            j = j + 1
        rt_push(stages, {"at": at, "dispatch": {"selector": dv_ref(listeners[i], "state", "location"), "laws": laws}})
        i = i + 1
    return stages


// One world and the same session mechanism for all sixteen residents.
fn c1_campaign_scene():
    var scene = c1_opening_install_scene(c1_hist_install_scene(c1_scenario_native()), "侦探")
    scene = c1_sound_install_scene(scene)
    scene = c1_other_groups_install_scene(scene)
    var physical = dv_add_object(scene.physical, campaign_state_object("campaign.clock", {"minute": dv_field(scene.physical.time)}))
    physical = dv_add_object(physical, campaign_state_object("campaign.access", {"living": dv_field(true), "contract": dv_field(false), "astral": dv_field(false), "logistics": dv_field(false)}))
    var actors = []
    var limit = 0
    var i = 0
    while i < rt_count(scene.actors):
        var actor = scene.actors[i]
        if actor.id == "demon":
            var goals = dv_find(actor.policy, "goals", [])
            let groups = ["contract", "astral", "logistics"]
            var j = 0
            while j < rt_count(groups):
                let action = c1_other_open_action(groups[j], "demon")
                rt_push(goals, {"kind": "communicate", "scope": "personal", "method_id": action.id, "available_when": action.precondition, "requires_argument": false, "basis": [c1_other_case(groups[j]).source]})
                j = j + 1
            actor = dv_with(actor, "policy", dv_with(actor.policy, "goals", goals))
        rt_push(actors, actor)
        limit = limit + actor.policy.budget
        i = i + 1
    return c1_other_environment_install_scene(dv_with_many(c1_active_configuration(scene), {"physical": physical, "actors": actors, "max_actions": limit, "clock_ref": campaign_clock()}))

// These physical processes are separate from the observer's conclusions.
// Neither a process nor a calendar boundary tells a mind
// that release is safe; a real local check and audible report remain necessary.
fn c1_other_environment_install_scene(scene):
    if dv_find(scene, "other_environment_installed", false):
        return scene
    let ventilation_source = campaign_source("docs/design-standard.md", 587, "西夹道残留积气经夜间通风消散；第七条仍须实测后放行")
    let care_source = campaign_source("docs/design-standard.md", 596, "上午高烧、午后退烧；实现午后环境窗为第一日12:00至18:00，须已有真实照护且医患仍在场；非行动费用或答辩预约")
    let air = dv_axiom("other.environment.west-ventilation", 1, dv_all([dv_at_least(campaign_clock(), 1890), c1_other_material("astral", "ventilation_functional", true), c1_other_material("astral", "west_gas", "residual")]), [dv_assign(c1_other_material_ref("astral", "west_gas"), "below-safety-mark")])
    // The source gives a part of the day, not a fixed treatment duration.
    // 720 <= minute < 1080 is this scenario's explicit afternoon window.
    // Existing burns remain; stable means no continuing spread, not healed.
    let afternoon = dv_all([dv_at_least(campaign_clock(), 720), dv_not(dv_at_least(campaign_clock(), 1080))])
    let care_response = dv_axiom("other.environment.care-response", 1, dv_all([afternoon, campaign_case_claim("logistics", "care_given"), c1_other_material("logistics", "care_active", true), campaign_at("mora", c1_other_case("logistics").room), campaign_at("bertrand", c1_other_case("logistics").room), c1_other_material("logistics", "fever", true)]), [dv_assign(c1_other_material_ref("logistics", "fever"), false), dv_assign(c1_other_material_ref("logistics", "wound_stable"), true)])
    var physical = dv_adopt(scene.physical, campaign_method(air.name, air), "enforce", 1, [ventilation_source])
    physical = dv_adopt(physical, campaign_method(care_response.name, care_response), "enforce", 1, [care_source])
    // No knowledge or safe-release flag is granted by either process.
    // Evening and morning examinations must read and report the actual state.
    var processes = dv_clone(dv_find(scene, "world_processes", []))
    rt_push(processes, {"law": air.name, "once": true, "source_refs": [ventilation_source]})
    rt_push(processes, {"law": care_response.name, "once": true, "source_refs": [care_source]})
    return dv_with_many(scene, {"physical": physical, "world_processes": processes, "other_environment_installed": true})

// Native first-chapter content for the three other dormitory groups.
// Personal perception, authority history, fallible hypotheses, literal answer and motive hypotheses
// occupy separate fields. No .story loader, answer grants, forced adoption or fixed route.
// This module does not give these people the living-wing broadcast.
// Prior strengths from old authorship remain provenance, not new personality weights.
// c1_other_group_extend installs content; source catalog data alone never completes an action.

fn c1_other_people():
    let key = ["authored-declaration", "c1_other_people"]
    let cached = rt_memo_get([], key)
    if cached[0]:
        return cached[1]
    return rt_memo_put([], key, c1_other_people_build())

