                mind = dv_adopt(mind, campaign_method(method, law), "predict", 1, [source])
                let recall = dv_with_many(campaign_surface_action(rt_cat(actor.id, rt_cat(".truth.recall.", row.id)), "help", law.premise, law.premise, method, [ref], "回想与材料有关的经过", "他重新看向来问者递出的材料，试着把自己的记忆接起来。", source), {"predict_law": method, "received_speech_requirement": {"speaker": "detective", "action_id": rt_cat("detective.truth.ask.", row.id)}})
                let claim = dv_fact(ref, true)
