// Live island content. All numeric additions below are adjustable game tuning,
// not historical facts, physical measurements or medical/agricultural claims.
#include 36-island-topology.dv
#include 50-chapter2.dv

fn island_parameters():
    return {"basis": "user:2026-10-24-approved-island-game-tuning", "concentration_unit": "normalized-hazard-unit", "capacity_unit": "32px-grid-area", "dose_unit": "existing-erosion-dose", "cases": {"start_minute": 3240, "fallback_drive": 1, "fallback_caution": 0.5, "fallback_trust": 0.5, "value_weight": 1, "experience_weight": 0.05, "erosion_weight": 0.1, "observation_utility": 0.2, "action_utility": 2, "travel_utility": 0.5, "inspection_refresh_minutes": 30, "experimental_opening": 0.5, "units": "minutes-from-opening; normalized-motivation; opening-fraction", "basis": "user:2026-10-25-approved-adjustable-slot-motivation"}, "initial_concentration": 0, "reserve_portions": 672, "conductance_fraction_per_15_minutes": 0.08, "settling_fraction_per_15_minutes": 0.02, "wind_strength": 0.02, "downward_per_height": 0.02, "dose_per_concentration_per_15_minutes": 0.25, "safe_concentration": 0.25, "night_boundary": 0.25, "severe_boundary": 1, "severe_night_boundary": 2, "crop_trays": 4, "crop_growth_ticks": 3, "crop_portions_per_tray": 8, "crop_damage_threshold": 1, "crop_damage_trays_per_tick": 1, "crop_initial_light": true, "heights": {"ground": 0, "first_upper": 5.8, "second_upper": 11.4, "archive": 17, "basement": -4.2, "deep_basement": -8.4, "outdoor_low": -2, "outdoor_high": 2}}

fn island_source():
    return campaign_source("dv_core/modules/55-island.dv", 0, island_parameters().basis)

fn island_ref(object, field):
    return campaign_ref(rt_cat("island.", object), field)

fn island_air_ref(room):
    return island_ref(rt_cat("air.", room), "concentration")

fn island_daylight():
    return dv_all([dv_at_least(island_ref("climate", "minute_of_day"), 360), dv_not(dv_at_least(island_ref("climate", "minute_of_day"), 1080))])

fn island_outdoors(map):
    return dv_has(["campus_n", "campus_ne", "campus_nw", "campus_s", "campus_sw", "harbor"], map)

fn island_height(room):
    let heights = island_parameters().heights
    if room.map == "archive":
        return heights.archive
    if room.map == "counterweight":
        return heights.basement
    if island_outdoors(room.map):
        return heights.outdoor_low
    if dv_has(["living_floor", "zone_jia", "zone_yi", "zone_bing", "zone_ding"], room.map):
        return heights.first_upper
    return heights.ground

fn island_rooms():
    let p = island_parameters()
    let source = island_topology_rooms()
    var rooms = []
    var i = 0
    while i < rt_count(source):
        let room = source[i]
        var declaration = dv_with_many(room, {"concentration_ref": island_air_ref(room.id), "height": island_height(room), "height_basis": "game-tuning-relative-layer-not-global-liquid-level", "volume": room.area_32_cells, "settling": p.settling_fraction_per_15_minutes})
        if island_outdoors(room.map):
            let severe = campaign_any(dv_fact(campaign_ref("c2.weather", "severe_air"), true), dv_fact(campaign_ref("c2.weather", "earthquake_recent"), true))
            declaration = dv_with(declaration, "boundaries", [{"when": dv_true(), "value": 0}, {"when": dv_all([dv_not(island_daylight()), dv_not(dv_fact(campaign_ref("c2.weather", "wind"), true))]), "value": p.night_boundary}, {"when": severe, "value": p.severe_boundary}, {"when": dv_all([dv_not(island_daylight()), severe]), "value": p.severe_night_boundary}])
        rt_push(rooms, declaration)
        i = i + 1
    return rooms

fn island_edges(rooms):
    let p = island_parameters()
    let source = island_topology_edges()
    var edges = []
    var i = 0
    while i < rt_count(source):
        let edge = source[i]
        let a = rooms[dvs_simulation_room_index(rooms, edge.from)]
        let b = rooms[dvs_simulation_room_index(rooms, edge.to)]
        // Wind uses the measured local horizontal axis only inside one map.
        // Different map coordinates have no common north/east reference.
        var wind = 0
        if a.map == b.map:
            if a.center_x < b.center_x:
                wind = p.wind_strength
            if b.center_x < a.center_x:
                wind = 0 - p.wind_strength
        // Exit records describe both directions. Split conductance between
        // reciprocal records, retaining parallel distinct doorways and sources.
        var forward = 0
        var reverse = 0
        if edge.kind == "exit":
            var e = 0
            while e < rt_count(source):
                if source[e].kind == "exit":
                    if source[e].from == edge.from and source[e].to == edge.to:
                        forward = forward + 1
                    if source[e].from == edge.to and source[e].to == edge.from:
                        reverse = reverse + 1
                e = e + 1
        var share = 1
        if 0 < reverse:
            share = dv_max(forward, reverse) / (forward + reverse)
        var declaration = dv_with_many(edge, {"opening": 1, "conductance": p.conductance_fraction_per_15_minutes * dv_min(a.volume, b.volume) * share, "reciprocal_share": share, "wind": wind, "wind_when": dv_fact(campaign_ref("c2.weather", "wind"), true), "downward": p.downward_per_height, "opening_basis": "geometric-open-passage-no-authoritative-switch-declared"})
        // No contract door identifies the total-store bolt. The abstract
        // total-store lock must not seal every geometric granary doorway.
        rt_push(edges, declaration)
        i = i + 1
    return edges

fn island_rule(id, category, when, calculations, effects):
    return {"id": id, "law": id, "category": category, "when": when, "calculations": calculations, "effects": effects, "basis": [island_source()]}

fn island_daily_copy(rule, at):
    return dv_with_many(rule, {"id": rt_cat(rule.id, rt_cat(".", rt_show(at))), "law": rt_cat(rule.law, rt_cat(".", rt_show(at))), "at": at})

fn island_macro_rules(locations, chapter):
    let p = island_parameters()
    var rules = []
    let clock = island_rule("island.climate.clock", "daylight", dv_true(), [{"ref": island_ref("climate", "minute_of_day"), "clock": true, "modulo": 1440}], [])
    rt_push(rules, dv_with(clock, "before_diffusion", true))
    if chapter == 2:
        rt_push(rules, {"id": "c2.weather.first_wind", "law": "c2.weather.first_wind", "category": "weather", "when": c2_first_wind_law().premise, "before_diffusion": true})
        let weather = c2_weather_changes()
        var w = 0
        while w < rt_count(weather):
            let id = rt_cat("c2.weather.", weather[w].id)
            rt_push(rules, {"id": id, "law": id, "category": "weather", "when": c2_weather_change_law(weather[w]).premise, "before_diffusion": true})
            w = w + 1
    let people = campaign_people()
    var i = 0
    while i < rt_count(people):
        let actor = people[i]
        var terms = []
        var positioned = dv_not(dv_true())
        var j = 0
        while j < rt_count(locations):
            let place = locations[j]
            var when = campaign_at(actor, place.location)
            positioned = campaign_any(positioned, when)
            // The authored severe quake/alley burst already adds eight dose
            // units. It is not charged again as a quarter-hour ambient dose.
            if place.location == "outdoor_alley":
                when = dv_all([when, dv_not(dv_all([dv_fact(campaign_ref("c2.weather", "earthquake_recent"), true), dv_fact(campaign_ref("c2.weather", "severe_air"), true)]))])
            rt_push(terms, {"ref": island_air_ref(place.room), "factor": p.dose_per_concentration_per_15_minutes, "when": when})
            j = j + 1
        rt_push(rules, island_rule(rt_cat("island.dose.sample.", actor), "ambient-exposure", dv_all([c2_alive(actor), positioned]), [{"op": "increment", "ref": campaign_own(actor, "island_pending_dose"), "terms": terms, "minimum": 0}], []))
        i = i + 1
    let meter_air = island_air_ref("campus_n:campus_n")
    rt_push(rules, island_rule("island.meter.sample", "source-essence-meter", dv_true(), [{"ref": campaign_ref("c2.meter", "concentration"), "terms": [{"ref": meter_air}]}, {"ref": campaign_ref("c2.meter", "numeric_sample_at"), "clock": true}], []))
    let safe = campaign_any(dv_not(dv_at_least(meter_air, p.safe_concentration)), dv_fact(meter_air, p.safe_concentration))
    rt_push(rules, island_rule("island.meter.numeric-safe", "source-essence-meter", safe, [], [dv_assign(campaign_ref("c2.meter", "numeric_safe"), true)]))
    rt_push(rules, island_rule("island.meter.numeric-unsafe", "source-essence-meter", dv_not(safe), [], [dv_assign(campaign_ref("c2.meter", "numeric_safe"), false)]))
    return rules

fn island_daily_rules(chapter):
    let p = island_parameters()
    let people = campaign_people()
    var consumed = []
    var carried = []
    var hungry = []
    var alive = []
    var masks = []
    var rules = []
    var i = 0
    while i < rt_count(people):
        let actor = people[i]
        rt_push(consumed, {"ref": campaign_own(actor, "consumed")})
        rt_push(carried, {"ref": campaign_own(actor, "rations")})
        rt_push(carried, {"ref": campaign_own(actor, "island_harvest_carried")})
        rt_push(hungry, {"constant": 1, "when": dv_all([c2_alive(actor), dv_fact(campaign_own(actor, "hungry"), true)])})
        rt_push(alive, {"constant": 1, "when": c2_alive(actor)})
        rt_push(masks, {"constant": dv_mask_bit(i), "when": c2_alive(actor)})
        let dose = island_rule(rt_cat("island.dose.settle.", actor), "erosion", c2_alive(actor), [{"op": "increment", "ref": campaign_own(actor, "erosion_exposure"), "terms": [{"ref": campaign_own(actor, "island_pending_dose")}]}, {"ref": campaign_own(actor, "island_pending_dose"), "constant": 0}], [])
        rt_push(rules, island_daily_copy(dose, 360))
        rt_push(rules, island_daily_copy(dose, 1080))
        if chapter == 2:
            let pathology = ["weakness", "impairment"]
            var j = 0
            while j < rt_count(pathology):
                let name = rt_cat("c2.physiology.", rt_cat(actor, rt_cat(".", pathology[j])))
                rt_push(rules, {"id": rt_cat(name, ".360"), "law": name, "category": "pathology", "at": 360})
                rt_push(rules, {"id": rt_cat(name, ".1080"), "law": name, "category": "pathology", "at": 1080})
                j = j + 1
        i = i + 1
    var period = dv_clone(consumed)
    rt_push(period, {"ref": island_ref("ledger", "consumed_total"), "factor": -1})
    var inventory = dv_clone(carried)
    rt_push(inventory, {"ref": campaign_ref("c2.granary", "remaining")})
    rt_push(inventory, {"ref": campaign_ref("c2.counter", "remaining")})
    rt_push(inventory, {"ref": campaign_ref("c2.bowl", "portions")})
    if chapter == 2:
        rt_push(inventory, {"ref": campaign_ref("c2.daily", "portions")})
        rt_push(inventory, {"ref": campaign_own("shen", "meal_ingredients")})
    let ledger = island_rule("island.ledger.settle", "food-accounting", dv_true(), [{"ref": island_ref("ledger", "period_consumed"), "terms": period, "minimum": 0}, {"ref": island_ref("ledger", "consumed_total"), "terms": consumed}, {"ref": island_ref("ledger", "inventory_portions"), "terms": inventory}, {"ref": island_ref("ledger", "hungry_people"), "terms": hungry}, {"ref": island_ref("ledger", "living_people"), "terms": alive}, {"ref": island_ref("ledger", "living_mask"), "terms": masks}, {"ref": island_ref("ledger", "settled_at"), "clock": true}], [])
    rt_push(rules, island_daily_copy(ledger, 360))
    rt_push(rules, island_daily_copy(ledger, 1080))
    let crop_air = island_air_ref("greenhouse:greenhouse")
    let safe_crop_air = campaign_any(dv_not(dv_at_least(crop_air, p.safe_concentration)), dv_fact(crop_air, p.safe_concentration))
    let healthy = dv_all([dv_fact(island_ref("crop", "light"), true), dv_fact(island_ref("crop", "cared"), true), dv_at_least(island_ref("crop", "trays"), 1), safe_crop_air, dv_not(dv_at_least(island_ref("crop", "growth"), p.crop_growth_ticks))])
    let growth = island_rule("island.crop.grow", "crops", healthy, [{"op": "increment", "ref": island_ref("crop", "growth"), "constant": 1}, {"ref": island_ref("crop", "last_growth_at"), "clock": true}], [dv_assign(island_ref("crop", "cared"), false)])
    let damage = island_rule("island.crop.damage", "crops", dv_all([dv_at_least(crop_air, p.crop_damage_threshold), dv_at_least(island_ref("crop", "trays"), 1)]), [{"ref": island_ref("crop", "trays"), "constant": 0 - p.crop_damage_trays_per_tick, "terms": [{"ref": island_ref("crop", "trays")}], "minimum": 0}, {"op": "increment", "ref": island_ref("crop", "damaged_trays"), "constant": p.crop_damage_trays_per_tick}], [dv_assign(island_ref("crop", "cared"), false)])
    rt_push(rules, island_daily_copy(growth, 360))
    rt_push(rules, island_daily_copy(growth, 1080))
    rt_push(rules, island_daily_copy(damage, 360))
    rt_push(rules, island_daily_copy(damage, 1080))
    return rules

fn island_display_object(id, room, title, fields):
    return dv_with_many(c2_object(id, room, dv_with_many(fields, {"name": dv_field(title), "location": dv_field(room)})), {"map_kind": "object", "map_title": title, "visible_fields": ["name", "location"]})

fn island_inspect(actor, id, room, object, fields, label, template, names):
    var grants = []
    var bindings = []
    var i = 0
    while i < rt_count(fields):
        let ref = campaign_ref(object, fields[i])
        rt_push(grants, ref)
        var labels = {}
        if fields[i] == "cared":
            labels = {"true": "本轮已照料", "false": "本轮待照料"}
        if fields[i] == "light":
            labels = {"true": "开启", "false": "关闭"}
        if fields[i] == "hungry":
            labels = {"true": "缺餐", "false": "未缺餐"}
        var binding = c2_visible_binding(names[i], ref, labels)
        if fields[i] == "settled_at":
            binding = dv_with(binding, "format", "game-clock")
        rt_push(bindings, binding)
        i = i + 1
    let when = campaign_at(actor, room)
    var action = dv_with_many(campaign_surface_action(id, "inspect", when, when, "", grants, label, label, island_source()), {"repeatable": true, "required_room": room, "island_content": true, "presentation": {"actor": actor, "voice": "visible-inspection", "lines": [c2_visible_line(dv_true(), template, bindings, island_source())]}})
    if object == "island.crop":
        action = dv_with(action, "interaction", {"kind": "site", "site": "seedbeds"})
    if object == "island.ledger":
        action = dv_with(action, "interaction", {"kind": "site", "site": "ledger"})
    return action

fn island_actions(actor, locations, chapter):
    var actions = []
    var i = 0
    while i < rt_count(locations):
        let place = locations[i]
        let id = rt_cat(actor, rt_cat(".island.air.", place.location))
        let object = rt_cat("island.air.", place.room)
        var reading = island_inspect(actor, id, place.location, object, ["concentration"], "查看此处源质读数", "源质表读数（游戏刻度）：{浓度}。", ["浓度"])
        if place.location == "outdoor_meter":
            reading = dv_with(reading, "grants", dv_append(reading.grants, campaign_clock()))
            let completed_at = c2_visible_line(dv_true(), "本次现场读表完成时刻：{时刻}。", [dv_with(c2_visible_binding("时刻", campaign_clock(), {}), "format", "game-clock")], island_source())
            reading = dv_with(reading, "presentation", dv_with(reading.presentation, "lines", dv_append(reading.presentation.lines, completed_at)))
        rt_push(actions, reading)
        i = i + 1
    if chapter == 2:
        rt_push(actions, island_inspect(actor, rt_cat(actor, ".island.ledger"), "main_granary", "island.ledger", ["settled_at", "period_consumed", "consumed_total", "inventory_portions", "hungry_people", "living_people"], "查看半日日账", "日账结于{时刻}。本期吃掉{本期}份，累计{累计}份。账面仓柜、随身和送餐余粮合计{余量}份；存活{人数}人，其中缺餐{缺餐}人。", ["时刻", "本期", "累计", "余量", "缺餐", "人数"]))
        rt_push(actions, island_inspect(actor, rt_cat(actor, ".island.crop.inspect"), "greenhouse", "island.crop", ["trays", "growth", "cared", "light", "damaged_trays"], "检视温室苗床", "苗床{批}批，生长进度{进度}/3。{照料}；照明{光照}，累计已损{损伤}批。", ["批", "进度", "照料", "光照", "损伤"]))
        rt_push(actions, island_inspect(actor, rt_cat(actor, ".island.self"), "living_hall", campaign_body(actor), ["erosion_exposure", "island_pending_dose", "rations", "consumed", "hungry", "island_harvest_carried"], "查看本人暴露记录与口粮", "已记暴露{剂量}，本期累积{待结}。随身口粮{携带}份，已食{已食}份，当前{缺餐}。收成{收成}份，尚未入库。", ["剂量", "待结", "携带", "已食", "缺餐", "收成"]))
        let jobs = island_crop_jobs(actor)
        i = 0
        while i < rt_count(jobs):
            rt_push(actions, jobs[i].action)
            i = i + 1
    return actions

fn island_crop_jobs(actor):
    let p = island_parameters()
    var jobs = []
    let care_id = rt_cat(actor, ".island.crop.care")
    let care_when = dv_all([campaign_at(actor, "greenhouse"), c2_alive(actor), dv_at_least(island_ref("crop", "trays"), 1), dv_fact(island_ref("crop", "cared"), false)])
    let care_law = dv_axiom(care_id, 1, care_when, [dv_assign(island_ref("crop", "cared"), true)])
    let care = dv_with_many(campaign_surface_action(care_id, "help", care_when, care_when, care_id, [island_ref("crop", "cared")], "照料温室苗床", "检查苗床并完成这一生长节拍所需的照料。", island_source()), {"repeatable": true, "island_content": true, "predict_law": care_id, "simulation_utility": 1, "interaction": {"kind": "site", "site": "seedbeds"}})
    rt_push(jobs, {"law": care_law, "action": care})
    let light_states = [true, false]
    var l = 0
    while l < rt_count(light_states):
        let light = light_states[l]
        let id = rt_cat(actor, rt_cat(".island.crop.light.", rt_show(light)))
        let when = dv_all([campaign_at(actor, "greenhouse"), c2_alive(actor), dv_fact(island_ref("crop", "light"), not light)])
        let law = dv_axiom(id, 1, when, [dv_assign(island_ref("crop", "light"), light)])
        var label = "关闭苗床照明"
        if light:
            label = "开启苗床照明"
        let action = dv_with_many(campaign_surface_action(id, "experiment", when, when, id, [island_ref("crop", "light")], label, label, island_source()), {"repeatable": true, "island_content": true, "predict_law": id, "interaction": {"kind": "site", "site": "seedbeds"}})
        rt_push(jobs, {"law": law, "action": action})
        l = l + 1
    let harvest_id = rt_cat(actor, ".island.crop.harvest")
    let harvest_when = dv_all([campaign_at(actor, "greenhouse"), c2_alive(actor), dv_at_least(island_ref("crop", "trays"), 1), dv_at_least(island_ref("crop", "growth"), p.crop_growth_ticks)])
    let harvest_law = dv_axiom(harvest_id, 1, harvest_when, [dv_increment(island_ref("crop", "trays"), -1), dv_increment(campaign_own(actor, "island_harvest_carried"), p.crop_portions_per_tray)])
    let harvest = dv_with_many(campaign_surface_action(harvest_id, "help", harvest_when, harvest_when, harvest_id, [island_ref("crop", "trays"), campaign_own(actor, "island_harvest_carried")], "收获一批成熟作物", "收获一批成熟作物，分装八标准份，随身携往粮仓。", island_source()), {"repeatable": true, "island_content": true, "predict_law": harvest_id, "simulation_utility": 1, "interaction": {"kind": "site", "site": "seedbeds"}})
    rt_push(jobs, {"law": harvest_law, "action": harvest})
    let store_id = rt_cat(actor, ".island.crop.store")
    let store_when = dv_all([campaign_at(actor, "main_granary"), c2_alive(actor), dv_fact(campaign_ref("c2.granary", "total_store_locked"), false), dv_at_least(campaign_own(actor, "island_harvest_carried"), p.crop_portions_per_tray)])
    let store_law = dv_axiom(store_id, 1, store_when, [dv_increment(campaign_own(actor, "island_harvest_carried"), 0 - p.crop_portions_per_tray), dv_increment(campaign_ref("c2.granary", "remaining"), p.crop_portions_per_tray), dv_increment(island_ref("crop", "stored_portions"), p.crop_portions_per_tray)])
    let store = dv_with_many(campaign_surface_action(store_id, "help", store_when, store_when, store_id, [campaign_own(actor, "island_harvest_carried"), campaign_ref("c2.granary", "remaining"), island_ref("crop", "stored_portions")], "将收成送入已开启粮仓", "将随身八份收成送入粮仓并记账。", island_source()), {"repeatable": true, "island_content": true, "predict_law": store_id, "simulation_utility": 1})
    rt_push(jobs, {"law": store_law, "action": store})
    let supply_id = rt_cat(actor, ".island.supply")
    let supply_when = dv_all([campaign_at(actor, "main_granary"), c2_alive(actor), dv_fact(campaign_ref("c2.granary", "total_store_locked"), false), dv_at_least(campaign_ref("c2.granary", "remaining"), p.crop_portions_per_tray)])
    let supply_law = dv_axiom(supply_id, 1, supply_when, [dv_increment(campaign_ref("c2.granary", "remaining"), 0 - p.crop_portions_per_tray), dv_increment(campaign_ref("c2.counter", "remaining"), p.crop_portions_per_tray), dv_increment(campaign_ref("c2.ledger", "reserve_received"), p.crop_portions_per_tray)])
    let supply = dv_with_many(campaign_surface_action(supply_id, "help", supply_when, supply_when, supply_id, [campaign_ref("c2.granary", "remaining"), campaign_ref("c2.counter", "remaining")], "转运八份存粮至配给台", "从已开粮仓转运八份存粮至配给台，仓柜分别登记同一笔转账。", island_source()), {"repeatable": true, "island_content": true, "predict_law": supply_id})
    rt_push(jobs, {"law": supply_law, "action": supply})
    return jobs

fn island_install(scene, locations):
    let chapter = dv_find(scene, "chapter", 1)
    if dv_find(scene, "island_installed_chapter", 0) == chapter:
        return scene
    let p = island_parameters()
    let rooms = island_rooms()
    var physical = c2_world_objects(scene.physical)
    physical = campaign_add_new(physical, campaign_state_object("island.climate", {"minute_of_day": dv_field(physical.time - rt_floor(physical.time / 1440) * 1440)}))
    if not dv_uncontested(dv_read(physical, campaign_ref("c2.granary", "remaining"))):
        physical = dv_store(physical, campaign_ref("c2.granary", "remaining"), dv_with(dv_field(p.reserve_portions), "basis", [island_source()]))
    if not dv_uncontested(dv_read(physical, campaign_ref("c2.weather", "wind"))):
        physical = dv_store(physical, campaign_ref("c2.weather", "wind"), dv_with(dv_field(false), "basis", [island_source()]))
    let meter_fields = {"concentration": dv_unknown(), "numeric_sample_at": dv_unknown(), "numeric_safe": dv_field(false)}
    var mf = 0
    while mf < rt_count(meter_fields):
        let ref = campaign_ref("c2.meter", meter_fields[mf][0])
        if not dv_uncontested(dv_read(physical, ref)):
            physical = dv_store(physical, ref, meter_fields[mf][1])
        mf = mf + 1
    var i = 0
    while i < rt_count(rooms):
        let room = rooms[i]
        physical = campaign_add_new(physical, campaign_state_object(rt_cat("island.air.", room.id), {"concentration": dv_with(dv_field(p.initial_concentration), "basis", [island_source()])}))
        i = i + 1
    physical = campaign_add_new(physical, island_display_object("island.ledger", "main_granary", "半日日账", {"settled_at": dv_unknown(), "period_consumed": dv_field(0), "consumed_total": dv_field(0), "inventory_portions": dv_unknown(), "hungry_people": dv_unknown(), "living_people": dv_unknown(), "living_mask": dv_unknown()}))
    physical = campaign_add_new(physical, island_display_object("island.crop", "greenhouse", "温室苗床", {"trays": dv_field(p.crop_trays), "growth": dv_field(0), "cared": dv_field(false), "light": dv_field(p.crop_initial_light), "damaged_trays": dv_field(0), "last_growth_at": dv_unknown(), "stored_portions": dv_field(0)}))
    let people = campaign_people()
    i = 0
    while i < rt_count(people):
        let fields = ["island_pending_dose", "island_harvest_carried"]
        var f = 0
        while f < rt_count(fields):
            let ref = campaign_own(people[i], fields[f])
            if not dv_uncontested(dv_read(physical, ref)):
                physical = dv_store(physical, ref, dv_field(0))
            f = f + 1
        i = i + 1
    var actors = []
    var bindings = scene.bindings
    i = 0
    while i < rt_count(scene.actors):
        var actor = scene.actors[i]
        if dv_has(people, actor.id):
            var mind = actor.mind
            let objects = ["island.ledger", "island.crop", campaign_body(actor.id), "c2.granary", "c2.counter"]
            var j = 0
            while j < rt_count(objects):
                if not dv_has_key(mind.objects, objects[j]):
                    mind = dv_add_object(mind, campaign_local_object(objects[j]))
                if dv_local(bindings, objects[j], actor.id) == "":
                    bindings = dv_append(bindings, dv_binding(objects[j], objects[j], actor.id))
                j = j + 1
            j = 0
            while j < rt_count(locations):
                let object = rt_cat("island.air.", locations[j].room)
                if not dv_has_key(mind.objects, object):
                    mind = dv_add_object(mind, campaign_local_object(object))
                if dv_local(bindings, object, actor.id) == "":
                    bindings = dv_append(bindings, dv_binding(object, object, actor.id))
                j = j + 1
            var actions = [for action in actor.actions if not dv_find(action, "island_content", false): action]
            let additions = island_actions(actor.id, locations, chapter)
            j = 0
            while j < rt_count(additions):
                rt_push(actions, additions[j])
                j = j + 1
            if chapter == 2:
                let jobs = island_crop_jobs(actor.id)
                j = 0
                while j < rt_count(jobs):
                    let law = jobs[j].law
                    if not dv_has_key(physical.adoptions, law.name):
                        physical = dv_adopt(physical, law, "enforce", 1, [island_source()])
                    if not dv_has_key(mind.adoptions, law.name):
                        mind = dv_adopt(mind, law, "predict", 1, [island_source()])
                    j = j + 1
            actor = dv_with_many(actor, {"mind": mind, "actions": actions})
        rt_push(actors, actor)
        i = i + 1
    let declarations = dv_with_many(dv_find(scene, "simulation_declarations", []), {"rooms": rooms, "edges": island_edges(rooms), "locations": locations, "macro_rules": island_macro_rules(locations, chapter), "daily_rules": island_daily_rules(chapter), "island_parameters": p})
    return dv_with_many(scene, {"physical": physical, "actors": actors, "bindings": bindings, "simulation_declarations": declarations, "island_installed_chapter": chapter})
