  {
    "name": "music_pipeline",
    "description": "Render music, effects and voices; write or export MuseScore sources; audit score assets. render is the default. Use arguments [\"--only\", \"<cue/effect/voice ID>\"] to select one item. audit requires --out.",
    "routes": {
      "render": {
        "kind": "python",
        "path": "music_pipeline/build_soundtrack.py",
        "timeout": 3600
      },
      "scores": {
        "kind": "python",
        "path": "music_pipeline/build_soundtrack.py",
        "arguments": [
          "--scores"
        ],
        "timeout": 3600
      },
      "rewrite-scores": {
        "kind": "python",
        "path": "music_pipeline/build_soundtrack.py",
        "arguments": [
          "--scores",
          "--rewrite-scores"
        ],
        "timeout": 3600
      },
      "from-mscz": {
        "kind": "python",
        "path": "music_pipeline/build_soundtrack.py",
        "arguments": [
          "--from-mscz"
        ],
        "timeout": 3600
      },
      "export": {
        "kind": "python",
        "path": "music_pipeline/build_soundtrack.py",
        "arguments": [
          "--export",
          "--scores"
        ],
        "timeout": 3600
      },
      "audit": {
        "kind": "python",
        "path": "music_pipeline/audit_score_assets.py"
      }
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string"
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "openWorldHint": false
    },
    "selector": "operation",
    "default": "render"
  },
