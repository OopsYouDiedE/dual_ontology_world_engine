    "name": "editor_tools",
    "description": "Use the common compiler checker/LSP diagnostic publisher or prepare/package editor clients. check takes CLI arguments and optional stdin; lsp-diagnostics takes {path, text?, version?}; client operations take CLI argument arrays. lsp-config returns stdio launch settings.",
    "routes": {
      "check": {
        "kind": "python",
        "path": "editor_lsp/check_dv.py"
      },
      "lsp-diagnostics": {
        "kind": "function",
        "module": "editor_lsp/mcp_actions.py",
        "function": "lsp_diagnostics"
      },
      "lsp-config": {
        "kind": "function",
        "module": "editor_lsp/mcp_actions.py",
        "function": "lsp_config"
      },
      "vscode-prepare": {
        "kind": "command",
        "command": [
          "node",
          "prepare.js"
        ],
        "cwd": "mcp/editor_lsp/clients/vscode"
      },
      "vscode-dependencies": {
        "kind": "command",
        "command": [
          "npm",
          "ci"
        ],
        "cwd": "mcp/editor_lsp/clients/vscode"
      },
      "vscode-package": {
        "kind": "command",
        "command": [
          "npm",
          "run",
          "package"
        ],
        "cwd": "mcp/editor_lsp/clients/vscode"
      },
      "visualstudio-build": {
