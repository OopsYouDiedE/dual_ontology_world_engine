  {
    "name": "build_tools",
    "description": "Run an explicitly selected compiler/session or .NET build. session takes build_session.py options including required --out. Build operations do not run game sessions.",
    "routes": {
      "session": {
        "kind": "python",
        "path": "build/build_session.py"
      },
      "language": {
        "kind": "command",
        "command": [
          "dotnet",
          "build",
          "dv_core/LanguageCore.sln",
          "--disable-build-servers",
          "-p:NuGetAudit=false"
        ]
      },
      "host": {
        "kind": "command",
        "command": [
          "dotnet",
          "build",
          "godot_csharp/DualOntologyWorldEngine.sln",
          "--disable-build-servers",
          "-p:NuGetAudit=false"
        ]
      },
      "cli": {
        "kind": "command",
        "command": [
          "dotnet",
          "build",
          "dv_core/cli/DvCli.csproj",
          "--disable-build-servers",
          "-p:NuGetAudit=false"
        ]
      }
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string"
        },
        "arguments": {
          "type": "array",
