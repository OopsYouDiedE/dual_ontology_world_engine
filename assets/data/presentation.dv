narrative highlights {
  actor_bindings = { scholar = "archaeologist"; chess_player = "chessplayer"; };
  "schema" = 1;
  "mode" = "staged-excerpts";
  "text_status" = "newly-authored-staged-excerpts-not-verbatim-design";
  "stages" = [{
      "id" = "shura_poet";
      "title" = "疯骑士的宣言";
      "condition" = "修罗线节选：卢西安已识破侦探的杀局，雀儿尚在场；本段不预置任何人的死亡。";
      "location" = "悬廊·护送伤员的通路";
      "lines" = [{
          "speaker" = "旁白";
          "text" = "卢西安把斗篷裹在雀儿肩上。剑横在侦探与她之间。";
          "actor" = "poet";
          "cue" = "approach";
        }, {
          "speaker" = "卢西安";
          "text" = "那就当我是疯子。";
          "actor" = "poet";
          "cue" = "gesture";
        }, {
          "speaker" = "卢西安";
          "text" = "堂吉诃德，我读过。";
          "actor" = "poet";
        }, {
          "speaker" = "卢西安";
          "text" = "风车我认得。";
          "actor" = "poet";
        }, {
          "speaker" = "卢西安";
          "text" = "你，我也认得。";
          "actor" = "poet";
          "cue" = "gesture";
        }, {
          "speaker" = "卢西安";
          "text" = "雀儿，走。身后的人，我来护。";
          "actor" = "poet";
        }, {
          "speaker" = "旁白";
          "text" = "他站到桥口。剑仍在抖，脚没有退。";
          "actor" = "poet";
          "cue" = "approach";
        }];
    }, {
      "id" = "scholar_relic";
      "title" = "人在，史在";
      "condition" = "第六章条件节选：当前封印方案拟炸毁三千年海民黑曜石母碑；并非所有封印方案都必须毁碑。";
      "location" = "火山底·黑曜石母碑前";
      "lines" = [{
          "speaker" = "旁白";
          "text" = "顾平章，五十九岁，宝蓝儒衫。他挡在三千年黑曜石母碑前。";
          "actor" = "scholar";
          "cue" = "approach";
        }, {
          "speaker" = "顾平章";
          "text" = "碑上的字，还在。";
          "actor" = "scholar";
        }, {
          "speaker" = "顾平章";
          "text" = "人名、年岁，都在。";
          "actor" = "scholar";
          "cue" = "cane_draw";
        }, {
          "speaker" = "顾平章";
          "text" = "引线，放下。";
          "actor" = "scholar";
          "cue" = "cane_raise";
        }, {
          "speaker" = "顾平章";
          "text" = "真要炸？";
          "actor" = "scholar";
          "cue" = "cane_strike";
        }, {
          "speaker" = "顾平章";
          "text" = "那就连老夫一起。";
          "actor" = "scholar";
          "cue" = "cane_stop";
        }, {
          "speaker" = "旁白";
          "text" = "御赐拐杖落地。他伸出左手，挡在母碑前。引线还未点燃。";
          "actor" = "scholar";
        }];
    }, {
      "id" = "chess_god";
      "title" = "与神明对弈";
      "condition" = "正常线节选：阮清月与代管者实体同席，实际在十九路棋盘落子；本段不裁定整盘胜负。";
      "location" = "礼乐迎宾馆·临窗棋席";
      "lines" = [{
          "speaker" = "旁白";
          "text" = "代管者摆正十九路棋盘，坐到阮清月对面。";
          "actor" = "demon";
        }, {
          "speaker" = "阮清月";
          "text" = "别拿人代子。";
          "actor" = "chess_player";
          "cue" = "gesture";
        }, {
          "speaker" = "旁白";
          "text" = "阮清月执黑，落右上星位。";
          "actor" = "chess_player";
          "cue" = "black_move";
        }, {
          "speaker" = "代管者";
          "text" = "容我应一手。";
          "actor" = "demon";
        }, {
          "speaker" = "旁白";
          "text" = "代管者执白，落左下星位。";
          "actor" = "demon";
          "cue" = "white_move";
        }, {
          "speaker" = "阮清月";
          "text" = "这手，轮我。";
          "actor" = "chess_player";
        }, {
          "speaker" = "旁白";
          "text" = "她将黑子落在左上星位。";
          "actor" = "chess_player";
          "cue" = "black_move";
        }, {
          "speaker" = "旁白";
          "text" = "代管者在右下星位落白。棋局未终。";
          "actor" = "demon";
          "cue" = "white_move";
        }];
    }, {
      "id" = "demon_miracle";
      "title" = "最后的馈赠";
      "condition" = "正常线完美结局的条件节选：封印已获成立，代管者沉睡前把岛上残余毒雾结晶为无害星尘。此段不是黄金迷梦提案，也不产生粮食或药物。";
      "location" = "四锚闭合后的祭坛";
      "lines" = [{
          "speaker" = "旁白";
          "text" = "四锚已经闭合。代管者放下空茶杯。";
          "actor" = "demon";
          "cue" = "approach";
        }, {
          "speaker" = "代管者";
          "text" = "容我收个尾。";
          "actor" = "demon";
        }, {
          "speaker" = "旁白";
          "text" = "它抬手。岛上残余毒雾化作无害星尘。";
          "actor" = "demon";
          "cue" = "miracle";
        }, {
          "speaker" = "代管者";
          "text" = "诸位，请看窗外。";
          "actor" = "demon";
        }, {
          "speaker" = "旁白";
          "text" = "风穿过祭坛。石阶露了出来。";
          "actor" = "demon";
          "cue" = "miracle";
        }, {
          "speaker" = "旁白";
          "text" = "星尘落在杯沿。代管者合眼沉睡。";
          "actor" = "demon";
        }];
    }, {
      "id" = "kitchen_dumplings";
      "title" = "先吃一口热饭";
      "condition" = "第一章第2日下午破冰节选：沈鼎在主楼1F厨房用现有白面、猪肉和白菜包饺子，苏泠与雀儿在场；代管者仅闻到蒸汽，不能吞咽。";
      "location" = "主楼1F·总后厨与大食堂";
      "lines" = [{
          "speaker" = "沈鼎";
          "text" = "袖子挽上。先洗手。";
          "actor" = "chef";
          "cue" = "gesture";
        }, {
          "speaker" = "旁白";
          "text" = "白面团和猪肉白菜馅摆上桌。雀儿托皮，苏泠捏边。";
          "actor" = "musician";
          "cue" = "dumpling";
        }, {
          "speaker" = "苏泠";
          "text" = "我这个……歪了。";
          "actor" = "musician";
        }, {
          "speaker" = "沈鼎";
          "text" = "露馅也能吃。放这儿。";
          "actor" = "chef";
          "cue" = "dumpling";
        }, {
          "speaker" = "旁白";
          "text" = "代管者在窗外闻香。它不能吞咽。";
          "actor" = "demon";
          "cue" = "steam";
        }, {
          "speaker" = "沈鼎";
          "text" = "出锅了。别挤，挨个来。";
          "actor" = "chef";
          "cue" = "steam";
        }];
    }, {
      "id" = "last_transfer";
      "title" = "抢运窗口的最后一刻";
      "condition" = "第19日退潮窗口末刻节选：主楼1F仍在向高处抢运现有粮食与苗床，源质重新上涨、逼近一楼；绝对液面、影响范围以及本轮实际交接和撤人结果待现场记录确认。";
      "location" = "主楼1F·粮仓、服务梯与高处接收台";
      "lines" = [{
          "speaker" = "旁白";
          "text" = "一架苗床卡在粮仓门口。源质又向一楼逼近。";
          "actor" = "detective";
          "cue" = "tide";
        }, {
          "speaker" = "沈鼎";
          "text" = "这袋，往上送！";
          "actor" = "chef";
          "cue" = "transfer";
        }, {
          "speaker" = "旁白";
          "text" = "棘轮咬住。楼下人握紧吊绳。";
          "actor" = "detective";
          "cue" = "transfer";
        }, {
          "speaker" = "沈鼎";
          "text" = "别挤。源质近了就撤！";
          "actor" = "chef";
          "cue" = "tide";
        }, {
          "speaker" = "旁白";
          "text" = "苗床升上服务梯。门侧的人朝楼梯跑去。";
          "actor" = "detective";
          "cue" = "transfer";
        }, {
          "speaker" = "旁白";
          "text" = "绳索仍在摇。沈鼎等高处回话。";
          "actor" = "detective";
          "cue" = "tide";
        }];
    }];
};

