schema "dv-script-v1";

// Actor-owned rules, Sim4 daily autonomy vs. Ruan Qingyue's timed self-play Gambit selection,
// AI Detective's multi-strategy selection (fabricate diversion, lock gate with Qu'er & Huo, normal night watch),
// and other characters' cognition-dependent evaluations of the Detective's actions.
data case_theory {
  script = "scope lucian { axiom poetic_urge : feels_group_anxiety(day1_afternoon); axiom board_free : unwatched_lecture_board(day1_afternoon); axiom stunt : feels_group_anxiety(?t) -> unwatched_lecture_board(?t) -> plan_blackboard_prophecy(?t); query write_poem : plan_blackboard_prophecy(day1_afternoon); } scope detective_ch1 { axiom ambush_rule : observed_blue_chalk_on_lucian(?t) -> can_ambush_poet_at_board(?t); axiom debunk_rule : observed_blackboard_poem(?t) -> observed_demon_rhythm_critique(?t) -> can_speed_debunk_poem(?t); axiom converge_ambush : can_ambush_poet_at_board(?t) -> poet_stunt_resolved(?t); axiom converge_debunk : can_speed_debunk_poem(?t) -> poet_stunt_resolved(?t); axiom dumpling_ready : poet_stunt_resolved(?t) -> day1_dumpling_feast_ready(?t); query ambush : can_ambush_poet_at_board(day1_afternoon); query debunk : can_speed_debunk_poem(day1_afternoon); query feast : day1_dumpling_feast_ready(day1_afternoon); } scope ruan { axiom decoy_lucian : available_decoy(lucian,night_ration_slip); axiom conflict_ward_quer : available_conflict_pair(ward,quer,return_home_vote); axiom decoy_moran : available_decoy(moran,window_sketch); axiom conflict_ward_veronica : available_conflict_pair(ward,veronica,medicine_folio); axiom decoy_huo : available_decoy(huo,b1_pipe_check); axiom conflict_bertrand_lucian : available_conflict_pair(bertrand,lucian,ration_ledger); axiom build_gambit1 : self_play_started(ruan,day2) -> available_decoy(lucian,night_ration_slip) -> available_conflict_pair(ward,quer,return_home_vote) -> gambit_ready(fourteen_votes_probes); axiom build_gambit2 : self_play_started(ruan,day2) -> available_decoy(moran,window_sketch) -> available_conflict_pair(ward,veronica,medicine_folio) -> gambit_ready(sealed_folio_key); axiom build_gambit3 : self_play_started(ruan,day2) -> available_decoy(huo,b1_pipe_check) -> available_conflict_pair(bertrand,lucian,ration_ledger) -> gambit_ready(two_signatures_ration); query g1 : gambit_ready(fourteen_votes_probes); query g2 : gambit_ready(sealed_folio_key); query g3 : gambit_ready(two_signatures_ration); } scope detective { axiom diversion_plan : knows_night4_gate_hazard(?d) -> can_stage_fake_inquiry(?d) -> strategy_admissible(fabricate_diversion); axiom engineering_plan : knows_night4_gate_hazard(?d) -> allied_with_quer_and_huo(?d) -> strategy_admissible(lock_gate_with_quer_huo); axiom watch_plan : knows_night4_gate_hazard(?d) -> has_watch_supplies(?d) -> strategy_admissible(normal_night_watch); query s_diversion : strategy_admissible(fabricate_diversion); query s_lock : strategy_admissible(lock_gate_with_quer_huo); query s_watch : strategy_admissible(normal_night_watch); } scope ward_eval { axiom rule_law : values_procedural_truth(ward); axiom judge_deception : values_procedural_truth(ward) -> knows_fabricated_diversion(ward,detective) -> evaluates(ward,detective,procedural_perjury_condemned); axiom judge_diligence : values_procedural_truth(ward) -> observes_indoor_audit_only(ward,detective) -> evaluates(ward,detective,diligent_order_keeper); query condemned : evaluates(ward,detective,procedural_perjury_condemned); query praised : evaluates(ward,detective,diligent_order_keeper); } scope ruan_eval { axiom rule_go : values_minimum_cost_tesuji(ruan); axiom judge_diversion : values_minimum_cost_tesuji(ruan) -> knows_fabricated_diversion(ruan,detective) -> evaluates(ruan,detective,brilliant_tesuji_worthy_rival); axiom judge_watch : values_minimum_cost_tesuji(ruan) -> observes_normal_night_watch(ruan,detective) -> evaluates(ruan,detective,honest_but_heavy_clumsy_shape); query rival : evaluates(ruan,detective,brilliant_tesuji_worthy_rival); query clumsy : evaluates(ruan,detective,honest_but_heavy_clumsy_shape); } scope mora_eval { axiom rule_clinic : values_patient_survival_first(mora); axiom judge_mercy : values_patient_survival_first(mora) -> knows_fabricated_diversion(mora,detective) -> zero_casualty_achieved(night4) -> evaluates(mora,detective,merciful_white_lie_approved); query approved : evaluates(mora,detective,merciful_white_lie_approved); } scope quer_eval { axiom rule_street : values_genuine_respect(quer); axiom judge_partner : values_genuine_respect(quer) -> invited_to_lock_gate_together(quer,detective,huo) -> evaluates(quer,detective,trusted_craft_partner); query partner : evaluates(quer,detective,trusted_craft_partner); } scope bertrand_eval { axiom rule_comrade : values_shared_hardship(bertrand); axiom judge_watch : values_shared_hardship(bertrand) -> shared_normal_night_watch(bertrand,detective) -> evaluates(bertrand,detective,honorable_trench_comrade); query comrade : evaluates(bertrand,detective,honorable_trench_comrade); } scope ch2_night4_casualty { axiom moran_knows : knows_specific_lethal_prima(moran,night4); axiom moran_obsessed : obsessed_with_vortex_color(moran,night4); axiom bertrand_knows : knows_specific_lethal_prima(bertrand,night4); axiom bertrand_rescues : enters_to_rescue(bertrand,moran,night4); axiom no_chelator : lacks_prepared_chelator(veronica,night4); axiom clause7_bypass : knows_specific_lethal_prima(?p,night4) -> no_clause7_demon_block(?p,night4); axiom double_casualty : no_clause7_demon_block(moran,night4) -> obsessed_with_vortex_color(moran,night4) -> no_clause7_demon_block(bertrand,night4) -> enters_to_rescue(bertrand,moran,night4) -> lacks_prepared_chelator(veronica,night4) -> night4_double_casualty(moran,bertrand); query moran_unprotected : no_clause7_demon_block(moran,night4); query casualty : night4_double_casualty(moran,bertrand); } scope elena { axiom autonomy : values_informed_choice(elena); axiom hearing : values_informed_choice(?a) -> wearing_earmuffs(?a) -> restore_hearing_due(?a); query restore : restore_hearing_due(elena); } scope demon { axiom duty : accepts_protective_duty(demon); axiom rescue : accepts_protective_duty(?a) -> holding_protective_valve(?a) -> victim_at_valve(elena) -> evacuate_due(?a,elena); axiom verify : accepts_protective_duty(?a) -> holding_protective_valve(?a) -> verify_release_due(?a); query evacuation : evacuate_due(demon,elena); query recheck : verify_release_due(demon); query overnight : forced_overnight_guard(demon); }";
  audit = [
    {scope="lucian";theorems={write_poem="proved";};},
    {scope="detective_ch1";theorems={ambush="unknown";debunk="unknown";feast="unknown";};},
    {scope="ruan";theorems={g1="unknown";g2="unknown";g3="unknown";};},
    {scope="detective";theorems={s_diversion="unknown";s_lock="unknown";s_watch="unknown";};},
    {scope="ward_eval";theorems={condemned="unknown";praised="unknown";};},
    {scope="ruan_eval";theorems={rival="unknown";clumsy="unknown";};},
    {scope="mora_eval";theorems={approved="unknown";};},
    {scope="quer_eval";theorems={partner="unknown";};},
    {scope="bertrand_eval";theorems={comrade="unknown";};},
    {scope="ch2_night4_casualty";theorems={moran_unprotected="proved";casualty="proved";};},
    {scope="elena";theorems={restore="unknown";};},
    {scope="demon";theorems={evacuation="unknown";recheck="unknown";overnight="unknown";};}
  ];
};

