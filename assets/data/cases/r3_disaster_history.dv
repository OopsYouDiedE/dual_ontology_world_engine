  channel 2F-cross-M_传声_R06 : 2F-cross-M -> R06 { minimum_delay := 3 };
  channel 2F-cross-M_传声_R07 : 2F-cross-M -> R07 { minimum_delay := 3 };
  channel 2F-cross-M_传声_R08 : 2F-cross-M -> R08 { minimum_delay := 3 };
  channel 2F-cross-M_传声_R09 : 2F-cross-M -> R09 { minimum_delay := 3 };
  channel 2F-cross-M_传声_R10 : 2F-cross-M -> R10 { minimum_delay := 3 };
  channel 2F-cross-M_传声_R11 : 2F-cross-M -> R11 { minimum_delay := 3 };
  channel 2F-cross-M_传声_R12 : 2F-cross-M -> R12 { minimum_delay := 3 };
  channel 2F-cross-M_传声_R13 : 2F-cross-M -> R13 { minimum_delay := 3 };
  channel 2F-cross-M_传声_R14 : 2F-cross-M -> R14 { minimum_delay := 3 };
