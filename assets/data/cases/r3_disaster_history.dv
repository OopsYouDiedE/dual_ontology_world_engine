  def 误信反相压差计用撬棍内撬大门 : Operation := { kind := work, capability := manual, minimum_seconds := 20, intent := respond, requires_propositions := [external_prima_dangerous], actual_need_effects := { energy := -0.3, safety := 5, duty := 4, $goal := 5 }, requires := [d_gauge_inverted], uses := [crowbar], adds := [d_gate_checked, trace_crowbar_inner_frame] };
  def 打入结构钢楔钉死丁区门缝 : Operation := { kind := work, capability := manual, minimum_seconds := 20, intent := respond, requires_propositions := [external_prima_dangerous], actual_need_effects := { energy := -0.3, safety := 5, duty := 5, $goal := 5 }, requires := [trace_crowbar_inner_frame], uses := [steel_wedge], adds := [d_frame_inspected, d_steel_wedged_shut] };
  def 泼洒螯合强酸封缝并逼退撬门者 : Operation := { kind := work, capability := manual, minimum_seconds := 20, intent := respond, requires_propositions := [external_prima_dangerous], actual_need_effects := { energy := -0.3, safety := 3, duty := 4, $goal := 5 }, requires := [d_steel_wedged_shut], uses := [acid], adds := [r13_secured, trace_acid_scorched_mat, bertrand_acid_burn] };
