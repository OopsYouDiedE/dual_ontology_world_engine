  edge R04_到_R03 : R04 -> R03 := 22 { capability := walk };
  edge R03_到_R04 : R03 -> R04 := 22 { capability := walk };
  edge R08_到_B-gate-inner : R08 -> B-gate-inner := 40 { capability := walk };
  edge B-gate-inner_到_R08 : B-gate-inner -> R08 := 40 { capability := walk };
  edge R06_到_B-P : R06 -> B-P := 20 { capability := walk };
  edge B-P_到_B-gate-inner : B-P -> B-gate-inner := 35 { capability := walk };
  edge B-gate-inner_到_R06 : B-gate-inner -> R06 := 40 { capability := walk };
  edge R07_到_B-P : R07 -> B-P := 20 { capability := walk };
  edge B-gate-inner_到_R07 : B-gate-inner -> R07 := 42 { capability := walk };
  edge R05_到_B-gate-inner : R05 -> B-gate-inner := 45 { capability := walk };
  edge B-gate-inner_到_R05 : B-gate-inner -> R05 := 45 { capability := walk };
  edge R10_到_C-gate : R10 -> C-gate := 38 { capability := walk };
  edge C-gate_到_R10 : C-gate -> R10 := 38 { capability := walk };
  edge R12_到_C-gate : R12 -> C-gate := 36 { capability := walk };
  edge C-gate_到_R12 : C-gate -> R12 := 36 { capability := walk };
  edge R09_到_C-P : R09 -> C-P := 25 { capability := walk };
  edge C-P_到_C-gate : C-P -> C-gate := 22 { capability := walk };
  edge C-gate_到_R09 : C-gate -> R09 := 40 { capability := walk };
  edge C-P_到_R11 : C-P -> R11 := 30 { capability := walk };
  edge R13_到_D-gate : R13 -> D-gate := 40 { capability := walk };
  edge D-gate_到_R13 : D-gate -> R13 := 40 { capability := walk };
  edge R14_到_D-gate : R14 -> D-gate := 42 { capability := walk };
  edge D-gate_到_R14 : D-gate -> R14 := 42 { capability := walk };
  edge R15_到_D-gate : R15 -> D-gate := 45 { capability := walk };
  edge D-gate_到_R15 : D-gate -> R15 := 45 { capability := walk };
  edge R16_到_D-gate : R16 -> D-gate := 40 { capability := walk };
  edge D-gate_到_R16 : D-gate -> R16 := 40 { capability := walk };

  edge 2F-cross-M_到_N01 : 2F-cross-M -> N01 := 55 { requires_absent := [demon_manifested], capability := phase, access_bypass_capability := phase };
  edge N01_到_B-gate-inner : N01 -> B-gate-inner := 35 { requires_absent := [demon_manifested], capability := phase, access_bypass_capability := phase };
  edge B-gate-inner_到_B-P : B-gate-inner -> B-P := 15 { requires_absent := [demon_manifested], capability := phase, access_bypass_capability := phase };
