  resource b_pin at B-gate-inner;
  resource b_latch at B-gate-inner;
  resource b_gap at B-gate-inner;
  resource b_kitchen_hook at B-P;
  resource c_latch at C-gate;
  resource d_latch at D-gate;
  resource a_latch at A-gate;
  resource archive_vault at N01;

  object wrench : Tool at B-P;
  object oil : Supply at B-P;
  object cloth : Cloth at B-P;
  object knife : Tool held shen;
  object diagram : Diagram held vansittart;
  object scroll : Document held gu;
  object handcuffs : Tool held ward;
  object sword : Tool held lucian;
  object paperweight : Tool held moran;
  object bandage : Supply held selma;
  object crowbar : Tool held bertrand;
  object steel_wedge : Tool held margaret;
  object acid : Supply held veronica;

  def 步行 : Operation := { kind := move, capability := walk, minimum_seconds := 1, intent := purposeful, actual_need_effects := { energy := -0.5, $goal := 1 } };
  def 穿闭移动 : Operation := { kind := move, capability := phase, minimum_seconds := 1, intent := purposeful, actual_need_effects := { energy := -0.1, $goal := 1 } };

  def 舞步预演 : Operation := { kind := work, capability := manual, minimum_seconds := 60, intent := rehearse, actual_need_effects := { energy := -2, $goal := 4 }, adds := [rehearsal_completed] };
  def 指导舞步预演 : Operation := { kind := work, capability := observe, minimum_seconds := 60, intent := rehearse, actual_need_effects := { energy := -1, $goal := 4 }, adds := [rehearsal_guided] };
  def 发现反应炉故障 : Operation := { kind := observe, capability := observe, minimum_seconds := 5, intent := inquire, actual_need_effects := { energy := -0.1, $goal := 2 }, emits := [reactor_fault_detected] };
  def 断开反应炉并导流竖井 : Operation := { kind := work, capability := engineering, minimum_seconds := 20, intent := purposeful, requires_propositions := [reactor_fault_detected], actual_need_effects := { energy := -1, safety := 8, duty := 10, $goal := 8 }, requires := [reactor_fault], adds := [reactor_isolated, anchor_se_ready, shaft_upflow_rising], removes := [reactor_fault] };
  def 察觉源质险情 : Operation := { kind := observe, capability := observe, minimum_seconds := 5, intent := inquire, actual_need_effects := { energy := -0.1, $goal := 2 }, requires := [external_danger], emits := [external_prima_dangerous] };
  def 广播隔离警告 : Operation := { kind := speak, capability := broadcast, minimum_seconds := 15, intent := respond, requires_propositions := [external_prima_dangerous], actual_need_effects := { energy := -0.5, safety := 6, duty := 8, $goal := 6 }, requires := [external_danger], adds := [warning_broadcast], emits := [external_prima_dangerous, protect_positive_pressure, keep_isolation_boundary_closed] };

  def 起草契约 : Operation := { kind := work, capability := manual, minimum_seconds := 120, intent := respond, requires_propositions := [external_prima_dangerous], actual_need_effects := { energy := -1, duty := 8, $goal := 8 }, adds := [contract_drafted] };
  def 交接图纸 : Operation := { kind := work, capability := manual, minimum_seconds := 10, intent := respond, requires_propositions := [external_prima_dangerous], actual_need_effects := { energy := -0.2, duty := 5, $goal := 5 }, gives := [{ object := diagram, to := quer }], adds := [diagram_transferred], emits := [preserve_pipeline_diagram] };
  def 撬开通风篦将图纸塞入夹层 : Operation := { kind := work, capability := manual, minimum_seconds := 20, intent := respond, requires_propositions := [external_prima_dangerous, preserve_pipeline_diagram], actual_need_effects := { energy := -0.2, safety := 4, duty := 6, $goal := 6 }, places := [{ object := diagram, location := R03 }], adds := [diagram_preserved, trace_vent_pried] };
  def 幻火惊恐将孤本浸入水盆 : Operation := { kind := work, capability := manual, minimum_seconds := 20, intent := respond, requires_propositions := [external_prima_dangerous], actual_need_effects := { energy := -0.3, safety := 3, duty := 4, $goal := 5 }, requires := [a_glare_mirage], uses := [scroll], adds := [gu_notes_secured, scroll_soaked_in_basin] };
  def 误认盗窃将雀儿铐上铜管 : Operation := { kind := work, capability := manual, minimum_seconds := 20, intent := respond, requires_propositions := [external_prima_dangerous], actual_need_effects := { energy := -0.3, safety := 3, duty := 4, $goal := 5 }, requires := [trace_vent_pried], uses := [handcuffs], adds := [a_roll_checked, quer_cuffed_to_pipe] };
  def 拔剑劈断铜管托架救人 : Operation := { kind := work, capability := manual, minimum_seconds := 20, intent := respond, requires_propositions := [external_prima_dangerous], actual_need_effects := { energy := -0.4, safety := 5, duty := 6, $goal := 6 }, requires := [quer_cuffed_to_pipe], uses := [sword], adds := [trace_pipe_slashed, sword_notched] };

  def 扶稳伤员 : Operation := { kind := work, capability := manual, minimum_seconds := 20, intent := respond, requires_propositions := [external_prima_dangerous], actual_need_effects := { energy := -0.5, safety := 4, duty := 4, $goal := 4 }, adds := [elena_stabilized] };
  def 示意关门并扑入伤踝 : Operation := { kind := speak, capability := speak, minimum_seconds := 10, intent := respond, requires_propositions := [external_prima_dangerous], actual_need_effects := { energy := -0.2, safety := 4, duty := 4, $goal := 4 }, adds := [elena_inside_c, elena_ankle_sprained], emits := [elena_entered_c, close_c_gate_now] };
  def 拉下偏心重闸封门 : Operation := { kind := work, capability := manual, minimum_seconds := 15, intent := respond, requires_propositions := [external_prima_dangerous, elena_entered_c, close_c_gate_now], actual_need_effects := { energy := -0.5, safety := 8, duty := 6, $goal := 6 }, requires := [c_gate_open, elena_inside_c], adds := [c_gate_closed, trace_copper_filing_palm, c_window_afterimage], removes := [c_gate_open], resources := [c_latch] };
  def 照护伤员 : Operation := { kind := work, capability := manual, minimum_seconds := 30, intent := respond, requires_propositions := [external_prima_dangerous], actual_need_effects := { energy := -0.5, safety := 5, duty := 5, $goal := 6 }, requires := [elena_inside_c], adds := [elena_cared] };
  def 误认残影用镇纸猛砸观察窗内网 : Operation := { kind := work, capability := manual, minimum_seconds := 20, intent := respond, requires_propositions := [external_prima_dangerous], actual_need_effects := { energy := -0.3, safety := 3, duty := 4, $goal := 5 }, requires := [c_window_afterimage], uses := [paperweight], adds := [moran_sketch_secured, trace_window_mesh_dented] };
