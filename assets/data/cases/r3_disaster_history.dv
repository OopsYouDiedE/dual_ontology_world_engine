  channel 2F-cross-M_传声_R16 : 2F-cross-M -> R16 { minimum_delay := 3 };

  channel R01_传声_2F-cross-M : R01 -> 2F-cross-M { minimum_delay := 1 };
  channel R02_传声_2F-cross-M : R02 -> 2F-cross-M { minimum_delay := 1 };
