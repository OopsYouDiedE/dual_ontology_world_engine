  edge C-gate_到_D-gate : C-gate -> D-gate := 27 { requires_absent := [demon_manifested], capability := phase, access_bypass_capability := phase };

  channel B2-control_传声_B2-control : B2-control -> B2-control { minimum_delay := 0 };
  channel 2F-cross-M_传声_2F-cross-M : 2F-cross-M -> 2F-cross-M { minimum_delay := 0 };
  channel W-101_传声_W-101 : W-101 -> W-101 { minimum_delay := 1 };
  channel B-gate-inner_传声_B-gate-inner : B-gate-inner -> B-gate-inner { minimum_delay := 0 };
  channel C-P_传声_C-gate : C-P -> C-gate { minimum_delay := 2 };
