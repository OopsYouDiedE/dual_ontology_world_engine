    minimum_delay := 5,
    transform := [distorted_threat_heard, external_prima_dangerous]
  };

  channel 2F-cross-M_传声_W-101 : 2F-cross-M -> W-101 { minimum_delay := 3 };
  channel 2F-cross-M_传声_S-101 : 2F-cross-M -> S-101 { minimum_delay := 4 };
  channel 2F-cross-M_传声_R01 : 2F-cross-M -> R01 { minimum_delay := 3 };
  channel 2F-cross-M_传声_R02 : 2F-cross-M -> R02 { minimum_delay := 3 };
  channel 2F-cross-M_传声_R03 : 2F-cross-M -> R03 { minimum_delay := 3 };
